// EXPECT: this returns a slice into `a`, a local that is released when the function returns (region rule R1)
// the `else` is judged even when the `then` points somewhere safe
fn pick(n: i32, given: []u8) -> []u8 {
    let a: [3]u8 = [65, 66, 67]
    return if n > 0 { given[..] } else { a[..] }
}

fn main() { }
