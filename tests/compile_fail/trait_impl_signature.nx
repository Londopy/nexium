// EXPECT: `area` returns `i32`, but trait `Shape` declares `i64`
// EXPECT: `grow` takes `self: *Self`, but trait `Shape` declares `self: *mut Self`
// EXPECT: parameter `prefix` of `name` is `own` in trait `Shape` but not here
// EXPECT: `pair` takes 2 parameter(s) after `self`, but trait `Shape` declares 1
// EXPECT: parameter `n` of `tag` is `i64`, but trait `Shape` declares `i32`
// EXPECT: parameter `n` of `mark` is `own` here but not in trait `Shape`
trait Shape {
    fn area(self: *Self) -> i64
    fn grow(self: *mut Self, by: i64)
    fn name(self: *Self, own prefix: String) -> String
    fn pair(self: *Self, n: i32) -> i32
    fn tag(self: *Self, n: i32) -> i32
    fn mark(self: *Self, n: i32) -> i32
}

struct Square {
    side: i64
}

impl Shape for Square {
    fn area(self: *Self) -> i32 { return 1 }
    fn grow(self: *Self, by: i64) { }
    fn name(self: *Self, prefix: String) -> String { return String.from("sq") }
    fn pair(self: *Self, n: i32, extra: i32) -> i32 { return n + extra }
    fn tag(self: *Self, n: i64) -> i32 { return 0 }
    fn mark(self: *Self, n: i32) -> i32 { return n }
}

struct Box(T) {
    v: T
}

// a generic impl is held to the receiver, the count and `own`
impl(T) Shape for Box(T) {
    fn area(self: *Self) -> i64 { return 0 }
    fn grow(self: *mut Self, by: i64) { }
    fn name(self: *Self, own prefix: String) -> String { return prefix }
    fn pair(self: *Self, n: i32) -> i32 { return n }
    fn tag(self: *Self, n: i32) -> i32 { return n }
    fn mark(self: *Self, own n: i32) -> i32 { return n }
}

fn main() { }
