//! The test harness, a Nexium program: it builds the compiler from the C
//! seed with no Rust and runs every suite through the result.
//!
//!     nx run tests/run.nx                  every suite
//!     nx run tests/run.nx -- spec fmt      only these
//!     nx run tests/run.nx -- --jobs 4      how many cases run at once
//!
//! The chain is `bootstrap/nx.c` -> `nx0` (a C compiler), `nx0` builds
//! `self/nx.nx` -> `nx1`, `nx1` emits its own C -> `nx2`; `nx2` is the
//! compiler under test (`nx1` runs on the runtime the seed carries, `nx2` on
//! the one in the tree). It is rebuilt when anything under `self/`, `std/`,
//! `runtime/` or the seed is newer than it. Every suite records what failed;
//! the exit code is the number of failures, capped at 100.
//!
//! Suites: bootstrap (the fixed point), examples, spec, compile_fail, fmt,
//! std, gui, packages, ship, installer, repl, lsp, topo (the tutorial's
//! programs and the site generator).

import std.fs
import std.process
import std.thread
import std.strings

/// The harness's view of the machine: where the tree is, which compiler is
/// under test, and how C is compiled here.
struct Env {
    root: String
    nx: String
    windows: bool
    macos: bool
    jobs: usize
}

/// One case of a suite: what to run and what to expect.
struct Case {
    // "example", "test" (nx test), "spec", "compile_fail", "std"
    kind: String
    path: String
}

/// A worker's share of cases and what it found wrong.
struct Job {
    env: Env
    cases: List(Case)
    failures: List(String)
}

fn env_clone(e: *Env) -> Env {
    return Env{ .root = e.root.clone(), .nx = e.nx.clone(), .windows = e.windows, .macos = e.macos, .jobs = e.jobs }
}

// ----- running programs -------------------------------------------------------

/// Run a program from the repository root and capture what it printed.
fn run(e: *Env, argv: [][]u8) -> process.Output {
    return run_in(e, argv, "", e.root[..])
}

fn run_in(e: *Env, argv: [][]u8, stdin: []u8, cwd: []u8) -> process.Output {
    return process.run_with(argv, process.Options{ .stdin = stdin, .cwd = cwd }) catch {
        return process.Output{ .code = -1, .stdout = String.new(), .stderr = format("cannot run {}", .{argv[0]}) }
    }
}

fn nx(e: *Env, args: [][]u8) -> process.Output {
    var argv = List([]u8).new()
    argv.append(e.nx[..])
    for a in args { argv.append(a) }
    return run(e, argv[..])
}

fn nx_in(e: *Env, args: [][]u8, stdin: []u8, cwd: []u8) -> process.Output {
    var argv = List([]u8).new()
    argv.append(e.nx[..])
    for a in args { argv.append(a) }
    return run_in(e, argv[..], stdin, cwd)
}

/// The host C compiler builds one emitted file into an executable.
fn build_c(e: *Env, c_file: []u8, exe_path: []u8) -> ?String {
    var argv = List([]u8).new()
    if e.macos { argv.append("cc") } else { argv.append("zig"); argv.append("cc") }
    for a in ["-std=gnu11", "-O2", "-w", "-fno-strict-aliasing", "-o"] { argv.append(a) }
    argv.append(exe_path)
    argv.append(c_file)
    if e.windows { argv.append("-lws2_32") } else if !e.macos { argv.append("-lm"); argv.append("-lc") }
    let out = run(e, argv[..])
    if out.code != 0 { return format("{} did not build:\n{}", .{c_file, out.stderr}) }
    return null
}

fn is_program(path: []u8) -> bool {
    return path.ends_with(".nx")
}

/// Text as the recorded outputs store it: LF line ends, forward slashes.
fn normalize(s: []u8) -> String {
    return strings.replace(strings.replace(s, "\r\n", "\n")[..], "\\", "/")
}

/// Two texts must match; on a mismatch, the first line that differs.
fn same_text(expected: []u8, got: []u8, what: []u8) -> ?String {
    if expected == got { return null }
    let el = expected.lines()
    let gl = got.lines()
    var first = if el.len < gl.len { el.len } else { gl.len }
    for a, i in el {
        if i >= gl.len { break }
        if a != gl[i] { first = i; break }
    }
    let eline = if first < el.len { el[first] } else { "<end>" }
    let gline = if first < gl.len { gl[first] } else { "<end>" }
    return format("{} at line {} ({} vs {} lines):\n  expected: {}\n  got:      {}", .{what, first + 1, el.len, gl.len, eline, gline})
}

fn tree_files(dir: []u8) -> List(String) {
    var out = List(String).new()
    let names = fs.list(dir) catch { return out }
    for n in names { if is_program(n[..]) { out.append(fs.join(dir, n[..])) } }
    return out
}

fn newest(dir: []u8) -> i64 {
    var t: i64 = 0
    let files = fs.walk(dir) catch { return t }
    for f in files {
        let m = fs.modified(f[..]) catch { continue }
        if m > t { t = m }
    }
    return t
}

// ----- the bootstrap chain ------------------------------------------------------

/// The compiler under test, built from the seed when it is missing or
/// older than the sources it comes from.
fn bootstrap(e: *mut Env, failures: *mut List(String), force: bool) -> bool {
    let out = fs.join(e.root[..], "nx-out/bootstrap")
    fs.make_dirs(out[..]) catch { }
    let exe = if e.windows { ".exe" } else { "" }
    let nx0 = format("{}/nx0{}", .{out, exe})
    let nx1 = format("{}/nx1{}", .{out, exe})
    let nx2 = format("{}/nx2{}", .{out, exe})
    let c1 = format("{}/nx1.c", .{out})
    e.nx = nx2.clone()
    let seed = fs.join(e.root[..], "bootstrap/nx.c")
    var fresh = !force and fs.exists(nx2[..]) and fs.exists(c1[..])
    if fresh {
        let built = fs.modified(nx2[..]) catch { 0 }
        let seed_at = fs.modified(seed[..]) catch { 0 }
        for d in ["self", "std", "runtime"] { if newest(fs.join(e.root[..], d)[..]) > built { fresh = false } }
        if seed_at > built { fresh = false }
    }
    if fresh {
        println("bootstrap: {} is current", .{nx2})
        return true
    }
    println("bootstrap: stage 0, the C compiler builds nx0 from the seed", .{})
    if let err = build_c(e, seed[..], nx0[..]) { failures.append(err); return false }
    println("bootstrap: stage 1, nx0 builds self/nx.nx", .{})
    let args1 = [nx0[..], "build", "self/nx.nx", "--mode", "safe", "-o", nx1[..], "--out-dir", out[..]]
    let b1 = run(e, args1[..])
    if b1.code != 0 { failures.append(format("the seed compiler could not build self/nx.nx:\n{}", .{b1.stderr})); return false }
    println("bootstrap: stage 2, nx1 emits its own C, the C compiler builds nx2", .{})
    let args2 = [nx1[..], "emit-c", "self/nx.nx", "--mode", "safe"]
    let em = run(e, args2[..])
    if em.code != 0 { failures.append(format("nx1 could not emit self/nx.nx:\n{}", .{em.stderr})); return false }
    fs.write(c1[..], em.stdout[..]) catch { failures.append(String.from("cannot write nx1.c")); return false }
    if let err = build_c(e, c1[..], nx2[..]) { failures.append(err); return false }
    return true
}

/// `nx2` emits the C it was built from, and runs a program.
fn suite_bootstrap(e: *Env, failures: *mut List(String)) {
    let out = fs.join(e.root[..], "nx-out/bootstrap")
    let c1 = fs.read(format("{}/nx1.c", .{out})[..]) catch { failures.append(String.from("bootstrap: nx1.c is missing")); return }
    let again = nx(e, ["emit-c", "self/nx.nx", "--mode", "safe"][..])
    if again.code != 0 { failures.append(format("bootstrap: nx2 could not emit self/nx.nx:\n{}", .{again.stderr})); return }
    if let d = same_text(c1[..], again.stdout[..], "bootstrap: nx1 and nx2 emit different C for self/nx.nx") { failures.append(d); return }
    let hello = nx(e, ["run", "examples/hello.nx", "--out-dir", out[..]][..])
    if hello.code != 0 { failures.append(format("bootstrap: nx2 could not run hello:\n{}", .{hello.stderr})); return }
    let expected = fs.read(fs.join(e.root[..], "examples/hello.expected")[..]) catch { String.new() }
    if let d = same_text(normalize(expected[..])[..].trim(), normalize(hello.stdout[..])[..].trim(), "bootstrap: hello through nx2") { failures.append(d) }
    let seed = fs.read(fs.join(e.root[..], "bootstrap/nx.c")[..]) catch { String.new() }
    if seed[..] != c1[..] { println("note: bootstrap/nx.c is behind self/: regenerate it (nx emit-c self/nx.nx --mode safe > bootstrap/nx.c)", .{}) }
    println("bootstrap: the fixed point holds", .{})
}

// ----- cases that run in parallel -------------------------------------------------

/// The rewrite behind the --watch check: two seconds in, the program prints two.
fn rewrite_later(p: *mut String) -> i32 {
    time.sleep(2000)
    fs.write(p.*[..], "fn main() { println(\"two\", .{}) }\n") catch { return 1 }
    return 0
}

/// A recorded program: its output and exit code must match.
fn run_case(e: *Env, c: *Case) -> ?String {
    let kind = c.kind[..]
    let path = c.path[..]
    let out_dir = format("{}/nx-out/cases/{}", .{e.root, fs.stem(path)})
    if kind == "example" or kind == "test" or kind == "spec" {
        let sub = if kind == "test" { "test" } else { "run" }
        let out = nx(e, [sub, path, "--out-dir", out_dir[..]][..])
        var got = normalize(out.stdout[..])
        got.append(normalize(out.stderr[..])[..])
        let expected = normalize((fs.read(fs.with_extension(path, "expected")[..]) catch { String.new() })[..])
        fs.remove_all(out_dir[..]) catch { }
        if let d = same_text(expected[..].trim(), got[..].trim(), format("output of {} differs", .{path})[..]) { return d }
        if kind == "spec" {
            let text = fs.read(path) catch { String.new() }
            var want: i32 = 0
            for l in text[..].lines() { if let rest = strings.strip_prefix(l, "// EXIT:") { want = rest.trim().parse_int(i32) catch { 0 } } }
            if out.code != want { return format("exit code of {} is {}, expected {}", .{path, out.code, want}) }
        }
        return null
    }
    if kind == "topo_fails" {
        // a program the tutorial shows failing: the diagnostic is recorded
        let out = nx(e, ["check", path][..])
        if out.code == 0 { return format("{} was accepted but the Topo shows it failing", .{path}) }
        let expected = normalize((fs.read(fs.with_extension(path, "expected")[..]) catch { String.new() })[..])
        if let d = same_text(expected[..].trim(), normalize(out.stderr[..])[..].trim(), format("diagnostic of {} differs", .{path})[..]) { return d }
        return null
    }
    if kind == "compile_fail" {
        let text = fs.read(path) catch { return format("cannot read {}", .{path}) }
        var expects = List(String).new()
        for l in text[..].lines() { if let rest = strings.strip_prefix(l, "// EXPECT:") { expects.append(String.from(rest.trim())) } }
        if expects.len == 0 { return format("{} has no // EXPECT: line", .{path}) }
        // `// STRICT`: the case fails only because warnings are errors under
        // --strict (none since 1.3 made the view rules errors; a deprecation would)
        let strict = text[..].find("// STRICT") != null
        let out = if strict { nx(e, ["check", path, "--strict"][..]) } else { nx(e, ["check", path][..]) }
        if out.code == 0 { return format("{} was accepted but should fail", .{path}) }
        let diag = normalize(out.stderr[..])
        for x in expects {
            if diag[..].find(x[..]) == null { return format("{}: expected a diagnostic containing `{}`, got:\n{}", .{path, x, diag}) }
        }
        return null
    }
    if kind == "std" {
        let out = nx(e, ["test", path][..])
        if out.code != 0 { return format("std tests failed for {}:\n{}{}", .{path, out.stdout, out.stderr}) }
        return null
    }
    return format("unknown case kind {}", .{kind})
}

fn run_job(j: *mut Job) -> usize {
    for c in j.cases {
        if let f = run_case(&j.env, &c) { j.failures.append(f) }
    }
    return j.failures.len
}

/// Run cases on `jobs` threads; the failures, in case order per thread.
fn run_cases(e: *Env, cases: *List(Case), failures: *mut List(String)) {
    let n = if e.jobs < 1 { 1 } else { e.jobs }
    fs.make_dirs(fs.join(e.root[..], "nx-out/cases")[..]) catch { }
    var jobs = List(Job).new()
    for i in 0..n { jobs.append(Job{ .env = env_clone(e), .cases = List(Case).new(), .failures = List(String).new() }) }
    for c, i in cases { jobs[i % n].cases.append(Case{ .kind = c.kind.clone(), .path = c.path.clone() }) }
    var threads = List(thread.Thread(Job, usize)).new()
    while jobs.len > 0 {
        let j = jobs.pop().?
        threads.append(thread.spawn(Job, usize, run_job, j))
    }
    var ti = threads.len
    while ti > 0 {
        ti -= 1
        _ = threads[ti].join()
        let done = threads[ti].arg()
        for f in done.failures { failures.append(f.clone()) }
    }
}

fn suite_examples(e: *Env, failures: *mut List(String)) {
    var cases = List(Case).new()
    for name in ["hello", "tour", "binary", "ownership", "generics", "control", "ctest", "arena", "dyn", "parallel", "cimport", "process", "tree", "own", "stdlib", "json", "guard_scope", "records", "binary_sizes"] {
        cases.append(Case{ .kind = String.from("example"), .path = format("examples/{}.nx", .{name}) })
    }
    cases.append(Case{ .kind = String.from("test"), .path = String.from("examples/tests.nx") })
    run_cases(e, &cases, failures)
    // `nx doctor` must compile and run a program, not only find a C compiler
    let d = nx(e, ["doctor"][..])
    if d.code != 0 or d.stdout[..].find("smoke test:  a program compiles and runs") == null {
        failures.append(format("examples: nx doctor did not pass its smoke test:\n{}{}", .{d.stdout, d.stderr}))
    } else if d.stdout[..].find("latest release:") == null {
        failures.append(format("examples: nx doctor did not report the latest release:\n{}", .{d.stdout}))
    }
    // the daily update notice: a cached answer naming a newer release is
    // printed once, on stderr, and NX_NO_UPDATE_CHECK=1 silences it; the cache
    // stays set for the rest of the run so no later case asks the network
    let cache = fs.join(e.root[..], "nx-out/harness/update-check")
    let stamp = time.now() / 1000
    fs.make_dirs(fs.join(e.root[..], "nx-out/harness")[..]) catch { }
    fs.write(cache[..], format("checked {}\nnoticed 0\nlatest 99.0.0\n", .{stamp})[..]) catch {
        failures.append(format("examples: could not write the update cache {}", .{cache}))
    }
    os.set_env("NX_UPDATE_CACHE", cache[..])
    let n1 = nx(e, ["run", "examples/hello.nx", "--out-dir", "nx-out/harness/notice"][..])
    if n1.stderr[..].find("nx 99.0.0 is available") == null {
        failures.append(format("examples: a cached newer release was not announced:\n{}{}", .{n1.stdout, n1.stderr}))
    }
    let n2 = nx(e, ["run", "examples/hello.nx", "--out-dir", "nx-out/harness/notice"][..])
    if n2.stderr[..].find("is available") != null {
        failures.append(format("examples: the update notice repeated within a day:\n{}", .{n2.stderr}))
    }
    fs.write(cache[..], format("checked {}\nnoticed 0\nlatest 99.0.0\n", .{stamp})[..]) catch { }
    os.set_env("NX_NO_UPDATE_CHECK", "1")
    let n3 = nx(e, ["run", "examples/hello.nx", "--out-dir", "nx-out/harness/notice"][..])
    os.set_env("NX_NO_UPDATE_CHECK", "")
    if n3.stderr[..].find("is available") != null {
        failures.append(format("examples: NX_NO_UPDATE_CHECK=1 did not silence the update notice:\n{}", .{n3.stderr}))
    }
    fs.write(cache[..], format("checked {}\nnoticed {}\nlatest {}\n", .{stamp, stamp, "0.0.0"})[..]) catch { }
    // the completions and the manual page come out of the command table
    for sh in ["bash", "zsh", "fish", "powershell"] {
        let c = nx(e, ["completions", sh][..])
        let marker = if sh == "bash" { "_nx()" } else if sh == "zsh" { "#compdef nx" } else if sh == "fish" { "complete -c nx" } else { "Register-ArgumentCompleter" }
        if c.code != 0 or c.stdout[..].find(marker) == null or c.stdout[..].find("emit-c") == null or c.stdout[..].find("strict") == null {
            failures.append(format("examples: nx completions {} (exit {}):\n{}{}", .{sh, c.code, c.stdout[0..(if c.stdout.len < 400 { c.stdout.len } else { 400 })], c.stderr}))
        }
    }
    let bad = nx(e, ["completions", "tcsh"][..])
    if bad.code == 0 { failures.append(String.from("examples: nx completions accepted an unknown shell")) }
    let man = nx(e, ["man"][..])
    if man.code != 0 or man.stdout[..].find(".TH NX 1") == null or man.stdout[..].find(".SH COMMANDS") == null or man.stdout[..].find("NX_STRICT") == null {
        failures.append(format("examples: nx man (exit {}):\n{}", .{man.code, man.stderr}))
    }
    // an early `return` out of a `using arena` block ends the arena: nothing
    // is still live at exit under `nx leaks`
    let arena_lk = nx(e, ["leaks", "tests/spec/s5_arena_escape.nx", "--out-dir", "nx-out/harness/leaks"][..])
    if arena_lk.code != 0 or arena_lk.stderr[..].find("still live at exit") != null {
        failures.append(format("examples: nx leaks on s5_arena_escape (exit {}):\n{}{}", .{arena_lk.code, arena_lk.stdout, arena_lk.stderr}))
    }
    // a `while` condition's temporaries are released on every pass
    let while_lk = nx(e, ["leaks", "tests/spec/s6_while_condition_temporaries.nx", "--out-dir", "nx-out/harness/leaks-while"][..])
    if while_lk.code != 0 or while_lk.stderr[..].find("still live at exit") != null {
        failures.append(format("examples: nx leaks on s6_while_condition_temporaries (exit {}):\n{}{}", .{while_lk.code, while_lk.stdout, while_lk.stderr}))
    }
    // --watch: the program runs again after a file changes (a thread rewrites
    // it two seconds in; NX_WATCH_ROUNDS=1 stops after that rerun)
    let wsrc = fs.join(e.root[..], "nx-out/cases/watch.nx")
    fs.write(wsrc[..], "fn main() { println(\"one\", .{}) }\n") catch { }
    os.set_env("NX_WATCH_ROUNDS", "1")
    var rewriter = thread.spawn(String, i32, rewrite_later, wsrc.clone())
    let w = nx(e, ["run", wsrc[..], "--watch", "--out-dir", fs.join(e.root[..], "nx-out/cases/watch-out")[..]][..])
    _ = rewriter.join()
    os.set_env("NX_WATCH_ROUNDS", "")
    if w.code != 0 or w.stdout[..].find("one") == null or w.stdout[..].find("two") == null or w.stdout[..].find("running again") == null {
        failures.append(format("examples: nx run --watch (exit {}):\n{}{}", .{w.code, w.stdout, w.stderr}))
    }
    // nx explain: the tree from main down to the overflow check in twice
    let ex_src = fs.join(e.root[..], "nx-out/cases/explain.nx")
    fs.write(ex_src[..], "fn twice(x: i32) -> i32 { return x * 2 }\nfn main() { println(\"{}\", .{twice(3)}) }\n") catch { }
    let ex = nx(e, ["explain", ex_src[..], "main", "panics"][..])
    if ex.code != 0 or ex.stdout[..].find("calls twice at") == null or ex.stdout[..].find("arithmetic may overflow") == null {
        failures.append(format("examples: nx explain (exit {}):\n{}{}", .{ex.code, ex.stdout, ex.stderr}))
    }
    let exn = nx(e, ["explain", ex_src[..], "twice", "blocks"][..])
    if exn.code != 0 or exn.stdout[..].find("-> i32  !blocks") == null { failures.append(format("examples: nx explain on an effect a function lacks:\n{}{}", .{exn.stdout, exn.stderr})) }
    // nx doc lists a type's pub methods from all its impl blocks, with their
    // effects and doc comments, and an impl of one instance says which
    let doc_src = fs.join(e.root[..], "nx-out/cases/methods.nx")
    fs.write(doc_src[..], "pub struct Box { n: i32 }\nimpl Box {\n    /// Twice the number.\n    pub fn double(self: *Self) -> i32 { return self.n * 2 }\n    fn hidden(self: *Self) -> i32 { return 0 }\n}\nimpl Box {\n    pub fn show(self: *Self) { println(\"{}\", .{self.n}) }\n}\npub struct Pair(T) { a: T, b: T }\nimpl(T) Pair(T) {\n    pub fn first(self: *Self) -> T { return self.a }\n}\nimpl Pair(i32) {\n    pub fn sum(self: *Self) -> i32 { return self.a + self.b }\n}\n") catch { }
    let dg = nx(e, ["doc", doc_src[..], "-o", fs.join(e.root[..], "nx-out/cases/methods-doc")[..]][..])
    let page = fs.read(fs.join(e.root[..], "nx-out/cases/methods-doc/methods.html")[..]) catch { String.new() }
    for want in ["pub fn double(self: *Self) -&gt; i32", "Twice the number.", "pub fn show(self: *Self)</pre><div class=\"eff\">effects: blocks", "(generic; inferred per instantiation)", "<code>impl Pair(i32)</code>", "pub fn sum("] {
        if page[..].find(want) == null { failures.append(format("examples: nx doc does not show `{}` (exit {}):\n{}{}", .{want, dg.code, dg.stderr, page})) }
    }
    if page[..].find("hidden") != null { failures.append(String.from("examples: nx doc lists a method that is not pub")) }
    // nx fix makes rule V4's `.clone()` and rule V5's `@escape`, and the
    // program then checks clean; `--check` writes nothing; a V3 error has no
    // edit and is left; `--strict` is still accepted
    let fx_src = fs.join(e.root[..], "nx-out/cases/fixable.nx")
    let fixable = "fn keep(own s: String) -> usize { return s.len }\n\nfn make() -> String {\n    using arena {\n        let s = String.from(\"arena\")\n        return s\n    }\n    return String.new()\n}\n\nfn main() {\n    let a = String.from(\"first\")\n    let va = a[..]\n    let n = keep(a)\n    println(\"{} {} {}\", .{va, n, make()})\n}\n"
    fs.write(fx_src[..], fixable) catch { }
    let fck = nx(e, ["fix", fx_src[..], "--check"][..])
    let untouched = fs.read(fx_src[..]) catch { String.new() }
    if fck.code == 0 or fck.stdout[..].find("would fix") == null or untouched[..] != fixable { failures.append(format("examples: nx fix --check (exit {}) should report and write nothing:\n{}{}", .{fck.code, fck.stdout, fck.stderr})) }
    let fxd = nx(e, ["fix", fx_src[..]][..])
    let fixed = fs.read(fx_src[..]) catch { String.new() }
    if fxd.code != 0 or fixed[..].find("keep(a.clone())") == null or fixed[..].find("return @escape(s)") == null { failures.append(format("examples: nx fix (exit {}) did not make the V4 and V5 edits:\n{}{}{}", .{fxd.code, fxd.stdout, fxd.stderr, fixed})) }
    let fcl = nx(e, ["check", fx_src[..], "--strict"][..])
    if fcl.code != 0 { failures.append(format("examples: the program nx fix edited does not check clean:\n{}", .{fcl.stderr})) }
    let v3_src = fs.join(e.root[..], "nx-out/cases/unfixable.nx")
    fs.write(v3_src[..], "fn main() {\n    var xs = List(i32).new()\n    xs.append(1)\n    let v = xs[..]\n    xs.append(2)\n    println(\"{}\", .{v.len})\n}\n") catch { }
    // a literal past u128's maximum does not fit any type; it is not malformed
    // (written here: a file with a lexical error is not one nx fmt reads)
    let past = fs.join(e.root[..], "nx-out/cases/past_u128.nx")
    fs.write(past[..], "fn main() {\n    let x: u128 = 340282366920938463463374607431768211456\n    println(\"{}\", .{x})\n}\n") catch { }
    let pc = nx(e, ["check", past[..]][..])
    if pc.code == 0 or pc.stderr[..].find("integer literal `340282366920938463463374607431768211456` does not fit in any integer type") == null { failures.append(format("examples: a literal past u128's maximum (exit {}):\n{}", .{pc.code, pc.stderr})) }
    let fun = nx(e, ["fix", v3_src[..]][..])
    if fun.code == 0 or fun.stdout[..].find("1 error(s) left that nx fix has no edit for") == null { failures.append(format("examples: nx fix on a V3 error (exit {}):\n{}{}", .{fun.code, fun.stdout, fun.stderr})) }
    // `_ = ` in front of an unused value, in a statement and in a block's
    // tail; none in an `if` with no `else` whose value is wanted
    let un_src = fs.join(e.root[..], "nx-out/cases/unused.nx")
    fs.write(un_src[..], "fn twice(x: i32) -> i32 { return x * 2 }\n\nfn quiet(c: bool) {\n    twice(1)\n    if c {\n        twice(2)\n    }\n}\n\nfn main() {\n    quiet(true)\n    let v = if true { twice(3) }\n}\n") catch { }
    let unf = nx(e, ["fix", un_src[..]][..])
    let unt = fs.read(un_src[..]) catch { String.new() }
    if unf.stdout[..].find("2 error(s) left that nx fix has no edit for") == null or unt[..].find("    _ = twice(1)\n") == null or unt[..].find("        _ = twice(2)\n") == null or unt[..].find("_ = twice(3)") != null { failures.append(format("examples: nx fix and unused values (exit {}):\n{}{}{}", .{unf.code, unf.stdout, unf.stderr, unt})) }
    // the effects lockfile: the shipped example's is committed and must match;
    // a function that starts printing gains `blocks`, and --check says so
    let lk = nx(e, ["audit", "examples/ropesim.nx", "--check"][..])
    if lk.code != 0 or lk.stdout[..].find("effects match") == null { failures.append(format("examples: nx audit --check on ropesim:\n{}{}", .{lk.stdout, lk.stderr})) }
    let lock_src = fs.join(e.root[..], "nx-out/cases/locked.nx")
    fs.write(lock_src[..], "pub fn f() -> i32 { return 1 }\nfn main() { println(\"{}\", .{f()}) }\n") catch { }
    let w = nx(e, ["audit", lock_src[..], "--lock"][..])
    if w.code != 0 { failures.append(format("examples: nx audit --lock failed:\n{}", .{w.stderr})) }
    fs.write(lock_src[..], "pub fn f() -> i32 { println(\"hi\", .{}); return 1 }\nfn main() { println(\"{}\", .{f()}) }\n") catch { }
    let bad = nx(e, ["audit", lock_src[..], "--check"][..])
    if bad.code == 0 or bad.stderr[..].find("gained: blocks") == null { failures.append(format("examples: nx audit --check missed a gained effect (exit {}):\n{}{}", .{bad.code, bad.stdout, bad.stderr})) }
    // nx install puts a copy in place (the PATH is left alone here), and a
    // `portable` marker beside it is reported by the doctor
    os.set_env("NEXIUM_NO_MODIFY_PATH", "1")
    let inst_dir = fs.join(e.root[..], "nx-out/cases/install-test")
    fs.remove_all(inst_dir[..]) catch { }
    let inst = nx(e, ["install", inst_dir[..]][..])
    let inst_bin = if e.windows { inst_dir.clone() } else { fs.join(inst_dir[..], "bin") }
    let installed = fs.join(inst_bin[..], if e.windows { "nx.exe" } else { "nx" })
    if inst.code != 0 or !fs.exists(installed[..]) {
        failures.append(format("examples: nx install failed (exit {}):\n{}{}", .{inst.code, inst.stdout, inst.stderr}))
    } else {
        let v = run_in(e, [installed[..], "version"][..], "", e.root[..])
        if v.code != 0 or v.stdout[..].find("nx ") == null { failures.append(format("examples: the installed nx does not run:\n{}{}", .{v.stdout, v.stderr})) }
        fs.write(fs.join(inst_bin[..], "portable")[..], "") catch { }
        let d2 = run_in(e, [installed[..], "doctor"][..], "", e.root[..])
        if d2.stdout[..].find("portable:    yes") == null { failures.append(format("examples: the portable marker was not reported:\n{}{}", .{d2.stdout, d2.stderr})) }
    }
    fs.remove_all(inst_dir[..]) catch { }
    // nx upgrade --check asks GitHub, so only online (CI is); offline it must still fail cleanly
    let up = nx(e, ["upgrade", "--check"][..])
    if os.env("NX_ONLINE") != null {
        if up.code != 0 and up.stderr[..].find("no answer from api.github.com") != null {
            println("examples: nx upgrade --check: api.github.com did not answer (a rate limit?); not counted", .{})
        } else if up.code != 0 or (up.stdout[..].find("latest release") == null and up.stdout[..].find("is the latest release") == null) {
            failures.append(format("examples: nx upgrade --check answered (exit {}):\n{}{}", .{up.code, up.stdout, up.stderr}))
        }
    } else if up.code == 0 and up.stdout[..].find("latest release") == null and up.stdout[..].find("is the latest release") == null {
        failures.append(format("examples: nx upgrade --check exit 0 without an answer:\n{}", .{up.stdout}))
    }
    // nx layout: offsets, padding, the total, and the reordering that shrinks a struct
    let lay_src = fs.join(e.root[..], "nx-out/cases/layout.nx")
    fs.write(lay_src[..], "struct P { a: u8, b: u64, c: u8 }\nenum E { Unit, Pair(u8, u64) }\nfn main() {}\n") catch { failures.append(String.from("examples: cannot write layout.nx")); return }
    let lay = nx(e, ["layout", lay_src[..], "P", "E"][..])
    if lay.code != 0 { failures.append(format("examples: nx layout failed:\n{}", .{lay.stderr})) }
    for want in ["struct P: 24 bytes, alignment 8, 14 of padding", "     8     8  b: u64", "reordered by alignment (b, a, c): 16 bytes, 8 fewer", "enum E: 24 bytes, alignment 8", "Pair(u8, u64): 16 bytes of payload"] {
        if lay.stdout[..].find(want) == null { failures.append(format("examples: nx layout lacks `{}`:\n{}", .{want, lay.stdout})) }
    }
    // --sanitize: fast mode drops the overflow and bounds checks, and the
    // sanitizer puts them back; a name it does not know, and `address` with
    // zig cc (no runtime for it), are refused before anything is built
    let ovf_src = fs.join(e.root[..], "nx-out/cases/sanitize_overflow.nx")
    fs.write(ovf_src[..], "fn main() {\n    var x: i32 = 2147483600\n    var i: i32 = 0\n    while i < 100 {\n        x += 1\n        i += 1\n    }\n    println(\"{}\", .{x})\n}\n") catch { }
    let ovf = nx(e, ["run", ovf_src[..], "--mode", "fast", "--sanitize", "undefined"][..])
    if ovf.code == 0 or ovf.stderr[..].find("signed integer overflow") == null { failures.append(format("examples: --sanitize undefined missed an overflow in fast mode (exit {}):\n{}{}", .{ovf.code, ovf.stdout, ovf.stderr})) }
    if !e.macos {
        let oob_src = fs.join(e.root[..], "nx-out/cases/sanitize_bounds.nx")
        fs.write(oob_src[..], "fn main() {\n    var xs: [4]i32 = [1, 2, 3, 4]\n    var sum: i32 = 0\n    var i: usize = 0\n    while i < 5 {\n        sum += xs[i]\n        i += 1\n    }\n    println(\"{}\", .{sum})\n}\n") catch { }
        let oob = nx(e, ["run", oob_src[..], "--mode", "fast", "--sanitize", "undefined"][..])
        if oob.code == 0 or oob.stderr[..].find("out of bounds") == null { failures.append(format("examples: --sanitize undefined missed a fixed array read past its end in fast mode (exit {}):\n{}{}", .{oob.code, oob.stdout, oob.stderr})) }
    }
    let san_test = nx(e, ["test", "std/json.nx", "--sanitize", "undefined"][..])
    if san_test.code != 0 { failures.append(format("examples: nx test --sanitize undefined failed (exit {}):\n{}{}", .{san_test.code, san_test.stdout, san_test.stderr})) }
    let bogus = nx(e, ["run", "examples/hello.nx", "--sanitize", "thread"][..])
    if bogus.code != 2 or bogus.stderr[..].find("takes `address` and `undefined`, not `thread`") == null { failures.append(format("examples: --sanitize thread was not refused (exit {}):\n{}", .{bogus.code, bogus.stderr})) }
    // nx bench: each `bench` block measured, its value kept; `nx test` leaves
    // them; a panic fails one benchmark and the rest run; a filter narrows
    let bench_src = fs.join(e.root[..], "nx-out/cases/benches.nx")
    fs.write(bench_src[..], "fn sum_to(n: i64) -> i64 {\n    var s: i64 = 0\n    var i: i64 = 0\n    while i < n {\n        s += i\n        i += 1\n    }\n    return s\n}\n\nfn bench(n: i64) -> i64 { return n + 1 }\n\ntest \"sums\" {\n    expect(sum_to(4) == 6)\n}\n\nbench \"sum to 1000\" {\n    sum_to(1000)\n}\n\nbench \"a named function\" {\n    bench(41)\n}\n\nbench \"this one panics\" {\n    let xs = [1, 2, 3]\n    var i: usize = 0\n    while i < 4 { i += 1 }\n    xs[i]\n}\n") catch { }
    let bt = nx(e, ["test", bench_src[..]][..])
    if bt.code != 0 or bt.stdout[..].find("1 passed, 0 failed") == null or bt.stdout[..].find("sum to") != null { failures.append(format("examples: nx test on a file with benchmarks (exit {}):\n{}{}", .{bt.code, bt.stdout, bt.stderr})) }
    let bb = nx(e, ["bench", bench_src[..], "--quick"][..])
    for want in ["bench  sum to 1000       ", "ns/iter  (min ", "21 samples of ", "bench  a named function  ", "FAIL   this one panics", "index 4 out of bounds for length 3", "3 benchmark(s), safe mode, some failed"] {
        if bb.stdout[..].find(want) == null { failures.append(format("examples: nx bench lacks `{}` (exit {}):\n{}{}", .{want, bb.code, bb.stdout, bb.stderr})) }
    }
    if bb.code != 1 { failures.append(format("examples: nx bench with a failing benchmark exited {}", .{bb.code})) }
    let bf = nx(e, ["bench", bench_src[..], "named", "--quick"][..])
    if bf.code != 0 or bf.stdout[..].find("1 benchmark(s), safe mode (some skipped by filter)") == null { failures.append(format("examples: nx bench with a filter (exit {}):\n{}{}", .{bf.code, bf.stdout, bf.stderr})) }
    // a debug build split into a C file per module (NX_UNITS=1 splits even a
    // small one): the runtime's state is one (two modules read stdin in turn),
    // a module's global is the root file's, and a change to one module
    // compiles one file again
    let udir = fs.join(e.root[..], "nx-out/cases/units")
    fs.remove_all(udir[..]) catch { }
    fs.make_dirs(udir[..]) catch { }
    let umain = fs.join(udir[..], "main.nx")
    fs.write(umain[..], "import util\nimport shapes\n\nfn main() {\n    let a = util.first_line()\n    let b = shapes.second_line()\n    _ = util.hit()\n    println(\"{} {} {} {} {}\", .{a, b, util.twice(21), shapes.area(3), util.hit()})\n}\n") catch { }
    fs.write(fs.join(udir[..], "util.nx")[..], "var hits: i64 = 0\n\npub fn first_line() -> String {\n    return io.read_line() orelse String.new()\n}\n\npub fn twice(x: i64) -> i64 {\n    return x * 2\n}\n\npub fn hit() -> i64 {\n    unsafe {\n        hits += 1\n        return hits\n    }\n}\n") catch { }
    let ushapes = fs.join(udir[..], "shapes.nx")
    fs.write(ushapes[..], "pub fn second_line() -> String {\n    return io.read_line() orelse String.new()\n}\n\npub fn area(r: i64) -> i64 {\n    return r * r * 3\n}\n") catch { }
    let uout = fs.join(udir[..], "out")
    let uexe = fs.join(uout[..], if e.windows { "main.exe" } else { "main" })
    os.set_env("NX_UNITS", "1")
    let ub1 = nx(e, ["build", umain[..], "--out-dir", uout[..]][..])
    let ur1 = run_in(e, [uexe[..]][..], "alpha\nbeta\n", e.root[..])
    if ub1.stdout[..].find("3 of 3 C files compiled") == null or ur1.stdout[..].find("alpha beta 42 27 2") == null { failures.append(format("examples: a build split by module (exit {}):\n{}{}{}{}", .{ub1.code, ub1.stdout, ub1.stderr, ur1.stdout, ur1.stderr})) }
    fs.write(ushapes[..], "pub fn second_line() -> String {\n    return io.read_line() orelse String.new()\n}\n\npub fn area(r: i64) -> i64 {\n    return r * r * 4\n}\n") catch { }
    let ub2 = nx(e, ["build", umain[..], "--out-dir", uout[..]][..])
    let ur2 = run_in(e, [uexe[..]][..], "alpha\nbeta\n", e.root[..])
    if ub2.stdout[..].find("1 of 3 C files compiled") == null or ur2.stdout[..].find("alpha beta 42 36 2") == null { failures.append(format("examples: a split build after one module changed (exit {}):\n{}{}{}{}", .{ub2.code, ub2.stdout, ub2.stderr, ur2.stdout, ur2.stderr})) }
    os.set_env("NX_UNITS", "")
    // `if comptime`: the target picks the branch that is built, and the other
    // is not in the C at all
    let ct_src = fs.join(e.root[..], "nx-out/cases/comptime_if.nx")
    fs.write(ct_src[..], "fn main() {\n    let s = if comptime @target().0 == \"windows\" { \"built for windows\" } else { \"built for another\" }\n    println(\"{}\", .{s})\n}\n") catch { }
    for pick in [["x86_64-windows-gnu", "built for windows", "built for another"], ["x86_64-linux-gnu", "built for another", "built for windows"], ["aarch64-macos", "built for another", "built for windows"]] {
        let ce = nx(e, ["emit-c", ct_src[..], "--target", pick[0]][..])
        if ce.code != 0 or ce.stdout[..].find(pick[1]) == null or ce.stdout[..].find(pick[2]) != null { failures.append(format("examples: `if comptime` for {} did not build only `{}` (exit {}):\n{}", .{pick[0], pick[1], ce.code, ce.stderr})) }
    }
    // `#line`: a debug build's C names the `.nx` lines, each function followed
    // by the directive that gives the C its own lines back; `nx emit-c` has none
    let lines_dir = fs.join(e.root[..], "nx-out/cases/lines")
    let lb = nx(e, ["build", "tests/debug/values.nx", "--keep-c", "--out-dir", lines_dir[..]][..])
    let lc = fs.read(fs.join(lines_dir[..], "values.c")[..]) catch { String.new() }
    if lb.code != 0 or lc[..].find("#line 21 \"tests/debug/values.nx\"") == null { failures.append(format("examples: a debug build's C lacks the `.nx` line of the println (exit {}):\n{}", .{lb.code, lb.stderr})) }
    var resets: usize = 0
    for l, i in lc[..].lines() {
        if l.starts_with("#line ") and l.ends_with("values.c\"") {
            resets += 1
            if !l.starts_with(format("#line {} ", .{i + 2})[..]) { failures.append(format("examples: `{}` is on line {} of the C", .{l, i + 1})) }
        }
    }
    if resets == 0 { failures.append(String.from("examples: a debug build's C never gives the lines back to the C file")) }
    let lec = nx(e, ["emit-c", "tests/debug/values.nx"][..])
    if lec.stdout[..].find("#line") != null { failures.append(String.from("examples: nx emit-c printed #line directives")) }
    // nx debug: the formatters first, then NX_DEBUGGER's own words, then the
    // program (stand-ins for gdb and lldb print the arguments they were given)
    for flavor in ["gdb", "lldb"] {
        let fake_src = fs.join(e.root[..], format("nx-out/cases/fake-{}.nx", .{flavor})[..])
        fs.write(fake_src[..], "fn main() {\n    for a in os.args() { println(\"[{}]\", .{a}) }\n}\n") catch { }
        let fake_dir = fs.join(e.root[..], "nx-out/cases/fake-debugger")
        let fake = fs.join(fake_dir[..], format("fake-{}{}", .{flavor, if e.windows { ".exe" } else { "" }})[..])
        let fbuild = nx(e, ["build", fake_src[..], "--out-dir", fake_dir[..], "-o", fake[..]][..])
        if fbuild.code != 0 {
            failures.append(format("examples: the stand-in {} did not build:\n{}", .{flavor, fbuild.stderr}))
            continue
        }
        os.set_env("NX_DEBUGGER", format("{} --batchy", .{fake})[..])
        let dg = nx(e, ["debug", "tests/debug/values.nx", "--out-dir", fs.join(e.root[..], "nx-out/cases/debugged")[..], "--", "arg1"][..])
        os.set_env("NX_DEBUGGER", "")
        let wants = if flavor == "gdb" { ["[-q]", "[-x]", "nx_gdb.py]", "[--batchy]", "[--args]", "values", "[arg1]"] } else { ["[-o]", "[command script import \"", "nx_lldb.py\"]", "[--batchy]", "[--]", "values", "[arg1]"] }
        var at: usize = 0
        for want in wants {
            if let k = dg.stdout[at..].find(want) { at += k + want.len } else {
                failures.append(format("examples: nx debug with {} lacks `{}` in order (exit {}):\n{}{}", .{flavor, want, dg.code, dg.stdout, dg.stderr}))
                break
            }
        }
    }
    let asan_zig = nx(e, ["run", "examples/hello.nx", "--cc", "zig", "--sanitize", "address"][..])
    if asan_zig.code != 2 or asan_zig.stderr[..].find("zig cc has no AddressSanitizer runtime") == null { failures.append(format("examples: --sanitize address with zig cc was not refused (exit {}):\n{}", .{asan_zig.code, asan_zig.stderr})) }
    println("examples: {} programs, and nx doctor", .{cases.len})
}

fn suite_spec(e: *Env, failures: *mut List(String)) {
    var cases = List(Case).new()
    for f in tree_files("tests/spec") { cases.append(Case{ .kind = String.from("spec"), .path = f.clone() }) }
    if cases.len == 0 { failures.append(String.from("spec: no cases found")); return }
    run_cases(e, &cases, failures)
    println("spec: {} cases", .{cases.len})
}

fn suite_compile_fail(e: *Env, failures: *mut List(String)) {
    var cases = List(Case).new()
    for f in tree_files("tests/compile_fail") { cases.append(Case{ .kind = String.from("compile_fail"), .path = f.clone() }) }
    if cases.len == 0 { failures.append(String.from("compile_fail: no cases found")); return }
    run_cases(e, &cases, failures)
    // a lexical error cannot be a case in the tree (`nx fmt` refuses the
    // file): the lexer's complaint and the parser's reading of the same text
    // are one mistake, reported once, with its location
    let cut = fs.join(e.root[..], "nx-out/cases/syntax_once.nx")
    fs.write(cut[..], "fn main() {\n    let s = \"abc\n}\n") catch { }
    let o = nx(e, ["check", cut[..]][..])
    let d = normalize(o.stderr[..])
    if o.code == 0 or strings.count(d[..], "newline in string literal") != 1 or d[..].find("syntax_once.nx:2:13") == null or d[..].find("2 error(s)") == null or d[..].find("error at ") != null {
        failures.append(format("compile_fail: a lexical error was not reported once with its location (exit {}):\n{}", .{o.code, d}))
    }
    println("compile_fail: {} cases, and a lexical error", .{cases.len})
}

/// The Topo's programs reproduce their recorded output (the site shows
/// exactly what the harness ran), the tests among them pass, the packages
/// example builds from its own directory, the GUI chapter renders its frame,
/// and the site generator builds the site.
fn suite_topo(e: *Env, failures: *mut List(String)) {
    var cases = List(Case).new()
    for f in tree_files("topo/code") {
        let stem = fs.stem(f[..])
        if !fs.exists(fs.with_extension(f[..], "expected")[..]) { continue }
        let kind = if stem.find("_fails") != null { "topo_fails" } else { "example" }
        cases.append(Case{ .kind = String.from(kind), .path = f.clone() })
    }
    run_cases(e, &cases, failures)
    for f in ["topo/code/calc.nx", "topo/code/testing.nx"] {
        let t = nx(e, ["test", f, "--out-dir", format("{}/nx-out/cases/{}-tests", .{e.root, fs.stem(f)})[..]][..])
        if t.code != 0 { failures.append(format("topo: tests in {} failed:\n{}{}", .{f, t.stdout, t.stderr})) }
    }
    let app = fs.join(e.root[..], "topo/code/pkg/app")
    let pkg = nx_in(e, ["run", "main.nx", "--out-dir", fs.join(e.root[..], "nx-out/cases/topo-pkg")[..]][..], "", app[..])
    if pkg.code != 0 or pkg.text() != "SUMMIT!\nquiet" { failures.append(format("topo: the packages example printed:\n{}{}", .{pkg.stdout, pkg.stderr})) }
    // the package from the wild comes from GitHub: only when online (CI is), and
    // on Windows, where the SDK's pipe lives today
    if os.env("NX_ONLINE") != null and e.windows {
        let card = fs.join(e.root[..], "topo/code/discord")
        let fetched = nx_in(e, ["fetch"][..], "", card[..])
        if fetched.code != 0 { failures.append(format("topo: fetching the Discord SDK failed:\n{}", .{fetched.stderr})) }
        let ran = nx_in(e, ["run", "main.nx", "--out-dir", fs.join(e.root[..], "nx-out/cases/topo-discord")[..]][..], "", card[..])
        if ran.code != 0 or (ran.stdout[..].find("the card would have said") == null and ran.stdout[..].find("on your profile now") == null) {
            failures.append(format("topo: the Discord example printed:\n{}{}", .{ran.stdout, ran.stderr}))
        }
    } else {
        println("topo: the Discord package example is fetched only online (NX_ONLINE=1) and on Windows", .{})
    }
    let shot = fs.join(e.root[..], "nx-out/cases/topo-counter.ppm")
    let g = nx(e, ["run", "gui/counter.nx", "--out-dir", fs.join(e.root[..], "nx-out/cases/topo-gui")[..], "--", "--shot", shot[..]][..])
    if g.code != 0 { failures.append(format("topo: the counter GUI failed:\n{}", .{g.stderr})) }
    suite_exercises(e, failures)
    let site = nx(e, ["run", "site/build.nx", "--out-dir", fs.join(e.root[..], "nx-out/cases/topo-site")[..], "--", "--out", fs.join(e.root[..], "nx-out/site")[..]][..])
    if site.code != 0 { failures.append(format("topo: the site did not build:\n{}{}", .{site.stdout, site.stderr})) }
    if !fs.exists(fs.join(e.root[..], "nx-out/site/index.html")[..]) { failures.append(String.from("topo: the site has no index.html")) }
    println("topo: {} programs, the tests, the package, the GUI frame, the site", .{cases.len})
}

/// Every module of the standard library passes its own tests.
fn suite_std(e: *Env, failures: *mut List(String)) {
    var cases = List(Case).new()
    for f in tree_files("std") { cases.append(Case{ .kind = String.from("std"), .path = f.clone() }) }
    run_cases(e, &cases, failures)
    println("std: {} modules", .{cases.len})
}

/// `nx fmt --check` passes on every source in the tree: formatting is
/// idempotent and the sources are canonical.
fn suite_fmt(e: *Env, failures: *mut List(String)) {
    var args = List([]u8).new()
    args.append("fmt")
    var files = List(String).new()
    for dir in ["examples", "std", "gui", "self", "tests/spec", "tests/compile_fail", "tests", "topo/code", "site", "bench"] { for f in tree_files(dir) { files.append(f.clone()) } }
    // the course's starters too: a hole (`???`) is spaced like a word
    for d in fs.list("topo/exercises") catch { List(String).new() } {
        let dir = fs.join("topo/exercises", d[..])
        if fs.is_dir(dir[..]) { for f in tree_files(dir[..]) { files.append(f.clone()) } }
    }
    for f in files { args.append(f[..]) }
    args.append("--check")
    let out = nx(e, args[..])
    if out.code != 0 { failures.append(format("fmt: sources are not canonically formatted:\n{}{}", .{out.stdout, out.stderr})) }
    // a hole in every shape stays where it is written
    let holes = fs.join(e.root[..], "nx-out/cases/holes.nx")
    let text = "fn keep(??? text: String) -> i32 {\n    let s = x.??? + f(???, 1)\n    match p { .A => ???, ??? => 0 }\n    println(\"{}\", .{??? , a ??? b})\n    match d { <<len:???/big, rest:bytes>> => 1, _ => 0 }\n    ???\n}\n"
    let want = "fn keep(??? text: String) -> i32 {\n    let s = x.??? + f(???, 1)\n    match p { .A => ???, ??? => 0 }\n    println(\"{}\", .{???, a ??? b})\n    match d { <<len:???/big, rest:bytes>> => 1, _ => 0 }\n    ???\n}\n"
    fs.write(holes[..], text) catch { }
    let h = nx(e, ["fmt", holes[..]][..])
    let got = normalize((fs.read(holes[..]) catch { String.new() })[..])
    if h.code != 0 or got[..] != want { failures.append(format("fmt: the holes of an exercise moved (exit {}):\n{}{}", .{h.code, got, h.stderr})) }
    // `.*` and `.?` are postfix: spaced before operators and braces, tight before `.`, `[`, `(`
    let post = fs.join(e.root[..], "nx-out/cases/postfix.nx")
    let ptext = "fn f(i: *mut usize, o: ?[]u8, p: *Point) -> usize {\n    i.*+= 1\n    if i.*== 3 { return o.?.len }\n    match p.*{ _ => {} }\n    let q = p.*.x + p.*.y *(q - 1)\n    let s = if q > 0 { o.?} else { \"\" }\n    return s.len\n}\n"
    let pwant = "fn f(i: *mut usize, o: ?[]u8, p: *Point) -> usize {\n    i.* += 1\n    if i.* == 3 { return o.?.len }\n    match p.* { _ => { } }\n    let q = p.*.x + p.*.y * (q - 1)\n    let s = if q > 0 { o.? } else { \"\" }\n    return s.len\n}\n"
    fs.write(post[..], ptext) catch { }
    let pf = nx(e, ["fmt", post[..]][..])
    let pgot = normalize((fs.read(post[..]) catch { String.new() })[..])
    if pf.code != 0 or pgot[..] != pwant { failures.append(format("fmt: `.*`, `.?` and `* (` spacing (exit {}):\n{}{}", .{pf.code, pgot, pf.stderr})) }
    // a body brace after a slice or array return type is a body, not a literal
    let rty = fs.join(e.root[..], "nx-out/cases/return_types.nx")
    let rtext = "fn a() -> []Point { return [] }\nfn b() -> [2]Point { return undefined }\nfn c() -> []mut Point { return [] }\nfn d() -> ?[]Point { return null }\nfn e() -> Point { return Point{ .x = 1 } }\nfn f(p: *mut Point) -> *mut Point { return p }\nfn g(p: *mut Point) -> ?*mut Point { return p }\n"
    fs.write(rty[..], rtext) catch { }
    let rf = nx(e, ["fmt", rty[..]][..])
    let rgot = normalize((fs.read(rty[..]) catch { String.new() })[..])
    if rf.code != 0 or rgot[..] != rtext { failures.append(format("fmt: a body brace after a slice return type (exit {}):\n{}{}", .{rf.code, rgot, rf.stderr})) }
    println("fmt: {} files", .{files.len})
}

fn has_str(xs: *List(String), v: []u8) -> bool {
    for x in xs.* { if x[..] == v { return true } }
    return false
}

/// The course: every exercise's solution passes its own check, every
/// starter fails it the way its kind says, the compiler embeds every one,
/// and `nx topo` walks a chapter from the map to "all of it".
fn suite_exercises(e: *Env, failures: *mut List(String)) {
    var listed = List(String).new()
    var n: usize = 0
    let dirs = fs.list("topo/exercises") catch { List(String).new() }
    for d in dirs {
        let dir = fs.join("topo/exercises", d[..])
        if !fs.is_dir(dir[..]) { continue }
        let names = fs.list(dir[..]) catch { continue }
        for nm in names {
            if nm[..] == "quiz.txt" { listed.append(format("{}/quiz", .{d})); continue }
            if !nm[..].ends_with(".nx") or nm[..].ends_with(".solution.nx") { continue }
            n += 1
            let name = fs.stem(nm[..])
            let kind = name[..(name.find("_") orelse name.len)]
            listed.append(format("{}/{}", .{d, name}))
            let starter = fs.join(dir[..], nm[..])
            let solution = fs.join(dir[..], format("{}.solution.nx", .{name})[..])
            let expected_path = fs.join(dir[..], format("{}.expected", .{name})[..])
            let out_dir = format("{}/nx-out/cases/ex-{}-{}", .{e.root, d, name})
            let text = fs.read(starter[..]) catch { String.new() }
            if kind == "fill" or kind == "write" {
                if text[..].find("???") == null { failures.append(format("topo: {} has no ??? hole", .{starter})) }
            } else if kind == "fix" {
                let c = nx(e, ["check", starter[..]][..])
                if c.code == 0 { failures.append(format("topo: {} is accepted but should need fixing", .{starter})) }
            } else if kind == "test" {
                let t = nx(e, ["test", starter[..], "--out-dir", out_dir[..]][..])
                if t.code == 0 { failures.append(format("topo: the tests of {} pass before the fix", .{starter})) }
            } else if kind != "predict" {
                failures.append(format("topo: {} has an unknown kind `{}`", .{starter, kind}))
            }
            // the solution passes, or the program itself for a prediction
            let program = if kind == "predict" { starter.clone() } else { solution.clone() }
            if kind == "write" or kind == "test" {
                let t = nx(e, ["test", program[..], "--out-dir", out_dir[..]][..])
                if t.code != 0 { failures.append(format("topo: the solution {} fails its tests:\n{}{}", .{program, t.stdout, t.stderr})) }
            }
            if fs.exists(expected_path[..]) {
                let r = nx(e, ["run", program[..], "--out-dir", out_dir[..]][..])
                let expected = normalize((fs.read(expected_path[..]) catch { String.new() })[..])
                if r.code != 0 { failures.append(format("topo: {} does not run:\n{}", .{program, r.stderr})) }
                else if let diff = same_text(expected[..].trim(), normalize(r.stdout[..])[..].trim(), format("output of {} differs", .{program})[..]) { failures.append(diff) }
            }
            let f = nx(e, ["fmt", program[..], "--check"][..])
            if f.code != 0 { failures.append(format("topo: {} is not canonically formatted:\n{}{}", .{program, f.stdout, f.stderr})) }
        }
    }
    // the compiler embeds every one, and nothing else
    let l = nx(e, ["topo", "list"][..])
    var embedded = List(String).new()
    for line in l.stdout[..].lines() { if line.trim().len > 0 { embedded.append(String.from(line.trim())) } }
    for k in listed { if !has_str(&embedded, k[..]) { failures.append(format("topo: {} is not embedded in self/topo.nx", .{k})) } }
    for k in embedded { if !has_str(&listed, k[..]) { failures.append(format("topo: self/topo.nx embeds {}, which topo/exercises lacks", .{k})) } }
    // the quiz questions that ask the compiler are answered by it now
    let v = nx(e, ["topo", "verify"][..])
    if v.code != 0 { failures.append(format("topo: the quizzes disagree with the compiler:\n{}{}", .{v.stdout, v.stderr})) }
    // a chapter, walked: the map, the start, the starters failing, the
    // solutions passing, the quiz answered, the progress recorded
    let work = fs.join(e.root[..], "nx-out/cases/topo-course")
    fs.remove_all(work[..]) catch { }
    fs.make_dirs(work[..]) catch { }
    let progress = fs.join(work[..], "progress.txt")
    os.set_env("NX_TOPO_PROGRESS", progress[..])
    let m0 = nx_in(e, ["topo"][..], "", work[..])
    if m0.code != 0 or m0.stdout[..].find("Values and types") == null or m0.stdout[..].find("0/4 done") == null { failures.append(format("topo: the map:\n{}{}", .{m0.stdout, m0.stderr})) }
    let s = nx_in(e, ["topo", "5"][..], "", work[..])
    let chapter = fs.join(work[..], "topo-05-values-and-types")
    if s.code != 0 or !fs.exists(fs.join(chapter[..], "fill_wrap.nx")[..]) { failures.append(format("topo: starting chapter 5:\n{}{}", .{s.stdout, s.stderr})) }
    let c0 = nx_in(e, ["topo", "check"][..], "", work[..])
    if c0.code == 0 or c0.stdout[..].find("still has a hole") == null { failures.append(format("topo: the starters should not pass:\n{}{}", .{c0.stdout, c0.stderr})) }
    for nm in ["fill_wrap", "fix_widths"] {
        fs.copy(format("topo/exercises/05-values-and-types/{}.solution.nx", .{nm})[..], fs.join(chapter[..], format("{}.nx", .{nm})[..])[..]) catch { failures.append(format("topo: cannot copy the solution of {}", .{nm})) }
    }
    fs.write(fs.join(chapter[..], "predict_slices.guess")[..], "3 5 11\n9 camp\n") catch { }
    let c1 = nx_in(e, ["topo", "check"][..], "", work[..])
    if c1.code != 0 { failures.append(format("topo: the solutions should pass:\n{}{}", .{c1.stdout, c1.stderr})) }
    let q = nx_in(e, ["topo", "quiz", "5"][..], "2\n2\n2\n", work[..])
    if q.code != 0 or q.stdout[..].find("3 of 3 right") == null { failures.append(format("topo: the quiz:\n{}{}", .{q.stdout, q.stderr})) }
    let m1 = nx_in(e, ["topo"][..], "", work[..])
    if m1.stdout[..].find("4/4 done, all of it") == null { failures.append(format("topo: the map after the chapter:\n{}{}", .{m1.stdout, m1.stderr})) }
    let h = nx_in(e, ["topo", "hint", "topo-05-values-and-types/fill_wrap.nx"][..], "", work[..])
    if h.code != 0 or h.stdout[..].find("hint 1:") == null { failures.append(format("topo: hints:\n{}{}", .{h.stdout, h.stderr})) }
    os.set_env("NX_TOPO_PROGRESS", "")
    println("topo: {} exercises checked, and the course walked", .{n})
}

// ----- the tool suites ------------------------------------------------------------

fn program_found(e: *Env, name: []u8) -> bool {
    let out = run(e, [name, "--version"][..])
    return out.code == 0
}

/// `nx ship` on a library: the header, the Python package and wheel, the
/// Rust crate (built when cargo is around), the npm package (run when node is).
fn suite_ship(e: *Env, failures: *mut List(String)) {
    // a struct reached only through `self` pointers of trait methods, in a
    // library with no `main`, is defined, not left an incomplete type
    fs.make_dirs(fs.join(e.root[..], "nx-out/cases")[..]) catch { }
    let plib = fs.join(e.root[..], "nx-out/cases/ptr_only.nx")
    fs.write(plib[..], "trait Shape {\n    fn area(self: *Self) -> f64\n}\n\nstruct Square { side: f64 }\n\nimpl Shape for Square {\n    fn area(self: *Self) -> f64 { return self.side * self.side }\n}\n") catch { }
    let pb = nx(e, ["build", plib[..], "--out-dir", fs.join(e.root[..], "nx-out/cases/ptr_only")[..]][..])
    if pb.code != 0 { failures.append(format("ship: a library whose struct is used only through pointers does not build:\n{}", .{pb.stderr})) }
    let out_dir = fs.join(e.root[..], "nx-out/ship-test")
    fs.remove_all(out_dir[..]) catch { }
    let out = nx(e, ["ship", "examples/ropesim.nx", "--out-dir", out_dir[..]][..])
    if out.code != 0 { failures.append(format("ship: failed:\n{}", .{out.stderr})); return }
    let lib = fs.join(out_dir[..], "ropesim")
    for rel in ["ropesim.h", "python/ropesim/__init__.py", "rust/Cargo.toml", "node/index.js", "node/index.d.ts", "node/package.json"] {
        if !fs.exists(fs.join(lib[..], rel)[..]) { failures.append(format("ship: {} was not produced", .{rel})) }
    }
    var has_wheel = false
    for n in fs.list(lib[..]) catch { List(String).new() } { if n[..].ends_with(".whl") { has_wheel = true } }
    if !has_wheel { failures.append(String.from("ship: no wheel produced")) }
    let dts = fs.read(fs.join(lib[..], "node/index.d.ts")[..]) catch { String.new() }
    if dts[..].find("export function dot(a: Float64Array | ArrayLike<number>, b: Float64Array | ArrayLike<number>): number;") == null {
        failures.append(format("ship: typings:\n{}", .{dts}))
    }
    if program_found(e, "cargo") {
        let build = run_in(e, ["cargo", "build", "-q"][..], "", fs.join(lib[..], "rust")[..])
        if build.code != 0 { failures.append(format("ship: the generated crate does not build:\n{}", .{build.stderr})) }
    } else {
        println("ship: cargo not found; the Rust crate is not built", .{})
    }
    let npm = if e.windows { "npm.cmd" } else { "npm" }
    let node_dir = fs.join(lib[..], "node")
    if program_found(e, npm) {
        let install = run_in(e, [npm, "install", "--silent", "--no-audit", "--no-fund"][..], "", node_dir[..])
        if install.code == 0 {
            let script = "const m = require('.'); const pos = new Float64Array([0, 1, 2]); const r = m.simulate(pos, 0.1, 3); let err = ''; try { m.dot([1, 2], [1]); } catch (e) { err = e.errorName; } let panic = ''; try { m.divide(1n, 0n); } catch (e) { panic = e.name; } console.log(JSON.stringify({ dot: m.dot([1, 2, 3], [4, 5, 6]), sum: m.checksum('hello') > 0, moved: pos[1] !== 1, r: r > 0, err, panic, div: String(m.divide(84n, 2n)) }));"
            let node = run_in(e, ["node", "-e", script][..], "", node_dir[..])
            if node.code != 0 {
                failures.append(format("ship: the node package failed:\n{}", .{node.stderr}))
            } else if node.text() != "{\"dot\":32,\"sum\":true,\"moved\":true,\"r\":true,\"err\":\"InvalidInput\",\"panic\":\"NexiumPanic\",\"div\":\"42\"}" {
                failures.append(format("ship: the node package answered:\n{}", .{node.stdout}))
            }
        } else {
            println("ship: npm install failed (offline?); the node run is skipped", .{})
        }
    } else {
        println("ship: npm not found; the node package is not run", .{})
    }
    // a panic caught at the export boundary releases what the call acquired:
    // 200 calls that open a file and panic, then an open that must succeed
    // (the runtime has 64 file slots; before the tracker they were all leaked)
    let bdir = fs.join(e.root[..], "nx-out/ship-test/boundary-out")
    let bship = nx(e, ["ship", "tests/ship/boundary.nx", "--out-dir", bdir[..]][..])
    if bship.code != 0 { failures.append(format("ship: the boundary library failed to ship:\n{}", .{bship.stderr})); return }
    let blib = fs.join(bdir[..], "boundary")
    // the generated C is linked in directly: every emitted function is static
    // and the runtime is inlined, so the two programs share nothing but the exports
    let host = "const lib = @cImport(\"boundary.h\")\nartifact link { c_sources = [\"boundary.c\"] }\nfn main() {\n    let path: []u8 = \"boundary.h\"\n    var panics: i64 = 0\n    for _ in 0..200 {\n        var out: i64 = 0\n        let code = unsafe { lib.open_then_panic(path.ptr, path.len, 0, &mut out) }\n        if code != 0 { panics += 1 }\n    }\n    var ok: i64 = 0\n    let code = unsafe { lib.can_open(path.ptr, path.len, &mut ok) }\n    println(\"{} {} {}\", .{panics, code, ok})\n}\n"
    fs.write(fs.join(blib[..], "boundary_host.nx")[..], host) catch { failures.append(String.from("ship: cannot write the boundary host")); return }
    let bhost = nx_in(e, ["run", "boundary_host.nx"][..], "", blib[..])
    if bhost.code != 0 {
        failures.append(format("ship: the boundary host failed:\n{}{}", .{bhost.stdout, bhost.stderr}))
    } else if bhost.text() != "200 0 1" {
        failures.append(format("ship: after 200 panicking calls the boundary answered `{}` (want `200 0 true`: every panic reported, the file slots released)", .{bhost.text()}))
    }
    fs.remove_all(out_dir[..]) catch { }
    println("ship: the library artifacts, and the export boundary releasing what a panic left", .{})
}

/// The GUI's headless tests and the offscreen demo; then a build from
/// inside the directory with a bare file name (the declared C source must
/// still be compiled in).
fn suite_gui(e: *Env, failures: *mut List(String)) {
    let t = nx(e, ["test", "gui/nexium_gui.nx"][..])
    if t.code != 0 { failures.append(format("gui: tests failed:\n{}{}", .{t.stdout, t.stderr})); return }
    let shot = fs.join(e.root[..], "nx-out/demo-shot.ppm")
    let d = nx(e, ["run", "gui/demo.nx", "--", "--shot", shot[..]][..])
    if d.code != 0 { failures.append(format("gui: the offscreen demo failed:\n{}", .{d.stderr})); return }
    let size = fs.size(shot[..]) catch { 0 }
    if size <= 640 * 440 * 3 { failures.append(String.from("gui: the screenshot was not written")) }
    let bare = nx_in(e, ["build", "demo.nx", "--out-dir", fs.join(e.root[..], "nx-out/demo-bare")[..]][..], "", fs.join(e.root[..], "gui")[..])
    if bare.code != 0 { failures.append(format("gui: a build with a bare file name failed:\n{}", .{bare.stderr})) }
    println("gui: headless tests, the demo, a bare-name build", .{})
}

/// Packages: a manifest with a path dependency, `import dep` (src/lib.nx),
/// `import dep.module`, a package importing its own sibling, and a lock file.
fn suite_packages(e: *Env, failures: *mut List(String)) {
    let base = fs.join(e.root[..], "nx-out/pkg-test")
    fs.remove_all(base[..]) catch { }
    let files = [
        ("words/nexium.toml", "[package]\nname = \"words\"\nversion = \"0.1.0\"\n"),
        ("words/src/lib.nx", "pub fn planet() -> []u8 { return \"world\" }\n"),
        ("greet/nexium.toml", "[package]\nname = \"greet\"\nversion = \"0.1.0\"\n\n[dependencies]\nwords = { path = \"../words\" }\n"),
        ("greet/src/lib.nx", "import util\nimport words\npub fn hello() -> String { return util.wrap(words.planet()) }\n"),
        ("greet/src/util.nx", "pub fn wrap(s: []u8) -> String { var out = String.from(\"hello, \"); out.append(s); return out }\n"),
        ("greet/src/extra.nx", "pub fn punct() -> []u8 { return \"!\" }\n"),
        ("app/nexium.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\ngreet = { path = \"../greet\" }\n"),
        ("app/main.nx", "import greet\nimport greet.extra\nfn main() {\n    println(\"{}{}\", .{greet.hello(), extra.punct()})\n}\n"),
    ]
    for f in files {
        let p = fs.join(base[..], f.0)
        fs.make_dirs(fs.parent(p[..])) catch { }
        fs.write(p[..], f.1) catch { failures.append(format("packages: cannot write {}", .{p})); return }
    }
    let app = fs.join(base[..], "app")
    let out = nx_in(e, ["run", "main.nx"][..], "", app[..])
    if out.code != 0 { failures.append(format("packages: the program failed:\n{}", .{out.stderr})); return }
    if out.text() != "hello, world!" { failures.append(format("packages: the program printed {}", .{out.stdout})) }
    let fetch_args = ["fetch"]
    let fetch = nx_in(e, fetch_args[..], "", app[..])
    if fetch.code != 0 { failures.append(format("packages: nx fetch failed:\n{}", .{fetch.stderr})); return }
    let lock = fs.read(fs.join(app[..], "nexium.lock")[..]) catch { String.new() }
    if lock[..].find("greet\tpath\t../greet") == null { failures.append(format("packages: lock file:\n{}", .{lock})) }
    if lock[..].find("words\tpath") == null { failures.append(format("packages: the transitive dependency is missing from the lock:\n{}", .{lock})) }
    // a git dependency: the lock pins the commit, so a moved tag does not move
    // a build until `nx update` asks for it
    if !program_found(e, "git") {
        println("packages: path dependencies, module imports, the lock file (git not found: the git dependency is not tested)", .{})
        return
    }
    let repo = fs.join(base[..], "gitdep")
    fs.make_dirs(fs.join(repo[..], "src")[..]) catch { }
    fs.write(fs.join(repo[..], "nexium.toml")[..], "[package]\nname = \"gitdep\"\nversion = \"0.1.0\"\n") catch { }
    fs.write(fs.join(repo[..], "src/lib.nx")[..], "pub fn v() -> i32 { return 1 }\n") catch { }
    // and a second package in a directory of the same repository
    fs.make_dirs(fs.join(repo[..], "sdk/src")[..]) catch { }
    fs.write(fs.join(repo[..], "sdk/nexium.toml")[..], "[package]\nname = \"sdk\"\nversion = \"0.1.0\"\n") catch { }
    fs.write(fs.join(repo[..], "sdk/src/lib.nx")[..], "pub fn w() -> i32 { return 10 }\n") catch { }
    let gitc = ["git", "-c", "user.email=t@t", "-c", "user.name=t", "-c", "commit.gpgsign=false"]
    var g = List([]u8).new()
    for a in gitc { g.append(a) }
    for step in [["init", "-q", "-b", "main"][..], ["add", "."][..], ["commit", "-qm", "one"][..], ["tag", "v1"][..]] {
        var argv = g.clone()
        for a in step { argv.append(a) }
        let r = run_in(e, argv[..], "", repo[..])
        if r.code != 0 { failures.append(format("packages: git {} failed:\n{}", .{step[0], r.stderr})); return }
    }
    let url = strings.replace(repo[..], "\\", "/")
    let gitapp = fs.join(base[..], "gitapp")
    fs.make_dirs(gitapp[..]) catch { }
    fs.write(fs.join(gitapp[..], "nexium.toml")[..], format("[package]\nname = \"gitapp\"\nversion = \"0.1.0\"\n\n[dependencies]\ngitdep = {{ git = \"{}\", tag = \"v1\" }}\n", .{url})[..]) catch { }
    fs.write(fs.join(gitapp[..], "main.nx")[..], "import gitdep\nfn main() { println(\"{}\", .{gitdep.v()}) }\n") catch { }
    let f1 = nx_in(e, ["fetch"][..], "", gitapp[..])
    if f1.code != 0 { failures.append(format("packages: nx fetch of a git dependency failed:\n{}", .{f1.stderr})); return }
    let r1 = nx_in(e, ["run", "main.nx"][..], "", gitapp[..])
    if r1.text() != "1" { failures.append(format("packages: the git dependency at v1 printed {} {}", .{r1.stdout, r1.stderr})); return }
    let lock1 = fs.read(fs.join(gitapp[..], "nexium.lock")[..]) catch { String.new() }
    // the tag moves to a second commit
    fs.write(fs.join(repo[..], "src/lib.nx")[..], "pub fn v() -> i32 { return 2 }\n") catch { }
    for step in [["commit", "-qam", "two"][..], ["tag", "-f", "v1"][..]] {
        var argv = g.clone()
        for a in step { argv.append(a) }
        let r = run_in(e, argv[..], "", repo[..])
        if r.code != 0 { failures.append(format("packages: git {} failed:\n{}", .{step[0], r.stderr})); return }
    }
    // a fresh machine: no modules, the lock committed; fetch must give the locked commit
    fs.remove_all(fs.join(gitapp[..], "nexium_modules")[..]) catch { }
    let f2 = nx_in(e, ["fetch"][..], "", gitapp[..])
    if f2.code != 0 { failures.append(format("packages: nx fetch from the lock failed:\n{}", .{f2.stderr})); return }
    let r2 = nx_in(e, ["run", "main.nx"][..], "", gitapp[..])
    if r2.text() != "1" { failures.append(format("packages: after the tag moved, fetch from the lock printed {} (the lock was not honoured)", .{r2.stdout})); return }
    let lock2 = fs.read(fs.join(gitapp[..], "nexium.lock")[..]) catch { String.new() }
    if lock2[..] != lock1[..] { failures.append(format("packages: fetch rewrote the lock:\n{}\nwas:\n{}", .{lock2, lock1})); return }
    // `nx update` is what follows the tag
    let u = nx_in(e, ["update", "gitdep"][..], "", gitapp[..])
    if u.code != 0 { failures.append(format("packages: nx update failed:\n{}", .{u.stderr})); return }
    let r3 = nx_in(e, ["run", "main.nx"][..], "", gitapp[..])
    if r3.text() != "2" { failures.append(format("packages: after nx update the program printed {}", .{r3.stdout})); return }
    let lock3 = fs.read(fs.join(gitapp[..], "nexium.lock")[..]) catch { String.new() }
    if lock3[..] == lock1[..] { failures.append(String.from("packages: nx update did not rewrite the lock")) }
    // a package in a directory of the repository: `dir` names it
    let gitapp2 = fs.join(base[..], "gitapp2")
    fs.make_dirs(gitapp2[..]) catch { }
    fs.write(fs.join(gitapp2[..], "nexium.toml")[..], format("[package]\nname = \"gitapp2\"\nversion = \"0.1.0\"\n\n[dependencies]\nsdk = {{ git = \"{}\", tag = \"v1\", dir = \"sdk\" }}\n", .{url})[..]) catch { }
    fs.write(fs.join(gitapp2[..], "main.nx")[..], "import sdk\nfn main() { println(\"{}\", .{sdk.w()}) }\n") catch { }
    let f3 = nx_in(e, ["fetch"][..], "", gitapp2[..])
    if f3.code != 0 { failures.append(format("packages: nx fetch of a package in a directory failed:\n{}", .{f3.stderr})); return }
    let r3 = nx_in(e, ["run", "main.nx"][..], "", gitapp2[..])
    if r3.text() != "10" { failures.append(format("packages: the package in a directory printed {} {}", .{r3.stdout, r3.stderr})); return }
    println("packages: path dependencies, module imports, the lock file, a git dependency whose tag moves, a package in a directory", .{})
}

/// `artifact installer`: `nx ship` writes an Inno Setup script on Windows
/// and an install script elsewhere, next to the built program.
fn suite_installer(e: *Env, failures: *mut List(String)) {
    let base = fs.join(e.root[..], "nx-out/installer-test")
    fs.remove_all(base[..]) catch { }
    fs.make_dirs(fs.join(base[..], "assets")[..]) catch { }
    let files = [
        ("assets/data.txt", "data\n"),
        ("LICENSE", "MIT\n"),
        ("README.md", "# Greeter\n"),
        ("greeter.nx", "artifact cli { name = \"greeter\" }\nartifact installer { name = \"Greeter\", publisher = \"Londopy\", version = \"1.0.0\", license = \"LICENSE\", readme = \"README.md\", files = [\"assets\"], add_to_path = true }\nfn main() { println(\"hi\", .{}) }\n"),
    ]
    for f in files { fs.write(fs.join(base[..], f.0)[..], f.1) catch { failures.append(format("installer: cannot write {}", .{f.0})); return } }
    // an installed Inno Setup would also compile the script; the script itself is what this checks
    os.set_env("ISCC", "")
    let out = nx_in(e, ["ship", "greeter.nx"][..], "", base[..])
    if out.code != 0 { failures.append(format("installer: nx ship failed:\n{}", .{out.stderr})); return }
    let dir = fs.join(base[..], "nx-out/greeter")
    if !fs.exists(fs.join(dir[..], "assets/data.txt")[..]) { failures.append(String.from("installer: files were not copied next to the program")) }
    if e.windows {
        let iss = fs.read(fs.join(dir[..], "Greeter.iss")[..]) catch { failures.append(String.from("installer: no Greeter.iss")); return }
        for want in ["AppName=Greeter", "AppVersion=1.0.0", "addtopath", "assets\\*", "AppId={{", "SetupMutex=GreeterSetupMutex", "CloseApplications=yes", "SetupLogging=yes", "install.log", "Another Greeter installer"] {
            if iss[..].find(want) == null { failures.append(format("installer: the script lacks `{}`:\n{}", .{want, iss})) }
        }
    } else {
        let sh = fs.read(fs.join(dir[..], "install.sh")[..]) catch { failures.append(String.from("installer: no install.sh")); return }
        for want in ["copy_tree 'assets'", "exe='greeter'"] {
            if sh[..].find(want) == null { failures.append(format("installer: the script lacks `{}`:\n{}", .{want, sh})) }
        }
        if !fs.exists(fs.join(dir[..], "greeter-1.0.0-linux.tar.gz")[..]) and !fs.exists(fs.join(dir[..], "greeter-1.0.0-macos.tar.gz")[..]) {
            failures.append(String.from("installer: no archive was written"))
        }
    }
    println("installer: the scripts and the staged files", .{})
}

/// The REPL evaluates lines, keeps bindings, accepts items, reports errors, and prints.
fn suite_repl(e: *Env, failures: *mut List(String)) {
    let script = "let x = 2\nx * 21\nfn sq(n: i32) -> i32 { return n * n }\nsq(x)\nprintln(\"hi {}\", .{x})\nimport std.strings\nstrings.to_upper(\"ok\")\nlet s = String.from(\"a\")\ns\nundefined_name\nnx upgrade\nlet q = 1 +\nvar xs = List(i32).new()\nxs.append(7)\nxs\n:effects xs.append(8)\n:effects x\nlet y = 5\n:undo\n:vars\n:save nx-out/repl-session.nx\n:quit\n"
    let repl_args = ["repl"]
    let out = nx_in(e, repl_args[..], script, e.root[..])
    if out.code != 0 { failures.append(format("repl: exited with {}:\n{}", .{out.code, out.stderr})); return }
    for want in ["i64: 42", "i32: 4", "hi 2", "String: \"OK\"", "String: \"a\"", "List(i32): [7]"] {
        if out.stdout[..].find(want) == null { failures.append(format("repl: missing `{}` in:\n{}", .{want, out.stdout})) }
    }
    if out.stderr[..].find("undefined_name") == null { failures.append(format("repl: the error for an unknown name was not reported:\n{}", .{out.stderr})) }
    // a command for the terminal is named as one, an input cut short says so,
    // and nothing points into the program the REPL builds around the input
    for want in ["`nx upgrade` is a command for the terminal", "the input ends in the middle of a statement"] {
        if out.stderr[..].find(want) == null { failures.append(format("repl: missing `{}` in:\n{}", .{want, out.stderr})) }
    }
    for leak in ["error at ", "<repl>", "`return`"] {
        if out.stderr[..].find(leak) != null { failures.append(format("repl: `{}` from the synthetic program shown in:\n{}", .{leak, out.stderr})) }
    }
    // :effects names the effects of an expression with the bindings in scope
    for want in ["effects: allocates", "effects: none"] {
        if out.stdout[..].find(want) == null { failures.append(format("repl: missing `{}` in:\n{}", .{want, out.stdout})) }
    }
    // :undo takes the binding back; :vars after it does not list y
    if out.stdout[..].find("undone: let y = 5") == null or out.stdout[..].find("y: i64") != null {
        failures.append(format("repl: :undo did not take `let y = 5` back:\n{}", .{out.stdout}))
    }
    // :save writes a program with the items and the statements
    let saved = fs.read(fs.join(e.root[..], "nx-out/repl-session.nx")[..]) catch { String.new() }
    if saved[..].find("fn sq(n: i32)") == null or saved[..].find("fn main() -> !void") == null or saved[..].find("_ = x * 21") == null {
        failures.append(format("repl: :save did not write the session:\n{}", .{saved}))
    }
    // the prompt's colours: a keyword bold blue, a string green (the editor
    // itself needs a terminal; :colour renders a line the way it would)
    let col = nx_in(e, ["repl"][..], ":colour let s = \"hi\"\n:quit\n", e.root[..])
    if col.stdout[..].find("\x1b[1;34mlet\x1b[0m") == null or col.stdout[..].find("\x1b[32m\"hi\"\x1b[0m") == null {
        failures.append(format("repl: :colour did not colour the line:\n{}", .{col.stdout}))
    }
    // nx -p prints a value, nx -e runs lines
    let p = nx(e, ["-p", "2 * 21"][..])
    if p.code != 0 or p.text() != "42" { failures.append(format("repl: nx -p answered `{}` (exit {}):\n{}", .{p.text(), p.code, p.stderr})) }
    let ev = nx(e, ["-e", "fn f() -> i32 { return 7 }\nprintln(\"f is {}\", .{f()})"][..])
    if ev.code != 0 or ev.text() != "f is 7" { failures.append(format("repl: nx -e answered `{}` (exit {}):\n{}", .{ev.text(), ev.code, ev.stderr})) }
    let bad = nx(e, ["-p", "no_such_name"][..])
    if bad.code == 0 { failures.append(String.from("repl: nx -p of an unknown name did not fail")) }
    println("repl: a session and its diagnostics, :effects, :undo and :save; nx -e and nx -p", .{})
}

/// What `nx play` says when a program needs a compiled run: those programs
/// are refused, which the playground shows, rather than run differently.
fn play_refused(stderr: []u8) -> bool {
    for m in ["the interpreter cannot run this program", "has no `main`", "call depth", "step budget", "C preprocessor failed"] {
        if stderr.find(m) != null { return true }
    }
    return false
}

/// `nx play`, the playground's command, against the recorded outputs. Every
/// spec case, example and Topo program with an `.expected` is interpreted
/// instead of compiled and must print what the compiled program printed, or
/// be refused; it never prints something else. Every fill and fix exercise of
/// chapters 2 to 15 runs in the page, so its solution must print its
/// recorded output from stdin with no refusal, and a fix starter must fail
/// with the compiler's diagnostics, as `nx topo check` grades them.
fn suite_play(e: *Env, failures: *mut List(String)) {
    var same: usize = 0
    var refused: usize = 0
    var files = List(String).new()
    for dir in ["tests/spec", "examples", "topo/code"] {
        for f in tree_files(dir) { files.append(f.clone()) }
    }
    for f in files {
        let expected_path = fs.with_extension(f[..], "expected")
        let expected = fs.read(expected_path[..]) catch { continue }
        let out = nx(e, ["play", f[..]][..])
        if play_refused(out.stderr[..]) {
            refused += 1
            continue
        }
        var got = normalize(out.stdout[..])
        got.append(normalize(out.stderr[..])[..])
        if let d = same_text(normalize(expected[..])[..].trim(), got[..].trim(), format("nx play of {} differs from the compiled run", .{f})[..]) {
            failures.append(d)
        } else {
            same += 1
        }
    }
    var graded: usize = 0
    let chapters = fs.list("topo/exercises") catch { List(String).new() }
    for ch in chapters {
        let num = ch[..].split("-")[0].parse_int(u32) catch { continue }
        if num < 2 or num > 15 { continue }
        let dir = fs.join("topo/exercises", ch[..])
        let names = fs.list(dir[..]) catch { continue }
        for n in names {
            if ! (n[..].starts_with("fill_") or n[..].starts_with("fix_")) { continue }
            let path = fs.join(dir[..], n[..])
            if n[..].ends_with(".solution.nx") {
                let stem = fs.stem(fs.stem(n[..])[..])
                let want = fs.read(fs.join(dir[..], format("{}.expected", .{stem})[..])[..]) catch { continue }
                let text = fs.read(path[..]) catch { String.new() }
                let out = nx_in(e, ["play"][..], text[..], e.root[..])
                if out.code != 0 {
                    failures.append(format("nx play: the solution {} does not run in the page (exit {}):\n{}", .{path, out.code, out.stderr}))
                } else if let d = same_text(normalize(want[..])[..].trim(), normalize(out.stdout[..])[..].trim(), format("nx play of {}", .{path})[..]) {
                    failures.append(d)
                }
                graded += 1
            } else if n[..].starts_with("fix_") and n[..].ends_with(".nx") {
                let text = fs.read(path[..]) catch { String.new() }
                let out = nx_in(e, ["play"][..], text[..], e.root[..])
                if out.code != 1 or out.stderr[..].find("error") == null {
                    failures.append(format("nx play: the starter {} must fail with diagnostics (exit {}):\n{}", .{path, out.code, out.stderr}))
                }
                graded += 1
            }
        }
    }
    // the exit codes: main's own, 1 after an error, 2 after a panic
    let code = nx_in(e, ["play"][..], "fn main() -> u8 {\n    return 7\n}\n", e.root[..])
    if code.code != 7 { failures.append(format("nx play: main returning 7 exited with {}", .{code.code})) }
    let pan = nx_in(e, ["play"][..], "fn main() {\n    let xs = [1, 2]\n    var i: usize = 4\n    println(\"{}\", .{xs[i]})\n}\n", e.root[..])
    if pan.code != 2 or pan.stderr[..].find("panic: index 4 out of bounds for length 2") == null or pan.stderr[..].find("at main.nx:4") == null {
        failures.append(format("nx play: a panic exited with {}:\n{}", .{pan.code, pan.stderr}))
    }
    let empty = nx_in(e, ["play"][..], "  ", e.root[..])
    if empty.code != 1 or empty.stderr[..].find("the program is empty") == null {
        failures.append(format("nx play: an empty program answered (exit {}):\n{}", .{empty.code, empty.stderr}))
    }
    let spin = nx_in(e, ["play"][..], "fn main() {\n    var n: u64 = 0\n    while true { n += 1 }\n}\n", e.root[..])
    if spin.code != 2 or spin.stderr[..].find("step budget") == null {
        failures.append(format("nx play: an endless loop was not stopped by the step budget (exit {}):\n{}", .{spin.code, spin.stderr}))
    }
    println("play: {} programs as compiled, {} refused, {} exercises graded", .{same, refused, graded})
}

fn frame(body: []u8) -> String {
    return format("Content-Length: {}\r\n\r\n{}", .{body.len, body})
}

fn json_escape(s: []u8) -> String {
    return strings.replace(strings.replace(strings.replace(s, "\\", "\\\\")[..], "\"", "\\\"")[..], "\n", "\\n")
}

/// The response with the given id, up to the next frame.
fn response(out: []u8, id: usize) -> []u8 {
    var start = out.find(format("\"id\":{},", .{id})[..])
    if start == null { start = out.find(format("\"id\":{}}}", .{id})[..]) }
    let s = start orelse return ""
    let rest = out[s..]
    let end = rest.find("Content-Length") orelse rest.len
    return rest[0..end]
}

/// The language server over stdio: diagnostics, go to definition,
/// completion and rename, driven the way an editor drives them.
fn suite_lsp(e: *Env, failures: *mut List(String)) {
    let dir = fs.join(e.root[..], "nx-out/lsp-test")
    fs.make_dirs(dir[..]) catch { }
    fs.write(fs.join(dir[..], "helper.nx")[..], "pub fn twice(x: i32) -> i32 { return x * 2 }\npub const LIMIT: i32 = 10\n") catch { failures.append(String.from("lsp: cannot write helper.nx")); return }
    let main = fs.join(dir[..], "main.nx")
    let text = "import helper\n\nstruct Point { x: i32, y: i32 }\n\nfn origin() -> Point { return Point{ .x = 0, .y = 0 } }\n\nfn main() {\n    let total = helper.twice(3)\n    let p = origin()\n    println(\"{} {}\", .{total + p.x, helper.LIMIT})\n    let again = total\n    for item, idx in [1, 2] { println(\"{}\", .{item + idx}) }\n}\n"
    fs.write(main[..], text) catch { failures.append(String.from("lsp: cannot write main.nx")); return }
    let uri = format("file:///{}", .{strings.replace(strings.replace(main[..], "\\", "/")[..], ":", "%3A")})
    var input = String.new()
    input.append(frame("{\"jsonrpc\":\"2.0\",\"id\":0,\"method\":\"initialize\",\"params\":{}}")[..])
    input.append(frame(format("{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"{}\",\"languageId\":\"nexium\",\"version\":1,\"text\":\"{}\"}}}}}}", .{uri, json_escape(text)})[..])[..])
    // (id, method, line, character): `helper.twice` on line 7, `origin()` on 8, the local `total` on 10,
    // completion after `helper.` and after `p.` on line 9, `idx` on line 11
    let asks = [(1, "definition", 7, 24), (2, "definition", 8, 13), (3, "definition", 10, 17), (4, "completion", 9, 43), (5, "completion", 9, 33), (7, "definition", 11, 53)]
    for a in asks {
        input.append(frame(format("{{\"jsonrpc\":\"2.0\",\"id\":{},\"method\":\"textDocument/{}\",\"params\":{{\"textDocument\":{{\"uri\":\"{}\"}},\"position\":{{\"line\":{},\"character\":{}}}}}}}", .{a.0, a.1, uri, a.2, a.3})[..])[..])
    }
    input.append(frame(format("{{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"textDocument/rename\",\"params\":{{\"textDocument\":{{\"uri\":\"{}\"}},\"position\":{{\"line\":10,\"character\":17}},\"newName\":\"sum\"}}}}", .{uri})[..])[..])
    input.append(frame(format("{{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"textDocument/codeLens\",\"params\":{{\"textDocument\":{{\"uri\":\"{}\"}}}}}}", .{uri})[..])[..])
    input.append(frame("{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"shutdown\"}")[..])
    input.append(frame("{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}")[..])
    let lsp_args = ["lsp"]
    let out = nx_in(e, lsp_args[..], input[..], e.root[..])
    let o = out.stdout[..]
    if o.find("\"definitionProvider\":true") == null { failures.append(format("lsp: capabilities:\n{}", .{o})); return }
    // code lenses: the panic proof above every function (origin cannot panic; main can)
    let r8 = response(o, 8)
    if r8.find("cannot panic") == null or r8.find("panics") == null { failures.append(format("lsp: code lenses: {}", .{r8})) }
    let r1 = response(o, 1)
    if r1.find("helper.nx") == null or r1.find("\"line\":0") == null { failures.append(format("lsp: definition of helper.twice: {}", .{r1})) }
    let r2 = response(o, 2)
    if r2.find("main.nx") == null or r2.find("\"line\":4") == null { failures.append(format("lsp: definition of origin: {}", .{r2})) }
    let r3 = response(o, 3)
    if r3.find("\"line\":7") == null { failures.append(format("lsp: definition of the local total: {}", .{r3})) }
    let r4 = response(o, 4)
    if r4.find("\"label\":\"LIMIT\"") == null or r4.find("\"label\":\"twice\"") == null { failures.append(format("lsp: module completion: {}", .{r4})) }
    let r5 = response(o, 5)
    if r5.find("\"label\":\"x\"") == null or r5.find("\"label\":\"y\"") == null { failures.append(format("lsp: field completion: {}", .{r5})) }
    let r6 = response(o, 6)
    if strings.count(r6, "\"newText\":\"sum\"") != 3 { failures.append(format("lsp: rename edits: {}", .{r6})) }
    // `idx` resolves to its binding in the `for` header on the same line, column 14
    let r7 = response(o, 7)
    if r7.find("\"line\":11") == null or r7.find("\"character\":14") == null { failures.append(format("lsp: definition of the for binding: {}", .{r7})) }
    // a program that checks is answered by the checker (decision 115): the
    // `scale` of the right `impl`, a field renamed in every file that names
    // it (its declaration, its accesses, a literal's initializer), a local's type
    let sdir = fs.join(e.root[..], "nx-out/lsp-sem")
    fs.make_dirs(sdir[..]) catch { }
    fs.write(fs.join(sdir[..], "shapes.nx")[..], "pub struct Circle { r: i64 }\npub struct Square { side: i64 }\npub fn area_of(c: Circle) -> i64 { return c.r * c.r * 3 }\n\nimpl Circle { pub fn scale(self: *Self, k: i64) -> i64 { return self.r * k } }\nimpl Square { pub fn scale(self: *Self, k: i64) -> i64 { return self.side * k } }\n") catch { failures.append(String.from("lsp: cannot write shapes.nx")); return }
    let smain = fs.join(sdir[..], "sem.nx")
    let stext = "import shapes\n\nfn main() {\n    let c = shapes.Circle{ .r = 2 }\n    let s = shapes.Square{ .side = 3 }\n    let a = c.scale(2)\n    let b = s.scale(2)\n    var total = a + b\n    total += shapes.area_of(c)\n    println(\"{} {}\", .{total, c.r})\n}\n"
    fs.write(smain[..], stext) catch { failures.append(String.from("lsp: cannot write sem.nx")); return }
    let suri = format("file:///{}", .{strings.replace(strings.replace(smain[..], "\\", "/")[..], ":", "%3A")})
    var sin = String.new()
    sin.append(frame("{\"jsonrpc\":\"2.0\",\"id\":0,\"method\":\"initialize\",\"params\":{}}")[..])
    sin.append(frame(format("{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"{}\",\"languageId\":\"nexium\",\"version\":1,\"text\":\"{}\"}}}}}}", .{suri, json_escape(stext)})[..])[..])
    let sasks = [(11, "definition", 6, 15), (12, "definition", 8, 22), (13, "hover", 7, 9), (14, "hover", 5, 8)]
    for a in sasks {
        sin.append(frame(format("{{\"jsonrpc\":\"2.0\",\"id\":{},\"method\":\"textDocument/{}\",\"params\":{{\"textDocument\":{{\"uri\":\"{}\"}},\"position\":{{\"line\":{},\"character\":{}}}}}}}", .{a.0, a.1, suri, a.2, a.3})[..])[..])
    }
    sin.append(frame(format("{{\"jsonrpc\":\"2.0\",\"id\":15,\"method\":\"textDocument/rename\",\"params\":{{\"textDocument\":{{\"uri\":\"{}\"}},\"position\":{{\"line\":9,\"character\":33}},\"newName\":\"radius\"}}}}", .{suri})[..])[..])
    sin.append(frame("{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"shutdown\"}")[..])
    sin.append(frame("{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}")[..])
    let sout = nx_in(e, lsp_args[..], sin[..], e.root[..])
    let so = sout.stdout[..]
    let s11 = response(so, 11)
    if s11.find("shapes.nx") == null or s11.find("\"line\":5") == null or s11.find("\"character\":21") == null { failures.append(format("lsp: definition of Square's scale: {}", .{s11})) }
    let s12 = response(so, 12)
    if s12.find("shapes.nx") == null or s12.find("\"line\":2") == null { failures.append(format("lsp: definition of shapes.area_of: {}", .{s12})) }
    let s13 = response(so, 13)
    if s13.find("var total: i64") == null { failures.append(format("lsp: hover on a var: {}", .{s13})) }
    let s14 = response(so, 14)
    if s14.find("let a: i64") == null { failures.append(format("lsp: hover on a let: {}", .{s14})) }
    let s15 = response(so, 15)
    if strings.count(s15, "\"newText\":\"radius\"") != 6 or s15.find("shapes.nx") == null or s15.find("sem.nx") == null { failures.append(format("lsp: a field renamed in both files: {}", .{s15})) }
    println("lsp: an editor session, and one answered by the checker", .{})
}

// ----- main -------------------------------------------------------------------

fn usage() {
    eprintln("usage: nx run tests/run.nx -- [suite ...] [--jobs N] [--nx PATH] [--rebuild]", .{})
    eprintln("suites: bootstrap examples spec compile_fail fmt std gui packages ship installer repl lsp topo", .{})
}

fn main() -> u8 {
    let args = os.args()
    let windows = os.env("COMSPEC") != null and os.env("WINDIR") != null
    let macos = !windows and io.file_kind("/System/Library/CoreServices") == 2
    var e = Env{ .root = fs.cwd() catch { String.from(".") }, .nx = String.new(), .windows = windows, .macos = macos, .jobs = thread.count() }
    if e.jobs > 8 { e.jobs = 8 }
    var wanted = List(String).new()
    var force = false
    var given_nx = String.new()
    var i: usize = 1
    while i < args.len {
        let a = args[i]
        if a == "--jobs" and i + 1 < args.len { e.jobs = args[i + 1].parse_int(usize) catch { 1 }; i += 2; continue }
        if a == "--nx" and i + 1 < args.len { given_nx = String.from(args[i + 1]); i += 2; continue }
        if a == "--rebuild" { force = true; i += 1; continue }
        if a.starts_with("-") { usage(); return 2 }
        wanted.append(String.from(a))
        i += 1
    }
    // the compiler under test runs the C compiler this host has
    if macos { os.set_env("NX_CC", "cc") } else { os.set_env("NX_ZIG", "zig") }
    let all = ["bootstrap", "examples", "spec", "compile_fail", "fmt", "std", "gui", "packages", "ship", "installer", "repl", "play", "lsp", "topo"]
    for w in wanted {
        var known = false
        for s in all { if w[..] == s { known = true } }
        if !known { eprintln("unknown suite {}", .{w}); usage(); return 2 }
    }
    var failures = List(String).new()
    let started = time.monotonic()
    if given_nx.len > 0 {
        e.nx = given_nx
    } else if !bootstrap(&mut e, &mut failures, force) {
        for f in failures { eprintln("FAIL {}", .{f}) }
        return 1
    }
    for s in all {
        var run_it = wanted.len == 0
        for w in wanted { if w[..] == s { run_it = true } }
        if !run_it { continue }
        let before = failures.len
        if s == "bootstrap" { suite_bootstrap(&e, &mut failures) }
        else if s == "examples" { suite_examples(&e, &mut failures) }
        else if s == "spec" { suite_spec(&e, &mut failures) }
        else if s == "compile_fail" { suite_compile_fail(&e, &mut failures) }
        else if s == "fmt" { suite_fmt(&e, &mut failures) }
        else if s == "std" { suite_std(&e, &mut failures) }
        else if s == "gui" { suite_gui(&e, &mut failures) }
        else if s == "packages" { suite_packages(&e, &mut failures) }
        else if s == "ship" { suite_ship(&e, &mut failures) }
        else if s == "installer" { suite_installer(&e, &mut failures) }
        else if s == "repl" { suite_repl(&e, &mut failures) }
        else if s == "play" { suite_play(&e, &mut failures) }
        else if s == "lsp" { suite_lsp(&e, &mut failures) }
        else if s == "topo" { suite_topo(&e, &mut failures) }
        if failures.len > before { println("{}: {} failure(s)", .{s, failures.len - before}) }
    }
    let secs = (time.monotonic() - started) / 1000000000
    if failures.len == 0 {
        println("ok: every suite passed in {}s", .{secs})
        return 0
    }
    for f in failures { eprintln("FAIL {}\n", .{f}) }
    eprintln("{} failure(s) in {}s", .{failures.len, secs})
    return (if failures.len > 100 { 100 } else { failures.len }) as u8
}
