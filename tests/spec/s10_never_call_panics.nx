// EXIT: 101
// A `-> never` call standing for a struct value runs and panics with its
// own message; nothing after it runs.

struct Point { x: i32, y: i32 }

fn fail(msg: []u8) -> never { panic(msg) }

fn point(n: i32) -> Point {
    if n >= 0 { return Point{ .x = n, .y = n } }
    return fail("a negative point")
}

fn main() {
    println("before", .{})
    let p = point(-1)
    println("after {}", .{p.x})
}
