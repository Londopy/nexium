// SPEC 5.6: a `[]mut T` views its storage: writes through it, through a range of
// it, through a callee that passes it on, and through a local view all land there.
fn double_all(xs: []mut i64) {
    for i in 0..xs.len { xs[i] = xs[i] * 2 }
}

fn bump_through(xs: []mut i64) {
    double_all(xs)
    xs[0] = xs[0] + 1
}

fn fill(bs: []mut u8, c: u8) {
    for i in 0..bs.len { bs[i] = c }
}

fn main() {
    var xs = [1, 2, 3, 4, 5]
    double_all(xs[..])
    println("{} {} {} {} {}", .{xs[0], xs[1], xs[2], xs[3], xs[4]})
    double_all(xs[1..3])
    println("{} {} {} {} {}", .{xs[0], xs[1], xs[2], xs[3], xs[4]})
    bump_through(xs[..])
    println("{} {} {} {} {}", .{xs[0], xs[1], xs[2], xs[3], xs[4]})
    var ys = List(i64).new()
    ys.append(10)
    ys.append(20)
    double_all(ys[..])
    println("{} {}", .{ys[0], ys[1]})
    var buf = [0 as u8, 0, 0]
    fill(buf[..], 7)
    println("{} {} {}", .{buf[0], buf[1], buf[2]})
    var zs = [1, 1, 1, 1]
    let view = zs[1..3]
    view[0] = 8
    view[1] = 9
    println("{} {} {} {}", .{zs[0], zs[1], zs[2], zs[3]})
}
