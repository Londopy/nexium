// EXIT: 101
// `xs.swap(i, j)` exchanges two elements of a mutable slice, a List's or an
// array's, of any element type (owned ones move, nothing is copied); an
// index out of bounds panics.

fn main() {
    var names = List(String).new()
    names.append(String.from("b"))
    names.append(String.from("a"))
    names.append(String.from("c"))
    names.swap(0, 1)
    names.swap(2, 2)
    println("{} {} {}", .{names[0], names[1], names[2]})
    var xs: [4]i64 = [4, 3, 2, 1]
    xs[..].swap(0, 3)
    let view = xs[1..3]
    println("{} {} {}", .{xs[0], xs[3], view.len})
    names.swap(0, 5)
    println("not reached", .{})
}
