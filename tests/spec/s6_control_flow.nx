// SPEC 6.2: if as expression, if let, while/else, for over ranges with steps, labels, labeled blocks yield values.
fn main() {
    let a = 3
    let m = if a > 2 { "big" } else { "small" }
    let o: ?i32 = 5
    if let v = o { println("{} {}", .{m, v}) } else { println("none", .{}) }
    var i: i32 = 0
    while i < 3 { i += 1 } else { println("loop ended at {}", .{i}) }
    while true { break } else { println("not printed", .{}) }
    var acc = String.new()
    let lo: i64 = 10
    for k in lo..0 step -3 { acc.append(format("{},", .{k})[..]) }
    for k in 0..6 step 2 { acc.append(format("{};", .{k})[..]) }
    println("{}", .{acc})
    var hits: i32 = 0
    outer: for x in 0..3 {
        for y in 0..3 {
            if y == 2 { continue :outer }
            if x == 2 { break :outer }
            hits += 1
        }
    }
    let v = blk: {
        if hits > 3 { break :blk 100 }
        break :blk 0
    }
    let arr = [4, 5, 6]
    var total = 0
    for x, idx in arr { total += x * (idx as i64 + 1) }
    for c, s in "ab", [1, 2] { total += (c as i64) + s }
    println("{} {} {}", .{hits, v, total})
}
