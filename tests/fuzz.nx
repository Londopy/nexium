//! Fuzzing, a Nexium program: mutated sources through the front end, and
//! random bytes through the binary pattern engine. A crash is a finding; a
//! diagnostic is not.
//!
//!     nx run tests/fuzz.nx -- --nx nx-out/bootstrap/nx2 --iterations 300 --seed 7
//!
//! Every mutant of a corpus file (`examples/`, `tests/spec/`, `std/`) goes
//! through `nx check`; exit 0 (accepted) and exit 1 (rejected with a
//! diagnostic) are the two right answers, anything else (a panic, a signal,
//! a timeout) is a finding. Then a program full of binary patterns is built
//! once and fed random byte strings: it must answer every one without
//! crashing. Both engines run on std.testing's property driver: the cases
//! come from a `testing.Rng` of the seed, and the first finding of each is
//! shrunk to the smallest case that still fails, then saved under
//! `nx-out/fuzzing/findings/` and reported. The exit code is the number of
//! findings.
//!
//! `--run N` is the hunter of 1.2: one accepted mutant in N is built in
//! debug mode, where released storage is filled with `0xDD`, and run. A
//! signal or an abort is a finding (a view the rules of SPEC 5.6 and 5.7
//! missed reads released storage and dies there instead of by luck); a
//! panic or an exit code is a program's own answer. A mutant the checker
//! accepted and the emitter or the C compiler then rejected is a finding
//! too. A mutant without `main` builds as a library object and is not run.

import std.fs
import std.process
import std.strings
import std.testing

struct Env {
    nx: String
    windows: bool
    dir: String
    findings: usize
    // build and run one accepted mutant in N in debug mode (0: none)
    run_every: usize
}

fn run_in(argv: [][]u8, stdin: []u8, cwd: []u8) -> process.Output {
    return process.run_with(argv, process.Options{ .stdin = stdin, .cwd = cwd }) catch {
        return process.Output{ .code = -1, .stdout = String.new(), .stderr = format("cannot run {}", .{argv[0]}) }
    }
}

/// The compiler under a time limit where the platform has one (`timeout`
/// from coreutils); a hung front end is a finding too.
fn check(e: *Env, path: []u8) -> process.Output {
    var argv = List([]u8).new()
    if !e.windows { argv.append("timeout"); argv.append("30") }
    argv.append(e.nx[..])
    argv.append("check")
    argv.append(path)
    return run_in(argv[..], "", "")
}

fn note_finding(e: *mut Env, what: []u8, text: []u8, out: *process.Output) {
    e.findings += 1
    let dir = fs.join(e.dir[..], "findings")
    fs.make_dirs(dir[..]) catch { }
    let saved = format("{}/{}-{}.nx", .{dir, what, e.findings})
    fs.write(saved[..], text) catch { }
    var first = String.new()
    for l in out.stderr[..].lines() { if first.len == 0 and l.trim().len > 0 { first = String.from(l) } }
    println("FINDING {}: exit {} ({}) saved as {}", .{what, out.code, first, saved})
}

/// The hunter: an accepted mutant built in debug mode and run under a time
/// limit where the platform has one. True when it found something: the kind
/// in `what`, the output in `out`.
fn run_mutant(e: *Env, path: []u8, what: *mut String, out: *mut process.Output) -> bool {
    let exe = fs.join(e.dir[..], if e.windows { "mutant.exe" } else { "mutant" })
    var build_args = List([]u8).new()
    build_args.append(e.nx[..])
    for a in ["build", path, "-o", exe[..], "--mode", "debug", "--out-dir", e.dir[..]] { build_args.append(a) }
    let b = run_in(build_args[..], "", "")
    if b.code != 0 {
        what.* = String.from("emit")
        out.* = b
        return true
    }
    // no `main`: a library object, nothing to execute
    if b.stderr[..].find("building a library object") != null { return false }
    var argv = List([]u8).new()
    if !e.windows { argv.append("timeout"); argv.append("10") }
    argv.append(exe[..])
    let r = run_in(argv[..], "", "")
    // 0 to 100 are a program's own codes, 101 a panic, 124 the time limit
    if r.code < 0 or (r.code > 101 and r.code != 124) {
        what.* = String.from("dangling")
        out.* = r
        return true
    }
    return false
}

// ----- mutations ---------------------------------------------------------------

const TOKENS = ["fn", "let", "var", "if", "else", "for", "while", "match", "return", "struct", "enum", "import", "comptime", "unsafe", "defer",
    "{", "}", "(", ")", "[", "]", "<<", ">>", ",", ".", ":", "=", "==", "->", "=>", "|", "|>", "?", "!", "&", "*", "..", "..=", "\"", "'", "\\", "0x", "1e", "//", "///", "@",
    "null", "true", "undefined", "self", "Self", "String", "List", "Map", "i32", "u8", "usize", "f64", "bool", "error", "try", "catch", "orelse", "own", "pub", "test",
    "\n", " ", "\t", "\r", b"\x00", b"\xff", b"\xe2\x82", "{{", "}}", "{}", ".{", "%", "/", "-", "+", "1", "0", "999999999999999999999", "\"\"", "''"]

/// One random edit of the text.
fn mutate(r: *mut testing.Rng, src: []u8, other: []u8) -> String {
    var out = String.new()
    let n = src.len
    let kind = r.pick(8)
    if n == 0 { out.append(TOKENS[r.pick(TOKENS.len)]); return out }
    if kind == 0 {
        // delete a range
        let a = r.pick(n)
        let b = a + r.pick(if n - a < 64 { n - a } else { 64 }) + 1
        out.append(src[0..a])
        if b < n { out.append(src[b..]) }
    } else if kind == 1 {
        // duplicate a range
        let a = r.pick(n)
        let b = a + r.pick(if n - a < 128 { n - a } else { 128 }) + 1
        let bb = if b > n { n } else { b }
        out.append(src[0..bb])
        out.append(src[a..bb])
        out.append(src[bb..])
    } else if kind == 2 {
        // insert a token
        let a = r.pick(n + 1)
        out.append(src[0..a])
        out.append(TOKENS[r.pick(TOKENS.len)])
        out.append(src[a..])
    } else if kind == 3 {
        // replace a byte with a random printable one, or a control byte
        let a = r.pick(n)
        out.append(src[0..a])
        let c = if r.pick(4) == 0 { r.pick(32) as u8 } else { (32 + r.pick(95)) as u8 }
        out.push_byte(c)
        out.append(src[a + 1..])
    } else if kind == 4 {
        // truncate
        out.append(src[0..r.pick(n)])
    } else if kind == 5 {
        // swap two lines
        var lines = List([]u8).new()
        for l in src.lines() { lines.append(l) }
        if lines.len < 2 { out.append(src); return out }
        let i = r.pick(lines.len)
        let j = r.pick(lines.len)
        for l, k in lines {
            if k > 0 { out.append("\n") }
            out.append(if k == i { lines[j] } else if k == j { lines[i] } else { l })
        }
    } else if kind == 6 {
        // splice: the head of this file and the tail of another
        let a = r.pick(n)
        let b = r.pick(other.len + 1)
        out.append(src[0..a])
        out.append(other[b..])
    } else {
        // several edits at once
        var cur = String.from(src)
        for k in 0..(2 + r.pick(4)) { cur = mutate(r, cur[..], other) }
        return cur
    }
    return out
}

/// A mutant, and whether the hunter builds and runs it.
struct Mutant {
    text: String
    run: bool
}

/// Mutated corpus files through the front end.
fn fuzz_sources(e: *mut Env, iterations: usize, seed: u64) {
    var corpus = List(String).new()
    for dir in ["examples", "tests/spec", "std"] {
        let names = fs.list(dir) catch { continue }
        for nm in names { if nm[..].ends_with(".nx") { corpus.append(fs.join(dir, nm[..])) } }
    }
    if corpus.len == 0 { println("no corpus", .{}); return }
    var texts = List(String).new()
    for f in corpus { texts.append(fs.read(f[..]) catch { String.new() }) }
    let case_path = fs.join(e.dir[..], "case.nx")
    let run_every = e.run_every
    var cases: usize = 0
    var accepted: usize = 0
    var rejected: usize = 0
    var ran: usize = 0
    // counted until the first finding: after it, cases are its shrinking
    var found = false
    // what the last failing case found
    var what = String.new()
    var last = process.Output{ .code = 0, .stdout = String.new(), .stderr = String.new() }
    let gen = |[&texts, run_every] r: *mut testing.Rng| -> Mutant {
        let src = &texts[r.pick(texts.len)]
        let other = &texts[r.pick(texts.len)]
        let text = mutate(r, src[..], other[..])
        let run = run_every > 0 and r.pick(run_every) == 0
        return Mutant{ .text = text, .run = run }
    }
    let holds = |[e, &case_path, &mut cases, &mut accepted, &mut rejected, &mut ran, &mut found, &mut what, &mut last] m: *Mutant| -> bool {
        if !found { cases += 1 }
        fs.write(case_path[..], m.text[..]) catch { return true }
        let out = check(e, case_path[..])
        if out.code == 1 {
            if !found { rejected += 1 }
            return true
        }
        if out.code != 0 {
            found = true
            what = String.from("source")
            last = out
            return false
        }
        if !found { accepted += 1 }
        if !m.run { return true }
        if !found { ran += 1 }
        let hit = run_mutant(e, case_path[..], &mut what, &mut last)
        if hit { found = true }
        return !hit
    }
    let how = testing.Search{ .seed = seed, .cases = iterations, .shrink_limit = 300 }
    if let f = testing.search(Mutant, how, gen, holds) {
        // the smallest mutant found, run once more for its own output
        let m = testing.replay(Mutant, f.choices[..], gen)
        _ = holds(&m)
        println("sources: case {} failed; shrunk {} times", .{f.case, f.steps})
        note_finding(e, what[..], m.text[..], &last)
    }
    println("sources: {} cases, {} accepted, {} rejected, {} run in debug mode, {} finding(s)", .{cases, accepted, rejected, ran, e.findings})
}

// ----- the binary pattern engine ---------------------------------------------------

/// The pattern program, built once and fed random bytes.
fn fuzz_binary(e: *mut Env, iterations: usize, seed: u64) {
    let src = String.from("tests/fuzz_patterns.nx")
    let exe = fs.join(e.dir[..], if e.windows { "patterns.exe" } else { "patterns" })
    var build_args = List([]u8).new()
    for a in ["build", src[..], "-o", exe[..], "--mode", "safe", "--out-dir", e.dir[..]] { build_args.append(a) }
    build_args.insert(0, e.nx[..])
    let b = run_in(build_args[..], "", "")
    if b.code != 0 { println("the pattern program did not build:\n{}", .{b.stderr}); e.findings += 1; return }
    var cases: usize = 0
    var ok: usize = 0
    var found = false
    var last = process.Output{ .code = 0, .stdout = String.new(), .stderr = String.new() }
    let gen = |r: *mut testing.Rng| -> String {
        var data = String.new()
        let n = r.pick(if r.pick(4) == 0 { 300 } else { 24 })
        for k in 0..n {
            let pick = r.pick(6)
            if pick == 0 { data.push_byte(0x1b) } else if pick == 1 { data.push_byte(0x45) } else if pick == 2 { data.push_byte('N') } else if pick == 3 { data.push_byte(0) } else { data.push_byte(r.pick(256) as u8) }
        }
        return data
    }
    let holds = |[&exe, &mut cases, &mut ok, &mut found, &mut last] data: *String| -> bool {
        if !found { cases += 1 }
        let argv = [exe[..]]
        let out = run_in(argv[..], data[..], "")
        if out.code != 0 {
            found = true
            last = out
            return false
        }
        if !found { ok += 1 }
        return true
    }
    let how = testing.Search{ .seed = seed, .cases = iterations, .shrink_limit = 500 }
    if let f = testing.search(String, how, gen, holds) {
        let data = testing.replay(String, f.choices[..], gen)
        _ = holds(&data)
        println("binary: case {} failed; shrunk {} times", .{f.case, f.steps})
        note_finding(e, "binary", data[..], &last)
    }
    println("binary: {} inputs, {} answered, {} finding(s)", .{cases, ok, e.findings})
}

// ----- main --------------------------------------------------------------------

fn main() -> u8 {
    let args = os.args()
    var e = Env{ .nx = String.from("nx-out/bootstrap/nx2"), .windows = os.env("COMSPEC") != null and os.env("WINDIR") != null, .dir = String.from("nx-out/fuzzing"), .findings = 0, .run_every = 0 }
    if e.windows { e.nx.append(".exe") }
    var iterations: usize = 200
    var seed: u64 = 1
    var i: usize = 1
    while i < args.len {
        let a = args[i]
        if a == "--nx" and i + 1 < args.len { e.nx = String.from(args[i + 1]); i += 2; continue }
        if a == "--iterations" and i + 1 < args.len { iterations = args[i + 1].parse_int(usize) catch { 200 }; i += 2; continue }
        if a == "--seed" and i + 1 < args.len { seed = args[i + 1].parse_int(u64) catch { 1 }; i += 2; continue }
        if a == "--run" and i + 1 < args.len { e.run_every = args[i + 1].parse_int(usize) catch { 0 }; i += 2; continue }
        eprintln("usage: nx run tests/fuzz.nx -- [--nx PATH] [--iterations N] [--seed N] [--run N]", .{})
        return 2
    }
    // the compiler's path as the platform spells it, from anywhere
    if !fs.is_absolute(e.nx[..]) { e.nx = fs.join((fs.cwd() catch { String.from(".") })[..], e.nx[..]) }
    if e.windows { e.nx = strings.replace(e.nx[..], "/", "\\") }
    if e.windows { os.set_env("NX_ZIG", "zig") } else if io.file_kind("/System/Library/CoreServices") == 2 { os.set_env("NX_CC", "cc") } else { os.set_env("NX_ZIG", "zig") }
    fs.make_dirs(e.dir[..]) catch { }
    println("fuzz: {} with seed {}, {} iterations per engine", .{e.nx, seed, iterations})
    fuzz_sources(&mut e, iterations, seed)
    fuzz_binary(&mut e, iterations, seed)
    if e.findings == 0 { println("ok: no findings", .{}); return 0 }
    return (if e.findings > 100 { 100 } else { e.findings }) as u8
}
