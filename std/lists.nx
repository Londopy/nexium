// std.lists: generic helpers over slices and Lists, written in Nexium.
//
// `import std.lists` then `lists.sum(xs)`, `lists.map(f, xs)`, ...
// Functions take slices, so arrays, Lists, and slices all work; results that
// are new collections are returned as owned `List`s.

/// Sum of the elements.
pub fn sum(comptime T: type, xs: []T) -> T {
    var total: T = 0
    for x in xs { total += x }
    return total
}

/// Smallest element, or null when empty.
pub fn min(comptime T: type where T: Ord, xs: []T) -> ?T {
    if xs.len == 0 { return null }
    var best = xs[0]
    for x in xs { if x < best { best = x } }
    return best
}

/// Largest element, or null when empty.
pub fn max(comptime T: type where T: Ord, xs: []T) -> ?T {
    if xs.len == 0 { return null }
    var best = xs[0]
    for x in xs { if x > best { best = x } }
    return best
}

/// Position of the largest element, or null when empty.
pub fn arg_max(comptime T: type where T: Ord, xs: []T) -> ?usize {
    if xs.len == 0 { return null }
    var at: usize = 0
    for x, i in xs { if x > xs[at] { at = i } }
    return at
}

/// True when every element satisfies `pred`.
pub fn all(comptime T: type, xs: []T, pred: fn(T) -> bool) -> bool {
    for x in xs { if !pred(x) { return false } }
    return true
}

/// True when some element satisfies `pred`.
pub fn any(comptime T: type, xs: []T, pred: fn(T) -> bool) -> bool {
    for x in xs { if pred(x) { return true } }
    return false
}

/// How many elements satisfy `pred`.
pub fn count_if(comptime T: type, xs: []T, pred: fn(T) -> bool) -> usize {
    var n: usize = 0
    for x in xs { if pred(x) { n += 1 } }
    return n
}

/// The elements that satisfy `pred`, in order.
pub fn filter(comptime T: type, xs: []T, pred: fn(T) -> bool) -> List(T) {
    var out = List(T).new()
    for x in xs { if pred(x) { out.append(x) } }
    return out
}

/// `f` applied to every element.
pub fn map(comptime T: type, comptime U: type, xs: []T, f: fn(T) -> U) -> List(U) {
    var out = List(U).with_capacity(xs.len)
    for x in xs { out.append(f(x)) }
    return out
}

/// Left fold: `f(f(f(init, x0), x1), x2)`.
pub fn fold(comptime T: type, comptime A: type, xs: []T, init: A, f: fn(A, T) -> A) -> A {
    var acc = init
    for x in xs { acc = f(acc, x) }
    return acc
}

/// First element satisfying `pred`, or null.
pub fn find(comptime T: type, xs: []T, pred: fn(T) -> bool) -> ?T {
    for x in xs { if pred(x) { return x } }
    return null
}

/// Position of the first element satisfying `pred`, or null.
pub fn position(comptime T: type, xs: []T, pred: fn(T) -> bool) -> ?usize {
    for x, i in xs { if pred(x) { return i } }
    return null
}

/// A reversed copy.
pub fn reversed(comptime T: type, xs: []T) -> List(T) {
    var out = List(T).with_capacity(xs.len)
    var i = xs.len
    while i > 0 {
        i -= 1
        out.append(xs[i])
    }
    return out
}

/// Adjacent duplicates removed (sort first for global dedup).
pub fn dedup(comptime T: type where T: Eq, xs: []T) -> List(T) {
    var out = List(T).new()
    for x, i in xs {
        if i == 0 or x != xs[i - 1] { out.append(x) }
    }
    return out
}

/// The first `n` elements (or all when shorter).
pub fn take(comptime T: type, xs: []T, n: usize) -> []T{
    return if n < xs.len { xs[0..n] } else { xs }
}

/// Everything after the first `n` elements.
pub fn drop(comptime T: type, xs: []T, n: usize) -> []T{
    return if n < xs.len { xs[n..] } else { xs[xs.len..] }
}

/// Consecutive windows of `size`, as start indices; `for i in windows(xs, 3)` then `xs[i..i+3]`.
pub fn window_starts(len: usize, size: usize) -> List(usize) {
    var out = List(usize).new()
    if size == 0 or size > len { return out }
    for i in 0..len - size + 1 { out.append(i) }
    return out
}

/// Pairs (a[i], b[i]) up to the shorter length.
pub fn zip(comptime A: type, comptime B: type, a: []A, b: []B) -> List((A, B)) {
    let n = if a.len < b.len { a.len } else { b.len }
    var out = List((A, B)).with_capacity(n)
    for i in 0..n { out.append((a[i], b[i])) }
    return out
}

/// Elements repeated `times` times in sequence.
pub fn repeat(comptime T: type, xs: []T, times: usize) -> List(T) {
    var out = List(T).with_capacity(xs.len * times)
    for _ in 0..times { for x in xs { out.append(x) } }
    return out
}

/// True when `xs` starts with `prefix`.
pub fn starts_with(comptime T: type where T: Eq, xs: []T, prefix: []T) -> bool {
    if prefix.len > xs.len { return false }
    for p, i in prefix { if xs[i] != p { return false } }
    return true
}

fn is_even(x: i32) -> bool { return x % 2 == 0 }
fn double(x: i32) -> i32 { return x * 2 }
fn to_len(s: []u8) -> usize { return s.len }
fn add(a: i64, b: i32) -> i64 { return a + b as i64 }

test "sum min max" {
    let xs = [3, 1, 4, 1, 5]
    expect_eq(sum(i32, xs[..]), 14)
    expect_eq(min(i32, xs[..]) orelse -1, 1)
    expect_eq(max(i32, xs[..]) orelse -1, 5)
    expect_eq(arg_max(i32, xs[..]) orelse 99, 4)
    let none: [0]i32 = []
    expect(max(i32, none[..]) == null)
    let fs = [1.5, 2.5]
    expect_eq(sum(f64, fs[..]), 4.0)
}

test "predicates" {
    let xs = [2, 4, 6]
    expect(all(i32, xs[..], is_even))
    let ys = [2, 3]
    expect(!all(i32, ys[..], is_even))
    expect(any(i32, ys[..], is_even))
    expect_eq(count_if(i32, ys[..], is_even), 1)
    expect_eq(find(i32, ys[..], is_even) orelse 0, 2)
    expect_eq(position(i32, ys[..], is_even) orelse 99, 0)
}

test "map filter fold" {
    let xs = [1, 2, 3, 4]
    let evens = filter(i32, xs[..], is_even)
    expect_eq(evens.len, 2)
    expect_eq(evens[1], 4)
    let doubled = map(i32, i32, xs[..], double)
    expect_eq(doubled[3], 8)
    let words = ["a", "bbb"]
    let lens = map([]u8, usize, words[..], to_len)
    expect_eq(lens[1], 3)
    expect_eq(fold(i32, i64, xs[..], 100, add), 110)
}

test "shapes" {
    let xs = [1, 1, 2, 2, 2, 3]
    let d = dedup(i32, xs[..])
    expect_eq(d.len, 3)
    let r = reversed(i32, xs[..])
    expect_eq(r[0], 3)
    expect_eq(take(i32, xs[..], 2).len, 2)
    expect_eq(take(i32, xs[..], 20).len, 6)
    expect_eq(drop(i32, xs[..], 4).len, 2)
    expect_eq(drop(i32, xs[..], 20).len, 0)
    expect_eq(window_starts(5, 3).len, 3)
    let names = ["x", "y"]
    let pairs = zip([]u8, i32, names[..], xs[..])
    expect_eq(pairs.len, 2)
    expect_eq(pairs[1].0, "y")
    expect_eq(repeat(i32, xs[0..2], 3).len, 6)
    expect(starts_with(i32, xs[..], xs[0..3]))
    expect(!starts_with(i32, xs[0..2], xs[..]))
}
