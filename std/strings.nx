// std.strings: text utilities on `[]u8` and `String`, written in Nexium.
//
// `import std.strings` then `strings.join(parts, ", ")`. The core methods
// (`len`, `split`, `trim`, `find`, `starts_with`, `parse_int`, ...) are
// compiler builtins; this module adds what is naturally written in the
// language itself. Slices returned here point into the argument they were cut
// from; `String` results are owned by the caller.

/// Concatenate `parts` with `sep` between them.
pub fn join(parts: [][]u8, sep: []u8) -> String {
    var out = String.new()
    for (parts) |p, i| {
        if (i > 0) out.append(sep)
        out.append(p)
    }
    return out
}

/// `s` repeated `n` times.
pub fn repeat(s: []u8, n: usize) -> String {
    var out = String.with_capacity(s.len * n)
    for (0..n) |_| { out.append(s) }
    return out
}

/// Left-pad with `fill` to at least `width` bytes.
pub fn pad_left(s: []u8, width: usize, fill: u8) -> String {
    var out = String.with_capacity(if (width > s.len) width else s.len)
    if (width > s.len) {
        for (0..width - s.len) |_| { out.push_byte(fill) }
    }
    out.append(s)
    return out
}

/// Right-pad with `fill` to at least `width` bytes.
pub fn pad_right(s: []u8, width: usize, fill: u8) -> String {
    var out = String.from(s)
    if (width > s.len) {
        for (0..width - s.len) |_| { out.push_byte(fill) }
    }
    return out
}

/// Center in `width` bytes, extra fill on the right.
pub fn center(s: []u8, width: usize, fill: u8) -> String {
    if (width <= s.len) return String.from(s)
    let total = width - s.len
    let left = total / 2
    var out = String.with_capacity(width)
    for (0..left) |_| { out.push_byte(fill) }
    out.append(s)
    for (0..total - left) |_| { out.push_byte(fill) }
    return out
}

/// How many non-overlapping times `needle` occurs in `s`.
pub fn count(s: []u8, needle: []u8) -> usize {
    if (needle.len == 0 or needle.len > s.len) return 0
    var n: usize = 0
    var i: usize = 0
    while (i + needle.len <= s.len) {
        if (s[i..i + needle.len] == needle) {
            n += 1
            i += needle.len
        } else {
            i += 1
        }
    }
    return n
}

/// Every occurrence of `from` replaced by `to`.
pub fn replace(s: []u8, from: []u8, to: []u8) -> String {
    var out = String.with_capacity(s.len)
    if (from.len == 0) {
        out.append(s)
        return out
    }
    var i: usize = 0
    while (i < s.len) {
        if (i + from.len <= s.len and s[i..i + from.len] == from) {
            out.append(to)
            i += from.len
        } else {
            out.push_byte(s[i])
            i += 1
        }
    }
    return out
}

/// Position of `needle` at or after `start`.
pub fn index_from(s: []u8, needle: []u8, start: usize) -> ?usize {
    if (start > s.len) return null
    let rest = s[start..]
    if (rest.find(needle)) |i| return start + i
    return null
}

/// Position of the last occurrence of `needle`.
pub fn last_index(s: []u8, needle: []u8) -> ?usize {
    if (needle.len == 0 or needle.len > s.len) return null
    var i = s.len - needle.len + 1
    while (i > 0) {
        i -= 1
        if (s[i..i + needle.len] == needle) return i
    }
    return null
}

/// `s` without a leading `prefix`, or null when it does not start with it.
pub fn strip_prefix(s: []u8, prefix: []u8) -> ?[]u8 {
    if (s.starts_with(prefix)) return s[prefix.len..]
    return null
}

/// `s` without a trailing `suffix`, or null when it does not end with it.
pub fn strip_suffix(s: []u8, suffix: []u8) -> ?[]u8 {
    if (s.ends_with(suffix)) return s[0..s.len - suffix.len]
    return null
}

fn is_space(c: u8) -> bool { return c == ' ' or c == '\t' or c == '\n' or c == '\r' }

/// Leading ASCII whitespace removed.
pub fn trim_left(s: []u8) -> []u8 {
    var i: usize = 0
    while (i < s.len and is_space(s[i])) { i += 1 }
    return s[i..]
}

/// Trailing ASCII whitespace removed.
pub fn trim_right(s: []u8) -> []u8 {
    var n = s.len
    while (n > 0 and is_space(s[n - 1])) { n -= 1 }
    return s[0..n]
}

/// True when `s` is empty or only ASCII whitespace.
pub fn is_blank(s: []u8) -> bool {
    for (s) |c| { if (!is_space(c)) return false }
    return true
}

/// Split on runs of ASCII whitespace; no empty pieces.
pub fn split_whitespace(s: []u8) -> List([]u8) {
    var out = List([]u8).new()
    var i: usize = 0
    while (i < s.len) {
        while (i < s.len and is_space(s[i])) { i += 1 }
        let start = i
        while (i < s.len and !is_space(s[i])) { i += 1 }
        if (i > start) out.append(s[start..i])
    }
    return out
}

/// ASCII letters upper-cased; other bytes unchanged.
pub fn to_upper(s: []u8) -> String {
    var out = String.with_capacity(s.len)
    for (s) |c| {
        if (c >= 'a' and c <= 'z') out.push_byte(c - 32)
        else out.push_byte(c)
    }
    return out
}

/// ASCII letters lower-cased; other bytes unchanged.
pub fn to_lower(s: []u8) -> String {
    var out = String.with_capacity(s.len)
    for (s) |c| {
        if (c >= 'A' and c <= 'Z') out.push_byte(c + 32)
        else out.push_byte(c)
    }
    return out
}

/// First ASCII letter upper-cased.
pub fn capitalize(s: []u8) -> String {
    var out = String.from(s)
    if (s.len > 0 and s[0] >= 'a' and s[0] <= 'z') {
        out.clear()
        out.push_byte(s[0] - 32)
        out.append(s[1..])
    }
    return out
}

/// Bytes in reverse order (bytes, not code points).
pub fn reverse(s: []u8) -> String {
    var out = String.with_capacity(s.len)
    var i = s.len
    while (i > 0) {
        i -= 1
        out.push_byte(s[i])
    }
    return out
}

/// Cut at the first `sep`: (before, after), or null when `sep` is absent.
pub fn split_once(s: []u8, sep: []u8) -> ?([]u8, []u8) {
    if (s.find(sep)) |i| return (s[0..i], s[i + sep.len..])
    return null
}

/// Truncate to `max` bytes, appending `...` when something was cut.
pub fn ellipsize(s: []u8, max: usize) -> String {
    if (s.len <= max) return String.from(s)
    var out = String.with_capacity(max)
    if (max > 3) out.append(s[0..max - 3])
    out.append("...")
    return out
}

test "join and repeat" {
    let parts = ["a", "b", "c"]
    expect_eq(join(parts[..], ", "), "a, b, c")
    expect_eq(join(parts[0..0], ", "), "")
    expect_eq(repeat("ab", 3), "ababab")
    expect_eq(repeat("x", 0), "")
}

test "padding" {
    expect_eq(pad_left("7", 3, '0'), "007")
    expect_eq(pad_right("ab", 4, '.'), "ab..")
    expect_eq(pad_left("long", 2, ' '), "long")
    expect_eq(center("hi", 6, '-'), "--hi--")
    expect_eq(center("hi", 5, '-'), "-hi--")
}

test "count and replace" {
    expect_eq(count("banana", "an"), 2)
    expect_eq(count("aaaa", "aa"), 2)
    expect_eq(count("abc", ""), 0)
    expect_eq(replace("a-b-c", "-", "+"), "a+b+c")
    expect_eq(replace("aaa", "a", "bb"), "bbbbbb")
    expect_eq(replace("abc", "", "x"), "abc")
}

test "searching" {
    expect_eq(index_from("abcabc", "bc", 2) orelse 99, 4)
    expect_eq(index_from("abc", "z", 0) orelse 99, 99)
    expect_eq(last_index("abcabc", "bc") orelse 99, 4)
    expect_eq(last_index("abc", "abcd") orelse 99, 99)
    expect_eq(strip_prefix("prefix-body", "prefix-") orelse "none", "body")
    expect_eq(strip_prefix("body", "prefix-") orelse "none", "none")
    expect_eq(strip_suffix("file.nx", ".nx") orelse "none", "file")
}

test "whitespace" {
    expect_eq(trim_left("  \t x "), "x ")
    expect_eq(trim_right(" x \n"), " x")
    expect(is_blank(" \t\n"))
    expect(!is_blank(" a "))
    let words = split_whitespace("  one two\tthree\n")
    expect_eq(words.len, 3)
    expect_eq(words[1], "two")
}

test "case and reverse" {
    expect_eq(to_upper("MiXed 1"), "MIXED 1")
    expect_eq(to_lower("MiXed 1"), "mixed 1")
    expect_eq(capitalize("nexium"), "Nexium")
    expect_eq(capitalize(""), "")
    expect_eq(reverse("abc"), "cba")
}

test "split_once and ellipsize" {
    if (split_once("key=value=x", "=")) |kv| {
        expect_eq(kv.0, "key")
        expect_eq(kv.1, "value=x")
    } else {
        expect(false)
    }
    expect(split_once("novalue", "=") == null)
    expect_eq(ellipsize("hello world", 8), "hello...")
    expect_eq(ellipsize("hi", 8), "hi")
}
