// std.env: the environment, and where a program keeps its files, written in
// Nexium: variables, the home directory, the config, data, cache and state
// directories each platform expects (XDG on Linux and the BSDs, Library on
// macOS, AppData on Windows), and `.env` files.
//
// `import std.env` then:
//
//     let port = env.get_or("PORT", "8080")
//     let dir = env.config_dir("myapp")              // ?String: ~/.config/myapp, ...
//     let notes = env.expand_home("~/notes.txt")
//     let n = env.load_dotenv(".env", false) catch 0 // sets what is not set yet
//
// The directories are where a program should keep its files; nothing here
// creates them (`fs.make_dirs` does). Each is null when the variables it
// comes from are not set.

import std.fs
import std.path

/// A variable: its name and value.
pub struct Var {
    name: String
    value: String
}

// ------------------------------------------------------------------ variables

/// The variable's value, or null when it is not set or set to nothing.
pub fn get(name: []u8) -> ?String {
    let v = os.env(name) orelse return null
    if v.len == 0 { return null }
    return String.from(v)
}

/// The variable's value, or `default` when it is not set or set to nothing.
pub fn get_or(name: []u8, default: []u8) -> String {
    return get(name) orelse String.from(default)
}

/// Set a variable for this program and the ones it starts.
pub fn set(name: []u8, value: []u8) {
    os.set_env(name, value)
}

/// Remove a variable.
pub fn unset(name: []u8) {
    os.set_env(name, "")
}

/// Every variable, sorted by name.
pub fn all() -> List(Var) {
    var out = List(Var).new()
    for entry in os.environ() {
        let eq = entry[..].find("=") orelse continue
        // Windows keeps a few hidden `=C:=C:\...` entries: no name
        if eq == 0 { continue }
        out.append(Var{ .name = String.from(entry[0..eq]), .value = String.from(entry[eq + 1..entry.len]) })
    }
    var i: usize = 1
    while i < out.len {
        var j = i
        while j > 0 and out[j].name[..] < out[j - 1].name[..] {
            out.swap(j, j - 1)
            j -= 1
        }
        i += 1
    }
    return out
}

// ------------------------------------------------------------------ directories

/// The user's home directory: `HOME`, or on Windows `USERPROFILE`.
pub fn home() -> ?String {
    return home_on(@target().0)
}

/// `~` or `~/...` at the start of a path, with the home directory in its
/// place; any other path as it is.
pub fn expand_home(p: []u8) -> String {
    if p.len == 0 or p[0] != '~' or (p.len > 1 and p[1] != '/' and p[1] != '\\') { return String.from(p) }
    let h = home() orelse return String.from(p)
    if p.len <= 2 { return h }
    return path.join(h[..], p[2..p.len])
}

/// Where a program keeps its settings, in a directory named `app` (none when
/// `app` is empty): `$XDG_CONFIG_HOME` or `~/.config` on Linux and the BSDs,
/// `~/Library/Application Support` on macOS, `%APPDATA%` on Windows.
pub fn config_dir(app: []u8) -> ?String {
    return dir_on(@target().0, KIND_CONFIG, app)
}

/// Where a program keeps what it makes and needs to keep:
/// `$XDG_DATA_HOME` or `~/.local/share`, `~/Library/Application Support`,
/// `%APPDATA%`.
pub fn data_dir(app: []u8) -> ?String {
    return dir_on(@target().0, KIND_DATA, app)
}

/// Where a program keeps what it can make again: `$XDG_CACHE_HOME` or
/// `~/.cache`, `~/Library/Caches`, `%LOCALAPPDATA%`.
pub fn cache_dir(app: []u8) -> ?String {
    return dir_on(@target().0, KIND_CACHE, app)
}

/// Where a program keeps its state between runs (logs, history, what was
/// open): `$XDG_STATE_HOME` or `~/.local/state`,
/// `~/Library/Application Support`, `%LOCALAPPDATA%`.
pub fn state_dir(app: []u8) -> ?String {
    return dir_on(@target().0, KIND_STATE, app)
}

const KIND_CONFIG: usize = 0
const KIND_DATA: usize = 1
const KIND_CACHE: usize = 2
const KIND_STATE: usize = 3

fn home_on(os_name: []u8) -> ?String {
    if os_name == "windows" {
        if let p = get("USERPROFILE") { return p }
    }
    return get("HOME")
}

// an XDG variable counts only when it holds an absolute path (the XDG base
// directory specification ignores a relative one)
fn xdg(name: []u8) -> ?String {
    let v = get(name) orelse return null
    if !path.is_absolute(v[..]) { return null }
    return v
}

fn with_app(base: []u8, app: []u8) -> String {
    if app.len == 0 { return String.from(base) }
    return path.join(base, app)
}

// the platform's directory of each kind, by the platform's name, so the
// tests reach every platform's rule on any machine
fn dir_on(os_name: []u8, kind: usize, app: []u8) -> ?String {
    if os_name == "windows" {
        let name = if kind == KIND_CONFIG or kind == KIND_DATA { "APPDATA" } else { "LOCALAPPDATA" }
        let base = get(name) orelse return null
        return with_app(base[..], app)
    }
    if os_name == "macos" {
        let h = home_on(os_name) orelse return null
        let sub = if kind == KIND_CACHE { "Library/Caches" } else { "Library/Application Support" }
        let base = path.join(h[..], sub)
        return with_app(base[..], app)
    }
    let names = ["XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME", "XDG_STATE_HOME"]
    let defaults = [".config", ".local/share", ".cache", ".local/state"]
    if let v = xdg(names[kind]) { return with_app(v[..], app) }
    let h = home_on(os_name) orelse return null
    let base = path.join(h[..], defaults[kind])
    return with_app(base[..], app)
}

// ------------------------------------------------------------------ .env files

/// The variables a `.env` file sets, in order: `NAME=value` lines, an
/// optional `export ` before the name, `#` comments and blank lines skipped,
/// a value in single quotes taken as written, one in double quotes with
/// `\n`, `\t`, `\"` and `\\` read as escapes, and an unquoted value trimmed
/// and cut at ` #`. A line that is none of these is an error.
pub fn parse_dotenv(text: []u8) -> !List(Var) {
    var out = List(Var).new()
    for raw in text.lines() {
        var line = raw.trim()
        if line.len == 0 or line[0] == '#' { continue }
        if line.starts_with("export ") { line = line[7..line.len].trim() }
        let eq = line.find("=") orelse return error.InvalidInput
        let name = line[0..eq].trim()
        if name.len == 0 { return error.InvalidInput }
        for c in name {
            let ok = (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '.'
            if !ok { return error.InvalidInput }
        }
        let rest = line[eq + 1..line.len].trim()
        var value = String.new()
        if rest.len > 0 and (rest[0] == '"' or rest[0] == '\'') {
            let q = rest[0]
            var i: usize = 1
            var closed = false
            while i < rest.len {
                let c = rest[i]
                if c == q {
                    closed = true
                    break
                }
                if q == '"' and c == '\\' and i + 1 < rest.len {
                    let e = rest[i + 1]
                    value.push_byte(if e == 'n' { '\n' } else if e == 't' { '\t' } else if e == 'r' { '\r' } else { e })
                    i += 2
                    continue
                }
                value.push_byte(c)
                i += 1
            }
            if !closed { return error.InvalidInput }
            let after = rest[i + 1..rest.len].trim()
            if after.len > 0 and after[0] != '#' { return error.InvalidInput }
        } else {
            var end = rest.len
            if let hash = rest.find(" #") { end = hash }
            value.append(rest[0..end].trim())
        }
        out.append(Var{ .name = String.from(name), .value = value })
    }
    return out
}

/// Read a `.env` file and set its variables: those not set already, or
/// every one when `override`. How many were set; `error.InvalidInput` when
/// a line does not parse (nothing is set then).
pub fn load_dotenv(file: []u8, override: bool) -> !usize {
    let text = try fs.read(file)
    let vars = try parse_dotenv(text[..])
    var n: usize = 0
    for v in vars {
        if !override and get(v.name[..]) != null { continue }
        set(v.name[..], v.value[..])
        n += 1
    }
    return n
}

// ------------------------------------------------------------------ tests

test "variables" {
    set("NX_ENV_TEST_A", "one")
    expect_eq(get("NX_ENV_TEST_A").?, "one")
    expect_eq(get_or("NX_ENV_TEST_A", "two"), "one")
    unset("NX_ENV_TEST_A")
    expect(get("NX_ENV_TEST_A") == null)
    expect_eq(get_or("NX_ENV_TEST_A", "two"), "two")
    set("NX_ENV_TEST_B", "b")
    var found = false
    var sorted = true
    let every = all()
    for v, i in every {
        if v.name[..] == "NX_ENV_TEST_B" and v.value[..] == "b" { found = true }
        if i > 0 and every[i].name[..] < every[i - 1].name[..] { sorted = false }
    }
    expect(found and sorted)
    unset("NX_ENV_TEST_B")
}

test "each platform's directories" {
    let keep = ["HOME", "USERPROFILE", "APPDATA", "LOCALAPPDATA", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME", "XDG_STATE_HOME"]
    var saved = List(String).new()
    for name in keep { saved.append(get_or(name, "")) }

    set("HOME", "/home/me")
    unset("XDG_CONFIG_HOME")
    set("XDG_CACHE_HOME", "relative/is/ignored")
    set("XDG_DATA_HOME", "/data")
    expect_eq(dir_on("linux", KIND_CONFIG, "app").?, "/home/me/.config/app")
    expect_eq(dir_on("linux", KIND_DATA, "app").?, "/data/app")
    expect_eq(dir_on("linux", KIND_CACHE, "").?, "/home/me/.cache")
    expect_eq(dir_on("bsd", KIND_STATE, "app").?, "/home/me/.local/state/app")

    set("HOME", "/Users/me")
    expect_eq(dir_on("macos", KIND_CONFIG, "app").?, "/Users/me/Library/Application Support/app")
    expect_eq(dir_on("macos", KIND_CACHE, "app").?, "/Users/me/Library/Caches/app")

    set("USERPROFILE", "C:\\Users\\me")
    set("APPDATA", "C:\\Users\\me\\AppData\\Roaming")
    set("LOCALAPPDATA", "C:\\Users\\me\\AppData\\Local")
    expect_eq(home_on("windows").?, "C:\\Users\\me")
    expect_eq(dir_on("windows", KIND_CONFIG, "app").?, "C:\\Users\\me\\AppData\\Roaming\\app")
    expect_eq(dir_on("windows", KIND_CACHE, "app").?, "C:\\Users\\me\\AppData\\Local\\app")
    unset("LOCALAPPDATA")
    expect(dir_on("windows", KIND_STATE, "app") == null)

    unset("HOME")
    expect(dir_on("linux", KIND_CONFIG, "app") == null)

    for name, i in keep { set(name, saved[i][..]) }
}

test "the home directory in a path" {
    let h = home()
    expect_eq(expand_home("notes.txt"), "notes.txt")
    expect_eq(expand_home("~user/x"), "~user/x")
    if let hh = h {
        expect_eq(expand_home("~"), hh)
        expect_eq(expand_home("~/notes.txt"), path.join(hh[..], "notes.txt"))
    }
}

test ".env files" {
    let text = "# settings\nexport PORT=8080\nNAME = \"a \\\"quoted\\\" name\"\nRAW='$not $expanded'\nPLAIN=value with spaces # a comment\nEMPTY=\n\nURL=http://x.test/#frag\n"
    let vars = try parse_dotenv(text)
    expect_eq(vars.len, 6)
    expect_eq(vars[0].name, "PORT")
    expect_eq(vars[0].value, "8080")
    expect_eq(vars[1].value, "a \"quoted\" name")
    expect_eq(vars[2].value, "$not $expanded")
    expect_eq(vars[3].value, "value with spaces")
    expect_eq(vars[4].value, "")
    expect_eq(vars[5].value, "http://x.test/#frag")
    var bad = false
    _ = parse_dotenv("NO_EQUALS_SIGN\n") catch |e| {
        bad = e == error.InvalidInput
        List(Var).new()
    }
    expect(bad)
    var unclosed = false
    _ = parse_dotenv("X=\"open\n") catch |e| {
        unclosed = e == error.InvalidInput
        List(Var).new()
    }
    expect(unclosed)

    let file = fs.temp_path("nx-dotenv-")
    try fs.write(file[..], "NX_DOTENV_A=from-file\nNX_DOTENV_B=from-file\n")
    set("NX_DOTENV_A", "already")
    expect_eq(try load_dotenv(file[..], false), 1)
    expect_eq(get("NX_DOTENV_A").?, "already")
    expect_eq(get("NX_DOTENV_B").?, "from-file")
    expect_eq(try load_dotenv(file[..], true), 2)
    expect_eq(get("NX_DOTENV_A").?, "from-file")
    unset("NX_DOTENV_A")
    unset("NX_DOTENV_B")
    try fs.remove(file[..])
}
