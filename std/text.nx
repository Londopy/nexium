// std.text: UTF-8 text by code point and by grapheme cluster, written in
// Nexium, with the Unicode tables it needs.
//
// `import std.text` then:
//
//     let n = text.char_count("héllo")            // 5 code points, not 6 bytes
//     for c in text.scalars("héllo") { ... }       // chars (Unicode scalars)
//     let g = text.grapheme_count("🇯🇵 e\u{301}")   // 3: a flag, a space, an é
//     for g in text.graphemes(s) { ... }           // what a reader counts as characters
//     let w = text.width("日本語")                   // 6 columns on a terminal
//     let cell = text.pad_right(text.truncate_width(name, 20), 20)
//     let s = text.to_upper("straße")               // "STRASSE"
//     let same = text.eq_ignore_case("Straße", "STRASSE")
//     let t = text.truncate("héllo wörld", 5)       // "héllo", never mid-character
//
// Strings are bytes; this module reads them as UTF-8, tolerating bad input
// (an invalid byte decodes as U+FFFD and advances one byte). Grapheme
// clusters are Unicode's extended grapheme clusters (UAX #29): a letter and
// its marks, a Hangul syllable, an emoji sequence joined by ZWJ, a flag, an
// Indic conjunct. Case mapping is Unicode's full mapping for every script,
// without the rules that depend on a language (Turkish and Lithuanian i);
// `to_lower` writes a final sigma where a word ends. `width` counts
// terminal columns as terminals draw them: East Asian wide and fullwidth
// characters and emoji sequences take two, marks and zero-width characters
// none. The tables at the end are generated by scripts/unicode_tables.py
// (`UNICODE_VERSION` says from which version).

pub const REPLACEMENT: u32 = 0xFFFD

/// A decoded code point and the number of bytes it took.
pub struct Decoded {
    cp: u32
    len: usize
}

/// Decode the code point starting at byte `i`. Invalid input yields
/// U+FFFD with length 1 so callers always make progress.
pub fn decode_at(s: []u8, i: usize) -> Decoded {
    if i >= s.len { return Decoded{ .cp = REPLACEMENT, .len = 0 } }
    let b0 = s[i]
    if b0 < 0x80 { return Decoded{ .cp = b0 as u32, .len = 1 } }
    var need: usize = 0
    var cp: u32 = 0
    var min: u32 = 0
    if b0 >= 0xC2 and b0 <= 0xDF {
        need = 1
        cp = (b0 & 0x1F) as u32
        min = 0x80
    } else if b0 >= 0xE0 and b0 <= 0xEF {
        need = 2
        cp = (b0 & 0x0F) as u32
        min = 0x800
    } else if b0 >= 0xF0 and b0 <= 0xF4 {
        need = 3
        cp = (b0 & 0x07) as u32
        min = 0x10000
    } else {
        return Decoded{ .cp = REPLACEMENT, .len = 1 }
    }
    var k: usize = 1
    while k <= need {
        if i + k >= s.len { return Decoded{ .cp = REPLACEMENT, .len = 1 } }
        let b = s[i + k]
        if b < 0x80 or b > 0xBF { return Decoded{ .cp = REPLACEMENT, .len = 1 } }
        cp = (cp << 6) | ((b & 0x3F) as u32)
        k += 1
    }
    if cp < min or cp > 0x10FFFF or (cp >= 0xD800 and cp <= 0xDFFF) { return Decoded{ .cp = REPLACEMENT, .len = 1 } }
    return Decoded{ .cp = cp, .len = need + 1 }
}

/// Append a code point as UTF-8.
pub fn push(out: *mut String, cp: u32) {
    if cp < 0x80 {
        out.push_byte(cp as u8)
    } else if cp < 0x800 {
        out.push_byte((0xC0 | (cp >> 6)) as u8)
        out.push_byte((0x80 | (cp & 0x3F)) as u8)
    } else if cp < 0x10000 {
        out.push_byte((0xE0 | (cp >> 12)) as u8)
        out.push_byte((0x80 | ((cp >> 6) & 0x3F)) as u8)
        out.push_byte((0x80 | (cp & 0x3F)) as u8)
    } else {
        out.push_byte((0xF0 | (cp >> 18)) as u8)
        out.push_byte((0x80 | ((cp >> 12) & 0x3F)) as u8)
        out.push_byte((0x80 | ((cp >> 6) & 0x3F)) as u8)
        out.push_byte((0x80 | (cp & 0x3F)) as u8)
    }
}

/// A code point as a String.
pub fn encode(cp: u32) -> String {
    var out = String.new()
    push(&mut out, cp)
    return out
}

/// Is the text well-formed UTF-8?
pub fn is_valid(s: []u8) -> bool {
    var i: usize = 0
    while i < s.len {
        let d = decode_at(s, i)
        if d.cp == REPLACEMENT and (d.len == 1 and s[i] != 0xEF) { return false }
        i += d.len
    }
    return true
}

/// All code points.
pub fn chars(s: []u8) -> List(u32) {
    var out = List(u32).new()
    var i: usize = 0
    while i < s.len {
        let d = decode_at(s, i)
        out.append(d.cp)
        i += d.len
    }
    return out
}

/// The number of code points.
pub fn char_count(s: []u8) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < s.len {
        i += decode_at(s, i).len
        n += 1
    }
    return n
}

/// The byte offset of the `n`th code point (or `s.len` when past the end).
pub fn byte_offset(s: []u8, n: usize) -> usize {
    var i: usize = 0
    var k: usize = 0
    while i < s.len and k < n {
        i += decode_at(s, i).len
        k += 1
    }
    return i
}

/// The `n`th code point, or null.
pub fn char_at(s: []u8, n: usize) -> ?u32 {
    let i = byte_offset(s, n)
    if i >= s.len { return null }
    return decode_at(s, i).cp
}

/// Code points `from` (inclusive) to `to` (exclusive), as a slice of `s`.
pub fn slice(s: []u8, from: usize, to: usize) -> []u8 {
    let a = byte_offset(s, from)
    let b = byte_offset(s, to)
    if b < a { return s[a..a] }
    return s[a..b]
}

/// The first `n` code points; never cuts a character in half.
pub fn truncate(s: []u8, n: usize) -> []u8 {
    return s[0..byte_offset(s, n)]
}

/// The code points in reverse order.
pub fn reverse(s: []u8) -> String {
    let cps = chars(s)
    var out = String.with_capacity(s.len)
    var i = cps.len
    while i > 0 {
        i -= 1
        push(&mut out, cps[i])
    }
    return out
}

/// The Unicode scalars, as `char`s (an invalid byte reads as U+FFFD).
pub fn scalars(s: []u8) -> List(char) {
    var out = List(char).new()
    var i: usize = 0
    while i < s.len {
        let d = decode_at(s, i)
        out.append(d.cp as char)
        i += d.len
    }
    return out
}

// ------------------------------------------------------------------ lookups

// the index of the range in sorted, disjoint `los`..`his` that holds `cp`
fn find_range(los: []u32, his: []u32, cp: u32) -> ?usize {
    var lo: usize = 0
    var hi = los.len
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if cp < los[mid] {
            hi = mid
        } else if cp > his[mid] {
            lo = mid + 1
        } else {
            return mid
        }
    }
    return null
}

// where `cp` is in the sorted `cps`
fn find_cp(cps: []u32, cp: u32) -> ?usize {
    var lo: usize = 0
    var hi = cps.len
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if cp < cps[mid] {
            hi = mid
        } else if cp > cps[mid] {
            lo = mid + 1
        } else {
            return mid
        }
    }
    return null
}

// ------------------------------------------------------------------ graphemes

// grapheme cluster break classes (UAX #29), with Extended_Pictographic and
// Indic_Conjunct_Break folded in as the generated table has them
const GB_OTHER: u8 = 0
const GB_CR: u8 = 1
const GB_LF: u8 = 2
const GB_CONTROL: u8 = 3
const GB_EXTEND: u8 = 4
const GB_ZWJ: u8 = 5
const GB_RI: u8 = 6
const GB_PREPEND: u8 = 7
const GB_SPACING: u8 = 8
const GB_L: u8 = 9
const GB_V: u8 = 10
const GB_T: u8 = 11
const GB_LV: u8 = 12
const GB_LVT: u8 = 13
// Extended_Pictographic (its break class is Other)
const GB_PICT: u8 = 14
// Indic_Conjunct_Break=Consonant (Other)
const GB_CONSONANT: u8 = 15
// Indic_Conjunct_Break=Extend and =Linker (both Extend)
const GB_INCB_EXTEND: u8 = 16
const GB_LINKER: u8 = 17

fn gb_kind(cp: u32) -> u8 {
    if cp < 0x80 {
        if cp == 0x0D { return GB_CR }
        if cp == 0x0A { return GB_LF }
        if cp < 0x20 or cp == 0x7F { return GB_CONTROL }
        return GB_OTHER
    }
    // a Hangul syllable is LV every 28th from U+AC00, LVT between
    if cp >= 0xAC00 and cp <= 0xD7A3 { return if (cp - 0xAC00) % 28 == 0 { GB_LV } else { GB_LVT } }
    if let i = find_range(GB_LO[..], GB_HI[..], cp) { return GB_KIND[i] }
    return GB_OTHER
}

fn gb_extend(k: u8) -> bool {
    return k == GB_EXTEND or k == GB_INCB_EXTEND or k == GB_LINKER
}

// No break between `prev` and `cur`: rules GB3 to GB13, with `ri` the
// regional indicators in a row up to `prev`, `pict` 2 after a pictograph,
// its extenders and a ZWJ, and `conj` 2 after a consonant and extenders or
// linkers with a linker among them. Anything else breaks (GB999).
fn joins(prev: u8, cur: u8, ri: usize, pict: u8, conj: u8) -> bool {
    if prev == GB_CR and cur == GB_LF { return true }
    if prev == GB_CR or prev == GB_LF or prev == GB_CONTROL { return false }
    if cur == GB_CR or cur == GB_LF or cur == GB_CONTROL { return false }
    if prev == GB_L and (cur == GB_L or cur == GB_V or cur == GB_LV or cur == GB_LVT) { return true }
    if (prev == GB_LV or prev == GB_V) and (cur == GB_V or cur == GB_T) { return true }
    if (prev == GB_LVT or prev == GB_T) and cur == GB_T { return true }
    if gb_extend(cur) or cur == GB_ZWJ or cur == GB_SPACING { return true }
    if prev == GB_PREPEND { return true }
    if cur == GB_CONSONANT and conj == 2 { return true }
    if cur == GB_PICT and prev == GB_ZWJ and pict == 2 { return true }
    return cur == GB_RI and prev == GB_RI and ri % 2 == 1
}

/// The byte offset where the grapheme cluster that starts at byte `i`
/// ends. A grapheme cluster is what a reader takes for one character: a
/// letter and its marks, a Hangul syllable, an emoji sequence joined by
/// ZWJ, a flag, an Indic conjunct, CR LF (Unicode's extended grapheme
/// clusters, UAX #29).
pub fn grapheme_end(s: []u8, i: usize) -> usize {
    if i >= s.len { return s.len }
    let first = decode_at(s, i)
    var prev = gb_kind(first.cp)
    var j = i + first.len
    var ri: usize = if prev == GB_RI { 1 } else { 0 }
    var pict: u8 = if prev == GB_PICT { 1 } else { 0 }
    var conj: u8 = if prev == GB_CONSONANT { 1 } else { 0 }
    while j < s.len {
        let d = decode_at(s, j)
        let cur = gb_kind(d.cp)
        if !joins(prev, cur, ri, pict, conj) { break }
        ri = if cur == GB_RI { ri + 1 } else { 0 }
        if cur == GB_PICT {
            pict = 1
        } else if pict == 1 and cur == GB_ZWJ {
            pict = 2
        } else if !(pict == 1 and gb_extend(cur)) {
            pict = 0
        }
        if cur == GB_CONSONANT {
            conj = 1
        } else if conj >= 1 and cur == GB_LINKER {
            conj = 2
        } else if !(conj >= 1 and (cur == GB_INCB_EXTEND or cur == GB_ZWJ)) {
            conj = 0
        }
        prev = cur
        j += d.len
    }
    return j
}

/// The grapheme clusters, as slices of the text.
pub fn graphemes(s: []u8) -> List([]u8) {
    var out = List([]u8).new()
    var i: usize = 0
    while i < s.len {
        let j = grapheme_end(s, i)
        out.append(s[i..j])
        i = j
    }
    return out
}

/// The number of grapheme clusters: the characters a reader counts.
pub fn grapheme_count(s: []u8) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < s.len {
        i = grapheme_end(s, i)
        n += 1
    }
    return n
}

/// The first `n` grapheme clusters; never splits one.
pub fn truncate_graphemes(s: []u8, n: usize) -> []u8 {
    var i: usize = 0
    var k: usize = 0
    while i < s.len and k < n {
        i = grapheme_end(s, i)
        k += 1
    }
    return s[0..i]
}

// ------------------------------------------------------------------ width

/// Does the code point take no columns (combining and enclosing marks,
/// format and zero-width characters, controls, Hangul vowels and finals)?
pub fn is_zero_width(cp: u32) -> bool {
    if cp < 0x20 or (cp >= 0x7F and cp <= 0x9F) { return true }
    if cp < 0x300 { return false }
    return find_range(ZERO_LO[..], ZERO_HI[..], cp) != null
}

/// Does the code point take two columns (East Asian wide and fullwidth,
/// emoji among them)?
pub fn is_wide(cp: u32) -> bool {
    if cp < 0x1100 { return false }
    return find_range(WIDE_LO[..], WIDE_HI[..], cp) != null
}

/// Columns a code point takes on a terminal: 0, 1 or 2.
pub fn char_width(cp: u32) -> usize {
    if is_zero_width(cp) { return 0 }
    if is_wide(cp) { return 2 }
    return 1
}

// The columns of one grapheme cluster: its first character's, and two for
// a flag and for an emoji sequence (a wide character in it, or U+FE0F
// asking for the emoji form).
fn cluster_width(g: []u8) -> usize {
    let first = decode_at(g, 0)
    if first.len >= g.len { return char_width(first.cp) }
    if is_wide(first.cp) or (first.cp >= 0x1F1E6 and first.cp <= 0x1F1FF) { return 2 }
    var i = first.len
    while i < g.len {
        let d = decode_at(g, i)
        if d.cp == 0xFE0F or is_wide(d.cp) { return 2 }
        i += d.len
    }
    return char_width(first.cp)
}

/// Columns the text takes on a terminal, grapheme cluster by cluster, as
/// terminals draw it: `e` with an accent is one, a family emoji two.
pub fn width(s: []u8) -> usize {
    var w: usize = 0
    var i: usize = 0
    while i < s.len {
        let j = grapheme_end(s, i)
        w += cluster_width(s[i..j])
        i = j
    }
    return w
}

/// Pad on the right to `columns` terminal columns (by width, not bytes).
pub fn pad_right(s: []u8, columns: usize) -> String {
    var out = String.from(s)
    var w = width(s)
    while w < columns {
        out.push_byte(' ')
        w += 1
    }
    return out
}

/// Pad on the left to `columns` terminal columns: the text right-aligned.
pub fn pad_left(s: []u8, columns: usize) -> String {
    var out = String.new()
    var w = width(s)
    while w < columns {
        out.push_byte(' ')
        w += 1
    }
    out.append(s)
    return out
}

/// The longest start of the text that fits in `columns` terminal columns,
/// cut between grapheme clusters.
pub fn truncate_width(s: []u8, columns: usize) -> []u8 {
    var w: usize = 0
    var i: usize = 0
    while i < s.len {
        let j = grapheme_end(s, i)
        let cw = cluster_width(s[i..j])
        if w + cw > columns { break }
        w += cw
        i = j
    }
    return s[0..i]
}

// ------------------------------------------------------------------ case

// `cp` by a table of runs (`lo`, `lo + step`, ... `hi` each add their
// delta), or `cp` itself
fn map_runs(los: []u32, his: []u32, deltas: []i32, steps: []u8, cp: u32) -> u32 {
    if let i = find_range(los, his, cp) {
        if (cp - los[i]) % (steps[i] as u32) == 0 { return ((cp as i64) + (deltas[i] as i64)) as u32 }
    }
    return cp
}

/// Upper-case a code point by Unicode's simple mapping, one code point to
/// one: `ß` stays `ß` here, where `to_upper` writes `SS`.
pub fn upper_char(cp: u32) -> u32 {
    if cp < 0x80 { return if cp >= 'a' as u32 and cp <= 'z' as u32 { cp - 32 } else { cp } }
    return map_runs(UPPER_LO[..], UPPER_HI[..], UPPER_DELTA[..], UPPER_STEP[..], cp)
}

/// Lower-case a code point by Unicode's simple mapping.
pub fn lower_char(cp: u32) -> u32 {
    if cp < 0x80 { return if cp >= 'A' as u32 and cp <= 'Z' as u32 { cp + 32 } else { cp } }
    return map_runs(LOWER_LO[..], LOWER_HI[..], LOWER_DELTA[..], LOWER_STEP[..], cp)
}

/// Case-fold a code point by Unicode's simple folding (`ς` and `σ` fold
/// alike); `fold` does the full folding of a text.
pub fn fold_char(cp: u32) -> u32 {
    if cp < 0x80 { return lower_char(cp) }
    if let i = find_cp(FOLD_CP[..], cp) { return FOLD_TO[i] }
    return lower_char(cp)
}

// the code points a mapping to more than one gives `cp`, or null
fn special_of(cps: []u32, at: []u16, to: []u32, cp: u32) -> ?[]u32 {
    if let i = find_cp(cps, cp) { return to[(at[i] as usize)..(at[i + 1] as usize)] }
    return null
}

// a letter with a case, for the final sigma
fn is_cased(cp: u32) -> bool {
    return upper_char(cp) != cp or lower_char(cp) != cp
}

// may the code point sit inside a word without ending it: a mark, a format
// character, an apostrophe, a period (Unicode's Case_Ignorable, roughly)
fn is_case_ignorable(cp: u32) -> bool {
    if cp == 0x27 or cp == 0x2E or cp == 0x3A or cp == 0xAD or cp == 0xB7 or cp == 0x2018 or cp == 0x2019 or cp == 0x2024 { return true }
    return cp >= 0x300 and is_zero_width(cp)
}

// Does the capital sigma at byte `i` end a word: a cased letter before it
// (past ignorable ones) and none after?
fn final_sigma(s: []u8, i: usize, len: usize) -> bool {
    var j = i
    var before = false
    while j > 0 {
        var k = j - 1
        while k > 0 and (s[k] & 0xC0) == 0x80 { k -= 1 }
        let d = decode_at(s, k)
        j = k
        if is_case_ignorable(d.cp) { continue }
        before = is_cased(d.cp)
        break
    }
    if !before { return false }
    var n = i + len
    while n < s.len {
        let d = decode_at(s, n)
        n += d.len
        if is_case_ignorable(d.cp) { continue }
        return !is_cased(d.cp)
    }
    return true
}

fn map_full(s: []u8, upper: bool) -> String {
    var out = String.with_capacity(s.len)
    var i: usize = 0
    while i < s.len {
        let d = decode_at(s, i)
        if upper {
            if let m = special_of(UPPER_SPECIAL_CP[..], UPPER_SPECIAL_AT[..], UPPER_SPECIAL_TO[..], d.cp) {
                for c in m { push(&mut out, c) }
            } else {
                push(&mut out, upper_char(d.cp))
            }
        } else if d.cp == 0x3A3 {
            push(&mut out, if final_sigma(s, i, d.len) { 0x3C2 } else { 0x3C3 })
        } else {
            if let m = special_of(LOWER_SPECIAL_CP[..], LOWER_SPECIAL_AT[..], LOWER_SPECIAL_TO[..], d.cp) {
                for c in m { push(&mut out, c) }
            } else {
                push(&mut out, lower_char(d.cp))
            }
        }
        i += d.len
    }
    return out
}

/// Upper-case by Unicode's full mapping, every script: `straße` becomes
/// `STRASSE`, `ﬁ` becomes `FI`.
pub fn to_upper(s: []u8) -> String {
    return map_full(s, true)
}

/// Lower-case by Unicode's full mapping, with `ς` for a sigma that ends a
/// word: `ΟΔΟΣ` becomes `οδος`.
pub fn to_lower(s: []u8) -> String {
    return map_full(s, false)
}

/// Case-fold by Unicode's full folding, to compare or look up text without
/// regard to case: `Straße`, `STRASSE` and `strasse` fold alike.
pub fn fold(s: []u8) -> String {
    var out = String.with_capacity(s.len)
    var i: usize = 0
    while i < s.len {
        let d = decode_at(s, i)
        if let m = special_of(FOLD_SPECIAL_CP[..], FOLD_SPECIAL_AT[..], FOLD_SPECIAL_TO[..], d.cp) {
            for c in m { push(&mut out, c) }
        } else {
            push(&mut out, fold_char(d.cp))
        }
        i += d.len
    }
    return out
}

/// Compare ignoring case, by full case folding.
pub fn eq_ignore_case(a: []u8, b: []u8) -> bool {
    let fa = fold(a)
    let fb = fold(b)
    return fa[..] == fb[..]
}

// ------------------------------------------------------------------ tests

test "decode and encode" {
    expect_eq(char_count("héllo"), 5)
    expect_eq(char_count("日本語"), 3)
    expect_eq(chars("aé日😀").len, 4)
    expect_eq(chars("aé日😀")[3], 0x1F600)
    expect_eq(encode(0xE9), "é")
    expect_eq(encode(0x65E5), "日")
    expect_eq(encode(0x1F600), "😀")
    expect(is_valid("héllo 日本"))
    expect(!is_valid(b"\xff\xfe"))
    expect(!is_valid(b"\xe6\x97"))
    let bad = decode_at(b"\xff", 0)
    expect_eq(bad.cp, REPLACEMENT)
    expect_eq(bad.len, 1)
    expect_eq(char_at("héllo", 1).?, 0xE9)
    expect(char_at("hé", 2) == null)
    expect_eq(slice("héllo wörld", 6, 11), "wörld")
    expect_eq(truncate("héllo wörld", 5), "héllo")
    expect_eq(reverse("héllo"), "olléh")
    expect_eq(byte_offset("héllo", 2), 3)
}

test "scalars" {
    let cs = scalars("aé日😀")
    expect_eq(cs.len, 4)
    expect_eq(cs[1], 'é')
    expect_eq(cs[3], '😀')
    let bad = scalars(b"a\xffb")
    expect_eq(bad[1] as u32, REPLACEMENT)
}

test "grapheme clusters" {
    // a letter and its accent, CR LF, flags, a family, a skin tone, a
    // syllable in jamo and precomposed, a Devanagari conjunct (GB9c), a
    // prepended mark, a ZWJ between letters
    expect_eq(grapheme_count("e\u{301}"), 1)
    expect_eq(grapheme_count("\r\n"), 1)
    expect_eq(grapheme_count("\n\r"), 2)
    expect_eq(grapheme_count("🇯🇵🇫🇷"), 2)
    expect_eq(grapheme_count("🇯🇵🇫"), 2)
    expect_eq(grapheme_count("👨\u{200D}👩\u{200D}👧"), 1)
    expect_eq(grapheme_count("👍🏽"), 1)
    expect_eq(grapheme_count("\u{1100}\u{1161}\u{11A8}"), 1)
    expect_eq(grapheme_count("각"), 1)
    expect_eq(grapheme_count("\u{915}\u{94D}\u{937}\u{93F}"), 1)
    expect_eq(grapheme_count("\u{915}\u{94D}"), 1)
    expect_eq(grapheme_count("\u{600}1"), 1)
    expect_eq(grapheme_count("a\u{200D}b"), 2)
    expect_eq(grapheme_count("héllo"), 5)
    let gs = graphemes("e\u{301}🇯🇵x")
    expect_eq(gs.len, 3)
    expect_eq(gs[0], "e\u{301}")
    expect_eq(gs[1], "🇯🇵")
    expect_eq(truncate_graphemes("e\u{301}e\u{301}e", 2), "e\u{301}e\u{301}")
    expect_eq(grapheme_end("ab", 0), 1)
    expect_eq(grapheme_end("ab", 2), 2)
    expect_eq(grapheme_count(""), 0)
}

test "width" {
    expect_eq(width("hello"), 5)
    expect_eq(width("日本語"), 6)
    expect_eq(width("e\u{301}"), 1)
    expect_eq(width("a\u{200B}b"), 2)
    expect_eq(char_width(0x1F600), 2)
    expect_eq(char_width(0x591), 0)
    expect_eq(char_width(0xFF21), 2)
    expect_eq(pad_right("日本", 6), "日本  ")
    // emoji sequences and flags take two columns, however many code points
    expect_eq(width("👨\u{200D}👩\u{200D}👧"), 2)
    expect_eq(width("🇯🇵"), 2)
    expect_eq(width("\u{2764}\u{FE0F}"), 2)
    expect_eq(width("\u{2764}"), 1)
    expect_eq(width("\u{1100}\u{1161}\u{11A8}"), 2)
    expect_eq(pad_left("日本", 6), "  日本")
    expect_eq(truncate_width("日本語", 5), "日本")
    expect_eq(truncate_width("ab日", 3), "ab")
    expect_eq(truncate_width("e\u{301}x", 1), "e\u{301}")
}

test "case" {
    expect_eq(to_upper("héllo wörld"), "HÉLLO WÖRLD")
    expect_eq(to_lower("ÀÉÎÕÜ"), "àéîõü")
    expect_eq(to_upper("straße"), "STRASSE")
    expect_eq(to_upper("αβγ"), "ΑΒΓ")
    expect_eq(to_lower("ΑΒΓΣ"), "αβγς")
    expect_eq(to_lower("ΣΑΣ ΣΑΣ."), "σας σας.")
    expect_eq(to_lower("Σ"), "σ")
    expect_eq(to_upper("привет"), "ПРИВЕТ")
    expect_eq(to_lower("ПРИВЕТ ЁЖ"), "привет ёж")
    expect_eq(to_upper("łódź"), "ŁÓDŹ")
    expect_eq(to_lower("ŁÓDŹ"), "łódź")
    // scripts the old offsets did not reach: Armenian, Georgian, Deseret
    expect_eq(to_upper("բարի"), "ԲԱՐԻ")
    expect_eq(to_lower("ᲐᲑᲒ"), "აბგ")
    expect_eq(to_upper("აბგ"), "ᲐᲑᲒ")
    expect_eq(to_upper("𐐨"), "𐐀")
    expect_eq(to_upper("ﬁ"), "FI")
    expect_eq(to_lower("İ"), "i\u{307}")
    expect_eq(to_upper("ǅ"), "Ǆ")
    expect(eq_ignore_case("Héllo", "hÉLLO"))
    expect(!eq_ignore_case("Héllo", "hello"))
    expect(eq_ignore_case("Straße", "STRASSE"))
    expect(eq_ignore_case("ΣΑΣ", "σας"))
    expect_eq(fold("Straße"), "strasse")
    expect_eq(fold("ﬁ"), "fi")
    expect_eq(upper_char('a' as u32), 'A' as u32)
    expect_eq(lower_char(0x3A3), 0x3C3)
    expect_eq(upper_char(0xDF), 0xDF)
    expect_eq(fold_char(0x3C2), 0x3C3)
}

