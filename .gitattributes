# GitHub does not know Nexium yet (Linguist needs real-world usage first);
# highlight .nx files with Zig's grammar, the closest match, until it does.
*.nx linguist-language=Zig
*.nx linguist-detectable=true

# generated and vendored bits should not count toward language statistics
bootstrap/nx.c linguist-generated=true text eol=lf
gui/font.bin binary linguist-generated=true
editors/tree-sitter-nexium/src/** linguist-generated=true
*.scm text eol=lf
*.js text eol=lf
assets/*.svg linguist-vendored=true
editors/** linguist-vendored=false

# keep line endings stable across platforms
*.nx text eol=lf
*.h text eol=lf
*.c text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.expected text eol=lf
*.log text eol=lf
*.html text eol=lf
# embedded by tests/spec/s12_comptime.nx: its byte length is recorded
tests/spec/helpers/*.txt text eol=lf
*.sh text eol=lf
# embedded and read by the tutorial programs: their byte lengths are recorded
topo/code/data/* text eol=lf
*.toml text eol=lf
*.csv text eol=lf
# editor files that Unix editors read as-is: no CRLF on checkout
*.vim text eol=lf
*.lua text eol=lf
*.el text eol=lf
*.nanorc text eol=lf
# embedded by the compiler; nx debug writes them beside the binary
runtime/*.py text eol=lf
# command files the debuggers read (tests/debug/check.sh)
tests/debug/*.txt text eol=lf
