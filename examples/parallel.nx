// `for parallel` (spec 7.2): the body runs across worker threads. The
// checker rejects bodies with the `shared_mutable` effect; results go into a
// mutable slice that each iteration writes at its own index.

fn simulate(seed: f64) -> f64 {
    var x = seed
    for _i in 0..2000 { x = x + 0.001 * math.sin(x) }
    return x
}

fn main() {
    var cases: [64]f64 = undefined
    for i in 0..64 { cases[i] = i as f64 * 0.1 }
    var results: [64]f64 = undefined
    let out = results[..]
    for parallel c, i in cases[..] {
        out[i] = simulate(c)
    }
    var total: f64 = 0.0
    for r in results { total += r }
    println("sum {:.3} first {:.3} last {:.3}", .{total, results[0], results[63]})
    // sequential reference
    var check: f64 = 0.0
    for c in cases { check += simulate(c) }
    println("matches sequential: {}", .{total == check})
}
