/// A small numeric core meant to be called from Python or C.

pub fn simulate(positions: []mut f64, dt: f64, steps: u32) -> f64 export(c) {
    var energy: f64 = 0.0
    for (0..steps) |_s| {
        for (positions) |p, i| {
            positions[i] = p + dt * math.sin(p)
        }
    }
    for (positions) |p| { energy += p * p }
    return energy
}

pub fn dot(a: []f64, b: []f64) -> !f64 export(c) {
    if (a.len != b.len) return error.InvalidInput
    var acc: f64 = 0.0
    for (a, b) |x, y| { acc += x * y }
    return acc
}

pub fn checksum(data: []u8) -> u32 export(c) {
    var h: u32 = 2166136261
    for (data) |b| {
        h ^= b as u32
        h *%= 16777619
    }
    return h
}

pub fn divide(a: i64, b: i64) -> i64 export(c) {
    return a / b
}

artifact cabi { name = "ropesim", exports = [simulate, dot, checksum, divide] }
artifact python { name = "ropesim", version = "0.1.0" }
artifact rustlib { name = "ropesim" }
artifact node { name = "ropesim" }
