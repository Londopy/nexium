import std.thread

fn sum_to(n: *mut u64) -> u64 {
    var s: u64 = 0
    var i: u64 = 1
    while i <= n.*{ s += i; i += 1 }
    return s
}

fn main() {
    var a = thread.spawn(u64, u64, sum_to, 100)
    var b = thread.spawn(u64, u64, sum_to, 1000)
    println("{}", .{a.??? + b.???})
}
