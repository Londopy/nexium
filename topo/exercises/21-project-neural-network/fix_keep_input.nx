// topo: fix the error
// A layer keeps its input for the backward pass, but `x` is the caller's slice: a view of data
// the layer does not own. Make `forward` keep a copy of its own, so the program prints the
// recorded output even though the caller changes its data afterwards.
// hint: `to_owned()` makes a `List(f64)` from a `[]f64`, as the chapter's `forward` does
struct Layer {
    weights: List(f64)
    input: List(f64)
}

impl Layer {
    fn forward(self: *mut Self, x: []f64) -> f64 {
        self.input = x
        var s = 0.0
        for w, i in self.weights { s += w * x[i] }
        return s
    }
}

fn main() {
    var layer = Layer{ .weights = List(f64).from([0.5, -1.0, 2.0]), .input = List(f64).new() }
    var data = [1.0, 2.0, 3.0]
    let y = layer.forward(data[..])
    data[0] = 100.0
    println("{} {}", .{y, layer.input[0]})
}
