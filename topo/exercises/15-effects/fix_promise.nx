// topo: fix the error
// `total` promises `!allocates` and breaks it. Keep the promise; the output stays the same.
// hint: a `List` allocates; a running sum does not
fn total(xs: []i32) -> i64 !allocates {
    var copy = List(i64).new()
    for x in xs { copy.append(x as i64) }
    var sum: i64 = 0
    for c in copy { sum += c }
    return sum
}

fn main() {
    let xs: [4]i32 = [1, 2, 3, 4]
    println("{}", .{total(xs[..])})
}
