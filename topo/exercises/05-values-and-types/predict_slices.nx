// topo: predict the output
// Write what this prints into predict_slices.guess before you run it.
// hint: a range `2..5` takes the elements at 2, 3 and 4
fn main() {
    let primes = [2, 3, 5, 7, 11, 13]
    let mid = primes[2..5]
    println("{} {} {}", .{mid.len, mid[0], mid[mid.len - 1]})
    let text = "base camp"
    println("{} {}", .{text.len, text[5..]})
}
