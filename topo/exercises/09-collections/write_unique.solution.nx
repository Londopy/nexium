fn unique(xs: []i32) -> List(i32) {
    var out = List(i32).new()
    for x in xs {
        if !out[..].contains(x) { out.append(x) }
    }
    return out
}

fn main() {
    let xs: [7]i32 = [3, 1, 3, 2, 1, 5, 3]
    let u = unique(xs[..])
    println("{} {} {} {} {}", .{u.len, u[0], u[1], u[2], u[3]})
}

test "keeps the first of each" {
    let xs: [7]i32 = [3, 1, 3, 2, 1, 5, 3]
    let u = unique(xs[..])
    expect_eq(u.len, 4)
    expect_eq(u[0], 3)
    expect_eq(u[1], 1)
    expect_eq(u[3], 5)
}

test "empty stays empty" {
    let none = List(i32).new()
    expect_eq(unique(none[..]).len, 0)
}
