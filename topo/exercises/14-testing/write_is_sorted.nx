test "sorted" {
    let a: [4]i32 = [1, 2, 2, 9]
    expect(is_sorted(a[..]))
}

test "not sorted" {
    let a: [3]i32 = [3, 1, 2]
    expect(!is_sorted(a[..]))
}

test "short" {
    let one: [1]i32 = [7]
    expect(is_sorted(one[..]))
    let none = List(i32).new()
    expect(is_sorted(none[..]))
}
