fn initials(name: []u8) -> String {
    var out = String.new()
    for word in name.split(" ") {
        if word.len == 0 { continue }
        let c = word[0]
        out.push_byte(if c >= 'a' and c <= 'z' { c - 32 } else { c })
    }
    return out
}

fn main() { println("{}", .{initials("Chris Bonington")}) }

test "two names" { expect_eq(initials("Chris Bonington")[..], "CB") }
test "one name" { expect_eq(initials("Reinhold")[..], "R") }
test "lower case" { expect_eq(initials("don whillans")[..], "DW") }
test "extra spaces" { expect_eq(initials("Doug  Scott")[..], "DS") }
