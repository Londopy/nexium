    ex(&mut out, 13, "13-comptime", "fill_table", @embedFile("../topo/exercises/13-comptime/fill_table.nx"), @embedFile("../topo/exercises/13-comptime/fill_table.expected"), @embedFile("../topo/exercises/13-comptime/fill_table.solution.nx"))
    ex(&mut out, 14, "14-testing", "test_clamp", @embedFile("../topo/exercises/14-testing/test_clamp.nx"), "", @embedFile("../topo/exercises/14-testing/test_clamp.solution.nx"))
    ex(&mut out, 14, "14-testing", "write_is_sorted", @embedFile("../topo/exercises/14-testing/write_is_sorted.nx"), "", @embedFile("../topo/exercises/14-testing/write_is_sorted.solution.nx"))
