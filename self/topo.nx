//! `nx topo`: the Topo as a course, in the terminal. The exercises of every
//! chapter are embedded in the compiler: `nx topo <chapter>` writes them
//! into a directory to work in, `nx topo check` grades them with the
//! compiler and keeps the progress, `nx topo hint` and `nx topo solution`
//! help, `nx topo quiz <chapter>` asks the chapter's questions, and
//! `nx topo` alone is the route map with each pitch ticked.
//!
//! An exercise is a file under `topo/exercises/<chapter>/` whose name says
//! its kind: `fill_` (a hole marked `???` to fill so the program prints the
//! recorded output), `fix_` (a program the compiler rejects), `write_` and
//! `test_` (tests that must pass), `predict_` (the output, written into a
//! `.guess` file before running). Solutions live beside them; the harness
//! runs every one.

import std.fs
import std.strings
import std.process

/// A chapter of the Topo.
pub struct Chapter { n: usize, dir: []u8, title: []u8 }

/// An exercise: the starter the reader edits, its recorded output (empty
/// when the tests are the check), the solution.
pub struct Exercise {
    chapter: usize
    dir: []u8
    name: []u8
    source: []u8
    expected: []u8
    solution: []u8
}

/// A chapter's quiz: questions with one right answer each.
pub struct Quiz { chapter: usize, dir: []u8, text: []u8 }

fn chapters() -> List(Chapter) {
    var out = List(Chapter).new()
    out.append(Chapter{ .n = 1, .dir = "01-base-camp", .title = "Base camp" })
    out.append(Chapter{ .n = 2, .dir = "02-hello-world", .title = "Hello, world" })
    out.append(Chapter{ .n = 3, .dir = "03-first-script", .title = "Your first script" })
    out.append(Chapter{ .n = 4, .dir = "04-the-repl", .title = "The REPL" })
    out.append(Chapter{ .n = 5, .dir = "05-values-and-types", .title = "Values and types" })
    out.append(Chapter{ .n = 6, .dir = "06-functions-and-errors", .title = "Functions and errors" })
    out.append(Chapter{ .n = 7, .dir = "07-structs-enums-traits", .title = "Structs, enums and traits" })
    out.append(Chapter{ .n = 8, .dir = "08-ownership", .title = "Ownership" })
    out.append(Chapter{ .n = 9, .dir = "09-collections", .title = "Collections" })
    out.append(Chapter{ .n = 10, .dir = "10-project-calculator", .title = "Project: a calculator" })
    out.append(Chapter{ .n = 11, .dir = "11-project-todo", .title = "Project: a to-do list" })
    out.append(Chapter{ .n = 12, .dir = "12-binary-patterns", .title = "Binary patterns" })
    out.append(Chapter{ .n = 13, .dir = "13-comptime", .title = "Compile time" })
    out.append(Chapter{ .n = 14, .dir = "14-testing", .title = "Tests" })
    out.append(Chapter{ .n = 15, .dir = "15-effects", .title = "Effects" })
    out.append(Chapter{ .n = 16, .dir = "16-concurrency", .title = "Threads and parallel loops" })
    out.append(Chapter{ .n = 17, .dir = "17-networking", .title = "A network service" })
    out.append(Chapter{ .n = 18, .dir = "18-your-first-gui", .title = "Your first GUI" })
    out.append(Chapter{ .n = 19, .dir = "19-packages", .title = "Packages" })
    out.append(Chapter{ .n = 20, .dir = "20-shipping", .title = "Shipping a library" })
    out.append(Chapter{ .n = 21, .dir = "21-project-neural-network", .title = "Project: a neural network" })
    out.append(Chapter{ .n = 22, .dir = "22-tools", .title = "The tools" })
    out.append(Chapter{ .n = 23, .dir = "23-summit", .title = "The summit" })
    return out
}

fn ex(out: *mut List(Exercise), chapter: usize, dir: []u8, name: []u8, source: []u8, expected: []u8, solution: []u8) {
    out.append(Exercise{ .chapter = chapter, .dir = dir, .name = name, .source = source, .expected = expected, .solution = solution })
}

/// Every exercise, embedded from `topo/exercises/` (the harness checks the
/// directory and this list agree).
pub fn exercises() -> List(Exercise) {
    var out = List(Exercise).new()
    ex(&mut out, 2, "02-hello-world", "fill_greeting", @embedFile("../topo/exercises/02-hello-world/fill_greeting.nx"), @embedFile("../topo/exercises/02-hello-world/fill_greeting.expected"), @embedFile("../topo/exercises/02-hello-world/fill_greeting.solution.nx"))
    ex(&mut out, 2, "02-hello-world", "predict_pitches", @embedFile("../topo/exercises/02-hello-world/predict_pitches.nx"), @embedFile("../topo/exercises/02-hello-world/predict_pitches.expected"), "")
    ex(&mut out, 3, "03-first-script", "fix_count_words", @embedFile("../topo/exercises/03-first-script/fix_count_words.nx"), @embedFile("../topo/exercises/03-first-script/fix_count_words.expected"), @embedFile("../topo/exercises/03-first-script/fix_count_words.solution.nx"))
    ex(&mut out, 3, "03-first-script", "write_initials", @embedFile("../topo/exercises/03-first-script/write_initials.nx"), @embedFile("../topo/exercises/03-first-script/write_initials.expected"), @embedFile("../topo/exercises/03-first-script/write_initials.solution.nx"))
    ex(&mut out, 5, "05-values-and-types", "fill_wrap", @embedFile("../topo/exercises/05-values-and-types/fill_wrap.nx"), @embedFile("../topo/exercises/05-values-and-types/fill_wrap.expected"), @embedFile("../topo/exercises/05-values-and-types/fill_wrap.solution.nx"))
    ex(&mut out, 5, "05-values-and-types", "fix_widths", @embedFile("../topo/exercises/05-values-and-types/fix_widths.nx"), @embedFile("../topo/exercises/05-values-and-types/fix_widths.expected"), @embedFile("../topo/exercises/05-values-and-types/fix_widths.solution.nx"))
    ex(&mut out, 5, "05-values-and-types", "predict_slices", @embedFile("../topo/exercises/05-values-and-types/predict_slices.nx"), @embedFile("../topo/exercises/05-values-and-types/predict_slices.expected"), "")
    ex(&mut out, 6, "06-functions-and-errors", "fill_orelse", @embedFile("../topo/exercises/06-functions-and-errors/fill_orelse.nx"), @embedFile("../topo/exercises/06-functions-and-errors/fill_orelse.expected"), @embedFile("../topo/exercises/06-functions-and-errors/fill_orelse.solution.nx"))
    ex(&mut out, 6, "06-functions-and-errors", "write_letter", @embedFile("../topo/exercises/06-functions-and-errors/write_letter.nx"), @embedFile("../topo/exercises/06-functions-and-errors/write_letter.expected"), @embedFile("../topo/exercises/06-functions-and-errors/write_letter.solution.nx"))
    ex(&mut out, 7, "07-structs-enums-traits", "fill_corners", @embedFile("../topo/exercises/07-structs-enums-traits/fill_corners.nx"), @embedFile("../topo/exercises/07-structs-enums-traits/fill_corners.expected"), @embedFile("../topo/exercises/07-structs-enums-traits/fill_corners.solution.nx"))
    ex(&mut out, 7, "07-structs-enums-traits", "write_area", @embedFile("../topo/exercises/07-structs-enums-traits/write_area.nx"), @embedFile("../topo/exercises/07-structs-enums-traits/write_area.expected"), @embedFile("../topo/exercises/07-structs-enums-traits/write_area.solution.nx"))
    ex(&mut out, 8, "08-ownership", "fix_moved", @embedFile("../topo/exercises/08-ownership/fix_moved.nx"), @embedFile("../topo/exercises/08-ownership/fix_moved.expected"), @embedFile("../topo/exercises/08-ownership/fix_moved.solution.nx"))
    ex(&mut out, 8, "08-ownership", "fill_own", @embedFile("../topo/exercises/08-ownership/fill_own.nx"), @embedFile("../topo/exercises/08-ownership/fill_own.expected"), @embedFile("../topo/exercises/08-ownership/fill_own.solution.nx"))
    ex(&mut out, 8, "08-ownership", "predict_refcount", @embedFile("../topo/exercises/08-ownership/predict_refcount.nx"), @embedFile("../topo/exercises/08-ownership/predict_refcount.expected"), "")
    ex(&mut out, 9, "09-collections", "fill_counts", @embedFile("../topo/exercises/09-collections/fill_counts.nx"), @embedFile("../topo/exercises/09-collections/fill_counts.expected"), @embedFile("../topo/exercises/09-collections/fill_counts.solution.nx"))
    ex(&mut out, 9, "09-collections", "write_unique", @embedFile("../topo/exercises/09-collections/write_unique.nx"), @embedFile("../topo/exercises/09-collections/write_unique.expected"), @embedFile("../topo/exercises/09-collections/write_unique.solution.nx"))
