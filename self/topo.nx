/// Every quiz, embedded from `topo/exercises/<chapter>/quiz.txt`.
pub fn quizzes() -> List(Quiz) {
    var out = List(Quiz).new()
    out.append(Quiz{ .chapter = 5, .dir = "05-values-and-types", .text = @embedFile("../topo/exercises/05-values-and-types/quiz.txt") })
    out.append(Quiz{ .chapter = 6, .dir = "06-functions-and-errors", .text = @embedFile("../topo/exercises/06-functions-and-errors/quiz.txt") })
    out.append(Quiz{ .chapter = 8, .dir = "08-ownership", .text = @embedFile("../topo/exercises/08-ownership/quiz.txt") })
    out.append(Quiz{ .chapter = 10, .dir = "10-project-calculator", .text = @embedFile("../topo/exercises/10-project-calculator/quiz.txt") })
    out.append(Quiz{ .chapter = 11, .dir = "11-project-todo", .text = @embedFile("../topo/exercises/11-project-todo/quiz.txt") })
    out.append(Quiz{ .chapter = 15, .dir = "15-effects", .text = @embedFile("../topo/exercises/15-effects/quiz.txt") })
    out.append(Quiz{ .chapter = 17, .dir = "17-networking", .text = @embedFile("../topo/exercises/17-networking/quiz.txt") })
    out.append(Quiz{ .chapter = 19, .dir = "19-packages", .text = @embedFile("../topo/exercises/19-packages/quiz.txt") })
    out.append(Quiz{ .chapter = 20, .dir = "20-shipping", .text = @embedFile("../topo/exercises/20-shipping/quiz.txt") })
    out.append(Quiz{ .chapter = 21, .dir = "21-project-neural-network", .text = @embedFile("../topo/exercises/21-project-neural-network/quiz.txt") })
    out.append(Quiz{ .chapter = 22, .dir = "22-tools", .text = @embedFile("../topo/exercises/22-tools/quiz.txt") })
    return out
}

// ----- what an exercise says about itself ------------------------------------------

/// The kind of an exercise, from its name's prefix.
pub fn kind_of(name: []u8) -> []u8 {
    if let i = name.find("_") { return name[..i] }
    return name
}

pub fn kind_label(kind: []u8) -> []u8 {
    if kind == "fill" { return "fill in the blank" }
    if kind == "fix" { return "fix the error" }
    if kind == "write" { return "write it" }
    if kind == "test" { return "make the tests pass" }
    if kind == "predict" { return "predict the output" }
    return kind
}

/// The task: the comment lines after `// topo:` up to the first hint or code.
pub fn task_lines(source: []u8) -> List([]u8) {
    var out = List([]u8).new()
    var first = true
    for l in source.lines() {
        let t = l.trim()
        if first { first = false; continue }
        if t.starts_with("// hint:") { continue }
        if let rest = strings.strip_prefix(t, "//") {
            let r = rest.trim()
            if r.len > 0 { out.append(r) }
            continue
        }
        break
    }
    return out
}

/// The hints: every `// hint:` line of the header.
pub fn hints(source: []u8) -> List([]u8) {
    var out = List([]u8).new()
    for l in source.lines() {
        let t = l.trim()
        if let rest = strings.strip_prefix(t, "// hint:") { out.append(rest.trim()); continue }
        if !t.starts_with("//") { break }
    }
    return out
}

// ----- progress -------------------------------------------------------------------------

fn load_done(path: []u8) -> List(String) {
    var out = List(String).new()
    let text = fs.read(path) catch { return out }
    for l in text[..].lines() {
        if let rest = strings.strip_prefix(l.trim(), "done ") { out.append(String.from(rest.trim())) }
    }
    return out
}

fn is_done(done: *List(String), key: []u8) -> bool {
    for d in done.* { if d[..] == key { return true } }
    return false
}

fn mark_done(path: []u8, key: []u8) {
    if path.len == 0 { return }
    let done = load_done(path)
    if is_done(&done, key) { return }
    let parent = fs.parent(path)
    if parent.len > 0 { fs.make_dirs(parent) catch { } }
    fs.append(path, format("done {}\n", .{key})[..]) catch { eprintln("note: cannot record progress in {}", .{path}) }
}

fn normalize(s: []u8) -> String {
    return strings.replace(s, "\r\n", "\n")
}

/// The first line where two texts differ, or null when they agree.
fn first_difference(expected: []u8, got: []u8) -> ?(usize, []u8, []u8) {
    var el = List([]u8).new()
    var gl = List([]u8).new()
    for l in expected.lines() { el.append(l) }
    for l in got.lines() { gl.append(l) }
    let n = if el.len > gl.len { el.len } else { gl.len }
    for i in 0..n {
        let e = if i < el.len { el[i] } else { "" }
        let g = if i < gl.len { gl[i] } else { "" }
        if e != g { return (i + 1, e, g) }
    }
    return null
}

// ----- the commands -----------------------------------------------------------------

fn chapter_by_number(n: usize) -> ?Chapter {
    for c in chapters() { if c.n == n { return c } }
    return null
}

/// The exercise a file stands for: its directory names the chapter
/// (`topo-05-values-and-types` or the repository's `05-values-and-types`),
/// its stem the exercise.
fn exercise_for(path: []u8) -> ?Exercise {
    let dir_name = fs.base_name(fs.parent(path))
    let dir = strings.strip_prefix(dir_name, "topo-") orelse dir_name
    let stem = fs.stem(path)
    for e in exercises() {
        if e.dir == dir and e.name == stem { return e }
    }
    return null
}

fn print_map(progress: []u8) {
    let done = load_done(progress)
    let all = exercises()
    let qs = quizzes()
    println("The Topo, chapter by chapter; `nx topo <n>` starts one, `nx topo check` grades it", .{})
    for c in chapters() {
        var total: usize = 0
        var have: usize = 0
        for e in all {
            if e.chapter != c.n { continue }
            total += 1
            if is_done(&done, format("{}/{}", .{e.dir, e.name})[..]) { have += 1 }
        }
        for q in qs {
            if q.chapter != c.n { continue }
            total += 1
            if is_done(&done, format("{}/quiz", .{q.dir})[..]) { have += 1 }
        }
        var status = String.new()
        if total > 0 {
            status = if have == total { format("{}/{} done, all of it", .{have, total}) } else { format("{}/{} done", .{have, total}) }
        }
        println("  {>2}  {<28} {}", .{c.n, c.title, status})
    }
}

fn start(n: usize) -> i32 {
    let c = chapter_by_number(n) orelse { eprintln("error: there is no chapter {}; `nx topo` lists them", .{n}); return 2 }
    var mine = List(Exercise).new()
    for e in exercises() { if e.chapter == n { mine.append(e) } }
    var has_quiz = false
    for q in quizzes() { if q.chapter == n { has_quiz = true } }
    if mine.len == 0 and !has_quiz {
        println("chapter {}, {}: no exercises yet; read it on the site and move on", .{n, c.title})
        return 0
    }
    let dir = format("topo-{}", .{c.dir})
    fs.make_dirs(dir[..]) catch { eprintln("error: cannot create {}", .{dir}); return 1 }
    println("chapter {}, {}: {} exercise(s) in {}/", .{n, c.title, mine.len, dir})
    for e in mine {
        let path = fs.join(dir[..], format("{}.nx", .{e.name})[..])
        if !fs.exists(path[..]) { fs.write(path[..], e.source) catch { eprintln("error: cannot write {}", .{path}); return 1 } }
        if e.expected.len > 0 and kind_of(e.name) != "predict" {
            fs.write(fs.join(dir[..], format("{}.expected", .{e.name})[..])[..], e.expected) catch { }
        }
        if kind_of(e.name) == "predict" {
            let guess = fs.join(dir[..], format("{}.guess", .{e.name})[..])
            if !fs.exists(guess[..]) { fs.write(guess[..], "") catch { } }
        }
        let task = task_lines(e.source)
        let first = if task.len > 0 { task[0] } else { "" }
        println("  {<24} {<20} {}", .{format("{}.nx", .{e.name}), kind_label(kind_of(e.name)), first})
    }
    println("edit them, then `nx topo check {}`; `nx topo hint {}/<file>` when stuck", .{dir, dir})
    if has_quiz { println("the chapter has a quiz too: `nx topo quiz {}`", .{n}) }
    return 0
}

/// Why an exercise file does not pass yet, or null when it does.
fn check_one(e: *Exercise, path: []u8, exe: []u8) -> ?String {
    let text = fs.read(path) catch { return format("cannot read {}", .{path}) }
    let kind = kind_of(e.name)
    if kind != "predict" {
        for l, i in text[..].lines() {
            if l.trim().starts_with("//") { continue }
            if l.find("???") != null { return format("still has a hole (???) on line {}", .{i + 1}) }
        }
    }
    let out_dir = fs.join(fs.temp_dir()[..], "nexium-topo")
    if kind == "fill" or kind == "fix" {
        let r = process.run([exe, "run", path, "--out-dir", out_dir[..]][..]) catch { return format("cannot run {}", .{exe}) }
        if r.code != 0 { return format("does not build or run (exit {}):\n{}", .{r.code, r.stderr[..].trim()}) }
        let got = normalize(r.stdout[..])
        let want = normalize(e.expected)
        if let d = first_difference(want[..].trim(), got[..].trim()) {
            return format("the output differs on line {}: it prints `{}`, the chapter recorded `{}`", .{d.0, d.2, d.1})
        }
        return null
    }
    if kind == "write" or kind == "test" {
        let r = process.run([exe, "test", path, "--out-dir", out_dir[..]][..]) catch { return format("cannot run {}", .{exe}) }
        if r.code != 0 {
            var msg = String.from("the tests do not pass:\n")
            msg.append(r.stdout[..].trim())
            if r.stderr.len > 0 { msg.append("\n"); msg.append(r.stderr[..].trim()) }
            return msg
        }
        return null
    }
    if kind == "predict" {
        let guess_path = fs.with_extension(path, "guess")
        let guess = fs.read(guess_path[..]) catch { return format("write what it prints into {} first", .{fs.base_name(guess_path[..])}) }
        let g = normalize(guess[..])
        if g[..].trim().len == 0 { return format("write what it prints into {} first", .{fs.base_name(guess_path[..])}) }
        let want = normalize(e.expected)
        if let d = first_difference(want[..].trim(), g[..].trim()) {
            return format("the guess differs on line {}: you wrote `{}`, the program prints `{}`; run it and see why", .{d.0, d.2, d.1})
        }
        return null
    }
    return format("unknown kind of exercise `{}`", .{kind})
}

fn check(paths: [][]u8, exe: []u8, progress: []u8) -> i32 {
    var files = List(String).new()
    var roots = List(String).new()
    for p in paths { roots.append(String.from(p)) }
    if roots.len == 0 {
        // every chapter directory here
        let names = fs.list(".") catch { List(String).new() }
        for nm in names { if nm[..].starts_with("topo-") and fs.is_dir(nm[..]) { roots.append(nm.clone()) } }
        if roots.len == 0 { eprintln("nothing to check here: `nx topo <n>` starts a chapter, or name a file or directory", .{}); return 2 }
    }
    for r in roots {
        if fs.is_dir(r[..]) {
            let names = fs.list(r[..]) catch { List(String).new() }
            for nm in names { if nm[..].ends_with(".nx") { files.append(fs.join(r[..], nm[..])) } }
        } else {
            files.append(r.clone())
        }
    }
    var passed: usize = 0
    var total: usize = 0
    for f in files {
        let e = exercise_for(f[..]) orelse { continue }
        total += 1
        if let why = check_one(&e, f[..], exe) {
            println("  --   {}: {}", .{f, why})
        } else {
            println("  ok   {}", .{f})
            passed += 1
            mark_done(progress, format("{}/{}", .{e.dir, e.name})[..])
        }
    }
    if total == 0 { eprintln("no exercise files found; `nx topo <n>` writes a chapter's", .{}); return 2 }
    if passed == total { println("{} of {} pass; the chapter is done, `nx topo` shows the map", .{passed, total}); return 0 }
    println("{} of {} pass", .{passed, total})
    return 1
}

fn show_hint(path: []u8) -> i32 {
    let e = exercise_for(path) orelse { eprintln("error: {} is not one of the Topo's exercises", .{path}); return 2 }
    let hs = hints(e.source)
    if hs.len == 0 { println("no hints for {}; the chapter's text is the hint", .{e.name}); return 0 }
    for h, i in hs { println("hint {}: {}", .{i + 1, h}) }
    return 0
}

fn show_solution(path: []u8) -> i32 {
    let e = exercise_for(path) orelse { eprintln("error: {} is not one of the Topo's exercises", .{path}); return 2 }
    if e.solution.len == 0 {
        println("{} has no solution file: run it and read the output", .{e.name})
        return 0
    }
    print("{}", .{e.solution})
    return 0
}

/// One question of a quiz: the text, the choices, which is right, why.
/// A quiz question. One that asks the compiler carries a program (`| `
/// lines), what is asked of it (`ask: effects NAME`, `ask: output`, `ask:
/// check`) and the compiler's own words (`says:`), which `nx topo verify`
/// holds to what the compiler says now.
struct Question { text: String, choices: List(String), right: usize, why: String, code: List(String), ask: String, says: List(String) }

fn new_question() -> Question {
    return Question{ .text = String.new(), .choices = List(String).new(), .right = 0, .why = String.new(), .code = List(String).new(), .ask = String.new(), .says = List(String).new() }
}

fn parse_quiz(text: []u8) -> List(Question) {
    var out = List(Question).new()
    var cur = new_question()
    for l in text.lines() {
        let t = l.trim()
        if t.len == 0 {
            if cur.text.len > 0 { out.append(cur) }
            cur = new_question()
            continue
        }
        // a line of the question's program, kept as written after the bar
        if t == "|" { cur.code.append(String.new()); continue }
        if t.starts_with("| ") {
            let at = l.find("| ") orelse 0
            cur.code.append(String.from(l[at + 2..l.len]))
            continue
        }
        if let a = strings.strip_prefix(t, "ask:") { cur.ask = String.from(a.trim()); continue }
        if let w = strings.strip_prefix(t, "says:") { cur.says.append(String.from(w.trim())); continue }
        if let q = strings.strip_prefix(t, "Q:") { cur.text = String.from(q.trim()); continue }
        if let c = strings.strip_prefix(t, "* ") { cur.right = cur.choices.len; cur.choices.append(String.from(c)); continue }
        if let c = strings.strip_prefix(t, "- ") { cur.choices.append(String.from(c)); continue }
        if let w = strings.strip_prefix(t, ">") { cur.why = String.from(w.trim()); continue }
    }
    if cur.text.len > 0 { out.append(cur) }
    return out
}

fn quiz(n: usize, progress: []u8) -> i32 {
    let c = chapter_by_number(n) orelse { eprintln("error: there is no chapter {}; `nx topo` lists them", .{n}); return 2 }
    var text: []u8 = ""
    for q in quizzes() { if q.chapter == n { text = q.text } }
    if text.len == 0 { println("chapter {}, {}: no quiz yet", .{n, c.title}); return 0 }
    let qs = parse_quiz(text)
    println("chapter {}, {}: {} question(s); answer with a number", .{n, c.title, qs.len})
    var right: usize = 0
    for q, qi in qs {
        println("", .{})
        println("{}. {}", .{qi + 1, q.text})
        for cl, li in q.code { println("  {>3}| {}", .{li + 1, cl}) }
        for ch, i in q.choices { println("   {}) {}", .{i + 1, ch}) }
        print("> ", .{})
        let line = io.read_line() orelse { println("", .{}); break }
        let pick = line[..].trim().parse_int(usize) catch { 0 }
        if pick == q.right + 1 {
            right += 1
            println("right. {}", .{q.why})
        } else {
            println("no: {}) {}. {}", .{q.right + 1, q.choices[q.right], q.why})
        }
        for w in q.says { println("   the compiler: {}", .{w}) }
    }
    println("", .{})
    println("{} of {} right", .{right, qs.len})
    if right == qs.len { mark_done(progress, format("{}/quiz", .{c.dir})[..]); return 0 }
    return 1
}

/// A choice as the compiler would write it: the backticks around code dropped.
fn plain(s: []u8) -> String {
    var out = String.new()
    for c in s { if c != '`' { out.push_byte(c) } }
    return out
}

/// What the compiler says about a question's program: the answer the starred
/// choice must read, and its own words. Null, after a message, when it cannot say.
fn ask_compiler(exe: []u8, q: *Question, dir: []u8) -> ?(String, List(String)) {
    var program = String.new()
    for l in q.code { program.append(l[..]); program.append("\n") }
    fs.write(fs.join(dir, "main.nx")[..], program[..]) catch { eprintln("error: cannot write the question's program", .{}); return null }
    let opts = process.Options{ .stdin = "", .cwd = dir }
    var words = List(String).new()
    let ask = q.ask[..]
    if let name = strings.strip_prefix(ask, "effects ") {
        let r = process.run_with([exe, "effects", "main.nx"][..], opts) catch { return null }
        var effects = String.new()
        for line in r.stdout[..].lines() {
            if !line.starts_with(format("fn {}(", .{name.trim()})[..]) { continue }
            var cut = line.len
            while cut > 1 and ! (line[cut - 1] == ' ' and line[cut - 2] == ' ') { cut -= 1 }
            effects = String.from(line[cut..line.len])
        }
        if effects.len == 0 { eprintln("error: `nx effects` does not list `{}`:\n{}{}", .{name, r.stdout, r.stderr}); return null }
        // per effect, the first reason `nx explain` gives: the one in the function itself
        if effects != "(pure)" {
            for e in effects[..].split(" ") {
                let x = process.run_with([exe, "explain", "main.nx", name.trim(), e][..], opts) catch { return null }
                var first = String.new()
                for xl, i in x.stdout[..].lines() { if i > 0 and first.len == 0 and xl.trim().len > 0 { first = String.from(xl.trim()) } }
                words.append(format("{}: {}", .{e, first}))
            }
        }
        return (effects, words)
    }
    if ask == "check" {
        let r = process.run_with([exe, "check", "main.nx"][..], opts) catch { return null }
        if r.code == 0 { return (String.from("it compiles"), words) }
        var line = String.new()
        for dl in r.stderr[..].lines() {
            if words.len == 0 { if let m = strings.strip_prefix(dl, "error: ") { words.append(String.from(m)) } }
            if line.len == 0 {
                if let at = strings.strip_prefix(dl.trim(), "--> main.nx:") { line = format("line {}", .{at.split(":")[0]}) }
            }
        }
        return (line, words)
    }
    if ask == "output" {
        let r = process.run_with([exe, "run", "main.nx", "--out-dir", "out"][..], opts) catch { return null }
        if r.code != 0 { eprintln("error: the question's program does not run:\n{}", .{r.stderr}); return null }
        return (String.from(r.stdout[..].trim()), words)
    }
    eprintln("error: unknown `ask: {}` (effects NAME, check, output)", .{ask})
    return null
}

/// `nx topo verify`: every quiz question that asks the compiler is answered
/// by it now: its starred choice is the compiler's answer and its `says:`
/// lines are the compiler's words, so no quiz outlives the language.
fn verify(exe: []u8) -> i32 {
    let dir = fs.join(fs.temp_dir()[..], "nexium-topo-quiz")
    fs.make_dirs(dir[..]) catch { }
    var asked: usize = 0
    var wrong: usize = 0
    for qz in quizzes() {
        for q, qi in parse_quiz(qz.text) {
            if q.ask.len == 0 { continue }
            asked += 1
            let said = ask_compiler(exe, &q, dir[..]) orelse { wrong += 1; continue }
            let (answer, words) = said
            let starred = plain(q.choices[q.right][..])
            if starred != answer {
                eprintln("{}/quiz, question {}: the starred choice is `{}`, the compiler says `{}`", .{qz.dir, qi + 1, starred, answer})
                wrong += 1
            }
            var same = words.len == q.says.len
            if same { for w, i in words { if w != q.says[i] { same = false } } }
            if !same {
                eprintln("{}/quiz, question {}: `says:` should read", .{qz.dir, qi + 1})
                for w in words { eprintln("says: {}", .{w}) }
                wrong += 1
            }
        }
    }
    fs.remove_all(dir[..]) catch { }
    if wrong > 0 { eprintln("{} question(s) disagree with the compiler", .{wrong}); return 1 }
    println("{} question(s) answered by the compiler, all as the quizzes say", .{asked})
    return 0
}

fn list_all() -> i32 {
    for e in exercises() { println("{}/{}", .{e.dir, e.name}) }
    for q in quizzes() { println("{}/quiz", .{q.dir}) }
    return 0
}

fn usage() {
    eprintln("usage: nx topo                       the route map and your progress", .{})
    eprintln("       nx topo <chapter>             write the chapter's exercises into topo-<chapter>/", .{})
    eprintln("       nx topo check [file|dir ...]  grade them with the compiler (all topo-*/ here by default)", .{})
    eprintln("       nx topo hint <file>           the hints of an exercise", .{})
    eprintln("       nx topo solution <file>       its solution", .{})
    eprintln("       nx topo quiz <chapter>        the chapter's questions", .{})
    eprintln("       nx topo verify                the quizzes' answers against the compiler (for the course's authors)", .{})
    eprintln("       nx topo reset                 forget the progress", .{})
}

/// `nx topo ...`: `args` are the words after `topo`; `exe` is this compiler,
/// `progress` the file that keeps what is done ("" keeps nothing).
pub fn run(args: [][]u8, exe: []u8, progress: []u8) -> i32 {
    if args.len == 0 { print_map(progress); return 0 }
    let cmd = args[0]
    if cmd == "check" { return check(args[1..], exe, progress) }
    if cmd == "hint" {
        if args.len < 2 { usage(); return 2 }
        return show_hint(args[1])
    }
    if cmd == "solution" {
        if args.len < 2 { usage(); return 2 }
        return show_solution(args[1])
    }
    if cmd == "quiz" {
        if args.len < 2 { usage(); return 2 }
        let n = args[1].parse_int(usize) catch { usage(); return 2 }
        return quiz(n, progress)
    }
    if cmd == "reset" {
        if progress.len > 0 { fs.remove(progress) catch { } }
        println("progress forgotten", .{})
        return 0
    }
    if cmd == "list" { return list_all() }
    if cmd == "verify" { return verify(exe) }
    let n = cmd.parse_int(usize) catch { 0 }
    if n > 0 { return start(n) }
    if cmd == "start" and args.len >= 2 {
        let n = args[1].parse_int(usize) catch { usage(); return 2 }
        return start(n)
    }
    usage()
    return 2
}
