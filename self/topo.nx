    var out = List(Exercise).new()
    ex(&mut out, 2, "02-hello-world", "fill_greeting", @embedFile("../topo/exercises/02-hello-world/fill_greeting.nx"), @embedFile("../topo/exercises/02-hello-world/fill_greeting.expected"), @embedFile("../topo/exercises/02-hello-world/fill_greeting.solution.nx"))
    ex(&mut out, 2, "02-hello-world", "predict_pitches", @embedFile("../topo/exercises/02-hello-world/predict_pitches.nx"), @embedFile("../topo/exercises/02-hello-world/predict_pitches.expected"), "")
    ex(&mut out, 3, "03-first-script", "fix_count_words", @embedFile("../topo/exercises/03-first-script/fix_count_words.nx"), @embedFile("../topo/exercises/03-first-script/fix_count_words.expected"), @embedFile("../topo/exercises/03-first-script/fix_count_words.solution.nx"))
