// self/check_exprs.nx: expressions. Literals and names, unary, binary and
// comparison operators with their overflow and range proofs, pipes, calls of
// functions and function values with their effects, the builtin functions,
// `if` with the facts its conditions establish, and casts.
// The methods are the checker's (`impl Checker`, decision 110).

import check
import parser

type Checker = check.Checker
const EFF_ALL = check.EFF_ALL
const EFF_ALLOCATES = check.EFF_ALLOCATES
const EFF_BLOCKS = check.EFF_BLOCKS
const EFF_FFI = check.EFF_FFI
const EFF_PANICS = check.EFF_PANICS
const EFF_REFCOUNTS = check.EFF_REFCOUNTS
const EFF_SHARED_MUTABLE = check.EFF_SHARED_MUTABLE
type FactState = check.FactState
type Facts = check.Facts
const INFER_FLOAT = check.INFER_FLOAT
const INFER_INT = check.INFER_INT
type ItemKind = check.ItemKind
const NONE = check.NONE
const NONE_NAME = check.NONE_NAME
type Narrowing = check.Narrowing
type Obligation = check.Obligation
type Range = check.Range
type TK = check.TK
type TKind = check.TKind

// ---------------------------------------------------------------- expressions

impl Checker {
    /// An expression in a value position. A namespace (`math`, an imported
    /// module) is an expression only as the base of a member access, so it is
    /// an error here; `check_expr_any` is for the three places that take one.
    fn check_expr(self: *mut Self, e: usize, expected: usize) -> usize {
        let r = self.check_expr_any(e, expected)
        if self.is_namespace(r) {
            let m = self.cur_module()
            let n = self.node(m, e)
            let what = if n.k == parser.NodeKind.Ident { n.name.clone() } else { String.from("this") }
            self.fail_here(n.start, format("`{}` is a module, not a value; use one of its members (`{}.name`)", .{what, what})[..])
            return self.error_expr(n.start, n.end)
        }
        return r
    }

    fn check_expr_any(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let k = n.k
        let start = n.start
        let end = n.end
        if k == parser.NodeKind.Lit { return self.check_lit(e, expected) }
        if k == parser.NodeKind.Ident { return self.check_ident(n.name.clone()[..], start, end) }
        if k == parser.NodeKind.Unary { return self.check_unary(e, expected) }
        if k == parser.NodeKind.Binary {
            let op = n.name.clone()
            let l = n.x
            let r = n.y
            return self.check_binary_parts(op[..], l, r, expected, start, end)
        }
        if k == parser.NodeKind.Call { return self.check_call(e, expected) }
        if k == parser.NodeKind.Pipe { return self.check_pipe(e, expected) }
        if k == parser.NodeKind.If { return self.check_if(e, expected) }
        if k == parser.NodeKind.Block {
            let tb = self.check_block_labeled(e, expected)
            let ty = self.tir.nodes[tb].ty
            let be = self.mk(TKind.BlockExpr, ty, self.tir.nodes[tb].start, self.tir.nodes[tb].end)
            self.tir.nodes[be].kids.append(tb)
            return be
        }
        if k == parser.NodeKind.Cast { return self.check_cast(e) }
        if k == parser.NodeKind.FieldE { return self.check_field(e, expected) }
        if k == parser.NodeKind.OptChain { return self.check_opt_chain(e, expected) }
        if k == parser.NodeKind.ChainSelf { return self.check_chain_self(e) }
        if k == parser.NodeKind.ImplicitVariant { return self.check_implicit_variant(e, expected) }
        if k == parser.NodeKind.Index { return self.check_index(e) }
        if k == parser.NodeKind.SliceE { return self.check_slice_op(e) }
        if k == parser.NodeKind.StructLit { return self.check_struct_lit(e, expected) }
        if k == parser.NodeKind.ArrayLit { return self.check_array_lit(e, expected) }
        if k == parser.NodeKind.TupleLit { return self.check_tuple_lit(e, expected) }
        if k == parser.NodeKind.Try { return self.check_try(e) }
        if k == parser.NodeKind.Catch { return self.check_catch(e, expected) }
        if k == parser.NodeKind.OrElse { return self.check_orelse(e, expected) }
        if k == parser.NodeKind.IfCapture { return self.check_if_capture(e, expected) }
        if k == parser.NodeKind.MethodCall { return self.check_method_call(e, expected) }
        if k == parser.NodeKind.Match { return self.check_match(e, expected) }
        if k == parser.NodeKind.Closure { return self.check_closure(e, expected) }
        if k == parser.NodeKind.BinConstruct { return self.check_bin_construct(e) }
        if k == parser.NodeKind.Comptime {
            // evaluated at compile time; the stage-2 evaluator folds scalars,
            // calls are a later stage (the expression is kept as checked)
            let inner_node = n.x
            let saved = self.ctx().is_comptime
            self.ctx().is_comptime = true
            var inner = self.check_expr(inner_node, expected)
            self.ctx().is_comptime = saved
            inner = self.finalize_expr(inner)
            if let v = self.eval_const_expr(inner) { return self.value_node(&v, self.tir.nodes[inner].ty, start, end) }
            self.fail_here(start, "this expression cannot be evaluated at compile time")
            return inner
        }
        if k == parser.NodeKind.Builtin { return self.check_at_builtin(e, expected) }
        if k == parser.NodeKind.Null {
            var t = NONE
            if expected != NONE {
                let ex = self.tys.shallow(expected)
                if self.tys.kind(ex) == TK.Opt { t = ex }
                if self.tys.kind(ex) == TK.Infer {
                    let v = self.tys.fresh_infer()
                    let o = self.tys.wrap(TK.Opt, v, false)
                    _ = self.unify(ex, o)
                    t = o
                }
            }
            if t == NONE {
                let v = self.tys.fresh_infer()
                t = self.tys.wrap(TK.Opt, v, false)
            }
            return self.mk(TKind.OptNull, t, start, end)
        }
        if k == parser.NodeKind.Undefined {
            if expected != NONE { return self.mk(TKind.Undefined, expected, start, end) }
            self.fail_here(start, "`undefined` needs a type from context, e.g. `var buf: [1500]u8 = undefined`")
            return self.error_expr(start, end)
        }
        if k == parser.NodeKind.Unreachable {
            self.add_effect(EFF_PANICS, start, "`unreachable` panics if reached")
            let nv = self.tys.never()
            return self.mk(TKind.Unreachable, nv, start, end)
        }
        if k == parser.NodeKind.ErrorLit {
            let name = n.name.clone()
            let id = self.error_id(name[..])
            let t = self.tys.err_set(0, false)
            let te = self.mk(TKind.ErrVal, t, start, end)
            self.tir.nodes[te].a = id
            if expected != NONE {
                let r = self.coerce(te, expected)
                if r != NONE { return r }
            }
            return te
        }
        if k == parser.NodeKind.Unwrap {
            let inner_node = n.x
            let inner = self.check_expr(inner_node, NONE)
            let t = self.tys.shallow(self.tir.nodes[inner].ty)
            if self.tys.kind(t) == TK.Opt {
                // proven by a dominating `x != null`
                let proven = self.tir.nodes[inner].k == TKind.Local and check.has_local(&self.ctx().nonnull, self.tir.nodes[inner].a)
                if !proven { self.add_effect(EFF_PANICS, start, "`.?` panics when the optional is null") }
                let r = self.mk(TKind.Unwrap, self.tys.list[t].args[0], start, end)
                self.tir.nodes[r].kids.append(inner)
                self.tir.nodes[r].flag = proven
                return r
            }
            self.fail_here(start, format("`.?` requires an optional but found `{}`", .{self.ty_name(t)})[..])
            return self.error_expr(start, end)
        }
        if k == parser.NodeKind.Deref {
            let inner_node = n.x
            let inner = self.check_expr(inner_node, NONE)
            let t = self.tys.shallow(self.tir.nodes[inner].ty)
            if self.tys.kind(t) == TK.Ptr {
                let r = self.mk(TKind.Deref, self.tys.list[t].args[0], start, end)
                self.tir.nodes[r].kids.append(inner)
                return r
            }
            self.fail_here(start, format("`.*` requires a pointer but found `{}`", .{self.ty_name(t)})[..])
            return self.error_expr(start, end)
        }
        if k == parser.NodeKind.TypeVal {
            let ty_node = n.x
            let st = self.ctx().self_ty
            let t = self.resolve_type(m, ty_node, st)
            let tt = self.tys.type_ty()
            let r = self.mk(TKind.TypeVal, tt, start, end)
            self.tir.nodes[r].a = t
            return r
        }
        if k == parser.NodeKind.UnsafeE {
            let body = n.x
            self.ctx().unsafe_depth += 1
            let tb = self.check_block(body, expected, NONE, NONE)
            self.ctx().unsafe_depth -= 1
            let ty = self.tir.nodes[tb].ty
            let be = self.mk(TKind.BlockExpr, ty, start, end)
            self.tir.nodes[be].kids.append(tb)
            return be
        }
        let snippet = self.source_text(m, start, if end - start > 40 { start + 40 } else { end })
        self.fail_here(start, format("unsupported expression (stage 2): `{}`", .{snippet})[..])
        return self.error_expr(start, end)
    }

    fn check_lit(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let kind = n.text.clone()
        let text = n.name.clone()
        let start = n.start
        let end = n.end
        var exp = NONE
        if expected != NONE { exp = self.tys.shallow(expected) }
        if kind == "int" {
            var big = false
            let v = check.parse_int_literal(text[..], &mut big) orelse {
                self.fail_here(start, format("literal `{}` does not fit in any integer type (the largest, `u128`, holds up to 340282366920938463463374607431768211455)", .{text})[..])
                return self.error_expr(start, end)
            }
            if exp != NONE {
                let ek = self.tys.kind(exp)
                if ek == TK.Int {
                    let name = self.tys.list[exp].name.clone()
                    if big and name != "u128" {
                        self.fail_here(start, format("literal `{}` does not fit in `{}` (range {} to {})", .{text, name, check.int_min(name[..]), check.int_max(name[..])})[..])
                    } else if !big and (v < check.int_min(name[..]) or v > check.int_max(name[..])) {
                        self.fail_here(start, format("literal `{}` does not fit in `{}` (range {} to {})", .{v, name, check.int_min(name[..]), check.int_max(name[..])})[..])
                    }
                    let r = self.int_node(v, exp, start, end)
                    self.tir.nodes[r].flag = big
                    return r
                }
                if ek == TK.Float { return self.float_node(if big { @truncate(u128, v) as f64 } else { v as f64 }, exp, start, end) }
                if let ik = self.tys.infer_kind_of(exp) {
                    if ik == INFER_FLOAT { return self.float_node(v as f64, exp, start, end) }
                    if ik == INFER_INT {
                        let r = self.int_node(v, exp, start, end)
                        self.tir.nodes[r].flag = big
                        self.note_open_literal(r)
                        return r
                    }
                }
                if ek == TK.Distinct {
                    let u = self.distinct_underlying(self.tys.list[exp].def)
                    if self.tys.is_integer(u) { return self.int_node(v, exp, start, end) }
                    if self.tys.is_float(u) { return self.float_node(v as f64, exp, start, end) }
                }
            }
            let t = self.tys.int_lit()
            let r = self.int_node(v, t, start, end)
            self.tir.nodes[r].flag = big
            self.note_open_literal(r)
            return r
        }
        if kind == "float" {
            let f = text[..].parse_float() catch { 0.0 }
            if exp != NONE {
                if self.tys.kind(exp) == TK.Float { return self.float_node(f, exp, start, end) }
                if self.tys.kind(exp) == TK.Distinct {
                    let u = self.distinct_underlying(self.tys.list[exp].def)
                    if self.tys.is_float(u) { return self.float_node(f, exp, start, end) }
                }
            }
            let t = self.tys.float_lit()
            return self.float_node(f, t, start, end)
        }
        if kind == "str" or kind == "bytes" {
            let t = self.tys.str_slice()
            // `[N]u8` from a string literal when an array of that length is expected
            if exp != NONE and self.tys.kind(exp) == TK.Array {
                let et = self.tys.shallow(self.tys.list[exp].args[0])
                if self.tys.list[exp].n as usize == text.len and self.tys.kind(et) == TK.Int and self.tys.list[et].name == "u8" {
                    let u8t = self.tys.u8_ty()
                    let arr = self.mk(TKind.ArrayLit, exp, start, end)
                    for b in text {
                        let el = self.int_node(b as i128, u8t, start, end)
                        self.tir.nodes[arr].kids.append(el)
                    }
                    return arr
                }
            }
            let r = self.mk(TKind.Str, t, start, end)
            self.tir.nodes[r].text = text.clone()
            return r
        }
        if kind == "char" {
            let c = text[..].parse_int(i128) catch { 0 }
            if exp != NONE and self.tys.kind(exp) == TK.Int {
                let name = self.tys.list[exp].name.clone()
                if c <= check.int_max(name[..]) { return self.int_node(c, exp, start, end) }
                self.fail_here(start, format("character literal does not fit in `{}`", .{name})[..])
            }
            let t = self.tys.char_ty()
            let r = self.mk(TKind.Char, t, start, end)
            self.tir.nodes[r].ival = c
            return r
        }
        if kind == "bool" {
            let t = self.tys.bool_ty()
            let r = self.mk(TKind.Bool, t, start, end)
            self.tir.nodes[r].flag = text == "true"
            return r
        }
        self.fail_here(start, "unknown literal")
        return self.error_expr(start, end)
    }

    /// Whether `t` is a still-open integer literal type.
    fn open_int(self: *mut Self, t: usize) -> bool {
        if let ik = self.tys.infer_kind_of(self.tys.shallow(t)) { return ik == INFER_INT }
        return false
    }

    fn int_node(self: *mut Self, v: i128, ty: usize, start: usize, end: usize) -> usize {
        let r = self.mk(TKind.Int, ty, start, end)
        self.tir.nodes[r].ival = v
        return r
    }
    fn float_node(self: *mut Self, v: f64, ty: usize, start: usize, end: usize) -> usize {
        let r = self.mk(TKind.Float, ty, start, end)
        self.tir.nodes[r].fval = v
        return r
    }

    fn distinct_underlying(self: *mut Self, alias: usize) -> usize {
        let a_node = self.aliases[alias].node
        let a_mod = self.aliases[alias].module
        let target_node = self.node(a_mod, a_node).x
        return self.resolve_type(a_mod, target_node, NONE)
    }

    fn check_ident(self: *mut Self, name: []u8, start: usize, end: usize) -> usize {
        let l = self.lookup_local(name)
        if l != NONE {
            let ty = self.ctx().locals[l].ty
            if let moved_at = self.ctx().moved.get(l) {
                _ = moved_at
                self.fail_here(start, format("use of `{}` after it was moved", .{name})[..])
            }
            // naming the target of `x = v` is a write, not a read of what `x` views
            if l != self.ctx().assign_target {
                self.ctx().locals[l].last_use = start
                if self.ctx().locals[l].origins.len > 0 { self.check_view_use(l, start) }
            }
            let r = self.mk(TKind.Local, ty, start, end)
            self.tir.nodes[r].a = l
            if self.lookup_deref(name) {
                let pt = self.tys.shallow(ty)
                let inner = if self.tys.kind(pt) == TK.Ptr { self.tys.list[pt].args[0] } else { ty }
                let d = self.mk(TKind.Deref, inner, start, end)
                self.tir.nodes[d].kids.append(r)
                return d
            }
            return r
        }
        let m = self.cur_module()
        if let item = self.lookup(m, name) {
            if item.kind == ItemKind.Fn {
                let fid = item.id
                if self.fns[fid].is_generic {
                    self.fail_here(start, format("`{}` is generic; call it with arguments so its type parameters can be inferred", .{name})[..])
                    return self.error_expr(start, end)
                }
                if self.fn_takes_own(fid) {
                    self.fail_here(start, format("`{}` takes `own` parameters and cannot be used as a function value; call it directly", .{name})[..])
                    return self.error_expr(start, end)
                }
                let inst = self.instantiate(fid, List(usize).new())
                var ps = List(usize).new()
                for p in self.insts[inst].params { ps.append(self.insts[inst].locals[p].ty) }
                let r = self.insts[inst].ret
                let neg = self.insts[inst].declared_neg
                let ft = self.tys.func(ps, r, EFF_ALL & ~neg)
                let te = self.mk(TKind.FnToFat, ft, start, end)
                self.tir.nodes[te].a = inst
                return te
            }
            if item.kind == ItemKind.Const {
                let ty = self.resolve_const(item.id)
                // a scalar constant is inlined as its value
                let init = self.consts[item.id].value
                if init != NONE {
                    if let v = self.eval_const(init) { return self.value_node(&v, ty, start, end) }
                }
                let te = self.mk(TKind.Const, ty, start, end)
                self.tir.nodes[te].a = item.id
                return te
            }
            if item.kind == ItemKind.Global {
                let ty = self.global_type(item.id)
                if self.ctx().unsafe_depth == 0 and !self.ctx().is_comptime {
                    self.fail_here(start, format("access to mutable global `{}` requires an `unsafe` block", .{name})[..])
                }
                self.add_effect(EFF_SHARED_MUTABLE, start, "access to a mutable global")
                self.global_uses.append(Obligation{ .inst = item.id, .neg = 0, .at = start, .module = m })
                self.global_use_fns.append(self.ctx().fn_name.clone())
                let te = self.mk(TKind.Global, ty, start, end)
                self.tir.nodes[te].a = item.id
                return te
            }
            if item.kind == ItemKind.Struct or item.kind == ItemKind.Enum {
                let n_params = if item.kind == ItemKind.Struct { self.structs[item.id].tparams.len } else { self.enums[item.id].tparams.len }
                if n_params > 0 {
                    self.fail_here(start, format("`{}` is generic; write `{}(...)`", .{name, name})[..])
                    return self.error_expr(start, end)
                }
                let t = self.tys.of_def(if item.kind == ItemKind.Struct { TK.Struct } else { TK.Enum }, item.id, List(usize).new())
                return self.type_val(t, start, end)
            }
            if item.kind == ItemKind.Alias {
                let t = self.resolve_alias(item.id)
                return self.type_val(t, start, end)
            }
            if item.kind == ItemKind.ErrorSet {
                let t = self.tys.err_set(item.id, true)
                return self.type_val(t, start, end)
            }
            if item.kind == ItemKind.Trait {
                self.fail_here(start, format("`{}` is a trait and cannot be used as a value", .{name})[..])
                return self.error_expr(start, end)
            }
            if item.kind == ItemKind.Module {
                let te = self.mk(TKind.Unit, NONE, start, end)
                self.tir.nodes[te].name = format("module:{}", .{item.id})
                return te
            }
        }
        let g = self.env_lookup(name)
        if g != NONE { return self.type_val(g, start, end) }
        if name == "String" {
            let t = self.tys.string()
            return self.type_val(t, start, end)
        }
        if name == "List" or name == "Map" or check.is_builtin_namespace(name) or name == "context" or name == "Ordering" {
            let te = self.mk(TKind.Unit, NONE, start, end)
            self.tir.nodes[te].name = String.from(name)
            return te
        }
        self.fail_here(start, format("cannot find `{}` in this scope", .{name})[..])
        return self.error_expr(start, end)
    }

    fn type_val(self: *mut Self, t: usize, start: usize, end: usize) -> usize {
        let tt = self.tys.type_ty()
        let r = self.mk(TKind.TypeVal, tt, start, end)
        self.tir.nodes[r].a = t
        return r
    }

    fn check_unary(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let op = n.name.clone()
        let inner_node = n.x
        let start = n.start
        let end = n.end
        if op == "&" or op == "&mut" {
            let mutable = op == "&mut"
            var inner_expected = NONE
            if expected != NONE {
                let ex = self.tys.shallow(expected)
                if self.tys.kind(ex) == TK.Ptr { inner_expected = self.tys.list[ex].args[0] }
            }
            let inner = self.check_expr(inner_node, inner_expected)
            if mutable and self.is_place(inner) and !self.place_mutable(inner) {
                self.fail_here(start, "cannot take a mutable reference to an immutable value; declare it with `var`")
            }
            let it = self.tir.nodes[inner].ty
            let pt = self.tys.wrap(TK.Ptr, it, mutable)
            let r = self.mk(TKind.AddrOf, pt, start, end)
            self.tir.nodes[r].flag = mutable
            self.tir.nodes[r].kids.append(inner)
            // whoever holds `&mut x` may change it: its facts end here
            if mutable and self.tir.nodes[inner].k == TKind.Local { self.forget_local(self.tir.nodes[inner].a) }
            return r
        }
        if op == "!" {
            let bt = self.tys.bool_ty()
            var inner = self.check_expr(inner_node, bt)
            inner = self.coerce_or_error(inner, bt, "operand of `!`")
            return self.unary_node("!", "plain", inner, bt, start, end)
        }
        if op == "-" {
            // `-128` is one literal, not the negation of 128 (which would not fit an i8)
            let ln = self.node(m, inner_node)
            if ln.k == parser.NodeKind.Lit and ln.text == "int" and expected != NONE {
                let et = self.tys.shallow(expected)
                if self.tys.kind(et) == TK.Int and check.int_signed(self.tys.list[et].name[..]) {
                    let mx = check.int_max(self.tys.list[et].name[..])
                    let v = ln.name[..].parse_int(i128) catch { -1 }
                    if v >= 0 and v <= mx +| 1 { return self.int_node(-v, et, start, end) }
                    // the one literal past i128's maximum is its minimum, negated
                    if v < 0 and ln.name == "170141183460469231731687303715884105728" and self.tys.list[et].name == "i128" {
                        return self.int_node(check.int_min("i128"), et, start, end)
                    }
                }
            }
            // with no type expected, `-9223372036854775808` is one open literal
            // too, range-checked with the others once its type is known
            if ln.k == parser.NodeKind.Lit and ln.text == "int" and (expected == NONE or self.open_int(expected)) {
                let v = ln.name[..].parse_int(i128) catch { -1 }
                if v >= 0 {
                    let t = if expected == NONE { self.tys.int_lit() } else { self.tys.shallow(expected) }
                    let r = self.int_node(-v, t, start, end)
                    self.note_open_literal(r)
                    return r
                }
            }
            let inner = self.check_expr(inner_node, expected)
            let t = self.tys.shallow(self.tir.nodes[inner].ty)
            if self.tys.is_float(t) { return self.unary_node("-", "float", inner, t, start, end) }
            if self.tys.is_integer(t) {
                if self.tys.kind(t) == TK.Int and !check.int_signed(self.tys.list[t].name[..]) {
                    self.fail_here(start, format("cannot negate a value of unsigned type `{}`", .{self.tys.list[t].name})[..])
                }
                var proven = false
                if let r = self.expr_range(inner) {
                    if let tr = self.type_range(t) { proven = r.lo > tr.lo }
                }
                if !proven { self.add_effect(EFF_PANICS, start, "negation overflows for the minimum value") }
                return self.unary_node("-", "checked", inner, t, start, end)
            }
            if self.tys.kind(t) == TK.Distinct {
                let u = self.distinct_underlying(self.tys.list[t].def)
                let mode = if self.tys.is_float(u) { "float" } else { "checked" }
                return self.unary_node("-", mode, inner, t, start, end)
            }
            self.fail_here(start, format("cannot negate a value of type `{}`", .{self.ty_name(t)})[..])
            return self.error_expr(start, end)
        }
        // `~`
        let inner = self.check_expr(inner_node, expected)
        let t = self.tys.shallow(self.tir.nodes[inner].ty)
        if !self.tys.is_integer(t) { self.fail_here(start, format("`~` requires an integer but found `{}`", .{self.ty_name(t)})[..]) }
        return self.unary_node("~", "plain", inner, t, start, end)
    }

    fn unary_node(self: *mut Self, op: []u8, mode: []u8, inner: usize, ty: usize, start: usize, end: usize) -> usize {
        let r = self.mk(TKind.Unary, ty, start, end)
        self.tir.nodes[r].name = String.from(mode)
        self.tir.nodes[r].text = String.from(op)
        self.tir.nodes[r].kids.append(inner)
        return r
    }

    fn binary_node(self: *mut Self, op: []u8, mode: []u8, proven: bool, l: usize, r: usize, ty: usize, start: usize, end: usize) -> usize {
        let b = self.mk(TKind.Binary, ty, start, end)
        self.tir.nodes[b].text = String.from(op)
        self.tir.nodes[b].name = String.from(mode)
        self.tir.nodes[b].flag = proven
        self.tir.nodes[b].kids.append(l)
        self.tir.nodes[b].kids.append(r)
        return b
    }

    fn check_binary_parts(self: *mut Self, op: []u8, lhs: usize, rhs: usize, expected: usize, start: usize, end: usize) -> usize {
        if op == "and" or op == "or" {
            let bt = self.tys.bool_ty()
            var l = self.check_expr(lhs, bt)
            l = self.coerce_or_error(l, bt, "operand of a logical operator")
            var r = self.check_expr(rhs, bt)
            r = self.coerce_or_error(r, bt, "operand of a logical operator")
            let node = self.mk(TKind.Logical, bt, start, end)
            self.tir.nodes[node].flag = op == "and"
            self.tir.nodes[node].kids.append(l)
            self.tir.nodes[node].kids.append(r)
            return node
        }
        if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=" {
            return self.check_comparison(op, lhs, rhs, start, end)
        }
        let is_arith = op == "+" or op == "-" or op == "*" or op == "/" or op == "%" or op == "+%" or op == "-%" or op == "*%" or op == "+|" or op == "-|" or op == "*|"
        let is_bitwise = op == "&" or op == "|" or op == "^" or op == "<<" or op == ">>"
        let hint = if is_arith { expected } else { NONE }
        let l = self.check_expr(lhs, hint)
        let lt = self.tys.shallow(self.tir.nodes[l].ty)
        if op == "<<" or op == ">>" {
            let r = self.check_expr(rhs, NONE)
            let rt = self.tys.shallow(self.tir.nodes[r].ty)
            if !self.tys.is_integer(lt) or !self.tys.is_integer(rt) { self.fail_here(start, "shift operands must be integers") }
            var bits: i128 = 64
            var have_bits = false
            if self.tys.kind(lt) == TK.Int {
                bits = check.int_bits(self.tys.list[lt].name[..]) as i128
                have_bits = true
            }
            var proven = false
            if let rr = self.expr_range(r) { proven = rr.lo >= 0 and rr.hi < bits }
            _ = have_bits
            if !proven { self.add_effect(EFF_PANICS, start, "shift amount may exceed the bit width") }
            let res = self.tys.resolve(lt, false)
            return self.binary_node(op, "checked", proven, l, r, res, start, end)
        }
        var r = self.check_expr(rhs, lt)
        let rc = self.coerce(r, lt)
        if rc == NONE {
            let rt = self.tir.nodes[r].ty
            let ln = self.ty_name(lt)
            let rn = self.ty_name(rt)
            let lc = self.coerce(l, rt)
            if lc != NONE {
                self.fail_here(start, format("mismatched operand types `{}` and `{}` for `{}`; numeric conversions are explicit (`as`)", .{ln, rn, op})[..])
            } else {
                self.fail_here(start, format("mismatched operand types `{}` and `{}` for `{}`", .{ln, rn, op})[..])
            }
            return self.error_expr(start, end)
        }
        r = rc
        let t = self.tys.shallow(self.tir.nodes[l].ty)
        var under = t
        if self.tys.kind(t) == TK.Distinct { under = self.distinct_underlying(self.tys.list[t].def) }
        let is_int = self.tys.is_integer(under)
        let is_float = self.tys.is_float(under)
        let is_bool = self.tys.kind(self.tys.shallow(under)) == TK.Bool
        if is_bitwise and ! (is_int or is_bool) {
            self.fail_here(start, format("bitwise `{}` requires integer operands but found `{}`", .{op, self.ty_name(t)})[..])
            return self.error_expr(start, end)
        }
        if is_arith and ! (is_int or is_float) {
            self.fail_here(start, format("cannot apply `{}` to values of type `{}`", .{op, self.ty_name(t)})[..])
            return self.error_expr(start, end)
        }
        var mode = "checked"
        let wrapping = op == "+%" or op == "-%" or op == "*%"
        let saturating = op == "+|" or op == "-|" or op == "*|"
        if is_float {
            if wrapping or saturating { self.fail_here(start, "wrapping and saturating operators apply to integers only") }
            mode = "float"
        } else if is_bool {
            mode = "plain"
        } else if wrapping {
            mode = "wrap"
        } else if saturating {
            mode = "sat"
        } else if op == "&" or op == "|" or op == "^" {
            mode = "plain"
        }
        var proven = true
        if mode == "checked" {
            let tmp = self.binary_node(op, mode, false, l, r, t, start, end)
            var fits = false
            if let rr = self.expr_range_raw(tmp) {
                if let tr = self.type_range(under) { fits = rr.lo >= tr.lo and rr.hi <= tr.hi }
            }
            var div_ok = true
            if op == "/" or op == "%" {
                div_ok = false
                if let rr = self.expr_range(r) { div_ok = rr.lo > 0 or rr.hi < 0 }
                if !div_ok and self.tir.nodes[r].k == TKind.Local and check.has_local(&self.ctx().nonzero, self.tir.nodes[r].a) { div_ok = true }
            }
            proven = fits and div_ok
            if !proven {
                let why = if op == "/" or op == "%" { "division may divide by zero or overflow" } else { "arithmetic may overflow (use `+%` to wrap or `+|` to saturate)" }
                self.add_effect(EFF_PANICS, start, why)
            }
        }
        let res = self.tys.resolve(t, false)
        return self.binary_node(op, mode, proven, l, r, res, start, end)
    }

    fn check_comparison(self: *mut Self, op: []u8, lhs: usize, rhs: usize, start: usize, end: usize) -> usize {
        let bt = self.tys.bool_ty()
        var l = self.check_expr(lhs, NONE)
        let lt = self.tys.shallow(self.tir.nodes[l].ty)
        var r = self.check_expr(rhs, lt)
        let rc = self.coerce(r, lt)
        if rc != NONE {
            r = rc
        } else {
            let rt = self.tir.nodes[r].ty
            let lc = self.coerce(l, rt)
            if lc == NONE {
                self.fail_here(start, format("cannot compare `{}` with `{}`", .{self.ty_name(self.tir.nodes[l].ty), self.ty_name(rt)})[..])
                return self.error_expr(start, end)
            }
            l = lc
        }
        let t = self.tys.shallow(self.tir.nodes[l].ty)
        var under = t
        if self.tys.kind(t) == TK.Distinct { under = self.tys.shallow(self.distinct_underlying(self.tys.list[t].def)) }
        let k = self.tys.kind(under)
        let ordered = op == "<" or op == "<=" or op == ">" or op == ">="
        if k == TK.Int or k == TK.Float or k == TK.Char or k == TK.Infer {
            // fine
        } else if (k == TK.Bool or k == TK.Ptr or k == TK.ErrorSet) and !ordered {
            // fine
        } else if k == TK.Slice {
            let el = self.tys.list[under].args[0]
            let es = self.tys.shallow(el)
            let is_u8 = self.tys.kind(es) == TK.Int and self.tys.list[es].name == "u8"
            if !is_u8 and ordered { self.fail_here(start, format("cannot order values of type `{}`", .{self.ty_name(t)})[..]) }
            let cmp = self.builtin_node("SliceEq", bt, start, end)
            self.tir.nodes[cmp].kids.append(l)
            self.tir.nodes[cmp].kids.append(r)
            self.tir.nodes[cmp].kids2.append(el)
            return self.finish_compare(op, cmp, start, end)
        } else if k == TK.Str {
            let u8t = self.tys.u8_ty()
            let sl = self.tys.wrap(TK.Slice, u8t, false)
            let l2 = self.wrap_node(TKind.StrToSlice, l, sl)
            let r2 = self.wrap_node(TKind.StrToSlice, r, sl)
            self.tir.nodes[l2].start = start
            self.tir.nodes[l2].end = end
            self.tir.nodes[r2].start = start
            self.tir.nodes[r2].end = end
            let cmp = self.builtin_node("SliceEq", bt, start, end)
            self.tir.nodes[cmp].kids.append(l2)
            self.tir.nodes[cmp].kids.append(r2)
            self.tir.nodes[cmp].kids2.append(u8t)
            return self.finish_compare(op, cmp, start, end)
        } else if k == TK.Enum {
            let d = self.tys.list[under].def
            var all_unit = true
            let em = self.enums[d].module
            let variants = self.enums[d].variants.clone()
            for v in variants { if self.node(em, v).text != "unit" { all_unit = false } }
            let derived = check.list_has(&self.enums[d].derives, "Eq") or check.list_has(&self.enums[d].derives, "Ord")
            if ! (all_unit or derived) {
                self.fail_here(start, format("enum `{}` has payloads; add `derive(Eq)` to compare it, or use `match`", .{self.enums[d].name})[..])
            }
            if ordered and !check.list_has(&self.enums[d].derives, "Ord") {
                self.fail_here(start, format("enum `{}` is not ordered; add `derive(Ord)`", .{self.enums[d].name})[..])
            }
        } else if k == TK.Struct {
            let d = self.tys.list[under].def
            if self.structs[d].kind == "ref" and !ordered {
                let cmp = self.builtin_node("RefEq", bt, start, end)
                self.tir.nodes[cmp].kids.append(l)
                self.tir.nodes[cmp].kids.append(r)
                return self.finish_compare(op, cmp, start, end)
            }
            let want = if ordered { "Ord" } else { "Eq" }
            if !check.list_has(&self.structs[d].derives, want) {
                self.fail_here(start, format("`{}` cannot be compared with `{}`; add `derive({})` to the struct", .{self.structs[d].name, op, want})[..])
            }
        } else if k == TK.Opt and !ordered {
            if ! (self.tir.nodes[r].k == TKind.OptNull or self.tir.nodes[l].k == TKind.OptNull) {
                self.fail_here(start, "compare optionals against `null`, or unwrap them first")
            }
        } else {
            self.fail_here(start, format("cannot compare values of type `{}` with `{}`", .{self.ty_name(t), op})[..])
        }
        return self.binary_node(op, "plain", true, l, r, bt, start, end)
    }

    fn finish_compare(self: *mut Self, op: []u8, cmp: usize, start: usize, end: usize) -> usize {
        let bt = self.tys.bool_ty()
        if op == "==" { return cmp }
        if op == "!=" { return self.unary_node("!", "plain", cmp, bt, start, end) }
        // ordered comparison of byte slices: a memcmp-style compare against zero
        let it = self.tys.int("i32")
        let c = self.builtin_node("SliceFind", it, start, end)
        self.tir.nodes[c].kids = self.tir.nodes[cmp].kids.clone()
        self.tir.nodes[c].kids2.append(self.tir.nodes[cmp].kids2[0])
        self.tir.nodes[c].kids2.append(it)
        let zero = self.int_node(0, it, start, end)
        return self.binary_node(op, "plain", true, c, zero, bt, start, end)
    }

    fn builtin_node(self: *mut Self, name: []u8, ty: usize, start: usize, end: usize) -> usize {
        let b = self.mk(TKind.Builtin, ty, start, end)
        self.tir.nodes[b].name = String.from(name)
        return b
    }

    // ----- calls -----------------------------------------------------------------------------

    /// `x |> f(a)` is `f(x, a)`: a call node with the left side prepended to
    /// the arguments, spanning the whole pipe.
    fn check_pipe(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let lhs = n.x
        let rhs = n.y
        let start = n.start
        let end = n.end
        let rn = self.node(m, rhs)
        let rk = rn.k
        if rk == parser.NodeKind.Call or rk == parser.NodeKind.MethodCall {
            var call = self.blank_node(rk, start, end)
            call.name = rn.name.clone()
            call.x = rn.x
            call.kids.append(lhs)
            for a in rn.kids.clone() { call.kids.append(a) }
            let id = self.mods[m].parsed.tree.add(call)
            if rk == parser.NodeKind.Call { return self.check_call(id, expected) }
            return self.check_method_call(id, expected)
        }
        if rk == parser.NodeKind.Ident or rk == parser.NodeKind.FieldE {
            var call = self.blank_node(parser.NodeKind.Call, start, end)
            call.x = rhs
            call.kids.append(lhs)
            let id = self.mods[m].parsed.tree.add(call)
            return self.check_call(id, expected)
        }
        self.fail_here(rn.start, "the right side of `|>` must be a call, e.g. `x |> f(a)`")
        return self.error_expr(start, end)
    }

    fn check_call(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let callee = n.x
        let args = n.kids.clone()
        let start = n.start
        let end = n.end
        let cn = self.node(m, callee)
        if cn.k == parser.NodeKind.Ident {
            let name = cn.name.clone()
            if self.lookup_local(name[..]) == NONE {
                let item = self.lookup(m, name[..])
                if item == null {
                    let b = self.check_builtin_fn(name[..], args[..], start, end)
                    if b != NONE { return b }
                    if self.env_lookup(name[..]) == NONE and ! (name == "List" or name == "Map" or name == "String" or name == "Allocator") {
                        self.fail_here(start, format("cannot find function `{}`", .{name})[..])
                        for a in args { _ = self.check_expr(a, NONE) }
                        return self.error_expr(start, end)
                    }
                }
                if let it = item {
                    if it.kind == ItemKind.Fn { return self.call_fn_def(it.id, NONE, args[..], expected, start, end) }
                }
            }
        }
        if cn.k == parser.NodeKind.FieldE {
            // `Type.assoc(...)`, `mod.f(...)`, `ns.f(...)`, or a call through a field of function type
            let base_node = cn.x
            let fname = cn.name.clone()
            let b = self.check_expr_any(base_node, NONE)
            if self.is_namespace(b) {
                let ns = self.tir.nodes[b].name.clone()
                return self.check_namespace_call(ns[..], fname[..], args[..], expected, start, end)
            }
            let bt = self.tys.shallow(self.tir.nodes[b].ty)
            if self.tys.kind(bt) == TK.Type and self.tir.nodes[b].k == TKind.TypeVal {
                return self.check_static_call(self.tir.nodes[b].a, fname[..], args[..], expected, start, end)
            }
            let f = self.field_access(b, fname[..], cn.start, cn.end)
            return self.call_value(f, args[..], start, end)
        }
        if cn.k == parser.NodeKind.Ident {
            // a generic type instantiated in expression position: `List(i32)`, `Pair(i32, f64)`
            let name = cn.name.clone()
            var is_type = name == "List" or name == "Map" or name == "String"
            if let it = self.lookup(m, name[..]) { if it.kind == ItemKind.Struct or it.kind == ItemKind.Enum { is_type = true } }
            if is_type {
                var targs = List(usize).new()
                for a in args { targs.append(self.expr_as_type(a)) }
                let st = self.ctx().self_ty
                let t = self.named_type(m, name[..], NONE_NAME, targs, start, st)
                return self.type_val(t, start, end)
            }
        }
        let f = self.check_expr(callee, NONE)
        let ft = self.tys.shallow(self.tir.nodes[f].ty)
        if self.tys.kind(ft) == TK.Type and self.tir.nodes[f].k == TKind.TypeVal {
            let tn = self.ty_name(self.tir.nodes[f].a)
            self.fail_here(start, format("`{}` is a type; construct it with `{}{{ .field = value }}`", .{tn, tn})[..])
            return self.error_expr(start, end)
        }
        return self.call_value(f, args[..], start, end)
    }

    fn call_value(self: *mut Self, f: usize, args: []usize, start: usize, end: usize) -> usize {
        let ft = self.tys.shallow(self.tir.nodes[f].ty)
        if self.tys.kind(ft) != TK.Fn {
            self.fail_here(start, format("cannot call a value of type `{}`", .{self.ty_name(ft)})[..])
            for a in args { _ = self.check_expr(a, NONE) }
            return self.error_expr(start, end)
        }
        let all = self.tys.list[ft].args.clone()
        let n_params = all.len - 1
        let ret = all[n_params]
        let eff = self.tys.list[ft].n
        if args.len != n_params {
            self.fail_here(start, format("this function takes {} argument(s) but {} were given", .{n_params, args.len})[..])
            return self.error_expr(start, end)
        }
        var targs = List(usize).new()
        for a, i in args {
            var te = self.check_expr(a, all[i])
            te = self.coerce_or_error(te, all[i], "argument")
            targs.append(te)
        }
        if self.tir.nodes[f].k == TKind.FnToFat {
            let inst = self.tir.nodes[f].a
            self.ctx().callees.append(inst)
            self.ctx().callee_spans.append(start)
            let c = self.mk(TKind.Call, ret, start, end)
            self.tir.nodes[c].a = inst
            self.tir.nodes[c].kids = targs
            return c
        }
        if eff != 0 { self.add_effect(eff, start, "calling through a function value acquires the effects its type permits") }
        let c = self.mk(TKind.CallPtr, ret, start, end)
        self.tir.nodes[c].kids.append(f)
        for t in targs { self.tir.nodes[c].kids.append(t) }
        return c
    }

    /// Call a non-generic definition (stage 2: no type inference of generics yet).
    /// Call a definition, inferring generic arguments from the receiver, the
    /// arguments, explicit type arguments, and the expected type.
    fn call_fn_def(self: *mut Self, fid: usize, self_arg: usize, args: []usize, expected: usize, start: usize, end: usize) -> usize {
        let fm = self.fns[fid].module
        let nm = self.fns[fid].node_module
        let node = self.fns[fid].node
        let impl_id = self.fns[fid].impl_id
        let saved_env = self.env_save()
        var names = List(String).new()
        var tys = List(usize).new()
        var impl_targs = List(usize).new()
        var self_ty = NONE
        if impl_id != NONE {
            let tps = self.impls[impl_id].tparams.clone()
            var bound = List(usize).new()
            if self_arg != NONE {
                // the receiver type (through a pointer) binds the impl's parameters
                var rt = self.tys.resolve(self.tir.nodes[self_arg].ty, true)
                if self.tys.kind(rt) == TK.Ptr { rt = self.tys.list[rt].args[0] }
                if let b = self.match_impl_target(impl_id, rt) { bound = b }
            }
            for tp, i in tps {
                let t = if i < bound.len { bound[i] } else { self.tys.fresh_infer() }
                names.append(tp.clone())
                tys.append(t)
                impl_targs.append(t)
            }
            self.env_set(&names, &tys)
            let target = self.impls[impl_id].target
            self_ty = self.resolve_type(fm, target, NONE)
        }
        let fname = self.node(nm, node).name.clone()
        let param_nodes = self.node(nm, node).kids.clone()
        let type_params = self.fn_type_params(fid)
        // value parameters: everything but the type parameters
        var value_params = List(usize).new()
        for pn in param_nodes { if ! (self.node(nm, pn).flag and self.is_type_param_node(nm, pn)) { value_params.append(pn) } }
        let n_self: usize = if self_arg != NONE { 1 } else { 0 }
        // explicit type arguments come first: `max(i32, a, b)`
        var explicit = false
        if type_params.len > 0 and args.len == value_params.len + type_params.len - n_self {
            explicit = true
            for i in 0..type_params.len { if !self.is_type_arg(args[i]) { explicit = false } }
        }
        var fn_targs = List(usize).new()
        var rest_start: usize = 0
        if explicit {
            for tp, i in type_params {
                let te = self.check_expr(args[i], NONE)
                var t = self.tys.void()
                if self.tir.nodes[te].k == TKind.TypeVal { t = self.tir.nodes[te].a } else { self.fail_here(self.tir.nodes[te].start, "expected a type argument") }
                names.append(tp.clone())
                tys.append(t)
                fn_targs.append(t)
            }
            rest_start = type_params.len
        } else {
            for tp in type_params {
                let t = self.tys.fresh_infer()
                names.append(tp.clone())
                tys.append(t)
                fn_targs.append(t)
            }
        }
        self.env_set(&names, &tys)
        let n_rest = args.len - rest_start
        let is_extern = self.node(nm, node).flag2
        let variadic = self.node(nm, node).b == 1
        if (variadic and n_rest + n_self < value_params.len) or (!variadic and n_rest + n_self != value_params.len) {
            var msg = format("`{}` takes {} argument(s) but {} were given", .{fname, value_params.len - n_self, n_rest})
            if type_params.len > 0 and !explicit { msg.append(" (type parameters are inferred from the arguments)") }
            self.fail_here(start, msg[..])
            var i = rest_start
            while i < args.len { _ = self.check_expr(args[i], NONE); i += 1 }
            self.env_restore(&saved_env)
            return self.error_expr(start, end)
        }
        var targs = List(usize).new()
        var pi: usize = 0
        if self_arg != NONE {
            let pt_node = self.node(nm, value_params[0]).x
            let pt = self.resolve_type(fm, pt_node, self_ty)
            let sa = self.adjust_receiver(self_arg, pt, start, end)
            targs.append(sa)
            pi = 1
        }
        // the expected type helps infer the return type's parameters
        let ret_node = self.node(nm, node).x
        if expected != NONE and ret_node != NONE {
            let rt = self.resolve_type(fm, ret_node, self_ty)
            let saved_errs = self.errors.len
            _ = self.unify(rt, expected)
            while self.errors.len > saved_errs { _ = self.errors.pop() }
        }
        var ai = rest_start
        while ai < args.len {
            if pi >= value_params.len {
                // extra arguments of a C variadic: untyped literals take C's default promotions
                var te = self.check_expr(args[ai], NONE)
                let t = self.tys.shallow(self.tir.nodes[te].ty)
                let tk = self.tys.kind(t)
                if tk == TK.Infer and self.tys.is_integer(t) {
                    te = self.coerce_or_error(te, self.tys.named(TK.Int, "i32"), "variadic argument")
                } else if tk == TK.Infer and self.tys.is_float(t) {
                    te = self.coerce_or_error(te, self.tys.named(TK.Float, "f64"), "variadic argument")
                } else if ! (tk == TK.Int or tk == TK.Float or tk == TK.Bool or tk == TK.Char or tk == TK.Ptr) {
                    self.fail_here(self.tir.nodes[te].start, format("a value of type `{}` cannot be passed to a C variadic parameter; use scalars or pointers", .{self.ty_name(t)})[..])
                }
                targs.append(te)
                ai += 1
                continue
            }
            let pn = self.node(nm, value_params[pi])
            let pname = pn.name.clone()
            let pt_node = pn.x
            let owned = pn.flag2
            pi += 1
            // the parameter type is resolved in the callee's environment, the
            // argument checked in the caller's
            self.env_set(&names, &tys)
            let pt = self.resolve_type(fm, pt_node, self_ty)
            self.env_restore(&saved_env)
            var te = self.check_expr(args[ai], pt)
            te = self.coerce_or_error(te, pt, format("argument `{}`", .{pname})[..])
            if owned { te = self.take_ownership(te) }
            targs.append(te)
            ai += 1
        }
        self.env_restore(&saved_env)
        // every type argument must be known now
        var all_targs = List(usize).new()
        for t in impl_targs {
            let r = self.tys.resolve(t, true)
            if self.tys.contains_infer(r) {
                self.fail_here(start, format("cannot infer all type parameters of `{}`; pass them explicitly", .{fname})[..])
                return self.error_expr(start, end)
            }
            all_targs.append(r)
        }
        for t in fn_targs {
            let r = self.tys.resolve(t, true)
            if self.tys.contains_infer(r) {
                self.fail_here(start, format("cannot infer all type parameters of `{}`; pass them explicitly", .{fname})[..])
                return self.error_expr(start, end)
            }
            all_targs.append(r)
        }
        // where-clause bounds
        let wheres = self.node(nm, node).kids2.clone()
        for w in wheres {
            let wn = self.node(nm, w)
            let pname = wn.name.clone()
            let bounds = wn.text.clone()
            var bt = NONE
            for nm, i in names { if nm == pname { bt = tys[i] } }
            if bt == NONE { continue }
            let t = self.tys.resolve(bt, true)
            let bnames = Checker.split_words(bounds[..])
            for b in bnames {
                if !self.type_satisfies_trait(t, b[..]) {
                    self.fail_here(start, format("`{}` requires `{}: {}`, but `{}` does not implement `{}`", .{fname, pname, b, self.ty_name(t), b})[..])
                }
            }
        }
        let inst = self.instantiate(fid, all_targs)
        let ret = self.insts[inst].ret
        self.ctx().callees.append(inst)
        self.ctx().callee_spans.append(start)
        if is_extern {
            if self.ctx().unsafe_depth == 0 { self.fail_here(start, format("calling the foreign function `{}` requires an `unsafe` block", .{fname})[..]) }
            self.add_effect(EFF_FFI, start, "call to a foreign function")
        }
        let c = self.mk(TKind.Call, ret, start, end)
        self.tir.nodes[c].a = inst
        self.tir.nodes[c].kids = targs
        return c
    }

    /// Is this argument a type (for explicit type arguments)?
    fn is_type_arg(self: *mut Self, a: usize) -> bool {
        let m = self.cur_module()
        let n = self.node(m, a)
        if n.k == parser.NodeKind.TypeVal { return true }
        if n.k == parser.NodeKind.Ident {
            let name = n.name.clone()
            if self.lookup_local(name[..]) != NONE { return false }
            if self.env_lookup(name[..]) != NONE { return true }
            if name == "String" { return true }
            if let it = self.lookup(m, name[..]) { return it.kind == ItemKind.Struct or it.kind == ItemKind.Enum or it.kind == ItemKind.Alias }
            return false
        }
        if n.k == parser.NodeKind.Call {
            let callee = self.node(m, n.x)
            if callee.k != parser.NodeKind.Ident { return false }
            let name = callee.name.clone()
            if name == "List" or name == "Map" { return true }
            if let it = self.lookup(m, name[..]) { return it.kind == ItemKind.Struct or it.kind == ItemKind.Enum }
        }
        return false
    }

    /// Why `t` cannot be cloned, or null. A struct or enum clones when it
    /// derives `Clone` and its fields and payloads do (a unit enum always);
    /// numbers, strings, slices, containers of clonable elements, optionals,
    /// tuples, arrays, weak references and reference classes (a retained copy)
    /// clone; a pointer, a trait object or a function value does not. The walk
    /// starts with `clone_seen` cleared; a type met twice is a recursion, not
    /// a blocker.
    fn clone_blocker(self: *mut Self, t0: usize) -> ?String {
        let t = self.tys.resolve(t0, true)
        for s in self.clone_seen { if s == t { return null } }
        self.clone_seen.append(t)
        let k = self.tys.kind(t)
        if k == TK.Int or k == TK.Float or k == TK.Bool or k == TK.Char or k == TK.Str or k == TK.Slice or k == TK.Weak or k == TK.ErrorSet or k == TK.Void { return null }
        if k == TK.List or k == TK.Opt or k == TK.Array or k == TK.ErrUnion or k == TK.Map or k == TK.Tuple {
            for a in self.tys.list[t].args.clone() {
                if let why = self.clone_blocker(a) { return why }
            }
            return null
        }
        if k == TK.Distinct { return self.clone_blocker(self.distinct_underlying(self.tys.list[t].def)) }
        if k == TK.Struct {
            let d = self.tys.list[t].def
            if self.structs[d].kind == "ref" { return null }
            let name = self.ty_name(t)
            if !check.list_has(&self.structs[d].derives, "Clone") { return format("`{}` does not derive `Clone`", .{name}) }
            let fields = self.structs[d].fields.clone()
            let fts = self.struct_field_types(t)
            let dm = self.structs[d].module
            for f, i in fields {
                if let why = self.clone_blocker(fts[i]) { return format("field `{}` of `{}`: {}", .{self.node(dm, f).name, name, why}) }
            }
            return null
        }
        if k == TK.Enum {
            let d = self.tys.list[t].def
            let name = self.ty_name(t)
            let variants = self.enums[d].variants.clone()
            let em = self.enums[d].module
            var all_unit = true
            for v in variants { if self.node(em, v).text != "unit" { all_unit = false } }
            if all_unit { return null }
            if !check.list_has(&self.enums[d].derives, "Clone") { return format("`{}` does not derive `Clone`", .{name}) }
            let vtys = self.enum_variant_types(t)
            for tys, vi in vtys {
                for pt in tys {
                    if let why = self.clone_blocker(pt) { return format("variant `{}` of `{}`: {}", .{self.node(em, variants[vi]).name, name, why}) }
                }
            }
            return null
        }
        if k == TK.Ptr { return String.from("a pointer is a view into other storage; clone what it points to") }
        if k == TK.Dyn { return String.from("a trait object cannot be cloned") }
        if k == TK.Fn { return String.from("a function value cannot be cloned") }
        return format("`{}` cannot be cloned", .{self.ty_name(t)})
    }

    /// The effects of cloning a `t`: an allocation for a string, a list or
    /// a map anywhere inside, a retain for a reference class or a weak
    /// reference. Starts with `clone_seen` cleared.
    fn clone_effects(self: *mut Self, t0: usize) -> u64 {
        let t = self.tys.resolve(t0, true)
        for s in self.clone_seen { if s == t { return 0 } }
        self.clone_seen.append(t)
        let k = self.tys.kind(t)
        var eff: u64 = 0
        if k == TK.Str or k == TK.List or k == TK.Map { eff |= EFF_ALLOCATES }
        if k == TK.Weak { return EFF_REFCOUNTS }
        if k == TK.List or k == TK.Opt or k == TK.Array or k == TK.ErrUnion or k == TK.Map or k == TK.Tuple {
            for a in self.tys.list[t].args.clone() { eff |= self.clone_effects(a) }
            return eff
        }
        if k == TK.Distinct { return self.clone_effects(self.distinct_underlying(self.tys.list[t].def)) }
        if k == TK.Struct {
            let d = self.tys.list[t].def
            if self.structs[d].kind == "ref" { return EFF_REFCOUNTS }
            for ft in self.struct_field_types(t) { eff |= self.clone_effects(ft) }
            return eff
        }
        if k == TK.Enum {
            for tys in self.enum_variant_types(t) {
                for pt in tys { eff |= self.clone_effects(pt) }
            }
            return eff
        }
        return eff
    }

    /// Does `t` satisfy a trait: the derivable ones by their rules, others by an impl.
    fn type_satisfies_trait(self: *mut Self, t0: usize, trait_name: []u8) -> bool {
        let t = self.tys.resolve(t0, true)
        let k = self.tys.kind(t)
        if trait_name == "Clone" {
            self.clone_seen.clear()
            return self.clone_blocker(t) == null
        }
        let derivable = trait_name == "Eq" or trait_name == "Ord" or trait_name == "Hash" or trait_name == "Format" or trait_name == "Copy"
        if derivable {
            if k == TK.Int or k == TK.Float or k == TK.Bool or k == TK.Char { return true }
            if k == TK.Slice and trait_name != "Copy" {
                let e = self.tys.list[t].args[0]
                if trait_name == "Ord" {
                    let es = self.tys.shallow(e)
                    return self.tys.kind(es) == TK.Int and self.tys.list[es].name == "u8"
                }
                return self.type_satisfies_trait(e, trait_name)
            }
            if k == TK.Str and trait_name != "Copy" { return true }
            if k == TK.Struct {
                if check.list_has(&self.structs[self.tys.list[t].def].derives, trait_name) { return true }
            }
            if k == TK.Enum {
                let d = self.tys.list[t].def
                if check.list_has(&self.enums[d].derives, trait_name) { return true }
                if trait_name != "Copy" {
                    var all_unit = true
                    let em = self.enums[d].module
                    let variants = self.enums[d].variants.clone()
                    for v in variants { if self.node(em, v).text != "unit" { all_unit = false } }
                    if all_unit { return true }
                }
            }
            if k == TK.Distinct { return self.type_satisfies_trait(self.distinct_underlying(self.tys.list[t].def), trait_name) }
        }
        let n = self.impls.len
        for i in 0..n {
            if !self.impls[i].has_trait or self.impls[i].trait_name != trait_name { continue }
            if self.match_impl_target(i, t) != null { return true }
        }
        return false
    }

    /// A method receiver becomes what the `self` parameter wants: a pointer
    /// to a place, or the value itself.
    fn adjust_receiver(self: *mut Self, recv: usize, want: usize, at: usize, end: usize) -> usize {
        let wt = self.tys.shallow(want)
        let rt = self.tys.shallow(self.tir.nodes[recv].ty)
        let wk = self.tys.kind(wt)
        let rk = self.tys.kind(rt)
        if wk == TK.Ptr and rk == TK.Ptr {
            if self.tys.list[wt].flag and !self.tys.list[rt].flag {
                self.fail_here(at, "this method mutates its receiver, but the receiver is an immutable pointer")
            }
            return recv
        }
        if wk == TK.Ptr {
            let mutable = self.tys.list[wt].flag
            if mutable and self.is_place(recv) and !self.place_mutable(recv) {
                var what = String.from("the receiver")
                if self.tir.nodes[recv].k == TKind.Local { what = format("`{}`", .{self.ctx().locals[self.tir.nodes[recv].a].name}) }
                self.fail_here(at, format("this method mutates its receiver, but {} is immutable", .{what})[..])
            }
            let pt = self.tys.wrap(TK.Ptr, self.tir.nodes[recv].ty, mutable)
            let r = self.mk(TKind.AddrOf, pt, at, end)
            self.tir.nodes[r].flag = mutable
            self.tir.nodes[r].kids.append(recv)
            return r
        }
        if rk == TK.Ptr {
            let r = self.mk(TKind.Deref, want, at, end)
            self.tir.nodes[r].kids.append(recv)
            return r
        }
        return recv
    }

    fn check_builtin_fn(self: *mut Self, name: []u8, args: []usize, start: usize, end: usize) -> usize {
        let m = self.cur_module()
        let v = self.tys.void()
        let bytes = self.tys.str_slice()
        if name == "println" or name == "print" or name == "eprintln" or name == "format" {
            if args.len == 0 or args.len > 2 {
                self.fail_here(start, format("`{}` takes a format string and an optional `.{{ }}` argument tuple", .{name})[..])
                return self.error_expr(start, end)
            }
            let fmt_node = args[0]
            let fn_ = self.node(m, fmt_node)
            if ! (fn_.k == parser.NodeKind.Lit and fn_.text == "str") {
                self.fail_here(fn_.start, "the format string must be a string literal so it can be checked at compile time (section 7.4)")
                return self.error_expr(start, end)
            }
            let fmt = fn_.name.clone()
            let fstart = fn_.start
            let fend = fn_.end
            // the arguments: positional `.{a, b}` or named `.{ .x = a, .w = 8 }`
            var arg_nodes = List(usize).new()
            var arg_names = List(String).new()
            var named = false
            if args.len == 2 {
                let an = self.node(m, args[1])
                if an.k == parser.NodeKind.TupleLit {
                    arg_nodes = an.kids.clone()
                } else if an.k == parser.NodeKind.StructLit and an.x == NONE {
                    named = an.kids.len > 0
                    for f in an.kids.clone() {
                        arg_names.append(self.node(m, f).name.clone())
                        arg_nodes.append(self.node(m, f).x)
                    }
                } else {
                    arg_nodes.append(args[1])
                }
            }
            // the placeholders, rewritten for the emitter to `{#index:spec}`: a
            // name or a position becomes an index into the arguments (so one
            // argument may be written twice), and a width taken from an argument
            // (`{v:>w}`) becomes `>#index`
            var out = String.new()
            var used = List(bool).new()
            for _ in arg_nodes { used.append(false) }
            var width_args = List(usize).new()
            var next: usize = 0
            var i: usize = 0
            while i < fmt.len {
                let ch = fmt[i]
                if ch == '{' {
                    if i + 1 < fmt.len and fmt[i + 1] == '{' { out.append("{{"); i += 2; continue }
                    var j = i + 1
                    while j < fmt.len and fmt[j] != '}' { j += 1 }
                    if j >= fmt.len {
                        self.fail_here(fstart, "unterminated `{` in format string (write `{{` for a literal brace)")
                        return self.error_expr(start, end)
                    }
                    var head = String.new()
                    var spec = String.new()
                    var seen_colon = false
                    for b in fmt[i + 1..j] {
                        if !seen_colon and b == ':' { seen_colon = true }
                        else if seen_colon { spec.push_byte(b) }
                        else { head.push_byte(b) }
                    }
                    var idx = NONE
                    if named {
                        if head.len == 0 {
                            self.fail_here(fstart, "named arguments need a name in every placeholder, `{name}` or `{name:spec}`")
                            return self.error_expr(start, end)
                        }
                        idx = check.name_index(&arg_names, head[..]) orelse {
                            self.fail_here(fstart, format("format string names `{}` but the arguments have no such field", .{head})[..])
                            return self.error_expr(start, end)
                        }
                    } else {
                        // positional: the body is the spec (`x`, `>6`, `.2`, `:.2`)
                        if head.len > 0 and !seen_colon {
                            spec = head.clone()
                            head.clear()
                        } else if head.len > 0 {
                            self.fail_here(fstart, format("`{{{}:...}}` names an argument, but the arguments are positional; write `.{{ .{} = value }}`", .{head, head})[..])
                            return self.error_expr(start, end)
                        }
                        idx = next
                        next += 1
                    }
                    // a width from an argument: `>name`, `<name`
                    if spec.len > 1 and (spec[0] == '>' or spec[0] == '<') and ! (spec[1] >= '0' and spec[1] <= '9') {
                        if !named {
                            self.fail_here(fstart, "a width taken from an argument needs named arguments, `.{ .w = 8, ... }`")
                            return self.error_expr(start, end)
                        }
                        let widx = check.name_index(&arg_names, spec[1..]) orelse {
                            self.fail_here(fstart, format("format width names `{}` but the arguments have no such field", .{spec[1..]})[..])
                            return self.error_expr(start, end)
                        }
                        width_args.append(widx)
                        used[widx] = true
                        let align = spec[0]
                        spec = String.new()
                        spec.push_byte(align)
                        spec.append(format("#{}", .{widx})[..])
                    }
                    if idx < arg_nodes.len { used[idx] = true }
                    out.append(format("{{#{}", .{idx})[..])
                    if spec.len > 0 {
                        out.push_byte(':')
                        out.append(spec[..])
                    }
                    out.push_byte('}')
                    i = j + 1
                } else if ch == '}' {
                    if i + 1 < fmt.len and fmt[i + 1] == '}' { out.append("}}"); i += 2; continue }
                    self.fail_here(fstart, "unmatched `}` in format string (write `}}` for a literal brace)")
                    return self.error_expr(start, end)
                } else {
                    out.push_byte(ch)
                    i += 1
                }
            }
            if !named and next != arg_nodes.len {
                self.fail_here(start, format("format string has {} placeholder(s) but {} argument(s) were given", .{next, arg_nodes.len})[..])
                return self.error_expr(start, end)
            }
            if named {
                for u, ui in used {
                    if !u {
                        self.fail_here(start, format("the argument `{}` is not used by the format string", .{arg_names[ui]})[..])
                        return self.error_expr(start, end)
                    }
                }
            }
            var all = List(usize).new()
            let fs = self.mk(TKind.Str, bytes, fstart, fend)
            self.tir.nodes[fs].text = out
            all.append(fs)
            for a, ai in arg_nodes {
                var te = self.check_expr(a, NONE)
                te = self.finalize_expr(te)
                let t = self.tys.resolve(self.tir.nodes[te].ty, true)
                let k = self.tys.kind(t)
                if check.has_local(&width_args, ai) and k != TK.Int {
                    self.fail_here(self.tir.nodes[te].start, format("a format width must be an integer but `{}` is a `{}`", .{arg_names[ai], self.ty_name(t)})[..])
                }
                var ok = k == TK.Int or k == TK.Float or k == TK.Bool or k == TK.Char or k == TK.ErrorSet or k == TK.Ptr
                if k == TK.Slice {
                    let es = self.tys.shallow(self.tys.list[t].args[0])
                    ok = self.tys.kind(es) == TK.Int and self.tys.list[es].name == "u8"
                }
                if k == TK.Str {
                    let sl = self.tys.str_slice()
                    te = self.wrap_node(TKind.StrToSlice, te, sl)
                    ok = true
                }
                if k == TK.Enum {
                    ok = true
                    let d = self.tys.list[t].def
                    let em = self.enums[d].module
                    let variants = self.enums[d].variants.clone()
                    for vv in variants { if self.node(em, vv).text != "unit" { ok = false } }
                }
                if k == TK.Distinct {
                    let u = self.distinct_underlying(self.tys.list[t].def)
                    let c = self.mk(TKind.Cast, u, self.tir.nodes[te].start, self.tir.nodes[te].end)
                    self.tir.nodes[c].name = String.from("bits")
                    self.tir.nodes[c].kids.append(te)
                    te = c
                    ok = true
                }
                if k == TK.Opt {
                    let ik = self.tys.kind(self.tys.shallow(self.tys.list[t].args[0]))
                    ok = ik == TK.Int or ik == TK.Float or ik == TK.Bool or ik == TK.Char
                }
                if !ok {
                    self.fail_here(self.tir.nodes[te].start, format("cannot format a value of type `{}`; formatting supports numbers, bool, char, `[]u8`, `String`, unit enums, and errors", .{self.ty_name(t)})[..])
                }
                all.append(te)
            }
            var op = "Println"
            var ty = v
            if name == "print" { op = "Print" }
            if name == "eprintln" { op = "Eprintln" }
            if name == "format" {
                op = "Format"
                ty = self.tys.string()
                self.add_effect(EFF_ALLOCATES, start, "`format` builds an owned String")
            } else {
                self.add_effect(EFF_BLOCKS, start, "writing to stdout may block")
            }
            let b = self.builtin_node(op, ty, start, end)
            self.tir.nodes[b].kids = all
            return b
        }
        if name == "expect" or name == "assert" {
            if args.len != 1 {
                self.fail_here(start, format("`{}` takes 1 argument(s) but {} were given", .{name, args.len})[..])
                for a in args { _ = self.check_expr(a, NONE) }
                return self.error_expr(start, end)
            }
            let bt = self.tys.bool_ty()
            var c = self.check_expr(args[0], bt)
            c = self.coerce_or_error(c, bt, "condition")
            self.add_effect(EFF_PANICS, start, "a failed `expect` panics")
            let an = self.node(m, args[0])
            let src = self.source_text(m, an.start, an.end)
            let msg = self.mk(TKind.Str, bytes, start, end)
            self.tir.nodes[msg].text = src
            let b = self.builtin_node("Expect", v, start, end)
            self.tir.nodes[b].kids.append(c)
            self.tir.nodes[b].kids.append(msg)
            return b
        }
        if name == "expect_eq" {
            if args.len != 2 {
                self.fail_here(start, format("`expect_eq` takes 2 argument(s) but {} were given", .{args.len})[..])
                for a in args { _ = self.check_expr(a, NONE) }
                return self.error_expr(start, end)
            }
            let c = self.check_comparison("==", args[0], args[1], start, end)
            self.add_effect(EFF_PANICS, start, "a failed `expect_eq` panics")
            let src = self.source_text(m, start, end)
            let msg = self.mk(TKind.Str, bytes, start, end)
            self.tir.nodes[msg].text = src
            let b = self.builtin_node("Expect", v, start, end)
            self.tir.nodes[b].kids.append(c)
            self.tir.nodes[b].kids.append(msg)
            return b
        }
        if name == "panic" {
            if args.len != 1 {
                self.fail_here(start, format("`panic` takes 1 argument(s) but {} were given", .{args.len})[..])
                for a in args { _ = self.check_expr(a, NONE) }
                return self.error_expr(start, end)
            }
            var msg = self.check_expr(args[0], bytes)
            msg = self.coerce_or_error(msg, bytes, "panic message")
            self.add_effect(EFF_PANICS, start, "explicit panic")
            let nv = self.tys.never()
            let b = self.builtin_node("Panic", nv, start, end)
            self.tir.nodes[b].kids.append(msg)
            return b
        }
        return NONE
    }

    fn source_text(self: *Self, m: usize, start: usize, end: usize) -> String {
        return String.from(self.mods[m].source[start..end])
    }

    // ----- if, casts ---------------------------------------------------------------------------

    fn check_if(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let cond_node = n.x
        let then_node = n.y
        let els_node = n.z
        let start = n.start
        let end = n.end
        let bt = self.tys.bool_ty()
        var c = self.check_expr(cond_node, bt)
        c = self.coerce_or_error(c, bt, "if condition")
        let then_facts = self.guard_facts(c, false)
        let saved = self.facts_save()
        self.push_scope()
        self.apply_facts(&then_facts)
        let moved_before = self.moved_snapshot()
        let v = self.tys.void()
        let then_expected = if els_node != NONE { expected } else { v }
        let tb = self.check_block(then_node, then_expected, NONE, NONE)
        self.pop_scope()
        self.facts_restore(&saved)
        let moved_then = self.moved_snapshot()
        let then_ty = self.tir.nodes[tb].ty
        let then_diverges = self.tys.kind(self.tys.shallow(then_ty)) == TK.Never
        if then_diverges and els_node == NONE { self.moved_restore(&moved_before) }
        if els_node == NONE {
            let tk = self.tys.kind(self.tys.shallow(then_ty))
            if ! (tk == TK.Void or tk == TK.Never) {
                self.fail_here(self.tir.nodes[tb].start, format("an `if` without `else` produces no value, but this block has type `{}`; discard the value with `_ =`", .{self.ty_name(then_ty)})[..])
            }
            let r = self.mk(TKind.If, v, start, end)
            self.tir.nodes[r].kids.append(c)
            self.tir.nodes[r].kids.append(tb)
            return r
        }
        self.moved_restore(&moved_before)
        let hint = if then_diverges { expected } else { then_ty }
        // the else branch knows the condition failed
        let else_facts = self.guard_facts(c, true)
        let saved_else = self.facts_save()
        self.apply_facts(&else_facts)
        var eb = NONE
        let ek = self.node(m, els_node).k
        if ek == parser.NodeKind.Block {
            eb = self.check_block(els_node, hint, NONE, NONE)
        } else {
            let te = self.check_expr(els_node, hint)
            eb = self.mk(TKind.Block, self.tir.nodes[te].ty, self.tir.nodes[te].start, self.tir.nodes[te].end)
            self.tir.nodes[eb].a = te
        }
        self.facts_restore(&saved_else)
        let else_diverges = self.tys.kind(self.tys.shallow(self.tir.nodes[eb].ty)) == TK.Never
        let moved_else = self.moved_snapshot()
        self.moved_restore(&moved_before)
        if !then_diverges { self.moved_merge(&moved_then) }
        if !else_diverges { self.moved_merge(&moved_else) }
        let ty = self.join_branches(tb, eb, expected)
        let r = self.mk(TKind.If, ty, start, end)
        self.tir.nodes[r].kids.append(c)
        self.tir.nodes[r].kids.append(tb)
        self.tir.nodes[r].kids.append(eb)
        return r
    }

    /// Unify two branch blocks to a common type, coercing tails as needed.
    fn join_branches(self: *mut Self, a: usize, b: usize, expected: usize) -> usize {
        let at = self.tys.shallow(self.tir.nodes[a].ty)
        let bt = self.tys.shallow(self.tir.nodes[b].ty)
        let a_never = self.tys.kind(at) == TK.Never
        let b_never = self.tys.kind(bt) == TK.Never
        var target = NONE
        if a_never and b_never {
            target = self.tys.never()
        } else if a_never {
            target = bt
            if expected != NONE and self.coerce_tail_ok(b, expected) { target = expected }
        } else if b_never {
            target = at
            if expected != NONE and self.coerce_tail_ok(a, expected) { target = expected }
        } else {
            if expected != NONE and self.coerce_tail_ok(a, expected) and self.coerce_tail_ok(b, expected) {
                target = expected
            } else if self.coerce_tail_ok(b, at) {
                target = at
            } else if self.coerce_tail_ok(a, bt) {
                target = bt
            } else {
                self.fail_here(self.tir.nodes[b].start, format("`if` branches have incompatible types: `{}` and `{}`", .{self.ty_name(at), self.ty_name(bt)})[..])
                target = at
            }
        }
        self.coerce_block_tail(a, target)
        self.coerce_block_tail(b, target)
        return target
    }

    fn coerce_tail_ok(self: *mut Self, b: usize, t: usize) -> bool {
        let tail = self.tir.nodes[b].a
        if tail != NONE {
            // a probe: errors are not reported, bindings made by unification stay
            let saved = self.errors.len
            let saved_ty = self.tir.nodes[tail].ty
            let r = self.coerce(tail, t)
            while self.errors.len > saved { _ = self.errors.pop() }
            if r == NONE {
                self.tir.nodes[tail].ty = saved_ty
                return false
            }
            // undo the wrapping the probe made; the real coercion redoes it
            self.tir.nodes[tail].ty = saved_ty
            return true
        }
        let bk = self.tys.kind(self.tys.shallow(self.tir.nodes[b].ty))
        let tk = self.tys.kind(self.tys.shallow(t))
        return (bk == TK.Never or bk == TK.Void) and (tk == TK.Void or self.block_diverges(b))
    }

    fn coerce_block_tail(self: *mut Self, b: usize, t: usize) {
        let tail = self.tir.nodes[b].a
        if tail != NONE {
            let c = self.coerce_or_error(tail, t, "block value")
            self.tir.nodes[b].a = c
        }
        self.tir.nodes[b].ty = t
    }

    fn moved_snapshot(self: *mut Self) -> List(usize) {
        return self.ctx().moved.keys()
    }
    fn moved_restore(self: *mut Self, snap: *List(usize)) {
        let keys = self.ctx().moved.keys()
        for k in keys {
            var keep = false
            for s in snap { if s == k { keep = true } }
            if !keep { _ = self.ctx().moved.remove(k) }
        }
        for s in snap { if !self.ctx().moved.contains(s) { self.ctx().moved.put(s, 0) } }
    }
    fn moved_merge(self: *mut Self, snap: *List(usize)) {
        for s in snap { if !self.ctx().moved.contains(s) { self.ctx().moved.put(s, 0) } }
    }

    /// Range facts from a boolean guard on a local: `x < N`, `x <= N`, `x >= N`, `x > N`.
    /// What a condition proves in the branch where it is true (or, with
    /// `negate`, false): ranges of locals (`x < n`, `x == n`, `x != n` at an
    /// end of the range), locals `!= 0`, optionals `!= null`, a slice's least
    /// length (`s.len >= n`) and an index below a slice's length (`i < s.len`).
    /// `a and b` proves both; `!(a or b)` is `!a and !b`; `a or b` proves
    /// nothing certain about either side; `!c` flips.
    fn guard_facts(self: *mut Self, c: usize, negate: bool) -> Facts {
        var out = Facts{ .ranges = List(Narrowing).new(), .nonzero = List(usize).new(), .nonnull = List(usize).new(), .min_len = List(Narrowing).new(), .below = List((usize, usize)).new() }
        let k = self.tir.nodes[c].k
        let kids = self.tir.nodes[c].kids.clone()
        if k == TKind.Unary and self.tir.nodes[c].text == "!" { return self.guard_facts(kids[0], !negate) }
        if k == TKind.Logical {
            let is_and = self.tir.nodes[c].flag
            if is_and != negate {
                let l = self.guard_facts(kids[0], negate)
                let r = self.guard_facts(kids[1], negate)
                return check.facts_both(&l, &r)
            }
            return out
        }
        if k != TKind.Binary { return out }
        var op = self.tir.nodes[c].text.clone()
        if negate { op = check.flip_cmp(op[..]) }
        var lhs = kids[0]
        var rhs = kids[1]
        // `null` on either side
        if self.tir.nodes[rhs].k == TKind.OptNull or self.tir.nodes[lhs].k == TKind.OptNull {
            let other = if self.tir.nodes[rhs].k == TKind.OptNull { lhs } else { rhs }
            if op == "!=" and self.tir.nodes[other].k == TKind.Local { out.nonnull.append(self.tir.nodes[other].a) }
            return out
        }
        // the local (or the length) on the left
        if self.tir.nodes[lhs].k != TKind.Local and !self.is_slice_len(lhs) {
            if self.tir.nodes[rhs].k != TKind.Local and !self.is_slice_len(rhs) { return out }
            let t = lhs
            lhs = rhs
            rhs = t
            op = check.mirror_cmp(op[..])
        }
        // `i < s.len`: an index below a slice's length
        if self.tir.nodes[lhs].k == TKind.Local and self.is_slice_len(rhs) and op == "<" {
            let ls = self.tir.nodes[self.tir.nodes[rhs].kids[0]].a
            var pair = (self.tir.nodes[lhs].a, ls)
            out.below.append(pair)
            return out
        }
        let rr = self.expr_range(rhs) orelse return out
        // `s.len >= n`: a least length
        if self.is_slice_len(lhs) {
            let sl = self.tir.nodes[self.tir.nodes[lhs].kids[0]].a
            var least: i128 = 0
            if op == ">=" or op == "==" { least = rr.lo } else if op == ">" { least = rr.lo + 1 }
            if least > 0 { out.min_len.append(Narrowing{ .local = sl, .lo = least, .hi = least }) }
            return out
        }
        if self.tir.nodes[lhs].k != TKind.Local { return out }
        let l = self.tir.nodes[lhs].a
        var cur = Range{ .lo = -85070591730234615865843651857942052864, .hi = 85070591730234615865843651857942052863 }
        if let lr = self.expr_range(lhs) { cur = lr }
        if op == "!=" {
            if rr.lo == 0 and rr.hi == 0 { out.nonzero.append(l) }
            if rr.lo == rr.hi {
                // `x != lo` or `x != hi` at an end of the known range shortens it
                if cur.lo == rr.lo and cur.lo < cur.hi { out.ranges.append(Narrowing{ .local = l, .lo = cur.lo + 1, .hi = cur.hi }) }
                else if cur.hi == rr.hi and cur.lo < cur.hi { out.ranges.append(Narrowing{ .local = l, .lo = cur.lo, .hi = cur.hi - 1 }) }
            }
            return out
        }
        var nr = Narrowing{ .local = l, .lo = cur.lo, .hi = cur.hi }
        var known = true
        if op == "<" { nr.hi = check.min128(cur.hi, rr.hi - 1) }
        else if op == "<=" { nr.hi = check.min128(cur.hi, rr.hi) }
        else if op == ">" { nr.lo = check.max128(cur.lo, rr.lo + 1) }
        else if op == ">=" { nr.lo = check.max128(cur.lo, rr.lo) }
        else if op == "==" { nr.lo = check.max128(cur.lo, rr.lo); nr.hi = check.min128(cur.hi, rr.hi) }
        else { known = false }
        if known and nr.lo <= nr.hi { out.ranges.append(nr) }
        return out
    }

    /// `s.len` of a slice-typed local (a slice's length never changes).
    fn is_slice_len(self: *mut Self, e: usize) -> bool {
        if self.tir.nodes[e].k != TKind.Builtin or self.tir.nodes[e].name != "Len" { return false }
        let arg = self.tir.nodes[e].kids[0]
        if self.tir.nodes[arg].k != TKind.Local { return false }
        return self.tys.kind(self.tys.shallow(self.tir.nodes[arg].ty)) == TK.Slice
    }

    fn apply_facts(self: *mut Self, f: *Facts) {
        for nr in f.ranges { self.ctx().ranges.put(nr.local, Range{ .lo = nr.lo, .hi = nr.hi }) }
        for l in f.nonzero { if !check.has_local(&self.ctx().nonzero, l) { self.ctx().nonzero.append(l) } }
        for l in f.nonnull { if !check.has_local(&self.ctx().nonnull, l) { self.ctx().nonnull.append(l) } }
        for m in f.min_len {
            var least = m.lo
            if let cur = self.ctx().min_len.get(m.local) { if cur.lo > least { least = cur.lo } }
            self.ctx().min_len.put(m.local, Range{ .lo = least, .hi = least })
        }
        for (i, s) in f.below { self.ctx().index_of.put(i, s) }
    }

    fn facts_save(self: *mut Self) -> FactState {
        return FactState{ .ranges = self.ctx().ranges.clone(), .nonzero = self.ctx().nonzero.clone(), .nonnull = self.ctx().nonnull.clone(), .min_len = self.ctx().min_len.clone(), .index_of = self.ctx().index_of.clone() }
    }

    fn facts_restore(self: *mut Self, s: *FactState) {
        self.ctx().ranges = s.ranges.clone()
        self.ctx().nonzero = s.nonzero.clone()
        self.ctx().nonnull = s.nonnull.clone()
        self.ctx().min_len = s.min_len.clone()
        self.ctx().index_of = s.index_of.clone()
    }

    /// The local changed: nothing proven about it holds any more.
    fn forget_local(self: *mut Self, l: usize) {
        _ = self.ctx().ranges.remove(l)
        _ = self.ctx().min_len.remove(l)
        _ = self.ctx().index_of.remove(l)
        check.drop_local(&mut self.ctx().nonzero, l)
        check.drop_local(&mut self.ctx().nonnull, l)
    }

    /// A loop may change any `var` on any pass: what was proven about one
    /// before the loop does not hold inside it, nor after.
    fn forget_var_facts(self: *mut Self) {
        var ks = List(usize).new()
        for k in self.ctx().ranges { ks.append(k) }
        for k in self.ctx().min_len { ks.append(k) }
        for k in self.ctx().index_of { ks.append(k) }
        for k in self.ctx().nonzero { ks.append(k) }
        for k in self.ctx().nonnull { ks.append(k) }
        for l in ks { if self.ctx().locals[l].mutable { self.forget_local(l) } }
    }

    /// Whether parse node `e` is an integer literal, or `-` on one.
    fn is_int_literal(self: *mut Self, m: usize, e: usize) -> bool {
        let n = self.node(m, e)
        if n.k == parser.NodeKind.Lit { return n.text == "int" }
        if n.k == parser.NodeKind.Unary and n.name == "-" {
            let inner = self.node(m, n.x)
            return inner.k == parser.NodeKind.Lit and inner.text == "int"
        }
        return false
    }

    /// A distinct type's representation, any other type itself.
    fn numeric_base(self: *mut Self, t: usize) -> usize {
        if self.tys.kind(t) == TK.Distinct { return self.tys.shallow(self.distinct_underlying(self.tys.list[t].def)) }
        return t
    }

    fn check_cast(self: *mut Self, e: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let inner_node = n.x
        let ty_node = n.y
        let start = n.start
        let end = n.end
        let st = self.ctx().self_ty
        let target = self.resolve_type(m, ty_node, st)
        let to = self.tys.shallow(target)
        // a literal operand, or `-` on one, takes a numeric target as its type:
        // `0xffffffffffffffff as u128` is that value, not an `i64`'s -1
        // widened, and `300 as u8` fails as `let z: u8 = 300` does
        var operand_expected = NONE
        if self.is_int_literal(m, inner_node) and self.tys.is_numeric(self.numeric_base(to)) { operand_expected = to }
        let inner = self.check_expr(inner_node, operand_expected)
        let from = self.tys.resolve(self.tir.nodes[inner].ty, true)
        let kf = self.tys.kind(from)
        let kt = self.tys.kind(to)
        var uf = from
        var ut = to
        if kf == TK.Distinct { uf = self.tys.shallow(self.distinct_underlying(self.tys.list[from].def)) }
        if kt == TK.Distinct { ut = self.tys.shallow(self.distinct_underlying(self.tys.list[to].def)) }
        let kuf = self.tys.kind(uf)
        let kut = self.tys.kind(ut)
        var kind = String.new()
        if (kf == TK.Distinct or kt == TK.Distinct) and uf == ut {
            kind = String.from("bits")
        } else if kuf == TK.Int and kut == TK.Int {
            let an = self.tys.list[uf].name.clone()
            let bn = self.tys.list[ut].name.clone()
            let fits = check.int_min(an[..]) >= check.int_min(bn[..]) and check.int_max(an[..]) <= check.int_max(bn[..])
            var proven = fits
            if !proven {
                if let r = self.expr_range(inner) { proven = r.lo >= check.int_min(bn[..]) and r.hi <= check.int_max(bn[..]) }
            }
            if !proven { self.add_effect(EFF_PANICS, start, "narrowing cast panics when the value does not fit (use `@truncate` to wrap)") }
            kind = format("int_to_int checked={}", .{!proven})
        } else if kuf == TK.Int and kut == TK.Float {
            kind = String.from("int_to_float")
        } else if kuf == TK.Float and kut == TK.Int {
            self.add_effect(EFF_PANICS, start, "float to integer cast panics when out of range")
            kind = String.from("float_to_int")
        } else if kuf == TK.Float and kut == TK.Float {
            kind = String.from("float_to_float")
        } else if kuf == TK.Bool and kut == TK.Int {
            kind = String.from("bits")
        } else if kuf == TK.Char and kut == TK.Int {
            if check.int_max(self.tys.list[ut].name[..]) < 0x10FFFF {
                self.add_effect(EFF_PANICS, start, "char to narrow integer cast panics when out of range")
                kind = String.from("int_to_int checked=true")
            } else {
                kind = String.from("bits")
            }
        } else if kuf == TK.Int and kut == TK.Char {
            self.add_effect(EFF_PANICS, start, "integer to char cast panics for invalid scalar values")
            kind = String.from("int_to_int checked=true")
        } else if kuf == TK.Enum and kut == TK.Int {
            let d = self.tys.list[uf].def
            let em = self.enums[d].module
            let variants = self.enums[d].variants.clone()
            for v in variants { if self.node(em, v).text != "unit" { self.fail_here(start, "only enums without payloads convert to integers") } }
            kind = String.from("bits")
        } else if kuf == TK.Ptr and kut == TK.Ptr {
            if self.ctx().unsafe_depth == 0 { self.fail_here(start, "pointer casts require an `unsafe` block") }
            kind = String.from("ptr_to_ptr")
        } else if (kuf == TK.Int and kut == TK.Ptr) or (kuf == TK.Ptr and kut == TK.Int and self.tys.list[ut].name == "usize") {
            if self.ctx().unsafe_depth == 0 { self.fail_here(start, "casting between pointers and integers requires an `unsafe` block") }
            kind = String.from("ptr_to_ptr")
        } else {
            if self.unify(from, to) { return inner }
            self.fail_here(start, format("cannot cast `{}` to `{}`", .{self.ty_name(from), self.ty_name(to)})[..])
            return self.error_expr(start, end)
        }
        let c = self.mk(TKind.Cast, to, start, end)
        self.tir.nodes[c].name = kind
        self.tir.nodes[c].kids.append(inner)
        return c
    }
}
