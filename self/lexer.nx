// The Nexium lexer, in Nexium. First piece of the self-hosted compiler.
//
// Usage: lexer <file.nx>
// Prints one line per token, `start end KIND [payload]`, in exactly the format
// of `nx tokens`, so the two can be diffed. Errors go to stderr as
// `error at OFFSET: message` and the exit code is 1.

pub enum Kind {
    Ident, Int, Float, Str, Bytes, Char, Doc, Newline, Eof,
    LParen, RParen, LBrace, RBrace, LBracket, RBracket,
    Comma, Colon, Semi, Dot, DotStar, DotQuestion, DotDot, DotLBrace,
    Arrow, FatArrow, Question, Bang, Tilde, At, Pipe, PipeGt, Hash, Dollar,
    Plus, Minus, Star, Slash, Percent,
    PlusPct, MinusPct, StarPct, PlusPipe, MinusPipe, StarPipe,
    Amp, Caret,
    Eq, EqEq, Ne, Lt, Le, Gt, Ge,
    PlusEq, MinusEq, StarEq, SlashEq, PercentEq, AmpEq, PipeEq, CaretEq, ShlEq, ShrEq,
    PlusPctEq, MinusPctEq, StarPctEq,
    LtLt, GtGt,
}

pub fn kind_name(k: Kind) -> []u8 {
    match k {
        .Ident => "Ident", .Int => "Int", .Float => "Float", .Str => "Str", .Bytes => "Bytes",
        .Char => "Char", .Doc => "Doc", .Newline => "Newline", .Eof => "Eof",
        .LParen => "LParen", .RParen => "RParen", .LBrace => "LBrace", .RBrace => "RBrace",
        .LBracket => "LBracket", .RBracket => "RBracket",
        .Comma => "Comma", .Colon => "Colon", .Semi => "Semi", .Dot => "Dot", .DotStar => "DotStar",
        .DotQuestion => "DotQuestion", .DotDot => "DotDot", .DotLBrace => "DotLBrace",
        .Arrow => "Arrow", .FatArrow => "FatArrow", .Question => "Question", .Bang => "Bang",
        .Tilde => "Tilde", .At => "At", .Pipe => "Pipe", .PipeGt => "PipeGt", .Hash => "Hash",
        .Dollar => "Dollar",
        .Plus => "Plus", .Minus => "Minus", .Star => "Star", .Slash => "Slash", .Percent => "Percent",
        .PlusPct => "PlusPct", .MinusPct => "MinusPct", .StarPct => "StarPct",
        .PlusPipe => "PlusPipe", .MinusPipe => "MinusPipe", .StarPipe => "StarPipe",
        .Amp => "Amp", .Caret => "Caret",
        .Eq => "Eq", .EqEq => "EqEq", .Ne => "Ne", .Lt => "Lt", .Le => "Le", .Gt => "Gt", .Ge => "Ge",
        .PlusEq => "PlusEq", .MinusEq => "MinusEq", .StarEq => "StarEq", .SlashEq => "SlashEq",
        .PercentEq => "PercentEq", .AmpEq => "AmpEq", .PipeEq => "PipeEq", .CaretEq => "CaretEq",
        .ShlEq => "ShlEq", .ShrEq => "ShrEq",
        .PlusPctEq => "PlusPctEq", .MinusPctEq => "MinusPctEq", .StarPctEq => "StarPctEq",
        .LtLt => "LtLt", .GtGt => "GtGt",
    }
}

pub struct Token {
    kind: Kind
    start: usize
    end: usize
    text: String
}

pub struct Lexer {
    src: []u8
    pos: usize
    depth: List(u8)
    toks: List(Token)
    errors: List(String)
}

fn is_digit(c: u8) -> bool { return c >= '0' and c <= '9' }
fn is_alpha(c: u8) -> bool { return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') }
fn is_alnum(c: u8) -> bool { return is_digit(c) or is_alpha(c) }
fn is_hex(c: u8) -> bool { return is_digit(c) or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F') }

fn hex_value(c: u8) -> u8 {
    if is_digit(c) { return c - '0' }
    if c >= 'a' and c <= 'f' { return c - 'a' + 10 }
    return c - 'A' + 10
}

// String.append_char encodes a code point; a raw byte goes in as a one-byte slice.
fn push_byte(out: *mut String, b: u8) {
    let one = [b]
    out.append(one[..])
}

fn append_hex(out: *mut String, b: u8) {
    let digits = "0123456789abcdef"
    out.append_char(digits[(b >> 4) as usize] as char)
    out.append_char(digits[(b & 15) as usize] as char)
}

fn utf8_len(first: u8) -> usize {
    if first < 0x80 { return 1 }
    if (first >> 5) == 0b110 { return 2 }
    if (first >> 4) == 0b1110 { return 3 }
    return 4
}

fn append_utf8(out: *mut String, cp: u32) {
    if cp < 0x80 {
        push_byte(out, cp as u8)
    } else if cp < 0x800 {
        push_byte(out, (0xC0 | (cp >> 6)) as u8)
        push_byte(out, (0x80 | (cp & 0x3F)) as u8)
    } else if cp < 0x10000 {
        push_byte(out, (0xE0 | (cp >> 12)) as u8)
        push_byte(out, (0x80 | ((cp >> 6) & 0x3F)) as u8)
        push_byte(out, (0x80 | (cp & 0x3F)) as u8)
    } else {
        push_byte(out, (0xF0 | (cp >> 18)) as u8)
        push_byte(out, (0x80 | ((cp >> 12) & 0x3F)) as u8)
        push_byte(out, (0x80 | ((cp >> 6) & 0x3F)) as u8)
        push_byte(out, (0x80 | (cp & 0x3F)) as u8)
    }
}

fn is_scalar(v: u32) -> bool {
    return v < 0x110000 and (v < 0xD800 or v > 0xDFFF)
}

// The first code point of a UTF-8 buffer, or null when it is not valid UTF-8.
fn first_code_point(b: []u8) -> ?u32 {
    if b.len == 0 { return null }
    let c0 = b[0]
    if c0 < 0x80 { return c0 as u32 }
    let n = utf8_len(c0)
    if n == 4 and (c0 >> 3) != 0b11110 { return null }
    if b.len < n { return null }
    var cp: u32 = 0
    if n == 2 {
        cp = (c0 & 0x1F) as u32
    } else if n == 3 {
        cp = (c0 & 0x0F) as u32
    } else {
        cp = (c0 & 0x07) as u32
    }
    for i in 1..n {
        let c = b[i]
        if (c & 0xC0) != 0x80 { return null }
        cp = (cp << 6) | (c & 0x3F) as u32
    }
    if n == 2 and cp < 0x80 { return null }
    if n == 3 and cp < 0x800 { return null }
    if n == 4 and cp < 0x10000 { return null }
    if !is_scalar(cp) { return null }
    // the rest of the buffer must be valid too (Rust checks the whole literal)
    var i = n
    while i < b.len {
        let c = b[i]
        if c < 0x80 { i += 1; continue }
        let m = utf8_len(c)
        if m == 4 and (c >> 3) != 0b11110 { return null }
        if i + m > b.len { return null }
        for j in 1..m { if (b[i + j] & 0xC0) != 0x80 { return null } }
        i += m
    }
    return cp
}

fn is_valid_utf8(b: []u8) -> bool {
    if b.len == 0 { return true }
    return first_code_point(b) != null
}

fn parse_radix(text: []u8, radix: u128) -> ?u128 {
    if text.len == 0 { return null }
    var v: u128 = 0
    for c in text {
        var d: u128 = 0
        if is_digit(c) {
            d = (c - '0') as u128
        } else if is_hex(c) {
            d = hex_value(c) as u128
        } else {
            return null
        }
        if d >= radix { return null }
        if let m = v.checked_mul(radix) { v = m } else { return null }
        if let a = v.checked_add(d) { v = a } else { return null }
    }
    return v
}

// Does the digit text form a float Rust's parser accepts?
fn valid_float(text: []u8, radix: u32) -> bool {
    var i: usize = 0
    var mant_digits: usize = 0
    while i < text.len and (is_digit(text[i]) or (radix == 16 and is_hex(text[i]))) { i += 1; mant_digits += 1 }
    if i < text.len and text[i] == '.' {
        i += 1
        while i < text.len and (is_digit(text[i]) or (radix == 16 and is_hex(text[i]))) { i += 1; mant_digits += 1 }
    }
    if mant_digits == 0 { return false }
    if i < text.len and ((radix == 10 and (text[i] == 'e' or text[i] == 'E')) or (radix == 16 and (text[i] == 'p' or text[i] == 'P'))) {
        i += 1
        if i < text.len and (text[i] == '+' or text[i] == '-') { i += 1 }
        var exp_digits: usize = 0
        while i < text.len and is_digit(text[i]) { i += 1; exp_digits += 1 }
        if exp_digits == 0 { return false }
    }
    return i == text.len
}

impl Lexer {
    fn peek(self: *Self) -> u8 {
        return if self.pos < self.src.len { self.src[self.pos] } else { 0 }
    }
    fn peek_at(self: *Self, n: usize) -> u8 {
        return if self.pos + n < self.src.len { self.src[self.pos + n] } else { 0 }
    }
    fn push(self: *mut Self, kind: Kind, start: usize, own text: String) {
        self.toks.append(Token{ .kind = kind, .start = start, .end = self.pos, .text = text })
    }
    fn push_plain(self: *mut Self, kind: Kind, start: usize) {
        self.push(kind, start, String.new())
    }
    fn err(self: *mut Self, start: usize, msg: []u8) {
        self.errors.append(format("error at {}: {}", .{start, msg}))
    }
    fn last_is_newline(self: *Self) -> bool {
        if self.toks.len == 0 { return true }
        return self.toks[self.toks.len - 1].kind == Kind.Newline
    }
    fn newlines_suppressed(self: *Self) -> bool {
        if self.depth.len == 0 { return false }
        let top = self.depth[self.depth.len - 1]
        return top == '(' or top == '['
    }

    pub fn lex(self: *mut Self) {
        while true {
            let c = self.peek()
            if c == 0 { break }
            let start = self.pos
            if c == ' ' or c == '\t' or c == '\r' {
                self.pos += 1
            } else if c == '\n' {
                self.pos += 1
                if !self.newlines_suppressed() and !self.last_is_newline() {
                    self.push_plain(Kind.Newline, start)
                }
            } else if c == '/' and self.peek_at(1) == '/' {
                let is_doc = self.peek_at(2) == '/' and self.peek_at(3) != '/'
                self.pos += if is_doc { 3 } else { 2 }
                let s = self.pos
                while self.peek() != '\n' and self.peek() != 0 { self.pos += 1 }
                if is_doc {
                    let text = String.from(self.src[s..self.pos].trim())
                    self.push(Kind.Doc, start, text)
                }
            } else if is_alpha(c) or c == '_' {
                if (c == 'r' or c == 'b') and self.peek_at(1) == '"' {
                    self.pos += 1
                    self.string(start, c == 'r', c == 'b')
                    continue
                }
                while is_alnum(self.peek()) or self.peek() == '_' { self.pos += 1 }
                self.push(Kind.Ident, start, String.from(self.src[start..self.pos]))
            } else if is_digit(c) {
                self.number(start)
            } else if c == '"' {
                self.string(start, false, false)
            } else if c == '\'' {
                self.char_lit(start)
            } else if c >= 0x80 {
                while self.peek() >= 0x80 { self.pos += 1 }
                self.err(start, "non-ASCII characters are not permitted outside string literals and comments")
            } else {
                self.punct(start)
            }
        }
        let start = self.pos
        if !self.last_is_newline() { self.push_plain(Kind.Newline, start) }
        self.push_plain(Kind.Eof, start)
    }

    fn number(self: *mut Self, start: usize) {
        var radix: u32 = 10
        if self.peek() == '0' {
            let n = self.peek_at(1)
            if n == 'x' or n == 'X' { radix = 16; self.pos += 2 }
            else if n == 'o' or n == 'O' { radix = 8; self.pos += 2 }
            else if n == 'b' or n == 'B' { radix = 2; self.pos += 2 }
        }
        let digits_start = self.pos
        var is_float = false
        while true {
            let c = self.peek()
            if c == '_' or is_digit(c) or (radix == 16 and is_hex(c)) {
                self.pos += 1
            } else if c == '.' and radix == 10 and is_digit(self.peek_at(1)) {
                is_float = true
                self.pos += 1
            } else if c == '.' and radix == 16 and is_hex(self.peek_at(1)) {
                is_float = true
                self.pos += 1
            } else if (c == 'e' or c == 'E') and radix == 10 {
                is_float = true
                self.pos += 1
                if self.peek() == '+' or self.peek() == '-' { self.pos += 1 }
            } else if (c == 'p' or c == 'P') and radix == 16 {
                is_float = true
                self.pos += 1
                if self.peek() == '+' or self.peek() == '-' { self.pos += 1 }
            } else {
                break
            }
        }
        var text = String.new()
        for b in self.src[digits_start..self.pos] { if b != '_' { text.append_char(b as char) } }
        if is_float {
            if valid_float(text, radix) {
                self.push(Kind.Float, start, String.from(self.src[start..self.pos]))
            } else {
                self.err(start, format("malformed float literal `{}`", .{text}))
            }
        } else {
            if let v = parse_radix(text, radix as u128) {
                self.push(Kind.Int, start, v.to_string())
            } else {
                self.err(start, format("malformed integer literal `{}`", .{text}))
            }
        }
        if is_alpha(self.peek()) {
            let s = self.pos
            while is_alnum(self.peek()) { self.pos += 1 }
            self.err(s, "unexpected characters after numeric literal")
        }
    }

    // after the backslash was consumed
    fn escape(self: *mut Self, out: *mut String, start: usize) {
        let c = self.peek()
        self.pos += 1
        if c == 'n' { out.append_char('\n') }
        else if c == 'r' { out.append_char('\r') }
        else if c == 't' { out.append_char('\t') }
        else if c == '0' { out.append_char(0 as char) }
        else if c == '\\' { out.append_char('\\') }
        else if c == '"' { out.append_char('"') }
        else if c == '\'' { out.append_char('\'') }
        else if c == 'x' {
            if is_hex(self.peek()) and is_hex(self.peek_at(1)) {
                let v = hex_value(self.peek()) * 16 + hex_value(self.peek_at(1))
                push_byte(out, v)
                self.pos += 2
            } else {
                self.err(start, "\\x escape needs two hex digits")
            }
        } else if c == 'u' {
            if self.peek() == '{' {
                self.pos += 1
                let s = self.pos
                while is_hex(self.peek()) { self.pos += 1 }
                let hex = self.src[s..self.pos]
                if self.peek() == '}' { self.pos += 1 }
                var ok = false
                if let v = parse_radix(hex, 16) {
                    if v < 0x110000 and is_scalar(v as u32) {
                        append_utf8(out, v as u32)
                        ok = true
                    }
                }
                if !ok { self.err(start, "invalid \\u{...} escape") }
            } else {
                self.err(start, "\\u escape needs braces: \\u{1F600}")
            }
        } else {
            var msg = String.from("unknown escape `\\")
            push_byte(&mut msg, c)
            msg.append("`")
            self.err(start, msg)
        }
    }

    fn string(self: *mut Self, start: usize, raw: bool, bytes: bool) {
        self.pos += 1
        var out = String.new()
        while true {
            let c = self.peek()
            if c == 0 {
                self.err(start, "unterminated string literal")
                break
            }
            if c == '"' {
                self.pos += 1
                break
            }
            if c == '\\' and !raw {
                self.pos += 1
                self.escape(&mut out, start)
                continue
            }
            if c == '\n' and !raw {
                self.err(start, "newline in string literal (use \\n or a raw string)")
            }
            push_byte(&mut out, c)
            self.pos += 1
        }
        var hex = String.new()
        for b in out { append_hex(&mut hex, b) }
        if bytes {
            self.push(Kind.Bytes, start, hex)
        } else {
            if !is_valid_utf8(out) {
                self.err(start, "string literal is not valid UTF-8 (use b\"...\" for bytes)")
            }
            self.push(Kind.Str, start, hex)
        }
    }

    fn char_lit(self: *mut Self, start: usize) {
        self.pos += 1
        var out = String.new()
        let c = self.peek()
        if c == '\\' {
            self.pos += 1
            self.escape(&mut out, start)
        } else if c == 0 or c == '\n' {
            self.err(start, "unterminated character literal")
            return
        } else {
            let n = utf8_len(c)
            var end = self.pos + n
            if end > self.src.len { end = self.src.len }
            out.append(self.src[self.pos..end])
            self.pos += n
        }
        if self.peek() != '\'' {
            self.err(start, "character literal must contain exactly one character")
            while self.peek() != '\'' and self.peek() != '\n' and self.peek() != 0 { self.pos += 1 }
        }
        if self.peek() == '\'' { self.pos += 1 }
        var v: u32 = 0
        if let cp = first_code_point(out) {
            v = cp
        } else if out.len > 0 {
            v = out[0] as u32
        }
        self.push(Kind.Char, start, v.to_string())
    }

    fn punct(self: *mut Self, start: usize) {
        let c = self.peek()
        let c1 = self.peek_at(1)
        let c2 = self.peek_at(2)
        var kind = Kind.Eof
        var len: usize = 1
        if c == '(' { self.depth.append('('); kind = Kind.LParen }
        else if c == '[' { self.depth.append('['); kind = Kind.LBracket }
        else if c == '{' { self.depth.append('{'); kind = Kind.LBrace }
        else if c == ')' { _ = self.depth.pop(); kind = Kind.RParen }
        else if c == ']' { _ = self.depth.pop(); kind = Kind.RBracket }
        else if c == '}' { _ = self.depth.pop(); kind = Kind.RBrace }
        else if c == ',' { kind = Kind.Comma }
        else if c == ';' { kind = Kind.Semi }
        else if c == ':' { kind = Kind.Colon }
        else if c == '.' and c1 == '*' { kind = Kind.DotStar; len = 2 }
        else if c == '.' and c1 == '?' { kind = Kind.DotQuestion; len = 2 }
        else if c == '.' and c1 == '.' { kind = Kind.DotDot; len = 2 }
        else if c == '.' and c1 == '{' { self.depth.append('{'); kind = Kind.DotLBrace; len = 2 }
        else if c == '.' { kind = Kind.Dot }
        else if c == '-' and c1 == '>' { kind = Kind.Arrow; len = 2 }
        else if c == '=' and c1 == '>' { kind = Kind.FatArrow; len = 2 }
        else if c == '=' and c1 == '=' { kind = Kind.EqEq; len = 2 }
        else if c == '=' { kind = Kind.Eq }
        else if c == '!' and c1 == '=' { kind = Kind.Ne; len = 2 }
        else if c == '!' { kind = Kind.Bang }
        else if c == '<' and c1 == '<' and c2 == '=' { kind = Kind.ShlEq; len = 3 }
        else if c == '<' and c1 == '<' { kind = Kind.LtLt; len = 2 }
        else if c == '<' and c1 == '=' { kind = Kind.Le; len = 2 }
        else if c == '<' { kind = Kind.Lt }
        else if c == '>' and c1 == '>' and c2 == '=' { kind = Kind.ShrEq; len = 3 }
        else if c == '>' and c1 == '>' { kind = Kind.GtGt; len = 2 }
        else if c == '>' and c1 == '=' { kind = Kind.Ge; len = 2 }
        else if c == '>' { kind = Kind.Gt }
        else if c == '+' and c1 == '%' and c2 == '=' { kind = Kind.PlusPctEq; len = 3 }
        else if c == '+' and c1 == '%' { kind = Kind.PlusPct; len = 2 }
        else if c == '+' and c1 == '|' { kind = Kind.PlusPipe; len = 2 }
        else if c == '+' and c1 == '=' { kind = Kind.PlusEq; len = 2 }
        else if c == '+' { kind = Kind.Plus }
        else if c == '-' and c1 == '%' and c2 == '=' { kind = Kind.MinusPctEq; len = 3 }
        else if c == '-' and c1 == '%' { kind = Kind.MinusPct; len = 2 }
        else if c == '-' and c1 == '|' { kind = Kind.MinusPipe; len = 2 }
        else if c == '-' and c1 == '=' { kind = Kind.MinusEq; len = 2 }
        else if c == '-' { kind = Kind.Minus }
        else if c == '*' and c1 == '%' and c2 == '=' { kind = Kind.StarPctEq; len = 3 }
        else if c == '*' and c1 == '%' { kind = Kind.StarPct; len = 2 }
        else if c == '*' and c1 == '|' { kind = Kind.StarPipe; len = 2 }
        else if c == '*' and c1 == '=' { kind = Kind.StarEq; len = 2 }
        else if c == '*' { kind = Kind.Star }
        else if c == '/' and c1 == '=' { kind = Kind.SlashEq; len = 2 }
        else if c == '/' { kind = Kind.Slash }
        else if c == '%' and c1 == '=' { kind = Kind.PercentEq; len = 2 }
        else if c == '%' { kind = Kind.Percent }
        else if c == '&' and c1 == '=' { kind = Kind.AmpEq; len = 2 }
        else if c == '&' { kind = Kind.Amp }
        else if c == '|' and c1 == '>' { kind = Kind.PipeGt; len = 2 }
        else if c == '|' and c1 == '=' { kind = Kind.PipeEq; len = 2 }
        else if c == '|' { kind = Kind.Pipe }
        else if c == '^' and c1 == '=' { kind = Kind.CaretEq; len = 2 }
        else if c == '^' { kind = Kind.Caret }
        else if c == '?' { kind = Kind.Question }
        else if c == '~' { kind = Kind.Tilde }
        else if c == '@' { kind = Kind.At }
        else if c == '#' { kind = Kind.Hash }
        else if c == '$' { kind = Kind.Dollar }
        else {
            self.pos += 1
            var msg = String.from("unexpected character `")
            push_byte(&mut msg, c)
            msg.append("`")
            self.err(start, msg)
            return
        }
        self.pos += len
        self.push_plain(kind, start)
    }
}

/// A lexer over `src`, ready to `lex()`.
pub fn new_lexer(src: []u8) -> Lexer {
    return Lexer{ .src = src, .pos = 0, .depth = List(u8).new(), .toks = List(Token).new(), .errors = List(String).new() }
}

/// Is `s` a reserved word?
pub fn is_keyword(s: []u8) -> bool {
    for k in KEYWORDS { if k == s { return true } }
    return false
}

const KEYWORDS = ["fn", "let", "var", "const", "struct", "enum", "record", "ref", "class", "trait", "impl", "pub", "import", "return", "if", "else", "for", "while", "match", "break", "continue", "try", "catch", "defer", "errdefer", "comptime", "unsafe", "error", "true", "false", "null", "undefined", "and", "or", "type", "distinct", "where", "into", "artifact", "test", "export", "unreachable", "as", "orelse", "in", "dyn", "weak", "parallel", "extern", "using"]

fn main() -> !void {
    let args = os.args()
    if args.len < 2 {
        eprintln("usage: lexer <file.nx>", .{})
        os.exit(2)
    }
    let text = try io.read_file(args[1])
    var lx = Lexer{ .src = text, .pos = 0, .depth = List(u8).new(), .toks = List(Token).new(), .errors = List(String).new() }
    lx.lex()
    var out = String.new()
    for t in lx.toks {
        out.append(format("{} {} {}", .{t.start, t.end, kind_name(t.kind)}))
        if t.text.len > 0 {
            out.append(" ")
            out.append(t.text)
        }
        out.append("\n")
    }
    print("{}", .{out})
    for e in lx.errors { eprintln("{}", .{e}) }
    if lx.errors.len > 0 { os.exit(1) }
}
