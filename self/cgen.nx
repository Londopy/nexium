            let sep = if name == "SliceSplit" { self.simple(args[1]) } else { String.from("nx_lit(\"\\n\", 1)") }
            self.line(format("{{ size_t _s = 0; for (;;) {{ nx_sl_u8 _rest = {{ nx_padd({}.ptr, _s), {}.len - _s }}; size_t _i; bool _f = {}.len && nx_sl_find(_rest, {}, &_i); nx_sl_u8 _piece = {{ _rest.ptr, _f ? _i : _rest.len }};", .{av, av, sep, sep})[..])
            if name == "SliceLines" {
                self.line("  if (_piece.len && _piece.ptr[_piece.len - 1] == '\\r') _piece.len--;")
                self.line(format("  if (!_f && _piece.len == 0 && {}.len) break;", .{av})[..])
            }
            self.line(format("  if ({}.len == {}.cap) nx_list_grow(c, (nx_rawlist*)&{}, sizeof(nx_sl_u8), _Alignof(nx_sl_u8), {}.len + 1);", .{t, t, t, t})[..])
            self.line(format("  {}.ptr[{}.len++] = _piece; if (!_f) break; _s += _i + {}.len; }} }}", .{t, t, sep})[..])
