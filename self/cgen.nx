            self.line(format("if ({} >= {}->len) nx_panic_bounds({}, {}->len, {});", .{i, lp, i, lp, loc})[..])
            self.line(format("{} {} = {}->ptr[{}];", .{en, t, lp, i})[..])
            if name == "ListRemove" {
