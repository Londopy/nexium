            if self.c.tir.nodes[args[2]].k == check.TKind.Int { marker = self.c.tir.nodes[args[2]].ival }
            let f = if marker == 0 { "add" } else if marker == 1 { "sub" } else { "mul" }
            let cn = self.cty(ety)
