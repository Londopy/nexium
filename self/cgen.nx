            return format("((({}) >= 'a' && ({}) <= 'z') || (({}) >= 'A' && ({}) <= 'Z'))", .{v, v, v, v})
        }
        if name == "CharIsSpace" {
            let v = self.simple(args[0])
            return format("(({}) == ' ' || ({}) == '\\t' || ({}) == '\\n' || ({}) == '\\r')", .{v, v, v, v})
        }
        if name == "CharToLower" {
            let v = self.simple(args[0])
            return format("((({}) >= 'A' && ({}) <= 'Z') ? ({}) + 32 : ({}))", .{v, v, v, v})
        }
        if name == "CharToUpper" {
            let v = self.simple(args[0])
            return format("((({}) >= 'a' && ({}) <= 'z') ? ({}) - 32 : ({}))", .{v, v, v, v})
        }
        if name == "CharToDigit" {
            let v = self.simple(args[0])
            let cn = self.cty(ety)
            let t = self.tmp()
            self.line(format("{} {}; {}.has = ({}) >= '0' && ({}) <= '9'; {}.val = ({}) - '0';", .{cn, t, t, v, v, t, v})[..])
            return t
        }
        if name == "ReadFile" {
            let p = self.simple(args[0])
            let cn = self.cty(ety)
            let t = self.tmp()
            let io = self.err_id("IoError")
            self.line(format("{} {}; {{ nx_string _s; if (nx_read_file(c, {}, &_s)) {{ {}.err = 0; {}.val = _s; }} else {}.err = {}u; }}", .{cn, t, p, t, t, t, io})[..])
            return t
        }
        if name == "WriteFile" or name == "AppendFile" {
            let p = self.simple(args[0])
            let d = self.simple(args[1])
            let cn = self.cty(ety)
            let io = self.err_id("IoError")
            let f = if name == "WriteFile" { "nx_write_file" } else { "nx_append_file" }
            return format("(({}){{ .err = {}({}, {}) ? 0 : {}u }})", .{cn, f, p, d, io})
        }
        if name == "FsKind" {
            let p = self.simple(args[0])
            return format("nx_fs_kind({})", .{p})
        }
        if name == "FsSize" or name == "FsModified" {
            let p = self.simple(args[0])
            let cn = self.cty(ety)
            let t = self.tmp()
            let nf = self.err_id("NotFound")
            let io = self.err_id("IoError")
            let pick = if name == "FsSize" { "(uint64_t)_sz" } else { "_mt" }
            self.line(format("{} {}; {{ int64_t _sz = 0, _mt = 0; int32_t _r = nx_fs_stat({}, &_sz, &_mt); if (_r == 0) {{ {}.err = 0; {}.val = {}; }} else {}.err = _r == 1 ? {}u : {}u; }}", .{cn, t, p, t, t, pick, t, nf, io})[..])
            return t
        }
        if name == "FsMkdir" or name == "FsRemoveFile" or name == "FsRemoveDir" {
            let p = self.simple(args[0])
            let cn = self.cty(ety)
            let t = self.tmp()
            let nf = self.err_id("NotFound")
            let io = self.err_id("IoError")
            let f = if name == "FsMkdir" { "nx_fs_mkdir" } else if name == "FsRemoveFile" { "nx_fs_remove_file" } else { "nx_fs_remove_dir" }
            self.line(format("{} {}; {{ int32_t _r = {}({}); {}.err = _r == 0 ? 0 : _r == 1 ? {}u : {}u; }}", .{cn, t, f, p, t, nf, io})[..])
            return t
        }
        if name == "FsRename" {
            let av = self.simple(args[0])
            let bv = self.simple(args[1])
            let cn = self.cty(ety)
            let t = self.tmp()
            let nf = self.err_id("NotFound")
            let io = self.err_id("IoError")
            self.line(format("{} {}; {{ int32_t _r = nx_fs_rename({}, {}); {}.err = _r == 0 ? 0 : _r == 1 ? {}u : {}u; }}", .{cn, t, av, bv, t, nf, io})[..])
            return t
        }
        if name == "FsListDir" {
            let p = self.simple(args[0])
            let cn = self.cty(ety)
            let t = self.tmp()
            let nf = self.err_id("NotFound")
            let io = self.err_id("IoError")
            self.line(format("{} {}; {{ nx_rawlist _l; int32_t _r = nx_fs_list_dir(c, {}, &_l); if (_r == 0) {{ {}.err = 0; memcpy(&{}.val, &_l, sizeof _l); }} else {}.err = _r == 1 ? {}u : {}u; }}", .{cn, t, p, t, t, t, nf, io})[..])
            return t
        }
        if name == "FsCwd" {
            let cn = self.cty(ety)
            let t = self.tmp()
            let io = self.err_id("IoError")
            self.line(format("{} {}; {{ nx_string _s; if (nx_fs_cwd(c, &_s)) {{ {}.err = 0; {}.val = _s; }} else {}.err = {}u; }}", .{cn, t, t, t, t, io})[..])
            return t
        }
        if name == "FsTempDir" { return String.from("nx_fs_temp_dir(c)") }
        if name == "ExePath" { return String.from("nx_exe_path(c)") }
        if name == "Arch" { return String.from("nx_host_arch()") }
        if name == "FileOpen" {
            let p = self.simple(args[0])
            let md = self.simple(args[1])
            let cn = self.cty(ety)
            let t = self.tmp()
            let nf = self.err_id("NotFound")
            let io = self.err_id("IoError")
            self.line(format("{} {}; {{ int64_t _h = nx_file_open({}, {}); if (_h >= 0) {{ {}.err = 0; {}.val = _h; }} else {}.err = _h == -1 ? {}u : {}u; }}", .{cn, t, p, md, t, t, t, nf, io})[..])
            return t
        }
        if name == "FileRead" {
            let h = self.simple(args[0])
            let n = self.simple(args[1])
            let cn = self.cty(ety)
            let t = self.tmp()
            let io = self.err_id("IoError")
            self.line(format("{} {}; {{ nx_string _s; if (nx_file_read(c, {}, {}, &_s)) {{ {}.err = 0; {}.val = _s; }} else {}.err = {}u; }}", .{cn, t, h, n, t, t, t, io})[..])
            return t
        }
        if name == "FileWrite" {
            let h = self.simple(args[0])
            let d = self.simple(args[1])
            let cn = self.cty(ety)
            let io = self.err_id("IoError")
            return format("(({}){{ .err = nx_file_write({}, {}) ? 0 : {}u }})", .{cn, h, d, io})
        }
        if name == "FileFlush" or name == "FileClose" {
            let h = self.simple(args[0])
            let cn = self.cty(ety)
            let io = self.err_id("IoError")
            let f = if name == "FileFlush" { "nx_file_flush" } else { "nx_file_close" }
            return format("(({}){{ .err = {}({}) ? 0 : {}u }})", .{cn, f, h, io})
        }
        if name == "NetConnect" or name == "NetListen" or name == "NetAccept" or name == "NetUdpBind" {
            var a = List(String).new()
            for x in args { a.append(self.simple(x)) }
            let cn = self.cty(ety)
            let t = self.tmp()
            let f = if name == "NetConnect" { "nx_tcp_connect" } else if name == "NetListen" { "nx_tcp_listen" } else if name == "NetAccept" { "nx_tcp_accept" } else { "nx_udp_bind" }
            let errs = self.net_errs()
            self.line(format("{} {}; {{ int64_t _h = 0; int32_t _r = {}({}, &_h); if (_r == 0) {{ {}.err = 0; {}.val = _h; }} else {}.err = {}; }}", .{cn, t, f, join_strings(&a, ", "), t, t, t, errs})[..])
            return t
        }
        if name == "NetSend" or name == "NetClose" or name == "NetSendTo" {
            var a = List(String).new()
            for x in args { a.append(self.simple(x)) }
            let cn = self.cty(ety)
            let t = self.tmp()
            let f = if name == "NetSend" { "nx_net_send" } else if name == "NetClose" { "nx_net_close" } else { "nx_udp_send_to" }
            let errs = self.net_errs()
            self.line(format("{} {}; {{ int32_t _r = {}({}); {}.err = _r == 0 ? 0 : {}; }}", .{cn, t, f, join_strings(&a, ", "), t, errs})[..])
            return t
        }
        if name == "NetRecv" or name == "NetRecvFrom" {
            var a = List(String).new()
            for x in args { a.append(self.simple(x)) }
            let cn = self.cty(ety)
            let t = self.tmp()
            let f = if name == "NetRecv" { "nx_net_recv" } else { "nx_udp_recv_from" }
            let errs = self.net_errs()
            self.line(format("{} {}; {{ nx_string _s; int32_t _r = {}(c, {}, &_s); if (_r == 0) {{ {}.err = 0; {}.val = _s; }} else {}.err = {}; }}", .{cn, t, f, join_strings(&a, ", "), t, t, t, errs})[..])
            return t
        }
        if name == "NetPeer" or name == "NetLocal" {
            let s = self.simple(args[0])
            let cn = self.cty(ety)
            let t = self.tmp()
            let local = if name == "NetLocal" { "true" } else { "false" }
            let errs = self.net_errs()
            self.line(format("{} {}; {{ nx_string _s; int32_t _r = nx_net_name(c, {}, {}, &_s); if (_r == 0) {{ {}.err = 0; {}.val = _s; }} else {}.err = {}; }}", .{cn, t, s, local, t, t, t, errs})[..])
            return t
        }
        if name == "NetResolve" {
            let h = self.simple(args[0])
            let cn = self.cty(ety)
            let t = self.tmp()
            let errs = self.net_errs()
            self.line(format("{} {}; {{ nx_rawlist _l; int32_t _r = nx_net_resolve(c, {}, &_l); if (_r == 0) {{ {}.err = 0; memcpy(&{}.val, &_l, sizeof _l); }} else {}.err = {}; }}", .{cn, t, h, t, t, t, errs})[..])
            return t
        }
        if name == "NetLastPeer" { return String.from("nx_net_last_peer(c)") }
        if name == "ThreadStart" {
            let f = self.simple(args[0])
            let p = self.simple(args[1])
            return format("nx_thread_start(c, (void*){}.fn, {}.env, (void*)({}))", .{f, f, p})
        }
        if name == "ThreadJoin" {
            let h = self.simple(args[0])
            self.line(format("nx_thread_join({}, {});", .{h, loc})[..])
            return String.from("0")
        }
        if name == "ThreadCount" { return String.from("nx_hw_threads()") }
        if name == "MutexNew" { return String.from("nx_mutex_new()") }
        if name == "CondNew" { return String.from("nx_cond_new()") }
        if name == "MutexLock" or name == "MutexUnlock" or name == "MutexFree" or name == "CondSignal" or name == "CondBroadcast" or name == "CondFree" {
            let h = self.simple(args[0])
            let f = if name == "MutexLock" { "nx_mutex_lock" } else if name == "MutexUnlock" { "nx_mutex_unlock" } else if name == "MutexFree" { "nx_mutex_free" }
            else if name == "CondSignal" { "nx_cond_signal" } else if name == "CondBroadcast" { "nx_cond_broadcast" } else { "nx_cond_free" }
            self.line(format("{}({});", .{f, h})[..])
            return String.from("0")
        }
        if name == "CondWait" {
            let cv = self.simple(args[0])
            let mu = self.simple(args[1])
            self.line(format("nx_cond_wait({}, {});", .{cv, mu})[..])
            return String.from("0")
        }
        if name == "Environ" {
            let cn = self.cty(ety)
            let t = self.tmp()
            self.line(format("{} {}; {{ nx_rawlist _l; nx_environ(c, &_l); memcpy(&{}, &_l, sizeof _l); }}", .{cn, t, t})[..])
            return t
        }
        if name == "ReadLine" {
            let cn = self.cty(ety)
            let t = self.tmp()
            self.line(format("{} {}; {{ nx_string _s; {}.has = nx_read_line(c, &_s); if ({}.has) {}.val = _s; }}", .{cn, t, t, t, t})[..])
            return t
        }
        if name == "Args" {
            let cn = self.cty(ety)
            let t = self.tmp()
            self.line(format("{} {}; {{ size_t _n; nx_sl_u8* _a = nx_args(c, &_n); {}.ptr = _a; {}.len = _n; }}", .{cn, t, t, t})[..])
            return t
        }
        if name == "Env" {
            let n = self.simple(args[0])
            let cn = self.cty(ety)
            let t = self.tmp()
            self.line(format("{} {}; {{ char _nb[256]; size_t _l = {}.len < 255 ? {}.len : 255; memcpy(_nb, {}.ptr, _l); _nb[_l] = 0; const char* _v = getenv(_nb); {}.has = _v != NULL; if (_v) {{ {}.val.ptr = (uint8_t*)_v; {}.val.len = strlen(_v); }} }}", .{cn, t, n, n, n, t, t, t})[..])
            return t
        }
        if name == "SetEnv" {
            let n = self.simple(args[0])
            let v = self.simple(args[1])
            self.line(format("nx_set_env({}, {});", .{n, v})[..])
            return String.from("0")
        }
        if name == "RawMode" {
            let on = self.simple(args[0])
            return format("nx_raw_mode({})", .{on})
        }
        if name == "ReadKey" {
            let cn = self.cty(ety)
            let t = self.tmp()
            self.line(format("{} {}; {{ int64_t _k = 0; {}.has = nx_read_key(&_k); if ({}.has) {}.val = _k; }}", .{cn, t, t, t, t})[..])
            return t
        }
        if name == "PendingInput" { return String.from("nx_pending_input()") }
        if name == "IsTerminal" {
            let h = self.simple(args[0])
            return format("nx_is_terminal({})", .{h})
        }
        if name == "Exit" {
            let v = self.simple(args[0])
            self.line(format("exit((int)({}));", .{v})[..])
            return String.from("0")
        }
        if name == "Run" {
            let argv = self.simple(args[0])
            let cn = self.cty(ety)
            let t = self.tmp()
            let io = self.err_id("IoError")
            self.line(format("{} {}; {{ int _code = 0; if (nx_run(c, {}.ptr, {}.len, &_code)) {{ {}.err = 0; {}.val = _code; }} else {}.err = {}u; }}", .{cn, t, argv, argv, t, t, t, io})[..])
            return t
        }
        if name == "Exec" {
            let argv = self.simple(args[0])
            let input = self.simple(args[1])
            let cwd = self.simple(args[2])
            let cn = self.cty(ety)
            let t = self.tmp()
            let io = self.err_id("IoError")
            self.line(format("{} {}; {{ int _code = 0; if (nx_run_capture(c, {}.ptr, {}.len, {}, {}, &_code)) {{ {}.err = 0; {}.val = _code; }} else {}.err = {}u; }}", .{cn, t, argv, argv, input, cwd, t, t, t, io})[..])
            return t
        }
        if name == "LastStdout" { return String.from("nx_last_stdout(c)") }
        if name == "LastStderr" { return String.from("nx_last_stderr(c)") }
        if name == "TimeNow" { return String.from("nx_time_now_ms()") }
        if name == "TimeUtcOffset" {
            let v = self.simple(args[0])
            return format("nx_time_utc_offset_min({})", .{v})
        }
        if name == "TimeMonotonic" { return String.from("nx_time_monotonic_ns()") }
        if name == "Sleep" {
            let v = self.simple(args[0])
            self.line(format("nx_sleep_ms({});", .{v})[..])
            return String.from("0")
        }
        if name == "RandomInt" {
            let av = self.simple(args[0])
            let bv = self.simple(args[1])
            return format("nx_random_int(c, {}, {}, {})", .{av, bv, loc})
        }
        if name == "RandomFloat" { return String.from("nx_random_float(c)") }
        if name == "RandomSeed" {
            let v = self.simple(args[0])
            self.line(format("c->rng = {}; c->rng_seeded = true;", .{v})[..])
            return String.from("0")
        }
        self.errors.append(format("builtin {} is not supported by the C backend", .{name}))
        return String.from("0")
    }

    /// The error id for a socket result code `_r` (1 not found, 2 refused, 3 timeout, other io).
    fn net_errs(self: *mut Self) -> String {
        return format("(_r == 1 ? {}u : _r == 2 ? {}u : _r == 3 ? {}u : {}u)", .{self.err_id("NotFound"), self.err_id("ConnectionRefused"), self.err_id("Timeout"), self.err_id("IoError")})
    }

    fn map_key_kind(self: *mut Self, k: usize) -> u32 {
        let kk = self.kind(k)
        if kk == check.TK.Slice { return 1 }
        if kk == check.TK.Str { return 2 }
        return 0
    }

    fn int_bounds_pub(self: *mut Self, t0: usize, lo: *mut String, hi: *mut String) {
        let t = self.res(t0)
        let k = self.c.tys.kind(t)
        if k == check.TK.Int {
            let nm = self.c.tys.list[t].name.clone()
            lo.*= int_literal(check.int_min(nm[..]), "i128")
            hi.*= int_literal(check.int_max(nm[..]), "i128")
            return
        }
        if k == check.TK.Distinct {
            self.int_bounds_pub(self.c.distinct_underlying(self.c.tys.list[t].def), lo, hi)
            return
        }
        lo.*= String.from("0")
        hi.*= String.from("0")
    }

    fn qsort_cmp(self: *mut Self, t0: usize) -> String {
        let t = self.res(t0)
        let key = format("qsort:{}", .{t})
        if let n = self.thunks_by_key.get(key[..]) { return n.clone() }
        let m = self.mangle(t)
        let name = format("nx_qcmp_{}", .{m})
        self.thunks_by_key.put(key, name.clone())
        let cn = self.cty(t)
        let cmp = self.cmp_expr(t, format("(*(const {}*)a)", .{cn})[..], format("(*(const {}*)b)", .{cn})[..])
        self.protos_out.append(format("static int {}(const void* a, const void* b);\n", .{name})[..])
        self.helpers_out.append(format("static int {}(const void* a, const void* b) {{ return {}; }}\n", .{name, cmp})[..])
        return name
    }

    // ----- trait objects -----------------------------------------------------

    fn trait_method_name(self: *mut Self, tr: usize, i: usize) -> String {
        let tm = self.c.traits[tr].module
        return self.c.node(tm, self.c.traits[tr].methods[i]).name.clone()
    }

    /// The vtable struct of a trait and the fat pointer type over it.
    fn emit_vtable_type(self: *mut Self, tr: usize) {
        let tname = self.c.traits[tr].name.clone()
        let key = format("vtable:{}", .{tr})
        if self.thunks_by_key.contains(key[..]) { return }
        self.thunks_by_key.put(key, tname.clone())
        let methods = self.c.traits[tr].methods.clone()
        var fields = String.new()
        // method signatures are taken from any vtable instance; without one, emit generic pointers
        var sample = NONE
        for v, i in self.c.vtables { if sample == NONE and v.trait_id == tr { sample = i } }
        for m, i in methods {
            let mname = sanitize_ident(self.c.node(self.c.traits[tr].module, m).name[..])
            var sig = String.new()
            if sample != NONE and i < self.c.vtables[sample].insts.len {
                let inst = self.c.vtables[sample].insts[i]
                let ret_t = self.c.insts[inst].ret
                let ret = if self.is_void(ret_t) { String.from("void") } else { self.cty(ret_t) }
                var params = String.from("nx_ctx*, void*")
                for p, k in self.c.insts[inst].params.clone() {
                    if k == 0 { continue }
                    let cn = self.cty(self.c.insts[inst].locals[p].ty)
                    params.append(format(", {}", .{cn})[..])
                }
                sig = format("{} (*{})({})", .{ret, mname, params})
            } else {
                sig = format("void (*{})(nx_ctx*, void*)", .{mname})
            }
            fields.append(format(" {};", .{sig})[..])
        }
        self.fwd_out.append(format("typedef struct nx_vt_{} nx_vt_{};\ntypedef struct nx_dyn_{} {{ void* data; const nx_vt_{}* vt; }} nx_dyn_{};\n", .{tname, tname, tname, tname, tname})[..])
        self.types_out.append(format("struct nx_vt_{} {{{} }};\n", .{tname, fields})[..])
    }

    /// The vtable instance for (trait, type): thunks adapt `void* self` to the receiver type.
    fn vtable_instance(self: *mut Self, vt: usize) -> String {
        let tr = self.c.vtables[vt].trait_id
        let ty = self.c.vtables[vt].ty
        let insts = self.c.vtables[vt].insts.clone()
        let key = format("vtinst:{}", .{vt})
        if let n = self.thunks_by_key.get(key[..]) { return n.clone() }
        let tname = self.c.traits[tr].name.clone()
        let name = format("nx_vt_{}_{}", .{tname, self.mangle(ty)})
        self.thunks_by_key.put(key, name.clone())
        self.emit_vtable_type(tr)
        var entries = List(String).new()
        for inst, i in insts {
            let thunk = format("nx_vtthunk_{}_{}", .{vt, i})
            let ret_t = self.c.insts[inst].ret
            let ret = if self.is_void(ret_t) { String.from("void") } else { self.cty(ret_t) }
            var params = List(String).new()
            params.append(String.from("nx_ctx* c"))
            params.append(String.from("void* self"))
            var args = List(String).new()
            args.append(String.from("c"))
            let ps = self.c.insts[inst].params.clone()
            let recv_ty = self.c.insts[inst].locals[ps[0]].ty
            let recv_c = self.cty(recv_ty)
            let tcn = self.cty(ty)
            if self.kind(recv_ty) == check.TK.Ptr { args.append(format("({})self", .{recv_c})) } else { args.append(format("*({}*)self", .{tcn})) }
            for p, k in ps {
                if k == 0 { continue }
                let cn = self.cty(self.c.insts[inst].locals[p].ty)
                params.append(format("{} a{}", .{cn, k}))
                args.append(format("a{}", .{k}))
            }
            let target = self.fn_c_name(inst)
            self.helpers_out.append(format("static {} {}({}) {{ {}{}({}); }}\n", .{ret, thunk, join_strings(&params, ", "), if ret == "void" { "" } else { "return " }, target, join_strings(&args, ", ")})[..])
            entries.append(format(".{} = {}", .{sanitize_ident(self.trait_method_name(tr, i)[..]), thunk}))
        }
        self.helpers_out.append(format("static const nx_vt_{} {} = {{ {} }};\n", .{tname, name, join_strings(&entries, ", ")})[..])
        return name
    }

    fn dyn_from(self: *mut Self, e: usize) -> String {
        let inner = self.c.tir.nodes[e].kids[0]
        let v = self.expr(inner)
        let vt = self.vtable_instance(self.c.tir.nodes[e].a)
        let cn = self.cty(self.c.tir.nodes[e].ty)
        return format("(({}){{ (void*)({}), &{} }})", .{cn, v, vt})
    }

    fn dyn_call(self: *mut Self, e: usize) -> String {
        let kids = self.c.tir.nodes[e].kids.clone()
        let ety = self.c.tir.nodes[e].ty
        let recv = kids[0]
        let r = self.simple(recv)
        let rt = self.res(self.c.tir.nodes[recv].ty)
        var tr: usize = 0
        if self.c.tys.kind(rt) == check.TK.Dyn { tr = self.c.tys.list[rt].def }
        let mname = sanitize_ident(self.trait_method_name(tr, self.c.tir.nodes[e].a)[..])
        var args = List(String).new()
        args.append(String.from("c"))
        args.append(format("{}.data", .{r}))
        for x, i in kids { if i > 0 { args.append(self.simple(x)) } }
        let call = format("{}.vt->{}({})", .{r, mname, join_strings(&args, ", ")})
        if self.is_void(ety) { return call }
        return self.bind_tmp(call[..], ety)
    }

    // ----- exports -------------------------------------------------------------

    /// The scalar C type of an exportable value, or "" when it is not a scalar.
    fn scalar_c(self: *mut Self, t0: usize) -> String {
        let t = self.res(t0)
        let k = self.c.tys.kind(t)
        if k == check.TK.Int { return String.from(int_c_name(self.c.tys.list[t].name[..])) }
        if k == check.TK.Float { return String.from(if self.c.tys.list[t].name == "f32" { "float" } else { "double" }) }
        if k == check.TK.Bool { return String.from("bool") }
        if k == check.TK.Char { return String.from("uint32_t") }
        if k == check.TK.Distinct { return self.scalar_c(self.c.distinct_underlying(self.c.tys.list[t].def)) }
        return String.new()
    }

    fn type_name_pretty(self: *mut Self, t0: usize) -> String {
        let t = self.res(t0)
        let k = self.c.tys.kind(t)
        if k == check.TK.List { return String.from("List") }
        if k == check.TK.Str { return String.from("String") }
        if k == check.TK.Map { return String.from("Map") }
        if k == check.TK.Opt { return String.from("optional") }
        if k == check.TK.ErrUnion { return String.from("error union") }
        if k == check.TK.Struct { return self.c.structs[self.c.tys.list[t].def].name.clone() }
        if k == check.TK.Enum { return self.c.enums[self.c.tys.list[t].def].name.clone() }
        return self.c.ty_name(t)
    }

    /// The parameter's kind: 0 scalar, 1 slice of scalars, 2 layout(c) struct;
    /// 3 when it has no C representation (an error was reported).
    fn param_kind(self: *mut Self, t0: usize, what: []u8, fname: []u8, elem_c: *mut String, mutable: *mut bool) -> u8 {
        if self.scalar_c(t0).len > 0 { return 0 }
        let t = self.res(t0)
        let k = self.c.tys.kind(t)
        if k == check.TK.Slice {
            let ec = self.scalar_c(self.c.tys.list[t].args[0])
            if ec.len == 0 {
                self.errors.append(format("export `{}`: {} is a slice of a non-scalar type, which has no C representation", .{fname, what}))
                return 3
            }
            elem_c.*= ec
            mutable.*= self.c.tys.list[t].flag
            return 1
        }
        if k == check.TK.Struct {
            let d = self.c.tys.list[t].def
            if self.c.structs[d].layout != "c" or self.c.structs[d].kind == "ref" {
                self.errors.append(format("export `{}`: {} has type `{}`, which needs `layout(c)` to cross the boundary", .{fname, what, self.c.structs[d].name}))
                return 3
            }
            let ftys = self.c.struct_field_types(t)
            let dm = self.c.structs[d].module
            for f, i in self.c.structs[d].fields.clone() {
                if self.scalar_c(ftys[i]).len == 0 {
                    self.errors.append(format("export `{}`: field `{}` of `{}` is not a scalar", .{fname, self.c.node(dm, f).name, self.c.structs[d].name}))
                    return 3
                }
            }
            elem_c.*= self.cty(t)
            return 2
        }
        let tn = self.type_name_pretty(t)
        self.errors.append(format("export `{}`: {} has type `{}`, which has no C representation (use scalars, slices of scalars, or `layout(c)` structs)", .{fname, what, tn}))
        return 3
    }

    /// The scalar record of an exportable scalar type.
    fn scalar_of(self: *mut Self, t0: usize) -> Scalar {
        let t = self.res(t0)
        let k = self.c.tys.kind(t)
        if k == check.TK.Distinct { return self.scalar_of(self.c.distinct_underlying(self.c.tys.list[t].def)) }
        var kind: u8 = 0
        var int_name = String.new()
        if k == check.TK.Int { int_name = self.c.tys.list[t].name.clone() }
        else if k == check.TK.Float { kind = if self.c.tys.list[t].name == "f32" { 1 } else { 2 } }
        else if k == check.TK.Bool { kind = 3 }
        else if k == check.TK.Char { kind = 4 }
        return Scalar{ .c = self.scalar_c(t0), .kind = kind, .int_name = int_name }
    }

    /// The boundary record of a parameter or return type whose kind is known.
    fn export_param(self: *mut Self, name: []u8, t0: usize, kind: u8, elem_c: []u8, mutable: bool) -> ExportParam {
        var ep = ExportParam{ .name = String.from(name), .kind = kind, .scalar = Scalar{ .c = String.new(), .kind = 0, .int_name = String.new() }, .elem_c = String.from(elem_c), .mutable = mutable, .c_name = String.new(), .fields = List(ExportField).new() }
        if kind == 0 { ep.scalar = self.scalar_of(t0) }
        else if kind == 1 {
            let t = self.res(t0)
            ep.scalar = self.scalar_of(self.c.tys.list[t].args[0])
        } else if kind == 2 {
            let t = self.res(t0)
            let d = self.c.tys.list[t].def
            let dm = self.c.structs[d].module
            let ftys = self.c.struct_field_types(t)
            ep.c_name = String.from(elem_c)
            for f, i in self.c.structs[d].fields.clone() {
                let fname = self.c.node(dm, f).name.clone()
                ep.fields.append(ExportField{ .name = fname.clone(), .c_name = format("{}_{}", .{sanitize_ident(fname[..]), i}), .scalar = self.scalar_of(ftys[i]) })
            }
        }
        return ep
    }

    fn export_wrapper(self: *mut Self, inst: usize) -> String {
        let fname = self.c.insts[inst].name.clone()
        let ps = self.c.insts[inst].params.clone()
        var params = List(String).new()
        var args = List(String).new()
        var info = ExportInfo{ .name = fname.clone(), .params = List(ExportParam).new(), .has_ret = false, .ret = self.export_param("", 0, 3, "", false), .status = false, .effects = String.new(), .doc = List(String).new() }
        args.append(String.from("&ctx"))
        for p in ps {
            let lname = self.c.insts[inst].locals[p].name.clone()
            let lt = self.c.insts[inst].locals[p].ty
            var elem_c = String.new()
            var mutable = false
            let kind = self.param_kind(lt, format("parameter `{}`", .{lname})[..], fname[..], &mut elem_c, &mut mutable)
            if kind == 3 { return String.new() }
            info.params.append(self.export_param(lname[..], lt, kind, elem_c[..], mutable))
            if kind == 0 {
                params.append(format("{} {}", .{self.scalar_c(lt), lname}))
                let cn = self.cty(lt)
                args.append(format("({})({})", .{cn, lname}))
            } else if kind == 1 {
                params.append(format("{}{}* {}", .{if mutable { "" } else { "const " }, elem_c, lname}))
                params.append(format("size_t {}_len", .{lname}))
                let cn = self.cty(lt)
                args.append(format("(({}){{ ({}*){}, {}_len }})", .{cn, elem_c, lname, lname}))
            } else {
                params.append(format("{} {}", .{elem_c, lname}))
                args.append(lname.clone())
            }
        }
        let ret_t = self.res(self.c.insts[inst].ret)
        let is_eu = self.c.tys.kind(ret_t) == check.TK.ErrUnion
        let payload = if is_eu { self.c.tys.list[ret_t].args[0] } else { ret_t }
        var ret_c = String.new()
        var has_ret = false
        if !self.is_void(payload) {
            var elem_c = String.new()
            var mutable = false
            let kind = self.param_kind(payload, "the return value", fname[..], &mut elem_c, &mut mutable)
            if kind == 3 { return String.new() }
            if kind == 1 {
                self.errors.append(format("export `{}`: returning a slice across the boundary is not allowed (its lifetime cannot be expressed); return through a caller-provided buffer", .{fname}))
                return String.new()
            }
            info.ret = self.export_param("", payload, kind, elem_c[..], mutable)
            info.has_ret = true
            ret_c = if kind == 0 { self.scalar_c(payload) } else { elem_c }
            has_ret = true
        }
        let status = is_eu or (self.c.insts[inst].effects & check.EFF_PANICS) != 0
        let effects = check.render_effects(self.c.insts[inst].effects)
        info.status = status
        info.effects = effects.clone()
        // the function's /// lines
        let fdef = self.c.insts[inst].def
        let fm = self.c.fns[fdef].node_module
        let fnode = self.c.fns[fdef].node
        let d = self.c.mods[fm].parsed.tree.nodes[fnode].doc
        if d != check.NONE and self.c.mods[fm].parsed.tree.doc_counts[d] > 0 {
            for line in self.c.mods[fm].parsed.tree.docs[d][..].lines() { info.doc.append(String.from(line)) }
        }
        self.exports.append(info)
        let target = self.fn_c_name(inst)
        var out = String.new()
        let panic_id = self.err_id("Panic")
        out.append(format("/* export: {}{} */\n", .{fname, if effects.len == 0 { String.new() } else { format(" ({})", .{effects}) }})[..])
        let joined = if params.len == 0 { String.from("void") } else { join_strings(&params, ", ") }
        if !status {
            let rc = if has_ret { ret_c.clone() } else { String.from("void") }
            out.append(format("NX_EXPORT {} {}({}) {{\n", .{rc, fname, joined})[..])
            out.append("  nx_ctx ctx = nx_default_ctx(0, NULL);\n")
            if has_ret {
                out.append(format("  return ({}){}({});\n", .{rc, target, join_strings(&args, ", ")})[..])
            } else {
                out.append(format("  {}({});\n", .{target, join_strings(&args, ", ")})[..])
            }
            out.append("}\n")
        } else {
            var all = List(String).new()
            for p in params { all.append(p.clone()) }
            if has_ret { all.append(format("{}* out", .{ret_c})) }
            let alljoined = if all.len == 0 { String.from("void") } else { join_strings(&all, ", ") }
            out.append(format("NX_EXPORT int32_t {}({}) {{\n", .{fname, alljoined})[..])
            // the call's context gets a tracker: a panic caught here releases what
            // the call acquired before the status goes back (see nx_export_leave)
            out.append("  nx_ctx ctx = nx_default_ctx(0, NULL);\n  nx_boundary _nxb; nx_boundary* prev = nx_tls_boundary; nx_tls_boundary = &_nxb;\n  nx_tracker _nxt; nx_export_enter(&ctx, &_nxb, &_nxt);\n")
            out.append(format("  if (setjmp(_nxb.jb)) {{ nx_export_leave(&ctx, &_nxb, &_nxt, true); nx_tls_boundary = prev; return {}; }}\n", .{panic_id})[..])
            if is_eu {
                let rcn = self.cty(ret_t)
                out.append(format("  {} r = {}({});\n  nx_export_leave(&ctx, &_nxb, &_nxt, false); nx_tls_boundary = prev;\n  if (r.err) return (int32_t)r.err;\n", .{rcn, target, join_strings(&args, ", ")})[..])
                if has_ret { out.append("  if (out) *out = r.val;\n") }
            } else if has_ret {
                let rcn = self.cty(ret_t)
                out.append(format("  {} r = {}({});\n  nx_export_leave(&ctx, &_nxb, &_nxt, false); nx_tls_boundary = prev;\n  if (out) *out = r;\n", .{rcn, target, join_strings(&args, ", ")})[..])
            } else {
                out.append(format("  {}({});\n  nx_export_leave(&ctx, &_nxb, &_nxt, false); nx_tls_boundary = prev;\n", .{target, join_strings(&args, ", ")})[..])
            }
            out.append("  return 0;\n}\n")
        }
        return out
    }

    // ----- for parallel ---------------------------------------------------------

    /// Locals a block uses that are declared outside of it, ascending.
    fn free_locals(self: *mut Self, b: usize) -> List(usize) {
        var used = List(usize).new()
        var declared = List(usize).new()
        self.walk_block(b, &mut used, &mut declared)
        var out = List(usize).new()
        for u in used { if !list_has_usize(&declared, u) and !list_has_usize(&out, u) { out.append(u) } }
        sort_usize(&mut out)
        return out
    }

    fn walk_block(self: *mut Self, b: usize, used: *mut List(usize), declared: *mut List(usize)) {
        for s in self.c.tir.nodes[b].kids.clone() { self.walk_stmt(s, used, declared) }
        let tail = self.c.tir.nodes[b].a
        if tail != NONE { self.walk_expr(tail, used, declared) }
    }

    fn walk_stmt(self: *mut Self, s: usize, used: *mut List(usize), declared: *mut List(usize)) {
        let k = self.c.tir.nodes[s].k
        let kids = self.c.tir.nodes[s].kids.clone()
        let a = self.c.tir.nodes[s].a
        if k == check.TKind.SLet {
            declared.append(a)
            if kids.len > 0 { self.walk_expr(kids[0], used, declared) }
        } else if k == check.TKind.SAssign {
            self.walk_expr(kids[0], used, declared)
            self.walk_expr(kids[1], used, declared)
        } else if k == check.TKind.SExpr or k == check.TKind.SReturn or k == check.TKind.SBreak {
            if kids.len > 0 { self.walk_expr(kids[0], used, declared) }
        } else if k == check.TKind.SDefer or k == check.TKind.SErrDefer {
            self.walk_stmt(kids[0], used, declared)
        } else if k == check.TKind.SWhile {
            self.walk_expr(kids[0], used, declared)
            self.walk_block(kids[1], used, declared)
            if kids.len > 2 { self.walk_block(kids[2], used, declared) }
        } else if k == check.TKind.SForRange {
            declared.append(a)
            self.walk_expr(kids[0], used, declared)
            self.walk_expr(kids[1], used, declared)
            if self.c.tir.nodes[s].flag { self.walk_expr(kids[2], used, declared) }
            self.walk_block(kids[kids.len - 1], used, declared)
        } else if k == check.TKind.SForSlice {
            let locals = self.c.tir.nodes[s].kids2.clone()
            for l, i in locals {
                declared.append(l)
                self.walk_expr(kids[i], used, declared)
            }
            if a != NONE { declared.append(a) }
            self.walk_block(kids[kids.len - 1], used, declared)
        } else if k == check.TKind.SBlock or k == check.TKind.SUsing {
            self.walk_block(kids[0], used, declared)
        } else if k == check.TKind.SDrop {
            used.append(a)
        }
    }

    fn walk_pat(self: *mut Self, p: usize, declared: *mut List(usize)) {
        let k = self.c.tir.nodes[p].k
        let kids = self.c.tir.nodes[p].kids.clone()
        if k == check.TKind.PBind { declared.append(self.c.tir.nodes[p].a); return }
        if k == check.TKind.PVariant or k == check.TKind.POr or k == check.TKind.PTuple or k == check.TKind.PSome or k == check.TKind.POk {
            for q in kids { self.walk_pat(q, declared) }
            return
        }
        if k == check.TKind.PBinary {
            for seg in kids {
                let desc = self.c.tir.nodes[seg].name.clone()
                let words = check.split_words(desc[..])
                if words[0] == "bind" or words[0] == "rest" { declared.append(words[1][..].parse_int(usize) catch { NONE }) }
            }
        }
    }

    fn walk_expr(self: *mut Self, e: usize, used: *mut List(usize), declared: *mut List(usize)) {
        let k = self.c.tir.nodes[e].k
        let kids = self.c.tir.nodes[e].kids.clone()
        let a = self.c.tir.nodes[e].a
        if k == check.TKind.Local { used.append(a); return }
        if k == check.TKind.If {
            self.walk_expr(kids[0], used, declared)
            self.walk_block(kids[1], used, declared)
            if kids.len > 2 { self.walk_block(kids[2], used, declared) }
            return
        }
        if k == check.TKind.IfCapture {
            self.walk_expr(kids[0], used, declared)
            declared.append(a)
            self.walk_block(kids[1], used, declared)
            if kids.len > 2 { self.walk_block(kids[2], used, declared) }
            return
        }
        if k == check.TKind.Match {
            self.walk_expr(kids[0], used, declared)
            var i: usize = 1
            while i < kids.len {
                let akids = self.c.tir.nodes[kids[i]].kids.clone()
                self.walk_pat(akids[0], declared)
                var j: usize = 1
                while j < akids.len { self.walk_expr(akids[j], used, declared); j += 1 }
                i += 1
            }
            return
        }
        if k == check.TKind.BlockExpr { self.walk_block(kids[0], used, declared); return }
        if k == check.TKind.Catch {
            self.walk_expr(kids[0], used, declared)
            if a != NONE { declared.append(a) }
            self.walk_expr(kids[1], used, declared)
            return
        }
        if k == check.TKind.Closure {
            for l in self.c.tir.nodes[e].kids2.clone() { used.append(l) }
            return
        }
        if k == check.TKind.RecordCheck {
            self.walk_expr(kids[0], used, declared)
            let fields = self.c.tir.nodes[e].kids2.clone()
            var i: usize = 1
            while i < kids.len {
                declared.append(fields[(i - 1) * 2 + 1])
                self.walk_expr(kids[i], used, declared)
                i += 1
            }
            return
        }
        if k == check.TKind.BinConstruct {
            self.walk_expr(kids[kids.len - 1], used, declared)
            var i: usize = 0
            while i + 1 < kids.len {
                for sk in self.c.tir.nodes[kids[i]].kids.clone() { self.walk_expr(sk, used, declared) }
                i += 1
            }
            return
        }
        // every other kind: its expression children, in order
        for x in kids { self.walk_expr(x, used, declared) }
    }

    /// Lower a parallel slice loop: evaluate the slices, build the environment,
    /// emit the worker function, and dispatch through the runtime.
    fn parallel_for(self: *mut Self, s: usize) {
        let kids = self.c.tir.nodes[s].kids.clone()
        let index = self.c.tir.nodes[s].a
        let label = self.c.tir.nodes[s].b
        let locals = self.c.tir.nodes[s].kids2.clone()
        let body = kids[kids.len - 1]
        // slices are evaluated once in the parent
        var slices = List(String).new()
        var slice_tys = List(usize).new()
        for l, i in locals {
            let sc = self.expr(kids[i])
            let st = self.bind_tmp(sc[..], self.c.tir.nodes[kids[i]].ty)
            slices.append(st)
            slice_tys.append(self.c.tir.nodes[kids[i]].ty)
        }
        let first = slices[0].clone()
        let loc = self.node_loc(s)
        for sl, i in slices {
            if i == 0 { continue }
            self.line(format("if ({}.len != {}.len) nx_panic(\"parallel iteration over slices of different lengths\", {});", .{sl, first, loc})[..])
        }
        // free locals of the body become pointers in the environment
        var free = List(usize).new()
        for l in self.free_locals(body) {
            if list_has_usize(&locals, l) or l == index { continue }
            free.append(l)
        }
        let n = self.tmp()
        let env_ty = format("nx_parenv_{}", .{n})
        let fn_name = format("nx_par_{}", .{n})
        var fields = String.new()
        for ty, k in slice_tys {
            let cn = self.cty(ty)
            fields.append(format(" {} s{};", .{cn, k})[..])
        }
        for l in free {
            let cn = self.cty(self.cur.local_tys[l])
            fields.append(format(" {}* l{};", .{cn, l})[..])
        }
        self.types_out.append(format("typedef struct {} {{{} char _pad; }} {};\n", .{env_ty, fields, env_ty})[..])
        let env = self.tmp()
        var inits = List(String).new()
        for sl, k in slices { inits.append(format(".s{} = {}", .{k, sl})) }
        for l in free {
            let name = self.local_name(l)
            inits.append(format(".l{} = &({})", .{l, name}))
        }
        self.line(format("{} {} = {{ {} }};", .{env_ty, env, join_strings(&inits, ", ")})[..])
        self.line(format("nx_parallel_for(c, {}.len, {}, &{}, {});", .{first, fn_name, env, loc})[..])

        // emit the worker function with its own state, mapping free locals through the environment
        var saved = empty_fn_state()
        saved.inst = self.cur.inst
        saved.locals = self.cur.locals.clone()
        saved.local_tys = self.cur.local_tys.clone()
        saved.ret = self.cur.ret
        saved.is_test = self.cur.is_test
        saved.loop_labels = self.cur.loop_labels.clone()
        saved.loop_depths = self.cur.loop_depths.clone()
        saved.block_labels = self.cur.block_labels.clone()
        saved.block_brks = self.cur.block_brks.clone()
        saved.block_outs = self.cur.block_outs.clone()
        var saved_scopes = List(Scope).new()
        while self.cur.scopes.len > 0 {
            let sc = self.cur.scopes.pop() orelse break
            saved_scopes.append(sc)
        }
        var saved_body = List(String).new()
        while self.body.len > 0 {
            let b = self.body.pop() orelse break
            saved_body.append(b)
        }
        let saved_tmp = self.tmp
        var worker = empty_fn_state()
        worker.inst = saved.inst
        worker.locals = saved.locals.clone()
        for l in free { worker.locals[l] = format("(*_penv->l{})", .{l}) }
        worker.local_tys = saved.local_tys.clone()
        worker.ret = saved.ret
        self.cur = worker
        self.body = List(String).new()
        self.body.append(String.new())
        self.line(format("{}* _penv = ({}*)_pv; NX_UNUSED(_penv);", .{env_ty, env_ty})[..])
        let idx = if index != NONE { self.local_name(index) } else { self.tmp() }
        self.cur.loop_labels.append(label)
        self.cur.loop_depths.append(0)
        self.line(format("for (size_t {} = _b; {} < _e; {}++) {{", .{idx, idx, idx})[..])
        self.push_buf()
        for l, k in locals {
            let name = self.local_name(l)
            let cn = self.cty(self.cur.local_tys[l])
            self.line(format("{} {} = _penv->s{}.ptr[{}];", .{cn, name, k, idx})[..])
        }
        self.push_scope(true)
        self.block_stmt(body)
        self.pop_scope_emit()
        self.splice_buf()
        self.line(format("  nx_cont_{}: ;", .{label})[..])
        self.line("}")
        let code = self.pop_buf()
        self.protos_out.append(format("static void {}(nx_ctx* c, void* _pv, size_t _b, size_t _e);\n", .{fn_name})[..])
        self.funcs_out.append(format("static void {}(nx_ctx* c, void* _pv, size_t _b, size_t _e) {{\n  NX_UNUSED(c);\n{}}}\n\n", .{fn_name, code})[..])
        // restore the parent
        self.cur = saved
        while saved_scopes.len > 0 {
            let sc = saved_scopes.pop() orelse break
            self.cur.scopes.append(sc)
        }
        self.body = List(String).new()
        while saved_body.len > 0 {
            let b = saved_body.pop() orelse break
            self.body.append(b)
        }
        if saved_tmp > self.tmp { self.tmp = saved_tmp }
    }

    // ----- binary patterns ---------------------------------------------------

    fn bytes_of(self: *mut Self, s: []u8, ty: usize) -> String {
        let k = self.kind(ty)
        if k == check.TK.Str { return format("nx_str_slice({})", .{s}) }
        if k == check.TK.Array { return format("nx_lit((const char*){}.v, {})", .{s, self.c.tys.list[self.res(ty)].n}) }
        return String.from(s)
    }

    /// A segment's description, decoded: kind ("value"/"bind"/"rest"), the bound
    /// local, the size ("bits N" / "expr" / "rest"), endian, signed, float, utf8.
    fn seg_info(self: *mut Self, seg: usize, kind: *mut String, local: *mut usize, size: *mut String, bits: *mut u64, endian: *mut String, signed: *mut bool, float: *mut bool, utf8: *mut bool) {
        let desc = self.c.tir.nodes[seg].name.clone()
        let words = check.split_words(desc[..])
        kind.*= words[0].clone()
        var wi: usize = 1
        local.*= NONE
        if words[0] == "bind" or words[0] == "rest" { local.*= words[1][..].parse_int(usize) catch { NONE }; wi = 2 }
        let sw = words[wi].clone()
        if sw == "size=expr" { size.*= String.from("expr"); wi += 1 }
        else if sw == "size=rest" { size.*= String.from("rest"); wi += 1 }
        else { size.*= String.from("bits"); bits.*= words[wi + 1][..].parse_int(u64) catch { 0 }; wi += 2 }
        endian.*= String.from(words[wi][7..])
        signed.*= words[wi + 1] == "signed=true"
        float.*= words[wi + 2] == "float=true"
        utf8.*= words[wi + 3] == "utf8=true"
    }

    /// The size expression node of a segment, or NONE.
    fn seg_size_expr(self: *mut Self, seg: usize, kind: []u8, size: []u8) -> usize {
        if size != "expr" { return NONE }
        let skids = self.c.tir.nodes[seg].kids.clone()
        return skids[skids.len - 1]
    }

    fn seg_value_expr(self: *mut Self, seg: usize) -> usize { return self.c.tir.nodes[seg].kids[0] }

    fn bits_read_expr(self: *mut Self, buf: []u8, bit: []u8, sz: []u8, endian: []u8, float: bool, signed: bool, is_32: bool) -> String {
        var raw = format("nx_bits_read({}.ptr, {}, {})", .{buf, bit, sz})
        if endian == "little" { raw = format("nx_bswap({}, {} / 8)", .{raw, sz}) }
        else if endian == "native" { raw = format("(nx_is_little_endian() ? nx_bswap({}, {} / 8) : {})", .{raw, sz, raw}) }
        if float {
            if is_32 { return format("({{ uint32_t _b = (uint32_t){}; float _f; memcpy(&_f, &_b, 4); _f; }})", .{raw}) }
            return format("({{ uint64_t _b = (uint64_t){}; double _f; memcpy(&_f, &_b, 8); _f; }})", .{raw})
        }
        if signed { return format("nx_sign_extend({}, {})", .{raw, sz}) }
        return raw
    }

    /// Binary pattern test: computes into a temporary flag; bindings are recomputed in bind.
    fn bin_pattern_test(self: *mut Self, segs: []usize, s: []u8, ty: usize) -> String {
        let buf = self.bytes_of(s, ty)
        let flag = self.tmp()
        self.line(format("bool {} = false;", .{flag})[..])
        self.line("do {")
        self.push_buf()
        let bit = self.tmp()
        self.line(format("size_t {} = 0; NX_UNUSED({});", .{bit, bit})[..])
        let total = format("({}.len * 8)", .{buf})
        // static total size when all segments are constant
        var const_bits: u64 = 0
        var all_const = true
        var any_rest = false
        for seg in segs {
            var kind = String.new()
            var local = NONE
            var size = String.new()
            var bits: u64 = 0
            var endian = String.new()
            var signed = false
            var float = false
            var utf8 = false
            self.seg_info(seg, &mut kind, &mut local, &mut size, &mut bits, &mut endian, &mut signed, &mut float, &mut utf8)
            if size != "bits" { all_const = false } else { const_bits += bits }
            if size == "rest" { any_rest = true }
        }
        if all_const { self.line(format("if ({} != {}) break;", .{total, const_bits})[..]) }
        for seg in segs {
            var kind = String.new()
            var local = NONE
            var size = String.new()
            var bits: u64 = 0
            var endian = String.new()
            var signed = false
            var float = false
            var utf8 = false
            self.seg_info(seg, &mut kind, &mut local, &mut size, &mut bits, &mut endian, &mut signed, &mut float, &mut utf8)
            var size_c = String.new()
            if size == "bits" { size_c = format("{}", .{bits}) }
            else if size == "expr" {
                // size expressions may use earlier bindings: bind them progressively
                let v = self.expr(self.seg_size_expr(seg, kind[..], size[..]))
                size_c = format("((size_t)({}))", .{v})
            } else { size_c = format("({} - {})", .{total, bit}) }
            let sz = self.tmp()
            self.line(format("size_t {} = {};", .{sz, size_c})[..])
            if !all_const { self.line(format("if ({} + {} > {}) break;", .{bit, sz, total})[..]) }
            let sty = self.c.tir.nodes[seg].ty
            let is_bytes = self.kind(sty) == check.TK.Slice or size == "rest"
            if kind == "bind" or kind == "rest" {
                let name = self.local_name(local)
                if is_bytes {
                    self.line(format("if (({} & 7) || ({} & 7)) break;", .{bit, sz})[..])
                    self.line(format("nx_sl_u8 {} = {{ nx_padd({}.ptr, {} / 8), {} / 8 }};", .{name, buf, bit, sz})[..])
                    if utf8 { self.line(format("if (!nx_utf8_valid({})) break;", .{name})[..]) }
                } else {
                    let cn = self.cty(sty)
                    let read = self.bits_read_expr(buf[..], bit[..], sz[..], endian[..], float, signed, size == "bits" and bits == 32)
                    self.line(format("{} {} = {};", .{cn, name, read})[..])
                }
            } else {
                let v = self.seg_value_expr(seg)
                if is_bytes {
                    let vc = self.simple(v)
                    self.line(format("if (({} & 7) || {} != {}.len * 8) break;", .{bit, sz, vc})[..])
                    self.line(format("if (memcmp(nx_padd({}.ptr, {} / 8), {}.ptr, {}.len) != 0) break;", .{buf, bit, vc, vc})[..])
                } else {
                    let cn = self.cty(sty)
                    let read = self.bits_read_expr(buf[..], bit[..], sz[..], endian[..], float, signed, size == "bits" and bits == 32)
                    let vc = self.expr(v)
                    self.line(format("if ((({})({})) != (({})({}))) break;", .{cn, read, cn, vc})[..])
                }
            }
            self.line(format("{} += {};", .{bit, sz})[..])
        }
        if !all_const and !any_rest { self.line(format("if ({} != {}) break;", .{bit, total})[..]) }
        self.line(format("{} = true;", .{flag})[..])
        self.splice_buf()
        self.line("} while (0);")
        return flag
    }

    fn bin_pattern_bind(self: *mut Self, segs: []usize, s: []u8, ty: usize) {
        // bindings were declared inside the test's do-block; redo them in this scope
        let buf = self.bytes_of(s, ty)
        let bit = self.tmp()
        self.line(format("size_t {} = 0; NX_UNUSED({});", .{bit, bit})[..])
        let total = format("({}.len * 8)", .{buf})
        for seg in segs {
            var kind = String.new()
            var local = NONE
            var size = String.new()
            var bits: u64 = 0
            var endian = String.new()
            var signed = false
            var float = false
            var utf8 = false
            self.seg_info(seg, &mut kind, &mut local, &mut size, &mut bits, &mut endian, &mut signed, &mut float, &mut utf8)
            var size_c = String.new()
            if size == "bits" { size_c = format("{}", .{bits}) }
            else if size == "expr" {
                let v = self.expr(self.seg_size_expr(seg, kind[..], size[..]))
                size_c = format("((size_t)({}))", .{v})
            } else { size_c = format("({} - {})", .{total, bit}) }
            let sz = self.tmp()
            self.line(format("size_t {} = {};", .{sz, size_c})[..])
            let sty = self.c.tir.nodes[seg].ty
            let is_bytes = self.kind(sty) == check.TK.Slice or size == "rest"
            if kind == "bind" or kind == "rest" {
                let name = self.local_name(local)
                if is_bytes {
                    self.line(format("nx_sl_u8 {} = {{ nx_padd({}.ptr, {} / 8), {} / 8 }};", .{name, buf, bit, sz})[..])
                } else {
                    let cn = self.cty(sty)
                    let read = self.bits_read_expr(buf[..], bit[..], sz[..], endian[..], float, signed, size == "bits" and bits == 32)
                    self.line(format("{} {} = {};", .{cn, name, read})[..])
                }
            }
            self.line(format("{} += {};", .{bit, sz})[..])
        }
    }

    fn bin_construct(self: *mut Self, e: usize) -> String {
        let kids = self.c.tir.nodes[e].kids.clone()
        let target = kids[kids.len - 1]
        let buf = self.simple(target)
        let cn = self.cty(self.c.tir.nodes[e].ty)
        let out = self.tmp()
        self.line(format("{} {};", .{cn, out})[..])
        self.line("{")
        self.push_buf()
        let bit = self.tmp()
        self.line(format("size_t {} = 0;", .{bit})[..])
        let total = format("({}.len * 8)", .{buf})
        let fail = self.err_id("BufferTooSmall")
        self.line(format("{}.err = 0;", .{out})[..])
        self.line("do {")
        self.push_buf()
        var i: usize = 0
        while i + 1 < kids.len {
            let seg = kids[i]
            i += 1
            var kind = String.new()
            var local = NONE
            var size = String.new()
            var bits: u64 = 0
            var endian = String.new()
            var signed = false
            var float = false
            var utf8 = false
            self.seg_info(seg, &mut kind, &mut local, &mut size, &mut bits, &mut endian, &mut signed, &mut float, &mut utf8)
            let sty = self.c.tir.nodes[seg].ty
            let is_bytes = self.kind(sty) == check.TK.Slice or size == "rest"
            let v = if kind == "value" { self.simple(self.seg_value_expr(seg)) } else { String.from("0") }
            var size_c = String.new()
            if size == "bits" { size_c = format("{}", .{bits}) }
            else if size == "expr" {
                let sv = self.expr(self.seg_size_expr(seg, kind[..], size[..]))
                size_c = format("((size_t)({}))", .{sv})
            } else { size_c = format("({}.len * 8)", .{v}) }
            let sz = self.tmp()
            self.line(format("size_t {} = {};", .{sz, size_c})[..])
            self.line(format("if ({} + {} > {}) {{ {}.err = {}u; break; }}", .{bit, sz, total, out, fail})[..])
            if is_bytes {
                self.line(format("if (({} & 7) || {} > {}.len * 8) {{ {}.err = {}u; break; }}", .{bit, sz, v, out, fail})[..])
                self.line(format("memcpy(nx_padd({}.ptr, {} / 8), {}.ptr, {} / 8);", .{buf, bit, v, sz})[..])
            } else {
                var raw = String.new()
                if float {
                    if size == "bits" and bits == 32 { raw = format("({{ float _f = (float)({}); uint32_t _b; memcpy(&_b, &_f, 4); (uint64_t)_b; }})", .{v}) }
                    else { raw = format("({{ double _f = (double)({}); uint64_t _b; memcpy(&_b, &_f, 8); _b; }})", .{v}) }
                } else {
                    raw = format("(uint64_t)({})", .{v})
                }
                if endian == "little" { raw = format("nx_bswap({}, {} / 8)", .{raw, sz}) }
                else if endian == "native" { raw = format("(nx_is_little_endian() ? nx_bswap({}, {} / 8) : {})", .{raw, sz, raw}) }
                self.line(format("nx_bits_write({}.ptr, {}, {}, {});", .{buf, bit, sz, raw})[..])
            }
            self.line(format("{} += {};", .{bit, sz})[..])
        }
        self.line(format("{}.val = (nx_sl_u8){{ {}.ptr, {} / 8 }};", .{out, buf, bit})[..])
        self.splice_buf()
        self.line("} while (0);")
        self.splice_buf()
        self.line("}")
        return out
    }

    // ----- entry -----------------------------------------------------------------

    fn main_wrapper(self: *mut Self) -> String {
        let main = self.c.main_inst
        if main == NONE {
            self.errors.append(String.from("no `main` function found; add `fn main() { ... }` or declare a library artifact"))
            return String.new()
        }
        let target = self.fn_c_name(main)
        let ret_t = self.res(self.c.insts[main].ret)
        var out = String.new()
        out.append(self.entry_head()[..])
        out.append("  nx_console_utf8();\n  nx_ctx ctx = nx_default_ctx(argc, argv);\n  nx_ctx_track_self(&ctx);\n  nx_boundary b; b.track = NULL; nx_tls_boundary = &b;\n  if (setjmp(b.jb)) { fflush(stdout); fprintf(stderr, \"panic: %s\\n  at %s\\n\", b.msg, b.loc); return 101; }\n")
        if self.c.insts[main].params.len > 0 { self.errors.append(String.from("`main` takes no parameters; read arguments with `os.args()`")) }
        let rk = self.c.tys.kind(ret_t)
        if rk == check.TK.Void {
            out.append(format("  {}(&ctx);\n  fflush(stdout);\n  nx_ctx_release(&ctx);\n  nx_leak_report(&ctx);\n  return 0;\n", .{target})[..])
        } else if rk == check.TK.ErrUnion {
            let rcn = self.cty(ret_t)
            out.append(format("  {} r = {}(&ctx);\n  fflush(stdout);\n  nx_ctx_release(&ctx);\n  nx_leak_report(&ctx);\n  if (r.err) {{ fprintf(stderr, \"error: %s\\n\", nx_error_name(r.err)); return 1; }}\n", .{rcn, target})[..])
            if self.kind(self.c.tys.list[ret_t].args[0]) == check.TK.Int { out.append("  return (int)r.val;\n") } else { out.append("  return 0;\n") }
        } else if rk == check.TK.Int {
            out.append(format("  int code = (int){}(&ctx);\n  fflush(stdout);\n  nx_ctx_release(&ctx);\n  nx_leak_report(&ctx);\n  return code;\n", .{target})[..])
        } else {
            self.errors.append(String.from("`main` must return `void`, `!void`, or an integer exit code"))
        }
        out.append("}\n")
        self.entry_tail(&mut out)
        return out
    }

    /// The opening line of the C entry point: `main` itself, or the body that
    /// `main` runs on a thread with the declared stack (see `entry_tail`).
    fn entry_head(self: *mut Self) -> String {
        if self.stack_bytes > 0 { return String.from("static int nx_main_body(int argc, char** argv) {\n") }
        return String.from("int main(int argc, char** argv) {\n")
    }

    /// With `artifact cli { stack = ... }`: the real `main`, which runs the
    /// body on a thread reserving that much stack (`nx_run_on_stack`).
    fn entry_tail(self: *mut Self, out: *mut String) {
        if self.stack_bytes == 0 { return }
        out.append("typedef struct nx_main_call { int argc; char** argv; int code; } nx_main_call;\nstatic void nx_main_trampoline(void* p) { nx_main_call* c = (nx_main_call*)p; c->code = nx_main_body(c->argc, c->argv); }\n")
        out.append(format("int main(int argc, char** argv) {{ nx_main_call c; c.argc = argc; c.argv = argv; c.code = 0; nx_run_on_stack({}ULL, nx_main_trampoline, &c); return c.code; }}\n", .{self.stack_bytes})[..])
    }

    fn test_runner(self: *mut Self) -> String {
        var out = String.new()
        out.append(self.entry_head()[..])
        out.append("  nx_console_utf8();\n  nx_ctx ctx = nx_default_ctx(argc, argv);\n  const char* filter = NULL; int verbose = 0;\n  for (int ai = 1; ai < argc; ai++) { if (strcmp(argv[ai], \"--verbose\") == 0) verbose = 1; else filter = argv[ai]; }\n  int passed = 0, failed = 0, skipped = 0;\n  nx_boundary b; b.track = NULL; uint64_t t0 = 0;\n")
        for t in self.c.tests.clone() {
            let full = self.c.insts[t].name.clone()
            let name = full[5..]
            let target = self.fn_c_name(t)
            let rcn = self.cty(self.c.insts[t].ret)
            let esc = c_escape_bytes(name)
            out.append(format("  if (!filter || strstr({}, filter)) {{\n    nx_tls_boundary = &b; t0 = nx_time_monotonic_ns();\n    if (setjmp(b.jb)) {{ failed++; printf(\"FAIL  %s\\n      panic: %s\\n      at %s\\n\", {}, b.msg, b.loc); }}\n    else {{ {} r = {}(&ctx); if (r.err) {{ failed++; printf(\"FAIL  %s\\n      error: %s\\n\", {}, nx_error_name(r.err)); }} else {{ passed++; if (verbose) printf(\"ok    %s  (%.1f ms)\\n\", {}, (double)(nx_time_monotonic_ns() - t0) / 1e6); else printf(\"ok    %s\\n\", {}); }} }}\n    nx_tls_boundary = NULL;\n  }} else {{ skipped++; if (verbose) printf(\"skip  %s\\n\", {}); }}\n", .{esc, esc, rcn, target, esc, esc, esc, esc})[..])
        }
        out.append("  printf(\"\\n%d passed, %d failed%s\\n\", passed, failed, skipped ? \" (some skipped by filter)\" : \"\");\n  return failed ? 1 : 0;\n}\n")
        self.entry_tail(&mut out)
        return out
    }

    /// The whole translation unit.
    fn generate(self: *mut Self) -> String {
        // error names
        var names = String.from("static const char* const nx_error_names[] = { \"(ok)\"")
        for n in self.c.error_names { names.append(format(", \"{}\"", .{n})[..]) }
        names.append(" };\nNX_INLINE const char* nx_error_name(uint32_t e) { return e <= sizeof(nx_error_names)/sizeof(*nx_error_names) - 1 ? nx_error_names[e] : \"(unknown error)\"; }\n")
        self.data_out.append(names[..])
        // consts and globals
        let nc = self.c.consts.len
        for i in 0..nc {
            let ty = self.c.consts[i].ty
            let te = self.c.consts[i].value
            if ty == NONE or te == NONE { continue }
            if self.c.tir.nodes[te].k != check.TKind.Value { continue }
            let cn = self.cty(ty)
            let v = self.c.value_of_node(te)
            let init = self.static_init(&v, ty)
            if init.len > 0 { self.data_out.append(format("static const {} {} = {};\n", .{cn, const_mangled(self.c, i), init})[..]) }
        }
        let ng = self.c.globals.len
        for i in 0..ng {
            let ty = self.c.globals[i].ty
            if ty == NONE { continue }
            let cn = self.cty(ty)
            var init = String.new()
            let ge = self.c.globals[i].init
            if ge != NONE and self.c.tir.nodes[ge].k == check.TKind.Value {
                let v = self.c.value_of_node(ge)
                init = self.static_init(&v, ty)
            }
            let mangled = global_mangled(self.c, i)
            if init.len > 0 { self.data_out.append(format("static {} {} = {};\n", .{cn, mangled, init})[..]) }
            else { self.data_out.append(format("static {} {};\n", .{cn, mangled})[..]) }
        }
        // prototypes for all functions with bodies (and externs)
        let n = self.c.insts.len
        for i in 0..n {
            if self.c.insts[i].body == NONE and !self.c.insts[i].is_extern { continue }
            if self.is_cimport_fn(i) { continue } // declared by the included header
            let sig = self.fn_signature(i, false)
            self.protos_out.append(format("{};\n", .{sig})[..])
        }
        // bodies
        for i in 0..n {
            if self.c.insts[i].body != NONE { self.emit_function(i) }
        }
        // exports and entry
        var tail = String.new()
        for i in 0..n {
            if self.c.insts[i].export_name != "-" { tail.append(self.export_wrapper(i)[..]) }
        }
        if self.entry == ENTRY_MAIN { tail.append(self.main_wrapper()[..]) }
        else if self.entry == ENTRY_TESTS { tail.append(self.test_runner()[..]) }
        var out = String.new()
        out.append("/* generated by nx */\n")
        let mode_name = if self.mode == MODE_DEBUG { "DEBUG" } else if self.mode == MODE_SAFE { "SAFE" } else if self.mode == MODE_FAST { "FAST" } else { "SMALL" }
        out.append(format("#define NX_MODE_{}\n", .{mode_name})[..])
        out.append(RUNTIME_H)
        out.append("\n/* ---- imported C headers ---- */\n")
        for h, i in self.c.cimport_headers {
            if self.c.cimport_system[i] { out.append(format("#include <{}>\n", .{h})[..]) } else { out.append(format("#include \"{}\"\n", .{h})[..]) }
        }
        out.append("\n/* ---- forward declarations ---- */\n")
        out.append(self.fwd_out[..])
        out.append("\n/* ---- types ---- */\n")
        self.define_forwarded()
        var seen = Map(String, bool).new()
        let type_lines = self.types_out[..].lines()
        for line, li in type_lines {
            // a trailing newline yields an empty last line here, not in the oracle
            if li + 1 == type_lines.len and line.len == 0 { break }
            if seen.contains(line[..]) { continue }
            seen.put(String.from(line), true)
            out.append(line[..])
            out.append("\n")
        }
        out.append("\n/* ---- data ---- */\n")
        out.append(self.data_out[..])
        out.append("\n/* ---- prototypes ---- */\n")
        out.append(self.protos_out[..])
        out.append("\n/* ---- helpers ---- */\n")
        out.append(self.helpers_out[..])
        out.append("\n/* ---- functions ---- */\n")
        out.append(self.funcs_out[..])
        out.append("\n/* ---- entry ---- */\n")
        out.append(tail[..])
        // library-level helpers: error names and the last panic message
        var any_export = false
        for i in 0..n { if self.c.insts[i].export_name != "-" { any_export = true } }
        if any_export {
            let lib = sanitize_ident(self.lib_name[..])
            out.append(format("NX_EXPORT const char* {}_error_name(int32_t code) {{ return nx_error_name((uint32_t)code); }}\nNX_EXPORT const char* {}_last_panic(void) {{ return nx_tls_last_panic; }}\n", .{lib, lib})[..])
        }
        return out
    }
}

fn const_mangled(c: *check.Checker, id: usize) -> String { return format("nxc_{}_{}", .{c.consts[id].name, id}) }
fn global_mangled(c: *check.Checker, id: usize) -> String { return format("nxg_{}_{}", .{c.globals[id].name, id}) }

/// The file name without directories and extension.
fn stem_of(path: []u8) -> []u8 {
    var start: usize = 0
    var i = path.len
    while i > 0 {
        if path[i - 1] == '/' or path[i - 1] == '\\' { start = i; break }
        i -= 1
    }
    var end = path.len
    var j = path.len
    while j > start {
        if path[j - 1] == '.' { end = j - 1; break }
        j -= 1
    }
    return path[start..end]
}

fn join_strings(xs: *List(String), sep: []u8) -> String {
    var out = String.new()
    for x, i in xs {
        if i > 0 { out.append(sep) }
        out.append(x[..])
    }
    return out
}

fn list_has_usize(xs: *List(usize), x: usize) -> bool {
    for y in xs { if y == x { return true } }
    return false
}

fn sort_usize(xs: *mut List(usize)) {
    let n = xs.len
    var i: usize = 1
    while i < n {
        var j = i
        while j > 0 and xs[j - 1] > xs[j] {
            let t = xs[j - 1]
            xs[j - 1] = xs[j]
            xs[j] = t
            j -= 1
        }
        i += 1
    }
}

fn list_remove_usize(xs: *mut List(usize), x: usize) {
    var i: usize = 0
    while i < xs.len {
        if xs[i] == x { _ = xs.remove(i); return }
        i += 1
    }
}

fn main() -> !void {
    let args = os.args()
    if args.len < 2 {
        eprintln("usage: cgen <file.nx> [--std <dir>] [--cc <command>] [--tests]", .{})
        os.exit(2)
    }
    var std_dir: []u8 = "std"
    var cc_text = String.new()
    var entry = ENTRY_MAIN
    var i: usize = 2
    while i < args.len {
        if args[i] == "--std" and i + 1 < args.len { std_dir = args[i + 1]; i += 1 }
        else if args[i] == "--cc" and i + 1 < args.len { cc_text = String.from(args[i + 1]); i += 1 }
        else if args[i] == "--tests" { entry = ENTRY_TESTS }
        i += 1
    }
    if cc_text.len == 0 { if let v = os.env("NX_CC") { cc_text = String.from(v) } }
    var cc = List(String).new()
    if cc_text.len > 0 {
        for w in cc_text[..].split(" ") { if w.len > 0 { cc.append(String.from(w)) } }
    } else if let z = os.env("NX_ZIG") {
        cc.append(String.from(z))
        cc.append(String.from("cc"))
    } else {
        cc.append(String.from("zig"))
        cc.append(String.from("cc"))
    }
    let mods = try check.load(args[1], std_dir)
    var c = check.new_checker(mods)
    c.cc = cc
    c.collect()
    c.reserve_errors()
    c.check_program()
    if c.errors.len > 0 {
        for e in c.errors { eprintln("error: {}", .{e}) }
        os.exit(1)
    }
    if entry == ENTRY_MAIN and c.main_inst == NONE { entry = if c.tests.len > 0 { ENTRY_TESTS } else { ENTRY_LIBRARY } }
    var g = new_gen(&mut c, MODE_DEBUG, entry)
    g.lib_name = String.from(stem_of(args[1]))
    let out = g.generate()
    if g.errors.len > 0 {
        for e in g.errors { eprintln("error: {}", .{e}) }
        os.exit(1)
    }
    print("{}", .{out})
}
