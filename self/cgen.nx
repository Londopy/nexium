                ut = if bits == 8 { "uint8_t" } else if bits == 16 { "uint16_t" } else if bits == 32 { "uint32_t" } else if bits == 64 { "uint64_t" } else { "nx_u128" }
            }
            return format("(({})({})({}))", .{cn, ut, v})
        }
