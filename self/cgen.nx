            self.line(format("{} {}; {{ nx_i128 _v = 0; int _r = nx_parse_int({}, {}, {}, &_v); {}.err = _r == 0 ? 0 : (_r == 1 ? {}u : {}u); if (_r == 0) {}.val = ({})_v; }}", .{cn, t, av, lo, hi, t, inv, ovf, t, target})[..])
            return t
        }
        if name == "SliceParseFloat" {
