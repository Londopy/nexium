            let is_f32 = self.c.tys.kind(ft) == check.TK.Float and self.c.tys.list[ft].name == "f32"
            let f = if name == "MathSqrt" { "sqrt" } else if name == "MathFloor" { "floor" } else if name == "MathCeil" { "ceil" } else if name == "MathRound" { "round" }
            else if name == "MathSin" { "sin" } else if name == "MathCos" { "cos" } else if name == "MathTan" { "tan" } else if name == "MathExp" { "exp" }
            else if name == "MathLog" { "log" } else { "log2" }
            if is_f32 { return format("{}f({})", .{f, x}) }
            return format("{}({})", .{f, x})
