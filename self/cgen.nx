        }
        if name == "RefCount" {
            let v = self.simple(args[0])
            return format("(({})->rc)", .{v})
        }
        if name == "RefEq" {
            let av = self.simple(args[0])
            let bv = self.simple(args[1])
            return format("(({}) == ({}))", .{av, bv})
