            self.line(format("if ({}->len == {}->cap) nx_list_grow(c, (nx_rawlist*){}, sizeof({}), _Alignof({}), {}->len + 1);", .{lp, lp, lp, en, en, lp})[..])
            self.line(format("memmove({}->ptr + {} + 1, {}->ptr + {}, ({}->len - {}) * sizeof({}));", .{lp, i, lp, i, lp, i, en})[..])
