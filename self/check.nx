    NsFn{ .ns = "sync", .name = "unlock", .args = "i64", .ret = "void", .op = "MutexUnlock", .effects = EFF_SHARED_MUTABLE },
    NsFn{ .ns = "sync", .name = "mutex_free", .args = "i64", .ret = "void", .op = "MutexFree", .effects = EFF_SHARED_MUTABLE },
    NsFn{ .ns = "sync", .name = "signal", .args = "i64", .ret = "void", .op = "CondSignal", .effects = EFF_SHARED_MUTABLE },
    NsFn{ .ns = "sync", .name = "broadcast", .args = "i64", .ret = "void", .op = "CondBroadcast", .effects = EFF_SHARED_MUTABLE },
    NsFn{ .ns = "sync", .name = "cond_free", .args = "i64", .ret = "void", .op = "CondFree", .effects = EFF_SHARED_MUTABLE },
    NsFn{ .ns = "sync", .name = "wait", .args = "i64 i64", .ret = "void", .op = "CondWait", .effects = EFF_BLOCKS | EFF_SHARED_MUTABLE },
    NsFn{ .ns = "time", .name = "now", .args = "", .ret = "i64", .op = "TimeNow", .effects = EFF_NONDETERMINISTIC },
    NsFn{ .ns = "time", .name = "monotonic", .args = "", .ret = "u64", .op = "TimeMonotonic", .effects = EFF_NONDETERMINISTIC },
    NsFn{ .ns = "time", .name = "sleep", .args = "u64", .ret = "void", .op = "Sleep", .effects = EFF_BLOCKS },
    NsFn{ .ns = "time", .name = "utc_offset", .args = "i64", .ret = "i64", .op = "TimeUtcOffset", .effects = EFF_NONDETERMINISTIC },
    NsFn{ .ns = "random", .name = "int", .args = "i64 i64", .ret = "i64", .op = "RandomInt", .effects = EFF_NONDETERMINISTIC },
    NsFn{ .ns = "random", .name = "float", .args = "", .ret = "f64", .op = "RandomFloat", .effects = EFF_NONDETERMINISTIC },
    NsFn{ .ns = "random", .name = "seed", .args = "u64", .ret = "void", .op = "RandomSeed", .effects = 0 },
]

impl Checker {
    /// A type from a short code used by the namespace table.
    fn code_ty(self: *mut Self, code: []u8) -> usize {
        if code.len > 0 and code[0] == '!' {
            let inner = self.code_ty(code[1..])
            return self.tys.err_union(0, false, inner)
        }
        if code.len > 0 and code[0] == '?' {
            let inner = self.code_ty(code[1..])
            return self.tys.wrap(TK.Opt, inner, false)
        }
        if code.len > 2 and code[0..2] == "[]" {
            let inner = self.code_ty(code[2..])
            return self.tys.wrap(TK.Slice, inner, false)
        }
        if code.len > 5 and code[0..5] == "List(" {
            let inner = self.code_ty(code[5..code.len - 1])
            return self.tys.wrap(TK.List, inner, false)
        }
        if code == "bytes" { return self.tys.str_slice() }
        if code == "string" { return self.tys.string() }
        if code == "void" { return self.tys.void() }
        if code == "never" { return self.tys.never() }
        if code == "f64" { return self.tys.float64() }
        return self.tys.int(code)
    }

    fn split_words(codes: []u8) -> List(String) {
        var out = List(String).new()
        var cur = String.new()
        for c in codes {
            if c == ' ' {
                if cur.len > 0 { out.append(cur.clone()) }
                cur.clear()
            } else {
                cur.push_byte(c)
            }
        }
        if cur.len > 0 { out.append(cur) }
        return out
    }

    fn check_namespace_member(self: *mut Self, ns: []u8, name: []u8, start: usize, end: usize, expected: usize) -> usize {
        _ = expected
        let f64t = self.tys.float64()
        if ns == "math" {
            if name == "PI" { return self.float_node(3.141592653589793, f64t, start, end) }
            if name == "E" { return self.float_node(2.718281828459045, f64t, start, end) }
            if name == "TAU" { return self.float_node(6.283185307179586, f64t, start, end) }
            if name == "INF" { return self.float_node(1.0 / 0.0, f64t, start, end) }
            if name == "NAN" { return self.float_node(0.0 / 0.0, f64t, start, end) }
        }
        if ns.len > 7 and ns[0..7] == "module:" {
            let m = ns[7..].parse_int(usize) catch { 0 }
            let key = item_key(m, name)
            if let item = self.items.get(key[..]) {
                if item.kind == ItemKind.Fn and !self.node(m, self.fns[item.id].node).flag {
                    self.fail_here(start, format("function `{}` is private to its module", .{name})[..])
                }
                let saved = self.ctx().module
                self.ctx().module = m
                let te = self.check_ident(name, start, end)
                self.ctx().module = saved
                return te
            }
            if let why = self.cimport_unsupported.get(format("{}:{}", .{m, name})[..]) {
                self.fail_here(start, format("`{}` was imported from `{}` but cannot be used: {}", .{name, self.mods[m].name[8..], why})[..])
            } else {
                self.fail_here(start, format("module `{}` has no item `{}`", .{self.mods[m].name, name})[..])
            }
            return self.error_expr(start, end)
        }
        self.fail_here(start, format("`{}` has no member `{}`", .{ns, name})[..])
        return self.error_expr(start, end)
    }

    fn check_namespace_call(self: *mut Self, ns: []u8, name: []u8, args: []usize, expected: usize, start: usize, end: usize) -> usize {
        if ns.len > 7 and ns[0..7] == "module:" {
            let m = ns[7..].parse_int(usize) catch { 0 }
            let key = item_key(m, name)
            if let item = self.items.get(key[..]) {
                if item.kind == ItemKind.Fn {
                    if !self.node(m, self.fns[item.id].node).flag { self.fail_here(start, format("function `{}` is private to its module", .{name})[..]) }
                    return self.call_fn_def(item.id, NONE, args, expected, start, end)
                }
            }
            if let why = self.cimport_unsupported.get(format("{}:{}", .{m, name})[..]) {
                self.fail_here(start, format("`{}` was imported from `{}` but cannot be called: {}", .{name, self.mods[m].name[8..], why})[..])
            } else {
                self.fail_here(start, format("module `{}` has no function `{}`", .{self.mods[m].name, name})[..])
            }
            for a in args { _ = self.check_expr(a, NONE) }
            return self.error_expr(start, end)
        }
        if ns == "math" { return self.check_math_call(name, args, expected, start, end) }
        if ns == "mem" and name == "copy" {
            if args.len != 2 {
                self.fail_here(start, format("`mem.copy` takes 2 argument(s) but {} were given", .{args.len})[..])
                return self.error_expr(start, end)
            }
            let d = self.check_expr(args[0], NONE)
            let dt = self.tys.resolve(self.tir.nodes[d].ty, true)
            if self.tys.kind(dt) != TK.Slice {
                self.fail_here(start, "mem.copy takes a `[]mut T` destination")
                return self.error_expr(start, end)
            }
            let e = self.tys.list[dt].args[0]
            if !self.tys.list[dt].flag { self.fail_here(start, "mem.copy destination must be `[]mut T`") }
            let st = self.tys.wrap(TK.Slice, e, false)
            var s = self.check_expr(args[1], st)
            s = self.coerce_or_error(s, st, "source")
            self.add_effect(EFF_PANICS, start, "mem.copy panics when the source is longer than the destination")
            let v = self.tys.void()
            let b = self.builtin_node("SliceCopy", v, start, end)
            self.tir.nodes[b].kids.append(d)
            self.tir.nodes[b].kids.append(s)
            self.tir.nodes[b].kids2.append(e)
            return b
        }
        if ns == "thread" and name == "start" {
            if args.len != 2 {
                self.fail_here(start, format("`thread.start` takes 2 argument(s) but {} were given", .{args.len})[..])
                return self.error_expr(start, end)
            }
            let f = self.check_expr(args[0], NONE)
            let ft = self.tys.shallow(self.tir.nodes[f].ty)
            var param = NONE
            if self.tys.kind(ft) == TK.Fn and self.tys.list[ft].args.len == 2 {
                let p0 = self.tys.shallow(self.tys.list[ft].args[0])
                let r0 = self.tys.shallow(self.tys.list[ft].args[1])
                if self.tys.kind(p0) == TK.Ptr and self.tys.kind(r0) == TK.Void { param = self.tys.list[ft].args[0] }
            }
            if param == NONE {
                self.fail_here(start, "thread.start takes a function value `fn(*mut T) -> void` (a closure without captures or a named function)")
                return self.error_expr(start, end)
            }
            var p = self.check_expr(args[1], param)
            p = self.coerce_or_error(p, param, "argument")
            self.add_effect(EFF_NONDETERMINISTIC, start, "threads interleave")
            self.add_effect(EFF_SHARED_MUTABLE, start, "a thread shares memory with its spawner")
            let i64t = self.tys.int("i64")
            let b = self.builtin_node("ThreadStart", i64t, start, end)
            self.tir.nodes[b].kids.append(f)
            self.tir.nodes[b].kids.append(p)
            return b
        }
        let lookup_ns = if ns == "process" { "os" } else { ns }
        for f in NS_FNS {
            if f.ns != lookup_ns or f.name != name { continue }
            let codes = Checker.split_words(f.args)
            if args.len != codes.len {
                self.fail_here(start, format("`{}.{}` takes {} argument(s) but {} were given", .{ns, name, codes.len, args.len})[..])
                return self.error_expr(start, end)
            }
            let ret = self.code_ty(f.ret)
            let b = self.builtin_node(f.op, ret, start, end)
            for a, i in args {
                let pt = self.code_ty(codes[i][..])
                var te = self.check_expr(a, pt)
                te = self.coerce_or_error(te, pt, "argument")
                self.tir.nodes[b].kids.append(te)
            }
            if f.effects != 0 { self.add_effect(f.effects, start, "builtin") }
            return b
        }
        self.fail_here(start, format("`{}` has no function `{}`", .{ns, name})[..])
        for a in args { _ = self.check_expr(a, NONE) }
        return self.error_expr(start, end)
    }

    fn check_math_call(self: *mut Self, name: []u8, args: []usize, expected: usize, start: usize, end: usize) -> usize {
        var unary = ""
        if name == "sqrt" { unary = "MathSqrt" }
        if name == "abs" { unary = "MathAbs" }
        if name == "floor" { unary = "MathFloor" }
        if name == "ceil" { unary = "MathCeil" }
        if name == "round" { unary = "MathRound" }
        if name == "sin" { unary = "MathSin" }
        if name == "cos" { unary = "MathCos" }
        if name == "tan" { unary = "MathTan" }
        if name == "exp" { unary = "MathExp" }
        if name == "log" { unary = "MathLog" }
        if name == "log2" { unary = "MathLog2" }
        if unary.len > 0 {
            if args.len != 1 {
                self.fail_here(start, format("`math.{}` takes 1 argument(s) but {} were given", .{name, args.len})[..])
                return self.error_expr(start, end)
            }
            let x = self.check_expr(args[0], expected)
            let t = self.tys.resolve(self.tir.nodes[x].ty, true)
            if name == "abs" {
                if !self.tys.is_numeric(t) { self.fail_here(start, "math.abs takes a number") }
            } else if !self.tys.is_float(t) {
                self.fail_here(start, format("math.{} takes a float but found `{}`; convert with `as f64`", .{name, self.ty_name(t)})[..])
            }
            let b = self.builtin_node(unary, t, start, end)
            self.tir.nodes[b].kids.append(x)
            self.tir.nodes[b].kids2.append(t)
            return b
        }
        var binary = ""
        if name == "min" { binary = "MathMin" }
        if name == "max" { binary = "MathMax" }
        if name == "pow" { binary = "MathPow" }
        if name == "atan2" { binary = "MathAtan2" }
        if binary.len > 0 {
            if args.len != 2 {
                self.fail_here(start, format("`math.{}` takes 2 argument(s) but {} were given", .{name, args.len})[..])
                return self.error_expr(start, end)
            }
            let a = self.check_expr(args[0], expected)
            let at = self.tys.resolve(self.tir.nodes[a].ty, false)
            var bb = self.check_expr(args[1], at)
            bb = self.coerce_or_error(bb, at, "second operand")
            let t = self.tys.resolve(at, true)
            if !self.tys.is_numeric(t) { self.fail_here(start, format("math.{} takes numbers", .{name})[..]) }
            if (name == "pow" or name == "atan2") and !self.tys.is_float(t) { self.fail_here(start, format("math.{} takes floats", .{name})[..]) }
            let b = self.builtin_node(binary, t, start, end)
            self.tir.nodes[b].kids.append(a)
            self.tir.nodes[b].kids.append(bb)
            self.tir.nodes[b].kids2.append(t)
            return b
        }
        if name == "clamp" {
            if args.len != 3 {
                self.fail_here(start, format("`math.clamp` takes 3 argument(s) but {} were given", .{args.len})[..])
                return self.error_expr(start, end)
            }
            let a = self.check_expr(args[0], expected)
            let at = self.tys.resolve(self.tir.nodes[a].ty, false)
            var lo = self.check_expr(args[1], at)
            lo = self.coerce_or_error(lo, at, "lower bound")
            var hi = self.check_expr(args[2], at)
            hi = self.coerce_or_error(hi, at, "upper bound")
            let t = self.tys.resolve(at, true)
            let b = self.builtin_node("MathClamp", t, start, end)
            self.tir.nodes[b].kids.append(a)
            self.tir.nodes[b].kids.append(lo)
            self.tir.nodes[b].kids.append(hi)
            self.tir.nodes[b].kids2.append(t)
            return b
        }
        self.fail_here(start, format("`math` has no function `{}`", .{name})[..])
        return self.error_expr(start, end)
    }

    // ----- static members and calls ------------------------------------------------------------

    fn check_static_member(self: *mut Self, t0: usize, name: []u8, start: usize, end: usize, expected: usize) -> usize {
        _ = expected
        let t = self.tys.shallow(t0)
        let k = self.tys.kind(t)
        if k == TK.Enum {
            let d = self.tys.list[t].def
            let idx = self.enum_variant_index(d, name)
            if idx == NONE {
                self.fail_here(start, format("enum `{}` has no variant `{}`", .{self.enums[d].name, name})[..])
                return self.error_expr(start, end)
            }
            let em = self.enums[d].module
            if self.node(em, self.enums[d].variants[idx]).text != "unit" {
                self.fail_here(start, format("variant `{}.{}` carries a payload; construct it with `{}.{}(...)`", .{self.enums[d].name, name, self.enums[d].name, name})[..])
            }
            let r = self.mk(TKind.EnumLit, t, start, end)
            self.tir.nodes[r].a = idx
            return r
        }
        if k == TK.ErrorSet and self.tys.list[t].flag {
            let s = self.tys.list[t].def
            let id = self.error_id(name)
            if !self.error_set_has(s, name) {
                self.fail_here(start, format("error set `{}` has no member `{}`", .{self.error_sets[s].name, name})[..])
            }
            let r = self.mk(TKind.ErrVal, t, start, end)
            self.tir.nodes[r].a = id
            return r
        }
        if k == TK.Struct or k == TK.Distinct {
            let fid = self.find_inherent_method(t, name)
            if fid != NONE {
                if self.fns[fid].is_generic {
                    self.fail_here(start, format("`{}` is generic; call it directly", .{name})[..])
                    return self.error_expr(start, end)
                }
                if self.fn_takes_own(fid) {
                    self.fail_here(start, format("`{}` takes `own` parameters and cannot be used as a function value; call it directly", .{name})[..])
                    return self.error_expr(start, end)
                }
                let inst = self.instantiate(fid, List(usize).new())
                var ps = List(usize).new()
                for p in self.insts[inst].params { ps.append(self.insts[inst].locals[p].ty) }
                let r = self.insts[inst].ret
                let neg = self.insts[inst].declared_neg
                let ft = self.tys.func(ps, r, EFF_ALL & ~neg)
                let te = self.mk(TKind.FnToFat, ft, start, end)
                self.tir.nodes[te].a = inst
                return te
            }
            self.fail_here(start, format("`{}` has no associated item `{}`", .{self.ty_name(t), name})[..])
            return self.error_expr(start, end)
        }
        self.fail_here(start, format("`{}` has no member `{}`", .{self.ty_name(t), name})[..])
        return self.error_expr(start, end)
    }

    fn error_set_has(self: *mut Self, set: usize, name: []u8) -> bool {
        let m = self.error_sets[set].module
        // the set's names live on its declaration node
        let items = self.mods[m].parsed.items.clone()
        for it in items {
            let n = self.node(m, it)
            if n.k == parser.NodeKind.ErrorSet and n.name == self.error_sets[set].name {
                for w in n.words { if w == name { return true } }
                return false
            }
        }
        return false
    }

    /// Match an impl's target against a concrete type; the impl's type
    /// parameters bound in order, or null.
    fn match_impl_target(self: *mut Self, impl_id: usize, t0: usize) -> ?List(usize) {
        let t = self.tys.resolve(t0, true)
        let m = self.impls[impl_id].module
        let target = self.impls[impl_id].target
        let tps = self.impls[impl_id].tparams.clone()
        var names = List(String).new()
        var bound = List(usize).new()
        if !self.match_type_pattern(m, target, t, &tps, &mut names, &mut bound) { return null }
        var out = List(usize).new()
        for tp in tps {
            var b = NONE
            for nm, i in names { if nm == tp { b = bound[i] } }
            if b == NONE { return null }
            out.append(b)
        }
        return out
    }

    /// Match a type expression with parameters against a type, binding parameters.
    fn match_type_pattern(self: *mut Self, m: usize, pat: usize, t0: usize, params: *List(String), names: *mut List(String), bound: *mut List(usize)) -> bool {
        let t = self.tys.shallow(t0)
        let n = self.node(m, pat)
        let k = n.k
        let tk = self.tys.kind(t)
        if k == parser.NodeKind.TName and n.words.len == 1 {
            let name = n.words[0].clone()
            let args = n.kids.clone()
            if list_has(params, name[..]) and args.len == 0 {
                for nm, i in names { if nm == name { return bound[i] == t } }
                names.append(name.clone())
                bound.append(t)
                return true
            }
            if args.len > 0 {
                if name == "List" and tk == TK.List and args.len == 1 { return self.match_type_pattern(m, args[0], self.tys.list[t].args[0], params, names, bound) }
                if name == "Map" and tk == TK.Map and args.len == 2 {
                    return self.match_type_pattern(m, args[0], self.tys.list[t].args[0], params, names, bound) and self.match_type_pattern(m, args[1], self.tys.list[t].args[1], params, names, bound)
                }
                if tk == TK.Struct or tk == TK.Enum {
                    let d = self.tys.list[t].def
                    var same = false
                    if let r = self.lookup(m, name[..]) { same = (r.kind == ItemKind.Struct and tk == TK.Struct or r.kind == ItemKind.Enum and tk == TK.Enum) and r.id == d }
                    let targs = self.tys.list[t].args.clone()
                    if !same or targs.len != args.len { return false }
                    for a, i in args { if !self.match_type_pattern(m, a, targs[i], params, names, bound) { return false } }
                    return true
                }
                return false
            }
        }
        if k == parser.NodeKind.TSlice or k == parser.NodeKind.TPtr {
            let want = if k == parser.NodeKind.TSlice { TK.Slice } else { TK.Ptr }
            if tk != want or self.tys.list[t].flag != n.flag { return false }
            return self.match_type_pattern(m, n.x, self.tys.list[t].args[0], params, names, bound)
        }
        if k == parser.NodeKind.TOpt {
            if tk != TK.Opt { return false }
            return self.match_type_pattern(m, n.x, self.tys.list[t].args[0], params, names, bound)
        }
        if k == parser.NodeKind.TArray {
            if tk != TK.Array { return false }
            let want = self.const_eval_int(m, n.x) orelse return false
            if want != self.tys.list[t].n as i128 { return false }
            return self.match_type_pattern(m, n.y, self.tys.list[t].args[0], params, names, bound)
        }
        // a concrete type: resolve and compare
        let saved = self.errors.len
        let saved_env = self.env_save()
        self.env_set(&List(String).new(), &List(usize).new())
        let pt = self.resolve_type(m, pat, NONE)
        self.env_restore(&saved_env)
        while self.errors.len > saved { _ = self.errors.pop() }
        return self.tys.resolve(pt, true) == t
    }

    /// A method of an inherent impl first, then of a trait impl, for type `t`;
    /// a trait's default method is materialized as an impl method when first needed.
    fn find_inherent_method(self: *mut Self, t0: usize, name: []u8) -> usize {
        let t = self.tys.resolve(t0, true)
        let n = self.impls.len
        for pass in 0..2 {
            for i in 0..n {
                let has_trait = self.impls[i].has_trait
                if (pass == 0 and has_trait) or (pass == 1 and !has_trait) { continue }
                let methods = self.impls[i].methods.clone()
                let im = self.impls[i].module
                for fid in methods {
                    if self.node(self.fns[fid].node_module, self.fns[fid].node).name == name and self.match_impl_target(i, t) != null { return fid }
                }
            }
        }
        for i in 0..n {
            if !self.impls[i].has_trait { continue }
            if self.match_impl_target(i, t) == null { continue }
            let im = self.impls[i].module
            let tn = self.impls[i].trait_name.clone()
            let tr = self.lookup(im, tn[..]) orelse continue
            if tr.kind != ItemKind.Trait { continue }
            let tm = self.traits[tr.id].module
            let methods = self.traits[tr.id].methods.clone()
            for meth in methods {
                let mn = self.node(tm, meth)
                if mn.name == name and mn.y != NONE {
                    let generic = self.impls[i].tparams.len > 0 or self.fn_is_generic(tm, meth)
                    self.fns.append(FnDef{ .node = meth, .node_module = tm, .module = im, .impl_id = i, .is_generic = generic, .is_test = false, .test_name = String.new(), .test_comptime = false })
                    let fid = self.fns.len - 1
                    self.impls[i].methods.append(fid)
                    return fid
                }
            }
        }
        return NONE
    }

    /// Build (or reuse) the vtable of `trait_id` for the concrete type `t`;
    /// NONE when `t` does not implement the trait.
    fn vtable_for(self: *mut Self, trait_id: usize, t0: usize, at: usize) -> usize {
        let t = self.tys.resolve(t0, true)
        for v, i in self.vtables { if v.trait_id == trait_id and v.ty == t { return i } }
        let tname = self.traits[trait_id].name.clone()
        let tm = self.traits[trait_id].module
        var has_impl = false
        let n = self.impls.len
        for i in 0..n {
            if self.impls[i].has_trait and self.impls[i].trait_name == tname and self.match_impl_target(i, t) != null { has_impl = true }
        }
        if !has_impl { return NONE }
        var insts = List(usize).new()
        let methods = self.traits[trait_id].methods.clone()
        for meth in methods {
            let mname = self.node(tm, meth).name.clone()
            let fid = self.find_inherent_method(t, mname[..])
            if fid == NONE {
                self.fail_here(at, format("`{}` implements `{}` but has no method `{}`", .{self.ty_name(t), tname, mname})[..])
                return NONE
            }
            if self.fns[fid].is_generic {
                self.fail_here(at, format("method `{}` is generic and cannot be called through `dyn {}`", .{mname, tname})[..])
                return NONE
            }
            // impl type params from the concrete type
            var targs = List(usize).new()
            let impl_id = self.fns[fid].impl_id
            if impl_id != NONE {
                if let b = self.match_impl_target(impl_id, t) { targs = b }
            }
            insts.append(self.instantiate(fid, targs))
        }
        self.vtables.append(VTable{ .trait_id = trait_id, .ty = t, .insts = insts })
        return self.vtables.len - 1
    }

    /// The signature of trait method `idx` seen through a trait object:
    /// parameter types after `self`, the return type, and whether the
    /// receiver is mutable. `Self` may only appear in receiver position.
    fn dyn_method_sig(self: *mut Self, trait_id: usize, idx: usize, at: usize, params: *mut List(usize), ret: *mut usize, mutable: *mut bool) -> bool {
        let tm = self.traits[trait_id].module
        let tname = self.traits[trait_id].name.clone()
        let meth = self.traits[trait_id].methods[idx]
        let mname = self.node(tm, meth).name.clone()
        let all = self.node(tm, meth).kids.clone()
        if all.len == 0 or self.node(tm, all[0]).name != "self" { return false }
        let st_node = self.node(tm, all[0]).x
        mutable.*= self.node(tm, st_node).k == parser.NodeKind.TPtr and self.node(tm, st_node).flag
        let placeholder = self.tys.named(TK.Type, "Self")
        for pn, i in all {
            if i == 0 { continue }
            if self.node(tm, pn).flag { continue }
            let t = self.resolve_type(tm, self.node(tm, pn).x, placeholder)
            if self.type_mentions(t, placeholder) {
                self.fail_here(at, format("method `{}` uses `Self` in a parameter and cannot be called through `dyn {}`", .{mname, tname})[..])
                return false
            }
            params.append(t)
        }
        let ret_node = self.node(tm, meth).x
        var r = self.tys.void()
        if ret_node != NONE { r = self.resolve_type(tm, ret_node, placeholder) }
        if self.type_mentions(r, placeholder) {
            self.fail_here(at, format("method `{}` returns `Self` and cannot be called through `dyn {}`", .{mname, tname})[..])
            return false
        }
        ret.*= r
        return true
    }

    fn type_mentions(self: *mut Self, t0: usize, needle: usize) -> bool {
        let t = self.tys.shallow(t0)
        if t == needle { return true }
        for a in self.tys.list[t].args.clone() { if self.type_mentions(a, needle) { return true } }
        return false
    }

    fn check_static_call(self: *mut Self, t0: usize, name: []u8, args: []usize, expected: usize, start: usize, end: usize) -> usize {
        let t = self.tys.shallow(t0)
        let k = self.tys.kind(t)
        let u = self.tys.usize_ty()
        let bytes = self.tys.str_slice()
        if k == TK.List {
            let e = self.tys.list[t].args[0]
            if name == "new" {
                if !self.args_n(args, 0, "List.new", start) { return self.error_expr(start, end) }
                let b = self.builtin_node("ListNew", t, start, end)
                self.tir.nodes[b].kids2.append(e)
                return b
            }
            if name == "with_capacity" {
                if !self.args_n(args, 1, "List.with_capacity", start) { return self.error_expr(start, end) }
                let n = self.arg(args[0], u, "capacity")
                self.add_effect(EFF_ALLOCATES, start, "reserving list capacity allocates")
                let b = self.builtin_node("ListWithCapacity", t, start, end)
                self.tir.nodes[b].kids.append(n)
                self.tir.nodes[b].kids2.append(e)
                return b
            }
            if name == "from" {
                if !self.args_n(args, 1, "List.from", start) { return self.error_expr(start, end) }
                let st = self.tys.wrap(TK.Slice, e, false)
                let s = self.arg(args[0], st, "source slice")
                self.add_effect(EFF_ALLOCATES, start, "copying into a List allocates")
                let b = self.builtin_node("ListFromSlice", t, start, end)
                self.tir.nodes[b].kids.append(s)
                self.tir.nodes[b].kids2.append(e)
                return b
            }
            self.fail_here(start, format("`List` has no associated function `{}`; available: new, with_capacity, from", .{name})[..])
            return self.error_expr(start, end)
        }
        if k == TK.Str {
            if name == "new" {
                if !self.args_n(args, 0, "String.new", start) { return self.error_expr(start, end) }
                return self.builtin_node("StringNew", t, start, end)
            }
            if name == "from" {
                if !self.args_n(args, 1, "String.from", start) { return self.error_expr(start, end) }
                let s = self.arg(args[0], bytes, "source")
                self.add_effect(EFF_ALLOCATES, start, "building a String allocates")
                let b = self.builtin_node("StringFrom", t, start, end)
                self.tir.nodes[b].kids.append(s)
                return b
            }
            if name == "with_capacity" {
                if !self.args_n(args, 1, "String.with_capacity", start) { return self.error_expr(start, end) }
                let n = self.arg(args[0], u, "capacity")
                self.add_effect(EFF_ALLOCATES, start, "reserving capacity allocates")
                let b = self.builtin_node("StringWithCapacity", t, start, end)
                self.tir.nodes[b].kids.append(n)
                return b
            }
            self.fail_here(start, format("`String` has no associated function `{}`; available: new, from, with_capacity", .{name})[..])
            return self.error_expr(start, end)
        }
        if k == TK.Map {
            if name == "new" {
                if !self.args_n(args, 0, "Map.new", start) { return self.error_expr(start, end) }
                let b = self.builtin_node("MapNew", t, start, end)
                self.tir.nodes[b].kids2.append(self.tys.list[t].args[0])
                self.tir.nodes[b].kids2.append(self.tys.list[t].args[1])
                return b
            }
            self.fail_here(start, format("`Map` has no associated function `{}`; available: new", .{name})[..])
            return self.error_expr(start, end)
        }
        if k == TK.Enum { return self.check_variant_ctor(t, name, args, start, end) }
        if k == TK.Struct or k == TK.Distinct {
            if k == TK.Struct and name == "new" and self.structs[self.tys.list[t].def].kind == "record" {
                // validated construction: Record.new(.{ ... }) -> !Record
                let rname = self.structs[self.tys.list[t].def].name.clone()
                if args.len != 1 {
                    self.fail_here(start, format("`new` takes 1 argument(s) but {} were given", .{args.len})[..])
                    return self.error_expr(start, end)
                }
                let an = self.node(self.cur_module(), args[0])
                if an.k != parser.NodeKind.StructLit or an.x != NONE {
                    self.fail_here(an.start, format("`{}.new` takes an anonymous struct literal: `{}.new(.{{ .field = value }})`", .{rname, rname})[..])
                    return self.error_expr(start, end)
                }
                self.record_new_mode = true
                let lit = self.check_struct_lit_into(args[0], t)
                self.record_new_mode = false
                return self.record_check(lit, t, true, start, end)
            }
            let fid = self.find_inherent_method(t, name)
            if fid != NONE {
                let fm = self.fns[fid].node_module
                let params = self.node(fm, self.fns[fid].node).kids.clone()
                if k == TK.Struct and params.len > 0 and self.node(fm, params[0]).name == "self" {
                    self.fail_here(start, format("`{}` is a method; call it on a value: `value.{}(...)`", .{name, name})[..])
                    return self.error_expr(start, end)
                }
                return self.call_fn_def(fid, NONE, args, expected, start, end)
            }
            self.fail_here(start, format("`{}` has no associated function `{}`", .{self.ty_name(t), name})[..])
            for a in args { _ = self.check_expr(a, NONE) }
            return self.error_expr(start, end)
        }
        self.fail_here(start, format("`{}` has no associated function `{}`", .{self.ty_name(t), name})[..])
        for a in args { _ = self.check_expr(a, NONE) }
        return self.error_expr(start, end)
    }

    fn args_n(self: *mut Self, args: []usize, n: usize, what: []u8, at: usize) -> bool {
        if args.len != n {
            self.fail_here(at, format("`{}` takes {} argument(s) but {} were given", .{what, n, args.len})[..])
            for a in args { _ = self.check_expr(a, NONE) }
            return false
        }
        return true
    }

    fn arg(self: *mut Self, e: usize, ty: usize, what: []u8) -> usize {
        let te = self.check_expr(e, ty)
        return self.coerce_or_error(te, ty, what)
    }

    /// `List(i32)`, `Map(K, V)`, `Pair(i32)` in expression position: a type value.
    fn expr_as_type(self: *mut Self, e: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let k = n.k
        let st = self.ctx().self_ty
        if k == parser.NodeKind.TypeVal { return self.resolve_type(m, n.x, st) }
        if k == parser.NodeKind.Ident {
            let name = n.name.clone()
            return self.named_type(m, name[..], NONE_NAME, List(usize).new(), n.start, st)
        }
        if k == parser.NodeKind.FieldE {
            let base = self.node(m, n.x)
            if base.k == parser.NodeKind.Ident {
                return self.named_type(m, n.name.clone()[..], base.name.clone()[..], List(usize).new(), n.start, st)
            }
        }
        if k == parser.NodeKind.Call {
            let callee = self.node(m, n.x)
            let args = n.kids.clone()
            var targs = List(usize).new()
            for a in args { targs.append(self.expr_as_type(a)) }
            if callee.k == parser.NodeKind.Ident {
                return self.named_type(m, callee.name.clone()[..], NONE_NAME, targs, n.start, st)
            }
        }
        if k == parser.NodeKind.TupleLit {
            let elems = n.kids.clone()
            var ts = List(usize).new()
            for a in elems { ts.append(self.expr_as_type(a)) }
            if ts.len == 0 { return self.tys.void() }
            return self.tys.tuple(ts)
        }
        self.fail_here(n.start, "expected a type argument")
        return self.tys.void()
    }

    // ----- method calls -------------------------------------------------------------------------

    fn check_method_call(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let recv_node = n.x
        let method = n.name.clone()
        let args = n.kids.clone()
        let start = n.start
        let end = n.end
        let recv = self.check_expr(recv_node, NONE)
        if self.is_namespace(recv) {
            let ns = self.tir.nodes[recv].name.clone()
            return self.check_namespace_call(ns[..], method[..], args[..], expected, start, end)
        }
        let rt = self.tys.shallow(self.tir.nodes[recv].ty)
        if self.tys.kind(rt) == TK.Type and self.tir.nodes[recv].k == TKind.TypeVal {
            return self.check_static_call(self.tir.nodes[recv].a, method[..], args[..], expected, start, end)
        }
        var base_t = rt
        while self.tys.kind(base_t) == TK.Ptr { base_t = self.tys.shallow(self.tys.list[base_t].args[0]) }
        let bk = self.tys.kind(base_t)
        if bk == TK.Dyn {
            let recv2 = self.auto_deref_all(recv)
            let trait_id = self.tys.list[base_t].def
            let permitted = self.tys.list[base_t].n
            let tm = self.traits[trait_id].module
            let tname = self.traits[trait_id].name.clone()
            let methods = self.traits[trait_id].methods.clone()
            var idx = NONE
            for meth, i in methods { if self.node(tm, meth).name == method { idx = i } }
            if idx == NONE {
                self.fail_here(start, format("trait `{}` has no method `{}`", .{tname, method})[..])
                for a in args { _ = self.check_expr(a, NONE) }
                return self.error_expr(start, end)
            }
            var ps = List(usize).new()
            var ret = NONE
            var mutable = false
            if !self.dyn_method_sig(trait_id, idx, start, &mut ps, &mut ret, &mut mutable) { return self.error_expr(start, end) }
            if mutable and self.is_place(recv2) and !self.place_mutable(recv2) {
                self.fail_here(start, format("`{}` mutates its receiver, but this trait object is immutable", .{method})[..])
            }
            if args.len != ps.len {
                self.fail_here(start, format("`{}` takes {} argument(s) but {} were given", .{method, ps.len, args.len})[..])
                return self.error_expr(start, end)
            }
            var targs = List(usize).new()
            for a, i in args { targs.append(self.arg(a, ps[i], "argument")) }
            // a dynamic call acquires every effect the trait object permits
            if permitted != 0 {
                self.add_effect(permitted, start, "calling through a trait object acquires the effects its type permits")
            }
            let r = self.mk(TKind.DynCall, ret, start, end)
            self.tir.nodes[r].a = idx
            self.tir.nodes[r].kids.append(recv2)
            for ta in targs { self.tir.nodes[r].kids.append(ta) }
            return r
        }
        if bk == TK.Struct or bk == TK.Enum or bk == TK.Distinct {
            let fid = self.find_inherent_method(base_t, method[..])
            if fid != NONE {
                let fm = self.fns[fid].node_module
                let params = self.node(fm, self.fns[fid].node).kids.clone()
                let has_self = params.len > 0 and self.node(fm, params[0]).name == "self"
                if !has_self {
                    self.fail_here(start, format("`{}` is an associated function, not a method; call it as `{}.{}(...)`", .{method, self.ty_name(base_t), method})[..])
                    return self.error_expr(start, end)
                }
                return self.call_fn_def(fid, recv, args[..], expected, start, end)
            }
            if self.is_ref_class(base_t) and method == "weak" {
                if !self.args_n(args[..], 0, "weak", start) { return self.error_expr(start, end) }
                let wt = self.tys.wrap(TK.Weak, base_t, false)
                self.add_effect(EFF_REFCOUNTS, start, "creating a weak reference")
                let b = self.builtin_node("Weak", wt, start, end)
                self.tir.nodes[b].kids.append(recv)
                self.tir.nodes[b].kids2.append(base_t)
                return b
            }
        }
        let recv2 = self.auto_deref_all(recv)
        let t = self.tys.resolve(self.tir.nodes[recv2].ty, true)
        let r = self.builtin_method(recv2, t, method[..], args[..], start, end)
        if r != NONE { return r }
        self.fail_here(start, format("no method `{}` on type `{}`", .{method, self.ty_name(t)})[..])
        for a in args { _ = self.check_expr(a, NONE) }
        return self.error_expr(start, end)
    }

    fn require_mut_recv(self: *mut Self, recv: usize, method: []u8, at: usize) {
        if self.is_place(recv) and !self.place_mutable(recv) {
            var what = String.from("the receiver")
            if self.tir.nodes[recv].k == TKind.Local { what = format("`{}`", .{self.ctx().locals[self.tir.nodes[recv].a].name}) }
            self.fail_here(at, format("`{}` mutates its receiver, but {} is immutable", .{method, what})[..])
        }
    }

    fn bnode(self: *mut Self, op: []u8, recv: usize, ty: usize, ety: usize, start: usize, end: usize) -> usize {
        let b = self.builtin_node(op, ty, start, end)
        if recv != NONE { self.tir.nodes[b].kids.append(recv) }
        if ety != NONE { self.tir.nodes[b].kids2.append(ety) }
        return b
    }

    fn is_empty_node(self: *mut Self, recv: usize, start: usize, end: usize) -> usize {
        let u = self.tys.usize_ty()
        let bt = self.tys.bool_ty()
        let len = self.bnode("Len", recv, u, NONE, start, end)
        let zero = self.int_node(0, u, start, end)
        return self.binary_node("==", "plain", true, len, zero, bt, start, end)
    }

    fn builtin_method(self: *mut Self, recv: usize, t: usize, method: []u8, args: []usize, start: usize, end: usize) -> usize {
        let v = self.tys.void()
        let bt = self.tys.bool_ty()
        let u = self.tys.usize_ty()
        let u8t = self.tys.u8_ty()
        let bytes = self.tys.str_slice()
        let string = self.tys.string()
        let k = self.tys.kind(t)
        if k == TK.List {
            let e = self.tys.list[t].args[0]
            if method == "append" or method == "push" {
                if !self.args_n(args, 1, "append", start) { return self.error_expr(start, end) }
                self.require_mut_recv(recv, "append", start)
                var x = self.arg(args[0], e, "element")
                x = self.take_ownership(x)
                self.add_effect(EFF_ALLOCATES, start, "appending to a List may grow it")
                let b = self.bnode("ListAppend", recv, v, e, start, end)
                self.tir.nodes[b].kids.append(x)
                return b
            }
            if method == "pop" {
                if !self.args_n(args, 0, "pop", start) { return self.error_expr(start, end) }
                self.require_mut_recv(recv, "pop", start)
                let o = self.tys.wrap(TK.Opt, e, false)
                return self.bnode("ListPop", recv, o, e, start, end)
            }
            if method == "clear" {
                if !self.args_n(args, 0, "clear", start) { return self.error_expr(start, end) }
                self.require_mut_recv(recv, "clear", start)
                return self.bnode("ListClear", recv, v, e, start, end)
            }
            if method == "clone" {
                if !self.args_n(args, 0, "clone", start) { return self.error_expr(start, end) }
                self.add_effect(EFF_ALLOCATES, start, "cloning a List allocates")
                return self.bnode("ListClone", recv, t, e, start, end)
            }
            if method == "last" or method == "first" {
                if !self.args_n(args, 0, method, start) { return self.error_expr(start, end) }
                let o = self.tys.wrap(TK.Opt, e, false)
                let s = self.tys.wrap(TK.Slice, e, false)
                let sl = self.mk(TKind.ListToSlice, s, start, end)
                self.tir.nodes[sl].kids.append(recv)
                let idx = self.int_node(if method == "last" { 1 } else { 0 }, u, start, end)
                let b = self.bnode("ListLast", sl, o, e, start, end)
                self.tir.nodes[b].kids.append(idx)
                return b
            }
            if method == "insert" {
                if !self.args_n(args, 2, "insert", start) { return self.error_expr(start, end) }
                self.require_mut_recv(recv, "insert", start)
                let i = self.arg(args[0], u, "index")
                var x = self.arg(args[1], e, "element")
                x = self.take_ownership(x)
                self.add_effect(EFF_ALLOCATES, start, "inserting into a List may grow it")
                self.add_effect(EFF_PANICS, start, "insert panics when the index is out of range")
                let b = self.bnode("ListInsert", recv, v, e, start, end)
                self.tir.nodes[b].kids.append(i)
                self.tir.nodes[b].kids.append(x)
                return b
            }
            if method == "remove" or method == "swap_remove" {
                if !self.args_n(args, 1, method, start) { return self.error_expr(start, end) }
                self.require_mut_recv(recv, method, start)
                let i = self.arg(args[0], u, "index")
                self.add_effect(EFF_PANICS, start, "remove panics when the index is out of range")
                let b = self.bnode(if method == "remove" { "ListRemove" } else { "ListSwapRemove" }, recv, e, e, start, end)
                self.tir.nodes[b].kids.append(i)
                return b
            }
            if method == "extend" {
                if !self.args_n(args, 1, "extend", start) { return self.error_expr(start, end) }
                self.require_mut_recv(recv, "extend", start)
                let st = self.tys.wrap(TK.Slice, e, false)
                let s = self.arg(args[0], st, "elements")
                if self.needs_drop(e) { self.fail_here(start, "`extend` copies elements; the element type owns resources, so append clones instead") }
                self.add_effect(EFF_ALLOCATES, start, "extending a List may grow it")
                let b = self.bnode("ListExtend", recv, v, e, start, end)
                self.tir.nodes[b].kids.append(s)
                return b
            }
            if method == "reserve" {
                if !self.args_n(args, 1, "reserve", start) { return self.error_expr(start, end) }
                self.require_mut_recv(recv, "reserve", start)
                let n = self.arg(args[0], u, "capacity")
                self.add_effect(EFF_ALLOCATES, start, "reserving allocates")
                let b = self.bnode("ListReserve", recv, v, e, start, end)
                self.tir.nodes[b].kids.append(n)
                return b
            }
            if method == "items" or method == "as_slice" {
                if !self.args_n(args, 0, method, start) { return self.error_expr(start, end) }
                let mu = self.place_mutable(recv)
                let st = self.tys.wrap(TK.Slice, e, mu)
                let sl = self.mk(TKind.ListToSlice, st, start, end)
                self.tir.nodes[sl].kids.append(recv)
                return sl
            }
            if method == "is_empty" {
                if !self.args_n(args, 0, "is_empty", start) { return self.error_expr(start, end) }
                return self.is_empty_node(recv, start, end)
            }
            let mu = self.place_mutable(recv)
            let st = self.tys.wrap(TK.Slice, e, mu)
            let sl = self.mk(TKind.ListToSlice, st, start, end)
            self.tir.nodes[sl].kids.append(recv)
            return self.slice_method(sl, e, mu, method, args, start, end)
        }
        if k == TK.Str {
            if method == "append" {
                if !self.args_n(args, 1, "append", start) { return self.error_expr(start, end) }
                self.require_mut_recv(recv, "append", start)
                let s = self.arg(args[0], bytes, "text")
                self.add_effect(EFF_ALLOCATES, start, "appending to a String may grow it")
                let b = self.bnode("StringAppend", recv, v, NONE, start, end)
                self.tir.nodes[b].kids.append(s)
                return b
            }
            if method == "append_char" {
                if !self.args_n(args, 1, "append_char", start) { return self.error_expr(start, end) }
                self.require_mut_recv(recv, "append_char", start)
                let ct = self.tys.char_ty()
                let c = self.arg(args[0], ct, "character")
                self.add_effect(EFF_ALLOCATES, start, "appending to a String may grow it")
                let b = self.bnode("StringAppendChar", recv, v, NONE, start, end)
                self.tir.nodes[b].kids.append(c)
                return b
            }
            if method == "push_byte" {
                if !self.args_n(args, 1, "push_byte", start) { return self.error_expr(start, end) }
                self.require_mut_recv(recv, "push_byte", start)
                let x = self.arg(args[0], u8t, "byte")
                self.add_effect(EFF_ALLOCATES, start, "appending to a String may grow it")
                let b = self.bnode("StringPushByte", recv, v, NONE, start, end)
                self.tir.nodes[b].kids.append(x)
                return b
            }
            if method == "clone" or method == "to_string" {
                if !self.args_n(args, 0, method, start) { return self.error_expr(start, end) }
                self.add_effect(EFF_ALLOCATES, start, "cloning a String allocates")
                return self.bnode("StringClone", recv, string, NONE, start, end)
            }
            if method == "clear" {
                if !self.args_n(args, 0, "clear", start) { return self.error_expr(start, end) }
                self.require_mut_recv(recv, "clear", start)
                return self.bnode("StringClear", recv, v, NONE, start, end)
            }
            if method == "pop" {
                if !self.args_n(args, 0, "pop", start) { return self.error_expr(start, end) }
                self.require_mut_recv(recv, "pop", start)
                let o = self.tys.wrap(TK.Opt, u8t, false)
                return self.bnode("StringPop", recv, o, NONE, start, end)
            }
            if method == "bytes" or method == "as_slice" {
                if !self.args_n(args, 0, method, start) { return self.error_expr(start, end) }
                let sl = self.mk(TKind.StrToSlice, bytes, start, end)
                self.tir.nodes[sl].kids.append(recv)
                return sl
            }
            let sl = self.mk(TKind.StrToSlice, bytes, start, end)
            self.tir.nodes[sl].kids.append(recv)
            return self.slice_method(sl, u8t, false, method, args, start, end)
        }
        if k == TK.Map {
            let kt = self.tys.list[t].args[0]
            let vt = self.tys.list[t].args[1]
            var lookup_kt = kt
            if self.tys.kind(self.tys.shallow(kt)) == TK.Str { lookup_kt = bytes }
            if method == "put" or method == "insert" {
                if !self.args_n(args, 2, "put", start) { return self.error_expr(start, end) }
                self.require_mut_recv(recv, "put", start)
                var kk = self.arg(args[0], kt, "key")
                kk = self.take_ownership(kk)
                var vv = self.arg(args[1], vt, "value")
                vv = self.take_ownership(vv)
                self.add_effect(EFF_ALLOCATES, start, "inserting into a Map may grow it")
                let b = self.bnode("MapPut", recv, v, kt, start, end)
                self.tir.nodes[b].kids2.append(vt)
                self.tir.nodes[b].kids.append(kk)
                self.tir.nodes[b].kids.append(vv)
                return b
            }
            if method == "get" or method == "contains" or method == "remove" {
                if !self.args_n(args, 1, method, start) { return self.error_expr(start, end) }
                if method == "remove" { self.require_mut_recv(recv, "remove", start) }
                let kk = self.arg(args[0], lookup_kt, "key")
                let rt = if method == "get" { self.tys.wrap(TK.Opt, vt, false) } else { bt }
                let op = if method == "get" { "MapGet" } else if method == "contains" { "MapContains" } else { "MapRemove" }
                let b = self.bnode(op, recv, rt, kt, start, end)
                self.tir.nodes[b].kids2.append(vt)
                self.tir.nodes[b].kids.append(kk)
                return b
            }
            if method == "clear" or method == "clone" or method == "keys" or method == "values" {
                if !self.args_n(args, 0, method, start) { return self.error_expr(start, end) }
                var rt = v
                var op = "MapClear"
                if method == "clear" {
                    self.require_mut_recv(recv, "clear", start)
                } else if method == "clone" {
                    self.add_effect(EFF_ALLOCATES, start, "cloning a Map allocates")
                    rt = t
                    op = "MapClone"
                } else if method == "keys" {
                    self.add_effect(EFF_ALLOCATES, start, "collecting keys allocates")
                    rt = self.tys.wrap(TK.List, kt, false)
                    op = "MapKeys"
                } else {
                    self.add_effect(EFF_ALLOCATES, start, "collecting values allocates")
                    rt = self.tys.wrap(TK.List, vt, false)
                    op = "MapValues"
                }
                let b = self.bnode(op, recv, rt, kt, start, end)
                self.tir.nodes[b].kids2.append(vt)
                return b
            }
            if method == "is_empty" {
                if !self.args_n(args, 0, "is_empty", start) { return self.error_expr(start, end) }
                return self.is_empty_node(recv, start, end)
            }
            return NONE
        }
        if k == TK.Slice { return self.slice_method(recv, self.tys.list[t].args[0], self.tys.list[t].flag, method, args, start, end) }
        if k == TK.Array {
            let e = self.tys.list[t].args[0]
            let mu = self.place_mutable(recv)
            let st = self.tys.wrap(TK.Slice, e, mu)
            let sl = self.mk(TKind.ArrayToSlice, st, start, end)
            self.tir.nodes[sl].kids.append(recv)
            return self.slice_method(sl, e, mu, method, args, start, end)
        }
        if k == TK.Int {
            if method == "abs" {
                if !self.args_n(args, 0, "abs", start) { return self.error_expr(start, end) }
                self.add_effect(EFF_PANICS, start, "abs overflows for the minimum value")
                return self.bnode("MathAbs", recv, t, t, start, end)
            }
            if method == "min" or method == "max" {
                if !self.args_n(args, 1, method, start) { return self.error_expr(start, end) }
                let x = self.arg(args[0], t, "operand")
                let b = self.bnode(if method == "min" { "MathMin" } else { "MathMax" }, recv, t, t, start, end)
                self.tir.nodes[b].kids.append(x)
                return b
            }
            if method == "checked_add" or method == "checked_sub" or method == "checked_mul" {
                if !self.args_n(args, 1, method, start) { return self.error_expr(start, end) }
                let x = self.arg(args[0], t, "operand")
                let o = self.tys.wrap(TK.Opt, t, false)
                let marker = self.int_node(if method == "checked_add" { 0 } else if method == "checked_sub" { 1 } else { 2 }, t, start, end)
                let b = self.bnode("Hash", recv, o, t, start, end)
                self.tir.nodes[b].kids.append(x)
                self.tir.nodes[b].kids.append(marker)
                return b
            }
            if method == "to_string" {
                if !self.args_n(args, 0, "to_string", start) { return self.error_expr(start, end) }
                self.add_effect(EFF_ALLOCATES, start, "formatting into a String allocates")
                return self.bnode("IntToStr", recv, string, t, start, end)
            }
            return NONE
        }
        if k == TK.Float {
            var op = ""
            if method == "abs" { op = "MathAbs" }
            if method == "sqrt" { op = "MathSqrt" }
            if method == "floor" { op = "MathFloor" }
            if method == "ceil" { op = "MathCeil" }
            if method == "round" { op = "MathRound" }
            if op.len > 0 {
                if !self.args_n(args, 0, method, start) { return self.error_expr(start, end) }
                return self.bnode(op, recv, t, t, start, end)
            }
            if method == "min" or method == "max" or method == "pow" {
                if !self.args_n(args, 1, method, start) { return self.error_expr(start, end) }
                let x = self.arg(args[0], t, "operand")
                let b = self.bnode(if method == "min" { "MathMin" } else if method == "max" { "MathMax" } else { "MathPow" }, recv, t, t, start, end)
                self.tir.nodes[b].kids.append(x)
                return b
            }
            if method == "to_string" {
                if !self.args_n(args, 0, "to_string", start) { return self.error_expr(start, end) }
                self.add_effect(EFF_ALLOCATES, start, "formatting into a String allocates")
                return self.bnode("FloatToStr", recv, string, t, start, end)
            }
            return NONE
        }
        if k == TK.Char {
            var op = ""
            var rt = bt
            if method == "is_digit" { op = "CharIsDigit" }
            if method == "is_alpha" { op = "CharIsAlpha" }
            if method == "is_space" { op = "CharIsSpace" }
            if method == "to_lower" { op = "CharToLower"; rt = t }
            if method == "to_upper" { op = "CharToUpper"; rt = t }
            if op.len > 0 {
                if !self.args_n(args, 0, method, start) { return self.error_expr(start, end) }
                return self.bnode(op, recv, rt, NONE, start, end)
            }
            if method == "to_digit" {
                if !self.args_n(args, 0, method, start) { return self.error_expr(start, end) }
                let u32t = self.tys.int("u32")
                let o = self.tys.wrap(TK.Opt, u32t, false)
                return self.bnode("CharToDigit", recv, o, NONE, start, end)
            }
            return NONE
        }
        if k == TK.Weak {
            if method == "upgrade" {
                if !self.args_n(args, 0, "upgrade", start) { return self.error_expr(start, end) }
                let inner = self.tys.list[t].args[0]
                let o = self.tys.wrap(TK.Opt, inner, false)
                self.add_effect(EFF_REFCOUNTS, start, "upgrading a weak reference retains")
                return self.bnode("Upgrade", recv, o, inner, start, end)
            }
            return NONE
        }
        if k == TK.Opt {
            self.fail_here(start, format("cannot call `{}` on an optional; unwrap it first with `orelse`, `.?`, or `if let`", .{method})[..])
            return self.error_expr(start, end)
        }
        if k == TK.ErrUnion {
            self.fail_here(start, format("cannot call `{}` on an error union; use `try` first", .{method})[..])
            return self.error_expr(start, end)
        }
        return NONE
    }

    fn slice_method(self: *mut Self, recv: usize, e: usize, mutable: bool, method: []u8, args: []usize, start: usize, end: usize) -> usize {
        let m = self.cur_module()
        let v = self.tys.void()
        let bt = self.tys.bool_ty()
        let u = self.tys.usize_ty()
        let u8t = self.tys.u8_ty()
        let bytes = self.tys.str_slice()
        let string = self.tys.string()
        let es = self.tys.shallow(e)
        let is_u8 = self.tys.kind(es) == TK.Int and self.tys.list[es].name == "u8"
        if method == "fill" {
            if !self.args_n(args, 1, "fill", start) { return self.error_expr(start, end) }
            if !mutable { self.fail_here(start, "`fill` needs a mutable slice (`[]mut T`)") }
            let x = self.arg(args[0], e, "value")
            let b = self.bnode("SliceFill", recv, v, e, start, end)
            self.tir.nodes[b].kids.append(x)
            return b
        }
        if method == "reverse" or method == "sort" {
            if !self.args_n(args, 0, method, start) { return self.error_expr(start, end) }
            if !mutable { self.fail_here(start, format("`{}` needs a mutable slice (`[]mut T`)", .{method})[..]) }
            return self.bnode(if method == "reverse" { "SliceReverse" } else { "SliceSort" }, recv, v, e, start, end)
        }
        if method == "contains" {
            if !self.args_n(args, 1, "contains", start) { return self.error_expr(start, end) }
            let an = self.node(m, args[0])
            if is_u8 and an.k == parser.NodeKind.Lit and an.text == "str" {
                let needle = self.arg(args[0], bytes, "needle")
                let ot = self.tys.wrap(TK.Opt, u, false)
                let f = self.bnode("SliceFind", recv, ot, e, start, end)
                self.tir.nodes[f].kids.append(needle)
                let nul = self.mk(TKind.OptNull, ot, start, end)
                return self.binary_node("!=", "plain", true, f, nul, bt, start, end)
            }
            let x = self.arg(args[0], e, "value")
            let b = self.bnode("SliceContains", recv, bt, e, start, end)
            self.tir.nodes[b].kids.append(x)
            return b
        }
        if method == "index_of" {
            if !self.args_n(args, 1, "index_of", start) { return self.error_expr(start, end) }
            let x = self.arg(args[0], e, "value")
            let o = self.tys.wrap(TK.Opt, u, false)
            let b = self.bnode("SliceIndexOf", recv, o, e, start, end)
            self.tir.nodes[b].kids.append(x)
            return b
        }
        if method == "copy_from" {
            if !self.args_n(args, 1, "copy_from", start) { return self.error_expr(start, end) }
            if !mutable { self.fail_here(start, "`copy_from` needs a mutable slice (`[]mut T`)") }
            let st = self.tys.wrap(TK.Slice, e, false)
            let s = self.arg(args[0], st, "source")
            self.add_effect(EFF_PANICS, start, "copy_from panics when the source is longer than the destination")
            let b = self.bnode("SliceCopy", recv, v, e, start, end)
            self.tir.nodes[b].kids.append(s)
            return b
        }
        if method == "is_empty" {
            if !self.args_n(args, 0, "is_empty", start) { return self.error_expr(start, end) }
            return self.is_empty_node(recv, start, end)
        }
        if method == "to_owned" or method == "to_list" {
            if !self.args_n(args, 0, method, start) { return self.error_expr(start, end) }
            self.add_effect(EFF_ALLOCATES, start, "copying into a List allocates")
            let lt = self.tys.wrap(TK.List, e, false)
            return self.bnode("ListFromSlice", recv, lt, e, start, end)
        }
        if !is_u8 { return NONE }
        if method == "starts_with" or method == "ends_with" {
            if !self.args_n(args, 1, method, start) { return self.error_expr(start, end) }
            let p = self.arg(args[0], bytes, "prefix")
            let b = self.bnode(if method == "starts_with" { "SliceStartsWith" } else { "SliceEndsWith" }, recv, bt, e, start, end)
            self.tir.nodes[b].kids.append(p)
            return b
        }
        if method == "find" {
            if !self.args_n(args, 1, "find", start) { return self.error_expr(start, end) }
            let needle = self.arg(args[0], bytes, "needle")
            let o = self.tys.wrap(TK.Opt, u, false)
            let b = self.bnode("SliceFind", recv, o, e, start, end)
            self.tir.nodes[b].kids.append(needle)
            return b
        }
        if method == "trim" {
            if !self.args_n(args, 0, "trim", start) { return self.error_expr(start, end) }
            return self.bnode("SliceTrim", recv, bytes, e, start, end)
        }
        if method == "split" {
            if !self.args_n(args, 1, "split", start) { return self.error_expr(start, end) }
            let sep = self.arg(args[0], bytes, "separator")
            self.add_effect(EFF_ALLOCATES, start, "split collects the pieces into a List")
            let lt = self.tys.wrap(TK.List, bytes, false)
            let b = self.bnode("SliceSplit", recv, lt, e, start, end)
            self.tir.nodes[b].kids.append(sep)
            return b
        }
        if method == "lines" {
            if !self.args_n(args, 0, "lines", start) { return self.error_expr(start, end) }
            self.add_effect(EFF_ALLOCATES, start, "lines collects the pieces into a List")
            let lt = self.tys.wrap(TK.List, bytes, false)
            return self.bnode("SliceLines", recv, lt, e, start, end)
        }
        if method == "to_string" {
            if !self.args_n(args, 0, "to_string", start) { return self.error_expr(start, end) }
            self.add_effect(EFF_ALLOCATES, start, "building a String allocates")
            return self.bnode("StringFrom", recv, string, NONE, start, end)
        }
        if method == "parse_int" {
            if !self.args_n(args, 1, "parse_int", start) { return self.error_expr(start, end) }
            let tv = self.check_expr(args[0], NONE)
            if self.tir.nodes[tv].k != TKind.TypeVal {
                self.fail_here(start, "parse_int takes the integer type to parse, e.g. `s.parse_int(i32)`")
                return self.error_expr(start, end)
            }
            let target = self.tir.nodes[tv].a
            if !self.tys.is_integer(target) { self.fail_here(start, "parse_int needs an integer type") }
            let r = self.tys.err_union(0, false, target)
            return self.bnode("SliceParseInt", recv, r, target, start, end)
        }
        if method == "parse_float" {
            if !self.args_n(args, 0, "parse_float", start) { return self.error_expr(start, end) }
            let f64t = self.tys.float64()
            let r = self.tys.err_union(0, false, f64t)
            return self.bnode("SliceParseFloat", recv, r, f64t, start, end)
        }
        if method == "eq_ignore_case" {
            if !self.args_n(args, 1, "eq_ignore_case", start) { return self.error_expr(start, end) }
            let o = self.arg(args[0], bytes, "other")
            let b = self.bnode("SliceEqIgnoreCase", recv, bt, e, start, end)
            self.tir.nodes[b].kids.append(o)
            return b
        }
        _ = u8t
        return NONE
    }
}

// ---------------------------------------------------------------- compile-time values

// value kinds: `kind` picks the meaning of the payload fields
const VK_INT: u8 = 0
const VK_FLOAT: u8 = 1
const VK_BOOL: u8 = 2
const VK_CHAR: u8 = 3
const VK_STR: u8 = 4
// `VK_NONE` is "no value": an unset local, an absent payload
const VK_NONE: u8 = 5
const VK_VOID: u8 = 6
const VK_ARRAY: u8 = 7
const VK_TUPLE: u8 = 8
const VK_STRUCT: u8 = 9
// an enum: `ival` is the variant, `items` its payload
const VK_ENUM: u8 = 10
const VK_NULL: u8 = 11
// some(x) and ok(x): `items[0]`
const VK_SOME: u8 = 12
// an error: `ival` is its id
const VK_ERR: u8 = 13
const VK_OK: u8 = 14
// a type value: `ival` is the type
const VK_TYPE: u8 = 15
const VK_UNDEFINED: u8 = 16
const VK_LIST: u8 = 17
// a map as insertion-ordered pairs: `items` alternates key, value
const VK_MAP: u8 = 18
const VK_OWNED_STR: u8 = 19
// a function: `ival` is the instance
const VK_FN: u8 = 20
const VK_NEVER: u8 = 21
// a pointer to a place: frame `ival`, local `b`, and a path of field or
// element indices into it
const VK_PTR: u8 = 22

/// A compile-time value, the Rust `Value`.
pub struct CV {
    kind: u8
    ival: i128
    fval: f64
    flag: bool
    text: String
    items: List(CV)
    path: List(usize)
    b: usize
}

fn cv(kind: u8) -> CV { return CV{ .kind = kind, .ival = 0, .fval = 0.0, .flag = false, .text = String.new(), .items = List(CV).new(), .path = List(usize).new(), .b = 0 } }
fn cv_int(v: i128) -> CV { var c = cv(VK_INT); c.ival = v; return c }
fn cv_float(v: f64) -> CV { var c = cv(VK_FLOAT); c.fval = v; return c }
fn cv_bool(v: bool) -> CV { var c = cv(VK_BOOL); c.flag = v; return c }
fn cv_char(v: i128) -> CV { var c = cv(VK_CHAR); c.ival = v; return c }
fn cv_str(s: []u8) -> CV { var c = cv(VK_STR); c.text = String.from(s); return c }
fn cv_owned(s: []u8) -> CV { var c = cv(VK_OWNED_STR); c.text = String.from(s); return c }
fn cv_none() -> CV { return cv(VK_NONE) }
fn cv_err(id: usize) -> CV { var c = cv(VK_ERR); c.ival = id as i128; return c }
fn cv_seq(kind: u8, own items: List(CV)) -> CV { var c = cv(kind); c.items = items; return c }
fn cv_wrap(kind: u8, own inner: CV) -> CV { var c = cv(kind); c.items.append(inner); return c }
fn cv_ptr(fi: usize, l: usize, own path: List(usize)) -> CV { var c = cv(VK_PTR); c.ival = fi as i128; c.b = l; c.path = path; return c }

fn cv_clone(v: *CV) -> CV {
    var c = CV{ .kind = v.kind, .ival = v.ival, .fval = v.fval, .flag = v.flag, .text = v.text.clone(), .items = List(CV).new(), .path = v.path.clone(), .b = v.b }
    for it in v.items { c.items.append(cv_clone(&it)) }
    return c
}

fn cv_as_int(v: *CV) -> ?i128 {
    if v.kind == VK_INT or v.kind == VK_CHAR { return v.ival }
    if v.kind == VK_BOOL { return if v.flag { 1 } else { 0 } }
    return null
}
fn cv_as_float(v: *CV) -> ?f64 {
    if v.kind == VK_FLOAT { return v.fval }
    if v.kind == VK_INT { return v.ival as f64 }
    return null
}
fn cv_as_bool(v: *CV) -> ?bool {
    if v.kind == VK_BOOL { return v.flag }
    return null
}
fn cv_bytes(v: *CV) -> ?[]u8 {
    if v.kind == VK_STR or v.kind == VK_OWNED_STR { return v.text[..] }
    return null
}
fn cv_seq_len(v: *CV) -> ?usize {
    if v.kind == VK_ARRAY or v.kind == VK_LIST { return v.items.len }
    if v.kind == VK_STR or v.kind == VK_OWNED_STR { return v.text.len }
    return null
}
/// The elements of an array, list, or byte string as values.
fn cv_seq_items(v: *CV) -> ?List(CV) {
    var out = List(CV).new()
    if v.kind == VK_ARRAY or v.kind == VK_LIST {
        for it in v.items { out.append(cv_clone(&it)) }
        return out
    }
    if v.kind == VK_STR or v.kind == VK_OWNED_STR {
        for b in v.text { out.append(cv_int(b as i128)) }
        return out
    }
    return null
}

/// Structural equality: the same kind and the same payload.
fn cv_eq(a: *CV, b: *CV) -> bool {
    if a.kind != b.kind { return false }
    if a.ival != b.ival or a.fval != b.fval or a.flag != b.flag or a.b != b.b { return false }
    if a.text[..] != b.text[..] { return false }
    if a.items.len != b.items.len or a.path.len != b.path.len { return false }
    for x, i in a.path { if x != b.path[i] { return false } }
    for x, i in a.items { if !cv_eq(&x, &b.items[i]) { return false } }
    return true
}

/// Equality that treats a string literal and an owned string alike, and a
/// list and an array alike.
fn cv_key_eq(a: *CV, b: *CV) -> bool {
    let a_str = a.kind == VK_STR or a.kind == VK_OWNED_STR
    let b_str = b.kind == VK_STR or b.kind == VK_OWNED_STR
    if a_str and b_str { return a.text[..] == b.text[..] }
    let a_seq = a.kind == VK_LIST or a.kind == VK_ARRAY
    let b_seq = b.kind == VK_LIST or b.kind == VK_ARRAY
    if a_seq and b_seq {
        if a.items.len != b.items.len { return false }
        for x, i in a.items { if !cv_key_eq(&x, &b.items[i]) { return false } }
        return true
    }
    return cv_eq(a, b)
}

/// Ordering for sorting: -1, 0, 1.
fn cv_cmp(a: *CV, b: *CV) -> i8 {
    if a.kind == VK_INT and b.kind == VK_INT { return if a.ival < b.ival { -1 } else if a.ival > b.ival { 1 } else { 0 } }
    if a.kind == VK_FLOAT and b.kind == VK_FLOAT { return if a.fval < b.fval { -1 } else if a.fval > b.fval { 1 } else { 0 } }
    if a.kind == VK_BOOL and b.kind == VK_BOOL {
        if a.flag == b.flag { return 0 }
        return if !a.flag { -1 } else { 1 }
    }
    if a.kind == VK_CHAR and b.kind == VK_CHAR { return if a.ival < b.ival { -1 } else if a.ival > b.ival { 1 } else { 0 } }
    let a_str = a.kind == VK_STR or a.kind == VK_OWNED_STR
    let b_str = b.kind == VK_STR or b.kind == VK_OWNED_STR
    if a_str and b_str { return cmp_bytes(a.text[..], b.text[..]) }
    if (a.kind == VK_STRUCT and b.kind == VK_STRUCT) or (a.kind == VK_TUPLE and b.kind == VK_TUPLE) {
        for x, i in a.items {
            if i >= b.items.len { break }
            let r = cv_cmp(&x, &b.items[i])
            if r != 0 { return r }
        }
        return 0
    }
    return 0
}

/// The `(value ...)` form of the dump.
fn cv_text(v: *CV) -> String {
    let k = v.kind
    if k == VK_INT { return format("(int {})", .{v.ival}) }
    if k == VK_FLOAT { return format("(float {})", .{rust_float(v.fval)}) }
    if k == VK_BOOL { return format("(bool {})", .{v.flag}) }
    if k == VK_CHAR { return format("(char {})", .{v.ival}) }
    if k == VK_STR or k == VK_OWNED_STR { return format("(str {})", .{tquote(v.text[..])}) }
    if k == VK_VOID { return String.from("(void)") }
    if k == VK_ARRAY or k == VK_LIST or k == VK_TUPLE or k == VK_STRUCT { return format("(seq {})", .{cv_items_text(v)}) }
    if k == VK_ENUM {
        let inner = cv_items_text(v)
        return format("(enum {} {})", .{v.ival, inner})
    }
    if k == VK_NULL { return String.from("(null)") }
    if k == VK_SOME { return format("(some {})", .{cv_text(&v.items[0])}) }
    if k == VK_OK { return format("(ok {})", .{cv_text(&v.items[0])}) }
    if k == VK_ERR { return format("(err {})", .{v.ival}) }
    if k == VK_FN { return format("(fn {})", .{v.ival}) }
    if k == VK_TYPE { return String.from("(type)") }
    if k == VK_MAP { return format("(map {})", .{cv_items_text(v)}) }
    if k == VK_UNDEFINED { return String.from("(undefined)") }
    if k == VK_NEVER { return String.from("(never)") }
    if k == VK_PTR { return String.from("(ptr)") }
    return String.from("(?)")
}

fn cv_items_text(v: *CV) -> String {
    var s = String.new()
    for it, i in v.items {
        if i > 0 { s.append(" ") }
        s.append(cv_text(&it)[..])
    }
    return s
}

/// A value as `format` prints it.
fn cv_format(v: *CV) -> String {
    let k = v.kind
    if k == VK_INT { return format("{}", .{v.ival}) }
    if k == VK_FLOAT { return format_float(v.fval) }
    if k == VK_BOOL { return format("{}", .{v.flag}) }
    if k == VK_CHAR {
        if v.ival < 0 or v.ival > 0x10FFFF { return String.new() }
        return utf8_encode(v.ival as u32)
    }
    if k == VK_STR or k == VK_OWNED_STR { return v.text.clone() }
    if k == VK_VOID { return String.new() }
    if k == VK_NULL { return String.from("null") }
    if k == VK_SOME { return cv_format(&v.items[0]) }
    if k == VK_ENUM { return format("variant {}", .{v.ival}) }
    return String.from("?")
}

/// Rust's `{}` for f64 with a `.0` on whole numbers.
fn format_float(f: f64) -> String {
    let whole = f == math.floor(f)
    if whole and f < 1.0e16 and f > -1.0e16 { return format("{:.1}", .{f}) }
    return rust_float(f)
}

impl Checker {
    /// The value of a constant expression, when the stage-2 evaluator knows it:
    /// literals, unary and binary arithmetic on scalars, casts, and references
    /// to other constants. Null means "not a scalar the evaluator handles".
    fn eval_const(self: *mut Self, e: usize) -> ?CV {
        let k = self.tir.nodes[e].k
        if k == TKind.Int { return cv_int(self.tir.nodes[e].ival) }
        if k == TKind.Float { return cv_float(self.tir.nodes[e].fval) }
        if k == TKind.Bool { return cv_bool(self.tir.nodes[e].flag) }
        if k == TKind.Char { return cv_char(self.tir.nodes[e].ival) }
        if k == TKind.Str { return cv_str(self.tir.nodes[e].text[..]) }
        if k == TKind.Value {
            let nm = self.tir.nodes[e].name.clone()
            if nm == "int" { return cv_int(self.tir.nodes[e].ival) }
            if nm == "float" { return cv_float(self.tir.nodes[e].fval) }
            if nm == "bool" { return cv_bool(self.tir.nodes[e].flag) }
            if nm == "char" { return cv_char(self.tir.nodes[e].ival) }
            if nm == "str" { return cv_str(self.tir.nodes[e].text[..]) }
            return null
        }
        if k == TKind.Const {
            let id = self.tir.nodes[e].a
            if self.consts[id].value != NONE { return self.eval_const(self.consts[id].value) }
            return null
        }
        if k == TKind.Cast {
            let inner = self.eval_const(self.tir.nodes[e].kids[0]) orelse return null
            let kind = self.tir.nodes[e].name.clone()
            let tt = self.tys.shallow(self.tir.nodes[e].ty)
            if kind.len >= 10 and kind[0..10] == "int_to_int" {
                if inner.kind != 0 and inner.kind != 3 { return null }
                if self.tys.kind(tt) == TK.Int {
                    let nm = self.tys.list[tt].name.clone()
                    if inner.ival < int_min(nm[..]) or inner.ival > int_max(nm[..]) { return null }
                }
                return cv_int(inner.ival)
            }
            if kind == "int_to_float" { if inner.kind != 0 { return null }; return cv_float(inner.ival as f64) }
            if kind == "float_to_float" { if inner.kind != 1 { return null }; return cv_float(inner.fval) }
            if kind == "float_to_int" { if inner.kind != 1 { return null }; return cv_int(inner.fval as i128) }
            if kind == "bits" {
                if self.tys.kind(tt) == TK.Int and inner.kind == 2 { return cv_int(if inner.flag { 1 } else { 0 }) }
                if self.tys.kind(tt) == TK.Char and inner.kind == 0 { return cv_char(inner.ival) }
                if self.tys.kind(tt) == TK.Int and inner.kind == 3 { return cv_int(inner.ival) }
                return inner
            }
            return null
        }
        if k == TKind.Unary {
            let inner = self.eval_const(self.tir.nodes[e].kids[0]) orelse return null
            let op = self.tir.nodes[e].text.clone()
            if op == "-" {
                if inner.kind == 0 { return cv_int(-inner.ival) }
                if inner.kind == 1 { return cv_float(-inner.fval) }
                return null
            }
            if op == "!" { if inner.kind != 2 { return null }; return cv_bool(!inner.flag) }
            if op == "~" { if inner.kind != 0 { return null }; return cv_int(~inner.ival) }
            return null
        }
        if k == TKind.Logical {
            let a = self.eval_const(self.tir.nodes[e].kids[0]) orelse return null
            if a.kind != 2 { return null }
            let is_and = self.tir.nodes[e].flag
            if is_and and !a.flag { return cv_bool(false) }
            if !is_and and a.flag { return cv_bool(true) }
            let b = self.eval_const(self.tir.nodes[e].kids[1]) orelse return null
            if b.kind != 2 { return null }
            return cv_bool(b.flag)
        }
        if k == TKind.Binary {
            let a = self.eval_const(self.tir.nodes[e].kids[0]) orelse return null
            let b = self.eval_const(self.tir.nodes[e].kids[1]) orelse return null
            let op = self.tir.nodes[e].text.clone()
            if a.kind == 0 and b.kind == 0 {
                let x = a.ival
                let y = b.ival
                if op == "+" or op == "+%" or op == "+|" { return cv_int(x + y) }
                if op == "-" or op == "-%" or op == "-|" { return cv_int(x - y) }
                if op == "*" or op == "*%" or op == "*|" { return cv_int(x * y) }
                if op == "/" { if y == 0 { return null }; return cv_int(x / y) }
                if op == "%" { if y == 0 { return null }; return cv_int(x % y) }
                if op == "&" { return cv_int(x & y) }
                if op == "|" { return cv_int(x | y) }
                if op == "^" { return cv_int(x ^ y) }
                if op == "<<" { if y < 0 or y > 127 { return null }; return cv_int(x << (y as u32)) }
                if op == ">>" { if y < 0 or y > 127 { return null }; return cv_int(x >> (y as u32)) }
                if op == "==" { return cv_bool(x == y) }
                if op == "!=" { return cv_bool(x != y) }
                if op == "<" { return cv_bool(x < y) }
                if op == "<=" { return cv_bool(x <= y) }
                if op == ">" { return cv_bool(x > y) }
                if op == ">=" { return cv_bool(x >= y) }
                return null
            }
            if a.kind == 1 and b.kind == 1 {
                let x = a.fval
                let y = b.fval
                if op == "+" { return cv_float(x + y) }
                if op == "-" { return cv_float(x - y) }
                if op == "*" { return cv_float(x * y) }
                if op == "/" { return cv_float(x / y) }
                if op == "==" { return cv_bool(x == y) }
                if op == "!=" { return cv_bool(x != y) }
                if op == "<" { return cv_bool(x < y) }
                if op == "<=" { return cv_bool(x <= y) }
                if op == ">" { return cv_bool(x > y) }
                if op == ">=" { return cv_bool(x >= y) }
                return null
            }
            if a.kind == 2 and b.kind == 2 {
                if op == "==" { return cv_bool(a.flag == b.flag) }
                if op == "!=" { return cv_bool(a.flag != b.flag) }
                if op == "&" { return cv_bool(a.flag and b.flag) }
                if op == "|" { return cv_bool(a.flag or b.flag) }
                if op == "^" { return cv_bool(a.flag != b.flag) }
                return null
            }
            if a.kind == 3 and b.kind == 3 {
                if op == "==" { return cv_bool(a.ival == b.ival) }
                if op == "!=" { return cv_bool(a.ival != b.ival) }
                if op == "<" { return cv_bool(a.ival < b.ival) }
                if op == "<=" { return cv_bool(a.ival <= b.ival) }
                if op == ">" { return cv_bool(a.ival > b.ival) }
                if op == ">=" { return cv_bool(a.ival >= b.ival) }
                return null
            }
            return null
        }
        return null
    }

    /// A `(value ...)` node: a scalar lives in the node's own fields, any
    /// other value in the `values` table (name `agg`, index in `a`).
    fn value_node(self: *mut Self, v: *CV, ty: usize, start: usize, end: usize) -> usize {
        let r = self.mk(TKind.Value, ty, start, end)
        if v.kind > VK_STR {
            self.tir.nodes[r].name = String.from("agg")
            self.tir.nodes[r].a = self.values.len
            self.values.append(cv_clone(v))
            return r
        }
        let names = ["int", "float", "bool", "char", "str"]
        self.tir.nodes[r].name = String.from(names[v.kind as usize])
        self.tir.nodes[r].ival = v.ival
        self.tir.nodes[r].fval = v.fval
        self.tir.nodes[r].flag = v.flag
        self.tir.nodes[r].text = v.text.clone()
        return r
    }

    /// The value a `(value ...)` node holds.
    fn value_of_node(self: *mut Self, e: usize) -> CV {
        let nm = self.tir.nodes[e].name.clone()
        if nm == "agg" { return cv_clone(&self.values[self.tir.nodes[e].a]) }
        if nm == "int" { return cv_int(self.tir.nodes[e].ival) }
        if nm == "float" { return cv_float(self.tir.nodes[e].fval) }
        if nm == "bool" { return cv_bool(self.tir.nodes[e].flag) }
        if nm == "char" { return cv_char(self.tir.nodes[e].ival) }
        return cv_str(self.tir.nodes[e].text[..])
    }

    fn value_text(self: *mut Self, e: usize) -> String {
        let v = self.value_of_node(e)
        return cv_text(&v)
    }
}

// ---------------------------------------------------------------- the compile-time interpreter

// Compile-time evaluation runs the typed IR: pure computation, collections,
// calls to Nexium functions; no I/O, clocks, randomness or foreign calls.
// A step budget turns a runaway evaluation into an error.

const STEP_BUDGET: u64 = 20000000

// control flow out of a statement or block
const FL_NEXT: u8 = 0
const FL_RETURN: u8 = 1
const FL_BREAK: u8 = 2
const FL_CONTINUE: u8 = 3
const FL_FAIL: u8 = 4

/// One function activation: the values of its locals by id (`VK_NONE` when
/// unset). Temporaries made for `&rvalue` are appended past the locals.
pub struct Frame {
    vals: List(CV)
}

/// The interpreter state of an outer evaluation while an inner one runs
/// (checking a callee's body on demand can evaluate a constant of its own).
pub struct ItSave {
    steps: u64
    panic: String
    panic_at: usize
    has_panic: bool
    budget: bool
    pending: u8
    pending_label: usize
    pending_val: CV
    failed_at: usize
    frames: List(Frame)
    cur_fn: usize
    out: CV
    flow_val: CV
    flow_label: usize
}

fn frames_clone(fs: *List(Frame)) -> List(Frame) {
    var out = List(Frame).new()
    for f in fs {
        var nf = Frame{ .vals = List(CV).new() }
        for v in f.vals { nf.vals.append(cv_clone(&v)) }
        out.append(nf)
    }
    return out
}

fn wrap_to(v: i128, bits: u32, signed: bool) -> i128 {
    if bits >= 128 { return v }
    let m: i128 = 1 << bits
    var r = v % m
    if r < 0 { r += m }
    if signed and r >= m / 2 { r -= m }
    return r
}

/// IEEE 754 decoding by arithmetic: the language has no bit cast.
fn f64_from_bits(raw: u64) -> f64 {
    let sign = (raw >> 63) != 0
    let exp = ((raw >> 52) & 0x7FF) as i64
    let mant = raw & 0xFFFFFFFFFFFFF
    var v: f64 = 0.0
    if exp == 0x7FF {
        v = if mant == 0 { 1.0 / 0.0 } else { 0.0 / 0.0 }
    } else if exp == 0 {
        v = (mant as f64) * pow2(-1074)
    } else {
        v = (1.0 + (mant as f64) / 4503599627370496.0) * pow2(exp - 1023)
    }
    return if sign { -v } else { v }
}

fn f32_from_bits(raw: u32) -> f64 {
    let sign = (raw >> 31) != 0
    let exp = ((raw >> 23) & 0xFF) as i64
    let mant = raw & 0x7FFFFF
    var v: f64 = 0.0
    if exp == 0xFF {
        v = if mant == 0 { 1.0 / 0.0 } else { 0.0 / 0.0 }
    } else if exp == 0 {
        v = (mant as f64) * pow2(-149)
    } else {
        v = (1.0 + (mant as f64) / 8388608.0) * pow2(exp - 127)
    }
    return if sign { -v } else { v }
}

fn pow2(e: i64) -> f64 {
    var r: f64 = 1.0
    var n = e
    while n > 0 { r *= 2.0; n -= 1 }
    while n < 0 { r /= 2.0; n += 1 }
    return r
}

fn utf8_encode(cp: u32) -> String {
    var s = String.new()
    if cp < 0x80 {
        s.push_byte(cp as u8)
    } else if cp < 0x800 {
        s.push_byte((0xC0 | (cp >> 6)) as u8)
        s.push_byte((0x80 | (cp & 0x3F)) as u8)
    } else if cp < 0x10000 {
        s.push_byte((0xE0 | (cp >> 12)) as u8)
        s.push_byte((0x80 | ((cp >> 6) & 0x3F)) as u8)
        s.push_byte((0x80 | (cp & 0x3F)) as u8)
    } else {
        s.push_byte((0xF0 | (cp >> 18)) as u8)
        s.push_byte((0x80 | ((cp >> 12) & 0x3F)) as u8)
        s.push_byte((0x80 | ((cp >> 6) & 0x3F)) as u8)
        s.push_byte((0x80 | (cp & 0x3F)) as u8)
    }
    return s
}

/// The first scalar of a UTF-8 string, or null when the prefix is malformed.
fn utf8_first(s: []u8) -> ?u32 {
    if s.len == 0 { return null }
    let b0 = s[0] as u32
    if b0 < 0x80 { return b0 }
    var n: usize = 0
    var cp: u32 = 0
    if b0 >> 5 == 6 { n = 1; cp = b0 & 0x1F }
    else if b0 >> 4 == 14 { n = 2; cp = b0 & 0x0F }
    else if b0 >> 3 == 30 { n = 3; cp = b0 & 0x07 }
    else { return null }
    if s.len < n + 1 { return null }
    for i in 0..n {
        let b = s[i + 1] as u32
        if b >> 6 != 2 { return null }
        cp = (cp << 6) | (b & 0x3F)
    }
    return cp
}

fn utf8_valid(s: []u8) -> bool {
    var i: usize = 0
    while i < s.len {
        let cp = utf8_first(s[i..]) orelse return false
        i += if cp < 0x80 { 1 } else if cp < 0x800 { 2 } else if cp < 0x10000 { 3 } else { 4 }
    }
    return true
}

fn trim_ascii(s: []u8) -> []u8 {
    var a: usize = 0
    var b = s.len
    while a < b and (s[a] == ' ' or s[a] == '\t' or s[a] == '\n' or s[a] == '\r') { a += 1 }
    while b > a and (s[b - 1] == ' ' or s[b - 1] == '\t' or s[b - 1] == '\n' or s[b - 1] == '\r') { b -= 1 }
    return s[a..b]
}

fn lower_ascii(c: u8) -> u8 { return if c >= 'A' and c <= 'Z' { c + 32 } else { c } }

impl Checker {
    // ----- entry points ------------------------------------------------------------

    fn it_enter(self: *mut Self) -> ItSave {
        let s = ItSave{
            .steps = self.it_steps, .panic = self.it_panic.clone(), .panic_at = self.it_panic_at, .has_panic = self.it_has_panic,
            .budget = self.it_budget, .pending = self.it_pending, .pending_label = self.it_pending_label, .pending_val = cv_clone(&self.it_pending_val),
            .failed_at = self.it_failed_at, .frames = frames_clone(&self.frames), .cur_fn = self.it_cur_fn, .out = cv_clone(&self.it_out),
            .flow_val = cv_clone(&self.it_flow_val), .flow_label = self.it_flow_label,
        }
        self.it_steps = 0
        self.it_panic = String.new()
        self.it_panic_at = NONE
        self.it_has_panic = false
        self.it_budget = false
        self.it_pending = 0
        self.it_pending_label = NONE
        self.it_pending_val = cv(VK_NONE)
        self.it_failed_at = NONE
        self.frames = List(Frame).new()
        self.it_cur_fn = NONE
        self.it_out = cv(VK_NONE)
        self.it_flow_val = cv(VK_NONE)
        self.it_flow_label = NONE
        return s
    }

    fn it_leave(self: *mut Self, s: *ItSave) {
        self.it_steps = s.steps
        self.it_panic = s.panic.clone()
        self.it_panic_at = s.panic_at
        self.it_has_panic = s.has_panic
        self.it_budget = s.budget
        self.it_pending = s.pending
        self.it_pending_label = s.pending_label
        self.it_pending_val = cv_clone(&s.pending_val)
        self.it_failed_at = s.failed_at
        self.frames = frames_clone(&s.frames)
        self.it_cur_fn = s.cur_fn
        self.it_out = cv_clone(&s.out)
        self.it_flow_val = cv_clone(&s.flow_val)
        self.it_flow_label = s.flow_label
    }

    /// Evaluate an expression with no locals; a compile-time panic or an
    /// exhausted budget is reported as an error.
    fn eval_const_expr(self: *mut Self, e: usize) -> ?CV {
        let saved = self.it_enter()
        var fr = Frame{ .vals = List(CV).new() }
        self.frames.append(fr)
        let r = self.it_eval(e)
        if self.it_has_panic {
            self.fail_here(self.it_panic_at, format("compile-time evaluation panicked: {}", .{self.it_panic})[..])
        }
        if self.it_budget {
            self.fail_here(self.tir.nodes[e].start, format("compile-time evaluation exceeded the step budget ({} steps)", .{STEP_BUDGET})[..])
        }
        self.it_leave(&saved)
        return r
    }

    /// Evaluate with one local bound; silent on failure (record constraints).
    fn eval_with_local(self: *mut Self, e: usize, local: usize, own v: CV) -> ?CV {
        let saved = self.it_enter()
        var fr = Frame{ .vals = List(CV).new() }
        for i in 0..local + 1 { fr.vals.append(cv(VK_NONE)) }
        fr.vals[local] = v
        self.frames.append(fr)
        let r = self.it_eval(e)
        self.it_leave(&saved)
        return r
    }

    /// Run a function instance at compile time. Returns 0 with the value in
    /// `it_out` on success, 1 when it could not be evaluated, 2 when it
    /// panicked (message in `it_panic`, location in `it_panic_at`).
    fn call_instance(self: *mut Self, inst: usize, own args: List(CV)) -> u8 {
        let saved = self.it_enter()
        let r = self.it_call(inst, args)
        var code: u8 = 1
        var out = cv(VK_NONE)
        var msg = String.new()
        var at = NONE
        if self.it_has_panic {
            code = 2
            msg = self.it_panic.clone()
            at = self.it_panic_at
        } else if self.it_budget {
            code = 2
            msg = format("exceeded the compile-time step budget ({} steps)", .{STEP_BUDGET})
            at = self.insts[inst].start
        } else if let v = r {
            code = 0
            out = v
        }
        self.it_leave(&saved)
        self.it_out = out
        self.it_panic = msg
        self.it_panic_at = at
        return code
    }

    // ----- machinery ---------------------------------------------------------------

    fn it_step(self: *mut Self) -> bool {
        self.it_steps += 1
        if self.it_steps > STEP_BUDGET {
            self.it_budget = true
            return false
        }
        return true
    }

    /// Record a panic with a location and stop evaluation.
    fn it_panic_at(self: *mut Self, msg: []u8, at: usize) {
        self.it_panic = String.from(msg)
        self.it_panic_at = at
        self.it_has_panic = true
    }

    fn it_fail_panic(self: *mut Self, msg: []u8, at: usize) {
        if !self.it_has_panic { self.it_panic_at(msg, at) }
    }

    /// A zero-initialized value of the given type, for `undefined` locals.
    fn it_default_value(self: *mut Self, ty0: usize) -> CV {
        let ty = self.tys.resolve(ty0, true)
        let k = self.tys.kind(ty)
        if k == TK.Int { return cv_int(0) }
        if k == TK.Float { return cv_float(0.0) }
        if k == TK.Bool { return cv_bool(false) }
        if k == TK.Char { return cv_char(0) }
        if k == TK.Array {
            let n = self.tys.list[ty].n
            let e = self.tys.list[ty].args[0]
            var items = List(CV).new()
            for i in 0..n { items.append(self.it_default_value(e)) }
            return cv_seq(VK_ARRAY, items)
        }
        if k == TK.Tuple {
            var items = List(CV).new()
            for t in self.tys.list[ty].args.clone() { items.append(self.it_default_value(t)) }
            return cv_seq(VK_TUPLE, items)
        }
        if k == TK.Struct {
            var items = List(CV).new()
            for t in self.struct_field_types(ty) { items.append(self.it_default_value(t)) }
            return cv_seq(VK_STRUCT, items)
        }
        if k == TK.Opt { return cv(VK_NULL) }
        if k == TK.List { return cv_seq(VK_LIST, List(CV).new()) }
        if k == TK.Str { return cv_owned("") }
        if k == TK.Distinct { return self.it_default_value(self.distinct_underlying(self.tys.list[ty].def)) }
        return cv(VK_UNDEFINED)
    }

    fn it_ensure_body(self: *mut Self, inst: usize) -> bool {
        if self.insts[inst].body != NONE { return true }
        var pos = NONE
        for q, i in self.queue { if q == inst { pos = i } }
        if pos != NONE {
            _ = self.queue.remove(pos)
            self.check_fn_body(inst)
            return self.insts[inst].body != NONE
        }
        return false
    }

    fn it_call(self: *mut Self, inst: usize, own args: List(CV)) -> ?CV {
        if !self.it_step() { return null }
        if !self.it_ensure_body(inst) { return null }
        if self.insts[inst].is_extern { return null }
        var fr = Frame{ .vals = List(CV).new() }
        let nlocals = self.insts[inst].locals.len
        for i in 0..nlocals { fr.vals.append(cv(VK_NONE)) }
        let params = self.insts[inst].params.clone()
        for a, i in args { if i < params.len { fr.vals[params[i]] = cv_clone(&a) } }
        self.frames.append(fr)
        let outer = self.it_cur_fn
        self.it_cur_fn = inst
        let body = self.insts[inst].body
        let flow = self.it_exec_block(body)
        self.it_cur_fn = outer
        _ = self.frames.pop()
        if flow == FL_FAIL { return null }
        if flow == FL_RETURN { return cv_clone(&self.it_flow_val) }
        if self.it_out.kind == VK_NONE { return cv(VK_VOID) }
        return cv_clone(&self.it_out)
    }

    fn it_env_get(self: *mut Self, l: usize) -> CV {
        let fi = self.frames.len - 1
        if l >= self.frames[fi].vals.len { return cv(VK_UNDEFINED) }
        if self.frames[fi].vals[l].kind == VK_NONE { return cv(VK_UNDEFINED) }
        return cv_clone(&self.frames[fi].vals[l])
    }

    fn it_env_set(self: *mut Self, l: usize, own v: CV) {
        let fi = self.frames.len - 1
        while self.frames[fi].vals.len <= l { self.frames[fi].vals.append(cv(VK_NONE)) }
        self.frames[fi].vals[l] = v
    }

    /// A block's flow; its value (the tail's, or a labeled break's) lands in
    /// `it_out` (`VK_NONE` when there is none).
    fn it_exec_block(self: *mut Self, b: usize) -> u8 {
        let stmts = self.tir.nodes[b].kids.clone()
        let tail = self.tir.nodes[b].a
        let label = self.tir.nodes[b].b
        var defers = List(usize).new()
        var flow = FL_NEXT
        var decided = false
        for s in stmts {
            let k = self.tir.nodes[s].k
            if k == TKind.SDefer { defers.append(self.tir.nodes[s].kids[0]); continue }
            if k == TKind.SErrDefer { continue }
            let f = self.it_exec_stmt(s)
            if f == FL_FAIL { return FL_FAIL }
            if f != FL_NEXT { flow = f; decided = true; break }
        }
        var value = cv(VK_NONE)
        if !decided {
            if tail != NONE {
                let v = self.it_eval(tail) orelse return FL_FAIL
                value = v
            }
            if self.it_pending != 0 {
                flow = self.it_pending
                self.it_flow_label = self.it_pending_label
                self.it_flow_val = cv_clone(&self.it_pending_val)
                self.it_pending = 0
                value = cv(VK_NONE)
            }
        }
        // the flow's payload survives the defers
        let fval = cv_clone(&self.it_flow_val)
        let flabel = self.it_flow_label
        var i = defers.len
        while i > 0 {
            i -= 1
            if self.it_exec_stmt(defers[i]) == FL_FAIL { return FL_FAIL }
        }
        self.it_flow_val = fval
        self.it_flow_label = flabel
        // labeled block: a break targeting this block yields its value
        if flow == FL_BREAK and label != NONE and self.it_flow_label == label {
            self.it_out = cv_clone(&self.it_flow_val)
            return FL_NEXT
        }
        self.it_out = value
        return flow
    }

    fn it_exec_stmt(self: *mut Self, s: usize) -> u8 {
        let f = self.it_exec_stmt_inner(s)
        if f == FL_FAIL { return FL_FAIL }
        if self.it_pending != 0 {
            let p = self.it_pending
            self.it_flow_label = self.it_pending_label
            self.it_flow_val = cv_clone(&self.it_pending_val)
            self.it_pending = 0
            return p
        }
        return f
    }

    fn it_exec_stmt_inner(self: *mut Self, s: usize) -> u8 {
        if !self.it_step() { return FL_FAIL }
        let k = self.tir.nodes[s].k
        let kids = self.tir.nodes[s].kids.clone()
        let a = self.tir.nodes[s].a
        let b = self.tir.nodes[s].b
        if k == TKind.SLet {
            var v = cv(VK_UNDEFINED)
            if kids.len > 0 {
                let init = kids[0]
                if self.tir.nodes[init].k == TKind.Undefined {
                    v = self.it_default_value(self.tir.nodes[init].ty)
                } else {
                    v = self.it_eval(init) orelse return FL_FAIL
                }
            }
            self.it_env_set(a, v)
            return FL_NEXT
        }
        if k == TKind.SAssign {
            let target = kids[0]
            var v = self.it_eval(kids[1]) orelse return FL_FAIL
            let op = self.tir.nodes[s].name.clone()
            if op != "=" {
                // "+= checked": the operator and the arithmetic mode
                var sym = String.new()
                var mode = String.new()
                var seen_eq = false
                var after_space = false
                for c in op {
                    if after_space { mode.push_byte(c) }
                    else if c == ' ' { after_space = true }
                    else if c == '=' and !seen_eq { seen_eq = true }
                    else { sym.push_byte(c) }
                }
                let cur = self.it_eval(target) orelse return FL_FAIL
                v = self.it_binop(sym[..], mode[..], cur, v, self.tir.nodes[target].ty, self.tir.nodes[s].start) orelse return FL_FAIL
            }
            if !self.it_assign(target, v) { return FL_FAIL }
            return FL_NEXT
        }
        if k == TKind.SExpr {
            _ = self.it_eval(kids[0]) orelse return FL_FAIL
            return FL_NEXT
        }
        if k == TKind.SReturn {
            var v = cv(VK_VOID)
            if kids.len > 0 { v = self.it_eval(kids[0]) orelse return FL_FAIL }
            self.it_flow_val = v
            return FL_RETURN
        }
        if k == TKind.SBreak {
            var v = cv(VK_NONE)
            if kids.len > 0 { v = self.it_eval(kids[0]) orelse return FL_FAIL }
            self.it_flow_val = v
            self.it_flow_label = a
            return FL_BREAK
        }
        if k == TKind.SContinue {
            self.it_flow_label = a
            return FL_CONTINUE
        }
        if k == TKind.SDefer { return self.it_exec_stmt(kids[0]) }
        if k == TKind.SErrDefer { return FL_NEXT }
        if k == TKind.SWhile {
            let label = a
            var broke = false
            while true {
                if !self.it_step() { return FL_FAIL }
                let c = self.it_eval(kids[0]) orelse return FL_FAIL
                if ! (c.kind == VK_BOOL and c.flag) { break }
                let f = self.it_exec_block(kids[1])
                if f == FL_FAIL { return FL_FAIL }
                if f == FL_NEXT { continue }
                if f == FL_BREAK and self.it_flow_label == label { broke = true; break }
                if f == FL_CONTINUE and self.it_flow_label == label { continue }
                return f
            }
            if !broke and kids.len > 2 {
                return self.it_exec_block(kids[2])
            }
            return FL_NEXT
        }
        if k == TKind.SForRange {
            let var_local = a
            let label = b
            let sv = self.it_eval(kids[0]) orelse return FL_FAIL
            let s0 = cv_as_int(&sv) orelse return FL_FAIL
            let ev = self.it_eval(kids[1]) orelse return FL_FAIL
            let e0 = cv_as_int(&ev) orelse return FL_FAIL
            var st: i128 = 1
            if self.tir.nodes[s].flag {
                let stv = self.it_eval(kids[2]) orelse return FL_FAIL
                st = cv_as_int(&stv) orelse return FL_FAIL
            }
            if st == 0 {
                self.it_panic_at("a range step cannot be zero", self.tir.nodes[s].start)
                return FL_FAIL
            }
            let body = kids[kids.len - 1]
            var i = s0
            while if st > 0 { i < e0 } else { i > e0 } {
                if !self.it_step() { return FL_FAIL }
                self.it_env_set(var_local, cv_int(i))
                let f = self.it_exec_block(body)
                if f == FL_FAIL { return FL_FAIL }
                if f == FL_BREAK and self.it_flow_label == label { break }
                if f != FL_NEXT and ! (f == FL_CONTINUE and self.it_flow_label == label) { return f }
                i += st
            }
            return FL_NEXT
        }
        if k == TKind.SForSlice {
            let index = a
            let label = b
            let locals = self.tir.nodes[s].kids2.clone()
            let body = kids[kids.len - 1]
            var seqs = List(CV).new()
            for l, i in locals {
                let v = self.it_eval(kids[i]) orelse return FL_FAIL
                let items = cv_seq_items(&v) orelse return FL_FAIL
                seqs.append(cv_seq(VK_LIST, items))
            }
            var n: usize = 0
            var first = true
            var mismatch = false
            for sq in seqs {
                if first { n = sq.items.len; first = false }
                else if sq.items.len != n { mismatch = true }
            }
            if mismatch {
                self.it_fail_panic("parallel iteration over slices of different lengths", self.tir.nodes[body].start)
                return FL_FAIL
            }
            for i in 0..n {
                if !self.it_step() { return FL_FAIL }
                for l, j in locals { self.it_env_set(l, cv_clone(&seqs[j].items[i])) }
                if index != NONE { self.it_env_set(index, cv_int(i as i128)) }
                let f = self.it_exec_block(body)
                if f == FL_FAIL { return FL_FAIL }
                if f == FL_BREAK and self.it_flow_label == label { break }
                if f != FL_NEXT and ! (f == FL_CONTINUE and self.it_flow_label == label) { return f }
            }
            return FL_NEXT
        }
        if k == TKind.SBlock or k == TKind.SUsing { return self.it_exec_block(kids[0]) }
        if k == TKind.SDrop { return FL_NEXT }
        return FL_FAIL
    }

    /// Resolve a place expression to a frame, a root local and a path of indices.
    fn it_place_path(self: *mut Self, e: usize, fi: *mut usize, l: *mut usize, path: *mut List(usize)) -> bool {
        let k = self.tir.nodes[e].k
        let kids = self.tir.nodes[e].kids.clone()
        if k == TKind.Local {
            fi.*= self.frames.len - 1
            l.*= self.tir.nodes[e].a
            path.clear()
            return true
        }
        if k == TKind.Field or k == TKind.TupleField or k == TKind.RefField {
            if !self.it_place_path(kids[0], fi, l, path) { return false }
            path.append(self.tir.nodes[e].a)
            return true
        }
        if k == TKind.Index {
            let iv = self.it_eval(kids[1]) orelse return false
            let i = cv_as_int(&iv) orelse return false
            if !self.it_place_path(kids[0], fi, l, path) { return false }
            path.append(i as usize)
            return true
        }
        if k == TKind.Deref {
            let p = self.it_eval(kids[0]) orelse return false
            if p.kind != VK_PTR { return false }
            fi.*= p.ival as usize
            l.*= p.b
            path.clear()
            for x in p.path { path.append(x) }
            return true
        }
        if k == TKind.ListToSlice or k == TKind.ArrayToSlice or k == TKind.StrToSlice { return self.it_place_path(kids[0], fi, l, path) }
        return false
    }

    /// The place a mutating builtin acts on: the receiver place, following
    /// any pointer stored there.
    fn it_recv_place(self: *mut Self, e: usize, fi: *mut usize, l: *mut usize, path: *mut List(usize)) -> bool {
        if !self.it_place_path(e, fi, l, path) { return false }
        while true {
            let cur = self.it_walk(fi.*, l.*, path)
            if cur.kind == VK_NONE { return false }
            if cur.kind != VK_PTR { return true }
            let nfi = cur.ival as usize
            let nl = cur.b
            let np = cur.path.clone()
            fi.*= nfi
            l.*= nl
            path.clear()
            for x in np { path.append(x) }
        }
        return true
    }

    /// Follow a path into a frame's local; `cv_bad` (kind `VK_NONE`) when it
    /// does not exist.
    fn it_walk(self: *mut Self, fi: usize, l: usize, path: *List(usize)) -> *mut CV{
        if fi >= self.frames.len or l >= self.frames[fi].vals.len { return &mut self.cv_bad }
        var cur: *mut CV = &mut self.frames[fi].vals[l]
        if cur.kind == VK_NONE { return &mut self.cv_bad }
        for step in path {
            let k = cur.kind
            if k == VK_ARRAY or k == VK_LIST or k == VK_STRUCT or k == VK_TUPLE or k == VK_ENUM {
                if step >= cur.items.len { return &mut self.cv_bad }
                cur = &mut cur.items[step]
            } else if (k == VK_SOME or k == VK_OK) and step == 0 {
                cur = &mut cur.items[0]
            } else {
                return &mut self.cv_bad
            }
        }
        return cur
    }

    fn it_read_path(self: *mut Self, root: *CV, path: []usize) -> ?CV {
        var cur: *CV = root
        for step in path {
            let k = cur.kind
            if k == VK_ARRAY or k == VK_LIST or k == VK_STRUCT or k == VK_TUPLE or k == VK_ENUM {
                if step >= cur.items.len { return null }
                cur = &cur.items[step]
            } else if (k == VK_SOME or k == VK_OK) and step == 0 {
                cur = &cur.items[0]
            } else if k == VK_OWNED_STR or k == VK_STR {
                if step >= cur.text.len { return null }
                return cv_int(cur.text[step] as i128)
            } else {
                return null
            }
        }
        return cv_clone(cur)
    }

    fn it_assign(self: *mut Self, target: usize, own v: CV) -> bool {
        var fi = NONE
        var l = NONE
        var path = List(usize).new()
        if !self.it_place_path(target, &mut fi, &mut l, &mut path) { return false }
        if path.len == 0 {
            if fi >= self.frames.len { return false }
            while self.frames[fi].vals.len <= l { self.frames[fi].vals.append(cv(VK_NONE)) }
            self.frames[fi].vals[l] = v
            return true
        }
        var prefix = List(usize).new()
        for x, i in path { if i + 1 < path.len { prefix.append(x) } }
        let last = path[path.len - 1]
        let parent = self.it_walk(fi, l, &prefix)
        if parent.kind == VK_NONE { return false }
        let pk = parent.kind
        if pk == VK_OWNED_STR {
            let b = cv_as_int(&v) orelse return false
            if last >= parent.text.len { return false }
            parent.text[last] = b as u8
            return true
        }
        if pk == VK_ARRAY or pk == VK_LIST or pk == VK_STRUCT or pk == VK_TUPLE or pk == VK_ENUM {
            if last >= parent.items.len { return false }
            parent.items[last] = v
            return true
        }
        if (pk == VK_SOME or pk == VK_OK) and last == 0 {
            parent.items[0] = v
            return true
        }
        return false
    }

    fn it_escape(self: *mut Self, flow: u8, label: usize, own v: CV) -> CV {
        self.it_pending = flow
        self.it_pending_label = label
        self.it_pending_val = v
        return cv(VK_NEVER)
    }

    fn it_eval(self: *mut Self, e: usize) -> ?CV {
        let r = self.it_eval_inner(e)
        if r == null and !self.it_has_panic and !self.it_budget and self.it_failed_at == NONE {
            self.it_failed_at = self.tir.nodes[e].start
        }
        return r
    }

    /// A block used as an expression: its value, or an escaping flow.
    fn it_block_value(self: *mut Self, b: usize) -> ?CV {
        let f = self.it_exec_block(b)
        if f == FL_FAIL { return null }
        if f == FL_NEXT {
            if self.it_out.kind == VK_NONE { return cv(VK_VOID) }
            return cv_clone(&self.it_out)
        }
        return self.it_escape(f, self.it_flow_label, cv_clone(&self.it_flow_val))
    }

    fn it_eval_inner(self: *mut Self, e: usize) -> ?CV {
        if !self.it_step() { return null }
        if self.it_pending != 0 { return cv(VK_NEVER) }
        let k = self.tir.nodes[e].k
        let kids = self.tir.nodes[e].kids.clone()
        let a = self.tir.nodes[e].a
        let ty = self.tir.nodes[e].ty
        let at = self.tir.nodes[e].start
        if k == TKind.Int { return cv_int(self.tir.nodes[e].ival) }
        if k == TKind.Float { return cv_float(self.tir.nodes[e].fval) }
        if k == TKind.Bool { return cv_bool(self.tir.nodes[e].flag) }
        if k == TKind.Char { return cv_char(self.tir.nodes[e].ival) }
        if k == TKind.Str { return cv_str(self.tir.nodes[e].text[..]) }
        if k == TKind.Unit { return cv(VK_VOID) }
        if k == TKind.Value { return self.value_of_node(e) }
        if k == TKind.Local { return self.it_env_get(a) }
        if k == TKind.Global { return null }
        if k == TKind.Const {
            _ = self.resolve_const(a)
            let init = self.consts[a].value
            if init == NONE or self.tir.nodes[init].k != TKind.Value { return null }
            return self.value_of_node(init)
        }
        if k == TKind.FnRef or k == TKind.FnToFat {
            var v = cv(VK_FN)
            v.ival = a as i128
            return v
        }
        if k == TKind.Field or k == TKind.RefField or k == TKind.TupleField {
            let bv = self.it_eval(kids[0]) orelse return null
            var path = List(usize).new()
            path.append(a)
            return self.it_read_path(&bv, path[..])
        }
        if k == TKind.Index {
            let bv = self.it_eval(kids[0]) orelse return null
            let iv = self.it_eval(kids[1]) orelse return null
            let i = cv_as_int(&iv) orelse return null
            let len = cv_seq_len(&bv) orelse return null
            if i < 0 or i as usize >= len {
                self.it_fail_panic(format("index {} out of bounds for length {}", .{i, len})[..], at)
                return null
            }
            var path = List(usize).new()
            path.append(i as usize)
            return self.it_read_path(&bv, path[..])
        }
        if k == TKind.SliceOp {
            let bv = self.it_eval(kids[0]) orelse return null
            let has_start = self.tir.nodes[e].flag
            let has_end = self.tir.nodes[e].flag2
            var next: usize = 1
            var s: usize = 0
            if has_start {
                let sv = self.it_eval(kids[next]) orelse return null
                s = (cv_as_int(&sv) orelse return null) as usize
                next += 1
            }
            let len = cv_seq_len(&bv) orelse return null
            var en = len
            if has_end {
                let ev = self.it_eval(kids[next]) orelse return null
                en = (cv_as_int(&ev) orelse return null) as usize
            }
            if s > en or en > len {
                self.it_fail_panic(format("slice bounds {}..{} out of range for length {}", .{s, en, len})[..], at)
                return null
            }
            if bv.kind == VK_ARRAY or bv.kind == VK_LIST {
                var items = List(CV).new()
                for i in s..en { items.append(cv_clone(&bv.items[i])) }
                return cv_seq(VK_ARRAY, items)
            }
            if bv.kind == VK_STR or bv.kind == VK_OWNED_STR { return cv_str(bv.text[s..en]) }
            return null
        }
        if k == TKind.Deref {
            let p = self.it_eval(kids[0]) orelse return null
            if p.kind != VK_PTR { return null }
            let fi = p.ival as usize
            let l = p.b
            if fi >= self.frames.len or l >= self.frames[fi].vals.len { return null }
            if self.frames[fi].vals[l].kind == VK_NONE { return null }
            let root = cv_clone(&self.frames[fi].vals[l])
            return self.it_read_path(&root, p.path[..])
        }
        if k == TKind.AddrOf {
            var fi = NONE
            var l = NONE
            var path = List(usize).new()
            if self.it_place_path(kids[0], &mut fi, &mut l, &mut path) { return cv_ptr(fi, l, path) }
            // the address of a temporary: give the value a slot of its own
            let v = self.it_eval(kids[0]) orelse return null
            let cur = self.frames.len - 1
            let id = self.frames[cur].vals.len
            self.frames[cur].vals.append(v)
            return cv_ptr(cur, id, List(usize).new())
        }
        if k == TKind.Call {
            var vs = List(CV).new()
            for x in kids { vs.append(self.it_eval(x) orelse return null) }
            return self.it_call(a, vs)
        }
        if k == TKind.CallPtr {
            let f = self.it_eval(kids[0]) orelse return null
            var vs = List(CV).new()
            for x, i in kids { if i > 0 { vs.append(self.it_eval(x) orelse return null) } }
            if f.kind != VK_FN { return null }
            return self.it_call(f.ival as usize, vs)
        }
        if k == TKind.Builtin { return self.it_eval_builtin(e) }
        if k == TKind.Unary {
            let v = self.it_eval(kids[0]) orelse return null
            let op = self.tir.nodes[e].text.clone()
            let mode = self.tir.nodes[e].name.clone()
            if op == "!" and v.kind == VK_BOOL { return cv_bool(!v.flag) }
            if op == "-" and v.kind == VK_FLOAT { return cv_float(-v.fval) }
            if op == "-" and v.kind == VK_INT {
                let r = -v.ival
                if mode == "checked" {
                    var lo: i128 = 0
                    var hi: i128 = 0
                    if self.it_int_range(ty, &mut lo, &mut hi) {
                        if r < lo or r > hi {
                            self.it_fail_panic("integer overflow in negation", at)
                            return null
                        }
                    }
                }
                return cv_int(r)
            }
            if op == "~" and v.kind == VK_INT {
                var bits: u32 = 64
                var signed = true
                _ = self.it_bits_of(ty, &mut bits, &mut signed)
                return cv_int(wrap_to(~v.ival, bits, signed))
            }
            if op == "~" and v.kind == VK_BOOL { return cv_bool(!v.flag) }
            return null
        }
        if k == TKind.Binary {
            let av = self.it_eval(kids[0]) orelse return null
            let bv = self.it_eval(kids[1]) orelse return null
            let op = self.tir.nodes[e].text.clone()
            let mode = self.tir.nodes[e].name.clone()
            return self.it_binop(op[..], mode[..], av, bv, self.tir.nodes[kids[0]].ty, at)
        }
        if k == TKind.Logical {
            let is_and = self.tir.nodes[e].flag
            let av = self.it_eval(kids[0]) orelse return null
            let x = cv_as_bool(&av) orelse return null
            if is_and and !x { return cv_bool(false) }
            if !is_and and x { return cv_bool(true) }
            let bv = self.it_eval(kids[1]) orelse return null
            let y = cv_as_bool(&bv) orelse return null
            return cv_bool(y)
        }
        if k == TKind.Cast {
            let v = self.it_eval(kids[0]) orelse return null
            let kind = self.tir.nodes[e].name.clone()
            if kind.len >= 10 and kind[0..10] == "int_to_int" {
                let checked = kind == "int_to_int checked=true"
                let i = cv_as_int(&v) orelse return null
                var lo: i128 = 0
                var hi: i128 = 0
                if self.it_int_range(ty, &mut lo, &mut hi) {
                    if i < lo or i > hi {
                        if checked {
                            self.it_fail_panic(format("value {} does not fit the target type", .{i})[..], at)
                            return null
                        }
                        var bits: u32 = 64
                        var signed = true
                        if !self.it_bits_of(ty, &mut bits, &mut signed) { return null }
                        return cv_int(wrap_to(i, bits, signed))
                    }
                }
                if self.tys.kind(self.tys.shallow(ty)) == TK.Char { return cv_char(i) }
                return cv_int(i)
            }
            if kind == "int_to_float" { let i = cv_as_int(&v) orelse return null; return cv_float(i as f64) }
            if kind == "float_to_int" {
                let f = cv_as_float(&v) orelse return null
                let i = f as i128
                var lo: i128 = 0
                var hi: i128 = 0
                if self.it_int_range(ty, &mut lo, &mut hi) {
                    if f != f or f > 1.0e300 or f < -1.0e300 or i < lo or i > hi {
                        self.it_fail_panic("float to integer cast out of range", at)
                        return null
                    }
                }
                return cv_int(i)
            }
            if kind == "float_to_float" { let f = cv_as_float(&v) orelse return null; return cv_float(f) }
            if kind == "bits" {
                if v.kind == VK_BOOL { return cv_int(if v.flag { 1 } else { 0 }) }
                if v.kind == VK_CHAR { return cv_int(v.ival) }
                if v.kind == VK_ENUM { return cv_int(v.ival) }
                return v
            }
            return null
        }
        if k == TKind.If {
            let c = self.it_eval(kids[0]) orelse return null
            let cb = cv_as_bool(&c) orelse return null
            if cb { return self.it_block_value(kids[1]) }
            if kids.len > 2 { return self.it_block_value(kids[2]) }
            return cv(VK_VOID)
        }
        if k == TKind.IfCapture {
            let c = self.it_eval(kids[0]) orelse return null
            if c.kind == VK_SOME {
                self.it_env_set(a, cv_clone(&c.items[0]))
                return self.it_block_value(kids[1])
            }
            if c.kind == VK_NULL {
                if kids.len > 2 { return self.it_block_value(kids[2]) }
                return cv(VK_VOID)
            }
            return null
        }
        if k == TKind.Match {
            let scrutinee = kids[0]
            let v = self.it_eval(scrutinee) orelse return null
            // `match p.*`: payload bindings typed as pointers point into the place
            var has_place = false
            var pfi = NONE
            var pl = NONE
            var ppath = List(usize).new()
            if self.tir.nodes[scrutinee].k == TKind.Deref {
                has_place = self.it_place_path(scrutinee, &mut pfi, &mut pl, &mut ppath)
            }
            var i: usize = 1
            while i < kids.len {
                let arm = kids[i]
                let akids = self.tir.nodes[arm].kids.clone()
                let has_guard = self.tir.nodes[arm].flag
                let m = self.it_match_pat(akids[0], &v, has_place, pfi, pl, &ppath)
                if m < 0 { return null }
                if m == 1 {
                    var body = akids[1]
                    if has_guard {
                        let g = self.it_eval(akids[1]) orelse return null
                        let gb = cv_as_bool(&g) orelse return null
                        if !gb { i += 1; continue }
                        body = akids[2]
                    }
                    return self.it_eval(body)
                }
                i += 1
            }
            self.it_fail_panic("no match arm matched", at)
            return null
        }
        if k == TKind.BlockExpr { return self.it_block_value(kids[0]) }
        if k == TKind.StructLit or k == TKind.RefNew {
            let idxs = self.tir.nodes[e].kids2.clone()
            var n: usize = 0
            for i in idxs { if i + 1 > n { n = i + 1 } }
            var vals = List(CV).new()
            for i in 0..n { vals.append(cv(VK_UNDEFINED)) }
            for f, i in kids { vals[idxs[i]] = self.it_eval(f) orelse return null }
            return cv_seq(VK_STRUCT, vals)
        }
        if k == TKind.EnumLit {
            var vals = List(CV).new()
            for p in kids { vals.append(self.it_eval(p) orelse return null) }
            var v = cv_seq(VK_ENUM, vals)
            v.ival = a as i128
            return v
        }
        if k == TKind.ArrayLit or k == TKind.TupleLit {
            var vals = List(CV).new()
            for x in kids { vals.append(self.it_eval(x) orelse return null) }
            return cv_seq(if k == TKind.ArrayLit { VK_ARRAY } else { VK_TUPLE }, vals)
        }
        if k == TKind.ArrayRepeat {
            let v = self.it_eval(kids[0]) orelse return null
            var vals = List(CV).new()
            for i in 0..a { vals.append(cv_clone(&v)) }
            return cv_seq(VK_ARRAY, vals)
        }
        if k == TKind.Try {
            let v = self.it_eval(kids[0]) orelse return null
            if v.kind == VK_OK { return cv_clone(&v.items[0]) }
            if v.kind == VK_ERR { return self.it_escape(FL_RETURN, NONE, v) }
            return v
        }
        if k == TKind.Catch {
            let v = self.it_eval(kids[0]) orelse return null
            if v.kind == VK_OK { return cv_clone(&v.items[0]) }
            if v.kind == VK_ERR {
                if a != NONE { self.it_env_set(a, cv_clone(&v)) }
                return self.it_eval(kids[1])
            }
            return v
        }
        if k == TKind.OrElse {
            let v = self.it_eval(kids[0]) orelse return null
            if v.kind == VK_SOME { return cv_clone(&v.items[0]) }
            if v.kind == VK_NULL { return self.it_eval(kids[1]) }
            return null
        }
        if k == TKind.Unwrap {
            let v = self.it_eval(kids[0]) orelse return null
            if v.kind == VK_SOME { return cv_clone(&v.items[0]) }
            if v.kind == VK_NULL {
                self.it_fail_panic("unwrapped a null optional", at)
                return null
            }
            return null
        }
        if k == TKind.OptWrap { let v = self.it_eval(kids[0]) orelse return null; return cv_wrap(VK_SOME, v) }
        if k == TKind.OptNull { return cv(VK_NULL) }
        if k == TKind.ErrWrap { let v = self.it_eval(kids[0]) orelse return null; return cv_wrap(VK_OK, v) }
        if k == TKind.ErrToUnion { return self.it_eval(kids[0]) }
        if k == TKind.ErrVal { return cv_err(a) }
        if k == TKind.ArrayToSlice {
            let v = self.it_eval(kids[0]) orelse return null
            if v.kind == VK_ARRAY or v.kind == VK_STR { return v }
            return null
        }
        if k == TKind.ListToSlice {
            var v = self.it_eval(kids[0]) orelse return null
            if v.kind == VK_LIST or v.kind == VK_ARRAY { v.kind = VK_ARRAY; return v }
            return null
        }
        if k == TKind.StrToSlice {
            var v = self.it_eval(kids[0]) orelse return null
            if v.kind == VK_OWNED_STR or v.kind == VK_STR { v.kind = VK_STR; return v }
            return null
        }
        if k == TKind.Closure { return null }
        if k == TKind.Unreachable {
            self.it_fail_panic("reached `unreachable`", at)
            return null
        }
        if k == TKind.Undefined { return cv(VK_UNDEFINED) }
        if k == TKind.BinConstruct { return null }
        if k == TKind.TypeVal {
            var v = cv(VK_TYPE)
            v.ival = a as i128
            return v
        }
        if k == TKind.RecordCheck {
            let as_error = self.tir.nodes[e].flag
            let v = self.it_eval(kids[0]) orelse return null
            let fields = self.tir.nodes[e].kids2.clone()
            var i: usize = 1
            while i < kids.len {
                let idx = fields[(i - 1) * 2]
                let local = fields[(i - 1) * 2 + 1]
                var path = List(usize).new()
                path.append(idx)
                let fv = self.it_read_path(&v, path[..]) orelse return null
                self.it_env_set(local, fv)
                let okv = self.it_eval(kids[i]) orelse return null
                let ok = cv_as_bool(&okv) orelse return null
                if !ok {
                    if as_error { return cv_err(self.error_id("InvalidRecord")) }
                    self.it_fail_panic("record constraint violated", at)
                    return null
                }
                i += 1
            }
            if as_error { return cv_wrap(VK_OK, v) }
            return v
        }
        if k == TKind.Retained { return self.it_eval(kids[0]) }
        return null
    }

    fn it_int_range(self: *mut Self, t0: usize, lo: *mut i128, hi: *mut i128) -> bool {
        let t = self.tys.shallow(t0)
        let k = self.tys.kind(t)
        if k == TK.Int {
            let nm = self.tys.list[t].name.clone()
            lo.*= int_min(nm[..])
            hi.*= int_max(nm[..])
            return true
        }
        if k == TK.Distinct { return self.it_int_range(self.distinct_underlying(self.tys.list[t].def), lo, hi) }
        return false
    }

    fn it_bits_of(self: *mut Self, t0: usize, bits: *mut u32, signed: *mut bool) -> bool {
        let t = self.tys.shallow(t0)
        let k = self.tys.kind(t)
        if k == TK.Int {
            let nm = self.tys.list[t].name.clone()
            bits.*= int_bits(nm[..])
            signed.*= int_signed(nm[..])
            return true
        }
        if k == TK.Distinct { return self.it_bits_of(self.distinct_underlying(self.tys.list[t].def), bits, signed) }
        return false
    }

    /// -1 when evaluation failed, 0 for no match, 1 for a match (bindings set).
    fn it_match_pat(self: *mut Self, p: usize, v: *CV, has_place: bool, pfi: usize, pl: usize, ppath: *List(usize)) -> i8 {
        let k = self.tir.nodes[p].k
        let a = self.tir.nodes[p].a
        let kids = self.tir.nodes[p].kids.clone()
        if k == TKind.PWild { return 1 }
        if k == TKind.PBind {
            var by_ptr = false
            if has_place and self.it_cur_fn != NONE {
                let lt = self.insts[self.it_cur_fn].locals[a].ty
                by_ptr = self.tys.kind(self.tys.shallow(lt)) == TK.Ptr and v.kind != VK_PTR
            }
            if by_ptr { self.it_env_set(a, cv_ptr(pfi, pl, ppath.clone())) }
            else { self.it_env_set(a, cv_clone(v)) }
            return 1
        }
        if k == TKind.PInt { let i = cv_as_int(v) orelse return 0; return if i == self.tir.nodes[p].ival { 1 } else { 0 } }
        if k == TKind.PFloat { let f = cv_as_float(v) orelse return 0; return if f == self.tir.nodes[p].fval { 1 } else { 0 } }
        if k == TKind.PBool { return if v.kind == VK_BOOL and v.flag == self.tir.nodes[p].flag { 1 } else { 0 } }
        if k == TKind.PChar {
            if v.kind == VK_CHAR or v.kind == VK_INT { return if v.ival == self.tir.nodes[p].ival { 1 } else { 0 } }
            return 0
        }
        if k == TKind.PStr {
            if v.kind == VK_STR or v.kind == VK_OWNED_STR { return if v.text[..] == self.tir.nodes[p].text[..] { 1 } else { 0 } }
            return 0
        }
        if k == TKind.PRange {
            let i = cv_as_int(v) orelse return -1
            let lo = self.tir.nodes[p].ival
            let hi = self.tir.nodes[p].text[..].parse_int(i128) catch { 0 }
            let inclusive = self.tir.nodes[p].flag
            return if i >= lo and (if inclusive { i <= hi } else { i < hi }) { 1 } else { 0 }
        }
        if k == TKind.PVariant {
            if v.kind != VK_ENUM or v.ival != a as i128 { return 0 }
            for q, i in kids {
                if i >= v.items.len { break }
                var sub = ppath.clone()
                sub.append(i)
                let r = self.it_match_pat(q, &v.items[i], has_place, pfi, pl, &sub)
                if r != 1 { return r }
            }
            return 1
        }
        if k == TKind.PError { return if v.kind == VK_ERR and v.ival == a as i128 { 1 } else { 0 } }
        if k == TKind.PNull { return if v.kind == VK_NULL { 1 } else { 0 } }
        if k == TKind.PSome {
            if v.kind != VK_SOME { return 0 }
            var sub = ppath.clone()
            sub.append(0)
            return self.it_match_pat(kids[0], &v.items[0], has_place, pfi, pl, &sub)
        }
        if k == TKind.POk {
            if v.kind == VK_OK {
                var sub = ppath.clone()
                sub.append(0)
                return self.it_match_pat(kids[0], &v.items[0], has_place, pfi, pl, &sub)
            }
            if v.kind == VK_ERR { return 0 }
            return self.it_match_pat(kids[0], v, has_place, pfi, pl, ppath)
        }
        if k == TKind.POr {
            for q in kids {
                let r = self.it_match_pat(q, v, has_place, pfi, pl, ppath)
                if r != 0 { return r }
            }
            return 0
        }
        if k == TKind.PTuple {
            if v.kind != VK_TUPLE or v.items.len != kids.len { return 0 }
            for q, i in kids {
                var sub = ppath.clone()
                sub.append(i)
                let r = self.it_match_pat(q, &v.items[i], has_place, pfi, pl, &sub)
                if r != 1 { return r }
            }
            return 1
        }
        if k == TKind.PBinary {
            var bytes = String.new()
            if v.kind == VK_STR or v.kind == VK_OWNED_STR { bytes = v.text.clone() }
            else if v.kind == VK_ARRAY {
                for x in v.items { bytes.push_byte((cv_as_int(&x) orelse 0) as u8) }
            } else { return -1 }
            return self.it_match_binary(kids[..], bytes[..])
        }
        return -1
    }

    fn it_match_binary(self: *mut Self, segs: []usize, bytes: []u8) -> i8 {
        var bit: usize = 0
        let total_bits = bytes.len * 8
        var any_rest = false
        for seg in segs {
            let desc = self.tir.nodes[seg].name.clone()
            let skids = self.tir.nodes[seg].kids.clone()
            // "bind 5 size=bits 8 endian=big signed=false float=false utf8=false"
            let words = Checker.split_words(desc[..])
            let kind = words[0].clone()
            var wi: usize = 1
            var local = NONE
            if kind == "bind" or kind == "rest" { local = words[1][..].parse_int(usize) catch { NONE }; wi = 2 }
            let size_word = words[wi].clone()
            var size_bits: usize = 0
            var value_kid = NONE
            var size_kid = NONE
            if kind == "value" { value_kid = skids[0] }
            if size_word == "size=expr" {
                size_kid = skids[skids.len - 1]
                let sv = self.it_eval(size_kid) orelse return -1
                size_bits = (cv_as_int(&sv) orelse return -1) as usize
                wi += 1
            } else if size_word == "size=rest" {
                size_bits = total_bits - bit
                any_rest = true
                wi += 1
            } else {
                // "size=bits" "8"
                size_bits = words[wi + 1][..].parse_int(usize) catch { 0 }
                wi += 2
            }
            let endian = words[wi].clone()
            let signed = words[wi + 1] == "signed=true"
            let float = words[wi + 2] == "float=true"
            if bit + size_bits > total_bits { return 0 }
            let seg_ty = self.tir.nodes[seg].ty
            let is_bytes = self.tys.kind(self.tys.shallow(seg_ty)) == TK.Slice or size_word == "size=rest"
            if is_bytes {
                if bit % 8 != 0 or size_bits % 8 != 0 { return 0 }
                let sl = bytes[bit / 8..bit / 8 + size_bits / 8]
                if kind == "value" {
                    let want = self.it_eval(value_kid) orelse return -1
                    if ! (want.kind == VK_STR or want.kind == VK_OWNED_STR) { return -1 }
                    if want.text[..] != sl { return 0 }
                } else {
                    self.it_env_set(local, cv_str(sl))
                }
            } else {
                var raw: u128 = 0
                for i in 0..size_bits {
                    let b = bit + i
                    let bitv = (bytes[b / 8] >> ((7 - (b % 8)) as u8)) & 1
                    raw = (raw << 1) | (bitv as u128)
                }
                if endian == "endian=little" and size_bits % 8 == 0 and size_bits > 8 {
                    var r: u128 = 0
                    let nb = size_bits / 8
                    for i in 0..nb {
                        r |= ((raw >> ((i * 8) as u32)) & 0xff) << (((nb - 1 - i) * 8) as u32)
                    }
                    raw = r
                }
                var val = cv(VK_NONE)
                if float {
                    val = cv_float(if size_bits == 32 { f32_from_bits(raw as u32) } else { f64_from_bits(raw as u64) })
                } else if signed and size_bits < 128 {
                    let m: i128 = 1 << (size_bits as u32)
                    var r = raw as i128
                    if r >= m / 2 { r -= m }
                    val = cv_int(r)
                } else {
                    val = cv_int(raw as i128)
                }
                if kind == "value" {
                    let want = self.it_eval(value_kid) orelse return -1
                    var eq = false
                    if want.kind == VK_FLOAT and val.kind == VK_FLOAT { eq = want.fval == val.fval }
                    else {
                        let wi2 = cv_as_int(&want) orelse return -1
                        let vi2 = cv_as_int(&val) orelse return -1
                        eq = wi2 == vi2
                    }
                    if !eq { return 0 }
                } else {
                    self.it_env_set(local, val)
                }
            }
            bit += size_bits
        }
        return if bit == total_bits or any_rest { 1 } else { 0 }
    }

    fn it_binop(self: *mut Self, op: []u8, mode: []u8, a: CV, b: CV, ty: usize, at: usize) -> ?CV {
        let is_cmp = op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">="
        if is_cmp {
            // -1 less, 0 equal, 1 greater, 2 unordered
            var r: i8 = 2
            let a_str = a.kind == VK_STR or a.kind == VK_OWNED_STR
            let b_str = b.kind == VK_STR or b.kind == VK_OWNED_STR
            if a.kind == VK_FLOAT and b.kind == VK_FLOAT {
                if a.fval != a.fval or b.fval != b.fval { r = 2 }
                else if a.fval < b.fval { r = -1 } else if a.fval > b.fval { r = 1 } else { r = 0 }
            } else if a_str and b_str {
                r = cmp_bytes(a.text[..], b.text[..])
            } else if a.kind == VK_NULL and b.kind == VK_NULL {
                r = 0
            } else if (a.kind == VK_SOME or a.kind == VK_NULL) and (b.kind == VK_SOME or b.kind == VK_NULL) {
                r = -1
            } else if a.kind == VK_ENUM and b.kind == VK_ENUM {
                r = if a.ival < b.ival { -1 } else if a.ival > b.ival { 1 } else { 0 }
            } else if a.kind == VK_ERR and b.kind == VK_ERR {
                r = if a.ival < b.ival { -1 } else if a.ival > b.ival { 1 } else { 0 }
            } else if (a.kind == VK_STRUCT and b.kind == VK_STRUCT) or (a.kind == VK_ARRAY and b.kind == VK_ARRAY) {
                r = if cv_eq(&a, &b) { 0 } else { -1 }
            } else {
                let x = cv_as_int(&a) orelse return null
                let y = cv_as_int(&b) orelse return null
                r = if x < y { -1 } else if x > y { 1 } else { 0 }
            }
            if r == 2 { return cv_bool(op == "!=") }
            if op == "==" { return cv_bool(r == 0) }
            if op == "!=" { return cv_bool(r != 0) }
            if op == "<" { return cv_bool(r == -1) }
            if op == "<=" { return cv_bool(r != 1) }
            if op == ">" { return cv_bool(r == 1) }
            return cv_bool(r != -1)
        }
        if a.kind == VK_BOOL and b.kind == VK_BOOL {
            if op == "&" { return cv_bool(a.flag and b.flag) }
            if op == "|" { return cv_bool(a.flag or b.flag) }
            if op == "^" { return cv_bool(a.flag != b.flag) }
            return null
        }
        if mode == "float" {
            let x = cv_as_float(&a) orelse return null
            let y = cv_as_float(&b) orelse return null
            if op == "+" { return cv_float(x + y) }
            if op == "-" { return cv_float(x - y) }
            if op == "*" { return cv_float(x * y) }
            if op == "/" { return cv_float(x / y) }
            if op == "%" { return cv_float(x % y) }
            return null
        }
        let x = cv_as_int(&a) orelse return null
        let y = cv_as_int(&b) orelse return null
        var bits: u32 = 64
        var signed = true
        _ = self.it_bits_of(ty, &mut bits, &mut signed)
        var lo: i128 = -9223372036854775808
        var hi: i128 = 9223372036854775807
        _ = self.it_int_range(ty, &mut lo, &mut hi)
        var raw: ?i128 = null
        if op == "+" or op == "+%" or op == "+|" { raw = checked_add(x, y) }
        else if op == "-" or op == "-%" or op == "-|" { raw = checked_sub(x, y) }
        else if op == "*" or op == "*%" or op == "*|" { raw = checked_mul(x, y) }
        else if op == "/" {
            if y == 0 { self.it_fail_panic("division by zero", at); return null }
            raw = x / y
        } else if op == "%" {
            if y == 0 { self.it_fail_panic("remainder by zero", at); return null }
            raw = x % y
        } else if op == "&" { raw = x & y }
        else if op == "|" { raw = x | y }
        else if op == "^" { raw = x ^ y }
        else if op == "<<" {
            if y < 0 or y >= bits as i128 { self.it_fail_panic("shift amount exceeds the bit width", at); return null }
            raw = wrap_to(x << (y as u32), bits, signed)
        } else if op == ">>" {
            if y < 0 or y >= bits as i128 { self.it_fail_panic("shift amount exceeds the bit width", at); return null }
            raw = x >> (y as u32)
        } else {
            return null
        }
        let r = raw orelse {
            self.it_fail_panic("integer overflow", at)
            return null
        }
        if mode == "checked" {
            if r < lo or r > hi {
                self.it_fail_panic(format("integer overflow: {} {} {} does not fit", .{x, op, y})[..], at)
                return null
            }
            return cv_int(r)
        }
        if mode == "wrap" { return cv_int(wrap_to(r, bits, signed)) }
        if mode == "sat" { return cv_int(if r < lo { lo } else if r > hi { hi } else { r }) }
        return cv_int(r)
    }

    fn it_eval_builtin(self: *mut Self, e: usize) -> ?CV {
        let name = self.tir.nodes[e].name.clone()
        let args = self.tir.nodes[e].kids.clone()
        let tys = self.tir.nodes[e].kids2.clone()
        let at = self.tir.nodes[e].start
        var vs = List(CV).new()
        for x in args { vs.append(self.it_eval(x) orelse return null) }
        if name == "Len" {
            if vs[0].kind == VK_MAP { return cv_int((vs[0].items.len / 2) as i128) }
            let n = cv_seq_len(&vs[0]) orelse return null
            return cv_int(n as i128)
        }
        // ---- lists, mutating through the receiver place
        if name == "ListClear" or name == "ListInsert" or name == "ListRemove" or name == "ListSwapRemove" or name == "ListExtend"
            or name == "ListAppend" or name == "ListPop" or name == "StringClear" or name == "StringPop" or name == "MapPut"
            or name == "MapRemove" or name == "MapClear" or name == "SliceCopy" or name == "SliceFill" or name == "SliceReverse"
            or name == "SliceSort" or name == "StringAppend" or name == "StringAppendChar" or name == "StringPushByte" {
            var fi = NONE
            var l = NONE
            var path = List(usize).new()
            if !self.it_recv_place(args[0], &mut fi, &mut l, &mut path) { return null }
            let cur = self.it_walk(fi, l, &path)
            if cur.kind == VK_NONE { return null }
            return self.it_mutating_builtin(name[..], cur, &vs, at)
        }
        if name == "ListReserve" { return cv(VK_VOID) }
        if name == "MapNew" { return cv_seq(VK_MAP, List(CV).new()) }
        if name == "MapGet" {
            if vs[0].kind != VK_MAP { return null }
            var i: usize = 0
            while i + 1 < vs[0].items.len {
                if cv_key_eq(&vs[0].items[i], &vs[1]) { return cv_wrap(VK_SOME, cv_clone(&vs[0].items[i + 1])) }
                i += 2
            }
            return cv(VK_NULL)
        }
        if name == "MapContains" {
            if vs[0].kind != VK_MAP { return null }
            var i: usize = 0
            while i + 1 < vs[0].items.len {
                if cv_key_eq(&vs[0].items[i], &vs[1]) { return cv_bool(true) }
                i += 2
            }
            return cv_bool(false)
        }
        if name == "MapKeys" or name == "MapValues" {
            if vs[0].kind != VK_MAP { return null }
            var out = List(CV).new()
            var i: usize = if name == "MapKeys" { 0 } else { 1 }
            while i < vs[0].items.len { out.append(cv_clone(&vs[0].items[i])); i += 2 }
            return cv_seq(VK_LIST, out)
        }
        if name == "SliceIndexOf" {
            let items = cv_seq_items(&vs[0]) orelse return null
            for x, i in items { if cv_key_eq(&x, &vs[1]) { return cv_wrap(VK_SOME, cv_int(i as i128)) } }
            return cv(VK_NULL)
        }
        if name == "SliceFind" {
            let hay = cv_bytes(&vs[0]) orelse return null
            let needle = cv_bytes(&vs[1]) orelse return null
            if needle.len == 0 { return cv_wrap(VK_SOME, cv_int(0)) }
            if let i = find_sub(hay, needle) { return cv_wrap(VK_SOME, cv_int(i as i128)) }
            return cv(VK_NULL)
        }
        if name == "SliceTrim" {
            let s = cv_bytes(&vs[0]) orelse return null
            return cv_owned(trim_ascii(s))
        }
        if name == "SliceSplit" {
            let s = cv_bytes(&vs[0]) orelse return null
            let sep = cv_bytes(&vs[1]) orelse return null
            var out = List(CV).new()
            if sep.len == 0 {
                out.append(cv_owned(s))
            } else {
                var start: usize = 0
                var i: usize = 0
                while i + sep.len <= s.len {
                    if s[i..i + sep.len] == sep {
                        out.append(cv_owned(s[start..i]))
                        i += sep.len
                        start = i
                    } else {
                        i += 1
                    }
                }
                out.append(cv_owned(s[start..]))
            }
            return cv_seq(VK_LIST, out)
        }
        if name == "SliceLines" {
            let s = cv_bytes(&vs[0]) orelse return null
            var out = List(CV).new()
            var start: usize = 0
            var i: usize = 0
            while i <= s.len {
                if i == s.len or s[i] == '\n' {
                    var end = i
                    if end > start and s[end - 1] == '\r' { end -= 1 }
                    out.append(cv_owned(s[start..end]))
                    start = i + 1
                }
                i += 1
            }
            return cv_seq(VK_LIST, out)
        }
        if name == "SliceToOwned" {
            if vs[0].kind == VK_STR { return cv_owned(vs[0].text[..]) }
            if vs[0].kind == VK_ARRAY { var v = cv_clone(&vs[0]); v.kind = VK_LIST; return v }
            return cv_clone(&vs[0])
        }
        if name == "SliceParseInt" {
            let s = cv_bytes(&vs[0]) orelse return null
            let v = trim_ascii(s).parse_int(i128) catch { return cv_err(self.error_id("InvalidInput")) }
            return cv_wrap(VK_OK, cv_int(v))
        }
        if name == "SliceParseFloat" {
            let s = cv_bytes(&vs[0]) orelse return null
            let v = trim_ascii(s).parse_float() catch { return cv_err(self.error_id("InvalidInput")) }
            return cv_wrap(VK_OK, cv_float(v))
        }
        if name == "SliceEqIgnoreCase" {
            let x = cv_bytes(&vs[0]) orelse return null
            let y = cv_bytes(&vs[1]) orelse return null
            if x.len != y.len { return cv_bool(false) }
            for c, i in x { if lower_ascii(c) != lower_ascii(y[i]) { return cv_bool(false) } }
            return cv_bool(true)
        }
        // ---- checks and misc
        if name == "ExpectEq" {
            if cv_key_eq(&vs[0], &vs[1]) { return cv(VK_VOID) }
            self.it_panic_at(format("expectation failed: {} != {}", .{cv_format(&vs[0]), cv_format(&vs[1])})[..], at)
            return null
        }
        if name == "Assert" {
            if vs[0].kind == VK_BOOL and vs[0].flag { return cv(VK_VOID) }
            self.it_panic_at("assertion failed", at)
            return null
        }
        if name == "Unreachable" {
            self.it_panic_at("reached unreachable code", at)
            return null
        }
        if name == "TypeName" {
            if tys.len == 0 { return null }
            return cv_owned(self.ty_name(tys[0])[..])
        }
        if name == "Utf8Validate" { let s = cv_bytes(&vs[0]) orelse return null; return cv_bool(utf8_valid(s)) }
        if name == "Utf8Encode" {
            let cp = cv_as_int(&vs[0]) orelse return null
            if cp < 0 or cp > 0x10FFFF or (cp >= 0xD800 and cp <= 0xDFFF) { return null }
            return cv_owned(utf8_encode(cp as u32)[..])
        }
        if name == "Utf8Decode" {
            let s = cv_bytes(&vs[0]) orelse return null
            if !utf8_valid(s) { return cv(VK_NULL) }
            let cp = utf8_first(s) orelse return cv(VK_NULL)
            return cv_wrap(VK_SOME, cv_char(cp as i128))
        }
        // ---- reference classes are plain values in the interpreter
        if name == "Retain" or name == "Release" or name == "Drop" { return cv(VK_VOID) }
        if name == "Weak" { return cv_wrap(VK_SOME, cv_clone(&vs[0])) }
        if name == "Upgrade" {
            if vs[0].kind == VK_SOME or vs[0].kind == VK_NULL { return cv_clone(&vs[0]) }
            return cv_wrap(VK_SOME, cv_clone(&vs[0]))
        }
        if name == "RefCount" { return cv_int(1) }
        if name == "RefEq" { return cv_bool(cv_key_eq(&vs[0], &vs[1])) }
        if name == "ListNew" or name == "ListWithCapacity" { return cv_seq(VK_LIST, List(CV).new()) }
        if name == "ListFromSlice" {
            if vs[0].kind == VK_ARRAY { var v = cv_clone(&vs[0]); v.kind = VK_LIST; return v }
            if vs[0].kind == VK_STR {
                var items = List(CV).new()
                for b in vs[0].text { items.append(cv_int(b as i128)) }
                return cv_seq(VK_LIST, items)
            }
            return null
        }
        if name == "ListClone" or name == "StringClone" or name == "MapClone" { return cv_clone(&vs[0]) }
        if name == "ListLast" {
            let which = cv_as_int(&vs[1]) orelse return null
            if vs[0].kind != VK_ARRAY { return null }
            if vs[0].items.len == 0 { return cv(VK_NULL) }
            if which == 1 { return cv_wrap(VK_SOME, cv_clone(&vs[0].items[vs[0].items.len - 1])) }
            return cv_wrap(VK_SOME, cv_clone(&vs[0].items[0]))
        }
        if name == "ListItems" { return cv_clone(&vs[0]) }
        if name == "StringNew" or name == "StringWithCapacity" { return cv_owned("") }
        if name == "StringFrom" {
            if vs[0].kind == VK_STR or vs[0].kind == VK_OWNED_STR { return cv_owned(vs[0].text[..]) }
            return null
        }
        if name == "StringBytes" {
            if vs[0].kind == VK_STR or vs[0].kind == VK_OWNED_STR { return cv_str(vs[0].text[..]) }
            return null
        }
        if name == "SliceEq" {
            let a_str = vs[0].kind == VK_STR or vs[0].kind == VK_OWNED_STR
            let b_str = vs[1].kind == VK_STR or vs[1].kind == VK_OWNED_STR
            if a_str and b_str { return cv_bool(vs[0].text[..] == vs[1].text[..]) }
            if vs[0].kind == VK_ARRAY and vs[1].kind == VK_ARRAY { return cv_bool(cv_eq(&vs[0], &vs[1])) }
            return null
        }
        if name == "SliceStartsWith" or name == "SliceEndsWith" {
            let x = cv_bytes(&vs[0]) orelse return null
            let y = cv_bytes(&vs[1]) orelse return null
            if y.len > x.len { return cv_bool(false) }
            if name == "SliceStartsWith" { return cv_bool(x[0..y.len] == y) }
            return cv_bool(x[x.len - y.len..] == y)
        }
        if name == "SliceContains" {
            if vs[0].kind == VK_ARRAY {
                for x in vs[0].items { if cv_eq(&x, &vs[1]) { return cv_bool(true) } }
                return cv_bool(false)
            }
            if vs[0].kind == VK_STR {
                let b = cv_as_int(&vs[1]) orelse return null
                for c in vs[0].text { if c == b as u8 { return cv_bool(true) } }
                return cv_bool(false)
            }
            return null
        }
        if name == "Expect" {
            if vs[0].kind == VK_BOOL and vs[0].flag { return cv(VK_VOID) }
            var msg = String.new()
            if vs.len > 1 and vs[1].kind == VK_STR { msg = vs[1].text.clone() }
            self.it_fail_panic(format("expectation failed: {}", .{msg})[..], at)
            return null
        }
        if name == "Panic" {
            var msg = String.from("panic")
            if vs[0].kind == VK_STR or vs[0].kind == VK_OWNED_STR { msg = vs[0].text.clone() }
            self.it_fail_panic(msg[..], at)
            return null
        }
        if name == "Truncate" {
            var bits: u32 = 64
            var signed = true
            if !self.it_bits_of(self.tir.nodes[e].ty, &mut bits, &mut signed) { return null }
            let i = cv_as_int(&vs[0]) orelse return null
            return cv_int(wrap_to(i, bits, signed))
        }
        if name == "ErrorName" {
            if vs[0].kind != VK_ERR { return null }
            return cv_str(self.error_names[(vs[0].ival - 1) as usize][..])
        }
        if name == "MathAbs" {
            if vs[0].kind == VK_INT { return cv_int(if vs[0].ival < 0 { -vs[0].ival } else { vs[0].ival }) }
            if vs[0].kind == VK_FLOAT { return cv_float(if vs[0].fval < 0.0 { -vs[0].fval } else { vs[0].fval }) }
            return null
        }
        if name == "MathMin" or name == "MathMax" {
            let is_min = name == "MathMin"
            if vs[0].kind == VK_INT and vs[1].kind == VK_INT {
                let x = vs[0].ival
                let y = vs[1].ival
                return cv_int(if is_min { if x < y { x } else { y } } else { if x > y { x } else { y } })
            }
            if vs[0].kind == VK_FLOAT and vs[1].kind == VK_FLOAT {
                let x = vs[0].fval
                let y = vs[1].fval
                return cv_float(if is_min { if x < y { x } else { y } } else { if x > y { x } else { y } })
            }
            return null
        }
        if name == "MathClamp" {
            if vs[0].kind == VK_INT and vs[1].kind == VK_INT and vs[2].kind == VK_INT {
                let x = vs[0].ival
                return cv_int(if x < vs[1].ival { vs[1].ival } else if x > vs[2].ival { vs[2].ival } else { x })
            }
            if vs[0].kind == VK_FLOAT and vs[1].kind == VK_FLOAT and vs[2].kind == VK_FLOAT {
                let x = vs[0].fval
                return cv_float(if x < vs[1].fval { vs[1].fval } else if x > vs[2].fval { vs[2].fval } else { x })
            }
            return null
        }
        if name == "MathSqrt" or name == "MathFloor" or name == "MathCeil" or name == "MathRound" or name == "MathSin"
            or name == "MathCos" or name == "MathTan" or name == "MathExp" or name == "MathLog" or name == "MathLog2" {
            let x = cv_as_float(&vs[0]) orelse return null
            if name == "MathSqrt" { return cv_float(math.sqrt(x)) }
            if name == "MathFloor" { return cv_float(math.floor(x)) }
            if name == "MathCeil" { return cv_float(math.ceil(x)) }
            if name == "MathRound" { return cv_float(math.round(x)) }
            if name == "MathSin" { return cv_float(math.sin(x)) }
            if name == "MathCos" { return cv_float(math.cos(x)) }
            if name == "MathTan" { return cv_float(math.tan(x)) }
            if name == "MathExp" { return cv_float(math.exp(x)) }
            if name == "MathLog" { return cv_float(math.log(x)) }
            return cv_float(math.log2(x))
        }
        if name == "MathPow" {
            let x = cv_as_float(&vs[0]) orelse return null
            let y = cv_as_float(&vs[1]) orelse return null
            return cv_float(math.pow(x, y))
        }
        if name == "MathAtan2" {
            let x = cv_as_float(&vs[0]) orelse return null
            let y = cv_as_float(&vs[1]) orelse return null
            return cv_float(math.atan2(x, y))
        }
        if name == "Hash" {
            // checked_add/sub/mul encoded with a marker
            let x = cv_as_int(&vs[0]) orelse return null
            let y = cv_as_int(&vs[1]) orelse return null
            let m = cv_as_int(&vs[2]) orelse return null
            var r: ?i128 = null
            if m == 0 { r = checked_add(x, y) } else if m == 1 { r = checked_sub(x, y) } else { r = checked_mul(x, y) }
            var lo: i128 = 0
            var hi: i128 = 0
            if !self.it_int_range(self.tir.nodes[args[0]].ty, &mut lo, &mut hi) { return null }
            if let v = r {
                if v >= lo and v <= hi { return cv_wrap(VK_SOME, cv_int(v)) }
            }
            return cv(VK_NULL)
        }
        if name == "Format" {
            if vs[0].kind != VK_STR { return null }
            let fmt = vs[0].text.clone()
            var out = String.new()
            var ai: usize = 1
            var i: usize = 0
            while i < fmt.len {
                if fmt[i] == '{' {
                    if i + 1 < fmt.len and fmt[i + 1] == '{' { out.push_byte('{'); i += 2; continue }
                    var j = i + 1
                    while j < fmt.len and fmt[j] != '}' { j += 1 }
                    if ai >= vs.len { return null }
                    out.append(cv_format(&vs[ai])[..])
                    ai += 1
                    i = j + 1
                } else if fmt[i] == '}' and i + 1 < fmt.len and fmt[i + 1] == '}' {
                    out.push_byte('}')
                    i += 2
                } else {
                    out.push_byte(fmt[i])
                    i += 1
                }
            }
            return cv_owned(out[..])
        }
        if name == "IntToStr" or name == "FloatToStr" { return cv_owned(cv_format(&vs[0])[..]) }
        if name == "CharIsDigit" { let c = cv_as_int(&vs[0]) orelse return null; return cv_bool(c >= '0' as i128 and c <= '9' as i128) }
        if name == "CharIsAlpha" {
            let c = cv_as_int(&vs[0]) orelse return null
            return cv_bool((c >= 'a' as i128 and c <= 'z' as i128) or (c >= 'A' as i128 and c <= 'Z' as i128) or c > 127)
        }
        if name == "CharIsSpace" {
            let c = cv_as_int(&vs[0]) orelse return null
            return cv_bool(c == 32 or c == 9 or c == 10 or c == 13 or c == 11 or c == 12)
        }
        if name == "CharToLower" {
            let c = cv_as_int(&vs[0]) orelse return null
            return cv_char(if c >= 'A' as i128 and c <= 'Z' as i128 { c + 32 } else { c })
        }
        if name == "CharToUpper" {
            let c = cv_as_int(&vs[0]) orelse return null
            return cv_char(if c >= 'a' as i128 and c <= 'z' as i128 { c - 32 } else { c })
        }
        if name == "CharToDigit" {
            let c = cv_as_int(&vs[0]) orelse return null
            if c >= '0' as i128 and c <= '9' as i128 { return cv_wrap(VK_SOME, cv_int(c - '0' as i128)) }
            return cv(VK_NULL)
        }
        return null
    }

    /// The builtins that change a value in place; `cur` is the receiver's
    /// storage.
    fn it_mutating_builtin(self: *mut Self, name: []u8, cur: *mut CV, vs: *List(CV), at: usize) -> ?CV {
        let k = cur.kind
        if name == "ListClear" {
            if k != VK_LIST { return null }
            cur.items.clear()
            return cv(VK_VOID)
        }
        if name == "ListInsert" {
            if k != VK_LIST { return null }
            let i = (cv_as_int(&vs[1]) orelse return null) as usize
            if i > cur.items.len {
                self.it_panic_at("insert index out of range", at)
                return null
            }
            cur.items.insert(i, cv_clone(&vs[2]))
            return cv(VK_VOID)
        }
        if name == "ListRemove" or name == "ListSwapRemove" {
            if k != VK_LIST { return null }
            let i = (cv_as_int(&vs[1]) orelse return null) as usize
            if i >= cur.items.len {
                self.it_panic_at("remove index out of range", at)
                return null
            }
            if name == "ListRemove" { return cur.items.remove(i) }
            return cur.items.swap_remove(i)
        }
        if name == "ListExtend" {
            if k != VK_LIST { return null }
            let more = cv_seq_items(&vs[1]) orelse return null
            for x in more { cur.items.append(cv_clone(&x)) }
            return cv(VK_VOID)
        }
        if name == "ListAppend" {
            if k == VK_LIST { cur.items.append(cv_clone(&vs[1])); return cv(VK_VOID) }
            if k == VK_UNDEFINED {
                var items = List(CV).new()
                items.append(cv_clone(&vs[1]))
                cur.*= cv_seq(VK_LIST, items)
                return cv(VK_VOID)
            }
            return null
        }
        if name == "ListPop" {
            if k != VK_LIST { return null }
            let v = cur.items.pop() orelse return cv(VK_NULL)
            return cv_wrap(VK_SOME, v)
        }
        if name == "StringClear" {
            if ! (k == VK_OWNED_STR or k == VK_STR) { return null }
            cur.text.clear()
            return cv(VK_VOID)
        }
        if name == "StringPop" {
            if ! (k == VK_OWNED_STR or k == VK_STR) { return null }
            let b = cur.text.pop() orelse return cv(VK_NULL)
            return cv_wrap(VK_SOME, cv_int(b as i128))
        }
        if name == "MapPut" {
            if k == VK_MAP {
                var i: usize = 0
                while i + 1 < cur.items.len {
                    if cv_key_eq(&cur.items[i], &vs[1]) {
                        cur.items[i + 1] = cv_clone(&vs[2])
                        return cv(VK_VOID)
                    }
                    i += 2
                }
                cur.items.append(cv_clone(&vs[1]))
                cur.items.append(cv_clone(&vs[2]))
                return cv(VK_VOID)
            }
            if k == VK_UNDEFINED {
                var items = List(CV).new()
                items.append(cv_clone(&vs[1]))
                items.append(cv_clone(&vs[2]))
                cur.*= cv_seq(VK_MAP, items)
                return cv(VK_VOID)
            }
            return null
        }
        if name == "MapRemove" {
            if k != VK_MAP { return null }
            var i: usize = 0
            while i + 1 < cur.items.len {
                if cv_key_eq(&cur.items[i], &vs[1]) {
                    _ = cur.items.remove(i)
                    _ = cur.items.remove(i)
                    return cv_bool(true)
                }
                i += 2
            }
            return cv_bool(false)
        }
        if name == "MapClear" {
            if k != VK_MAP { return null }
            cur.items.clear()
            return cv(VK_VOID)
        }
        if name == "SliceCopy" {
            let src = cv_seq_items(&vs[1]) orelse return null
            if k == VK_LIST or k == VK_ARRAY {
                for x, i in src { if i < cur.items.len { cur.items[i] = cv_clone(&x) } }
                return cv(VK_VOID)
            }
            if k == VK_OWNED_STR or k == VK_STR {
                for x, i in src {
                    if i < cur.text.len { cur.text[i] = (cv_as_int(&x) orelse return null) as u8 }
                }
                return cv(VK_VOID)
            }
            return null
        }
        if name == "SliceFill" {
            if k == VK_LIST or k == VK_ARRAY {
                let n = cur.items.len
                for i in 0..n { cur.items[i] = cv_clone(&vs[1]) }
                return cv(VK_VOID)
            }
            if k == VK_OWNED_STR or k == VK_STR {
                let b = (cv_as_int(&vs[1]) orelse return null) as u8
                let n = cur.text.len
                for i in 0..n { cur.text[i] = b }
                return cv(VK_VOID)
            }
            return null
        }
        if name == "SliceReverse" {
            if k == VK_LIST or k == VK_ARRAY {
                var i: usize = 0
                var j = cur.items.len
                while i + 1 < j {
                    j -= 1
                    let t = cv_clone(&cur.items[i])
                    cur.items[i] = cv_clone(&cur.items[j])
                    cur.items[j] = t
                    i += 1
                }
                return cv(VK_VOID)
            }
            if k == VK_OWNED_STR or k == VK_STR {
                var i: usize = 0
                var j = cur.text.len
                while i + 1 < j {
                    j -= 1
                    let t = cur.text[i]
                    cur.text[i] = cur.text[j]
                    cur.text[j] = t
                    i += 1
                }
                return cv(VK_VOID)
            }
            return null
        }
        if name == "SliceSort" {
            if k == VK_LIST or k == VK_ARRAY {
                // insertion sort keeps equal elements in order, like a stable sort
                let n = cur.items.len
                var i: usize = 1
                while i < n {
                    var j = i
                    while j > 0 and cv_cmp(&cur.items[j - 1], &cur.items[j]) > 0 {
                        let t = cv_clone(&cur.items[j - 1])
                        cur.items[j - 1] = cv_clone(&cur.items[j])
                        cur.items[j] = t
                        j -= 1
                    }
                    i += 1
                }
                return cv(VK_VOID)
            }
            if k == VK_OWNED_STR or k == VK_STR {
                let n = cur.text.len
                var i: usize = 1
                while i < n {
                    var j = i
                    while j > 0 and cur.text[j - 1] > cur.text[j] {
                        let t = cur.text[j - 1]
                        cur.text[j - 1] = cur.text[j]
                        cur.text[j] = t
                        j -= 1
                    }
                    i += 1
                }
                return cv(VK_VOID)
            }
            return null
        }
        if name == "StringAppend" or name == "StringAppendChar" or name == "StringPushByte" {
            var add = String.new()
            if vs[1].kind == VK_STR or vs[1].kind == VK_OWNED_STR { add = vs[1].text.clone() }
            else if vs[1].kind == VK_CHAR { add = utf8_encode(vs[1].ival as u32) }
            else if vs[1].kind == VK_INT { add.push_byte(vs[1].ival as u8) }
            else { return null }
            if k == VK_OWNED_STR { cur.text.append(add[..]); return cv(VK_VOID) }
            if k == VK_UNDEFINED { cur.*= cv_owned(add[..]); return cv(VK_VOID) }
            return null
        }
        return null
    }
}

fn list_has_usize(xs: *List(usize), x: usize) -> bool {
    for y in xs { if y == x { return true } }
    return false
}

fn cmp_bytes(a: []u8, b: []u8) -> i8 {
    var i: usize = 0
    while i < a.len and i < b.len {
        if a[i] < b[i] { return -1 }
        if a[i] > b[i] { return 1 }
        i += 1
    }
    if a.len < b.len { return -1 }
    if a.len > b.len { return 1 }
    return 0
}

// ---------------------------------------------------------------- match and patterns

impl Checker {
    fn check_match(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let scrut_node = n.x
        let arms = n.kids.clone()
        let start = n.start
        let end = n.end
        let s = self.check_expr(scrut_node, NONE)
        let st = self.tys.resolve(self.tir.nodes[s].ty, false)
        self.tir.nodes[s].ty = st
        // matching through a pointer binds owning payloads by reference
        var by_ref = NONE
        if self.tir.nodes[s].k == TKind.Deref {
            let inner = self.tir.nodes[s].kids[0]
            let it = self.tys.shallow(self.tir.nodes[inner].ty)
            if self.tys.kind(it) == TK.Ptr { by_ref = if self.tys.list[it].flag { 1 } else { 0 } }
        }
        let saved_by_ref = self.ctx().pat_by_ref
        self.ctx().pat_by_ref = by_ref
        if arms.len == 0 {
            self.fail_here(start, "`match` needs at least one arm")
            return self.error_expr(start, end)
        }
        let r = self.mk(TKind.Match, NONE, start, end)
        self.tir.nodes[r].kids.append(s)
        var hint = expected
        let moved_before = self.moved_snapshot()
        var moved_arms = List(List(usize)).new()
        var bodies = List(usize).new()
        for a in arms {
            let an = self.node(m, a)
            let pat_node = an.x
            let guard_node = an.y
            let body_node = an.z
            let astart = an.start
            let aend = an.end
            self.moved_restore(&moved_before)
            self.push_scope()
            let pat = self.check_pattern(pat_node, st)
            var guard = NONE
            if guard_node != NONE {
                let bt = self.tys.bool_ty()
                guard = self.check_expr(guard_node, bt)
                guard = self.coerce_or_error(guard, bt, "match guard")
            }
            var body = self.check_expr(body_node, hint)
            let bty = self.tys.shallow(self.tir.nodes[body].ty)
            if hint == NONE and self.tys.kind(bty) != TK.Never { hint = bty }
            body = self.take_ownership(body)
            self.pop_scope()
            let arm = self.mk(TKind.Arm, NONE, astart, aend)
            self.tir.nodes[arm].flag = guard != NONE
            self.tir.nodes[arm].kids.append(pat)
            if guard != NONE { self.tir.nodes[arm].kids.append(guard) }
            self.tir.nodes[arm].kids.append(body)
            self.tir.nodes[r].kids.append(arm)
            bodies.append(body)
            if self.tys.kind(bty) != TK.Never { moved_arms.append(self.moved_snapshot()) }
        }
        self.moved_restore(&moved_before)
        for ma in moved_arms { self.moved_merge(&ma) }
        let ty = self.join_exprs(&mut bodies, expected, start)
        // the coerced bodies replace the arms' last child
        let arm_nodes = self.tir.nodes[r].kids.clone()
        for a, i in arm_nodes {
            if i == 0 { continue }
            let last = self.tir.nodes[a].kids.len - 1
            self.tir.nodes[a].kids[last] = bodies[i - 1]
        }
        self.check_exhaustive(st, r, start)
        self.ctx().pat_by_ref = saved_by_ref
        self.tir.nodes[r].ty = ty
        return r
    }

    // ----- exhaustiveness ----------------------------------------------------------

    fn pat_irrefutable(self: *mut Self, p: usize) -> bool {
        let k = self.tir.nodes[p].k
        if k == TKind.PWild or k == TKind.PBind { return true }
        if k == TKind.PTuple {
            for q in self.tir.nodes[p].kids.clone() { if !self.pat_irrefutable(q) { return false } }
            return true
        }
        if k == TKind.POr {
            for q in self.tir.nodes[p].kids.clone() { if self.pat_irrefutable(q) { return true } }
            return false
        }
        return false
    }

    fn pat_is_wild(self: *mut Self, p: usize) -> bool {
        let k = self.tir.nodes[p].k
        return k == TKind.PWild or k == TKind.PBind
    }

    /// A wildcard pattern node to stand in for unmatched sub-columns.
    fn wild_pat(self: *mut Self) -> usize {
        if self.wild_pat_node == NONE { self.wild_pat_node = self.pat_node(TKind.PWild, 0, 0) }
        return self.wild_pat_node
    }

    fn check_exhaustive(self: *mut Self, st: usize, r: usize, at: usize) {
        let arm_nodes = self.tir.nodes[r].kids.clone()
        var unguarded = List(usize).new()
        for a, i in arm_nodes {
            if i == 0 { continue }
            if self.tir.nodes[a].flag { continue }
            unguarded.append(self.tir.nodes[a].kids[0])
        }
        for p in unguarded { if self.pat_irrefutable(p) { return } }
        let t = self.tys.shallow(st)
        let k = self.tys.kind(t)
        var flat = List(usize).new()
        for p in unguarded {
            if self.tir.nodes[p].k == TKind.POr {
                for q in self.tir.nodes[p].kids.clone() { flat.append(q) }
            } else {
                flat.append(p)
            }
        }
        var rows = List(List(usize)).new()
        for p in flat {
            var row = List(usize).new()
            row.append(p)
            rows.append(row)
        }
        var tys = List(usize).new()
        tys.append(st)
        if self.rows_exhaustive(&tys, &rows) { return }
        var hint = String.from("; add a catch-all arm `_ =>`")
        if k == TK.Enum {
            let d = self.tys.list[t].def
            let em = self.enums[d].module
            let variants = self.enums[d].variants.clone()
            var missing = String.new()
            for v, i in variants {
                var covered = false
                for p in flat {
                    if self.tir.nodes[p].k != TKind.PVariant or self.tir.nodes[p].a != i { continue }
                    var all = true
                    for q in self.tir.nodes[p].kids.clone() { if !self.pat_irrefutable(q) { all = false } }
                    if all { covered = true }
                }
                if covered { continue }
                if missing.len > 0 { missing.append(", ") }
                missing.append(".")
                missing.append(self.node(em, v).name[..])
            }
            hint = format("; not covered: {}", .{missing})
        } else if k == TK.Slice or k == TK.Str or k == TK.Array {
            hint = String.from("; binary and string matches need a catch-all arm `_ =>` (section 6.2)")
        } else if k == TK.ErrUnion {
            hint = String.from("; add `else => ...` to handle the remaining errors")
        } else if k == TK.Opt {
            hint = String.from("; cover both `null` and a binding for the value")
        }
        self.fail_here(at, format("`match` is not exhaustive{}", .{hint})[..])
    }

    /// The sub-patterns of `p` when it is built with constructor `c` (a
    /// (kind, index) pair), or null when it is built with another.
    fn pat_ctor_args(self: *mut Self, p: usize, ck: u8, ci: usize) -> ?List(usize) {
        let k = self.tir.nodes[p].k
        var out = List(usize).new()
        if ck == 0 and k == TKind.PBool {
            if (if self.tir.nodes[p].flag { 1 } else { 0 }) != ci { return null }
            return out
        }
        if ck == 1 and k == TKind.PVariant {
            if self.tir.nodes[p].a != ci { return null }
            for q in self.tir.nodes[p].kids.clone() { out.append(q) }
            return out
        }
        if ck == 2 and k == TKind.PNull { return out }
        if ck == 3 and k == TKind.PSome { out.append(self.tir.nodes[p].kids[0]); return out }
        if ck == 4 and k == TKind.POk { out.append(self.tir.nodes[p].kids[0]); return out }
        if ck == 5 and k == TKind.PError {
            if self.tir.nodes[p].a != ci { return null }
            return out
        }
        if ck == 6 and k == TKind.PTuple {
            for q in self.tir.nodes[p].kids.clone() { out.append(q) }
            return out
        }
        return null
    }

    /// The constructors of a type with their payload types: parallel lists of
    /// kind (0 bool, 1 variant, 2 null, 3 some, 4 ok, 5 error, 6 tuple),
    /// index, and payload types; false when there are too many to enumerate.
    fn constructors(self: *mut Self, t0: usize, kinds: *mut List(u8), idxs: *mut List(usize), payloads: *mut List(List(usize))) -> bool {
        let t = self.tys.shallow(t0)
        let k = self.tys.kind(t)
        if k == TK.Bool {
            kinds.append(0); idxs.append(1); payloads.append(List(usize).new())
            kinds.append(0); idxs.append(0); payloads.append(List(usize).new())
            return true
        }
        if k == TK.Enum {
            let vts = self.enum_variant_types(t)
            for vt, i in vts {
                kinds.append(1); idxs.append(i); payloads.append(vt.clone())
            }
            return true
        }
        if k == TK.Opt {
            kinds.append(2); idxs.append(0); payloads.append(List(usize).new())
            var inner = List(usize).new()
            inner.append(self.tys.list[t].args[0])
            kinds.append(3); idxs.append(0); payloads.append(inner)
            return true
        }
        if k == TK.Tuple {
            kinds.append(6); idxs.append(0); payloads.append(self.tys.list[t].args.clone())
            return true
        }
        if k == TK.ErrUnion and self.tys.list[t].flag {
            var inner = List(usize).new()
            inner.append(self.tys.list[t].args[0])
            kinds.append(4); idxs.append(0); payloads.append(inner)
            for id in self.error_set_ids(self.tys.list[t].def) {
                kinds.append(5); idxs.append(id); payloads.append(List(usize).new())
            }
            return true
        }
        return false
    }

    /// The error ids of an error set's members.
    fn error_set_ids(self: *mut Self, set: usize) -> List(usize) {
        var out = List(usize).new()
        let m = self.error_sets[set].module
        let items = self.mods[m].parsed.items.clone()
        for it in items {
            let n = self.node(m, it)
            if n.k == parser.NodeKind.ErrorSet and n.name == self.error_sets[set].name {
                let words = n.words.clone()
                for w in words { out.append(self.error_id(w[..])) }
                return out
            }
        }
        return out
    }

    /// Is every value of the tuple of types `tys` matched by some row? The
    /// classic matrix algorithm: pick the first column, split on its
    /// constructors, and recurse on the specialized rows.
    fn rows_exhaustive(self: *mut Self, tys: *List(usize), rows0: *List(List(usize))) -> bool {
        if tys.len == 0 { return rows0.len > 0 }
        // or-patterns in the first column become separate rows
        var rows = List(List(usize)).new()
        for r in rows0 { rows.append(r.clone()) }
        var changed = true
        while changed {
            changed = false
            var next = List(List(usize)).new()
            for r in rows {
                if self.tir.nodes[r[0]].k == TKind.POr {
                    changed = true
                    for alt in self.tir.nodes[r[0]].kids.clone() {
                        var nr = List(usize).new()
                        nr.append(alt)
                        for x, i in r { if i > 0 { nr.append(x) } }
                        next.append(nr)
                    }
                } else {
                    next.append(r.clone())
                }
            }
            rows = next
        }
        var rest_tys = List(usize).new()
        for t, i in tys { if i > 0 { rest_tys.append(t) } }
        var kinds = List(u8).new()
        var idxs = List(usize).new()
        var payloads = List(List(usize)).new()
        if !self.constructors(tys[0], &mut kinds, &mut idxs, &mut payloads) {
            // integers, strings, ...: only a wildcard covers them
            var d = List(List(usize)).new()
            for r in rows {
                if !self.pat_is_wild(r[0]) { continue }
                var nr = List(usize).new()
                for x, i in r { if i > 0 { nr.append(x) } }
                d.append(nr)
            }
            return self.rows_exhaustive(&rest_tys, &d)
        }
        let wild = self.wild_pat()
        for ck, c in kinds {
            let ci = idxs[c]
            let sub_tys = payloads[c].clone()
            var spec = List(List(usize)).new()
            for r in rows {
                if self.pat_is_wild(r[0]) {
                    var nr = List(usize).new()
                    for i in 0..sub_tys.len { nr.append(wild) }
                    for x, i in r { if i > 0 { nr.append(x) } }
                    spec.append(nr)
                } else if let subs = self.pat_ctor_args(r[0], ck, ci) {
                    var nr = subs
                    for x, i in r { if i > 0 { nr.append(x) } }
                    spec.append(nr)
                }
            }
            var nt = sub_tys.clone()
            for t in rest_tys { nt.append(t) }
            if !self.rows_exhaustive(&nt, &spec) { return false }
        }
        return true
    }

    /// A common type for a set of branch expressions; each is coerced to it in place.
    fn join_exprs(self: *mut Self, exprs: *mut List(usize), expected: usize, at: usize) -> usize {
        let nev = self.tys.never()
        let v = self.tys.void()
        var candidates = List(usize).new()
        if expected != NONE { candidates.append(expected) }
        for e in exprs {
            let t = self.tys.shallow(self.tir.nodes[e].ty)
            if self.tys.kind(t) != TK.Never { candidates.append(t) }
        }
        if candidates.len == 0 { return nev }
        var target = NONE
        for cand in candidates {
            // a probe: no errors, but unification bindings stay (as in the oracle)
            let saved = self.errors.len
            var ok = true
            for e in exprs {
                let saved_ty = self.tir.nodes[e].ty
                let c = self.coerce(e, cand)
                self.tir.nodes[e].ty = saved_ty
                if c == NONE { ok = false }
            }
            while self.errors.len > saved { _ = self.errors.pop() }
            if ok {
                target = cand
                break
            }
        }
        if target == NONE {
            var all_void = true
            for e in exprs {
                let k = self.tys.kind(self.tys.shallow(self.tir.nodes[e].ty))
                if ! (k == TK.Void or k == TK.Never) { all_void = false }
            }
            if all_void {
                target = v
            } else {
                self.fail_here(at, "match arms have incompatible types")
                target = candidates[0]
            }
        }
        for e, i in exprs { exprs[i] = self.coerce_or_error(e, target, "match arm") }
        return target
    }

    /// The type a pattern binding gets: the payload, or a pointer to it when
    /// matching through a pointer and the payload owns resources.
    fn pat_bind_ty(self: *mut Self, t: usize) -> usize {
        let by_ref = self.ctx().pat_by_ref
        if by_ref != NONE and self.needs_drop(t) { return self.tys.wrap(TK.Ptr, t, by_ref == 1) }
        return t
    }

    fn pat_node(self: *mut Self, k: TKind, start: usize, end: usize) -> usize {
        let v = self.tys.void()
        return self.tir.add(tblank(k, v, start, end))
    }

    fn pat_wrap(self: *mut Self, k: TKind, inner: usize, start: usize, end: usize) -> usize {
        let p = self.pat_node(k, start, end)
        self.tir.nodes[p].kids.append(inner)
        return p
    }

    fn check_pattern(self: *mut Self, pat: usize, ty0: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, pat)
        let k = n.k
        let start = n.start
        let end = n.end
        let ty = self.tys.shallow(ty0)
        let tk = self.tys.kind(ty)
        if k == parser.NodeKind.PWild { return self.pat_node(TKind.PWild, start, end) }
        if k == parser.NodeKind.PBind {
            let name = n.name.clone()
            // a bare name on an optional binds its payload; on an error union, the success value
            if tk == TK.Opt or tk == TK.ErrUnion {
                let inner = self.tys.list[ty].args[0]
                let bt = self.pat_bind_ty(inner)
                let l = self.declare_local(name[..], bt, false, start, end)
                let b = self.pat_node(TKind.PBind, start, end)
                self.tir.nodes[b].a = l
                return self.pat_wrap(if tk == TK.Opt { TKind.PSome } else { TKind.POk }, b, start, end)
            }
            let bt = self.pat_bind_ty(ty)
            let l = self.declare_local(name[..], bt, false, start, end)
            let b = self.pat_node(TKind.PBind, start, end)
            self.tir.nodes[b].a = l
            return b
        }
        if k == parser.NodeKind.PLit {
            if tk == TK.Opt or tk == TK.ErrUnion {
                let inner = self.tys.list[ty].args[0]
                let p = self.check_pattern(pat, inner)
                return self.pat_wrap(if tk == TK.Opt { TKind.PSome } else { TKind.POk }, p, start, end)
            }
            return self.check_lit_pattern(pat, ty)
        }
        if k == parser.NodeKind.PNull {
            if tk == TK.Opt { return self.pat_node(TKind.PNull, start, end) }
            self.fail_here(start, format("`null` pattern on a non-optional value of type `{}`", .{self.ty_name(ty)})[..])
            return self.pat_node(TKind.PWild, start, end)
        }
        if k == parser.NodeKind.PError {
            let name = n.name.clone()
            let id = self.error_id(name[..])
            if tk == TK.ErrUnion or tk == TK.ErrorSet {
                if self.tys.list[ty].flag {
                    let s = self.tys.list[ty].def
                    if !self.error_set_has(s, name[..]) {
                        self.fail_here(start, format("`error.{}` is not a member of error set `{}`", .{name, self.error_sets[s].name})[..])
                    }
                }
                let p = self.pat_node(TKind.PError, start, end)
                self.tir.nodes[p].a = id
                return p
            }
            self.fail_here(start, format("error pattern on a value of type `{}`, which is not an error union", .{self.ty_name(ty)})[..])
            return self.pat_node(TKind.PWild, start, end)
        }
        if k == parser.NodeKind.PRange {
            if tk == TK.Opt {
                let inner = self.tys.list[ty].args[0]
                let p = self.check_pattern(pat, inner)
                return self.pat_wrap(TKind.PSome, p, start, end)
            }
            if !self.tys.is_integer(ty) and tk != TK.Char {
                self.fail_here(start, "range patterns apply to integers and chars")
                return self.pat_node(TKind.PWild, start, end)
            }
            let lo_node = n.x
            let hi_node = n.y
            let inclusive = n.flag
            let lo = self.pattern_const_int(m, lo_node) orelse {
                self.fail_here(start, "range pattern bounds must be compile-time constants")
                return self.pat_node(TKind.PWild, start, end)
            }
            let hi = self.pattern_const_int(m, hi_node) orelse {
                self.fail_here(start, "range pattern bounds must be compile-time constants")
                return self.pat_node(TKind.PWild, start, end)
            }
            let p = self.pat_node(TKind.PRange, start, end)
            self.tir.nodes[p].ival = lo
            self.tir.nodes[p].text = format("{}", .{hi})
            self.tir.nodes[p].flag = inclusive
            return p
        }
        if k == parser.NodeKind.POr {
            let alts = n.kids.clone()
            let p = self.pat_node(TKind.POr, start, end)
            for a in alts {
                if self.node(m, a).k == parser.NodeKind.PBind { self.fail_here(self.node(m, a).start, "bindings are not allowed inside `|` patterns") }
                let q = self.check_pattern(a, ty)
                self.tir.nodes[p].kids.append(q)
            }
            return p
        }
        if k == parser.NodeKind.PTuple {
            let elems = n.kids.clone()
            if tk != TK.Tuple {
                self.fail_here(start, format("tuple pattern on a value of type `{}`", .{self.ty_name(ty)})[..])
                return self.pat_node(TKind.PWild, start, end)
            }
            let ts = self.tys.list[ty].args.clone()
            if ts.len != elems.len {
                self.fail_here(start, format("tuple pattern has {} elements but the value has {}", .{elems.len, ts.len})[..])
                return self.pat_node(TKind.PWild, start, end)
            }
            let p = self.pat_node(TKind.PTuple, start, end)
            for x, i in elems {
                let q = self.check_pattern(x, ts[i])
                self.tir.nodes[p].kids.append(q)
            }
            return p
        }
        if k == parser.NodeKind.PBinary {
            var is_bytes = false
            if tk == TK.Slice or tk == TK.Array {
                let es = self.tys.shallow(self.tys.list[ty].args[0])
                is_bytes = self.tys.kind(es) == TK.Int and self.tys.list[es].name == "u8"
            }
            if tk == TK.Str { is_bytes = true }
            if !is_bytes {
                self.fail_here(start, format("binary patterns match `[]u8` values, but this value has type `{}`", .{self.ty_name(ty)})[..])
                return self.pat_node(TKind.PWild, start, end)
            }
            return self.check_bin_pattern(pat)
        }
        if k == parser.NodeKind.PVariant {
            if tk == TK.Opt or tk == TK.ErrUnion {
                let inner = self.tys.list[ty].args[0]
                let p = self.check_pattern(pat, inner)
                return self.pat_wrap(if tk == TK.Opt { TKind.PSome } else { TKind.POk }, p, start, end)
            }
            let path = n.words.clone()
            let args = n.kids.clone()
            if tk == TK.Bool and path.len == 1 and (path[0] == "true" or path[0] == "false") {
                let p = self.pat_node(TKind.PBool, start, end)
                self.tir.nodes[p].flag = path[0] == "true"
                return p
            }
            if tk != TK.Enum {
                if path.len == 1 and args.len == 0 {
                    self.fail_here(start, format("`.{}` is an enum variant pattern but the value has type `{}`", .{path[0], self.ty_name(ty)})[..])
                } else {
                    self.fail_here(start, format("variant pattern `{}` on a value of type `{}`", .{join_words(&path, "."), self.ty_name(ty)})[..])
                }
                return self.pat_node(TKind.PWild, start, end)
            }
            let d = self.tys.list[ty].def
            let name = path[path.len - 1].clone()
            if path.len == 2 {
                var ok = false
                if let r = self.lookup(m, path[0][..]) { ok = r.kind == ItemKind.Enum and r.id == d }
                if !ok { self.fail_here(start, format("`{}` is not the enum `{}`", .{path[0], self.enums[d].name})[..]) }
            } else if path.len > 2 {
                self.fail_here(start, "variant patterns are `.Variant` or `Enum.Variant`")
            }
            let idx = self.enum_variant_index(d, name[..])
            if idx == NONE {
                self.fail_here(start, format("enum `{}` has no variant `{}`", .{self.enums[d].name, name})[..])
                return self.pat_node(TKind.PWild, start, end)
            }
            let vtys = self.enum_variant_types(ty)
            let want = vtys[idx].clone()
            let p = self.pat_node(TKind.PVariant, start, end)
            self.tir.nodes[p].a = idx
            if args.len == 0 and want.len > 0 {
                // `.Variant` matches any payload
                for w in want {
                    _ = w
                    let q = self.pat_node(TKind.PWild, start, end)
                    self.tir.nodes[p].kids.append(q)
                }
                return p
            }
            if args.len != want.len {
                self.fail_here(start, format("variant `{}.{}` has {} value(s) but the pattern binds {}", .{self.enums[d].name, name, want.len, args.len})[..])
                return self.pat_node(TKind.PWild, start, end)
            }
            for a, i in args {
                let q = self.check_pattern(a, want[i])
                self.tir.nodes[p].kids.append(q)
            }
            return p
        }
        self.fail_here(start, "unsupported pattern")
        return self.pat_node(TKind.PWild, start, end)
    }

    fn pattern_const_int(self: *mut Self, m: usize, e: usize) -> ?i128 {
        let n = self.node(m, e)
        if n.k == parser.NodeKind.Lit and n.text == "char" {
            let v = n.name[..].parse_int(i128) catch { return null }
            return v
        }
        if n.k == parser.NodeKind.Unary and n.name == "-" {
            let inner = n.x
            let v = self.pattern_const_int(m, inner) orelse return null
            return -v
        }
        return self.const_eval_int(m, e)
    }

    fn check_lit_pattern(self: *mut Self, pat: usize, ty: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, pat)
        let kind = n.text.clone()
        let text = n.name.clone()
        let negative = n.flag
        let start = n.start
        let end = n.end
        var under = ty
        if self.tys.kind(ty) == TK.Distinct { under = self.tys.shallow(self.distinct_underlying(self.tys.list[ty].def)) }
        let uk = self.tys.kind(under)
        if kind == "int" {
            var v = text[..].parse_int(i128) catch { 0 }
            if negative { v = -v }
            if uk == TK.Int {
                let name = self.tys.list[under].name.clone()
                if v < int_min(name[..]) or v > int_max(name[..]) { self.fail_here(start, format("literal `{}` does not fit in `{}`", .{v, name})[..]) }
                let p = self.pat_node(TKind.PInt, start, end)
                self.tir.nodes[p].ival = v
                return p
            }
            if uk == TK.Infer and self.tys.is_integer(ty) {
                let p = self.pat_node(TKind.PInt, start, end)
                self.tir.nodes[p].ival = v
                return p
            }
            if uk == TK.Float {
                let p = self.pat_node(TKind.PFloat, start, end)
                self.tir.nodes[p].fval = v as f64
                return p
            }
            if uk == TK.Char {
                let p = self.pat_node(TKind.PChar, start, end)
                self.tir.nodes[p].ival = v
                return p
            }
            self.fail_here(start, format("integer pattern on a value of type `{}`", .{self.ty_name(ty)})[..])
            return self.pat_node(TKind.PWild, start, end)
        }
        if kind == "float" {
            if uk == TK.Float {
                var f = text[..].parse_float() catch { 0.0 }
                if negative { f = -f }
                let p = self.pat_node(TKind.PFloat, start, end)
                self.tir.nodes[p].fval = f
                return p
            }
            self.fail_here(start, format("float pattern on a value of type `{}`", .{self.ty_name(ty)})[..])
            return self.pat_node(TKind.PWild, start, end)
        }
        if kind == "str" or kind == "bytes" {
            var ok = uk == TK.Str
            if uk == TK.Slice {
                let es = self.tys.shallow(self.tys.list[under].args[0])
                ok = self.tys.kind(es) == TK.Int and self.tys.list[es].name == "u8"
            }
            if ok {
                let p = self.pat_node(TKind.PStr, start, end)
                self.tir.nodes[p].text = text.clone()
                return p
            }
            self.fail_here(start, format("string pattern on a value of type `{}`", .{self.ty_name(ty)})[..])
            return self.pat_node(TKind.PWild, start, end)
        }
        if kind == "char" {
            let c = text[..].parse_int(i128) catch { 0 }
            if uk == TK.Char {
                let p = self.pat_node(TKind.PChar, start, end)
                self.tir.nodes[p].ival = c
                return p
            }
            if uk == TK.Int {
                let name = self.tys.list[under].name.clone()
                if c > int_max(name[..]) { self.fail_here(start, format("character does not fit in `{}`", .{name})[..]) }
                let p = self.pat_node(TKind.PInt, start, end)
                self.tir.nodes[p].ival = c
                return p
            }
            self.fail_here(start, format("character pattern on a value of type `{}`", .{self.ty_name(ty)})[..])
            return self.pat_node(TKind.PWild, start, end)
        }
        if kind == "bool" {
            if uk == TK.Bool {
                let p = self.pat_node(TKind.PBool, start, end)
                self.tir.nodes[p].flag = text == "true"
                return p
            }
            self.fail_here(start, format("boolean pattern on a value of type `{}`", .{self.ty_name(ty)})[..])
            return self.pat_node(TKind.PWild, start, end)
        }
        self.fail_here(start, "unknown literal pattern")
        return self.pat_node(TKind.PWild, start, end)
    }

    // ----- binary patterns and construction -------------------------------------------------

    /// A segment's modifiers: endian text, signed, float, utf8.
    fn seg_mods(self: *mut Self, m: usize, seg: usize, signed: *mut bool, float: *mut bool, utf8: *mut bool) -> String {
        var endian = String.from("big")
        for w in self.node(m, seg).words.clone() {
            if w == "big" or w == "little" or w == "native" { endian = w.clone() }
            if w == "signed" { signed.*= true }
            if w == "unsigned" { signed.*= false }
            if w == "float" { float.*= true }
            if w == "utf8" { utf8.*= true }
        }
        return endian
    }

    /// Size arithmetic runs at pointer width: every identifier is widened to
    /// `usize` by a synthesized cast, mirroring the oracle's rewrite.
    fn widen_size_expr(self: *mut Self, m: usize, e: usize) -> usize {
        let n = self.node(m, e)
        let k = n.k
        let start = n.start
        let end = n.end
        if k == parser.NodeKind.Ident {
            var tn = self.blank_node(parser.NodeKind.TName, start, end)
            tn.words.append(String.from("usize"))
            let tid = self.mods[m].parsed.tree.add(tn)
            var c = self.blank_node(parser.NodeKind.Cast, start, end)
            c.x = e
            c.y = tid
            return self.mods[m].parsed.tree.add(c)
        }
        if k == parser.NodeKind.Binary {
            let lhs = self.widen_size_expr(m, n.x)
            let rhs = self.widen_size_expr(m, n.y)
            var b = self.blank_node(parser.NodeKind.Binary, start, end)
            b.name = self.node(m, e).name.clone()
            b.x = lhs
            b.y = rhs
            return self.mods[m].parsed.tree.add(b)
        }
        if k == parser.NodeKind.Unary {
            let inner = self.widen_size_expr(m, n.x)
            var u = self.blank_node(parser.NodeKind.Unary, start, end)
            u.name = self.node(m, e).name.clone()
            u.x = inner
            return self.mods[m].parsed.tree.add(u)
        }
        return e
    }

    fn blank_node(self: *mut Self, k: parser.NodeKind, start: usize, end: usize) -> parser.Node {
        return parser.Node{
            .k = k, .start = start, .end = end, .name = String.new(), .text = String.new(),
            .flag = false, .flag2 = false, .a = 0, .b = 0,
            .kids = List(usize).new(), .kids2 = List(usize).new(),
            .x = NONE, .y = NONE, .z = NONE, .words = List(String).new(),
        }
    }

    /// A segment's size: `bits` when constant, else a checked `usize`
    /// expression in `size_expr`. Returns the size text for the dump.
    fn seg_size(self: *mut Self, m: usize, seg: usize, default_bits: u64, bits: *mut u64, size_expr: *mut usize) -> String {
        let sz = self.node(m, seg).y
        if sz == NONE {
            bits.*= default_bits
            return format("bits {}", .{default_bits})
        }
        if let v = self.const_eval_int(m, sz) {
            if v <= 0 {
                self.fail_here(self.node(m, sz).start, "segment size must be positive")
                bits.*= 8
                return String.from("bits 8")
            }
            bits.*= v as u64
            return format("bits {}", .{v})
        }
        let u = self.tys.usize_ty()
        let widened = self.widen_size_expr(m, sz)
        var te = self.check_expr(widened, u)
        te = self.coerce_or_error(te, u, "segment size")
        size_expr.*= te
        return String.from("expr")
    }

    fn int_type_for_bits(self: *mut Self, bits: u64, signed: bool) -> usize {
        var nm: []u8 = "u64"
        if bits <= 8 { nm = if signed { "i8" } else { "u8" } }
        else if bits <= 16 { nm = if signed { "i16" } else { "u16" } }
        else if bits <= 32 { nm = if signed { "i32" } else { "u32" } }
        else if signed { nm = "i64" }
        return self.tys.named(TK.Int, nm)
    }

    fn seg_node(self: *mut Self, ty: usize, start: usize, end: usize, kind: []u8, size: []u8, endian: []u8, signed: bool, float: bool, utf8: bool, value: usize, size_expr: usize) -> usize {
        let r = self.mk(TKind.Seg, ty, start, end)
        self.tir.nodes[r].name = format("{} size={} endian={} signed={} float={} utf8={}", .{kind, size, endian, signed, float, utf8})
        if value != NONE { self.tir.nodes[r].kids.append(value) }
        if size_expr != NONE { self.tir.nodes[r].kids.append(size_expr) }
        return r
    }

    fn check_bin_pattern(self: *mut Self, pat: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, pat)
        let segs = n.kids.clone()
        let start = n.start
        let end = n.end
        let bytes_t = self.tys.str_slice()
        let p = self.pat_node(TKind.PBinary, start, end)
        for seg, i in segs {
            var signed = false
            var float = false
            var utf8 = false
            let endian = self.seg_mods(m, seg, &mut signed, &mut float, &mut utf8)
            let sn = self.node(m, seg)
            let text = sn.text.clone()
            let name = sn.name.clone()
            let value_node = sn.x
            let sstart = sn.start
            let send = sn.end
            let has_size = sn.y != NONE
            if text == "rest" {
                if i != segs.len - 1 { self.fail_here(sstart, "a `bytes` segment consumes the remainder and must be last") }
                let l = self.declare_local(name[..], bytes_t, false, sstart, send)
                let r = self.seg_node(bytes_t, sstart, send, format("rest {}", .{l})[..], "rest", endian[..], signed, float, utf8, NONE, NONE)
                self.tir.nodes[p].kids.append(r)
                continue
            }
            if text == "bind" {
                let default_bits: u64 = if float { 64 } else { 8 }
                var bits: u64 = 0
                var size_expr = NONE
                let size = self.seg_size(m, seg, default_bits, &mut bits, &mut size_expr)
                var ty = bytes_t
                if size_expr == NONE {
                    if float {
                        if bits == 32 { ty = self.tys.named(TK.Float, "f32") }
                        else if bits == 64 { ty = self.tys.named(TK.Float, "f64") }
                        else {
                            self.fail_here(sstart, "float segments are 32 or 64 bits")
                            ty = self.tys.named(TK.Float, "f64")
                        }
                    } else if utf8 or bits > 64 {
                        if bits % 8 != 0 { self.fail_here(sstart, "byte-slice segments need a size that is a multiple of 8 bits") }
                        ty = bytes_t
                    } else {
                        ty = self.int_type_for_bits(bits, signed)
                    }
                }
                let l = self.declare_local(name[..], ty, false, sstart, send)
                let r = self.seg_node(ty, sstart, send, format("bind {}", .{l})[..], size[..], endian[..], signed, float, utf8, NONE, size_expr)
                self.tir.nodes[p].kids.append(r)
                continue
            }
            // a literal to match
            let vn = self.node(m, value_node)
            if vn.k == parser.NodeKind.Lit and (vn.text == "str" or vn.text == "bytes") {
                if has_size { self.fail_here(sstart, "string segments take their size from the literal") }
                let blen = vn.name.len
                let te = self.check_expr(value_node, NONE)
                let r = self.seg_node(bytes_t, sstart, send, "value", format("bits {}", .{blen * 8})[..], endian[..], signed, float, utf8, te, NONE)
                self.tir.nodes[p].kids.append(r)
                continue
            }
            var bits: u64 = 0
            var size_expr = NONE
            let size = self.seg_size(m, seg, 8, &mut bits, &mut size_expr)
            var ty = NONE
            if size_expr == NONE and float {
                ty = if bits == 32 { self.tys.named(TK.Float, "f32") } else { self.tys.named(TK.Float, "f64") }
            } else if size_expr == NONE and bits <= 64 {
                ty = self.int_type_for_bits(bits, signed)
            } else {
                self.fail_here(sstart, "literal segments must be at most 64 bits")
                ty = self.tys.named(TK.Int, "u64")
            }
            var te = self.check_expr(value_node, ty)
            te = self.coerce_or_error(te, ty, "binary segment literal")
            if self.tir.nodes[te].k == TKind.Int and size_expr == NONE and bits < 64 and !signed {
                let v = self.tir.nodes[te].ival
                if v < 0 or v >= (1 << (bits as u32)) {
                    self.fail_here(sstart, format("literal `{}` does not fit in {} bits", .{v, bits})[..])
                }
            }
            let r = self.seg_node(ty, sstart, send, "value", size[..], endian[..], signed, float, utf8, te, size_expr)
            self.tir.nodes[p].kids.append(r)
        }
        return p
    }

    fn check_bin_construct(self: *mut Self, e: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let segs = n.kids.clone()
        let target_node = n.x
        let start = n.start
        let end = n.end
        let bytes_t = self.tys.str_slice()
        let u = self.tys.u8_ty()
        let mut_bytes = self.tys.wrap(TK.Slice, u, true)
        var t = self.check_expr(target_node, mut_bytes)
        t = self.coerce_or_error(t, mut_bytes, "construction target (needs `[]mut u8`)")
        var out = List(usize).new()
        for seg in segs {
            var signed = false
            var float = false
            var utf8 = false
            let endian = self.seg_mods(m, seg, &mut signed, &mut float, &mut utf8)
            let sn = self.node(m, seg)
            let text = sn.text.clone()
            let sstart = sn.start
            let send = sn.end
            // a bound name is the identifier of that name
            var value_node = sn.x
            if text != "expr" {
                var id = self.blank_node(parser.NodeKind.Ident, sstart, send)
                id.name = sn.name.clone()
                value_node = self.mods[m].parsed.tree.add(id)
            }
            var is_rest = text == "rest"
            for w in self.node(m, seg).words.clone() { if w == "bytes" { is_rest = true } }
            if is_rest {
                var te = self.check_expr(value_node, bytes_t)
                te = self.coerce_or_error(te, bytes_t, "byte segment")
                out.append(self.seg_node(bytes_t, sstart, send, "value", "rest", endian[..], signed, float, utf8, te, NONE))
                continue
            }
            let vn = self.node(m, value_node)
            if vn.k == parser.NodeKind.Lit and (vn.text == "str" or vn.text == "bytes") {
                let blen = vn.name.len
                let te = self.check_expr(value_node, NONE)
                out.append(self.seg_node(bytes_t, sstart, send, "value", format("bits {}", .{blen * 8})[..], endian[..], signed, float, utf8, te, NONE))
                continue
            }
            let default_bits: u64 = if float { 64 } else { 8 }
            var bits: u64 = 0
            var size_expr = NONE
            let size = self.seg_size(m, seg, default_bits, &mut bits, &mut size_expr)
            var te = self.check_expr(value_node, NONE)
            let vt = self.tys.resolve(self.tir.nodes[te].ty, true)
            let vk = self.tys.kind(vt)
            if vk == TK.Int or vk == TK.Char or vk == TK.Bool {
            } else if vk == TK.Float and self.tys.list[vt].name == "f32" {
                if ! (size_expr == NONE and bits == 32) and !float { self.fail_here(sstart, "an f32 segment needs `:32/float`") }
            } else if vk == TK.Float {
                if !float { self.fail_here(sstart, "float values need the `/float` modifier") }
            } else if vk == TK.Slice and self.tys.kind(self.tys.shallow(self.tys.list[vt].args[0])) == TK.Int and self.tys.list[self.tys.shallow(self.tys.list[vt].args[0])].name == "u8" {
                out.append(self.seg_node(bytes_t, sstart, send, "value", size[..], endian[..], signed, float, utf8, te, size_expr))
                continue
            } else if vk == TK.Str {
                var w = tblank(TKind.StrToSlice, bytes_t, sstart, send)
                w.kids.append(te)
                let te2 = self.tir.add(w)
                out.append(self.seg_node(bytes_t, sstart, send, "value", size[..], endian[..], signed, float, utf8, te2, size_expr))
                continue
            } else {
                self.fail_here(sstart, format("cannot write a value of type `{}` into a binary; use integers, floats, or `[]u8`", .{self.ty_name(vt)})[..])
            }
            out.append(self.seg_node(vt, sstart, send, "value", size[..], endian[..], signed, float, utf8, te, size_expr))
        }
        let ret = self.tys.err_union(0, false, bytes_t)
        let r = self.mk(TKind.BinConstruct, ret, start, end)
        for o in out { self.tir.nodes[r].kids.append(o) }
        self.tir.nodes[r].kids.append(t)
        return r
    }

    // ----- @builtins ------------------------------------------------------------------------

    fn check_at_builtin(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let name = n.name.clone()
        let args = n.kids.clone()
        let start = n.start
        let end = n.end
        _ = expected
        let bytes = self.tys.str_slice()
        if name == "typeName" or name == "sizeOf" {
            if !self.args_n(args[..], 1, if name == "typeName" { "@typeName" } else { "@sizeOf" }, start) { return self.error_expr(start, end) }
            let te = self.check_expr(args[0], NONE)
            var t = self.tir.nodes[te].ty
            if self.tir.nodes[te].k == TKind.TypeVal { t = self.tir.nodes[te].a }
            t = self.tys.resolve(t, true)
            if name == "typeName" {
                let r = self.mk(TKind.Str, bytes, start, end)
                self.tir.nodes[r].text = self.ty_name(t)
                return r
            }
            let u = self.tys.usize_ty()
            return self.int_node(self.size_of(t) as i128, u, start, end)
        }
        if name == "truncate" {
            if !self.args_n(args[..], 2, "@truncate", start) { return self.error_expr(start, end) }
            let te = self.check_expr(args[0], NONE)
            if self.tir.nodes[te].k != TKind.TypeVal {
                self.fail_here(start, "the first argument of @truncate is the target type")
                return self.error_expr(start, end)
            }
            let t = self.tir.nodes[te].a
            let v = self.check_expr(args[1], NONE)
            if !self.tys.is_integer(t) or !self.tys.is_integer(self.tir.nodes[v].ty) { self.fail_here(start, "@truncate converts between integer types") }
            let vt = self.tys.resolve(self.tir.nodes[v].ty, true)
            self.tir.nodes[v].ty = vt
            let b = self.builtin_node("Truncate", t, start, end)
            self.tir.nodes[b].kids.append(v)
            self.tir.nodes[b].kids2.append(t)
            return b
        }
        if name == "errorName" {
            if !self.args_n(args[..], 1, "@errorName", start) { return self.error_expr(start, end) }
            let x = self.check_expr(args[0], NONE)
            let t = self.tys.shallow(self.tir.nodes[x].ty)
            if self.tys.kind(t) != TK.ErrorSet { self.fail_here(start, format("@errorName takes an error value but found `{}`", .{self.ty_name(t)})[..]) }
            let b = self.builtin_node("ErrorName", bytes, start, end)
            self.tir.nodes[b].kids.append(x)
            return b
        }
        if name == "embedFile" {
            if !self.args_n(args[..], 1, "@embedFile", start) { return self.error_expr(start, end) }
            let an = self.node(m, args[0])
            if ! (an.k == parser.NodeKind.Lit and an.text == "str") {
                self.fail_here(an.start, "@embedFile takes a string literal path (a declared build input)")
                return self.error_expr(start, end)
            }
            let path = an.name.clone()
            let dir = self.mods[m].dir.clone()
            let full = if dir.len == 0 { path.clone() } else { format("{}/{}", .{dir, path}) }
            let data = io.read_file(full[..]) catch {
                self.fail_here(start, format("@embedFile: cannot read `{}`", .{full})[..])
                return self.error_expr(start, end)
            }
            let r = self.mk(TKind.Str, bytes, start, end)
            self.tir.nodes[r].text = data
            return r
        }
        if name == "cstr" {
            if !self.args_n(args[..], 1, "@cstr", start) { return self.error_expr(start, end) }
            let an = self.node(m, args[0])
            if ! (an.k == parser.NodeKind.Lit and an.text == "str") {
                self.fail_here(an.start, "@cstr takes a string literal and yields a NUL-terminated `*u8` for C")
                return self.error_expr(start, end)
            }
            let u8t = self.tys.u8_ty()
            let pt = self.tys.wrap(TK.Ptr, u8t, false)
            let lit = self.mk(TKind.Str, bytes, start, end)
            self.tir.nodes[lit].text = an.name.clone()
            let b = self.builtin_node("PtrAdd", pt, start, end)
            self.tir.nodes[b].kids.append(lit)
            return b
        }
        if name == "weak" or name == "refCount" {
            if !self.args_n(args[..], 1, if name == "weak" { "@weak" } else { "@refCount" }, start) { return self.error_expr(start, end) }
            let x = self.check_expr(args[0], NONE)
            let t = self.tys.resolve(self.tir.nodes[x].ty, true)
            if !self.is_ref_class(t) {
                self.fail_here(start, format("@{} takes a `ref class` value", .{name})[..])
                return self.error_expr(start, end)
            }
            if name == "weak" {
                let wt = self.tys.wrap(TK.Weak, t, false)
                self.add_effect(EFF_REFCOUNTS, start, "creating a weak reference touches the count")
                let b = self.builtin_node("Weak", wt, start, end)
                self.tir.nodes[b].kids.append(x)
                self.tir.nodes[b].kids2.append(t)
                return b
            }
            let u = self.tys.usize_ty()
            let b = self.builtin_node("RefCount", u, start, end)
            self.tir.nodes[b].kids.append(x)
            return b
        }
        self.fail_here(start, format("unknown builtin `@{}`", .{name})[..])
        for a in args { _ = self.check_expr(a, NONE) }
        return self.error_expr(start, end)
    }

    /// Sizes and alignments of types, as the C backend lays them out.
    fn size_of(self: *mut Self, t0: usize) -> u64 {
        let t = self.tys.shallow(t0)
        let k = self.tys.kind(t)
        if k == TK.Int { return (int_bits(self.tys.list[t].name[..]) / 8) as u64 }
        if k == TK.Float { return if self.tys.list[t].name == "f32" { 4 } else { 8 } }
        if k == TK.Bool { return 1 }
        if k == TK.Char { return 4 }
        if k == TK.Void or k == TK.Never { return 0 }
        if k == TK.Array { return self.tys.list[t].n * self.size_of(self.tys.list[t].args[0]) }
        if k == TK.Slice or k == TK.Fn { return 16 }
        if k == TK.Ptr or k == TK.Weak { return 8 }
        if k == TK.Opt {
            let e = self.tys.list[t].args[0]
            return round_up(self.size_of(e) + 1, self.align_of(e))
        }
        if k == TK.ErrUnion {
            let e = self.tys.list[t].args[0]
            let a = max64(self.align_of(e), 4)
            return round_up(round_up(4, self.align_of(e)) + self.size_of(e), a)
        }
        if k == TK.Distinct { return self.size_of(self.distinct_underlying(self.tys.list[t].def)) }
        if k == TK.List or k == TK.Str { return 24 }
        if k == TK.Map { return 40 }
        if k == TK.Struct or k == TK.Tuple {
            if k == TK.Struct and self.is_ref_class(t) { return 8 }
            let fts = if k == TK.Struct { self.struct_field_types(t) } else { self.tys.list[t].args.clone() }
            var off: u64 = 0
            var maxa: u64 = 1
            for f in fts {
                let a = self.align_of(f)
                maxa = max64(maxa, a)
                off = round_up(off, a) + self.size_of(f)
            }
            return round_up(off, maxa)
        }
        if k == TK.Enum {
            let vtys = self.enum_variant_types(t)
            var maxs: u64 = 0
            var maxa: u64 = 4
            for v in vtys {
                var off: u64 = 0
                for f in v {
                    let a = self.align_of(f)
                    maxa = max64(maxa, a)
                    off = round_up(off, a) + self.size_of(f)
                }
                maxs = max64(maxs, off)
            }
            return round_up(round_up(4, maxa) + maxs, maxa)
        }
        return 8
    }

    fn align_of(self: *mut Self, t0: usize) -> u64 {
        let t = self.tys.shallow(t0)
        let k = self.tys.kind(t)
        if k == TK.Int { return min64((int_bits(self.tys.list[t].name[..]) / 8) as u64, 16) }
        if k == TK.Float { return if self.tys.list[t].name == "f32" { 4 } else { 8 } }
        if k == TK.Bool { return 1 }
        if k == TK.Char { return 4 }
        if k == TK.Void or k == TK.Never { return 1 }
        if k == TK.Array or k == TK.Opt { return self.align_of(self.tys.list[t].args[0]) }
        if k == TK.ErrUnion { return max64(self.align_of(self.tys.list[t].args[0]), 4) }
        if k == TK.Distinct { return self.align_of(self.distinct_underlying(self.tys.list[t].def)) }
        if k == TK.Struct or k == TK.Tuple {
            if k == TK.Struct and self.is_ref_class(t) { return 8 }
            let fts = if k == TK.Struct { self.struct_field_types(t) } else { self.tys.list[t].args.clone() }
            var maxa: u64 = 1
            for f in fts { maxa = max64(maxa, self.align_of(f)) }
            return maxa
        }
        if k == TK.Enum {
            let vtys = self.enum_variant_types(t)
            var maxa: u64 = 1
            for v in vtys { for f in v { maxa = max64(maxa, self.align_of(f)) } }
            return max64(maxa, 4)
        }
        return 8
    }
}

fn max64(a: u64, b: u64) -> u64 { return if a > b { a } else { b } }
fn min64(a: u64, b: u64) -> u64 { return if a < b { a } else { b } }

fn round_up(v: u64, a: u64) -> u64 {
    if a == 0 { return v }
    return ((v + a - 1) / a) * a
}

// ---------------------------------------------------------------- closures

impl Checker {
    fn check_closure(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let param_nodes = n.kids.clone()
        let capture_nodes = n.kids2.clone()
        let ret_node = n.y
        let body_node = n.x
        let start = n.start
        let end = n.end
        // the expected function type supplies omitted parameter and return types
        var exp = NONE
        if expected != NONE {
            let ex = self.tys.shallow(expected)
            if self.tys.kind(ex) == TK.Fn { exp = ex }
        }
        var exp_params = List(usize).new()
        var exp_ret = NONE
        var exp_eff: u64 = EFF_ALL
        if exp != NONE {
            let all = self.tys.list[exp].args.clone()
            for a, i in all { if i + 1 < all.len { exp_params.append(a) } }
            exp_ret = all[all.len - 1]
            exp_eff = self.tys.list[exp].n
        }
        let st = self.ctx().self_ty
        var ptys = List(usize).new()
        var pnames = List(String).new()
        var pstarts = List(usize).new()
        var pends = List(usize).new()
        for p, i in param_nodes {
            let pn = self.node(m, p)
            let pname = pn.name.clone()
            let ty_node = pn.x
            let pstart = pn.start
            let pend = pn.end
            var t = NONE
            if self.node(m, ty_node).k == parser.NodeKind.TInfer {
                if i < exp_params.len {
                    t = exp_params[i]
                } else {
                    self.fail_here(pstart, format("closure parameter `{}` needs a type annotation", .{pname})[..])
                    t = self.tys.void()
                }
            } else {
                t = self.resolve_type(m, ty_node, st)
            }
            ptys.append(t)
            pnames.append(pname)
            pstarts.append(pstart)
            pends.append(pend)
        }
        var ret = NONE
        if ret_node != NONE {
            ret = self.resolve_type(m, ret_node, st)
        } else if exp != NONE {
            ret = exp_ret
        } else {
            ret = self.tys.fresh_infer()
        }
        if exp != NONE and exp_params.len != ptys.len {
            self.fail_here(start, format("expected a closure with {} parameter(s) but it has {}", .{exp_params.len, ptys.len})[..])
        }
        // captures: by value moves a resource, by reference needs a `var` for `&mut`
        var cap_locals = List(usize).new()
        var cap_refs = List(bool).new()
        var cap_muts = List(bool).new()
        var cap_tys = List(usize).new()
        var cap_names = List(String).new()
        var cap_starts = List(usize).new()
        var cap_ends = List(usize).new()
        for c in capture_nodes {
            let cn = self.node(m, c)
            let cname = cn.name.clone()
            let by_ref = cn.flag
            let mutable = cn.flag2
            let cstart = cn.start
            let cend = cn.end
            let l = self.lookup_local(cname[..])
            if l == NONE {
                self.fail_here(cstart, format("cannot capture `{}`: no such local", .{cname})[..])
                continue
            }
            let lt = self.ctx().locals[l].ty
            if by_ref and mutable and !self.ctx().locals[l].mutable {
                self.fail_here(cstart, format("cannot capture `{}` by mutable reference; declare it with `var`", .{cname})[..])
            }
            if !by_ref {
                let le = self.mk(TKind.Local, lt, cstart, cend)
                self.tir.nodes[le].a = l
                _ = self.take_ownership(le)
            }
            cap_locals.append(l)
            cap_refs.append(by_ref)
            cap_muts.append(mutable)
            cap_tys.append(lt)
            cap_names.append(cname)
            cap_starts.append(cstart)
            cap_ends.append(cend)
        }
        // the instance
        let id = self.insts.len
        var locals = List(Local).new()
        var params = List(usize).new()
        for t, i in ptys {
            locals.append(Local{ .name = pnames[i].clone(), .ty = t, .mutable = false, .start = pstarts[i], .end = pends[i], .is_param = true, .owned = false, .loop_item = false })
            params.append(i)
        }
        let fname = self.ctx().fn_name.clone()
        self.insts.append(Inst{
                .name = format("closure in {}", .{fname}), .mangled = format("nx_closure_{}", .{id}), .def = NONE, .targs = List(usize).new(),
                .gen_names = self.env_names.clone(), .gen_tys = self.env_tys.clone(),
                .params = params, .ret = ret, .locals = locals, .body = NONE,
                .own_effects = 0, .effects = 0, .declared_neg = 0, .declared_pos = 0, .export_name = String.from("-"),
                .is_extern = false, .is_variadic = false, .is_pub = false, .is_test = false, .test_comptime = false,
                .is_closure = true, .closure_by_ref = cap_refs.clone(), .start = start, .end = end, .module = m, .self_ty = st,
                .witnesses = List(Witness).new(), .callees = List(usize).new(),
        })
        self.check_closure_body(id, body_node, &cap_names, &cap_refs, &cap_muts, &cap_tys, &cap_starts, &cap_ends)
        if exp_eff != EFF_ALL { self.oblige(id, EFF_ALL & ~exp_eff, start) }
        let ft = self.tys.func(ptys, ret, exp_eff)
        let r = self.mk(TKind.Closure, ft, start, end)
        self.tir.nodes[r].a = id
        for l, i in cap_locals {
            self.tir.nodes[r].kids2.append(l)
            self.tir.nodes[r].kids.append(if cap_refs[i] { 1 } else { 0 })
        }
        return r
    }

    fn check_closure_body(self: *mut Self, inst: usize, body_node: usize, names: *List(String), refs: *List(bool), muts: *List(bool), tys: *List(usize), starts: *List(usize), ends: *List(usize)) {
        let m = self.insts[inst].module
        let ret = self.insts[inst].ret
        var ctx = new_ctx(ret, m, self.insts[inst].name[..])
        ctx.self_ty = self.insts[inst].self_ty
        ctx.locals = self.insts[inst].locals.clone()
        ctx.scope_marks.append(0)
        for p in self.insts[inst].params {
            ctx.scope_names.append(ctx.locals[p].name.clone())
            ctx.scope_locals.append(p)
            ctx.scope_deref.append(false)
        }
        // captured variables become locals: by-value copies, or pointers dereferenced on use
        for nm, i in names {
            let lid = ctx.locals.len
            let by_ref = refs[i]
            let mutable = muts[i]
            let lty = if by_ref { self.tys.wrap(TK.Ptr, tys[i], mutable) } else { tys[i] }
            ctx.locals.append(Local{ .name = format("cap_{}", .{nm}), .ty = lty, .mutable = mutable or !by_ref, .start = starts[i], .end = ends[i], .is_param = true, .owned = false, .loop_item = false })
            ctx.scope_names.append(nm.clone())
            ctx.scope_locals.append(lid)
            ctx.scope_deref.append(by_ref)
        }
        self.ctxs.append(ctx)
        // an expression body is a block with that tail
        var block_node = body_node
        let bn = self.node(m, body_node)
        let is_block = bn.k == parser.NodeKind.Block
        let bstart = bn.start
        let bend = bn.end
        var ret_hint = ret
        if self.tys.contains_infer(ret) { ret_hint = NONE }
        var tb = NONE
        if is_block {
            tb = self.check_block(block_node, ret_hint, NONE, NONE)
        } else {
            // the same as check_block on a synthetic block holding the expression
            self.push_scope()
            var te = self.check_expr(body_node, ret_hint)
            let tt = self.tys.shallow(self.tir.nodes[te].ty)
            let tk = self.tys.kind(tt)
            var is_void_expected = false
            if ret_hint != NONE { is_void_expected = self.tys.kind(self.tys.shallow(ret_hint)) == TK.Void }
            tb = self.mk(TKind.Block, NONE, bstart, bend)
            var ty = self.tys.void()
            if is_void_expected and ! (tk == TK.Void or tk == TK.Never) {
                self.check_unused(te)
                let s = self.mk(TKind.SExpr, tt, bstart, bend)
                self.tir.nodes[s].kids.append(te)
                self.tir.nodes[tb].kids.append(s)
            } else if tk == TK.Void {
                let s = self.mk(TKind.SExpr, tt, bstart, bend)
                self.tir.nodes[s].kids.append(te)
                self.tir.nodes[tb].kids.append(s)
            } else {
                if ret_hint != NONE and !is_void_expected { te = self.coerce_or_error(te, ret_hint, "block value") }
                te = self.take_ownership(te)
                ty = self.tir.nodes[te].ty
                self.tir.nodes[tb].a = te
            }
            if self.tir.nodes[tb].a == NONE and self.block_diverges(tb) { ty = self.tys.never() }
            self.tir.nodes[tb].ty = ty
            self.pop_scope()
        }
        // infer the return type from the body when it was not annotated
        if self.tys.contains_infer(ret) {
            let bt = self.tir.nodes[tb].ty
            var target = NONE
            if self.tir.nodes[tb].a != NONE {
                target = bt
            } else if self.block_diverges(tb) {
                target = ret
            } else {
                target = self.tys.void()
            }
            if !self.tys.contains_infer(target) { _ = self.unify(ret, target) }
        }
        let tb2 = self.finalize_block_as_body(tb, ret)
        let done = self.ctxs.pop() orelse return
        self.insts[inst].locals = done.locals.clone()
        self.insts[inst].body = tb2
        self.insts[inst].own_effects = done.own_effects
        self.insts[inst].witnesses = done.witnesses.clone()
        self.insts[inst].callees = done.callees.clone()
        self.insts[inst].ret = self.tys.resolve(ret, true)
    }
}

pub fn new_checker(own mods: List(Mod)) -> Checker {
    return Checker{
        .mods = mods, .tys = Types{ .list = List(Ty).new(), .index = Map(String, usize).new(), .subst = List(usize).new(), .infer_kinds = List(u8).new() },
        .items = Map(String, ItemRef).new(), .imports = Map(String, ImportRef).new(),
        .structs = List(StructDef).new(), .enums = List(EnumDef).new(), .traits = List(TraitDef).new(),
        .impls = List(ImplDef).new(), .fns = List(FnDef).new(), .consts = List(ConstDef).new(),
        .globals = List(GlobalDef).new(), .aliases = List(AliasDef).new(), .error_sets = List(ErrorSetDef).new(),
        .errors = List(String).new(), .error_names = List(String).new(), .error_ids = Map(String, usize).new(),
        .insts = List(Inst).new(), .inst_map = Map(String, usize).new(), .queue = List(usize).new(), .tir = Tir{ .nodes = List(T).new() },
        .ctxs = List(FnCtx).new(), .main_inst = NONE, .tests = List(usize).new(),
        .env_names = List(String).new(), .env_tys = List(usize).new(),
        .record_new_mode = false, .vtables = List(VTable).new(), .obligations = List(Obligation).new(),
        .parallel_calls = List(Obligation).new(), .global_uses = List(Obligation).new(), .global_use_fns = List(String).new(), .artifact_kinds = List(String).new(), .wild_pat_node = NONE,
        .cc = List(String).new(), .target = String.new(), .cimport_headers = List(String).new(), .cimport_system = List(bool).new(), .cimport_unsupported = Map(String, String).new(),
        .values = List(CV).new(),
        .it_steps = 0, .it_panic = String.new(), .it_panic_at = NONE, .it_has_panic = false, .it_budget = false,
        .it_pending = 0, .it_pending_label = NONE, .it_pending_val = cv_none(), .it_failed_at = NONE,
        .frames = List(Frame).new(), .it_cur_fn = NONE, .it_out = cv_none(), .it_flow_val = cv_none(), .it_flow_label = NONE,
        .cv_bad = cv_none(),
    }
}

fn main() -> !void {
    let args = os.args()
    if args.len < 2 {
        eprintln("usage: check <file.nx> [--std <dir>]", .{})
        os.exit(2)
    }
    var std_dir: []u8 = "std"
    var i: usize = 2
    while i < args.len {
        if args[i] == "--std" and i + 1 < args.len {
            std_dir = args[i + 1]
            i += 2
        } else {
            i += 1
        }
    }
    var sigs = false
    var cc_text = String.new()
    var target = String.new()
    i = 2
    while i < args.len {
        if args[i] == "--sigs" { sigs = true }
        if args[i] == "--cc" and i + 1 < args.len { cc_text = String.from(args[i + 1]); i += 1 }
        if args[i] == "--target" and i + 1 < args.len { target = String.from(args[i + 1]); i += 1 }
        i += 1
    }
    if cc_text.len == 0 { if let v = os.env("NX_CC") { cc_text = String.from(v) } }
    var cc = List(String).new()
    if cc_text.len > 0 {
        for w in cc_text[..].split(" ") { if w.len > 0 { cc.append(String.from(w)) } }
    } else if let z = os.env("NX_ZIG") {
        cc.append(String.from(z))
        cc.append(String.from("cc"))
    } else {
        cc.append(String.from("zig"))
        cc.append(String.from("cc"))
    }
    let mods = try load(args[1], std_dir)
    var c = new_checker(mods)
    c.cc = cc
    c.target = target
    c.collect()
    c.reserve_errors()
    var out = String.new()
    if sigs {
        c.resolve_globals()
        c.print_sigs(&mut out)
    } else {
        c.check_program()
        c.print_program(&mut out)
    }
    print("{}", .{out})
    for e in c.errors { eprintln("error: {}", .{e}) }
    if c.errors.len > 0 { os.exit(1) }
}
