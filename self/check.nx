// self/check.nx: the checker. It loads the modules, collects every
// declaration, interns types, resolves signatures and instantiates generics,
// then checks every body into the typed IR with its types, effects and
// ownership. This file holds the checker's state and its core: types,
// definitions, loading, the typed IR, instances and the passes over the
// whole program, the generic environment, ownership, unification and
// ranges. The rest of its methods sit in modules of their own (decision
// 110), one responsibility each:
//
//     check_stmts     bodies, blocks, statements and loops
//     check_views     views and their origins: the rules V1 to V5
//     check_exprs     expressions, function calls, `if` and casts
//     check_fields    fields, literals, indexing, `try`, `catch`, `orelse`
//     check_calls     methods, static members, the builtin namespaces
//     check_match     `match`, patterns and exhaustiveness
//     check_builtins  the `@` builtins and layout
//     check_closures  closures
//     check_print     the typed IR as text (`nx tir`)
//     check_interp    the compile-time interpreter
//
// On its own it prints the checked program as `nx tir` does (`--sigs`: the
// declarations only):
//
//     nx run self/check.nx examples/tour.nx [--sigs] [--std std]

import lexer
import parser
import manifest
import cimport
// the modules holding the rest of the checker's methods: importing them is
// what makes them part of the program
import check_stmts
import check_views
import check_exprs
import check_fields
import check_calls
import check_match
import check_builtins
import check_closures
import check_print
import check_interp

pub const NONE: usize = 0xFFFFFFFFFFFFFFFF
pub const NONE_NAME: []u8 = ""

const BUILTIN_NAMESPACES = ["math", "io", "os", "time", "random", "fmt", "utf8", "ascii", "mem", "slice", "process", "test", "alloc", "net", "thread", "sync"]
const EFFECT_NAMES = ["allocates", "refcounts", "blocks", "shared_mutable", "nondeterministic", "panics", "ffi", "unbounded_stack"]
const INT_NAMES = ["i8", "i16", "i32", "i64", "i128", "isize", "u8", "u16", "u32", "u64", "u128", "usize"]

// ---------------------------------------------------------------- types

pub enum TK {
    Int, Float, Bool, Char, Void, Never,
    Struct, Enum, Array, Slice, Ptr, Opt, ErrUnion, Fn, Tuple, Distinct, Weak, List, Str, Map, Type, ErrorSet, Dyn, Infer,
}

/// One interned type. `name` is the primitive's spelling (`i32`, `f64`),
/// `def` a definition index, `n` an array length or an effect mask,
/// `flag` mutability (slices, pointers) or "has an error set", and
/// `args` the element, parameter, or argument types.
pub struct Ty {
    k: TK
    name: String
    def: usize
    n: u64
    flag: bool
    args: List(usize)
}

fn tk_tag(k: TK) -> u8 {
    match k {
        .Int => 0, .Float => 1, .Bool => 2, .Char => 3, .Void => 4, .Never => 5,
        .Struct => 6, .Enum => 7, .Array => 8, .Slice => 9, .Ptr => 10, .Opt => 11, .ErrUnion => 12,
        .Fn => 13, .Tuple => 14, .Distinct => 15, .Weak => 16, .List => 17, .Str => 18, .Map => 19,
        .Type => 20, .ErrorSet => 21, .Dyn => 22, .Infer => 23,
    }
}

pub struct Types {
    list: List(Ty)
    index: Map(String, usize)
    // inference variables: what each is bound to (NONE while open) and its
    // kind (0 any, 1 integer literal, 2 float literal)
    subst: List(usize)
    infer_kinds: List(u8)
}

const INFER_ANY: u8 = 0
pub const INFER_INT: u8 = 1
pub const INFER_FLOAT: u8 = 2

impl Types {
    fn key(t: *Ty) -> String {
        var k = format("{}:{}:{}:{}:{}:", .{tk_tag(t.k), t.name, t.def, t.n, t.flag})
        for a in t.args { k.append(format("{},", .{a})) }
        return k
    }

    fn intern(self: *mut Self, own t: Ty) -> usize {
        let k = Types.key(&t)
        if let id = self.index.get(k[..]) { return id }
        self.list.append(t)
        let id = self.list.len - 1
        self.index.put(k, id)
        return id
    }

    fn simple(self: *mut Self, k: TK) -> usize {
        return self.intern(Ty{ .k = k, .name = String.new(), .def = 0, .n = 0, .flag = false, .args = List(usize).new() })
    }
    fn named(self: *mut Self, k: TK, name: []u8) -> usize {
        return self.intern(Ty{ .k = k, .name = String.from(name), .def = 0, .n = 0, .flag = false, .args = List(usize).new() })
    }
    fn of_def(self: *mut Self, k: TK, def: usize, own args: List(usize)) -> usize {
        return self.intern(Ty{ .k = k, .name = String.new(), .def = def, .n = 0, .flag = false, .args = args })
    }
    fn wrap(self: *mut Self, k: TK, elem: usize, flag: bool) -> usize {
        var args = List(usize).new()
        args.append(elem)
        return self.intern(Ty{ .k = k, .name = String.new(), .def = 0, .n = 0, .flag = flag, .args = args })
    }
    fn array(self: *mut Self, n: u64, elem: usize) -> usize {
        var args = List(usize).new()
        args.append(elem)
        return self.intern(Ty{ .k = TK.Array, .name = String.new(), .def = 0, .n = n, .flag = false, .args = args })
    }
    fn err_union(self: *mut Self, set: usize, has_set: bool, elem: usize) -> usize {
        var args = List(usize).new()
        args.append(elem)
        return self.intern(Ty{ .k = TK.ErrUnion, .name = String.new(), .def = set, .n = 0, .flag = has_set, .args = args })
    }
    fn map(self: *mut Self, key: usize, value: usize) -> usize {
        var args = List(usize).new()
        args.append(key)
        args.append(value)
        return self.intern(Ty{ .k = TK.Map, .name = String.new(), .def = 0, .n = 0, .flag = false, .args = args })
    }
    /// `fn(params) -> ret` with the permitted effect mask in `n`; the return
    /// type is the last argument.
    fn func(self: *mut Self, own params: List(usize), ret: usize, effects: u64) -> usize {
        var args = params
        args.append(ret)
        return self.intern(Ty{ .k = TK.Fn, .name = String.new(), .def = 0, .n = effects, .flag = false, .args = args })
    }
    fn dyn_of(self: *mut Self, trait_id: usize, effects: u64) -> usize {
        return self.intern(Ty{ .k = TK.Dyn, .name = String.new(), .def = trait_id, .n = effects, .flag = false, .args = List(usize).new() })
    }
    fn tuple(self: *mut Self, own ts: List(usize)) -> usize {
        return self.intern(Ty{ .k = TK.Tuple, .name = String.new(), .def = 0, .n = 0, .flag = false, .args = ts })
    }
    fn int(self: *mut Self, name: []u8) -> usize { return self.named(TK.Int, name) }
    fn float64(self: *mut Self) -> usize { return self.named(TK.Float, "f64") }
    fn void(self: *mut Self) -> usize { return self.simple(TK.Void) }
    fn never(self: *mut Self) -> usize { return self.simple(TK.Never) }
    fn bool_ty(self: *mut Self) -> usize { return self.simple(TK.Bool) }
    fn char_ty(self: *mut Self) -> usize { return self.simple(TK.Char) }
    fn usize_ty(self: *mut Self) -> usize { return self.named(TK.Int, "usize") }
    fn u8_ty(self: *mut Self) -> usize { return self.named(TK.Int, "u8") }
    fn str_slice(self: *mut Self) -> usize {
        let u = self.u8_ty()
        return self.wrap(TK.Slice, u, false)
    }
    fn string(self: *mut Self) -> usize { return self.simple(TK.Str) }
    fn type_ty(self: *mut Self) -> usize { return self.simple(TK.Type) }

    /// A fresh inference variable of the given kind; `n` holds its index.
    fn fresh_infer_kind(self: *mut Self, kind: u8) -> usize {
        let n = self.subst.len
        self.subst.append(NONE)
        self.infer_kinds.append(kind)
        return self.intern(Ty{ .k = TK.Infer, .name = String.new(), .def = 0, .n = n as u64, .flag = false, .args = List(usize).new() })
    }
    fn fresh_infer(self: *mut Self) -> usize { return self.fresh_infer_kind(INFER_ANY) }
    fn int_lit(self: *mut Self) -> usize { return self.fresh_infer_kind(INFER_INT) }
    fn float_lit(self: *mut Self) -> usize { return self.fresh_infer_kind(INFER_FLOAT) }

    fn kind(self: *Self, t: usize) -> TK { return self.list[t].k }
    fn infer_index(self: *Self, t: usize) -> usize { return self.list[t].n as usize }

    /// Follow inference bindings to the representative type.
    fn shallow(self: *Self, t0: usize) -> usize {
        var t = t0
        while self.list[t].k == TK.Infer {
            let b = self.subst[self.list[t].n as usize]
            if b == NONE { return t }
            t = b
        }
        return t
    }

    fn infer_kind_of(self: *Self, t: usize) -> ?u8 {
        let s = self.shallow(t)
        if self.list[s].k != TK.Infer { return null }
        return self.infer_kinds[self.list[s].n as usize]
    }

    fn is_integer(self: *Self, t: usize) -> bool {
        let s = self.shallow(t)
        if self.list[s].k == TK.Int { return true }
        if let k = self.infer_kind_of(s) { return k == INFER_INT }
        return false
    }
    fn is_float(self: *Self, t: usize) -> bool {
        let s = self.shallow(t)
        if self.list[s].k == TK.Float { return true }
        if let k = self.infer_kind_of(s) { return k == INFER_FLOAT }
        return false
    }
    fn is_numeric(self: *Self, t: usize) -> bool { return self.is_integer(t) or self.is_float(t) }

    /// Fully resolve a type, substituting bound inference variables and
    /// defaulting open literals (`i64`, `f64`) when `default_lits` is set.
    fn resolve(self: *mut Self, t0: usize, default_lits: bool) -> usize {
        let t = self.shallow(t0)
        let k = self.list[t].k
        if k == TK.Infer {
            if !default_lits { return t }
            let n = self.list[t].n as usize
            let ik = self.infer_kinds[n]
            if ik == INFER_INT {
                let r = self.int("i64")
                self.subst[n] = r
                return r
            }
            if ik == INFER_FLOAT {
                let r = self.float64()
                self.subst[n] = r
                return r
            }
            return t
        }
        if self.list[t].args.len == 0 { return t }
        var copy = Ty{ .k = k, .name = self.list[t].name.clone(), .def = self.list[t].def, .n = self.list[t].n, .flag = self.list[t].flag, .args = List(usize).new() }
        let args = self.list[t].args.clone()
        for a in args { copy.args.append(self.resolve(a, default_lits)) }
        return self.intern(copy)
    }

    fn contains_infer(self: *Self, t0: usize) -> bool {
        let t = self.shallow(t0)
        if self.list[t].k == TK.Infer { return true }
        for a in self.list[t].args { if self.contains_infer(a) { return true } }
        return false
    }
}

/// Integer type facts by name.
/// The value of an integer literal's digits (the lexer's decimal text). A
/// value only `u128` holds, past `i128`'s maximum, comes back as its bit
/// pattern with `big` set; null when not even a `u128` holds it.
pub fn parse_int_literal(text: []u8, big: *mut bool) -> ?i128 {
    big.* = false
    let v = text.parse_int(i128) catch {
        let u = text.parse_int(u128) catch { return null }
        big.* = true
        return @truncate(i128, u)
    }
    return v
}

pub fn int_bits(name: []u8) -> u32 {
    if name == "i8" or name == "u8" { return 8 }
    if name == "i16" or name == "u16" { return 16 }
    if name == "i32" or name == "u32" { return 32 }
    if name == "i128" or name == "u128" { return 128 }
    return 64
}
pub fn int_signed(name: []u8) -> bool { return name[0] == 'i' }
pub fn int_min(name: []u8) -> i128 {
    if !int_signed(name) { return 0 }
    if name == "i128" { return -170141183460469231731687303715884105727 - 1 }
    return -((1 as i128) << (int_bits(name) - 1))
}
pub fn int_max(name: []u8) -> i128 {
    if name == "i128" { return 170141183460469231731687303715884105727 }
    if name == "u128" { return 170141183460469231731687303715884105727 }
    if int_signed(name) { return ((1 as i128) << (int_bits(name) - 1)) - 1 }
    return ((1 as i128) << int_bits(name)) - 1
}

pub fn effect_bit(name: []u8) -> u64 {
    for e, i in EFFECT_NAMES { if e == name { return (1 as u64) << (i as u64) } }
    return 0
}

/// `!allocates !panics`: the effects a mask does not permit.
fn render_negative(mask: u64) -> String {
    var out = String.new()
    for e, i in EFFECT_NAMES {
        if (mask & ((1 as u64) << (i as u64))) == 0 {
            if out.len > 0 { out.append(" ") }
            out.append("!")
            out.append(e)
        }
    }
    return out
}

/// The effects present in a mask, `allocates panics`.
/// A number right-aligned in `w` columns, for `nx layout`.
pub fn lpad(n: u64, w: usize) -> String {
    let digits = format("{}", .{n})
    var out = String.new()
    var k = digits.len
    while k < w {
        out.append(" ")
        k += 1
    }
    out.append(digits[..])
    return out
}

pub fn render_effects(mask: u64) -> String {
    var out = String.new()
    for e, i in EFFECT_NAMES {
        if (mask & ((1 as u64) << (i as u64))) != 0 {
            if out.len > 0 { out.append(" ") }
            out.append(e)
        }
    }
    return out
}

// ---------------------------------------------------------------- definitions

/// What a name in a module refers to.
pub enum ItemKind { Fn, Struct, Enum, Trait, Const, Global, Alias, ErrorSet, Module }

pub struct ItemRef {
    kind: ItemKind
    id: usize
}

pub struct StructDef {
    name: String
    kind: String
    layout: String
    // the C spelling of an imported struct (`struct tag` or a typedef name), else empty
    c_name: String
    tparams: List(String)
    derives: List(String)
    fields: List(usize)
    module: usize
    start: usize
    end: usize
    is_pub: bool
}

pub struct EnumDef {
    name: String
    tparams: List(String)
    derives: List(String)
    variants: List(usize)
    module: usize
    start: usize
    end: usize
}

pub struct TraitDef {
    name: String
    methods: List(usize)
    assoc: List(String)
    module: usize
    start: usize
    end: usize
}

pub struct ImplDef {
    trait_name: String
    has_trait: bool
    /// where the impl begins, for errors about its trait
    at: usize = 0
    target: usize
    tparams: List(String)
    methods: List(usize)
    module: usize
}

/// A function value used where its type forbids effects: checked once every
/// body is known and effects have propagated.
pub struct Obligation {
    inst: usize
    neg: u64
    at: usize
    module: usize
}

/// A trait's method table for one concrete type: the instances in trait
/// declaration order. Indexed by `DynFrom`.
pub struct VTable {
    trait_id: usize
    ty: usize
    insts: List(usize)
}

/// A function declaration: the node (in its module's tree), its module,
/// the impl it belongs to (or NONE), and whether it is generic.
pub struct FnDef {
    node: usize
    // the module whose tree holds `node` (a trait default lives in the trait's module)
    node_module: usize
    module: usize
    impl_id: usize
    is_generic: bool
    is_test: bool
    test_name: String
    // `bench "name" { }`: a test function that `nx bench` measures
    is_bench: bool = false
    test_comptime: bool
}

pub struct ConstDef {
    name: String
    node: usize
    module: usize
    start: usize
    end: usize
    is_pub: bool
    ty: usize
    in_progress: bool
    // the checked initializer (a TIR node), once resolved
    value: usize
}

pub struct GlobalDef {
    name: String
    node: usize
    module: usize
    start: usize
    end: usize
    ty: usize
    // the evaluated initializer, a `(value ...)` node (NONE when absent)
    init: usize
}

pub struct AliasDef {
    name: String
    node: usize
    is_distinct: bool
    module: usize
    start: usize
    end: usize
    // the type, once first used (NONE before)
    resolved: usize
}

pub struct ErrorSetDef {
    name: String
    module: usize
}

pub struct ImportRef {
    module: usize
    name: String
    has_name: bool
}

/// A loaded module: its name as the driver spells it, and its parse.
pub struct Mod {
    name: String
    source: String
    // the directory its relative paths (`@embedFile`) resolve against
    dir: String
    // the path diagnostics and generated code name it by (`<std>/x.nx` for std)
    path: String
    parsed: parser.Parsed
    // the package the module belongs to (its imports resolve inside it); empty for the program's own files
    pkg: String
}

// ---------------------------------------------------------------- loading

/// Read the root file and everything it imports, in the driver's order:
/// files depth-first from a stack (so the last import of a file loads
/// first), then the std modules in the order they were first named.
/// The standard library, embedded: a module's source by name, so a built
/// compiler needs no `std/` directory beside it.
/// The embedded standard library modules, in the order the first compiler listed them.
pub const STD_MODULE_NAMES = "strings, lists, bytes, num, json, args, fs, time, regex, text, testing, stream, net, http, thread, process, sort, heap, set, deque, hash, path, env, uuid, log, csv, toml, base64, websocket"

pub fn std_source(name: []u8) -> ?[]u8 {
    if name == "args" { return @embedFile("../std/args.nx") }
    if name == "bytes" { return @embedFile("../std/bytes.nx") }
    if name == "fs" { return @embedFile("../std/fs.nx") }
    if name == "http" { return @embedFile("../std/http.nx") }
    if name == "json" { return @embedFile("../std/json.nx") }
    if name == "lists" { return @embedFile("../std/lists.nx") }
    if name == "net" { return @embedFile("../std/net.nx") }
    if name == "num" { return @embedFile("../std/num.nx") }
    if name == "process" { return @embedFile("../std/process.nx") }
    if name == "regex" { return @embedFile("../std/regex.nx") }
    if name == "stream" { return @embedFile("../std/stream.nx") }
    if name == "strings" { return @embedFile("../std/strings.nx") }
    if name == "testing" { return @embedFile("../std/testing.nx") }
    if name == "text" { return @embedFile("../std/text.nx") }
    if name == "thread" { return @embedFile("../std/thread.nx") }
    if name == "time" { return @embedFile("../std/time.nx") }
    if name == "sort" { return @embedFile("../std/sort.nx") }
    if name == "heap" { return @embedFile("../std/heap.nx") }
    if name == "set" { return @embedFile("../std/set.nx") }
    if name == "deque" { return @embedFile("../std/deque.nx") }
    if name == "hash" { return @embedFile("../std/hash.nx") }
    if name == "path" { return @embedFile("../std/path.nx") }
    if name == "env" { return @embedFile("../std/env.nx") }
    if name == "uuid" { return @embedFile("../std/uuid.nx") }
    if name == "log" { return @embedFile("../std/log.nx") }
    if name == "csv" { return @embedFile("../std/csv.nx") }
    if name == "toml" { return @embedFile("../std/toml.nx") }
    if name == "base64" { return @embedFile("../std/base64.nx") }
    if name == "websocket" { return @embedFile("../std/websocket.nx") }
    return null
}

/// A std module's text: the file in `std_dir` when there is one, else the
/// embedded copy.
fn std_text(std_dir: []u8, short: []u8) -> ?String {
    let path = format("{}/{}.nx", .{std_dir, short})
    if io.file_kind(path[..]) == 1 {
        let t = io.read_file(path[..]) catch { return null }
        return t
    }
    let e = std_source(short) orelse return null
    return String.from(e)
}

pub fn load(root: []u8, std_dir: []u8) -> !List(Mod) {
    return load_with_text(root, "", std_dir)
}

/// `load`, with `root_text` standing in for the root file's contents when
/// it is not empty (an editor's unsaved buffer).
pub fn load_with_text(root: []u8, root_text: []u8, std_dir: []u8) -> !List(Mod) {
    var texts = Map(String, String).new()
    if root_text.len > 0 { texts.put(String.from(root), String.from(root_text)) }
    return load_with_texts(root, &texts, std_dir)
}

/// `load`, with `texts` standing in for the contents of the files it names
/// by path, as the modules name them (`Mod.path`): `nx fix` checks a trial
/// edit to any of the program's files this way.
pub fn load_with_texts(root: []u8, texts: *Map(String, String), std_dir: []u8) -> !List(Mod) {
    var mods = List(Mod).new()
    let root_dir = dir_of(root)
    let root_name = stem_of(root)
    // packages: the manifest above the root file names the dependencies
    var pkgs = List(manifest.Package).new()
    if let mf = manifest.find(root_dir) {
        pkgs = try manifest.packages(&mf)
    }
    var queue = List(String).new()
    var queue_paths = List(String).new()
    var queue_pkgs = List(String).new()
    queue.append(String.from(root_name))
    queue_paths.append(String.from(root))
    queue_pkgs.append(String.new())
    var seen = Map(String, bool).new()
    var std_pending = List(String).new()
    while queue.len > 0 {
        let name = queue.pop() orelse break
        let path = queue_paths.pop() orelse break
        let pkg = queue_pkgs.pop() orelse break
        if seen.contains(name[..]) { continue }
        seen.put(name.clone(), true)
        let text = if let t = texts.get(path[..]) { t.clone() } else {
            io.read_file(path[..]) catch {
                eprintln("error: cannot read {}", .{path})
                return error.NotFound
            }
        }
        let parsed = parser.parse_source(text[..])
        if parsed.errors.len > 0 {
            // the REPL's synthetic program is shown as the REPL shows its
            // diagnostics: no path, no count
            let repl = path[..] == "<repl>"
            let shown = syntax_errors(if repl { "" } else { path[..] }, text[..], &parsed.errors)
            if repl { for d in shown { eprintln("error: {}", .{d}) } } else { print_errors(&shown) }
            return error.InvalidInput
        }
        for it in parsed.items {
            let n = &parsed.tree.nodes[it]
            if n.k != parser.NodeKind.Import { continue }
            var words = List(String).new()
            for w in n.words {
                if w == "+" { break }
                words.append(w.clone())
            }
            if words[0] == "std" {
                if words.len == 2 and std_text(std_dir, words[1][..]) != null {
                    let mname = format("std.{}", .{words[1]})
                    if !list_has(&std_pending, mname[..]) { std_pending.append(mname) }
                }
                continue
            }
            // a dependency: `import foo` is its src/lib.nx, `import foo.bar` its src/bar.nx
            var dep_src = String.new()
            for pk in pkgs { if pk.name == words[0] { dep_src = pk.src.clone() } }
            if dep_src.len > 0 {
                var candidate = dep_src.clone()
                if words.len == 1 { candidate.append("/lib") } else { for w in words[1..] { candidate.append("/"); candidate.append(w[..]) } }
                candidate.append(".nx")
                if io.file_kind(candidate[..]) != 1 {
                    eprintln("error: package `{}` has no module `{}` (expected {})", .{words[0], join_words(&words, "."), candidate})
                    return error.NotFound
                }
                queue.append(join_words(&words, "."))
                queue_paths.append(candidate)
                queue_pkgs.append(words[0].clone())
                continue
            }
            // inside a package, imports are relative to its src and named under the package
            if pkg.len > 0 {
                var src = String.new()
                for pk in pkgs { if pk.name == pkg { src = pk.src.clone() } }
                var candidate = src.clone()
                for w in words { candidate.append("/"); candidate.append(w[..]) }
                candidate.append(".nx")
                if io.file_kind(candidate[..]) == 1 {
                    queue.append(format("{}.{}", .{pkg, join_words(&words, ".")}))
                    queue_paths.append(candidate)
                    queue_pkgs.append(pkg.clone())
                }
                continue
            }
            var rel = String.from(root_dir)
            for w, i in words {
                if i > 0 or rel.len > 0 { rel.append("/") }
                rel.append(w)
            }
            rel.append(".nx")
            if io.file_kind(rel[..]) == 1 {
                queue.append(join_words(&words, "."))
                queue_paths.append(rel)
                queue_pkgs.append(String.new())
            }
        }
        mods.append(Mod{ .name = name, .source = text, .dir = String.from(dir_of(path[..])), .path = path.clone(), .parsed = parsed, .pkg = pkg })
    }
    var si: usize = 0
    while si < std_pending.len {
        let mname = std_pending[si].clone()
        si += 1
        let short = mname[4..]
        let path = format("{}/{}.nx", .{std_dir, short})
        let text = std_text(std_dir, short) orelse {
            eprintln("error: cannot read {}", .{path})
            return error.NotFound
        }
        let parsed = parser.parse_source(text[..])
        if parsed.errors.len > 0 {
            let shown = syntax_errors(path[..], text[..], &parsed.errors)
            print_errors(&shown)
            return error.InvalidInput
        }
        for it in parsed.items {
            let n = &parsed.tree.nodes[it]
            if n.k != parser.NodeKind.Import { continue }
            if n.words.len >= 2 and n.words[0] == "std" and n.words[1] != "+" {
                let dep = format("std.{}", .{n.words[1]})
                if std_text(std_dir, n.words[1][..]) != null and !list_has(&std_pending, dep[..]) {
                    std_pending.append(dep)
                }
            }
        }
        let path = format("<std>/{}.nx", .{short})
        mods.append(Mod{ .name = mname, .source = text, .dir = String.from(std_dir), .path = path, .parsed = parsed, .pkg = String.new() })
    }
    return mods
}

pub fn list_has(xs: *List(String), s: []u8) -> bool {
    for x in xs { if x == s { return true } }
    return false
}

pub fn join_words(ws: *List(String), sep: []u8) -> String {
    var out = String.new()
    for w, i in ws {
        if i > 0 { out.append(sep) }
        out.append(w)
    }
    return out
}

/// The directory of a path; `.` for a bare file name, so that a module's
/// directory is always somewhere to look for headers and vendored C (the
/// frozen Rust compiler made the same choice).
fn dir_of(path: []u8) -> []u8 {
    var i = path.len
    while i > 0 {
        if path[i - 1] == '/' or path[i - 1] == '\\' { return path[0..i - 1] }
        i -= 1
    }
    return "."
}

fn stem_of(path: []u8) -> []u8 {
    var start: usize = 0
    var i = path.len
    while i > 0 {
        if path[i - 1] == '/' or path[i - 1] == '\\' { start = i; break }
        i -= 1
    }
    var end = path.len
    var j = path.len
    while j > start {
        if path[j - 1] == '.' { end = j - 1; break }
        j -= 1
    }
    return path[start..end]
}

// ---------------------------------------------------------------- the typed IR

/// Every typed node lives in one arena; `k` picks the meaning of the fields,
/// mirroring the Rust `TStmt`/`TExpr`/`TBlock`/`TPat`.
pub enum TKind {
    // statements
    SLet, SAssign, SExpr, SReturn, SBreak, SContinue, SDefer, SErrDefer, SWhile, SForRange, SForSlice, SBlock, SDrop, SUsing,
    // blocks
    Block,
    // expressions
    Int, Float, Bool, Char, Str, Unit, Local, Global, Const, FnRef, Field, RefField, TupleField, Index, SliceOp,
    Deref, AddrOf, Call, CallPtr, Builtin, Unary, Binary, Logical, Cast, If, IfCapture, Match, BlockExpr,
    StructLit, RefNew, EnumLit, ArrayLit, ArrayRepeat, TupleLit, Try, Catch, OrElse, Unwrap, OptWrap, OptNull,
    ErrWrap, ErrToUnion, ErrVal, ArrayToSlice, ListToSlice, StrToSlice, Closure, FnToFat, Unreachable, Undefined,
    BinConstruct, Value, TypeVal, RecordCheck, Retained, DynFrom, DynCall,
    // match arms and patterns
    Arm, PWild, PBind, PInt, PFloat, PBool, PStr, PChar, PRange, PVariant, PError, PNull, PSome, POk, POr, PTuple, PBinary,
    // `[a, rest..]` (a: the rest's position or NONE; flag: total for its type), the rest (a: its local or NONE), `x @ p` (a: the local)
    PSlice, PRest, PAt,
    Seg,
}

pub struct T {
    k: TKind
    ty: usize
    start: usize
    end: usize
    // ids, indexes, labels, locals, flags
    a: usize
    b: usize
    c: usize
    flag: bool
    flag2: bool
    // children: statements, arguments, arms, payloads
    kids: List(usize)
    // a second child list: for-slice item locals, struct-literal field indexes
    kids2: List(usize)
    // operator symbols, arithmetic modes, builtin names, cast kinds
    name: String
    // string literal bytes
    text: String
    ival: i128
    fval: f64
}

pub struct Tir {
    nodes: List(T)
}

pub fn tblank(k: TKind, ty: usize, start: usize, end: usize) -> T {
    return T{
        .k = k, .ty = ty, .start = start, .end = end, .a = NONE, .b = NONE, .c = NONE, .flag = false, .flag2 = false,
        .kids = List(usize).new(), .kids2 = List(usize).new(), .name = String.new(), .text = String.new(), .ival = 0, .fval = 0.0,
    }
}

impl Tir {
    fn add(self: *mut Self, own n: T) -> usize {
        self.nodes.append(n)
        return self.nodes.len - 1
    }
}

// ---------------------------------------------------------------- function contexts

pub struct Local {
    name: String
    ty: usize
    mutable: bool
    start: usize
    end: usize
    is_param: bool
    owned: bool
    loop_item: bool
    if_let: bool
    // a name of `let (a, b) = place` or `for (k, v) in items`: a view of the element
    tuple_view: bool
    // a name a pattern binds over a place (a `match` arm's): a view of what it matched
    pat_view: bool = false
    // where the value points when it holds a view (section 5.6): the locals it
    // borrows from, or ORIGIN_PARAM, ORIGIN_STATIC, ORIGIN_TEMP
    origins: List(Origin)
    // the scope depth at the declaration (the mark stack's height)
    depth: usize
    // the growths, clearings and reassignments of this local's storage, for V3
    changes: List(Change)
    // the origins already warned about through this local (once each)
    warned: List(usize)
    // the `using arena` nesting the local is declared in (0: outside any)
    arena_depth: usize
    // the `using arena` nesting the value it holds was made in, for V5: a
    // local declared inside a block may hold a value `@escape` made outside
    made_in: usize
    // the position of the last read of the local, for V3's loop rule
    last_use: usize
}

/// The storage a view points into and when the view was taken (a source
/// position, so a later change of the storage is later than the view).
pub struct Origin {
    local: usize
    taken_at: usize
    // the view is into heap storage the value owns (a `List`, `String` or
    // `Map` buffer), which moves with the value: a view into a value that the
    // same literal moves in is a view into the literal's own value
    heap: bool
    // the first field on the view's path from the local (`lv.rows[y]` views
    // field `rows`), or NONE for the whole value: a change of another field
    // of the same struct does not touch this storage
    field: usize
}

/// A change of a local's storage: where, and the loops it sits in (a view
/// taken before the loop meets it on the next pass).
pub struct Change {
    pos: usize
    loops: List(usize)
    // the first field of the place that changed (`lv.origins.append` changes
    // field `origins`), or NONE for the whole value
    field: usize
}

/// Do a view's origin and a change of its local meet? The whole value meets
/// everything; two fields meet when they are the same one.
pub fn fields_meet(a: usize, b: usize) -> bool {
    return a == NONE or b == NONE or a == b
}

/// The caller's storage (a parameter's), a global's or a literal's, a temporary's.
pub const ORIGIN_PARAM: usize = 0xFFFFFFFFFFFFFFFE
pub const ORIGIN_STATIC: usize = 0xFFFFFFFFFFFFFFFD
// the value's own heap storage (see `Origin.heap`), which travels with it
pub const ORIGIN_SELF: usize = 0xFFFFFFFFFFFFFFFC
pub const ORIGIN_TEMP: usize = 0xFFFFFFFFFFFFFFFB

pub struct LabelInfo {
    name: String
    has_name: bool
    id: usize
    is_loop: bool
    break_ty: usize
    scope_depth: usize
}

pub struct Witness {
    effects: u64
    at: usize
    why: String
}

/// An edit `nx fix` may make for an error: `start..end` of a module's
/// source becomes `text`. The checker offers it; `nx fix` keeps it only
/// when checking the edited program leaves fewer errors and no new one.
pub struct Fix derive(Clone) {
    module: usize
    start: usize
    end: usize
    text: String
    // what the edit does, for nx fix's report
    what: String
}

/// A diagnostic as data: where, what, and whether it is a note on the
/// error before it (the language server reads these).
pub struct Diag {
    module: usize
    at: usize
    msg: String
    note: bool
    // a warning (or a note on one): reported, not fatal, unless `--strict`
    // (nothing warns in 1.3; a deprecation will)
    warn: bool
}

/// Tarjan's strongly connected components over the instance call graph.
struct Tarjan {
    index: List(usize)
    low: List(usize)
    on_stack: List(bool)
    stack: List(usize)
    next: usize
    comp: List(usize)
}

pub struct Range {
    lo: i128
    hi: i128
}

/// The state of checking one function body. Scopes are a flat stack of
/// entries with a mark per scope.
pub struct FnCtx {
    ret: usize
    module: usize
    fn_name: String
    locals: List(Local)
    scope_names: List(String)
    scope_locals: List(usize)
    scope_deref: List(bool)
    scope_marks: List(usize)
    labels: List(LabelInfo)
    next_label: usize
    own_effects: u64
    witnesses: List(Witness)
    callees: List(usize)
    callee_spans: List(usize)
    moved: Map(usize, usize)
    // the start of every loop being checked, innermost last (V3's loop rule)
    loop_starts: List(usize)
    // how many `using arena` blocks enclose the point being checked (V5)
    using_depth: usize
    // the value being matched, for what its pattern bindings view
    pat_source: usize
    // the local named on the left of `x = v` while that name is checked: a
    // write, not a read of what it views
    assign_target: usize
    ranges: Map(usize, Range)
    // facts from guards beyond ranges: locals proven `!= 0`, optionals proven
    // `!= null`, slices with a proven least length (`lo`); all dropped when the
    // local is assigned, borrowed mutably, or a loop that may change it begins
    nonzero: List(usize)
    nonnull: List(usize)
    min_len: Map(usize, Range)
    // loop index variables known to be in range for a local slice
    index_of: Map(usize, usize)
    in_defer: bool
    loop_depth: usize
    unsafe_depth: usize
    is_comptime: bool
    in_parallel: usize
    self_ty: usize
    // matching through a pointer: NONE, 0 (immutable) or 1 (mutable)
    pat_by_ref: usize
}

pub fn new_ctx(ret: usize, module: usize, name: []u8) -> FnCtx {
    return FnCtx{
        .ret = ret, .module = module, .fn_name = String.from(name), .locals = List(Local).new(),
        .scope_names = List(String).new(), .scope_locals = List(usize).new(), .scope_deref = List(bool).new(), .scope_marks = List(usize).new(),
        .labels = List(LabelInfo).new(), .next_label = 0, .own_effects = 0, .witnesses = List(Witness).new(),
        .callees = List(usize).new(), .callee_spans = List(usize).new(), .moved = Map(usize, usize).new(), .ranges = Map(usize, Range).new(), .nonzero = List(usize).new(), .nonnull = List(usize).new(), .min_len = Map(usize, Range).new(),
        .index_of = Map(usize, usize).new(), .in_defer = false, .loop_depth = 0, .loop_starts = List(usize).new(), .using_depth = 0, .pat_source = NONE, .assign_target = NONE, .unsafe_depth = 0, .is_comptime = false, .in_parallel = 0, .self_ty = NONE, .pat_by_ref = NONE,
    }
}

/// One function instance: a definition with concrete type arguments, its
/// locals, and (after body checking) its body in the arena.
pub struct Inst {
    name: String
    mangled: String
    def: usize
    targs: List(usize)
    // the generic environment of the body: impl and function type parameters
    gen_names: List(String)
    gen_tys: List(usize)
    params: List(usize)
    ret: usize
    locals: List(Local)
    body: usize
    own_effects: u64
    effects: u64
    declared_neg: u64
    declared_pos: u64
    export_name: String
    is_extern: bool
    is_variadic: bool
    is_pub: bool
    is_test: bool
    test_comptime: bool
    is_closure: bool
    // a closure's captures: by reference or by value, in order
    closure_by_ref: List(bool)
    start: usize
    end: usize
    module: usize
    self_ty: usize
    witnesses: List(Witness)
    callees: List(usize)
    // where each callee was called, for the effect diagnostics
    callee_spans: List(usize)
}

pub const EFF_ALLOCATES: u64 = 1
pub const EFF_REFCOUNTS: u64 = 2
pub const EFF_BLOCKS: u64 = 4
pub const EFF_SHARED_MUTABLE: u64 = 8
pub const EFF_NONDETERMINISTIC: u64 = 16
pub const EFF_PANICS: u64 = 32
pub const EFF_FFI: u64 = 64
const EFF_UNBOUNDED_STACK: u64 = 128
pub const EFF_ALL: u64 = 255

// ---------------------------------------------------------------- the checker

pub struct Checker {
    mods: List(Mod)
    tys: Types
    items: Map(String, ItemRef)
    imports: Map(String, ImportRef)
    structs: List(StructDef)
    enums: List(EnumDef)
    traits: List(TraitDef)
    impls: List(ImplDef)
    fns: List(FnDef)
    consts: List(ConstDef)
    globals: List(GlobalDef)
    aliases: List(AliasDef)
    error_sets: List(ErrorSetDef)
    errors: List(String)
    // warnings, rendered like errors; `--strict` turns them into errors
    warnings: List(String)
    // the edits offered for errors, for `nx fix`
    fixes: List(Fix)
    // inside the block of an `if` with no `else` whose value is wanted: the
    // missing `else` is the mistake there, and `_ =` would only hide it
    no_discard_fix: bool = false
    // integer literals typed before their type was known (TIR node, module),
    // range-checked once it is
    open_lits: List(usize)
    open_lit_mods: List(usize)
    // per type: 1 when it cannot hold a view, 2 when it can (section 5.6)
    view_cache: Map(usize, u8)
    // a closure instance's captured locals, for the views it carries
    closure_caps: Map(usize, List(usize))
    diags: List(Diag)
    // error names, 1-based ids in order of first mention
    error_names: List(String)
    error_ids: Map(String, usize)
    // instances, the body-check queue (a stack), and the typed IR
    insts: List(Inst)
    inst_map: Map(String, usize)
    queue: List(usize)
    tir: Tir
    // the function being checked, as a stack (constants nest)
    ctxs: List(FnCtx)
    main_inst: usize
    tests: List(usize)
    // the `bench` blocks, run by `nx bench`
    benches: List(usize)
    // the generic environment types resolve in: parameter names bound to types
    env_names: List(String)
    env_tys: List(usize)
    // `Record.new(.{ ... })` checks its literal without the panicking wrapper
    record_new_mode: bool
    vtables: List(VTable)
    obligations: List(Obligation)
    // calls made inside `for parallel` bodies: (instance, loop start, module)
    parallel_calls: List(Obligation)
    // mutable-global reads and writes: (global, at, module) and the function
    global_uses: List(Obligation)
    global_use_fns: List(String)
    // artifact kinds declared by the program; some make it an embeddable library
    artifact_kinds: List(String)
    // a shared wildcard pattern for the exhaustiveness matrix
    wild_pat_node: usize
    // `@cImport`: the C compiler to preprocess with, the target, and the
    // headers imported (name, is_system); declarations that could not be
    // translated, keyed "module:name"
    cc: List(String)
    target: String
    cimport_headers: List(String)
    cimport_system: List(bool)
    cimport_unsupported: Map(String, String)
    // aggregate `(value ...)` payloads, by index
    values: List(check_interp.CV)
    // `nx repl`: unused values in `main` are printed, and the interpreter may talk to the world
    repl_mode: bool
    // `nx play`: the interpreter may talk to the world, as in the REPL; the program is checked as written
    play_mode: bool
    // the bindings of the `?.` chains being checked, innermost last (ChainSelf reads the top)
    chain_locals: List(usize)
    // statements a statement expands to after itself (`let (a, b) = e` is one `let` per name), drained by the block
    pending_stmts: List(usize)
    // the types a clone walk has visited (recursive types end the walk)
    clone_seen: List(usize)
    // the compile-time interpreter's state (see `it_enter`)
    it_steps: u64
    it_panic: String
    it_panic_at: usize
    it_has_panic: bool
    it_budget: bool
    it_pending: u8
    it_pending_label: usize
    it_pending_val: check_interp.CV
    it_failed_at: usize
    // the module of the function that panicked or could not be evaluated, NONE when unknown
    it_where: usize
    // where an evaluation that failed left the program's own file (module 0), NONE until it does
    it_root_at: usize
    // the last call's `[]mut T` parameters at its return (VK_NONE for the others)
    it_kept: List(check_interp.CV)
    // nested calls allowed (check_interp.CALL_DEPTH; less where the stack is smaller, as in the playground)
    it_depth_limit: usize
    // the `ref class` objects the interpreter made, by VK_REF index (never freed:
    // a run is exercise-sized and bounded by the step budget)
    it_heap: List(check_interp.CV)
    frames: List(check_interp.Frame)
    it_cur_fn: usize
    it_out: check_interp.CV
    it_flow_val: check_interp.CV
    it_flow_label: usize
    cv_bad: check_interp.CV
}

/// The location block of a diagnostic: `  --> path:line:col`, the source
/// line, and a caret under byte offset `at` of `src`. With an empty path (the
/// REPL, where the input is the line just typed) the block is the line and the
/// caret alone.
pub fn location_block(path: []u8, src: []u8, at: usize) -> String {
    var line: usize = 1
    var line_start: usize = 0
    var i: usize = 0
    let stop = if at < src.len { at } else { src.len }
    while i < stop {
        if src[i] == '\n' { line += 1; line_start = i + 1 }
        i += 1
    }
    let col = stop - line_start + 1
    var line_end = line_start
    while line_end < src.len and src[line_end] != '\n' { line_end += 1 }
    var text = src[line_start..line_end]
    if text.len > 0 and text[text.len - 1] == '\r' { text = text[0..text.len - 1] }
    var out = String.new()
    if path.len > 0 {
        out.append(format("  --> {}:{}:{}\n", .{path, line, col})[..])
        out.append("   |\n")
        out.append(format("{>3}| {}\n", .{line, text})[..])
    } else {
        out.append(format("   | {}\n", .{text})[..])
    }
    out.append("   | ")
    for _ in 1..col { out.append(" ") }
    out.append("^")
    return out
}

/// The lexer's and the parser's errors (`error at N: message`) rendered the
/// way the checker renders its own, for `print_errors`: the message and the
/// location block, one error per position (the lexer's complaint and the
/// parser's reading of the same text are one mistake).
pub fn syntax_errors(path: []u8, src: []u8, errors: *List(String)) -> List(String) {
    var out = List(String).new()
    var seen = List(usize).new()
    for e in errors {
        var msg = String.new()
        let at = parser.error_offset(e[..], &mut msg)
        var again = false
        for s in seen { if s == at { again = true } }
        if again { continue }
        seen.append(at)
        out.append(format("{}\n{}", .{msg, location_block(path, src, at)}))
    }
    return out
}

/// Print the diagnostics: errors with their prefix, notes as they are, and
/// the count at the end.
pub fn print_errors(errors: *List(String)) {
    var n: usize = 0
    for e in errors {
        if e[..].starts_with("  note:") { eprintln("{}", .{e}) } else { eprintln("error: {}", .{e}); n += 1 }
    }
    if n > 0 { eprintln("{} error(s)", .{n}) }
}

/// Warnings, with their prefix; under `--strict` they are printed as errors.
pub fn print_warnings(warnings: *List(String), strict: bool) {
    var n: usize = 0
    let label = if strict { "error" } else { "warning" }
    for w in warnings {
        if w[..].starts_with("  note:") { eprintln("{}", .{w}) } else { eprintln("{}: {}", .{label, w}); n += 1 }
    }
    if n > 0 { eprintln("{} {}(s){}", .{n, label, if strict { " (warnings, under --strict)" } else { "" }}) }
}

pub fn item_key(module: usize, name: []u8) -> String {
    return format("{}:{}", .{module, name})
}

/// The keys an artifact of a kind takes, as the build reads them; "" for a
/// kind there is none of. (`exports` is the old way of naming a C ABI's
/// functions, which `export(...)` on the functions replaced.)
pub fn artifact_keys(kind: []u8) -> []u8 {
    if kind == "cli" { return "name, stack" }
    if kind == "cabi" { return "name, version, exports" }
    if kind == "python" or kind == "node" or kind == "rustlib" { return "name, version" }
    if kind == "link" { return "c_sources, libs, include, lib_paths, libs_windows, libs_linux, libs_macos" }
    if kind == "installer" { return "name, publisher, version, url, license, readme, files, add_to_path" }
    return ""
}

impl Checker {
    /// A diagnostic: the message, then where, with the source line and a
    /// caret under the position, in the shape every Nexium tool prints:
    ///
    ///     error: message
    ///       --> path:line:col
    ///        |
    ///      12| let x = ...
    ///        |     ^
    fn fail(self: *mut Self, module: usize, at: usize, msg: []u8) {
        self.errors.append(format("{}\n{}", .{msg, self.render_at(module, at)}))
        self.diags.append(Diag{ .module = module, .at = at, .msg = String.from(msg), .note = false, .warn = false })
    }

    /// A note attached to the error just reported.
    fn note(self: *mut Self, module: usize, at: usize, msg: []u8) {
        self.errors.append(format("  note: {}\n{}", .{msg, self.render_at(module, at)}))
        self.diags.append(Diag{ .module = module, .at = at, .msg = String.from(msg), .note = true, .warn = false })
    }

    /// A warning: reported like an error, fatal only under `--strict`. The
    /// view rules of 1.2 arrived this way and are errors since 1.3
    /// (docs/stability.md: a warning in one release, an error in the next);
    /// a deprecation will warn so.
    fn warn(self: *mut Self, module: usize, at: usize, msg: []u8) {
        self.warnings.append(format("{}\n{}", .{msg, self.render_at(module, at)}))
        self.diags.append(Diag{ .module = module, .at = at, .msg = String.from(msg), .note = false, .warn = true })
    }

    fn warn_here(self: *mut Self, at: usize, msg: []u8) {
        let m = self.cur_module()
        self.warn(m, at, msg)
    }

    /// Offer `nx fix` an edit for the error just reported: `start..end` of
    /// the module's source becomes `text`. An edit already offered (another
    /// instance of a generic function) is offered once.
    fn offer_fix(self: *mut Self, module: usize, start: usize, end: usize, text: []u8, what: []u8) {
        for f in self.fixes {
            if f.module == module and f.start == start and f.end == end and f.text[..] == text { return }
        }
        self.fixes.append(Fix{ .module = module, .start = start, .end = end, .text = String.from(text), .what = String.from(what) })
    }

    /// `@target()` at compile time: the (os, arch, pointer_bits) of the build,
    /// from `--target`'s triple or else the machine the compiler runs on, in
    /// the words the runtime uses for the same build (`nx_host_os`,
    /// `nx_host_arch`, `NX_PTR_BITS`).
    pub fn build_target(self: *Self) -> (String, String, u32) {
        let (hos, harch, hbits) = @target()
        if self.target.len == 0 { return (String.from(hos), String.from(harch), hbits) }
        let t = self.target[..]
        var first = t
        if let i = t.find("-") { first = t[0..i] }
        var arch: []u8 = "unknown"
        if first == "x86_64" or first == "amd64" { arch = "x86_64" }
        else if first == "aarch64" or first == "arm64" { arch = "aarch64" }
        else if first == "x86" or first == "i386" or first == "i486" or first == "i586" or first == "i686" { arch = "x86" }
        else if first.starts_with("arm") or first.starts_with("thumb") { arch = "arm" }
        else if first == "riscv64" { arch = "riscv64" }
        var os: []u8 = "unknown"
        if t.find("windows") != null { os = "windows" }
        else if t.find("macos") != null or t.find("darwin") != null or t.find("ios") != null { os = "macos" }
        else if t.find("linux") != null { os = "linux" }
        else if t.find("freebsd") != null or t.find("openbsd") != null or t.find("netbsd") != null { os = "bsd" }
        let narrow = arch == "x86" or arch == "arm" or first.starts_with("wasm32") or first == "riscv32"
        return (String.from(os), String.from(arch), if narrow { 32 } else { 64 })
    }

    /// A note attached to the warning just reported.
    fn warn_note(self: *mut Self, module: usize, at: usize, msg: []u8) {
        self.warnings.append(format("  note: {}\n{}", .{msg, self.render_at(module, at)}))
        self.diags.append(Diag{ .module = module, .at = at, .msg = String.from(msg), .note = true, .warn = true })
    }

    /// `path:line:col` of a byte offset in a module.
    pub fn location(self: *Self, module: usize, at: usize) -> String {
        let src = self.mods[module].source[..]
        let path = if self.mods[module].path.len > 0 { self.mods[module].path[..] } else { self.mods[module].name[..] }
        var line: usize = 1
        var line_start: usize = 0
        var i: usize = 0
        let stop = if at < src.len { at } else { src.len }
        while i < stop {
            if src[i] == '\n' { line += 1; line_start = i + 1 }
            i += 1
        }
        return format("{}:{}:{}", .{path, line, at - line_start + 1})
    }

    /// Does a value of this type hold `ref class` references anywhere inside
    /// it, so that copying or dropping it touches a reference count?
    pub fn holds_refs(self: *mut Self, t0: usize) -> bool {
        if self.is_ref_like(t0) { return true }
        let t = self.tys.shallow(t0)
        let k = self.tys.kind(t)
        if k == TK.List or k == TK.Array or k == TK.ErrUnion { return self.holds_refs(self.tys.list[t].args[0]) }
        if k == TK.Map { return self.holds_refs(self.tys.list[t].args[0]) or self.holds_refs(self.tys.list[t].args[1]) }
        if k == TK.Tuple {
            for e in self.tys.list[t].args.clone() { if self.holds_refs(e) { return true } }
            return false
        }
        if k == TK.Struct {
            for e in self.struct_field_types(t) { if self.holds_refs(e) { return true } }
            return false
        }
        if k == TK.Enum {
            for v in self.enum_variant_types(t) { for e in v { if self.holds_refs(e) { return true } } }
            return false
        }
        return false
    }

    /// The location block of a diagnostic (`location_block`) at a byte offset
    /// into a module's text. The REPL's input is shown without a path: its
    /// lines are numbered in a program the user never sees.
    fn render_at(self: *Self, module: usize, at: usize) -> String {
        let m = &self.mods[module]
        let path = if self.repl_mode and m.path[..] == "<repl>" { "" } else if m.path.len > 0 { m.path[..] } else { m.name[..] }
        return location_block(path, m.source[..], at)
    }

    fn node(self: *Self, module: usize, id: usize) -> *parser.Node {
        return &self.mods[module].parsed.tree.nodes[id]
    }

    fn define(self: *mut Self, module: usize, name: []u8, kind: ItemKind, id: usize, at: usize) {
        let key = item_key(module, name)
        if self.items.contains(key[..]) {
            self.fail(module, at, format("`{}` is defined more than once in this module", .{name})[..])
            return
        }
        self.items.put(key, ItemRef{ .kind = kind, .id = id })
    }

    /// A trait's item by its name in module `m`: `Name`, or `module.Name`
    /// for a trait of an imported module.
    fn lookup_trait(self: *Self, m: usize, name: []u8) -> ?ItemRef {
        if let dot = name.find(".") {
            let q = self.lookup(m, name[0..dot]) orelse return null
            if q.kind != ItemKind.Module { return null }
            return self.lookup(q.id, name[dot + 1..name.len])
        }
        return self.lookup(m, name)
    }

    /// `impl http.Transport for T`: impls match their trait by its own
    /// name, so the qualifier is checked here and dropped, and the trait is
    /// reachable by that name in the impl's module, as `import
    /// std.http.{Transport}` would make it.
    fn qualify_impls(self: *mut Self) {
        let n = self.impls.len
        for i in 0..n {
            let tn = self.impls[i].trait_name.clone()
            let dot = tn[..].find(".") orelse continue
            let m = self.impls[i].module
            let at = self.impls[i].at
            let q = String.from(tn[0..dot])
            let bare = String.from(tn[dot + 1..tn.len])
            let module_ref = self.lookup(m, q[..]) orelse {
                self.fail(m, at, format("cannot find module `{}`", .{q})[..])
                continue
            }
            if module_ref.kind != ItemKind.Module {
                self.fail(m, at, format("`{}` is not a module", .{q})[..])
                continue
            }
            let r = self.lookup(module_ref.id, bare[..]) orelse {
                self.fail(m, at, format("module `{}` has no trait `{}`", .{q, bare})[..])
                continue
            }
            if r.kind != ItemKind.Trait {
                self.fail(m, at, format("`{}` is not a trait", .{tn})[..])
                continue
            }
            if let here = self.lookup(m, bare[..]) {
                if here.kind != r.kind or here.id != r.id {
                    self.fail(m, at, format("this module has a `{}` of its own, which `impl {}` would be taken for", .{bare, tn})[..])
                    continue
                }
            } else {
                self.imports.put(item_key(m, bare[..]), ImportRef{ .module = module_ref.id, .name = bare.clone(), .has_name = true })
            }
            self.impls[i].trait_name = bare
        }
    }

    fn lookup(self: *Self, module: usize, name: []u8) -> ?ItemRef {
        let key = item_key(module, name)
        if let r = self.items.get(key[..]) { return r }
        if let im = self.imports.get(key[..]) {
            if im.has_name {
                return self.items.get(item_key(im.module, im.name[..])[..])
            }
            return ItemRef{ .kind = ItemKind.Module, .id = im.module }
        }
        return null
    }

    // ----- collection -----------------------------------------------------

    fn collect(self: *mut Self) {
        // `const c = @cImport("header.h")` becomes a synthetic module
        let n_mods = self.mods.len
        for m in 0..n_mods {
            let items = self.mods[m].parsed.items.clone()
            for it in items { if self.is_cimport_const(m, it) { self.collect_cimport(m, it) } }
        }
        // the synthetic modules were collected as they were made
        for m in 0..n_mods {
            let items = self.mods[m].parsed.items.clone()
            for it in items {
                if self.is_cimport_const(m, it) { continue }
                self.collect_item(m, it)
            }
        }
        // every module's items are in: an impl may name another's trait
        self.qualify_impls()
    }

    fn is_cimport_const(self: *Self, m: usize, it: usize) -> bool {
        let n = self.node(m, it)
        if n.k != parser.NodeKind.Const { return false }
        let v = self.node(m, n.y)
        return v.k == parser.NodeKind.Builtin and v.name == "cImport"
    }

    /// The directories `#include "..."` resolves against: every module's
    /// directory and the `include` entries of `artifact link` declarations.
    fn include_dirs(self: *Self) -> List(String) {
        var out = List(String).new()
        let n_mods = self.mods.len
        for m in 0..n_mods {
            if self.mods[m].dir.len > 0 { out.append(self.mods[m].dir.clone()) }
            let items = self.mods[m].parsed.items.clone()
            for it in items {
                let n = self.node(m, it)
                if n.k != parser.NodeKind.Artifact or n.name != "link" { continue }
                for f in n.kids.clone() {
                    let fnode = self.node(m, f)
                    if fnode.name != "include" { continue }
                    let v = self.node(m, fnode.x)
                    var vals = List(usize).new()
                    if v.k == parser.NodeKind.ArrayLit { vals = v.kids.clone() } else { vals.append(fnode.x) }
                    for e in vals {
                        let en = self.node(m, e)
                        if en.k == parser.NodeKind.Lit and en.text == "str" { out.append(format("{}/{}", .{self.mods[m].dir, en.name})) }
                    }
                }
            }
        }
        return out
    }

    fn collect_cimport(self: *mut Self, m: usize, it: usize) {
        let n = self.node(m, it)
        let const_name = n.name.clone()
        let bnode = self.node(m, n.y)
        let args = bnode.kids.clone()
        let at = bnode.start
        var header = String.new()
        var ok = args.len == 1
        if ok {
            let a = self.node(m, args[0])
            ok = a.k == parser.NodeKind.Lit and a.text == "str"
            if ok { header = a.name.clone() }
        }
        if !ok {
            self.fail(m, at, "@cImport takes one string literal: the header to import, e.g. `@cImport(\"stdio.h\")`")
            return
        }
        if self.cc.len == 0 {
            self.fail(m, at, "@cImport is not available in this context")
            return
        }
        let windows = os.env("COMSPEC") != null and os.env("WINDIR") != null
        let opts = cimport.ImportOptions{ .cc = self.cc.clone(), .target = self.target.clone(), .include_dirs = self.include_dirs(), .windows = windows }
        let mid = self.mods.len
        self.mods.append(Mod{
            .name = format("cimport:{}", .{header}), .source = String.new(), .dir = String.new(), .path = String.new(), .pkg = String.new(),
            .parsed = parser.Parsed{ .tree = parser.Tree{ .nodes = List(parser.Node).new(), .docs = List(String).new(), .doc_counts = List(usize).new() }, .items = List(usize).new(), .errors = List(String).new() },
        })
        let bend = bnode.end
        let ci = cimport.import_header(header[..], &opts, &mut self.mods[mid].parsed.tree) catch |e| {
            _ = self.mods.pop()
            if e == error.IoError {
                self.fail(m, at, format("@cImport(\"{}\"): cannot run the C compiler", .{header})[..])
            } else {
                self.fail(m, at, format("@cImport(\"{}\"): the C preprocessor failed: {}", .{header, cimport.pp_error_line()})[..])
            }
            return
        }
        self.cimport_headers.append(header.clone())
        self.cimport_system.append(ci.is_system)
        // every imported declaration is reported at the `@cImport`
        let n_nodes = self.mods[mid].parsed.tree.nodes.len
        for k in 0..n_nodes {
            self.mods[mid].parsed.tree.nodes[k].start = at
            self.mods[mid].parsed.tree.nodes[k].end = bend
        }
        // structs, then aliases, functions and constants; a later declaration
        // does not shadow an earlier one of the same name
        var names = Map(String, bool).new()
        for st, i in ci.structs {
            let sname = self.node(mid, st).name.clone()
            names.put(sname, true)
            self.mods[mid].parsed.items.append(st)
            self.collect_item(mid, st)
            let sid = self.structs.len - 1
            self.structs[sid].c_name = ci.struct_cnames[i].clone()
        }
        for a in ci.aliases {
            let aname = self.node(mid, a).name.clone()
            if names.contains(aname[..]) { continue }
            names.put(aname, true)
            self.mods[mid].parsed.items.append(a)
            self.collect_item(mid, a)
        }
        for f in ci.functions {
            let fname = self.node(mid, f).name.clone()
            if names.contains(fname[..]) { continue }
            names.put(fname, true)
            self.mods[mid].parsed.items.append(f)
            self.collect_item(mid, f)
        }
        for c in ci.consts {
            let cname = self.node(mid, c).name.clone()
            if names.contains(cname[..]) { continue }
            names.put(cname, true)
            self.mods[mid].parsed.items.append(c)
            self.collect_item(mid, c)
        }
        for u, i in ci.unsupported_names {
            self.cimport_unsupported.put(format("{}:{}", .{mid, u}), ci.unsupported_whys[i].clone())
        }
        self.items.put(item_key(m, const_name[..]), ItemRef{ .kind = ItemKind.Module, .id = mid })
    }

    /// Whether any parameter of the function is `own`.
    fn fn_takes_own(self: *Self, fid: usize) -> bool {
        let nm = self.fns[fid].node_module
        let n = self.node(nm, self.fns[fid].node)
        for p in n.kids { if self.node(nm, p).flag2 { return true } }
        return false
    }

    fn fn_is_generic(self: *Self, module: usize, id: usize) -> bool {
        let n = self.node(module, id)
        for p in n.kids {
            if self.node(module, p).flag { return true }
        }
        return false
    }

    fn collect_item(self: *mut Self, m: usize, it: usize) {
        let k = self.node(m, it).k
        if k == parser.NodeKind.Fn {
            let name = self.node(m, it).name.clone()
            let name_at = self.node(m, it).start
            let generic = self.fn_is_generic(m, it)
            self.fns.append(FnDef{ .node = it, .node_module = m, .module = m, .impl_id = NONE, .is_generic = generic, .is_test = false, .test_name = String.new(), .test_comptime = false })
            self.define(m, name[..], ItemKind.Fn, self.fns.len - 1, name_at)
        } else if k == parser.NodeKind.Struct {
            let n = self.node(m, it)
            var d = StructDef{
                .name = n.name.clone(), .kind = n.text.clone(), .layout = self.node(m, n.x).name.clone(), .c_name = String.new(),
                .tparams = List(String).new(), .derives = List(String).new(), .fields = n.kids.clone(),
                .module = m, .start = n.start, .end = n.end, .is_pub = n.flag,
            }
            var second = false
            for w in n.words {
                if w == "+" { second = true; continue }
                if second { d.derives.append(w.clone()) } else { d.tparams.append(w.clone()) }
            }
            let name = d.name.clone()
            let at = d.start
            self.structs.append(d)
            self.define(m, name[..], ItemKind.Struct, self.structs.len - 1, at)
        } else if k == parser.NodeKind.Enum {
            let n = self.node(m, it)
            var d = EnumDef{ .name = n.name.clone(), .tparams = List(String).new(), .derives = List(String).new(), .variants = n.kids.clone(), .module = m, .start = n.start, .end = n.end }
            var second = false
            for w in n.words {
                if w == "+" { second = true; continue }
                if second { d.derives.append(w.clone()) } else { d.tparams.append(w.clone()) }
            }
            let name = d.name.clone()
            let at = d.start
            self.enums.append(d)
            self.define(m, name[..], ItemKind.Enum, self.enums.len - 1, at)
        } else if k == parser.NodeKind.Trait {
            let n = self.node(m, it)
            let d = TraitDef{ .name = n.name.clone(), .methods = n.kids.clone(), .assoc = n.words.clone(), .module = m, .start = n.start, .end = n.end }
            let name = d.name.clone()
            let at = d.start
            self.traits.append(d)
            self.define(m, name[..], ItemKind.Trait, self.traits.len - 1, at)
        } else if k == parser.NodeKind.Impl {
            let n = self.node(m, it)
            let impl_id = self.impls.len
            var methods = List(usize).new()
            let tparams = n.words.clone()
            for meth in n.kids {
                let generic = self.fn_is_generic(m, meth) or tparams.len > 0
                self.fns.append(FnDef{ .node = meth, .node_module = m, .module = m, .impl_id = impl_id, .is_generic = generic, .is_test = false, .test_name = String.new(), .test_comptime = false })
                methods.append(self.fns.len - 1)
            }
            self.impls.append(ImplDef{ .trait_name = n.name.clone(), .has_trait = n.name != "-", .at = n.start, .target = n.x, .tparams = tparams, .methods = methods, .module = m })
        } else if k == parser.NodeKind.Const {
            let n = self.node(m, it)
            let d = ConstDef{ .name = n.name.clone(), .node = it, .module = m, .start = n.start, .end = n.end, .is_pub = n.flag, .ty = NONE, .in_progress = false, .value = NONE }
            let name = d.name.clone()
            let at = d.start
            self.consts.append(d)
            self.define(m, name[..], ItemKind.Const, self.consts.len - 1, at)
        } else if k == parser.NodeKind.Global {
            let n = self.node(m, it)
            let d = GlobalDef{ .name = n.name.clone(), .node = it, .module = m, .start = n.start, .end = n.end, .ty = NONE, .init = NONE }
            let name = d.name.clone()
            let at = d.start
            self.globals.append(d)
            self.define(m, name[..], ItemKind.Global, self.globals.len - 1, at)
        } else if k == parser.NodeKind.TypeAlias {
            let n = self.node(m, it)
            let d = AliasDef{ .name = n.name.clone(), .node = it, .is_distinct = n.flag2, .module = m, .start = n.start, .end = n.end, .resolved = NONE }
            let name = d.name.clone()
            let at = d.start
            self.aliases.append(d)
            self.define(m, name[..], ItemKind.Alias, self.aliases.len - 1, at)
        } else if k == parser.NodeKind.ErrorSet {
            let n = self.node(m, it)
            let name = n.name.clone()
            let at = n.start
            let names = n.words.clone()
            for w in names { _ = self.error_id(w[..]) }
            self.error_sets.append(ErrorSetDef{ .name = name.clone(), .module = m })
            self.define(m, name[..], ItemKind.ErrorSet, self.error_sets.len - 1, at)
        } else if k == parser.NodeKind.Import {
            self.collect_import(m, it)
        } else if k == parser.NodeKind.Test {
            let n = self.node(m, it)
            self.fns.append(FnDef{ .node = it, .node_module = m, .module = m, .impl_id = NONE, .is_generic = false, .is_test = true, .test_name = n.name.clone(), .test_comptime = n.flag, .is_bench = n.flag2 })
        } else if k == parser.NodeKind.Artifact {
            self.artifact_kinds.append(self.node(m, it).name.clone())
            self.check_artifact(m, it)
        }
    }

    /// An artifact's kind and keys are ones the build knows: a key spelled
    /// wrong would be ignored, and a `stack` typed `stak` would leave `main`
    /// on the platform's default stack.
    fn check_artifact(self: *mut Self, m: usize, it: usize) {
        let kind = self.node(m, it).name.clone()
        let keys = artifact_keys(kind[..])
        if keys.len == 0 {
            let at = self.node(m, it).start
            self.fail(m, at, format("unknown artifact `{}`: the kinds are cli, cabi, python, node, rustlib, link and installer", .{kind})[..])
            return
        }
        for f in self.node(m, it).kids.clone() {
            let name = self.node(m, f).name.clone()
            let at = self.node(m, f).start
            var known = false
            for key in keys.split(", ") {
                if key == name[..] { known = true }
            }
            if !known {
                self.fail(m, at, format("`{}` is not a key of `artifact {}`, which takes {}", .{name, kind, keys})[..])
            }
        }
    }

    fn collect_import(self: *mut Self, m: usize, it: usize) {
        let n = self.node(m, it)
        var path = List(String).new()
        var names = List(String).new()
        var in_names = false
        for w in n.words {
            if w == "+" { in_names = true; continue }
            if in_names { names.append(w.clone()) } else { path.append(w.clone()) }
        }
        let target = join_words(&path, ".")
        var target_mod = NONE
        // inside package `foo`, `import util` is the module named `foo.util`
        if self.mods[m].pkg.len > 0 {
            let scoped = format("{}.{}", .{self.mods[m].pkg, target})
            for mm, i in self.mods {
                if mm.name == scoped { target_mod = i; break }
            }
        }
        if target_mod == NONE {
            for mm, i in self.mods {
                if mm.name == target { target_mod = i; break }
            }
        }
        if target_mod == NONE {
            if path[0] == "std" or is_builtin_namespace(path[path.len - 1][..]) { return }
            self.fail(m, n.start, format("cannot find module `{}`", .{target})[..])
            return
        }
        if n.flag {
            for nm in names {
                self.imports.put(item_key(m, nm[..]), ImportRef{ .module = target_mod, .name = nm.clone(), .has_name = true })
            }
        } else {
            let alias = if n.name == "-" { path[path.len - 1].clone() } else { n.name.clone() }
            self.imports.put(item_key(m, alias[..]), ImportRef{ .module = target_mod, .name = String.new(), .has_name = false })
        }
    }

    // ----- type resolution ------------------------------------------------

    fn resolve_type(self: *mut Self, m: usize, id: usize, self_ty: usize) -> usize {
        let k = self.node(m, id).k
        if k == parser.NodeKind.TName { return self.resolve_named(m, id, self_ty) }
        if k == parser.NodeKind.TInfer { return self.tys.simple(TK.Infer) }
        if k == parser.NodeKind.TArray {
            let n = self.node(m, id)
            let len_node = n.x
            let elem_node = n.y
            let e = self.resolve_type(m, elem_node, self_ty)
            if let len = self.const_eval_int(m, len_node) {
                if len < 0 {
                    self.fail(m, id, "array length must not be negative")
                    return self.tys.array(0, e)
                }
                return self.tys.array(len as u64, e)
            }
            self.fail(m, id, "array length must be a compile-time constant integer")
            return self.tys.array(0, e)
        }
        if k == parser.NodeKind.TSlice {
            let n = self.node(m, id)
            let elem_node = n.x
            let is_mut = n.flag
            let e = self.resolve_type(m, elem_node, self_ty)
            return self.tys.wrap(TK.Slice, e, is_mut)
        }
        if k == parser.NodeKind.TPtr {
            let n = self.node(m, id)
            let elem_node = n.x
            let is_mut = n.flag
            let e = self.resolve_type(m, elem_node, self_ty)
            return self.tys.wrap(TK.Ptr, e, is_mut)
        }
        if k == parser.NodeKind.TOpt {
            let elem_node = self.node(m, id).x
            let e = self.resolve_type(m, elem_node, self_ty)
            return self.tys.wrap(TK.Opt, e, false)
        }
        if k == parser.NodeKind.TWeak {
            let elem_node = self.node(m, id).x
            let e = self.resolve_type(m, elem_node, self_ty)
            return self.tys.wrap(TK.Weak, e, false)
        }
        if k == parser.NodeKind.TErr {
            let n = self.node(m, id)
            let set_node = n.x
            let elem_node = n.y
            let e = self.resolve_type(m, elem_node, self_ty)
            if set_node == NONE { return self.tys.err_union(0, false, e) }
            let sn = self.node(m, set_node)
            if sn.k == parser.NodeKind.TName and sn.words.len == 1 {
                if let r = self.lookup(m, sn.words[0][..]) {
                    if r.kind == ItemKind.ErrorSet { return self.tys.err_union(r.id, true, e) }
                }
                self.fail(m, id, format("`{}` is not an error set", .{sn.words[0]})[..])
                return self.tys.err_union(0, false, e)
            }
            self.fail(m, id, "expected an error set name before `!`")
            return self.tys.err_union(0, false, e)
        }
        if k == parser.NodeKind.TFn {
            let n = self.node(m, id)
            let params = n.kids.clone()
            let ret_node = n.x
            let eff_words = n.words.clone()
            var ps = List(usize).new()
            for p in params { ps.append(self.resolve_type(m, p, self_ty)) }
            let r = self.resolve_type(m, ret_node, self_ty)
            return self.tys.func(ps, r, effect_mask(&eff_words))
        }
        if k == parser.NodeKind.TTuple {
            let elems = self.node(m, id).kids.clone()
            var ts = List(usize).new()
            for e in elems { ts.append(self.resolve_type(m, e, self_ty)) }
            if ts.len == 0 { return self.tys.simple(TK.Void) }
            return self.tys.intern(Ty{ .k = TK.Tuple, .name = String.new(), .def = 0, .n = 0, .flag = false, .args = ts })
        }
        if k == parser.NodeKind.TDyn {
            let n = self.node(m, id)
            let trait_name = n.name.clone()
            let eff_words = n.words.clone()
            if let r = self.lookup_trait(m, trait_name[..]) {
                if r.kind == ItemKind.Trait { return self.tys.dyn_of(r.id, effect_mask(&eff_words)) }
            }
            self.fail(m, id, format("cannot find trait `{}`", .{trait_name})[..])
            return self.tys.simple(TK.Void)
        }
        self.fail(m, id, "unsupported type form")
        return self.tys.simple(TK.Void)
    }

    fn primitive(self: *mut Self, name: []u8) -> ?usize {
        for i in INT_NAMES { if i == name { return self.tys.named(TK.Int, name) } }
        if name == "f32" or name == "f64" { return self.tys.named(TK.Float, name) }
        if name == "bool" { return self.tys.simple(TK.Bool) }
        if name == "char" { return self.tys.simple(TK.Char) }
        if name == "void" { return self.tys.simple(TK.Void) }
        if name == "never" { return self.tys.simple(TK.Never) }
        if name == "error" { return self.tys.err_set(0, false) }
        if name == "type" { return self.tys.simple(TK.Type) }
        if name == "anytype" { return self.tys.simple(TK.Infer) }
        return null
    }

    fn resolve_named(self: *mut Self, m: usize, id: usize, self_ty: usize) -> usize {
        let n = self.node(m, id)
        let path = n.words.clone()
        let args = n.kids.clone()
        let at = n.start
        if path.len > 2 {
            self.fail(m, at, "type paths may have at most one module qualifier")
            return self.tys.simple(TK.Void)
        }
        var targs = List(usize).new()
        for a in args { targs.append(self.resolve_type(m, a, self_ty)) }
        if path.len == 2 { return self.named_type(m, path[1][..], path[0][..], targs, at, self_ty) }
        return self.named_type(m, path[0][..], NONE_NAME, targs, at, self_ty)
    }

    /// A named type with resolved arguments: `name`, or `qualifier.name`.
    fn named_type(self: *mut Self, m: usize, name: []u8, qualifier: []u8, own targs: List(usize), at: usize, self_ty: usize) -> usize {
        let qualified = qualifier.len > 0
        if !qualified {
            if name == "Self" {
                if self_ty != NONE { return self_ty }
                self.fail(m, at, "`Self` is only valid inside an impl or trait")
                return self.tys.simple(TK.Void)
            }
            let g = self.env_lookup(name)
            if g != NONE { return g }
            if let t = self.primitive(name) {
                if targs.len > 0 { self.fail(m, at, format("`{}` takes no type arguments", .{name})[..]) }
                return t
            }
            if name == "List" {
                if targs.len != 1 {
                    self.fail(m, at, "`List` takes one type argument: List(T)")
                    return self.tys.simple(TK.Void)
                }
                return self.tys.wrap(TK.List, targs[0], false)
            }
            if name == "Map" {
                if targs.len != 2 {
                    self.fail(m, at, "`Map` takes two type arguments: Map(K, V)")
                    return self.tys.simple(TK.Void)
                }
                return self.tys.map(targs[0], targs[1])
            }
            if name == "String" { return self.tys.simple(TK.Str) }
        }
        var module = m
        if qualified {
            let r = self.lookup(m, qualifier) orelse {
                self.fail(m, at, format("cannot find module `{}`", .{qualifier})[..])
                return self.tys.simple(TK.Void)
            }
            if r.kind != ItemKind.Module {
                self.fail(m, at, format("`{}.{}` is not a type", .{qualifier, name})[..])
                return self.tys.simple(TK.Void)
            }
            module = r.id
        }
        let r = self.lookup(module, name) orelse {
            self.fail(m, at, format("cannot find type `{}`", .{name})[..])
            return self.tys.simple(TK.Void)
        }
        if r.kind == ItemKind.Struct or r.kind == ItemKind.Enum {
            let n_params = if r.kind == ItemKind.Struct { self.structs[r.id].tparams.len } else { self.enums[r.id].tparams.len }
            if targs.len != n_params {
                self.fail(m, at, format("`{}` expects {} type argument(s) but {} were given", .{name, n_params, targs.len})[..])
                return self.tys.simple(TK.Void)
            }
            return self.tys.of_def(if r.kind == ItemKind.Struct { TK.Struct } else { TK.Enum }, r.id, targs)
        }
        if r.kind == ItemKind.Alias { return self.resolve_alias(r.id) }
        if r.kind == ItemKind.ErrorSet { return self.tys.err_set(r.id, true) }
        if r.kind == ItemKind.Trait {
            self.fail(m, at, format("`{}` is a trait, not a type", .{name})[..])
            return self.tys.simple(TK.Void)
        }
        self.fail(m, at, format("`{}` is not a type", .{name})[..])
        return self.tys.simple(TK.Void)
    }

    fn resolve_alias(self: *mut Self, id: usize) -> usize {
        if self.aliases[id].resolved != NONE { return self.aliases[id].resolved }
        let a_node = self.aliases[id].node
        let a_mod = self.aliases[id].module
        let target_node = self.node(a_mod, a_node).x
        var t = self.resolve_type(a_mod, target_node, NONE)
        if self.aliases[id].is_distinct { t = self.tys.of_def(TK.Distinct, id, List(usize).new()) }
        self.aliases[id].resolved = t
        return t
    }

    /// A constant integer expression: array lengths and the like.
    fn const_eval_int(self: *mut Self, m: usize, id: usize) -> ?i128 {
        let n = self.node(m, id)
        let k = n.k
        if k == parser.NodeKind.Lit {
            if n.text != "int" { return null }
            let v = n.name[..].parse_int(i128) catch { return null }
            return v
        }
        if k == parser.NodeKind.Unary {
            let op = n.name.clone()
            let inner = n.x
            if op != "-" { return null }
            let v = self.const_eval_int(m, inner) orelse return null
            return -v
        }
        if k == parser.NodeKind.Binary {
            let op = n.name.clone()
            let l_node = n.x
            let r_node = n.y
            let a = self.const_eval_int(m, l_node) orelse return null
            let b = self.const_eval_int(m, r_node) orelse return null
            if op == "+" { return a + b }
            if op == "-" { return a - b }
            if op == "*" { return a * b }
            if op == "/" { if b == 0 { return null }; return a / b }
            if op == "%" { if b == 0 { return null }; return a % b }
            if op == "<<" { return a << (b as u32) }
            if op == ">>" { return a >> (b as u32) }
            return null
        }
        if k == parser.NodeKind.Ident {
            let name = n.name.clone()
            if let r = self.lookup(m, name[..]) {
                if r.kind == ItemKind.Const {
                    let c_mod = self.consts[r.id].module
                    let value_node = self.node(c_mod, self.consts[r.id].node).y
                    return self.const_eval_int(c_mod, value_node)
                }
            }
            return null
        }
        return null
    }

    // ----- constants and globals -------------------------------------------

    fn resolve_const(self: *mut Self, id: usize) -> usize {
        if self.consts[id].ty != NONE { return self.consts[id].ty }
        if self.consts[id].in_progress {
            let at = self.consts[id].start
            let m = self.consts[id].module
            self.fail(m, at, "constant depends on itself")
            return self.tys.simple(TK.Void)
        }
        self.consts[id].in_progress = true
        let m = self.consts[id].module
        let node = self.consts[id].node
        let ty_node = self.node(m, node).x
        let value_node = self.node(m, node).y
        let cname = self.consts[id].name.clone()
        // the initializer is checked like any expression, in a compile-time context
        let v = self.tys.void()
        var ctx = new_ctx(v, m, format("const {}", .{cname})[..])
        ctx.is_comptime = true
        ctx.scope_marks.append(0)
        self.ctxs.append(ctx)
        var expected = NONE
        if ty_node != NONE { expected = self.resolve_type(m, ty_node, NONE) }
        var te = self.check_expr(value_node, expected)
        if expected != NONE { te = self.coerce_or_error(te, expected, "constant initializer") }
        te = self.finalize_expr(te)
        let t = self.tys.resolve(self.tir.nodes[te].ty, true)
        var seen = List(usize).new()
        let bad = self.heap_owning_part(t, &mut seen)
        if bad != NONE {
            let bk = self.tys.kind(self.tys.resolve(bad, true))
            var hint = String.new()
            if bk == TK.List { hint = format("; store a slice (`[]{}`) instead", .{self.ty_name(self.tys.list[self.tys.resolve(bad, true)].args[0])}) }
            if bk == TK.Str { hint = String.from("; store a `[]u8` instead") }
            if bad == t {
                self.fail_here(self.tir.nodes[te].start, format("a constant cannot own heap data (`{}`){}", .{self.ty_name(t), hint})[..])
            } else {
                self.fail_here(self.tir.nodes[te].start, format("a constant cannot own heap data: `{}` contains a `{}`{}", .{self.ty_name(t), self.ty_name(bad), hint})[..])
            }
        }
        // evaluate at compile time
        if let v = self.eval_const_expr(te) {
            te = self.value_node(&v, t, self.tir.nodes[te].start, self.tir.nodes[te].end)
        } else {
            self.fail_here(self.tir.nodes[te].start, "constant initializer must be evaluable at compile time")
        }
        _ = self.ctxs.pop()
        self.consts[id].in_progress = false
        self.consts[id].ty = t
        self.consts[id].value = te
        return t
    }

    /// The type of a constant initializer without an annotation: the
    /// literal defaults (`i32`, `f64`, `[]u8`), arrays of those, casts,
    /// arithmetic, and references to other constants. `expected` (or NONE)
    /// types an untyped integer literal.
    fn infer_const_type(self: *mut Self, m: usize, id: usize, expected: usize) -> usize {
        let n = self.node(m, id)
        let k = n.k
        if k == parser.NodeKind.Lit {
            let kind = n.text.clone()
            if kind == "int" {
                if expected != NONE and self.tys.list[expected].k == TK.Int { return expected }
                if expected != NONE and self.tys.list[expected].k == TK.Float { return expected }
                return self.tys.named(TK.Int, "i32")
            }
            if kind == "float" {
                if expected != NONE and self.tys.list[expected].k == TK.Float { return expected }
                return self.tys.named(TK.Float, "f64")
            }
            if kind == "str" or kind == "bytes" {
                let u8t = self.tys.named(TK.Int, "u8")
                return self.tys.wrap(TK.Slice, u8t, false)
            }
            if kind == "bool" { return self.tys.simple(TK.Bool) }
            if kind == "char" { return self.tys.simple(TK.Char) }
            return self.tys.simple(TK.Void)
        }
        if k == parser.NodeKind.Unary {
            let inner = n.x
            let op = n.name.clone()
            let t = self.infer_const_type(m, inner, expected)
            if op == "!" { return self.tys.simple(TK.Bool) }
            return t
        }
        if k == parser.NodeKind.Binary {
            let op = n.name.clone()
            let l_node = n.x
            let r_node = n.y
            if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=" or op == "and" or op == "or" {
                return self.tys.simple(TK.Bool)
            }
            // a typed side decides; a literal takes the other side's type
            let l_lit = self.node(m, l_node).k == parser.NodeKind.Lit
            let r_lit = self.node(m, r_node).k == parser.NodeKind.Lit
            if l_lit and !r_lit {
                let rt = self.infer_const_type(m, r_node, expected)
                return self.infer_const_type(m, l_node, rt)
            }
            let lt = self.infer_const_type(m, l_node, expected)
            if op == "<<" or op == ">>" { return lt }
            _ = self.infer_const_type(m, r_node, lt)
            return lt
        }
        if k == parser.NodeKind.Cast {
            let ty_node = n.y
            return self.resolve_type(m, ty_node, NONE)
        }
        if k == parser.NodeKind.ArrayLit {
            let elems = n.kids.clone()
            var elem_expected = NONE
            if expected != NONE and self.tys.list[expected].k == TK.Array { elem_expected = self.tys.list[expected].args[0] }
            var et = elem_expected
            for e, i in elems {
                let t = self.infer_const_type(m, e, if i == 0 { elem_expected } else { et })
                if i == 0 { et = t }
            }
            if elems.len == 0 and et == NONE { et = self.tys.simple(TK.Void) }
            return self.tys.array(elems.len as u64, et)
        }
        if k == parser.NodeKind.Ident {
            let name = n.name.clone()
            if let r = self.lookup(m, name[..]) {
                if r.kind == ItemKind.Const { return self.resolve_const(r.id) }
            }
            self.fail(m, id, format("cannot find `{}`", .{name})[..])
            return self.tys.simple(TK.Void)
        }
        if k == parser.NodeKind.StructLit {
            let ty_node = n.x
            if ty_node != NONE { return self.resolve_type(m, ty_node, NONE) }
        }
        self.fail(m, id, "unsupported constant initializer (stage 1)")
        return self.tys.simple(TK.Void)
    }

    /// The first part of `t` that owns heap memory (`List`, `String`, `Map`,
    /// a `ref class`, a weak reference), or NONE for a plain value type.
    fn heap_owning_part(self: *mut Self, t0: usize, seen: *mut List(usize)) -> usize {
        let t = self.tys.resolve(t0, true)
        for x in seen { if x == t { return NONE } }
        seen.append(t)
        let k = self.tys.kind(t)
        if k == TK.List or k == TK.Str or k == TK.Map or k == TK.Weak { return t }
        if k == TK.Struct {
            if self.structs[self.tys.list[t].def].kind == "ref" { return t }
            for f in self.struct_field_types(t) {
                let r = self.heap_owning_part(f, seen)
                if r != NONE { return r }
            }
            return NONE
        }
        if k == TK.Enum {
            for vt in self.enum_variant_types(t) {
                for f in vt {
                    let r = self.heap_owning_part(f, seen)
                    if r != NONE { return r }
                }
            }
            return NONE
        }
        if k == TK.Tuple {
            for f in self.tys.list[t].args.clone() {
                let r = self.heap_owning_part(f, seen)
                if r != NONE { return r }
            }
            return NONE
        }
        if k == TK.Array or k == TK.Slice or k == TK.Opt or k == TK.ErrUnion { return self.heap_owning_part(self.tys.list[t].args[0], seen) }
        if k == TK.Distinct { return self.heap_owning_part(self.distinct_underlying(self.tys.list[t].def), seen) }
        return NONE
    }

    /// A global's declared type, resolved on first use: a function checked
    /// on demand while a constant is evaluated may name a global before
    /// `resolve_globals` reaches it.
    fn global_type(self: *mut Self, i: usize) -> usize {
        if self.globals[i].ty == NONE {
            let m = self.globals[i].module
            let ty_node = self.node(m, self.globals[i].node).x
            self.globals[i].ty = self.resolve_type(m, ty_node, NONE)
        }
        return self.globals[i].ty
    }

    fn resolve_globals(self: *mut Self) {
        let n = self.globals.len
        for i in 0..n {
            let m = self.globals[i].module
            let node = self.globals[i].node
            let value_node = self.node(m, node).y
            let ty = self.global_type(i)
            if value_node != NONE {
                let gname = self.globals[i].name.clone()
                let v = self.tys.void()
                var ctx = new_ctx(v, m, format("global {}", .{gname})[..])
                ctx.is_comptime = true
                ctx.scope_marks.append(0)
                self.ctxs.append(ctx)
                var te = self.check_expr(value_node, ty)
                te = self.coerce_or_error(te, ty, "global initializer")
                te = self.finalize_expr(te)
                if let v = self.eval_const_expr(te) {
                    self.globals[i].init = self.value_node(&v, ty, self.tir.nodes[te].start, self.tir.nodes[te].end)
                } else {
                    self.fail_here(self.tir.nodes[te].start, "global initializer must be evaluable at compile time (globals are initialized at compile time or not at all)")
                }
                _ = self.ctxs.pop()
            }
        }
    }

    // ----- output -------------------------------------------------------------

    pub fn ty_name(self: *mut Self, t0: usize) -> String {
        // printing resolves: an open literal defaults to i64 or f64 here, as in the oracle
        let t = self.tys.resolve(t0, true)
        let ty = &self.tys.list[t]
        let k = ty.k
        if k == TK.Int or k == TK.Float { return ty.name.clone() }
        if k == TK.Bool { return String.from("bool") }
        if k == TK.Char { return String.from("char") }
        if k == TK.Void { return String.from("void") }
        if k == TK.Never { return String.from("never") }
        if k == TK.Str { return String.from("String") }
        if k == TK.Type { return String.from("type") }
        if k == TK.ErrorSet { return String.from("error") }
        if k == TK.Infer { return String.from("_") }
        if k == TK.Struct or k == TK.Enum {
            let name = if k == TK.Struct { self.structs[ty.def].name.clone() } else { self.enums[ty.def].name.clone() }
            if ty.args.len == 0 { return name }
            return format("{}({})", .{name, self.ty_list(ty.args[..])})
        }
        if k == TK.Array { return format("[{}]{}", .{ty.n, self.ty_name(ty.args[0])}) }
        if k == TK.Slice { return format("[]{}{}", .{if ty.flag { "mut " } else { "" }, self.ty_name(ty.args[0])}) }
        if k == TK.Ptr { return format("*{}{}", .{if ty.flag { "mut " } else { "" }, self.ty_name(ty.args[0])}) }
        if k == TK.Opt { return format("?{}", .{self.ty_name(ty.args[0])}) }
        if k == TK.ErrUnion {
            // a named set is part of the type's name: `Parse!i32`
            if ty.flag and ty.def < self.error_sets.len { return format("{}!{}", .{self.error_sets[ty.def].name, self.ty_name(ty.args[0])}) }
            return format("!{}", .{self.ty_name(ty.args[0])})
        }
        if k == TK.Weak { return format("weak {}", .{self.ty_name(ty.args[0])}) }
        if k == TK.List { return format("List({})", .{self.ty_name(ty.args[0])}) }
        if k == TK.Map { return format("Map({}, {})", .{self.ty_name(ty.args[0]), self.ty_name(ty.args[1])}) }
        if k == TK.Tuple { return format("({})", .{self.ty_list(ty.args[..])}) }
        if k == TK.Distinct { return self.aliases[ty.def].name.clone() }
        if k == TK.Fn {
            let neg = render_negative(ty.n)
            let ret = self.ty_name(ty.args[ty.args.len - 1])
            let params = self.ty_list(ty.args[0..ty.args.len - 1])
            if neg.len == 0 { return format("fn({}) -> {}", .{params, ret}) }
            return format("fn({}) -> {} {}", .{params, ret, neg})
        }
        if k == TK.Dyn {
            let neg = render_negative(ty.n)
            if neg.len == 0 { return format("dyn {}", .{self.traits[ty.def].name}) }
            return format("dyn {} {}", .{self.traits[ty.def].name, neg})
        }
        return String.from("?")
    }

    fn ty_list(self: *mut Self, ts: []usize) -> String {
        var out = String.new()
        for t, i in ts {
            if i > 0 { out.append(", ") }
            out.append(self.ty_name(t)[..])
        }
        return out
    }

    fn print_sigs(self: *mut Self, out: *mut String) {
        out.append("(program\n  (modules\n")
        for m, i in self.mods { out.append(format("    (module {} {})\n", .{i, m.name})[..]) }
        out.append("  )\n  (structs\n")
        for s, i in self.structs {
            out.append(format("    (struct {} {} @{}:{} kind={} layout={} module={} pub={} tparams=({}) derives=({})\n",
                .{i, s.name, s.start, s.end, s.kind, s.layout, s.module, s.is_pub, join_words(&s.tparams, " "), join_words(&s.derives, " ")})[..])
            for f in s.fields {
                let fnode = self.node(s.module, f)
                out.append(format("      (field {} @{}:{} default={} constraint={})\n", .{fnode.name, fnode.start, fnode.end, yes_no(fnode.y), yes_no(fnode.z)})[..])
            }
            out.append("    )\n")
        }
        out.append("  )\n  (enums\n")
        for e, i in self.enums {
            out.append(format("    (enum {} {} @{}:{} module={} tparams=({}) derives=({})\n",
                .{i, e.name, e.start, e.end, e.module, join_words(&e.tparams, " "), join_words(&e.derives, " ")})[..])
            for v in e.variants {
                let vn = self.node(e.module, v)
                var payload = String.new()
                if vn.text == "unit" {
                    payload.append("unit")
                } else if vn.text == "tuple" {
                    payload = format("tuple {}", .{vn.kids.len})
                } else {
                    payload.append("struct (")
                    for f, fi in vn.kids {
                        if fi > 0 { payload.append(" ") }
                        payload.append(self.node(e.module, f).name[..])
                    }
                    payload.append(")")
                }
                out.append(format("      (variant {} @{}:{} {})\n", .{vn.name, vn.start, vn.end, payload})[..])
            }
            out.append("    )\n")
        }
        out.append("  )\n  (aliases\n")
        for a, i in self.aliases {
            out.append(format("    (alias {} {} @{}:{} distinct={} module={})\n", .{i, a.name, a.start, a.end, a.is_distinct, a.module})[..])
        }
        out.append("  )\n  (traits\n")
        for t, i in self.traits {
            out.append(format("    (trait {} {} @{}:{} module={} assoc=({})\n", .{i, t.name, t.start, t.end, t.module, join_words(&t.assoc, " ")})[..])
            for meth in t.methods {
                let mn = self.node(t.module, meth)
                out.append(format("      (method {} @{}:{} params={} body={})\n", .{mn.name, mn.start, mn.end, mn.kids.len, yes_no(mn.y)})[..])
            }
            out.append("    )\n")
        }
        out.append("  )\n  (consts\n")
        for i in 0..self.consts.len {
            let t = self.resolve_const(i)
            let c = &self.consts[i]
            out.append(format("    (const {} {} @{}:{} module={} pub={} mangled=nxc_{}_{} ty={})\n", .{i, c.name, c.start, c.end, c.module, c.is_pub, c.name, i, self.ty_name(t)})[..])
        }
        out.append("  )\n  (globals\n")
        for g, i in self.globals {
            let init = yes_no(self.node(g.module, g.node).y)
            out.append(format("    (global {} {} @{}:{} module={} mangled=nxg_{}_{} ty={} init={})\n", .{i, g.name, g.start, g.end, g.module, g.name, i, self.ty_name(g.ty), init})[..])
        }
        out.append("  )\n  (fns\n")
        // signatures come in (module, span) order, as in the oracle
        let n_fns = self.fns.len
        var order = List(usize).new()
        for i in 0..n_fns { order.append(i) }
        var i: usize = 1
        while i < n_fns {
            var j = i
            while j > 0 and self.fn_sig_before(order[j], order[j - 1]) {
                let t = order[j - 1]
                order[j - 1] = order[j]
                order[j] = t
                j -= 1
            }
            i += 1
        }
        for fid in order { self.print_fn_sig(fid, out) }
        out.append("  )\n)\n")
    }

    /// Strictly earlier in (module, start, end) order.
    fn fn_sig_before(self: *mut Self, a: usize, b: usize) -> bool {
        let ma = self.fns[a].module
        let mb = self.fns[b].module
        if ma != mb { return ma < mb }
        let na = self.node(self.fns[a].node_module, self.fns[a].node)
        let nb = self.node(self.fns[b].node_module, self.fns[b].node)
        if na.start != nb.start { return na.start < nb.start }
        return na.end < nb.end
    }

    fn print_fn_sig(self: *mut Self, fid: usize, out: *mut String) {
        let is_generic = self.fns[fid].is_generic
        if is_generic { return }
        let m = self.fns[fid].module
        let nm = self.fns[fid].node_module
        let node = self.fns[fid].node
        let impl_id = self.fns[fid].impl_id
        let is_test = self.fns[fid].is_test
        var self_ty = NONE
        if impl_id != NONE {
            let target = self.impls[impl_id].target
            self_ty = self.resolve_type(m, target, NONE)
        }
        let n = self.node(nm, node)
        let start = n.start
        let end = n.end
        var name = n.name.clone()
        var export_name = n.text.clone()
        var is_extern = n.flag2
        var is_pub = n.flag
        var has_body = n.y != NONE
        var ctest = false
        var ret: usize = NONE
        var params = String.new()
        if is_test {
            let tn = self.fns[fid].test_name.clone()
            ctest = self.fns[fid].test_comptime
            name = format("{}:{}", .{if ctest { "ctest" } else if self.fns[fid].is_bench { "bench" } else { "test" }, tn})
            export_name = String.from("-")
            is_extern = false
            is_pub = false
            has_body = true
            let v = self.tys.simple(TK.Void)
            ret = self.tys.err_union(0, false, v)
        } else {
            let param_nodes = n.kids.clone()
            let ret_node = n.x
            for p in param_nodes {
                let pn = self.node(nm, p)
                let pname = pn.name.clone()
                let pty_node = pn.x
                let owned = pn.flag2
                let t = self.resolve_type(m, pty_node, self_ty)
                params.append(format("({} {} own={}) ", .{pname, self.ty_name(t), owned})[..])
            }
            if params.len > 0 { params = String.from(params[0..params.len - 1]) }
            ret = if ret_node == NONE { self.tys.simple(TK.Void) } else { self.resolve_type(m, ret_node, self_ty) }
        }
        // the mangled name: extern functions keep theirs, free functions are
        // `nx_name` in the root module or when exported and `nx_m<module>_name`
        // elsewhere; methods and tests are numbered by the body-checking stage
        var mangled = String.from("-")
        if is_extern {
            mangled = name.clone()
        } else if impl_id == NONE and (!is_test or ctest) {
            // a comptime test's name is not `test:`-prefixed, so it mangles as a free function
            if m == 0 or export_name != "-" {
                mangled = format("nx_{}", .{sanitize(name[..])})
            } else {
                mangled = format("nx_m{}_{}", .{m, sanitize(name[..])})
            }
        }
        var neg: u64 = 0
        var pos: u64 = 0
        if !is_test {
            for w in n.words {
                if w[0] == '!' { neg = neg | effect_bit(w[1..]) } else { pos = pos | effect_bit(w[..]) }
            }
        }
        out.append(format("    (fn - {} @{}:{} mangled={} module={} ret={} targs=() export={} extern={} variadic={} pub={} test={} ctest={} closure=false body={}\n",
            .{name, start, end, mangled, m, self.ty_name(ret), export_name, is_extern, n.b == 1, is_pub, is_test, ctest, if has_body { "yes" } else { "no" }})[..])
        out.append(format("      (params {})\n", .{params})[..])
        out.append(format("      (declared neg=({}) pos=({}))\n", .{render_effects(neg), render_effects(pos)})[..])
        out.append("    )\n")
    }
}

impl Types {
    fn err_set(self: *mut Self, set: usize, has_set: bool) -> usize {
        return self.intern(Ty{ .k = TK.ErrorSet, .name = String.new(), .def = set, .n = 0, .flag = has_set, .args = List(usize).new() })
    }
}

fn effect_mask(words: *List(String)) -> u64 {
    // a function type permits every effect except the negated ones
    var mask: u64 = 0xff
    for w in words {
        if w.len > 0 and w[0] == '!' { mask = mask & ~effect_bit(w[1..]) }
    }
    return mask
}

pub fn is_builtin_namespace(name: []u8) -> bool {
    for n in BUILTIN_NAMESPACES { if n == name { return true } }
    return false
}

pub fn yes_no(id: usize) -> []u8 {
    return if id == NONE { "no" } else { "yes" }
}

fn sanitize(s: []u8) -> String {
    var out = String.new()
    for c in s {
        let alnum = (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'
        if alnum {
            out.push_byte(c)
        } else if c == '(' or c == ',' or c == ')' or c == ' ' or c == '[' or c == ']' or c == '*' or c == '?' or c == '!' or c == '.' {
            if out.len == 0 or out[out.len - 1] != '_' { out.push_byte('_') }
        }
    }
    while out.len > 0 and out[out.len - 1] == '_' { _ = out.pop() }
    return out
}

pub fn tquote(b: []u8) -> String {
    var s = String.from("\"")
    for c in b {
        if c == '"' { s.append("\\\"") }
        else if c == '\\' { s.append("\\\\") }
        else if c == '\n' { s.append("\\n") }
        else if c == '\r' { s.append("\\r") }
        else if c == '\t' { s.append("\\t") }
        else if c >= 0x20 and c <= 0x7e { s.push_byte(c) }
        else {
            let hex = "0123456789abcdef"
            s.append("\\x")
            s.push_byte(hex[(c >> 4) as usize])
            s.push_byte(hex[(c & 15) as usize])
        }
    }
    s.append("\"")
    return s
}

/// The words of a space-separated list (a segment description, a where clause).
pub fn split_words(codes: []u8) -> List(String) { return Checker.split_words(codes) }

pub fn find_sub(hay: []u8, needle: []u8) -> ?usize {
    if needle.len > hay.len { return null }
    var i: usize = 0
    while i + needle.len <= hay.len {
        if hay[i..i + needle.len] == needle { return i }
        i += 1
    }
    return null
}

/// Rust prints floats with `{:?}`: the shortest round-trip text, with a
/// fractional part in decimal form (`100.0`) and a bare exponent in
/// exponential form (`1e-6`, `1e21`, never `1e-06`).
pub fn rust_float(v: f64) -> String {
    let s = format("{}", .{v})
    var epos = NONE
    for c, i in s { if c == 'e' or c == 'E' { epos = i } }
    if epos == NONE {
        var has_dot = false
        for c in s { if c == '.' or c == 'n' or c == 'i' { has_dot = true } }
        var out = String.from(s[..])
        if !has_dot { out.append(".0") }
        return out
    }
    var out = String.from(s[0..epos])
    out.append("e")
    var rest = s[epos + 1..]
    if rest.len > 0 and rest[0] == '+' { rest = rest[1..] }
    var neg = false
    if rest.len > 0 and rest[0] == '-' { neg = true; rest = rest[1..] }
    while rest.len > 1 and rest[0] == '0' { rest = rest[1..] }
    if neg { out.append("-") }
    out.append(rest)
    return out
}

pub fn list_has_usize(xs: *List(usize), x: usize) -> bool {
    for y in xs { if y == x { return true } }
    return false
}

pub fn max64(a: u64, b: u64) -> u64 { return if a > b { a } else { b } }

pub fn min64(a: u64, b: u64) -> u64 { return if a < b { a } else { b } }

pub fn round_up(v: u64, a: u64) -> u64 {
    if a == 0 { return v }
    return ((v + a - 1) / a) * a
}

// ---------------------------------------------------------------- errors and instances

impl Checker {
    fn error_id(self: *mut Self, name: []u8) -> usize {
        if let id = self.error_ids.get(name) { return id }
        self.error_names.append(String.from(name))
        let id = self.error_names.len
        self.error_ids.put(String.from(name), id)
        return id
    }

    /// The well-known errors get stable ids before any body is checked.
    fn reserve_errors(self: *mut Self) {
        let names = ["OutOfMemory", "Panic", "InvalidRecord", "Truncated", "Overflow", "InvalidUtf8", "NotFound", "IoError", "InvalidInput", "BufferTooSmall", "Timeout", "ConnectionRefused"]
        for n in names { _ = self.error_id(n) }
    }

    // ----- the current function context ----------------------------------------

    fn ctx(self: *mut Self) -> *mut FnCtx {
        return &mut self.ctxs[self.ctxs.len - 1]
    }
    fn cur_module(self: *Self) -> usize { return self.ctxs[self.ctxs.len - 1].module }

    fn add_effect(self: *mut Self, e: u64, at: usize, why: []u8) {
        let c = self.ctx()
        var seen = (c.own_effects & e) != 0
        if seen {
            // a witness is kept only for the first introduction of an effect
            var any = false
            for w in c.witnesses { if (w.effects & e) != 0 { any = true } }
            seen = any
        }
        if !seen { c.witnesses.append(Witness{ .effects = e, .at = at, .why = String.from(why) }) }
        c.own_effects = c.own_effects | e
    }

    fn push_scope(self: *mut Self) {
        let c = self.ctx()
        c.scope_marks.append(c.scope_names.len)
    }
    fn pop_scope(self: *mut Self) {
        let c = self.ctx()
        let mark = c.scope_marks.pop() orelse 0
        while c.scope_names.len > mark {
            _ = c.scope_names.pop()
            _ = c.scope_locals.pop()
            _ = c.scope_deref.pop()
        }
    }
    fn scope_depth(self: *mut Self) -> usize { return self.ctx().scope_marks.len }

    fn declare_local(self: *mut Self, name: []u8, ty: usize, mutable: bool, start: usize, end: usize) -> usize {
        let c = self.ctx()
        let id = c.locals.len
        c.locals.append(Local{ .name = String.from(name), .ty = ty, .mutable = mutable, .start = start, .end = end, .is_param = false, .owned = false, .loop_item = false, .if_let = false, .tuple_view = false, .origins = List(Origin).new(), .depth = c.scope_marks.len, .changes = List(Change).new(), .warned = List(usize).new(), .arena_depth = c.using_depth, .made_in = c.using_depth, .last_use = 0 })
        c.scope_names.append(String.from(name))
        c.scope_locals.append(id)
        c.scope_deref.append(false)
        return id
    }

    /// The innermost local of that name, or NONE.
    fn lookup_local(self: *mut Self, name: []u8) -> usize {
        let c = self.ctx()
        var i = c.scope_names.len
        while i > 0 {
            i -= 1
            if c.scope_names[i] == name { return c.scope_locals[i] }
        }
        return NONE
    }

    /// Is the innermost local of that name a by-reference capture (read through its pointer)?
    fn lookup_deref(self: *mut Self, name: []u8) -> bool {
        let c = self.ctx()
        var i = c.scope_names.len
        while i > 0 {
            i -= 1
            if c.scope_names[i] == name { return c.scope_deref[i] }
        }
        return false
    }

    fn new_label(self: *mut Self, name: []u8, has_name: bool, is_loop: bool, break_ty: usize) -> usize {
        let depth = self.scope_depth()
        let c = self.ctx()
        let id = c.next_label
        c.next_label += 1
        c.labels.append(LabelInfo{ .name = String.from(name), .has_name = has_name, .id = id, .is_loop = is_loop, .break_ty = break_ty, .scope_depth = depth })
        return id
    }

    fn local_ty(self: *mut Self, l: usize) -> usize { return self.ctx().locals[l].ty }

    fn fail_here(self: *mut Self, at: usize, msg: []u8) {
        let m = self.cur_module()
        self.fail(m, at, msg)
    }

    // ----- instances --------------------------------------------------------------

    fn inst_key(fid: usize, targs: *List(usize)) -> String {
        var k = format("{}:", .{fid})
        for t in targs { k.append(format("{},", .{t})) }
        return k
    }

    /// Get or create the instance of a definition with these type arguments.
    fn instantiate(self: *mut Self, fid: usize, own targs0: List(usize)) -> usize {
        var targs = List(usize).new()
        for t in targs0 { targs.append(self.tys.resolve(t, true)) }
        let key = Checker.inst_key(fid, &targs)
        if let id = self.inst_map.get(key[..]) { return id }
        let id = self.insts.len
        self.inst_map.put(key, id)
        let m = self.fns[fid].module
        let node = self.fns[fid].node
        let nm = self.fns[fid].node_module
        let impl_id = self.fns[fid].impl_id
        let is_test = self.fns[fid].is_test
        // the environment: impl type parameters first, then the function's
        var gen_names = List(String).new()
        var gen_tys = List(usize).new()
        var ti: usize = 0
        if impl_id != NONE {
            let tps = self.impls[impl_id].tparams.clone()
            for tp in tps {
                gen_names.append(tp.clone())
                gen_tys.append(if ti < targs.len { targs[ti] } else { self.tys.void() })
                ti += 1
            }
        }
        if !is_test {
            let tps = self.fn_type_params(fid)
            for tp in tps {
                gen_names.append(tp.clone())
                gen_tys.append(if ti < targs.len { targs[ti] } else { self.tys.void() })
                ti += 1
            }
        }
        let saved_env = self.env_save()
        self.env_set(&gen_names, &gen_tys)
        var self_ty = NONE
        if impl_id != NONE {
            let target = self.impls[impl_id].target
            self_ty = self.resolve_type(m, target, NONE)
        }
        var locals = List(Local).new()
        var params = List(usize).new()
        var ret: usize = NONE
        var name = String.new()
        var export_name = String.from("-")
        var is_extern = false
        var is_pub = false
        var test_comptime = false
        var neg: u64 = 0
        var pos: u64 = 0
        var start: usize = 0
        var end: usize = 0
        var any_owned = false
        var is_variadic = false
        if is_test {
            test_comptime = self.fns[fid].test_comptime
            name = format("{}:{}", .{if test_comptime { "ctest" } else if self.fns[fid].is_bench { "bench" } else { "test" }, self.fns[fid].test_name})
            let v = self.tys.void()
            ret = self.tys.err_union(0, false, v)
            start = self.node(nm, node).start
            end = self.node(nm, node).end
        } else {
            let n = self.node(nm, node)
            name = n.name.clone()
            export_name = n.text.clone()
            is_extern = n.flag2
            is_variadic = n.b == 1
            is_pub = n.flag
            start = n.start
            end = n.end
            let param_nodes = n.kids.clone()
            let ret_node = n.x
            let words = n.words.clone()
            for p in param_nodes {
                let pn = self.node(nm, p)
                // a `comptime T: type` parameter is a type argument, not a local
                if pn.flag and self.is_type_param_node(nm, p) { continue }
                let pname = pn.name.clone()
                let pty_node = pn.x
                let owned = pn.flag2
                let pstart = pn.start
                let pend = pn.end
                let t = self.resolve_type(m, pty_node, self_ty)
                // in a generic function the instantiation decides whether `own` matters
                if owned and !self.needs_drop(t) and gen_names.len == 0 {
                    self.fail(m, pstart, format("`own` applies to owning types (`List`, `String`, `Map`, or structs holding them); `{}` is copied anyway", .{self.ty_name(t)})[..])
                }
                if owned { any_owned = true }
                locals.append(Local{ .name = pname, .ty = t, .mutable = owned, .start = pstart, .end = pend, .is_param = true, .owned = owned, .loop_item = false, .if_let = false, .tuple_view = false, .origins = List(Origin).new(), .depth = 0, .changes = List(Change).new(), .warned = List(usize).new(), .arena_depth = 0, .made_in = 0, .last_use = 0 })
                params.append(locals.len - 1)
            }
            ret = if ret_node == NONE { self.tys.void() } else { self.resolve_type(m, ret_node, self_ty) }
            for w in words {
                if w[0] == '!' { neg = neg | effect_bit(w[1..]) } else { pos = pos | effect_bit(w[..]) }
            }
            if export_name != "-" {
                if targs.len > 0 { self.fail(m, start, "generic functions cannot be exported") }
                if any_owned { self.fail(m, start, "exported functions cannot take `own` parameters; the host language cannot hand over ownership") }
            }
        }
        self.env_restore(&saved_env)
        var mangled = String.new()
        if is_extern {
            mangled = name.clone()
        } else if is_test and !test_comptime {
            mangled = format("nx_test_{}", .{id})
        } else if targs.len == 0 and impl_id == NONE {
            if m == 0 or export_name != "-" {
                mangled = format("nx_{}", .{sanitize(name[..])})
            } else {
                mangled = format("nx_m{}_{}", .{m, sanitize(name[..])})
            }
        } else {
            var base = name.clone()
            if impl_id != NONE {
                base = format("{}_{}", .{sanitize(self.ty_name(self_ty)[..]), name})
            }
            mangled = format("nx_{}_{}", .{sanitize(base[..]), id})
        }
        self.insts.append(Inst{
            .name = name, .mangled = mangled, .def = fid, .targs = targs, .gen_names = gen_names, .gen_tys = gen_tys, .params = params, .ret = ret, .locals = locals, .body = NONE,
            .own_effects = 0, .effects = 0, .declared_neg = neg, .declared_pos = pos, .export_name = export_name,
            .is_extern = is_extern, .is_variadic = is_variadic, .is_pub = is_pub, .is_test = is_test, .test_comptime = test_comptime,
            .is_closure = false, .closure_by_ref = List(bool).new(), .start = start, .end = end, .module = m, .self_ty = self_ty,
            .witnesses = List(Witness).new(), .callees = List(usize).new(), .callee_spans = List(usize).new(),
        })
        // a std module's tests belong to the compiler's own suite
        let from_std = self.mods[m].name.len >= 4 and self.mods[m].name[0..4] == "std."
        if is_test and !test_comptime and !(from_std and m != 0) {
            if self.fns[fid].is_bench { self.benches.append(id) } else { self.tests.append(id) }
        }
        self.queue.append(id)
        return id
    }

    /// `comptime T: type` parameters, in order.
    fn fn_type_params(self: *mut Self, fid: usize) -> List(String) {
        var out = List(String).new()
        let m = self.fns[fid].node_module
        let node = self.fns[fid].node
        if self.fns[fid].is_test { return out }
        let params = self.node(m, node).kids.clone()
        for p in params {
            if self.node(m, p).flag and self.is_type_param_node(m, p) { out.append(self.node(m, p).name.clone()) }
        }
        return out
    }

    fn is_type_param_node(self: *mut Self, m: usize, p: usize) -> bool {
        let ty_node = self.node(m, p).x
        let tn = self.node(m, ty_node)
        return tn.k == parser.NodeKind.TName and tn.words.len == 1 and tn.words[0] == "type" and tn.kids.len == 0
    }

    fn drain_queue(self: *mut Self) {
        while self.queue.len > 0 {
            let inst = self.queue.pop() orelse break
            self.check_fn_body(inst)
        }
    }

    fn check_program(self: *mut Self) {
        self.check_duplicate_methods()
        self.check_trait_impls()
        let n = self.consts.len
        for i in 0..n { _ = self.resolve_const(i) }
        self.resolve_globals()
        let nf = self.fns.len
        for fid in 0..nf {
            if self.fns[fid].is_generic or self.fns[fid].impl_id != NONE { continue }
            let id = self.instantiate(fid, List(usize).new())
            let m = self.fns[fid].module
            if !self.fns[fid].is_test and self.node(self.fns[fid].node_module, self.fns[fid].node).name == "main" and m == 0 { self.main_inst = id }
        }
        for fid in 0..nf {
            let impl_id = self.fns[fid].impl_id
            if impl_id == NONE or self.fns[fid].is_generic { continue }
            if self.impls[impl_id].tparams.len == 0 { _ = self.instantiate(fid, List(usize).new()) }
        }
        self.drain_queue()
        self.check_open_literals()
        // compile-time tests run in the interpreter; a failure is a compile error
        let ni = self.insts.len
        for t in 0..ni {
            if !self.insts[t].test_comptime { continue }
            let name = self.insts[t].name[6..]
            let tname = String.from(name)
            let tstart = self.insts[t].start
            let tm = self.insts[t].module
            let code = self.call_instance(t, List(check_interp.CV).new())
            if code == 0 {
                if self.it_out.kind == check_interp.VK_ERR {
                    let ename = self.error_names[(self.it_out.ival - 1) as usize].clone()
                    self.fail(tm, tstart, format("comptime test \"{}\" failed with error.{}", .{tname, ename})[..])
                }
            } else if code == 1 {
                self.fail(tm, tstart, format("comptime test \"{}\" could not be evaluated at compile time (only pure computation runs at compile time)", .{tname})[..])
            } else {
                self.fail(tm, self.it_panic_at, format("comptime test \"{}\" panicked: {}", .{tname, self.it_panic})[..])
            }
        }
        self.propagate_effects()
        self.check_effect_bounds()
        self.check_embedded_constraints()
        self.check_obligations()
        self.check_export_types()
    }

    /// Note an integer literal whose type was still open when it was typed.
    fn note_open_literal(self: *mut Self, r: usize) {
        self.open_lits.append(r)
        self.open_lit_mods.append(self.cur_module())
    }

    /// Every integer literal fits the type it finally has: the type the
    /// program gave it, or `i64`, which an open literal defaults to.
    /// Checked once every body is, when each literal's type is settled.
    fn check_open_literals(self: *mut Self) {
        let n = self.open_lits.len
        for i in 0..n {
            let r = self.open_lits[i]
            let t = self.tys.resolve(self.tir.nodes[r].ty, true)
            if self.tys.kind(t) != TK.Int { continue }
            let name = self.tys.list[t].name.clone()
            let v = self.tir.nodes[r].ival
            // a literal past i128's maximum is its u128 bit pattern
            let big = self.tir.nodes[r].flag
            if big and name == "u128" { continue }
            if !big and v >= int_min(name[..]) and v <= int_max(name[..]) { continue }
            let range = if name == "u128" { String.from("range 0 to 340282366920938463463374607431768211455") } else { format("range {} to {}", .{int_min(name[..]), int_max(name[..])}) }
            let shown = if big { format("{}", .{@truncate(u128, v)}) } else { format("{}", .{v}) }
            let hint = if name == "i64" { "; an integer literal is `i64` unless its context gives it a type, as in `let x: u64 = ...`" } else { "" }
            self.fail(self.open_lit_mods[i], self.tir.nodes[r].start, format("literal `{}` does not fit in `{}` ({}){}", .{shown, name, range, hint})[..])
        }
    }

    /// Whether a type crosses the C boundary as one C scalar.
    fn is_c_scalar(self: *mut Self, t0: usize) -> bool {
        let t = self.tys.shallow(t0)
        let k = self.tys.kind(t)
        if k == TK.Int or k == TK.Float or k == TK.Bool or k == TK.Char { return true }
        if k == TK.Distinct { return self.is_c_scalar(self.distinct_underlying(self.tys.list[t].def)) }
        return false
    }

    /// Whether a parameter or result of an exported function can cross the
    /// C boundary (scalars, slices of scalars as parameters, `layout(c)`
    /// structs of scalars); the error names what cannot. The words are the
    /// C generator's, which keeps the same rules as a last line.
    fn export_crossing(self: *mut Self, t0: usize, what: []u8, fname: []u8, module: usize, at: usize, is_result: bool) {
        if self.is_c_scalar(t0) { return }
        let t = self.tys.shallow(t0)
        let k = self.tys.kind(t)
        if k == TK.Slice {
            if is_result {
                self.fail(module, at, format("export `{}`: returning a slice across the boundary is not allowed (its lifetime cannot be expressed); return through a caller-provided buffer", .{fname})[..])
            } else if !self.is_c_scalar(self.tys.list[t].args[0]) {
                self.fail(module, at, format("export `{}`: {} is a slice of a non-scalar type, which has no C representation", .{fname, what})[..])
            }
            return
        }
        if k == TK.Struct {
            let d = self.tys.list[t].def
            if self.structs[d].layout != "c" or self.structs[d].kind == "ref" {
                self.fail(module, at, format("export `{}`: {} has type `{}`, which needs `layout(c)` to cross the boundary", .{fname, what, self.structs[d].name})[..])
                return
            }
            let ftys = self.struct_field_types(t)
            let dm = self.structs[d].module
            for f, i in self.structs[d].fields.clone() {
                if !self.is_c_scalar(ftys[i]) {
                    self.fail(module, at, format("export `{}`: field `{}` of `{}` is not a scalar", .{fname, self.node(dm, f).name, self.structs[d].name})[..])
                    return
                }
            }
            return
        }
        self.fail(module, at, format("export `{}`: {} has type `{}`, which has no C representation (use scalars, slices of scalars, or `layout(c)` structs)", .{fname, what, self.ty_name(t)})[..])
    }

    /// Every exported function's parameters and result can cross the C boundary.
    fn check_export_types(self: *mut Self) {
        let n = self.insts.len
        for i in 0..n {
            if self.insts[i].export_name == "-" or self.insts[i].is_extern or self.insts[i].body == NONE { continue }
            let fname = self.insts[i].name.clone()
            let m = self.insts[i].module
            let at = self.insts[i].start
            for pl in self.insts[i].params.clone() {
                let what = format("parameter `{}`", .{self.insts[i].locals[pl].name})
                self.export_crossing(self.insts[i].locals[pl].ty, what[..], fname[..], m, at, false)
                // a slice `p` is `p` and `p_len` in C, and the header shows these names
                if self.tys.kind(self.tys.shallow(self.insts[i].locals[pl].ty)) == TK.Slice {
                    let len_name = format("{}_len", .{self.insts[i].locals[pl].name})
                    for other in self.insts[i].params.clone() {
                        if self.insts[i].locals[other].name == len_name {
                            self.fail(m, at, format("export `{}`: parameter `{}` has the name C gives the length of `{}`; rename one", .{fname, len_name, self.insts[i].locals[pl].name})[..])
                        }
                    }
                }
            }
            let ret = self.tys.shallow(self.insts[i].ret)
            let payload = if self.tys.kind(ret) == TK.ErrUnion { self.tys.list[ret].args[0] } else { ret }
            if self.tys.kind(self.tys.shallow(payload)) != TK.Void { self.export_crossing(payload, "the return value", fname[..], m, at, true) }
        }
    }

    /// Declared negative bounds hold; calls in `for parallel` bodies do not
    /// mutate shared state.
    fn check_effect_bounds(self: *mut Self) {
        let n = self.insts.len
        for i in 0..n {
            if self.insts[i].body == NONE { continue }
            let violated = self.insts[i].effects & self.insts[i].declared_neg
            if violated == 0 { continue }
            let fname = self.insts[i].name.clone()
            let fstart = self.insts[i].start
            let fm = self.insts[i].module
            for nm, ei in EFFECT_NAMES {
                let bit = (1 as u64) << (ei as u64)
                if (violated & bit) == 0 { continue }
                self.fail(fm, fstart, format("function `{}` is declared `!{}` but has the `{}` effect", .{fname, nm, nm})[..])
                let intro = self.find_introducer(i, bit)
                if intro == NONE { continue }
                let why = self.introducer_why(intro, bit)
                if intro == i {
                    self.note(fm, self.introducer_at(intro, bit), format("the effect is introduced here: {}", .{why})[..])
                } else {
                    // the first call in this function on a path to the introducer
                    var call_at = fstart
                    for c, ci in self.insts[i].callees {
                        if (self.insts[c].effects & bit) != 0 and ci < self.insts[i].callee_spans.len { call_at = self.insts[i].callee_spans[ci]; break }
                    }
                    self.note(fm, call_at, format("this call acquires `{}`", .{nm})[..])
                    self.note(self.insts[intro].module, self.introducer_at(intro, bit), format("introduced by `{}` here: {}", .{self.insts[intro].name, why})[..])
                }
            }
        }
        let calls = self.parallel_calls.clone()
        for c in calls {
            if (self.insts[c.inst].effects & EFF_SHARED_MUTABLE) != 0 {
                self.fail(c.module, c.at, format("`{}` is called inside a `for parallel` body but has the `shared_mutable` effect", .{self.insts[c.inst].name})[..])
            }
        }
    }

    /// The function that introduces effect `bit` on some call path from `inst`.
    fn find_introducer(self: *mut Self, inst: usize, bit: u64) -> usize {
        var visited = List(usize).new()
        var stack = List(usize).new()
        stack.append(inst)
        while stack.len > 0 {
            let i = stack.pop() orelse break
            if list_has_usize(&visited, i) { continue }
            visited.append(i)
            if (self.insts[i].own_effects & bit) != 0 or self.insts[i].is_extern { return i }
            for c in self.insts[i].callees.clone() {
                if (self.insts[c].effects & bit) != 0 { stack.append(c) }
            }
        }
        return NONE
    }

    /// Where effect `bit` enters `inst`: the recorded witness (the call, the
    /// append, the write), or the function's header when there is none (an
    /// extern function has no body to point into).
    /// The witness of an effect in an instance, for the editor: where it
    /// enters (the instance's start when it has no recorded witness) and why.
    pub fn witness_at(self: *mut Self, inst: usize, bit: u64) -> usize {
        return self.introducer_at(inst, bit)
    }

    pub fn witness_why(self: *mut Self, inst: usize, bit: u64) -> String {
        return self.introducer_why(inst, bit)
    }

    fn introducer_at(self: *mut Self, inst: usize, bit: u64) -> usize {
        for w in self.insts[inst].witnesses { if (w.effects & bit) != 0 { return w.at } }
        return self.insts[inst].start
    }

    fn introducer_why(self: *mut Self, inst: usize, bit: u64) -> String {
        for w in self.insts[inst].witnesses { if (w.effects & bit) != 0 { return w.why.clone() } }
        if self.insts[inst].is_extern { return String.from("foreign functions may do anything") }
        return String.new()
    }

    /// In an embeddable library, any reachable mutable global is an error.
    fn check_embedded_constraints(self: *mut Self) {
        var embedded = false
        for k in self.artifact_kinds {
            if k == "cabi" or k == "python" or k == "rustlib" or k == "node" or k == "shared" { embedded = true }
        }
        if !embedded { return }
        var reported = List(usize).new()
        let uses = self.global_uses.clone()
        for u, i in uses {
            if list_has_usize(&reported, u.inst) { continue }
            reported.append(u.inst)
            let gname = self.globals[u.inst].name.clone()
            self.fail(u.module, u.at, format("mutable global `{}` is reachable from `{}`, but this project declares an embeddable artifact (S2: no process-global state)", .{gname, self.global_use_fns[i]})[..])
        }
    }

    /// Closures, function references and trait objects coerced to bounded
    /// types must not have the effects those types forbid.
    fn check_obligations(self: *mut Self) {
        let obs = self.obligations.clone()
        for o in obs {
            let violated = self.insts[o.inst].effects & o.neg
            if violated == 0 { continue }
            var what = format("`{}`", .{self.insts[o.inst].name})
            if self.insts[o.inst].is_closure { what = String.from("this closure") }
            for nm, i in EFFECT_NAMES {
                if (violated & (1 << (i as u64))) == 0 { continue }
                self.fail(o.module, o.at, format("{} has the `{}` effect, but the function type it is used as forbids it (`!{}`)", .{what, nm, nm})[..])
            }
        }
    }

    fn oblige(self: *mut Self, inst: usize, neg: u64, at: usize) {
        if neg == 0 { return }
        self.obligations.append(Obligation{ .inst = inst, .neg = neg, .at = at, .module = self.cur_module() })
    }

    /// effects(f) = own(f) plus the effects of every callee, to a fixpoint.
    fn propagate_effects(self: *mut Self) {
        let n = self.insts.len
        self.mark_recursion()
        for i in 0..n {
            var e = self.insts[i].own_effects
            if self.insts[i].is_extern {
                e = e | EFF_FFI | EFF_BLOCKS | EFF_PANICS | EFF_ALLOCATES | EFF_NONDETERMINISTIC | EFF_SHARED_MUTABLE
            }
            self.insts[i].effects = e
        }
        var changed = true
        while changed {
            changed = false
            for i in 0..n {
                var e = self.insts[i].effects
                let callees = self.insts[i].callees.clone()
                for c in callees { e = e | self.insts[c].effects }
                if e != self.insts[i].effects {
                    self.insts[i].effects = e
                    changed = true
                }
            }
        }
    }

    /// A function on a cycle of the call graph (it calls itself, or calls
    /// something that calls it back) has the `unbounded_stack` effect: its
    /// stack use depends on its input (specification 9). Calls through
    /// function values and trait objects acquire it the way they acquire
    /// every effect the type permits. Strongly connected components of the
    /// instance call graph, by Tarjan's algorithm.
    fn mark_recursion(self: *mut Self) {
        let n = self.insts.len
        var t = Tarjan{ .index = List(usize).new(), .low = List(usize).new(), .on_stack = List(bool).new(), .stack = List(usize).new(), .next = 0, .comp = List(usize).new() }
        for _ in 0..n { t.index.append(NONE); t.low.append(0); t.on_stack.append(false); t.comp.append(NONE) }
        for i in 0..n { if t.index[i] == NONE { self.tarjan_visit(&mut t, i) } }
        // a component is a cycle when it has more than one member, or its one
        // member calls itself
        var size = List(usize).new()
        for _ in 0..n { size.append(0) }
        for i in 0..n { size[t.comp[i]] += 1 }
        for i in 0..n {
            let c = t.comp[i]
            var partner = NONE
            if size[c] > 1 {
                for k in self.insts[i].callees { if k != i and t.comp[k] == c { partner = k } }
            } else {
                for k in self.insts[i].callees { if k == i { partner = i } }
            }
            if partner == NONE { continue }
            let name = self.insts[i].name.clone()
            let why = if partner == i {
                format("`{}` calls itself: the recursion depth depends on the input", .{name})
            } else {
                format("`{}` and `{}` call each other: the recursion depth depends on the input", .{name, self.insts[partner].name})
            }
            self.insts[i].own_effects = self.insts[i].own_effects | EFF_UNBOUNDED_STACK
            self.insts[i].witnesses.append(Witness{ .effects = EFF_UNBOUNDED_STACK, .at = self.insts[i].start, .why = why })
        }
    }

    fn tarjan_visit(self: *mut Self, t: *mut Tarjan, v: usize) {
        t.index[v] = t.next
        t.low[v] = t.next
        t.next += 1
        t.stack.append(v)
        t.on_stack[v] = true
        let callees = self.insts[v].callees.clone()
        for w in callees {
            if t.index[w] == NONE {
                self.tarjan_visit(t, w)
                if t.low[w] < t.low[v] { t.low[v] = t.low[w] }
            } else if t.on_stack[w] {
                if t.index[w] < t.low[v] { t.low[v] = t.index[w] }
            }
        }
        if t.low[v] == t.index[v] {
            while true {
                let w = t.stack.pop() orelse break
                t.on_stack[w] = false
                t.comp[w] = v
                if w == v { break }
            }
        }
    }
}

// ---------------------------------------------------------------- type predicates

impl Checker {
    pub fn is_ref_class(self: *mut Self, t0: usize) -> bool {
        let t = self.tys.shallow(t0)
        if self.tys.kind(t) != TK.Struct { return false }
        return self.structs[self.tys.list[t].def].kind == "ref"
    }

    /// Types whose copies are made by retaining: ref classes and optionals or weak refs of them.
    fn is_ref_like(self: *mut Self, t0: usize) -> bool {
        let t = self.tys.shallow(t0)
        let k = self.tys.kind(t)
        if k == TK.Opt or k == TK.Weak { return self.is_ref_like(self.tys.list[t].args[0]) }
        return self.is_ref_class(t)
    }

    /// The resolved field types of a struct type (generic arguments applied).
    fn struct_field_types(self: *mut Self, t0: usize) -> List(usize) {
        let t = self.tys.shallow(t0)
        var out = List(usize).new()
        if self.tys.kind(t) != TK.Struct { return out }
        let d = self.tys.list[t].def
        let m = self.structs[d].module
        let fields = self.structs[d].fields.clone()
        let saved = self.env_save()
        self.env_set(&self.structs[d].tparams.clone(), &self.tys.list[t].args.clone())
        for f in fields {
            let ty_node = self.node(m, f).x
            out.append(self.resolve_type(m, ty_node, t))
        }
        self.env_restore(&saved)
        return out
    }

    // ----- the generic environment ----------------------------------------------------

    fn env_lookup(self: *mut Self, name: []u8) -> usize {
        var i = self.env_names.len
        while i > 0 {
            i -= 1
            if self.env_names[i] == name { return self.env_tys[i] }
        }
        return NONE
    }

    /// The environment as a flat list: names then types, for save and restore.
    fn env_save(self: *mut Self) -> EnvSave {
        return EnvSave{ .names = self.env_names.clone(), .tys = self.env_tys.clone() }
    }
    fn env_restore(self: *mut Self, saved: *EnvSave) {
        self.env_names = saved.names.clone()
        self.env_tys = saved.tys.clone()
    }
    fn env_set(self: *mut Self, names: *List(String), tys: *List(usize)) {
        self.env_names = names.clone()
        self.env_tys = tys.clone()
    }
    fn env_bind(self: *mut Self, name: []u8, ty: usize) {
        self.env_names.append(String.from(name))
        self.env_tys.append(ty)
    }

    /// Does a value of this type own resources released at scope exit?
    fn needs_drop(self: *mut Self, t0: usize) -> bool {
        let t = self.tys.shallow(t0)
        let k = self.tys.kind(t)
        if k == TK.List or k == TK.Str or k == TK.Map or k == TK.Weak { return true }
        if k == TK.Struct {
            if self.is_ref_class(t) { return true }
            let fts = self.struct_field_types(t)
            for f in fts { if self.needs_drop(f) { return true } }
            return false
        }
        if k == TK.Enum {
            let d = self.tys.list[t].def
            let m = self.enums[d].module
            let variants = self.enums[d].variants.clone()
            for v in variants {
                let vn = self.node(m, v)
                if vn.text == "unit" { continue }
                let kids = vn.kids.clone()
                let is_tuple = vn.text == "tuple"
                for c in kids {
                    let ty_node = if is_tuple { c } else { self.node(m, c).x }
                    let ft = self.resolve_type(m, ty_node, NONE)
                    if self.needs_drop(ft) { return true }
                }
            }
            return false
        }
        if k == TK.Array or k == TK.Opt or k == TK.ErrUnion { return self.needs_drop(self.tys.list[t].args[0]) }
        if k == TK.Tuple {
            let args = self.tys.list[t].args.clone()
            for a in args { if self.needs_drop(a) { return true } }
        }
        return false
    }

    fn is_place(self: *mut Self, e: usize) -> bool {
        let k = self.tir.nodes[e].k
        if k == TKind.Local or k == TKind.Global or k == TKind.RefField or k == TKind.Deref { return true }
        if k == TKind.Field or k == TKind.TupleField { return self.is_place(self.tir.nodes[e].kids[0]) }
        if k == TKind.Index {
            let base = self.tir.nodes[e].kids[0]
            let bt = self.tys.shallow(self.tir.nodes[base].ty)
            if self.tys.kind(bt) == TK.Slice { return true }
            return self.is_place(base)
        }
        return false
    }

    fn place_mutable(self: *mut Self, e: usize) -> bool {
        let k = self.tir.nodes[e].k
        if k == TKind.Local { return self.ctx().locals[self.tir.nodes[e].a].mutable }
        if k == TKind.Global { return true }
        if k == TKind.Field or k == TKind.TupleField { return self.place_mutable(self.tir.nodes[e].kids[0]) }
        if k == TKind.RefField { return true }
        if k == TKind.Index {
            let base = self.tir.nodes[e].kids[0]
            let bt = self.tys.shallow(self.tir.nodes[base].ty)
            if self.tys.kind(bt) == TK.Slice { return self.tys.list[bt].flag }
            return self.place_mutable(base)
        }
        if k == TKind.Deref {
            let p = self.tir.nodes[e].kids[0]
            let pt = self.tys.shallow(self.tir.nodes[p].ty)
            if self.tys.kind(pt) == TK.Ptr { return self.tys.list[pt].flag }
            return false
        }
        return false
    }

    // ----- ownership ------------------------------------------------------------------

    fn take_ownership(self: *mut Self, e: usize) -> usize {
        let t = self.tys.resolve(self.tir.nodes[e].ty, false)
        if !self.needs_drop(t) { return e }
        let k = self.tir.nodes[e].k
        if self.is_ref_like(t) {
            if k == TKind.RefNew or k == TKind.Call or k == TKind.Retained { return e }
            // a fresh reference already owns its count: `@weak(x)`, `w.upgrade()`,
            // and either wrapped into an optional; retaining it again would leak
            if self.is_fresh_ref(e) { return e }
            self.add_effect(EFF_REFCOUNTS, self.tir.nodes[e].start, "copying a reference retains it")
            var r = tblank(TKind.Retained, self.tir.nodes[e].ty, self.tir.nodes[e].start, self.tir.nodes[e].end)
            r.kids.append(e)
            return self.tir.add(r)
        }
        var l = NONE
        if k == TKind.Local {
            l = self.tir.nodes[e].a
        } else if k == TKind.Unwrap or k == TKind.OrElse or k == TKind.Try {
            let inner = self.tir.nodes[e].kids[0]
            if self.tir.nodes[inner].k == TKind.Local { l = self.tir.nodes[inner].a }
        }
        if l != NONE {
            let at = self.tir.nodes[e].start
            let is_param = self.ctx().locals[l].is_param
            let owned = self.ctx().locals[l].owned
            let loop_item = self.ctx().locals[l].loop_item
            let if_let = self.ctx().locals[l].if_let
            let tuple_view = self.ctx().locals[l].tuple_view
            let lname = self.ctx().locals[l].name.clone()
            if is_param and !owned {
                if k == TKind.Local {
                    self.fail_here(at, format("cannot move `{}` out of a parameter; parameters are borrowed", .{lname})[..])
                } else {
                    self.fail_here(at, format("cannot move the `{}` out of the parameter `{}`; parameters are borrowed", .{self.ty_name(t), lname})[..])
                }
            } else if loop_item {
                if k == TKind.Local {
                    self.fail_here(at, format("cannot move `{}` out of a loop; a loop variable is a view of the element", .{lname})[..])
                } else {
                    self.fail_here(at, format("cannot move the `{}` out of the loop variable `{}`; it is a view of the element", .{self.ty_name(t), lname})[..])
                }
            } else if tuple_view {
                if k == TKind.Local {
                    self.fail_here(at, format("cannot move `{}` out of a tuple binding over a place; the name is a view of the element (use `.clone()`, or destructure an owned value)", .{lname})[..])
                } else {
                    self.fail_here(at, format("cannot move the `{}` out of the tuple binding `{}`; it is a view of the element", .{self.ty_name(t), lname})[..])
                }
            } else if if_let {
                if k == TKind.Local {
                    self.fail_here(at, format("cannot move `{}` out of an `if let`; the binding is a view of the optional's payload (use `.clone()`, or take the value with `.?`)", .{lname})[..])
                } else {
                    self.fail_here(at, format("cannot move the `{}` out of the `if let` binding `{}`; it is a view of the optional's payload", .{self.ty_name(t), lname})[..])
                }
            } else {
                self.ctx().moved.put(l, at)
            }
            return e
        }
        if self.is_borrowed_view(e) {
            self.fail_here(self.tir.nodes[e].start, format("cannot move a `{}` out of a field or element", .{self.ty_name(t)})[..])
            self.note(self.cur_module(), self.tir.nodes[e].start, "use `.clone()` for an owned copy")
        }
        return e
    }

    /// A reference the expression itself created, with a count of its own.
    fn is_fresh_ref(self: *mut Self, e: usize) -> bool {
        let k = self.tir.nodes[e].k
        if k == TKind.RefNew or k == TKind.Call or k == TKind.Retained { return true }
        if k == TKind.Builtin { return self.tir.nodes[e].name == "Weak" or self.tir.nodes[e].name == "Upgrade" or self.tir.nodes[e].name == "Clone" or self.tir.nodes[e].name == "Escape" }
        if k == TKind.OptWrap or k == TKind.ErrWrap { return self.is_fresh_ref(self.tir.nodes[e].kids[0]) }
        return false
    }

    /// A field, element, or dereference: a view into something else's storage.
    fn is_borrowed_view(self: *mut Self, e: usize) -> bool {
        let k = self.tir.nodes[e].k
        if k == TKind.Field or k == TKind.RefField or k == TKind.TupleField or k == TKind.Index or k == TKind.Deref { return true }
        if k == TKind.Builtin { return self.tir.nodes[e].name == "MapGet" or self.tir.nodes[e].name == "ListLast" }
        // `return xs[i]` into a `?T` or `!T` wraps the element first; the view is still moved
        if k == TKind.OrElse or k == TKind.Unwrap or k == TKind.Try or k == TKind.OptWrap or k == TKind.ErrWrap {
            return self.is_borrowed_view(self.tir.nodes[e].kids[0])
        }
        return false
    }

    // ----- unification and coercion -------------------------------------------------

    fn unify(self: *mut Self, a0: usize, b0: usize) -> bool {
        let a = self.tys.shallow(a0)
        let b = self.tys.shallow(b0)
        if a == b { return true }
        let ka = self.tys.kind(a)
        let kb = self.tys.kind(b)
        if ka == TK.Infer { return self.bind_infer(self.tys.infer_index(a), b) }
        if kb == TK.Infer { return self.bind_infer(self.tys.infer_index(b), a) }
        if ka == TK.Never or kb == TK.Never { return true }
        if ka != kb { return false }
        let ta = self.tys.list[a].args.clone()
        let tb = self.tys.list[b].args.clone()
        if ka == TK.Struct or ka == TK.Enum {
            if self.tys.list[a].def != self.tys.list[b].def or ta.len != tb.len { return false }
            return self.unify_all(ta[..], tb[..])
        }
        if ka == TK.Array { return self.tys.list[a].n == self.tys.list[b].n and self.unify(ta[0], tb[0]) }
        if ka == TK.Slice or ka == TK.Ptr { return self.tys.list[a].flag == self.tys.list[b].flag and self.unify(ta[0], tb[0]) }
        if ka == TK.Opt or ka == TK.List or ka == TK.Weak { return self.unify(ta[0], tb[0]) }
        if ka == TK.ErrUnion {
            let sa = self.tys.list[a].flag
            let sb = self.tys.list[b].flag
            let same_set = (!sa or !sb) or self.tys.list[a].def == self.tys.list[b].def
            return same_set and self.unify(ta[0], tb[0])
        }
        if ka == TK.Map { return self.unify(ta[0], tb[0]) and self.unify(ta[1], tb[1]) }
        if ka == TK.Fn {
            if ta.len != tb.len { return false }
            let ea = self.tys.list[a].n
            let eb = self.tys.list[b].n
            return self.unify_all(ta[..], tb[..]) and (ea == eb or (ea & eb) == eb)
        }
        if ka == TK.Tuple { return ta.len == tb.len and self.unify_all(ta[..], tb[..]) }
        if ka == TK.ErrorSet { return true }
        if ka == TK.Dyn { return self.tys.list[a].def == self.tys.list[b].def and (self.tys.list[b].n & self.tys.list[a].n) == self.tys.list[a].n }
        if ka == TK.Int or ka == TK.Float { return self.tys.list[a].name == self.tys.list[b].name }
        if ka == TK.Distinct { return self.tys.list[a].def == self.tys.list[b].def }
        return false
    }

    fn unify_all(self: *mut Self, xs: []usize, ys: []usize) -> bool {
        for x, i in xs { if !self.unify(x, ys[i]) { return false } }
        return true
    }

    fn bind_infer(self: *mut Self, n: usize, target0: usize) -> bool {
        let kind = self.tys.infer_kinds[n]
        let target = self.tys.shallow(target0)
        if self.tys.kind(target) == TK.Infer {
            let m = self.tys.infer_index(target)
            if m == n { return true }
            let tk = self.tys.infer_kinds[m]
            var merged = kind
            if kind == INFER_ANY { merged = tk } else if tk == INFER_ANY { merged = kind } else if kind != tk { return false }
            self.tys.infer_kinds[m] = merged
            self.tys.subst[n] = target
            return true
        }
        let tk = self.tys.kind(target)
        var ok = true
        if kind == INFER_INT { ok = tk == TK.Int }
        if kind == INFER_FLOAT { ok = tk == TK.Float }
        if !ok { return false }
        self.tys.subst[n] = target
        return true
    }

    fn retype(self: *mut Self, e: usize, ty: usize) -> usize {
        self.tir.nodes[e].ty = ty
        return e
    }

    fn wrap_node(self: *mut Self, k: TKind, e: usize, ty: usize) -> usize {
        var w = tblank(k, ty, self.tir.nodes[e].start, self.tir.nodes[e].end)
        w.kids.append(e)
        return self.tir.add(w)
    }

    /// Coerce `e` to `target`; NONE when impossible (the expression is untouched).
    fn coerce(self: *mut Self, e: usize, target: usize) -> usize {
        let from = self.tys.shallow(self.tir.nodes[e].ty)
        let to = self.tys.shallow(target)
        if from == to { return e }
        let kf = self.tys.kind(from)
        let kt = self.tys.kind(to)
        if kf == TK.Never { return self.retype(e, target) }
        if kf == TK.Infer or kt == TK.Infer {
            if self.unify(from, to) { return self.retype(e, target) }
            if kt == TK.Opt {
                let inner = self.tys.list[to].args[0]
                let saved_ty = self.tir.nodes[e].ty
                let r = self.coerce(e, inner)
                if r != NONE { return self.wrap_node(TKind.OptWrap, r, target) }
                self.tir.nodes[e].ty = saved_ty
            }
            if kt == TK.ErrUnion {
                let inner = self.tys.list[to].args[0]
                let saved_ty = self.tir.nodes[e].ty
                let r = self.coerce(e, inner)
                if r != NONE { return self.wrap_node(TKind.ErrWrap, r, target) }
                self.tir.nodes[e].ty = saved_ty
            }
            return NONE
        }
        // *String / *List(T) -> a slice: a pointer to an owning value reads as a view of it
        if kf == TK.Ptr and kt == TK.Slice {
            let inner = self.tys.list[from].args[0]
            let ik = self.tys.kind(self.tys.shallow(inner))
            if ik == TK.Str or ik == TK.List {
                let d = self.wrap_node(TKind.Deref, e, inner)
                let r = self.coerce(d, target)
                if r != NONE { return r }
                return NONE
            }
            if ik == TK.Array {
                let ish = self.tys.shallow(inner)
                let e1 = self.tys.list[ish].args[0]
                let e2 = self.tys.list[to].args[0]
                let pm = self.tys.list[from].flag
                let m = self.tys.list[to].flag
                if self.unify(e1, e2) and (!m or pm) {
                    let d = self.wrap_node(TKind.Deref, e, inner)
                    return self.wrap_node(TKind.ArrayToSlice, d, target)
                }
            }
            return NONE
        }
        if kf == TK.Opt and kt == TK.Opt {
            if self.unify(self.tys.list[from].args[0], self.tys.list[to].args[0]) { return self.retype(e, target) }
            return NONE
        }
        if kt == TK.Opt {
            let inner = self.tys.list[to].args[0]
            let r = self.coerce(e, inner)
            if r != NONE { return self.wrap_node(TKind.OptWrap, r, target) }
            return NONE
        }
        if kf == TK.ErrorSet and kt == TK.ErrUnion {
            if self.tir.nodes[e].k == TKind.ErrVal {
                // a named set admits only its own members
                if self.tys.list[to].flag {
                    let s = self.tys.list[to].def
                    let ename = self.error_names[self.tir.nodes[e].a - 1].clone()
                    if !self.error_set_has(s, ename[..]) {
                        self.fail_here(self.tir.nodes[e].start, format("error `{}` is not a member of error set `{}`", .{ename, self.error_sets[s].name})[..])
                    }
                }
                return self.retype(e, target)
            }
            return self.wrap_node(TKind.ErrToUnion, e, target)
        }
        if kf == TK.ErrUnion and kt == TK.ErrUnion {
            // `Set!T` widens into `!T` (and into itself); `!T` never narrows into a named set
            let widening = !self.tys.list[to].flag or (self.tys.list[from].flag and self.tys.list[from].def == self.tys.list[to].def)
            if widening and self.unify(self.tys.list[from].args[0], self.tys.list[to].args[0]) { return self.retype(e, target) }
            return NONE
        }
        if kt == TK.ErrUnion {
            let inner = self.tys.list[to].args[0]
            let r = self.coerce(e, inner)
            if r != NONE { return self.wrap_node(TKind.ErrWrap, r, target) }
            return NONE
        }
        if kf == TK.Array and kt == TK.Slice {
            let e1 = self.tys.list[from].args[0]
            let e2 = self.tys.list[to].args[0]
            if self.unify(e1, e2) {
                if self.tys.list[to].flag and !self.place_mutable(e) and self.is_place(e) { return NONE }
                return self.wrap_node(TKind.ArrayToSlice, e, target)
            }
            return NONE
        }
        if kf == TK.List and kt == TK.Slice {
            let e1 = self.tys.list[from].args[0]
            let e2 = self.tys.list[to].args[0]
            if self.unify(e1, e2) {
                if self.tys.list[to].flag and self.is_place(e) and !self.place_mutable(e) { return NONE }
                return self.wrap_node(TKind.ListToSlice, e, target)
            }
            return NONE
        }
        if kf == TK.Str and kt == TK.Slice {
            let e2 = self.tys.shallow(self.tys.list[to].args[0])
            if self.tys.kind(e2) == TK.Int and self.tys.list[e2].name == "u8" {
                if self.tys.list[to].flag and self.is_place(e) and !self.place_mutable(e) { return NONE }
                return self.wrap_node(TKind.StrToSlice, e, target)
            }
            return NONE
        }
        if kf == TK.Slice and kt == TK.Slice and self.tys.list[from].flag and !self.tys.list[to].flag {
            if self.unify(self.tys.list[from].args[0], self.tys.list[to].args[0]) { return self.retype(e, target) }
            return NONE
        }
        if kf == TK.Ptr and kt == TK.Ptr and self.tys.list[from].flag and !self.tys.list[to].flag {
            if self.unify(self.tys.list[from].args[0], self.tys.list[to].args[0]) { return self.retype(e, target) }
            return NONE
        }
        // *T -> dyn Trait (a fat pointer; the pointee must implement the trait)
        if kf == TK.Ptr and kt == TK.Dyn {
            let inner = self.tys.resolve(self.tys.list[from].args[0], true)
            let trait_id = self.tys.list[to].def
            let tname = self.traits[trait_id].name.clone()
            if !self.type_satisfies_trait(inner, tname[..]) { return NONE }
            let vt = self.vtable_for(trait_id, inner, self.tir.nodes[e].start)
            if vt == NONE { return NONE }
            // every method must satisfy the trait object's negative bounds
            let need_neg = EFF_ALL & ~self.tys.list[to].n
            let vinsts = self.vtables[vt].insts.clone()
            for vi in vinsts { self.oblige(vi, need_neg, self.tir.nodes[e].start) }
            let r = self.wrap_node(TKind.DynFrom, e, target)
            self.tir.nodes[r].a = vt
            return r
        }
        if kf == TK.Fn and kt == TK.Fn {
            let pa = self.tys.list[from].args.clone()
            let pb = self.tys.list[to].args.clone()
            if pa.len == pb.len and self.unify_all(pa[..], pb[..]) {
                // the target may forbid effects the value has
                let need_neg = EFF_ALL & ~self.tys.list[to].n
                if need_neg != 0 {
                    let k = self.tir.nodes[e].k
                    if k == TKind.FnToFat or k == TKind.Closure {
                        self.oblige(self.tir.nodes[e].a, need_neg, self.tir.nodes[e].start)
                    } else if (self.tys.list[from].n & ~self.tys.list[to].n) != 0 {
                        return NONE
                    }
                }
                return self.retype(e, target)
            }
            return NONE
        }
        if self.unify(from, to) { return self.retype(e, target) }
        return NONE
    }

    fn coerce_or_error(self: *mut Self, e: usize, target: usize, what: []u8) -> usize {
        let r = self.coerce(e, target)
        if r != NONE { return r }
        let got = self.ty_name(self.tir.nodes[e].ty)
        let want = self.ty_name(target)
        self.fail_here(self.tir.nodes[e].start, format("type mismatch in {}: expected `{}` but found `{}`", .{what, want, got})[..])
        return self.retype(e, target)
    }

    fn finalize_expr(self: *mut Self, e: usize) -> usize {
        let t = self.tys.resolve(self.tir.nodes[e].ty, true)
        self.tir.nodes[e].ty = t
        return e
    }

    fn mk(self: *mut Self, k: TKind, ty: usize, start: usize, end: usize) -> usize {
        return self.tir.add(tblank(k, ty, start, end))
    }

    fn error_expr(self: *mut Self, start: usize, end: usize) -> usize {
        let n = self.tys.never()
        return self.mk(TKind.Unreachable, n, start, end)
    }

    // ----- ranges ------------------------------------------------------------------------

    fn type_range(self: *mut Self, t0: usize) -> ?Range {
        let t = self.tys.shallow(t0)
        let k = self.tys.kind(t)
        if k == TK.Int {
            let name = self.tys.list[t].name.clone()
            return Range{ .lo = int_min(name[..]), .hi = int_max(name[..]) }
        }
        if k == TK.Bool { return Range{ .lo = 0, .hi = 1 } }
        if k == TK.Char { return Range{ .lo = 0, .hi = 0x10FFFF } }
        return null
    }

    fn expr_range(self: *mut Self, e: usize) -> ?Range {
        let k = self.tir.nodes[e].k
        if k == TKind.Int or k == TKind.Char { return Range{ .lo = self.tir.nodes[e].ival, .hi = self.tir.nodes[e].ival } }
        if k == TKind.Bool {
            let v: i128 = if self.tir.nodes[e].flag { 1 } else { 0 }
            return Range{ .lo = v, .hi = v }
        }
        if k == TKind.Value and self.tir.nodes[e].name == "int" { return Range{ .lo = self.tir.nodes[e].ival, .hi = self.tir.nodes[e].ival } }
        if k == TKind.Local {
            let l = self.tir.nodes[e].a
            if let r = self.ctx().ranges.get(l) { return r }
            return self.type_range(self.ctx().locals[l].ty)
        }
        if k == TKind.Cast and self.tir.nodes[e].name.len >= 10 and self.tir.nodes[e].name[0..10] == "int_to_int" {
            let inner = self.expr_range(self.tir.nodes[e].kids[0]) orelse return null
            let tr = self.type_range(self.tir.nodes[e].ty) orelse return null
            return Range{ .lo = max128(inner.lo, tr.lo), .hi = min128(inner.hi, tr.hi) }
        }
        if k == TKind.Binary {
            let op = self.tir.nodes[e].text.clone()
            let a = self.expr_range(self.tir.nodes[e].kids[0]) orelse return null
            let b = self.expr_range(self.tir.nodes[e].kids[1]) orelse return null
            var r = Range{ .lo = 0, .hi = 0 }
            var known = true
            if op == "+" or op == "+%" or op == "+|" {
                r = Range{ .lo = sat_add(a.lo, b.lo), .hi = sat_add(a.hi, b.hi) }
            } else if op == "-" or op == "-%" or op == "-|" {
                r = Range{ .lo = sat_sub(a.lo, b.hi), .hi = sat_sub(a.hi, b.lo) }
            } else if op == "*" or op == "*%" or op == "*|" {
                let c0 = sat_mul(a.lo, b.lo)
                let c1 = sat_mul(a.lo, b.hi)
                let c2 = sat_mul(a.hi, b.lo)
                let c3 = sat_mul(a.hi, b.hi)
                r = Range{ .lo = min128(min128(c0, c1), min128(c2, c3)), .hi = max128(max128(c0, c1), max128(c2, c3)) }
            } else if op == "%" and b.lo > 0 {
                r = Range{ .lo = max128(0, min128(a.lo, 0)), .hi = min128(b.hi - 1, max128(a.hi, 0)) }
            } else if op == "/" and b.lo > 0 {
                r = Range{ .lo = min128(min128(a.lo, 0), a.lo / b.lo), .hi = max128(max128(a.hi, 0), a.hi / b.lo) }
            } else if op == "&" and b.lo >= 0 and a.lo >= 0 {
                r = Range{ .lo = 0, .hi = min128(a.hi, b.hi) }
            } else if op == ">>" and a.lo >= 0 and b.lo >= 0 {
                r = Range{ .lo = a.lo >> (min128(b.hi, 127) as u32), .hi = a.hi >> (min128(b.lo, 127) as u32) }
            } else {
                known = false
            }
            if !known { return self.type_range(self.tir.nodes[e].ty) }
            let wrapping = op == "+%" or op == "-%" or op == "*%" or op == "+|" or op == "-|" or op == "*|"
            if wrapping {
                if let tr = self.type_range(self.tir.nodes[e].ty) {
                    return Range{ .lo = max128(r.lo, tr.lo), .hi = min128(r.hi, tr.hi) }
                }
            }
            return r
        }
        // `@min(a, b)` / `@max(a, b)`: the smaller (larger) of the ends
        if k == TKind.Builtin and (self.tir.nodes[e].name == "MathMin" or self.tir.nodes[e].name == "MathMax") and self.tir.nodes[e].kids.len == 2 {
            if let a = self.expr_range(self.tir.nodes[e].kids[0]) {
                if let b = self.expr_range(self.tir.nodes[e].kids[1]) {
                    if self.tir.nodes[e].name == "MathMin" { return Range{ .lo = min128(a.lo, b.lo), .hi = min128(a.hi, b.hi) } }
                    return Range{ .lo = max128(a.lo, b.lo), .hi = max128(a.hi, b.hi) }
                }
            }
        }
        if k == TKind.Builtin and self.tir.nodes[e].name == "Len" {
            let arg = self.tir.nodes[e].kids[0]
            let at = self.tys.shallow(self.tir.nodes[arg].ty)
            if self.tys.kind(at) == TK.Array {
                let n = self.tys.list[at].n as i128
                return Range{ .lo = n, .hi = n }
            }
            // a slice with a proven least length
            if self.tir.nodes[arg].k == TKind.Local {
                if let m = self.ctx().min_len.get(self.tir.nodes[arg].a) { return Range{ .lo = m.lo, .hi = 170141183460469231731687303715884105727 } }
            }
            return Range{ .lo = 0, .hi = 170141183460469231731687303715884105727 }
        }
        return self.type_range(self.tir.nodes[e].ty)
    }

    /// The range of a checked operation before clamping to its type: null on overflow of i128.
    fn expr_range_raw(self: *mut Self, e: usize) -> ?Range {
        if self.tir.nodes[e].k != TKind.Binary { return self.expr_range(e) }
        let op = self.tir.nodes[e].text.clone()
        let a = self.expr_range(self.tir.nodes[e].kids[0]) orelse return null
        let b = self.expr_range(self.tir.nodes[e].kids[1]) orelse return null
        if op == "+" {
            let lo = checked_add(a.lo, b.lo) orelse return null
            let hi = checked_add(a.hi, b.hi) orelse return null
            return Range{ .lo = lo, .hi = hi }
        }
        if op == "-" {
            let lo = checked_sub(a.lo, b.hi) orelse return null
            let hi = checked_sub(a.hi, b.lo) orelse return null
            return Range{ .lo = lo, .hi = hi }
        }
        if op == "*" {
            let c0 = checked_mul(a.lo, b.lo) orelse return null
            let c1 = checked_mul(a.lo, b.hi) orelse return null
            let c2 = checked_mul(a.hi, b.lo) orelse return null
            let c3 = checked_mul(a.hi, b.hi) orelse return null
            return Range{ .lo = min128(min128(c0, c1), min128(c2, c3)), .hi = max128(max128(c0, c1), max128(c2, c3)) }
        }
        if op == "/" and b.lo > 0 { return Range{ .lo = min128(a.lo, 0), .hi = max128(a.hi, 0) } }
        if op == "%" and b.lo > 0 { return Range{ .lo = min128(a.lo, 0), .hi = min128(b.hi - 1, max128(a.hi, 0)) } }
        return null
    }
}

// ---------------------------------------------------------------- environments, facts and origins

pub struct EnvSave {
    names: List(String)
    tys: List(usize)
}

pub struct Narrowing {
    local: usize
    lo: i128
    hi: i128
}

/// What a guard proves: ranges, `!= 0`, `!= null`, least slice lengths, and
/// indices below a slice's length.
pub struct Facts {
    ranges: List(Narrowing)
    nonzero: List(usize)
    nonnull: List(usize)
    min_len: List(Narrowing)
    below: List((usize, usize))
}

/// The facts of a function context, saved before a branch and restored after.
pub struct FactState {
    ranges: Map(usize, Range)
    nonzero: List(usize)
    nonnull: List(usize)
    min_len: Map(usize, Range)
    index_of: Map(usize, usize)
}

/// Both hold: ranges intersect, the rest unite.
pub fn facts_both(l: *Facts, r: *Facts) -> Facts {
    var out = Facts{ .ranges = List(Narrowing).new(), .nonzero = List(usize).new(), .nonnull = List(usize).new(), .min_len = List(Narrowing).new(), .below = List((usize, usize)).new() }
    for x in l.ranges { out.ranges.append(Narrowing{ .local = x.local, .lo = x.lo, .hi = x.hi }) }
    for x in r.ranges {
        var found = false
        for j in 0..out.ranges.len {
            if out.ranges[j].local == x.local {
                out.ranges[j].lo = max128(out.ranges[j].lo, x.lo)
                out.ranges[j].hi = min128(out.ranges[j].hi, x.hi)
                found = true
            }
        }
        if !found { out.ranges.append(Narrowing{ .local = x.local, .lo = x.lo, .hi = x.hi }) }
    }
    var kept = List(Narrowing).new()
    for x in out.ranges { if x.lo <= x.hi { kept.append(Narrowing{ .local = x.local, .lo = x.lo, .hi = x.hi }) } }
    out.ranges = kept
    for v in l.nonzero { out.nonzero.append(v) }
    for v in r.nonzero { if !has_local(&out.nonzero, v) { out.nonzero.append(v) } }
    for v in l.nonnull { out.nonnull.append(v) }
    for v in r.nonnull { if !has_local(&out.nonnull, v) { out.nonnull.append(v) } }
    for x in l.min_len { out.min_len.append(Narrowing{ .local = x.local, .lo = x.lo, .hi = x.hi }) }
    for x in r.min_len {
        var found = false
        for j in 0..out.min_len.len {
            if out.min_len[j].local == x.local {
                if x.lo > out.min_len[j].lo { out.min_len[j].lo = x.lo; out.min_len[j].hi = x.lo }
                found = true
            }
        }
        if !found { out.min_len.append(Narrowing{ .local = x.local, .lo = x.lo, .hi = x.hi }) }
    }
    for p in l.below { out.below.append(p) }
    for p in r.below { out.below.append(p) }
    return out
}

pub fn name_index(names: *List(String), name: []u8) -> ?usize {
    for n, i in names.* { if n[..] == name { return i } }
    return null
}

/// An origin joins a list once.
pub fn add_origin(out: *mut List(Origin), local: usize, at: usize) { add_origin_h(out, local, at, false) }

pub fn add_origin_h(out: *mut List(Origin), local: usize, at: usize, heap: bool) { add_origin_f(out, local, at, heap, NONE) }

pub fn add_origin_f(out: *mut List(Origin), local: usize, at: usize, heap: bool, field: usize) {
    for i in 0..out.len {
        if out[i].local == local {
            // the same local through another field: the whole value from now on
            if out[i].field != field { out[i].field = NONE }
            return
        }
    }
    out.append(Origin{ .local = local, .taken_at = at, .heap = heap, .field = field })
}

pub fn add_origins(out: *mut List(Origin), more: *List(Origin)) {
    for o in more.* { add_origin_f(out, o.local, o.taken_at, o.heap, o.field) }
}

pub fn has_local(xs: *List(usize), v: usize) -> bool {
    for x in xs.* { if x == v { return true } }
    return false
}

pub fn drop_local(xs: *mut List(usize), v: usize) {
    var i: usize = 0
    while i < xs.len {
        if xs[i] == v { _ = xs.remove(i) } else { i += 1 }
    }
}

/// The comparison that holds when this one does not.
pub fn flip_cmp(op: []u8) -> String {
    if op == "<" { return String.from(">=") }
    if op == ">=" { return String.from("<") }
    if op == "<=" { return String.from(">") }
    if op == ">" { return String.from("<=") }
    if op == "==" { return String.from("!=") }
    if op == "!=" { return String.from("==") }
    return String.from(op)
}

/// The comparison with its sides swapped.
pub fn mirror_cmp(op: []u8) -> String {
    if op == "<" { return String.from(">") }
    if op == ">" { return String.from("<") }
    if op == "<=" { return String.from(">=") }
    if op == ">=" { return String.from("<=") }
    return String.from(op)
}

pub fn min128(a: i128, b: i128) -> i128 { return if a < b { a } else { b } }
pub fn max128(a: i128, b: i128) -> i128 { return if a > b { a } else { b } }
fn sat_add(a: i128, b: i128) -> i128 { return a +| b }
fn sat_sub(a: i128, b: i128) -> i128 { return a -| b }
fn sat_mul(a: i128, b: i128) -> i128 { return a *| b }
pub fn checked_add(a: i128, b: i128) -> ?i128 {
    let r = a +| b
    if r != a +% b { return null }
    return r
}
pub fn checked_sub(a: i128, b: i128) -> ?i128 {
    let r = a -| b
    if r != a -% b { return null }
    return r
}
pub fn checked_mul(a: i128, b: i128) -> ?i128 {
    let r = a *| b
    if r != a *% b { return null }
    return r
}

// ---------------------------------------------------------------- a new checker, and check.nx as a program

pub fn new_checker(own mods: List(Mod)) -> Checker {
    return Checker{
        .mods = mods, .tys = Types{ .list = List(Ty).new(), .index = Map(String, usize).new(), .subst = List(usize).new(), .infer_kinds = List(u8).new() },
        .items = Map(String, ItemRef).new(), .imports = Map(String, ImportRef).new(),
        .structs = List(StructDef).new(), .enums = List(EnumDef).new(), .traits = List(TraitDef).new(),
        .impls = List(ImplDef).new(), .fns = List(FnDef).new(), .consts = List(ConstDef).new(),
        .globals = List(GlobalDef).new(), .aliases = List(AliasDef).new(), .error_sets = List(ErrorSetDef).new(),
        .errors = List(String).new(), .warnings = List(String).new(), .fixes = List(Fix).new(), .open_lits = List(usize).new(), .open_lit_mods = List(usize).new(), .view_cache = Map(usize, u8).new(), .closure_caps = Map(usize, List(usize)).new(), .diags = List(Diag).new(), .error_names = List(String).new(), .error_ids = Map(String, usize).new(),
        .insts = List(Inst).new(), .inst_map = Map(String, usize).new(), .queue = List(usize).new(), .tir = Tir{ .nodes = List(T).new() },
        .ctxs = List(FnCtx).new(), .main_inst = NONE, .tests = List(usize).new(), .benches = List(usize).new(),
        .env_names = List(String).new(), .env_tys = List(usize).new(),
        .record_new_mode = false, .vtables = List(VTable).new(), .obligations = List(Obligation).new(),
        .parallel_calls = List(Obligation).new(), .global_uses = List(Obligation).new(), .global_use_fns = List(String).new(), .artifact_kinds = List(String).new(), .wild_pat_node = NONE,
        .cc = List(String).new(), .target = String.new(), .cimport_headers = List(String).new(), .cimport_system = List(bool).new(), .cimport_unsupported = Map(String, String).new(),
        .values = List(check_interp.CV).new(), .repl_mode = false, .play_mode = false, .chain_locals = List(usize).new(), .pending_stmts = List(usize).new(), .clone_seen = List(usize).new(),
        .it_steps = 0, .it_panic = String.new(), .it_panic_at = NONE, .it_has_panic = false, .it_budget = false,
        .it_pending = 0, .it_pending_label = NONE, .it_pending_val = check_interp.cv_none(), .it_failed_at = NONE, .it_where = NONE, .it_root_at = NONE, .it_kept = List(check_interp.CV).new(), .it_heap = List(check_interp.CV).new(), .it_depth_limit = check_interp.CALL_DEPTH,
        .frames = List(check_interp.Frame).new(), .it_cur_fn = NONE, .it_out = check_interp.cv_none(), .it_flow_val = check_interp.cv_none(), .it_flow_label = NONE,
        .cv_bad = check_interp.cv_none(),
    }
}

fn main() -> !void {
    let args = os.args()
    if args.len < 2 {
        eprintln("usage: check <file.nx> [--std <dir>]", .{})
        os.exit(2)
    }
    var std_dir: []u8 = "std"
    var i: usize = 2
    while i < args.len {
        if args[i] == "--std" and i + 1 < args.len {
            std_dir = args[i + 1]
            i += 2
        } else {
            i += 1
        }
    }
    var sigs = false
    var cc_text = String.new()
    var target = String.new()
    i = 2
    while i < args.len {
        if args[i] == "--sigs" { sigs = true }
        if args[i] == "--cc" and i + 1 < args.len { cc_text = String.from(args[i + 1]); i += 1 }
        if args[i] == "--target" and i + 1 < args.len { target = String.from(args[i + 1]); i += 1 }
        i += 1
    }
    if cc_text.len == 0 { if let v = os.env("NX_CC") { cc_text = String.from(v) } }
    var cc = List(String).new()
    if cc_text.len > 0 {
        for w in cc_text[..].split(" ") { if w.len > 0 { cc.append(String.from(w)) } }
    } else if let z = os.env("NX_ZIG") {
        cc.append(String.from(z))
        cc.append(String.from("cc"))
    } else {
        cc.append(String.from("zig"))
        cc.append(String.from("cc"))
    }
    let mods = try load(args[1], std_dir)
    var c = new_checker(mods)
    c.cc = cc
    c.target = target
    c.collect()
    c.reserve_errors()
    var out = String.new()
    if sigs {
        c.resolve_globals()
        c.print_sigs(&mut out)
    } else {
        c.check_program()
        c.print_program(&mut out)
    }
    print("{}", .{out})
    print_errors(&c.errors)
    if c.errors.len > 0 { os.exit(1) }
}
