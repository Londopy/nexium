// self/check.nx: the checker written in Nexium, stage 1 of the port
// (roadmap phase 4). This stage loads the modules the way the Rust driver
// does, collects every declaration, interns types, resolves the signatures
// of non-generic functions and the types of constants and globals, and
// prints them in the shape of `nx tir --sigs`, which `cargo test` diffs.
//
//     nx run self/check.nx examples/tour.nx [--std std]
//
// Later stages add statements and expressions (the full `nx tir` shape),
// effects, ownership, and monomorphization.

import lexer
import parser
import cimport

const NONE: usize = 0xFFFFFFFFFFFFFFFF
const NONE_NAME: []u8 = ""

const BUILTIN_NAMESPACES = ["math", "io", "os", "time", "random", "fmt", "utf8", "ascii", "mem", "slice", "process", "test", "alloc", "net", "thread", "sync"]
const EFFECT_NAMES = ["allocates", "refcounts", "blocks", "shared_mutable", "nondeterministic", "panics", "ffi", "unbounded_stack"]
const INT_NAMES = ["i8", "i16", "i32", "i64", "i128", "isize", "u8", "u16", "u32", "u64", "u128", "usize"]

// ---------------------------------------------------------------- types

pub enum TK {
    Int, Float, Bool, Char, Void, Never,
    Struct, Enum, Array, Slice, Ptr, Opt, ErrUnion, Fn, Tuple, Distinct, Weak, List, Str, Map, Type, ErrorSet, Dyn, Infer,
}

/// One interned type. `name` is the primitive's spelling (`i32`, `f64`),
/// `def` a definition index, `n` an array length or an effect mask,
/// `flag` mutability (slices, pointers) or "has an error set", and
/// `args` the element, parameter, or argument types.
pub struct Ty {
    k: TK
    name: String
    def: usize
    n: u64
    flag: bool
    args: List(usize)
}

fn tk_tag(k: TK) -> u8 {
    match k {
        .Int => 0, .Float => 1, .Bool => 2, .Char => 3, .Void => 4, .Never => 5,
        .Struct => 6, .Enum => 7, .Array => 8, .Slice => 9, .Ptr => 10, .Opt => 11, .ErrUnion => 12,
        .Fn => 13, .Tuple => 14, .Distinct => 15, .Weak => 16, .List => 17, .Str => 18, .Map => 19,
        .Type => 20, .ErrorSet => 21, .Dyn => 22, .Infer => 23,
    }
}

pub struct Types {
    list: List(Ty)
    index: Map(String, usize)
    // inference variables: what each is bound to (NONE while open) and its
    // kind (0 any, 1 integer literal, 2 float literal)
    subst: List(usize)
    infer_kinds: List(u8)
}

const INFER_ANY: u8 = 0
const INFER_INT: u8 = 1
const INFER_FLOAT: u8 = 2

impl Types {
    fn key(t: *Ty) -> String {
        var k = format("{}:{}:{}:{}:{}:", .{tk_tag(t.k), t.name, t.def, t.n, t.flag})
        for a in t.args { k.append(format("{},", .{a})) }
        return k
    }

    fn intern(self: *mut Self, own t: Ty) -> usize {
        let k = Types.key(&t)
        if let id = self.index.get(k[..]) { return id }
        self.list.append(t)
        let id = self.list.len - 1
        self.index.put(k, id)
        return id
    }

    fn simple(self: *mut Self, k: TK) -> usize {
        return self.intern(Ty{ .k = k, .name = String.new(), .def = 0, .n = 0, .flag = false, .args = List(usize).new() })
    }
    fn named(self: *mut Self, k: TK, name: []u8) -> usize {
        return self.intern(Ty{ .k = k, .name = String.from(name), .def = 0, .n = 0, .flag = false, .args = List(usize).new() })
    }
    fn of_def(self: *mut Self, k: TK, def: usize, own args: List(usize)) -> usize {
        return self.intern(Ty{ .k = k, .name = String.new(), .def = def, .n = 0, .flag = false, .args = args })
    }
    fn wrap(self: *mut Self, k: TK, elem: usize, flag: bool) -> usize {
        var args = List(usize).new()
        args.append(elem)
        return self.intern(Ty{ .k = k, .name = String.new(), .def = 0, .n = 0, .flag = flag, .args = args })
    }
    fn array(self: *mut Self, n: u64, elem: usize) -> usize {
        var args = List(usize).new()
        args.append(elem)
        return self.intern(Ty{ .k = TK.Array, .name = String.new(), .def = 0, .n = n, .flag = false, .args = args })
    }
    fn err_union(self: *mut Self, set: usize, has_set: bool, elem: usize) -> usize {
        var args = List(usize).new()
        args.append(elem)
        return self.intern(Ty{ .k = TK.ErrUnion, .name = String.new(), .def = set, .n = 0, .flag = has_set, .args = args })
    }
    fn map(self: *mut Self, key: usize, value: usize) -> usize {
        var args = List(usize).new()
        args.append(key)
        args.append(value)
        return self.intern(Ty{ .k = TK.Map, .name = String.new(), .def = 0, .n = 0, .flag = false, .args = args })
    }
    /// `fn(params) -> ret` with the permitted effect mask in `n`; the return
    /// type is the last argument.
    fn func(self: *mut Self, own params: List(usize), ret: usize, effects: u64) -> usize {
        var args = params
        args.append(ret)
        return self.intern(Ty{ .k = TK.Fn, .name = String.new(), .def = 0, .n = effects, .flag = false, .args = args })
    }
    fn dyn_of(self: *mut Self, trait_id: usize, effects: u64) -> usize {
        return self.intern(Ty{ .k = TK.Dyn, .name = String.new(), .def = trait_id, .n = effects, .flag = false, .args = List(usize).new() })
    }
    fn tuple(self: *mut Self, own ts: List(usize)) -> usize {
        return self.intern(Ty{ .k = TK.Tuple, .name = String.new(), .def = 0, .n = 0, .flag = false, .args = ts })
    }
    fn int(self: *mut Self, name: []u8) -> usize { return self.named(TK.Int, name) }
    fn float64(self: *mut Self) -> usize { return self.named(TK.Float, "f64") }
    fn void(self: *mut Self) -> usize { return self.simple(TK.Void) }
    fn never(self: *mut Self) -> usize { return self.simple(TK.Never) }
    fn bool_ty(self: *mut Self) -> usize { return self.simple(TK.Bool) }
    fn char_ty(self: *mut Self) -> usize { return self.simple(TK.Char) }
    fn usize_ty(self: *mut Self) -> usize { return self.named(TK.Int, "usize") }
    fn u8_ty(self: *mut Self) -> usize { return self.named(TK.Int, "u8") }
    fn str_slice(self: *mut Self) -> usize {
        let u = self.u8_ty()
        return self.wrap(TK.Slice, u, false)
    }
    fn string(self: *mut Self) -> usize { return self.simple(TK.Str) }
    fn type_ty(self: *mut Self) -> usize { return self.simple(TK.Type) }

    /// A fresh inference variable of the given kind; `n` holds its index.
    fn fresh_infer_kind(self: *mut Self, kind: u8) -> usize {
        let n = self.subst.len
        self.subst.append(NONE)
        self.infer_kinds.append(kind)
        return self.intern(Ty{ .k = TK.Infer, .name = String.new(), .def = 0, .n = n as u64, .flag = false, .args = List(usize).new() })
    }
    fn fresh_infer(self: *mut Self) -> usize { return self.fresh_infer_kind(INFER_ANY) }
    fn int_lit(self: *mut Self) -> usize { return self.fresh_infer_kind(INFER_INT) }
    fn float_lit(self: *mut Self) -> usize { return self.fresh_infer_kind(INFER_FLOAT) }

    fn kind(self: *Self, t: usize) -> TK { return self.list[t].k }
    fn infer_index(self: *Self, t: usize) -> usize { return self.list[t].n as usize }

    /// Follow inference bindings to the representative type.
    fn shallow(self: *Self, t0: usize) -> usize {
        var t = t0
        while self.list[t].k == TK.Infer {
            let b = self.subst[self.list[t].n as usize]
            if b == NONE { return t }
            t = b
        }
        return t
    }

    fn infer_kind_of(self: *Self, t: usize) -> ?u8 {
        let s = self.shallow(t)
        if self.list[s].k != TK.Infer { return null }
        return self.infer_kinds[self.list[s].n as usize]
    }

    fn is_integer(self: *Self, t: usize) -> bool {
        let s = self.shallow(t)
        if self.list[s].k == TK.Int { return true }
        if let k = self.infer_kind_of(s) { return k == INFER_INT }
        return false
    }
    fn is_float(self: *Self, t: usize) -> bool {
        let s = self.shallow(t)
        if self.list[s].k == TK.Float { return true }
        if let k = self.infer_kind_of(s) { return k == INFER_FLOAT }
        return false
    }
    fn is_numeric(self: *Self, t: usize) -> bool { return self.is_integer(t) or self.is_float(t) }

    /// Fully resolve a type, substituting bound inference variables and
    /// defaulting open literals (`i64`, `f64`) when `default_lits` is set.
    fn resolve(self: *mut Self, t0: usize, default_lits: bool) -> usize {
        let t = self.shallow(t0)
        let k = self.list[t].k
        if k == TK.Infer {
            if !default_lits { return t }
            let n = self.list[t].n as usize
            let ik = self.infer_kinds[n]
            if ik == INFER_INT {
                let r = self.int("i64")
                self.subst[n] = r
                return r
            }
            if ik == INFER_FLOAT {
                let r = self.float64()
                self.subst[n] = r
                return r
            }
            return t
        }
        if self.list[t].args.len == 0 { return t }
        var copy = Ty{ .k = k, .name = self.list[t].name.clone(), .def = self.list[t].def, .n = self.list[t].n, .flag = self.list[t].flag, .args = List(usize).new() }
        let args = self.list[t].args.clone()
        for a in args { copy.args.append(self.resolve(a, default_lits)) }
        return self.intern(copy)
    }

    fn contains_infer(self: *Self, t0: usize) -> bool {
        let t = self.shallow(t0)
        if self.list[t].k == TK.Infer { return true }
        for a in self.list[t].args { if self.contains_infer(a) { return true } }
        return false
    }
}

/// Integer type facts by name.
pub fn int_bits(name: []u8) -> u32 {
    if name == "i8" or name == "u8" { return 8 }
    if name == "i16" or name == "u16" { return 16 }
    if name == "i32" or name == "u32" { return 32 }
    if name == "i128" or name == "u128" { return 128 }
    return 64
}
pub fn int_signed(name: []u8) -> bool { return name[0] == 'i' }
pub fn int_min(name: []u8) -> i128 {
    if !int_signed(name) { return 0 }
    if name == "i128" { return -170141183460469231731687303715884105727 - 1 }
    return - ((1 as i128) << (int_bits(name) - 1))
}
pub fn int_max(name: []u8) -> i128 {
    if name == "i128" { return 170141183460469231731687303715884105727 }
    if name == "u128" { return 170141183460469231731687303715884105727 }
    if int_signed(name) { return ((1 as i128) << (int_bits(name) - 1)) - 1 }
    return ((1 as i128) << int_bits(name)) - 1
}

fn effect_bit(name: []u8) -> u64 {
    for e, i in EFFECT_NAMES { if e == name { return (1 as u64) << (i as u64) } }
    return 0
}

/// `!allocates !panics`: the effects a mask does not permit.
fn render_negative(mask: u64) -> String {
    var out = String.new()
    for e, i in EFFECT_NAMES {
        if (mask & ((1 as u64) << (i as u64))) == 0 {
            if out.len > 0 { out.append(" ") }
            out.append("!")
            out.append(e)
        }
    }
    return out
}

/// The effects present in a mask, `allocates panics`.
fn render_effects(mask: u64) -> String {
    var out = String.new()
    for e, i in EFFECT_NAMES {
        if (mask & ((1 as u64) << (i as u64))) != 0 {
            if out.len > 0 { out.append(" ") }
            out.append(e)
        }
    }
    return out
}

// ---------------------------------------------------------------- definitions

/// What a name in a module refers to.
pub enum ItemKind { Fn, Struct, Enum, Trait, Const, Global, Alias, ErrorSet, Module }

pub struct ItemRef {
    kind: ItemKind
    id: usize
}

pub struct StructDef {
    name: String
    kind: String
    layout: String
    // the C spelling of an imported struct (`struct tag` or a typedef name), else empty
    c_name: String
    tparams: List(String)
    derives: List(String)
    fields: List(usize)
    module: usize
    start: usize
    end: usize
    is_pub: bool
}

pub struct EnumDef {
    name: String
    tparams: List(String)
    derives: List(String)
    variants: List(usize)
    module: usize
    start: usize
    end: usize
}

pub struct TraitDef {
    name: String
    methods: List(usize)
    assoc: List(String)
    module: usize
    start: usize
    end: usize
}

pub struct ImplDef {
    trait_name: String
    has_trait: bool
    target: usize
    tparams: List(String)
    methods: List(usize)
    module: usize
}

/// A function value used where its type forbids effects: checked once every
/// body is known and effects have propagated.
pub struct Obligation {
    inst: usize
    neg: u64
    at: usize
    module: usize
}

/// A trait's method table for one concrete type: the instances in trait
/// declaration order. Indexed by `DynFrom`.
pub struct VTable {
    trait_id: usize
    ty: usize
    insts: List(usize)
}

/// A function declaration: the node (in its module's tree), its module,
/// the impl it belongs to (or NONE), and whether it is generic.
pub struct FnDef {
    node: usize
    // the module whose tree holds `node` (a trait default lives in the trait's module)
    node_module: usize
    module: usize
    impl_id: usize
    is_generic: bool
    is_test: bool
    test_name: String
    test_comptime: bool
}

pub struct ConstDef {
    name: String
    node: usize
    module: usize
    start: usize
    end: usize
    is_pub: bool
    ty: usize
    in_progress: bool
    // the checked initializer (a TIR node), once resolved
    value: usize
}

pub struct GlobalDef {
    name: String
    node: usize
    module: usize
    start: usize
    end: usize
    ty: usize
    // the evaluated initializer, a `(value ...)` node (NONE when absent)
    init: usize
}

pub struct AliasDef {
    name: String
    node: usize
    is_distinct: bool
    module: usize
    start: usize
    end: usize
    // the type, once first used (NONE before)
    resolved: usize
}

pub struct ErrorSetDef {
    name: String
    module: usize
}

pub struct ImportRef {
    module: usize
    name: String
    has_name: bool
}

/// A loaded module: its name as the driver spells it, and its parse.
pub struct Mod {
    name: String
    source: String
    // the directory its relative paths (`@embedFile`) resolve against
    dir: String
    // the path diagnostics and generated code name it by (`<std>/x.nx` for std)
    path: String
    parsed: parser.Parsed
}

// ---------------------------------------------------------------- loading

/// Read the root file and everything it imports, in the driver's order:
/// files depth-first from a stack (so the last import of a file loads
/// first), then the std modules in the order they were first named.
pub fn load(root: []u8, std_dir: []u8) -> !List(Mod) {
    var mods = List(Mod).new()
    let root_dir = dir_of(root)
    let root_name = stem_of(root)
    var queue = List(String).new()
    var queue_paths = List(String).new()
    queue.append(String.from(root_name))
    queue_paths.append(String.from(root))
    var seen = Map(String, bool).new()
    var std_pending = List(String).new()
    while queue.len > 0 {
        let name = queue.pop() orelse break
        let path = queue_paths.pop() orelse break
        if seen.contains(name[..]) { continue }
        seen.put(name.clone(), true)
        let text = io.read_file(path[..]) catch {
            eprintln("error: cannot read {}", .{path})
            return error.NotFound
        }
        let parsed = parser.parse_source(text[..])
        if parsed.errors.len > 0 {
            for e in parsed.errors { eprintln("{}: {}", .{path, e}) }
            return error.InvalidInput
        }
        for it in parsed.items {
            let n = &parsed.tree.nodes[it]
            if n.k != parser.NodeKind.Import { continue }
            var words = List(String).new()
            for w in n.words {
                if w == "+" { break }
                words.append(w.clone())
            }
            if words[0] == "std" {
                if words.len == 2 and io.file_kind(format("{}/{}.nx", .{std_dir, words[1]})[..]) == 1 {
                    let mname = format("std.{}", .{words[1]})
                    if !list_has(&std_pending, mname[..]) { std_pending.append(mname) }
                }
                continue
            }
            var rel = String.from(root_dir)
            for w, i in words {
                if i > 0 or rel.len > 0 { rel.append("/") }
                rel.append(w)
            }
            rel.append(".nx")
            if io.file_kind(rel[..]) == 1 {
                queue.append(join_words(&words, "."))
                queue_paths.append(rel)
            }
        }
        mods.append(Mod{ .name = name, .source = text, .dir = String.from(dir_of(path[..])), .path = path.clone(), .parsed = parsed })
    }
    var si: usize = 0
    while si < std_pending.len {
        let mname = std_pending[si].clone()
        si += 1
        let short = mname[4..]
        let path = format("{}/{}.nx", .{std_dir, short})
        let text = io.read_file(path[..]) catch {
            eprintln("error: cannot read {}", .{path})
            return error.NotFound
        }
        let parsed = parser.parse_source(text[..])
        if parsed.errors.len > 0 {
            for e in parsed.errors { eprintln("{}: {}", .{path, e}) }
            return error.InvalidInput
        }
        for it in parsed.items {
            let n = &parsed.tree.nodes[it]
            if n.k != parser.NodeKind.Import { continue }
            if n.words.len >= 2 and n.words[0] == "std" and n.words[1] != "+" {
                let dep = format("std.{}", .{n.words[1]})
                if io.file_kind(format("{}/{}.nx", .{std_dir, n.words[1]})[..]) == 1 and !list_has(&std_pending, dep[..]) {
                    std_pending.append(dep)
                }
            }
        }
        mods.append(Mod{ .name = mname, .source = text, .dir = String.from(std_dir), .path = format("<std>/{}.nx", .{short}), .parsed = parsed })
    }
    return mods
}

fn list_has(xs: *List(String), s: []u8) -> bool {
    for x in xs { if x == s { return true } }
    return false
}

fn join_words(ws: *List(String), sep: []u8) -> String {
    var out = String.new()
    for w, i in ws {
        if i > 0 { out.append(sep) }
        out.append(w)
    }
    return out
}

fn dir_of(path: []u8) -> []u8 {
    var i = path.len
    while i > 0 {
        if path[i - 1] == '/' or path[i - 1] == '\\' { return path[0..i - 1] }
        i -= 1
    }
    return path[0..0]
}

fn stem_of(path: []u8) -> []u8 {
    var start: usize = 0
    var i = path.len
    while i > 0 {
        if path[i - 1] == '/' or path[i - 1] == '\\' { start = i; break }
        i -= 1
    }
    var end = path.len
    var j = path.len
    while j > start {
        if path[j - 1] == '.' { end = j - 1; break }
        j -= 1
    }
    return path[start..end]
}

// ---------------------------------------------------------------- the typed IR

/// Every typed node lives in one arena; `k` picks the meaning of the fields,
/// mirroring the Rust `TStmt`/`TExpr`/`TBlock`/`TPat`.
pub enum TKind {
    // statements
    SLet, SAssign, SExpr, SReturn, SBreak, SContinue, SDefer, SErrDefer, SWhile, SForRange, SForSlice, SBlock, SDrop, SUsing,
    // blocks
    Block,
    // expressions
    Int, Float, Bool, Char, Str, Unit, Local, Global, Const, FnRef, Field, RefField, TupleField, Index, SliceOp,
    Deref, AddrOf, Call, CallPtr, Builtin, Unary, Binary, Logical, Cast, If, IfCapture, Match, BlockExpr,
    StructLit, RefNew, EnumLit, ArrayLit, ArrayRepeat, TupleLit, Try, Catch, OrElse, Unwrap, OptWrap, OptNull,
    ErrWrap, ErrToUnion, ErrVal, ArrayToSlice, ListToSlice, StrToSlice, Closure, FnToFat, Unreachable, Undefined,
    BinConstruct, Value, TypeVal, RecordCheck, Retained, DynFrom, DynCall,
    // match arms and patterns
    Arm, PWild, PBind, PInt, PFloat, PBool, PStr, PChar, PRange, PVariant, PError, PNull, PSome, POk, POr, PTuple, PBinary,
    Seg,
}

pub struct T {
    k: TKind
    ty: usize
    start: usize
    end: usize
    // ids, indexes, labels, locals, flags
    a: usize
    b: usize
    c: usize
    flag: bool
    flag2: bool
    // children: statements, arguments, arms, payloads
    kids: List(usize)
    // a second child list: for-slice item locals, struct-literal field indexes
    kids2: List(usize)
    // operator symbols, arithmetic modes, builtin names, cast kinds
    name: String
    // string literal bytes
    text: String
    ival: i128
    fval: f64
}

pub struct Tir {
    nodes: List(T)
}

fn tblank(k: TKind, ty: usize, start: usize, end: usize) -> T {
    return T{
        .k = k, .ty = ty, .start = start, .end = end, .a = NONE, .b = NONE, .c = NONE, .flag = false, .flag2 = false,
        .kids = List(usize).new(), .kids2 = List(usize).new(), .name = String.new(), .text = String.new(), .ival = 0, .fval = 0.0,
    }
}

impl Tir {
    fn add(self: *mut Self, own n: T) -> usize {
        self.nodes.append(n)
        return self.nodes.len - 1
    }
}

// ---------------------------------------------------------------- function contexts

pub struct Local {
    name: String
    ty: usize
    mutable: bool
    start: usize
    end: usize
    is_param: bool
    owned: bool
    loop_item: bool
}

pub struct LabelInfo {
    name: String
    has_name: bool
    id: usize
    is_loop: bool
    break_ty: usize
    scope_depth: usize
}

pub struct Witness {
    effects: u64
    at: usize
    why: String
}

pub struct Range {
    lo: i128
    hi: i128
}

/// The state of checking one function body. Scopes are a flat stack of
/// entries with a mark per scope.
pub struct FnCtx {
    ret: usize
    module: usize
    fn_name: String
    locals: List(Local)
    scope_names: List(String)
    scope_locals: List(usize)
    scope_deref: List(bool)
    scope_marks: List(usize)
    labels: List(LabelInfo)
    next_label: usize
    own_effects: u64
    witnesses: List(Witness)
    callees: List(usize)
    callee_spans: List(usize)
    moved: Map(usize, usize)
    ranges: Map(usize, Range)
    // loop index variables known to be in range for a local slice
    index_of: Map(usize, usize)
    in_defer: bool
    loop_depth: usize
    unsafe_depth: usize
    is_comptime: bool
    in_parallel: usize
    self_ty: usize
    // matching through a pointer: NONE, 0 (immutable) or 1 (mutable)
    pat_by_ref: usize
}

fn new_ctx(ret: usize, module: usize, name: []u8) -> FnCtx {
    return FnCtx{
        .ret = ret, .module = module, .fn_name = String.from(name), .locals = List(Local).new(),
        .scope_names = List(String).new(), .scope_locals = List(usize).new(), .scope_deref = List(bool).new(), .scope_marks = List(usize).new(),
        .labels = List(LabelInfo).new(), .next_label = 0, .own_effects = 0, .witnesses = List(Witness).new(),
        .callees = List(usize).new(), .callee_spans = List(usize).new(), .moved = Map(usize, usize).new(), .ranges = Map(usize, Range).new(),
        .index_of = Map(usize, usize).new(), .in_defer = false, .loop_depth = 0, .unsafe_depth = 0, .is_comptime = false, .in_parallel = 0, .self_ty = NONE, .pat_by_ref = NONE,
    }
}

/// One function instance: a definition with concrete type arguments, its
/// locals, and (after body checking) its body in the arena.
pub struct Inst {
    name: String
    mangled: String
    def: usize
    targs: List(usize)
    // the generic environment of the body: impl and function type parameters
    gen_names: List(String)
    gen_tys: List(usize)
    params: List(usize)
    ret: usize
    locals: List(Local)
    body: usize
    own_effects: u64
    effects: u64
    declared_neg: u64
    declared_pos: u64
    export_name: String
    is_extern: bool
    is_variadic: bool
    is_pub: bool
    is_test: bool
    test_comptime: bool
    is_closure: bool
    // a closure's captures: by reference or by value, in order
    closure_by_ref: List(bool)
    start: usize
    end: usize
    module: usize
    self_ty: usize
    witnesses: List(Witness)
    callees: List(usize)
}

const EFF_ALLOCATES: u64 = 1
const EFF_REFCOUNTS: u64 = 2
const EFF_BLOCKS: u64 = 4
const EFF_SHARED_MUTABLE: u64 = 8
const EFF_NONDETERMINISTIC: u64 = 16
const EFF_PANICS: u64 = 32
const EFF_FFI: u64 = 64
const EFF_UNBOUNDED_STACK: u64 = 128
const EFF_ALL: u64 = 255

// ---------------------------------------------------------------- the checker

pub struct Checker {
    mods: List(Mod)
    tys: Types
    items: Map(String, ItemRef)
    imports: Map(String, ImportRef)
    structs: List(StructDef)
    enums: List(EnumDef)
    traits: List(TraitDef)
    impls: List(ImplDef)
    fns: List(FnDef)
    consts: List(ConstDef)
    globals: List(GlobalDef)
    aliases: List(AliasDef)
    error_sets: List(ErrorSetDef)
    errors: List(String)
    // error names, 1-based ids in order of first mention
    error_names: List(String)
    error_ids: Map(String, usize)
    // instances, the body-check queue (a stack), and the typed IR
    insts: List(Inst)
    inst_map: Map(String, usize)
    queue: List(usize)
    tir: Tir
    // the function being checked, as a stack (constants nest)
    ctxs: List(FnCtx)
    main_inst: usize
    tests: List(usize)
    // the generic environment types resolve in: parameter names bound to types
    env_names: List(String)
    env_tys: List(usize)
    // `Record.new(.{ ... })` checks its literal without the panicking wrapper
    record_new_mode: bool
    vtables: List(VTable)
    obligations: List(Obligation)
    // calls made inside `for parallel` bodies: (instance, loop start, module)
    parallel_calls: List(Obligation)
    // mutable-global reads and writes: (global, at, module) and the function
    global_uses: List(Obligation)
    global_use_fns: List(String)
    // artifact kinds declared by the program; some make it an embeddable library
    artifact_kinds: List(String)
    // a shared wildcard pattern for the exhaustiveness matrix
    wild_pat_node: usize
    // `@cImport`: the C compiler to preprocess with, the target, and the
    // headers imported (name, is_system); declarations that could not be
    // translated, keyed "module:name"
    cc: List(String)
    target: String
    cimport_headers: List(String)
    cimport_system: List(bool)
    cimport_unsupported: Map(String, String)
    // aggregate `(value ...)` payloads, by index
    values: List(CV)
    // the compile-time interpreter's state (see `it_enter`)
    it_steps: u64
    it_panic: String
    it_panic_at: usize
    it_has_panic: bool
    it_budget: bool
    it_pending: u8
    it_pending_label: usize
    it_pending_val: CV
    it_failed_at: usize
    frames: List(Frame)
    it_cur_fn: usize
    it_out: CV
    it_flow_val: CV
    it_flow_label: usize
    cv_bad: CV
}

fn item_key(module: usize, name: []u8) -> String {
    return format("{}:{}", .{module, name})
}

impl Checker {
    fn fail(self: *mut Self, module: usize, at: usize, msg: []u8) {
        self.errors.append(format("{}:{}: {}", .{self.mods[module].name, at, msg}))
    }

    /// A note attached to the error just reported.
    fn note(self: *mut Self, module: usize, at: usize, msg: []u8) {
        self.errors.append(format("  note: {}:{}: {}", .{self.mods[module].name, at, msg}))
    }

    fn node(self: *Self, module: usize, id: usize) -> *parser.Node {
        return &self.mods[module].parsed.tree.nodes[id]
    }

    fn define(self: *mut Self, module: usize, name: []u8, kind: ItemKind, id: usize, at: usize) {
        let key = item_key(module, name)
        if self.items.contains(key[..]) {
            self.fail(module, at, format("`{}` is defined more than once in this module", .{name})[..])
            return
        }
        self.items.put(key, ItemRef{ .kind = kind, .id = id })
    }

    fn lookup(self: *Self, module: usize, name: []u8) -> ?ItemRef {
        let key = item_key(module, name)
        if let r = self.items.get(key[..]) { return r }
        if let im = self.imports.get(key[..]) {
            if im.has_name {
                return self.items.get(item_key(im.module, im.name[..])[..])
            }
            return ItemRef{ .kind = ItemKind.Module, .id = im.module }
        }
        return null
    }

    // ----- collection -----------------------------------------------------

    fn collect(self: *mut Self) {
        // `const c = @cImport("header.h")` becomes a synthetic module
        let n_mods = self.mods.len
        for m in 0..n_mods {
            let items = self.mods[m].parsed.items.clone()
            for it in items { if self.is_cimport_const(m, it) { self.collect_cimport(m, it) } }
        }
        // the synthetic modules were collected as they were made
        for m in 0..n_mods {
            let items = self.mods[m].parsed.items.clone()
            for it in items {
                if self.is_cimport_const(m, it) { continue }
                self.collect_item(m, it)
            }
        }
    }

    fn is_cimport_const(self: *Self, m: usize, it: usize) -> bool {
        let n = self.node(m, it)
        if n.k != parser.NodeKind.Const { return false }
        let v = self.node(m, n.y)
        return v.k == parser.NodeKind.Builtin and v.name == "cImport"
    }

    /// The directories `#include "..."` resolves against: every module's
    /// directory and the `include` entries of `artifact link` declarations.
    fn include_dirs(self: *Self) -> List(String) {
        var out = List(String).new()
        let n_mods = self.mods.len
        for m in 0..n_mods {
            if self.mods[m].dir.len > 0 { out.append(self.mods[m].dir.clone()) }
            let items = self.mods[m].parsed.items.clone()
            for it in items {
                let n = self.node(m, it)
                if n.k != parser.NodeKind.Artifact or n.name != "link" { continue }
                for f in n.kids.clone() {
                    let fnode = self.node(m, f)
                    if fnode.name != "include" { continue }
                    let v = self.node(m, fnode.x)
                    var vals = List(usize).new()
                    if v.k == parser.NodeKind.ArrayLit { vals = v.kids.clone() } else { vals.append(fnode.x) }
                    for e in vals {
                        let en = self.node(m, e)
                        if en.k == parser.NodeKind.Lit and en.text == "str" { out.append(format("{}/{}", .{self.mods[m].dir, en.name})) }
                    }
                }
            }
        }
        return out
    }

    fn collect_cimport(self: *mut Self, m: usize, it: usize) {
        let n = self.node(m, it)
        let const_name = n.name.clone()
        let bnode = self.node(m, n.y)
        let args = bnode.kids.clone()
        let at = bnode.start
        var header = String.new()
        var ok = args.len == 1
        if ok {
            let a = self.node(m, args[0])
            ok = a.k == parser.NodeKind.Lit and a.text == "str"
            if ok { header = a.name.clone() }
        }
        if !ok {
            self.fail(m, at, "@cImport takes one string literal: the header to import, e.g. `@cImport(\"stdio.h\")`")
            return
        }
        if self.cc.len == 0 {
            self.fail(m, at, "@cImport is not available in this context")
            return
        }
        let windows = os.env("COMSPEC") != null and os.env("WINDIR") != null
        let opts = cimport.ImportOptions{ .cc = self.cc.clone(), .target = self.target.clone(), .include_dirs = self.include_dirs(), .windows = windows }
        let mid = self.mods.len
        self.mods.append(Mod{
                .name = format("cimport:{}", .{header}), .source = String.new(), .dir = String.new(), .path = String.new(),
                .parsed = parser.Parsed{ .tree = parser.Tree{ .nodes = List(parser.Node).new() }, .items = List(usize).new(), .errors = List(String).new() },
        })
        let bend = bnode.end
        let ci = cimport.import_header(header[..], &opts, &mut self.mods[mid].parsed.tree) catch |e| {
            _ = self.mods.pop()
            if e == error.IoError {
                self.fail(m, at, format("@cImport(\"{}\"): cannot run the C compiler", .{header})[..])
            } else {
                self.fail(m, at, format("@cImport(\"{}\"): the C preprocessor failed: {}", .{header, cimport.pp_error_line()})[..])
            }
            return
        }
        self.cimport_headers.append(header.clone())
        self.cimport_system.append(ci.is_system)
        // every imported declaration is reported at the `@cImport`
        let n_nodes = self.mods[mid].parsed.tree.nodes.len
        for k in 0..n_nodes {
            self.mods[mid].parsed.tree.nodes[k].start = at
            self.mods[mid].parsed.tree.nodes[k].end = bend
        }
        // structs, then aliases, functions and constants; a later declaration
        // does not shadow an earlier one of the same name
        var names = Map(String, bool).new()
        for st, i in ci.structs {
            let sname = self.node(mid, st).name.clone()
            names.put(sname, true)
            self.mods[mid].parsed.items.append(st)
            self.collect_item(mid, st)
            let sid = self.structs.len - 1
            self.structs[sid].c_name = ci.struct_cnames[i].clone()
        }
        for a in ci.aliases {
            let aname = self.node(mid, a).name.clone()
            if names.contains(aname[..]) { continue }
            names.put(aname, true)
            self.mods[mid].parsed.items.append(a)
            self.collect_item(mid, a)
        }
        for f in ci.functions {
            let fname = self.node(mid, f).name.clone()
            if names.contains(fname[..]) { continue }
            names.put(fname, true)
            self.mods[mid].parsed.items.append(f)
            self.collect_item(mid, f)
        }
        for c in ci.consts {
            let cname = self.node(mid, c).name.clone()
            if names.contains(cname[..]) { continue }
            names.put(cname, true)
            self.mods[mid].parsed.items.append(c)
            self.collect_item(mid, c)
        }
        for u, i in ci.unsupported_names {
            self.cimport_unsupported.put(format("{}:{}", .{mid, u}), ci.unsupported_whys[i].clone())
        }
        self.items.put(item_key(m, const_name[..]), ItemRef{ .kind = ItemKind.Module, .id = mid })
    }

    /// Whether any parameter of the function is `own`.
    fn fn_takes_own(self: *Self, fid: usize) -> bool {
        let nm = self.fns[fid].node_module
        let n = self.node(nm, self.fns[fid].node)
        for p in n.kids { if self.node(nm, p).flag2 { return true } }
        return false
    }

    fn fn_is_generic(self: *Self, module: usize, id: usize) -> bool {
        let n = self.node(module, id)
        for p in n.kids {
            if self.node(module, p).flag { return true }
        }
        return false
    }

    fn collect_item(self: *mut Self, m: usize, it: usize) {
        let k = self.node(m, it).k
        if k == parser.NodeKind.Fn {
            let name = self.node(m, it).name.clone()
            let name_at = self.node(m, it).start
            let generic = self.fn_is_generic(m, it)
            self.fns.append(FnDef{ .node = it, .node_module = m, .module = m, .impl_id = NONE, .is_generic = generic, .is_test = false, .test_name = String.new(), .test_comptime = false })
            self.define(m, name[..], ItemKind.Fn, self.fns.len - 1, name_at)
        } else if k == parser.NodeKind.Struct {
            let n = self.node(m, it)
            var d = StructDef{
                .name = n.name.clone(), .kind = n.text.clone(), .layout = self.node(m, n.x).name.clone(), .c_name = String.new(),
                .tparams = List(String).new(), .derives = List(String).new(), .fields = n.kids.clone(),
                .module = m, .start = n.start, .end = n.end, .is_pub = n.flag,
            }
            var second = false
            for w in n.words {
                if w == "+" { second = true; continue }
                if second { d.derives.append(w.clone()) } else { d.tparams.append(w.clone()) }
            }
            let name = d.name.clone()
            let at = d.start
            self.structs.append(d)
            self.define(m, name[..], ItemKind.Struct, self.structs.len - 1, at)
        } else if k == parser.NodeKind.Enum {
            let n = self.node(m, it)
            var d = EnumDef{ .name = n.name.clone(), .tparams = List(String).new(), .derives = List(String).new(), .variants = n.kids.clone(), .module = m, .start = n.start, .end = n.end }
            var second = false
            for w in n.words {
                if w == "+" { second = true; continue }
                if second { d.derives.append(w.clone()) } else { d.tparams.append(w.clone()) }
            }
            let name = d.name.clone()
            let at = d.start
            self.enums.append(d)
            self.define(m, name[..], ItemKind.Enum, self.enums.len - 1, at)
        } else if k == parser.NodeKind.Trait {
            let n = self.node(m, it)
            let d = TraitDef{ .name = n.name.clone(), .methods = n.kids.clone(), .assoc = n.words.clone(), .module = m, .start = n.start, .end = n.end }
            let name = d.name.clone()
            let at = d.start
            self.traits.append(d)
            self.define(m, name[..], ItemKind.Trait, self.traits.len - 1, at)
        } else if k == parser.NodeKind.Impl {
            let n = self.node(m, it)
            let impl_id = self.impls.len
            var methods = List(usize).new()
            let tparams = n.words.clone()
            for meth in n.kids {
                let generic = self.fn_is_generic(m, meth) or tparams.len > 0
                self.fns.append(FnDef{ .node = meth, .node_module = m, .module = m, .impl_id = impl_id, .is_generic = generic, .is_test = false, .test_name = String.new(), .test_comptime = false })
                methods.append(self.fns.len - 1)
            }
            self.impls.append(ImplDef{ .trait_name = n.name.clone(), .has_trait = n.name != "-", .target = n.x, .tparams = tparams, .methods = methods, .module = m })
        } else if k == parser.NodeKind.Const {
            let n = self.node(m, it)
            let d = ConstDef{ .name = n.name.clone(), .node = it, .module = m, .start = n.start, .end = n.end, .is_pub = n.flag, .ty = NONE, .in_progress = false, .value = NONE }
            let name = d.name.clone()
            let at = d.start
            self.consts.append(d)
            self.define(m, name[..], ItemKind.Const, self.consts.len - 1, at)
        } else if k == parser.NodeKind.Global {
            let n = self.node(m, it)
            let d = GlobalDef{ .name = n.name.clone(), .node = it, .module = m, .start = n.start, .end = n.end, .ty = NONE, .init = NONE }
            let name = d.name.clone()
            let at = d.start
            self.globals.append(d)
            self.define(m, name[..], ItemKind.Global, self.globals.len - 1, at)
        } else if k == parser.NodeKind.TypeAlias {
            let n = self.node(m, it)
            let d = AliasDef{ .name = n.name.clone(), .node = it, .is_distinct = n.flag2, .module = m, .start = n.start, .end = n.end, .resolved = NONE }
            let name = d.name.clone()
            let at = d.start
            self.aliases.append(d)
            self.define(m, name[..], ItemKind.Alias, self.aliases.len - 1, at)
        } else if k == parser.NodeKind.ErrorSet {
            let n = self.node(m, it)
            let name = n.name.clone()
            let at = n.start
            let names = n.words.clone()
            for w in names { _ = self.error_id(w[..]) }
            self.error_sets.append(ErrorSetDef{ .name = name.clone(), .module = m })
            self.define(m, name[..], ItemKind.ErrorSet, self.error_sets.len - 1, at)
        } else if k == parser.NodeKind.Import {
            self.collect_import(m, it)
        } else if k == parser.NodeKind.Test {
            let n = self.node(m, it)
            self.fns.append(FnDef{ .node = it, .node_module = m, .module = m, .impl_id = NONE, .is_generic = false, .is_test = true, .test_name = n.name.clone(), .test_comptime = n.flag })
        } else if k == parser.NodeKind.Artifact {
            self.artifact_kinds.append(self.node(m, it).name.clone())
        }
    }

    fn collect_import(self: *mut Self, m: usize, it: usize) {
        let n = self.node(m, it)
        var path = List(String).new()
        var names = List(String).new()
        var in_names = false
        for w in n.words {
            if w == "+" { in_names = true; continue }
            if in_names { names.append(w.clone()) } else { path.append(w.clone()) }
        }
        let target = join_words(&path, ".")
        var target_mod = NONE
        for mm, i in self.mods {
            if mm.name == target { target_mod = i; break }
        }
        if target_mod == NONE {
            if path[0] == "std" or is_builtin_namespace(path[path.len - 1][..]) { return }
            self.fail(m, n.start, format("cannot find module `{}`", .{target})[..])
            return
        }
        if n.flag {
            for nm in names {
                self.imports.put(item_key(m, nm[..]), ImportRef{ .module = target_mod, .name = nm.clone(), .has_name = true })
            }
        } else {
            let alias = if n.name == "-" { path[path.len - 1].clone() } else { n.name.clone() }
            self.imports.put(item_key(m, alias[..]), ImportRef{ .module = target_mod, .name = String.new(), .has_name = false })
        }
    }

    // ----- type resolution ------------------------------------------------

    fn resolve_type(self: *mut Self, m: usize, id: usize, self_ty: usize) -> usize {
        let k = self.node(m, id).k
        if k == parser.NodeKind.TName { return self.resolve_named(m, id, self_ty) }
        if k == parser.NodeKind.TInfer { return self.tys.simple(TK.Infer) }
        if k == parser.NodeKind.TArray {
            let n = self.node(m, id)
            let len_node = n.x
            let elem_node = n.y
            let e = self.resolve_type(m, elem_node, self_ty)
            if let len = self.const_eval_int(m, len_node) {
                if len < 0 {
                    self.fail(m, id, "array length must not be negative")
                    return self.tys.array(0, e)
                }
                return self.tys.array(len as u64, e)
            }
            self.fail(m, id, "array length must be a compile-time constant integer")
            return self.tys.array(0, e)
        }
        if k == parser.NodeKind.TSlice {
            let n = self.node(m, id)
            let elem_node = n.x
            let is_mut = n.flag
            let e = self.resolve_type(m, elem_node, self_ty)
            return self.tys.wrap(TK.Slice, e, is_mut)
        }
        if k == parser.NodeKind.TPtr {
            let n = self.node(m, id)
            let elem_node = n.x
            let is_mut = n.flag
            let e = self.resolve_type(m, elem_node, self_ty)
            return self.tys.wrap(TK.Ptr, e, is_mut)
        }
        if k == parser.NodeKind.TOpt {
            let elem_node = self.node(m, id).x
            let e = self.resolve_type(m, elem_node, self_ty)
            return self.tys.wrap(TK.Opt, e, false)
        }
        if k == parser.NodeKind.TWeak {
            let elem_node = self.node(m, id).x
            let e = self.resolve_type(m, elem_node, self_ty)
            return self.tys.wrap(TK.Weak, e, false)
        }
        if k == parser.NodeKind.TErr {
            let n = self.node(m, id)
            let set_node = n.x
            let elem_node = n.y
            let e = self.resolve_type(m, elem_node, self_ty)
            if set_node == NONE { return self.tys.err_union(0, false, e) }
            let sn = self.node(m, set_node)
            if sn.k == parser.NodeKind.TName and sn.words.len == 1 {
                if let r = self.lookup(m, sn.words[0][..]) {
                    if r.kind == ItemKind.ErrorSet { return self.tys.err_union(r.id, true, e) }
                }
                self.fail(m, id, format("`{}` is not an error set", .{sn.words[0]})[..])
                return self.tys.err_union(0, false, e)
            }
            self.fail(m, id, "expected an error set name before `!`")
            return self.tys.err_union(0, false, e)
        }
        if k == parser.NodeKind.TFn {
            let n = self.node(m, id)
            let params = n.kids.clone()
            let ret_node = n.x
            let eff_words = n.words.clone()
            var ps = List(usize).new()
            for p in params { ps.append(self.resolve_type(m, p, self_ty)) }
            let r = self.resolve_type(m, ret_node, self_ty)
            return self.tys.func(ps, r, effect_mask(&eff_words))
        }
        if k == parser.NodeKind.TTuple {
            let elems = self.node(m, id).kids.clone()
            var ts = List(usize).new()
            for e in elems { ts.append(self.resolve_type(m, e, self_ty)) }
            if ts.len == 0 { return self.tys.simple(TK.Void) }
            return self.tys.intern(Ty{ .k = TK.Tuple, .name = String.new(), .def = 0, .n = 0, .flag = false, .args = ts })
        }
        if k == parser.NodeKind.TDyn {
            let n = self.node(m, id)
            let trait_name = n.name.clone()
            let eff_words = n.words.clone()
            if let r = self.lookup(m, trait_name[..]) {
                if r.kind == ItemKind.Trait { return self.tys.dyn_of(r.id, effect_mask(&eff_words)) }
            }
            self.fail(m, id, format("cannot find trait `{}`", .{trait_name})[..])
            return self.tys.simple(TK.Void)
        }
        self.fail(m, id, "unsupported type form")
        return self.tys.simple(TK.Void)
    }

    fn primitive(self: *mut Self, name: []u8) -> ?usize {
        for i in INT_NAMES { if i == name { return self.tys.named(TK.Int, name) } }
        if name == "f32" or name == "f64" { return self.tys.named(TK.Float, name) }
        if name == "bool" { return self.tys.simple(TK.Bool) }
        if name == "char" { return self.tys.simple(TK.Char) }
        if name == "void" { return self.tys.simple(TK.Void) }
        if name == "never" { return self.tys.simple(TK.Never) }
        if name == "error" { return self.tys.err_set(0, false) }
        if name == "type" { return self.tys.simple(TK.Type) }
        if name == "anytype" { return self.tys.simple(TK.Infer) }
        return null
    }

    fn resolve_named(self: *mut Self, m: usize, id: usize, self_ty: usize) -> usize {
        let n = self.node(m, id)
        let path = n.words.clone()
        let args = n.kids.clone()
        let at = n.start
        if path.len > 2 {
            self.fail(m, at, "type paths may have at most one module qualifier")
            return self.tys.simple(TK.Void)
        }
        var targs = List(usize).new()
        for a in args { targs.append(self.resolve_type(m, a, self_ty)) }
        if path.len == 2 { return self.named_type(m, path[1][..], path[0][..], targs, at, self_ty) }
        return self.named_type(m, path[0][..], NONE_NAME, targs, at, self_ty)
    }

    /// A named type with resolved arguments: `name`, or `qualifier.name`.
    fn named_type(self: *mut Self, m: usize, name: []u8, qualifier: []u8, own targs: List(usize), at: usize, self_ty: usize) -> usize {
        let qualified = qualifier.len > 0
        if !qualified {
            if name == "Self" {
                if self_ty != NONE { return self_ty }
                self.fail(m, at, "`Self` is only valid inside an impl or trait")
                return self.tys.simple(TK.Void)
            }
            let g = self.env_lookup(name)
            if g != NONE { return g }
            if let t = self.primitive(name) {
                if targs.len > 0 { self.fail(m, at, format("`{}` takes no type arguments", .{name})[..]) }
                return t
            }
            if name == "List" {
                if targs.len != 1 {
                    self.fail(m, at, "`List` takes one type argument: List(T)")
                    return self.tys.simple(TK.Void)
                }
                return self.tys.wrap(TK.List, targs[0], false)
            }
            if name == "Map" {
                if targs.len != 2 {
                    self.fail(m, at, "`Map` takes two type arguments: Map(K, V)")
                    return self.tys.simple(TK.Void)
                }
                return self.tys.map(targs[0], targs[1])
            }
            if name == "String" { return self.tys.simple(TK.Str) }
        }
        var module = m
        if qualified {
            let r = self.lookup(m, qualifier) orelse {
                self.fail(m, at, format("cannot find module `{}`", .{qualifier})[..])
                return self.tys.simple(TK.Void)
            }
            if r.kind != ItemKind.Module {
                self.fail(m, at, format("`{}.{}` is not a type", .{qualifier, name})[..])
                return self.tys.simple(TK.Void)
            }
            module = r.id
        }
        let r = self.lookup(module, name) orelse {
            self.fail(m, at, format("cannot find type `{}`", .{name})[..])
            return self.tys.simple(TK.Void)
        }
        if r.kind == ItemKind.Struct or r.kind == ItemKind.Enum {
            let n_params = if r.kind == ItemKind.Struct { self.structs[r.id].tparams.len } else { self.enums[r.id].tparams.len }
            if targs.len != n_params {
                self.fail(m, at, format("`{}` expects {} type argument(s) but {} were given", .{name, n_params, targs.len})[..])
                return self.tys.simple(TK.Void)
            }
            return self.tys.of_def(if r.kind == ItemKind.Struct { TK.Struct } else { TK.Enum }, r.id, targs)
        }
        if r.kind == ItemKind.Alias { return self.resolve_alias(r.id) }
        if r.kind == ItemKind.ErrorSet { return self.tys.err_set(r.id, true) }
        if r.kind == ItemKind.Trait {
            self.fail(m, at, format("`{}` is a trait, not a type", .{name})[..])
            return self.tys.simple(TK.Void)
        }
        self.fail(m, at, format("`{}` is not a type", .{name})[..])
        return self.tys.simple(TK.Void)
    }

    fn resolve_alias(self: *mut Self, id: usize) -> usize {
        if self.aliases[id].resolved != NONE { return self.aliases[id].resolved }
        let a_node = self.aliases[id].node
        let a_mod = self.aliases[id].module
        let target_node = self.node(a_mod, a_node).x
        var t = self.resolve_type(a_mod, target_node, NONE)
        if self.aliases[id].is_distinct { t = self.tys.of_def(TK.Distinct, id, List(usize).new()) }
        self.aliases[id].resolved = t
        return t
    }

    /// A constant integer expression: array lengths and the like.
    fn const_eval_int(self: *mut Self, m: usize, id: usize) -> ?i128 {
        let n = self.node(m, id)
        let k = n.k
        if k == parser.NodeKind.Lit {
            if n.text != "int" { return null }
            let v = n.name[..].parse_int(i128) catch { return null }
            return v
        }
        if k == parser.NodeKind.Unary {
            let op = n.name.clone()
            let inner = n.x
            if op != "-" { return null }
            let v = self.const_eval_int(m, inner) orelse return null
            return -v
        }
        if k == parser.NodeKind.Binary {
            let op = n.name.clone()
            let l_node = n.x
            let r_node = n.y
            let a = self.const_eval_int(m, l_node) orelse return null
            let b = self.const_eval_int(m, r_node) orelse return null
            if op == "+" { return a + b }
            if op == "-" { return a - b }
            if op == "*" { return a * b }
            if op == "/" { if b == 0 { return null }; return a / b }
            if op == "%" { if b == 0 { return null }; return a % b }
            if op == "<<" { return a << (b as u32) }
            if op == ">>" { return a >> (b as u32) }
            return null
        }
        if k == parser.NodeKind.Ident {
            let name = n.name.clone()
            if let r = self.lookup(m, name[..]) {
                if r.kind == ItemKind.Const {
                    let c_mod = self.consts[r.id].module
                    let value_node = self.node(c_mod, self.consts[r.id].node).y
                    return self.const_eval_int(c_mod, value_node)
                }
            }
            return null
        }
        return null
    }

    // ----- constants and globals -------------------------------------------

    fn resolve_const(self: *mut Self, id: usize) -> usize {
        if self.consts[id].ty != NONE { return self.consts[id].ty }
        if self.consts[id].in_progress {
            let at = self.consts[id].start
            let m = self.consts[id].module
            self.fail(m, at, "constant depends on itself")
            return self.tys.simple(TK.Void)
        }
        self.consts[id].in_progress = true
        let m = self.consts[id].module
        let node = self.consts[id].node
        let ty_node = self.node(m, node).x
        let value_node = self.node(m, node).y
        let cname = self.consts[id].name.clone()
        // the initializer is checked like any expression, in a compile-time context
        let v = self.tys.void()
        var ctx = new_ctx(v, m, format("const {}", .{cname})[..])
        ctx.is_comptime = true
        ctx.scope_marks.append(0)
        self.ctxs.append(ctx)
        var expected = NONE
        if ty_node != NONE { expected = self.resolve_type(m, ty_node, NONE) }
        var te = self.check_expr(value_node, expected)
        if expected != NONE { te = self.coerce_or_error(te, expected, "constant initializer") }
        te = self.finalize_expr(te)
        let t = self.tys.resolve(self.tir.nodes[te].ty, true)
        var seen = List(usize).new()
        let bad = self.heap_owning_part(t, &mut seen)
        if bad != NONE {
            let bk = self.tys.kind(self.tys.resolve(bad, true))
            var hint = String.new()
            if bk == TK.List { hint = format("; store a slice (`[]{}`) instead", .{self.ty_name(self.tys.list[self.tys.resolve(bad, true)].args[0])}) }
            if bk == TK.Str { hint = String.from("; store a `[]u8` instead") }
            if bad == t {
                self.fail_here(self.tir.nodes[te].start, format("a constant cannot own heap data (`{}`){}", .{self.ty_name(t), hint})[..])
            } else {
                self.fail_here(self.tir.nodes[te].start, format("a constant cannot own heap data: `{}` contains a `{}`{}", .{self.ty_name(t), self.ty_name(bad), hint})[..])
            }
        }
        // evaluate at compile time
        if let v = self.eval_const_expr(te) {
            te = self.value_node(&v, t, self.tir.nodes[te].start, self.tir.nodes[te].end)
        } else {
            self.fail_here(self.tir.nodes[te].start, "constant initializer must be evaluable at compile time")
        }
        _ = self.ctxs.pop()
        self.consts[id].in_progress = false
        self.consts[id].ty = t
        self.consts[id].value = te
        return t
    }

    /// The type of a constant initializer without an annotation: the
    /// literal defaults (`i32`, `f64`, `[]u8`), arrays of those, casts,
    /// arithmetic, and references to other constants. `expected` (or NONE)
    /// types an untyped integer literal.
    fn infer_const_type(self: *mut Self, m: usize, id: usize, expected: usize) -> usize {
        let n = self.node(m, id)
        let k = n.k
        if k == parser.NodeKind.Lit {
            let kind = n.text.clone()
            if kind == "int" {
                if expected != NONE and self.tys.list[expected].k == TK.Int { return expected }
                if expected != NONE and self.tys.list[expected].k == TK.Float { return expected }
                return self.tys.named(TK.Int, "i32")
            }
            if kind == "float" {
                if expected != NONE and self.tys.list[expected].k == TK.Float { return expected }
                return self.tys.named(TK.Float, "f64")
            }
            if kind == "str" or kind == "bytes" {
                let u8t = self.tys.named(TK.Int, "u8")
                return self.tys.wrap(TK.Slice, u8t, false)
            }
            if kind == "bool" { return self.tys.simple(TK.Bool) }
            if kind == "char" { return self.tys.simple(TK.Char) }
            return self.tys.simple(TK.Void)
        }
        if k == parser.NodeKind.Unary {
            let inner = n.x
            let op = n.name.clone()
            let t = self.infer_const_type(m, inner, expected)
            if op == "!" { return self.tys.simple(TK.Bool) }
            return t
        }
        if k == parser.NodeKind.Binary {
            let op = n.name.clone()
            let l_node = n.x
            let r_node = n.y
            if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=" or op == "and" or op == "or" {
                return self.tys.simple(TK.Bool)
            }
            // a typed side decides; a literal takes the other side's type
            let l_lit = self.node(m, l_node).k == parser.NodeKind.Lit
            let r_lit = self.node(m, r_node).k == parser.NodeKind.Lit
            if l_lit and !r_lit {
                let rt = self.infer_const_type(m, r_node, expected)
                return self.infer_const_type(m, l_node, rt)
            }
            let lt = self.infer_const_type(m, l_node, expected)
            if op == "<<" or op == ">>" { return lt }
            _ = self.infer_const_type(m, r_node, lt)
            return lt
        }
        if k == parser.NodeKind.Cast {
            let ty_node = n.y
            return self.resolve_type(m, ty_node, NONE)
        }
        if k == parser.NodeKind.ArrayLit {
            let elems = n.kids.clone()
            var elem_expected = NONE
            if expected != NONE and self.tys.list[expected].k == TK.Array { elem_expected = self.tys.list[expected].args[0] }
            var et = elem_expected
            for e, i in elems {
                let t = self.infer_const_type(m, e, if i == 0 { elem_expected } else { et })
                if i == 0 { et = t }
            }
            if elems.len == 0 and et == NONE { et = self.tys.simple(TK.Void) }
            return self.tys.array(elems.len as u64, et)
        }
        if k == parser.NodeKind.Ident {
            let name = n.name.clone()
            if let r = self.lookup(m, name[..]) {
                if r.kind == ItemKind.Const { return self.resolve_const(r.id) }
            }
            self.fail(m, id, format("cannot find `{}`", .{name})[..])
            return self.tys.simple(TK.Void)
        }
        if k == parser.NodeKind.StructLit {
            let ty_node = n.x
            if ty_node != NONE { return self.resolve_type(m, ty_node, NONE) }
        }
        self.fail(m, id, "unsupported constant initializer (stage 1)")
        return self.tys.simple(TK.Void)
    }

    /// The first part of `t` that owns heap memory (`List`, `String`, `Map`,
    /// a `ref class`, a weak reference), or NONE for a plain value type.
    fn heap_owning_part(self: *mut Self, t0: usize, seen: *mut List(usize)) -> usize {
        let t = self.tys.resolve(t0, true)
        for x in seen { if x == t { return NONE } }
        seen.append(t)
        let k = self.tys.kind(t)
        if k == TK.List or k == TK.Str or k == TK.Map or k == TK.Weak { return t }
        if k == TK.Struct {
            if self.structs[self.tys.list[t].def].kind == "ref" { return t }
            for f in self.struct_field_types(t) {
                let r = self.heap_owning_part(f, seen)
                if r != NONE { return r }
            }
            return NONE
        }
        if k == TK.Enum {
            for vt in self.enum_variant_types(t) {
                for f in vt {
                    let r = self.heap_owning_part(f, seen)
                    if r != NONE { return r }
                }
            }
            return NONE
        }
        if k == TK.Tuple {
            for f in self.tys.list[t].args.clone() {
                let r = self.heap_owning_part(f, seen)
                if r != NONE { return r }
            }
            return NONE
        }
        if k == TK.Array or k == TK.Slice or k == TK.Opt or k == TK.ErrUnion { return self.heap_owning_part(self.tys.list[t].args[0], seen) }
        if k == TK.Distinct { return self.heap_owning_part(self.distinct_underlying(self.tys.list[t].def), seen) }
        return NONE
    }

    fn resolve_globals(self: *mut Self) {
        let n = self.globals.len
        for i in 0..n {
            let m = self.globals[i].module
            let node = self.globals[i].node
            let ty_node = self.node(m, node).x
            let value_node = self.node(m, node).y
            let ty = self.resolve_type(m, ty_node, NONE)
            self.globals[i].ty = ty
            if value_node != NONE {
                let gname = self.globals[i].name.clone()
                let v = self.tys.void()
                var ctx = new_ctx(v, m, format("global {}", .{gname})[..])
                ctx.is_comptime = true
                ctx.scope_marks.append(0)
                self.ctxs.append(ctx)
                var te = self.check_expr(value_node, ty)
                te = self.coerce_or_error(te, ty, "global initializer")
                te = self.finalize_expr(te)
                if let v = self.eval_const_expr(te) {
                    self.globals[i].init = self.value_node(&v, ty, self.tir.nodes[te].start, self.tir.nodes[te].end)
                } else {
                    self.fail_here(self.tir.nodes[te].start, "global initializer must be evaluable at compile time (globals are initialized at compile time or not at all)")
                }
                _ = self.ctxs.pop()
            }
        }
    }

    // ----- output -------------------------------------------------------------

    fn ty_name(self: *mut Self, t0: usize) -> String {
        // printing resolves: an open literal defaults to i64 or f64 here, as in the oracle
        let t = self.tys.resolve(t0, true)
        let ty = &self.tys.list[t]
        let k = ty.k
        if k == TK.Int or k == TK.Float { return ty.name.clone() }
        if k == TK.Bool { return String.from("bool") }
        if k == TK.Char { return String.from("char") }
        if k == TK.Void { return String.from("void") }
        if k == TK.Never { return String.from("never") }
        if k == TK.Str { return String.from("String") }
        if k == TK.Type { return String.from("type") }
        if k == TK.ErrorSet { return String.from("error") }
        if k == TK.Infer { return String.from("_") }
        if k == TK.Struct or k == TK.Enum {
            let name = if k == TK.Struct { self.structs[ty.def].name.clone() } else { self.enums[ty.def].name.clone() }
            if ty.args.len == 0 { return name }
            return format("{}({})", .{name, self.ty_list(ty.args[..])})
        }
        if k == TK.Array { return format("[{}]{}", .{ty.n, self.ty_name(ty.args[0])}) }
        if k == TK.Slice { return format("[]{}{}", .{if ty.flag { "mut " } else { "" }, self.ty_name(ty.args[0])}) }
        if k == TK.Ptr { return format("*{}{}", .{if ty.flag { "mut " } else { "" }, self.ty_name(ty.args[0])}) }
        if k == TK.Opt { return format("?{}", .{self.ty_name(ty.args[0])}) }
        if k == TK.ErrUnion { return format("!{}", .{self.ty_name(ty.args[0])}) }
        if k == TK.Weak { return format("weak {}", .{self.ty_name(ty.args[0])}) }
        if k == TK.List { return format("List({})", .{self.ty_name(ty.args[0])}) }
        if k == TK.Map { return format("Map({}, {})", .{self.ty_name(ty.args[0]), self.ty_name(ty.args[1])}) }
        if k == TK.Tuple { return format("({})", .{self.ty_list(ty.args[..])}) }
        if k == TK.Distinct { return self.aliases[ty.def].name.clone() }
        if k == TK.Fn {
            let neg = render_negative(ty.n)
            let ret = self.ty_name(ty.args[ty.args.len - 1])
            let params = self.ty_list(ty.args[0..ty.args.len - 1])
            if neg.len == 0 { return format("fn({}) -> {}", .{params, ret}) }
            return format("fn({}) -> {} {}", .{params, ret, neg})
        }
        if k == TK.Dyn {
            let neg = render_negative(ty.n)
            if neg.len == 0 { return format("dyn {}", .{self.traits[ty.def].name}) }
            return format("dyn {} {}", .{self.traits[ty.def].name, neg})
        }
        return String.from("?")
    }

    fn ty_list(self: *mut Self, ts: []usize) -> String {
        var out = String.new()
        for t, i in ts {
            if i > 0 { out.append(", ") }
            out.append(self.ty_name(t)[..])
        }
        return out
    }

    fn print_sigs(self: *mut Self, out: *mut String) {
        out.append("(program\n  (modules\n")
        for m, i in self.mods { out.append(format("    (module {} {})\n", .{i, m.name})[..]) }
        out.append("  )\n  (structs\n")
        for s, i in self.structs {
            out.append(format("    (struct {} {} @{}:{} kind={} layout={} module={} pub={} tparams=({}) derives=({})\n",
                .{i, s.name, s.start, s.end, s.kind, s.layout, s.module, s.is_pub, join_words(&s.tparams, " "), join_words(&s.derives, " ")})[..])
            for f in s.fields {
                let fnode = self.node(s.module, f)
                out.append(format("      (field {} @{}:{} default={} constraint={})\n", .{fnode.name, fnode.start, fnode.end, yes_no(fnode.y), yes_no(fnode.z)})[..])
            }
            out.append("    )\n")
        }
        out.append("  )\n  (enums\n")
        for e, i in self.enums {
            out.append(format("    (enum {} {} @{}:{} module={} tparams=({}) derives=({})\n",
                .{i, e.name, e.start, e.end, e.module, join_words(&e.tparams, " "), join_words(&e.derives, " ")})[..])
            for v in e.variants {
                let vn = self.node(e.module, v)
                var payload = String.new()
                if vn.text == "unit" {
                    payload.append("unit")
                } else if vn.text == "tuple" {
                    payload = format("tuple {}", .{vn.kids.len})
                } else {
                    payload.append("struct (")
                    for f, fi in vn.kids {
                        if fi > 0 { payload.append(" ") }
                        payload.append(self.node(e.module, f).name[..])
                    }
                    payload.append(")")
                }
                out.append(format("      (variant {} @{}:{} {})\n", .{vn.name, vn.start, vn.end, payload})[..])
            }
            out.append("    )\n")
        }
        out.append("  )\n  (aliases\n")
        for a, i in self.aliases {
            out.append(format("    (alias {} {} @{}:{} distinct={} module={})\n", .{i, a.name, a.start, a.end, a.is_distinct, a.module})[..])
        }
        out.append("  )\n  (traits\n")
        for t, i in self.traits {
            out.append(format("    (trait {} {} @{}:{} module={} assoc=({})\n", .{i, t.name, t.start, t.end, t.module, join_words(&t.assoc, " ")})[..])
            for meth in t.methods {
                let mn = self.node(t.module, meth)
                out.append(format("      (method {} @{}:{} params={} body={})\n", .{mn.name, mn.start, mn.end, mn.kids.len, yes_no(mn.y)})[..])
            }
            out.append("    )\n")
        }
        out.append("  )\n  (consts\n")
        for i in 0..self.consts.len {
            let t = self.resolve_const(i)
            let c = &self.consts[i]
            out.append(format("    (const {} {} @{}:{} module={} pub={} mangled=nxc_{}_{} ty={})\n", .{i, c.name, c.start, c.end, c.module, c.is_pub, c.name, i, self.ty_name(t)})[..])
        }
        out.append("  )\n  (globals\n")
        for g, i in self.globals {
            let init = yes_no(self.node(g.module, g.node).y)
            out.append(format("    (global {} {} @{}:{} module={} mangled=nxg_{}_{} ty={} init={})\n", .{i, g.name, g.start, g.end, g.module, g.name, i, self.ty_name(g.ty), init})[..])
        }
        out.append("  )\n  (fns\n")
        // signatures come in (module, span) order, as in the oracle
        let n_fns = self.fns.len
        var order = List(usize).new()
        for i in 0..n_fns { order.append(i) }
        var i: usize = 1
        while i < n_fns {
            var j = i
            while j > 0 and self.fn_sig_before(order[j], order[j - 1]) {
                let t = order[j - 1]
                order[j - 1] = order[j]
                order[j] = t
                j -= 1
            }
            i += 1
        }
        for fid in order { self.print_fn_sig(fid, out) }
        out.append("  )\n)\n")
    }

    /// Strictly earlier in (module, start, end) order.
    fn fn_sig_before(self: *mut Self, a: usize, b: usize) -> bool {
        let ma = self.fns[a].module
        let mb = self.fns[b].module
        if ma != mb { return ma < mb }
        let na = self.node(self.fns[a].node_module, self.fns[a].node)
        let nb = self.node(self.fns[b].node_module, self.fns[b].node)
        if na.start != nb.start { return na.start < nb.start }
        return na.end < nb.end
    }

    fn print_fn_sig(self: *mut Self, fid: usize, out: *mut String) {
        let is_generic = self.fns[fid].is_generic
        if is_generic { return }
        let m = self.fns[fid].module
        let nm = self.fns[fid].node_module
        let node = self.fns[fid].node
        let impl_id = self.fns[fid].impl_id
        let is_test = self.fns[fid].is_test
        var self_ty = NONE
        if impl_id != NONE {
            let target = self.impls[impl_id].target
            self_ty = self.resolve_type(m, target, NONE)
        }
        let n = self.node(nm, node)
        let start = n.start
        let end = n.end
        var name = n.name.clone()
        var export_name = n.text.clone()
        var is_extern = n.flag2
        var is_pub = n.flag
        var has_body = n.y != NONE
        var ctest = false
        var ret: usize = NONE
        var params = String.new()
        if is_test {
            let tn = self.fns[fid].test_name.clone()
            ctest = self.fns[fid].test_comptime
            name = format("{}:{}", .{if ctest { "ctest" } else { "test" }, tn})
            export_name = String.from("-")
            is_extern = false
            is_pub = false
            has_body = true
            let v = self.tys.simple(TK.Void)
            ret = self.tys.err_union(0, false, v)
        } else {
            let param_nodes = n.kids.clone()
            let ret_node = n.x
            for p in param_nodes {
                let pn = self.node(nm, p)
                let pname = pn.name.clone()
                let pty_node = pn.x
                let owned = pn.flag2
                let t = self.resolve_type(m, pty_node, self_ty)
                params.append(format("({} {} own={}) ", .{pname, self.ty_name(t), owned})[..])
            }
            if params.len > 0 { params = String.from(params[0..params.len - 1]) }
            ret = if ret_node == NONE { self.tys.simple(TK.Void) } else { self.resolve_type(m, ret_node, self_ty) }
        }
        // the mangled name: extern functions keep theirs, free functions are
        // `nx_name` in the root module or when exported and `nx_m<module>_name`
        // elsewhere; methods and tests are numbered by the body-checking stage
        var mangled = String.from("-")
        if is_extern {
            mangled = name.clone()
        } else if impl_id == NONE and (!is_test or ctest) {
            // a comptime test's name is not `test:`-prefixed, so it mangles as a free function
            if m == 0 or export_name != "-" {
                mangled = format("nx_{}", .{sanitize(name[..])})
            } else {
                mangled = format("nx_m{}_{}", .{m, sanitize(name[..])})
            }
        }
        var neg: u64 = 0
        var pos: u64 = 0
        if !is_test {
            for w in n.words {
                if w[0] == '!' { neg = neg | effect_bit(w[1..]) } else { pos = pos | effect_bit(w[..]) }
            }
        }
        out.append(format("    (fn - {} @{}:{} mangled={} module={} ret={} targs=() export={} extern={} variadic={} pub={} test={} ctest={} closure=false body={}\n",
            .{name, start, end, mangled, m, self.ty_name(ret), export_name, is_extern, n.b == 1, is_pub, is_test, ctest, if has_body { "yes" } else { "no" }})[..])
        out.append(format("      (params {})\n", .{params})[..])
        out.append(format("      (declared neg=({}) pos=({}))\n", .{render_effects(neg), render_effects(pos)})[..])
        out.append("    )\n")
    }
}

impl Types {
    fn err_set(self: *mut Self, set: usize, has_set: bool) -> usize {
        return self.intern(Ty{ .k = TK.ErrorSet, .name = String.new(), .def = set, .n = 0, .flag = has_set, .args = List(usize).new() })
    }
}

fn effect_mask(words: *List(String)) -> u64 {
    // a function type permits every effect except the negated ones
    var mask: u64 = 0xff
    for w in words {
        if w.len > 0 and w[0] == '!' { mask = mask & ~effect_bit(w[1..]) }
    }
    return mask
}

fn is_builtin_namespace(name: []u8) -> bool {
    for n in BUILTIN_NAMESPACES { if n == name { return true } }
    return false
}

fn yes_no(id: usize) -> []u8 {
    return if id == NONE { "no" } else { "yes" }
}

fn sanitize(s: []u8) -> String {
    var out = String.new()
    for c in s {
        let alnum = (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'
        if alnum {
            out.push_byte(c)
        } else if c == '(' or c == ',' or c == ')' or c == ' ' or c == '[' or c == ']' or c == '*' or c == '?' or c == '!' or c == '.' {
            if out.len == 0 or out[out.len - 1] != '_' { out.push_byte('_') }
        }
    }
    while out.len > 0 and out[out.len - 1] == '_' { _ = out.pop() }
    return out
}

// ---------------------------------------------------------------- errors and instances

impl Checker {
    fn error_id(self: *mut Self, name: []u8) -> usize {
        if let id = self.error_ids.get(name) { return id }
        self.error_names.append(String.from(name))
        let id = self.error_names.len
        self.error_ids.put(String.from(name), id)
        return id
    }

    /// The well-known errors get stable ids before any body is checked.
    fn reserve_errors(self: *mut Self) {
        let names = ["OutOfMemory", "Panic", "InvalidRecord", "Truncated", "Overflow", "InvalidUtf8", "NotFound", "IoError", "InvalidInput", "BufferTooSmall", "Timeout", "ConnectionRefused"]
        for n in names { _ = self.error_id(n) }
    }

    // ----- the current function context ----------------------------------------

    fn ctx(self: *mut Self) -> *mut FnCtx{
        return &mut self.ctxs[self.ctxs.len - 1]
    }
    fn cur_module(self: *Self) -> usize { return self.ctxs[self.ctxs.len - 1].module }

    fn add_effect(self: *mut Self, e: u64, at: usize, why: []u8) {
        let c = self.ctx()
        var seen = (c.own_effects & e) != 0
        if seen {
            // a witness is kept only for the first introduction of an effect
            var any = false
            for w in c.witnesses { if (w.effects & e) != 0 { any = true } }
            seen = any
        }
        if !seen { c.witnesses.append(Witness{ .effects = e, .at = at, .why = String.from(why) }) }
        c.own_effects = c.own_effects | e
    }

    fn push_scope(self: *mut Self) {
        let c = self.ctx()
        c.scope_marks.append(c.scope_names.len)
    }
    fn pop_scope(self: *mut Self) {
        let c = self.ctx()
        let mark = c.scope_marks.pop() orelse 0
        while c.scope_names.len > mark {
            _ = c.scope_names.pop()
            _ = c.scope_locals.pop()
            _ = c.scope_deref.pop()
        }
    }
    fn scope_depth(self: *mut Self) -> usize { return self.ctx().scope_marks.len }

    fn declare_local(self: *mut Self, name: []u8, ty: usize, mutable: bool, start: usize, end: usize) -> usize {
        let c = self.ctx()
        let id = c.locals.len
        c.locals.append(Local{ .name = String.from(name), .ty = ty, .mutable = mutable, .start = start, .end = end, .is_param = false, .owned = false, .loop_item = false })
        c.scope_names.append(String.from(name))
        c.scope_locals.append(id)
        c.scope_deref.append(false)
        return id
    }

    /// The innermost local of that name, or NONE.
    fn lookup_local(self: *mut Self, name: []u8) -> usize {
        let c = self.ctx()
        var i = c.scope_names.len
        while i > 0 {
            i -= 1
            if c.scope_names[i] == name { return c.scope_locals[i] }
        }
        return NONE
    }

    /// Is the innermost local of that name a by-reference capture (read through its pointer)?
    fn lookup_deref(self: *mut Self, name: []u8) -> bool {
        let c = self.ctx()
        var i = c.scope_names.len
        while i > 0 {
            i -= 1
            if c.scope_names[i] == name { return c.scope_deref[i] }
        }
        return false
    }

    fn new_label(self: *mut Self, name: []u8, has_name: bool, is_loop: bool, break_ty: usize) -> usize {
        let depth = self.scope_depth()
        let c = self.ctx()
        let id = c.next_label
        c.next_label += 1
        c.labels.append(LabelInfo{ .name = String.from(name), .has_name = has_name, .id = id, .is_loop = is_loop, .break_ty = break_ty, .scope_depth = depth })
        return id
    }

    fn local_ty(self: *mut Self, l: usize) -> usize { return self.ctx().locals[l].ty }

    fn fail_here(self: *mut Self, at: usize, msg: []u8) {
        let m = self.cur_module()
        self.fail(m, at, msg)
    }

    // ----- instances --------------------------------------------------------------

    fn inst_key(fid: usize, targs: *List(usize)) -> String {
        var k = format("{}:", .{fid})
        for t in targs { k.append(format("{},", .{t})) }
        return k
    }

    /// Get or create the instance of a definition with these type arguments.
    fn instantiate(self: *mut Self, fid: usize, own targs0: List(usize)) -> usize {
        var targs = List(usize).new()
        for t in targs0 { targs.append(self.tys.resolve(t, true)) }
        let key = Checker.inst_key(fid, &targs)
        if let id = self.inst_map.get(key[..]) { return id }
        let id = self.insts.len
        self.inst_map.put(key, id)
        let m = self.fns[fid].module
        let node = self.fns[fid].node
        let nm = self.fns[fid].node_module
        let impl_id = self.fns[fid].impl_id
        let is_test = self.fns[fid].is_test
        // the environment: impl type parameters first, then the function's
        var gen_names = List(String).new()
        var gen_tys = List(usize).new()
        var ti: usize = 0
        if impl_id != NONE {
            let tps = self.impls[impl_id].tparams.clone()
            for tp in tps {
                gen_names.append(tp.clone())
                gen_tys.append(if ti < targs.len { targs[ti] } else { self.tys.void() })
                ti += 1
            }
        }
        if !is_test {
            let tps = self.fn_type_params(fid)
            for tp in tps {
                gen_names.append(tp.clone())
                gen_tys.append(if ti < targs.len { targs[ti] } else { self.tys.void() })
                ti += 1
            }
        }
        let saved_env = self.env_save()
        self.env_set(&gen_names, &gen_tys)
        var self_ty = NONE
        if impl_id != NONE {
            let target = self.impls[impl_id].target
            self_ty = self.resolve_type(m, target, NONE)
        }
        var locals = List(Local).new()
        var params = List(usize).new()
        var ret: usize = NONE
        var name = String.new()
        var export_name = String.from("-")
        var is_extern = false
        var is_pub = false
        var test_comptime = false
        var neg: u64 = 0
        var pos: u64 = 0
        var start: usize = 0
        var end: usize = 0
        var any_owned = false
        var is_variadic = false
        if is_test {
            test_comptime = self.fns[fid].test_comptime
            name = format("{}:{}", .{if test_comptime { "ctest" } else { "test" }, self.fns[fid].test_name})
            let v = self.tys.void()
            ret = self.tys.err_union(0, false, v)
            start = self.node(nm, node).start
            end = self.node(nm, node).end
        } else {
            let n = self.node(nm, node)
            name = n.name.clone()
            export_name = n.text.clone()
            is_extern = n.flag2
            is_variadic = n.b == 1
            is_pub = n.flag
            start = n.start
            end = n.end
            let param_nodes = n.kids.clone()
            let ret_node = n.x
            let words = n.words.clone()
            for p in param_nodes {
                let pn = self.node(nm, p)
                // a `comptime T: type` parameter is a type argument, not a local
                if pn.flag and self.is_type_param_node(nm, p) { continue }
                let pname = pn.name.clone()
                let pty_node = pn.x
                let owned = pn.flag2
                let pstart = pn.start
                let pend = pn.end
                let t = self.resolve_type(m, pty_node, self_ty)
                // in a generic function the instantiation decides whether `own` matters
                if owned and !self.needs_drop(t) and gen_names.len == 0 {
                    self.fail(m, pstart, format("`own` applies to owning types (`List`, `String`, `Map`, or structs holding them); `{}` is copied anyway", .{self.ty_name(t)})[..])
                }
                if owned { any_owned = true }
                locals.append(Local{ .name = pname, .ty = t, .mutable = owned, .start = pstart, .end = pend, .is_param = true, .owned = owned, .loop_item = false })
                params.append(locals.len - 1)
            }
            ret = if ret_node == NONE { self.tys.void() } else { self.resolve_type(m, ret_node, self_ty) }
            for w in words {
                if w[0] == '!' { neg = neg | effect_bit(w[1..]) } else { pos = pos | effect_bit(w[..]) }
            }
            if export_name != "-" {
                if targs.len > 0 { self.fail(m, start, "generic functions cannot be exported") }
                if any_owned { self.fail(m, start, "exported functions cannot take `own` parameters; the host language cannot hand over ownership") }
            }
        }
        self.env_restore(&saved_env)
        var mangled = String.new()
        if is_extern {
            mangled = name.clone()
        } else if is_test and !test_comptime {
            mangled = format("nx_test_{}", .{id})
        } else if targs.len == 0 and impl_id == NONE {
            if m == 0 or export_name != "-" {
                mangled = format("nx_{}", .{sanitize(name[..])})
            } else {
                mangled = format("nx_m{}_{}", .{m, sanitize(name[..])})
            }
        } else {
            var base = name.clone()
            if impl_id != NONE {
                base = format("{}_{}", .{sanitize(self.ty_name(self_ty)[..]), name})
            }
            mangled = format("nx_{}_{}", .{sanitize(base[..]), id})
        }
        self.insts.append(Inst{
                .name = name, .mangled = mangled, .def = fid, .targs = targs, .gen_names = gen_names, .gen_tys = gen_tys, .params = params, .ret = ret, .locals = locals, .body = NONE,
                .own_effects = 0, .effects = 0, .declared_neg = neg, .declared_pos = pos, .export_name = export_name,
                .is_extern = is_extern, .is_variadic = is_variadic, .is_pub = is_pub, .is_test = is_test, .test_comptime = test_comptime,
                .is_closure = false, .closure_by_ref = List(bool).new(), .start = start, .end = end, .module = m, .self_ty = self_ty,
                .witnesses = List(Witness).new(), .callees = List(usize).new(),
        })
        // a std module's tests belong to the compiler's own suite
        let from_std = self.mods[m].name.len >= 4 and self.mods[m].name[0..4] == "std."
        if is_test and !test_comptime and ! (from_std and m != 0) { self.tests.append(id) }
        self.queue.append(id)
        return id
    }

    /// `comptime T: type` parameters, in order.
    fn fn_type_params(self: *mut Self, fid: usize) -> List(String) {
        var out = List(String).new()
        let m = self.fns[fid].node_module
        let node = self.fns[fid].node
        if self.fns[fid].is_test { return out }
        let params = self.node(m, node).kids.clone()
        for p in params {
            if self.node(m, p).flag and self.is_type_param_node(m, p) { out.append(self.node(m, p).name.clone()) }
        }
        return out
    }

    fn is_type_param_node(self: *mut Self, m: usize, p: usize) -> bool {
        let ty_node = self.node(m, p).x
        let tn = self.node(m, ty_node)
        return tn.k == parser.NodeKind.TName and tn.words.len == 1 and tn.words[0] == "type" and tn.kids.len == 0
    }

    fn drain_queue(self: *mut Self) {
        while self.queue.len > 0 {
            let inst = self.queue.pop() orelse break
            self.check_fn_body(inst)
        }
    }

    fn check_program(self: *mut Self) {
        let n = self.consts.len
        for i in 0..n { _ = self.resolve_const(i) }
        self.resolve_globals()
        let nf = self.fns.len
        for fid in 0..nf {
            if self.fns[fid].is_generic or self.fns[fid].impl_id != NONE { continue }
            let id = self.instantiate(fid, List(usize).new())
            let m = self.fns[fid].module
            if !self.fns[fid].is_test and self.node(self.fns[fid].node_module, self.fns[fid].node).name == "main" and m == 0 { self.main_inst = id }
        }
        for fid in 0..nf {
            let impl_id = self.fns[fid].impl_id
            if impl_id == NONE or self.fns[fid].is_generic { continue }
            if self.impls[impl_id].tparams.len == 0 { _ = self.instantiate(fid, List(usize).new()) }
        }
        self.drain_queue()
        // compile-time tests run in the interpreter; a failure is a compile error
        let ni = self.insts.len
        for t in 0..ni {
            if !self.insts[t].test_comptime { continue }
            let name = self.insts[t].name[6..]
            let tname = String.from(name)
            let tstart = self.insts[t].start
            let tm = self.insts[t].module
            let code = self.call_instance(t, List(CV).new())
            if code == 0 {
                if self.it_out.kind == VK_ERR {
                    let ename = self.error_names[(self.it_out.ival - 1) as usize].clone()
                    self.fail(tm, tstart, format("comptime test \"{}\" failed with error.{}", .{tname, ename})[..])
                }
            } else if code == 1 {
                self.fail(tm, tstart, format("comptime test \"{}\" could not be evaluated at compile time (only pure computation runs at compile time)", .{tname})[..])
            } else {
                self.fail(tm, self.it_panic_at, format("comptime test \"{}\" panicked: {}", .{tname, self.it_panic})[..])
            }
        }
        self.propagate_effects()
        self.check_effect_bounds()
        self.check_embedded_constraints()
        self.check_obligations()
    }

    /// Declared negative bounds hold; calls in `for parallel` bodies do not
    /// mutate shared state.
    fn check_effect_bounds(self: *mut Self) {
        let n = self.insts.len
        for i in 0..n {
            if self.insts[i].body == NONE { continue }
            let violated = self.insts[i].effects & self.insts[i].declared_neg
            if violated == 0 { continue }
            let fname = self.insts[i].name.clone()
            let fstart = self.insts[i].start
            let fm = self.insts[i].module
            for nm, ei in EFFECT_NAMES {
                let bit = (1 as u64) << (ei as u64)
                if (violated & bit) == 0 { continue }
                self.fail(fm, fstart, format("function `{}` is declared `!{}` but has the `{}` effect", .{fname, nm, nm})[..])
                let intro = self.find_introducer(i, bit)
                if intro == NONE { continue }
                let why = self.introducer_why(intro, bit)
                if intro == i {
                    self.note(fm, self.insts[intro].start, format("the effect is introduced here: {}", .{why})[..])
                } else {
                    self.note(fm, fstart, format("this call acquires `{}`", .{nm})[..])
                    self.note(self.insts[intro].module, self.insts[intro].start, format("introduced by `{}` here: {}", .{self.insts[intro].name, why})[..])
                }
            }
        }
        let calls = self.parallel_calls.clone()
        for c in calls {
            if (self.insts[c.inst].effects & EFF_SHARED_MUTABLE) != 0 {
                self.fail(c.module, c.at, format("`{}` is called inside a `for parallel` body but has the `shared_mutable` effect", .{self.insts[c.inst].name})[..])
            }
        }
    }

    /// The function that introduces effect `bit` on some call path from `inst`.
    fn find_introducer(self: *mut Self, inst: usize, bit: u64) -> usize {
        var visited = List(usize).new()
        var stack = List(usize).new()
        stack.append(inst)
        while stack.len > 0 {
            let i = stack.pop() orelse break
            if list_has_usize(&visited, i) { continue }
            visited.append(i)
            if (self.insts[i].own_effects & bit) != 0 or self.insts[i].is_extern { return i }
            for c in self.insts[i].callees.clone() {
                if (self.insts[c].effects & bit) != 0 { stack.append(c) }
            }
        }
        return NONE
    }

    fn introducer_why(self: *mut Self, inst: usize, bit: u64) -> String {
        for w in self.insts[inst].witnesses { if (w.effects & bit) != 0 { return w.why.clone() } }
        if self.insts[inst].is_extern { return String.from("foreign functions may do anything") }
        return String.new()
    }

    /// In an embeddable library, any reachable mutable global is an error.
    fn check_embedded_constraints(self: *mut Self) {
        var embedded = false
        for k in self.artifact_kinds {
            if k == "cabi" or k == "python" or k == "rustlib" or k == "node" or k == "shared" { embedded = true }
        }
        if !embedded { return }
        var reported = List(usize).new()
        let uses = self.global_uses.clone()
        for u, i in uses {
            if list_has_usize(&reported, u.inst) { continue }
            reported.append(u.inst)
            let gname = self.globals[u.inst].name.clone()
            self.fail(u.module, u.at, format("mutable global `{}` is reachable from `{}`, but this project declares an embeddable artifact (S2: no process-global state)", .{gname, self.global_use_fns[i]})[..])
        }
    }

    /// Closures, function references and trait objects coerced to bounded
    /// types must not have the effects those types forbid.
    fn check_obligations(self: *mut Self) {
        let obs = self.obligations.clone()
        for o in obs {
            let violated = self.insts[o.inst].effects & o.neg
            if violated == 0 { continue }
            var what = format("`{}`", .{self.insts[o.inst].name})
            if self.insts[o.inst].is_closure { what = String.from("this closure") }
            for nm, i in EFFECT_NAMES {
                if (violated & (1 << (i as u64))) == 0 { continue }
                self.fail(o.module, o.at, format("{} has the `{}` effect, but the function type it is used as forbids it (`!{}`)", .{what, nm, nm})[..])
            }
        }
    }

    fn oblige(self: *mut Self, inst: usize, neg: u64, at: usize) {
        if neg == 0 { return }
        self.obligations.append(Obligation{ .inst = inst, .neg = neg, .at = at, .module = self.cur_module() })
    }

    /// effects(f) = own(f) plus the effects of every callee, to a fixpoint.
    fn propagate_effects(self: *mut Self) {
        let n = self.insts.len
        for i in 0..n {
            var e = self.insts[i].own_effects
            if self.insts[i].is_extern {
                e = e | EFF_FFI | EFF_BLOCKS | EFF_PANICS | EFF_ALLOCATES | EFF_NONDETERMINISTIC | EFF_SHARED_MUTABLE
            }
            self.insts[i].effects = e
        }
        var changed = true
        while changed {
            changed = false
            for i in 0..n {
                var e = self.insts[i].effects
                let callees = self.insts[i].callees.clone()
                for c in callees { e = e | self.insts[c].effects }
                if e != self.insts[i].effects {
                    self.insts[i].effects = e
                    changed = true
                }
            }
        }
    }

    // ----- bodies -------------------------------------------------------------------

    fn check_fn_body(self: *mut Self, inst: usize) {
        let fid = self.insts[inst].def
        let m = self.fns[fid].node_module
        let node = self.fns[fid].node
        let is_test = self.fns[fid].is_test
        let body = if is_test { self.node(m, node).x } else { self.node(m, node).y }
        if body == NONE {
            if !self.insts[inst].is_extern and self.fns[fid].impl_id == NONE {
                let nm = self.insts[inst].name.clone()
                self.fail(m, self.insts[inst].start, format("function `{}` has no body", .{nm})[..])
            }
            return
        }
        let ret = self.insts[inst].ret
        let saved_env = self.env_save()
        self.env_set(&self.insts[inst].gen_names.clone(), &self.insts[inst].gen_tys.clone())
        // where-clause bounds hold for the concrete arguments
        let wheres = self.node(m, node).kids2.clone()
        for w in wheres {
            let wn = self.node(m, w)
            let pname = wn.name.clone()
            let bounds = wn.text.clone()
            let wstart = wn.start
            let t = self.env_lookup(pname[..])
            if t == NONE { continue }
            let names = Checker.split_words(bounds[..])
            for b in names {
                if !self.type_satisfies_trait(t, b[..]) {
                    self.fail(m, wstart, format("type `{}` does not implement trait `{}`", .{self.ty_name(t), b})[..])
                }
            }
        }
        var ctx = new_ctx(ret, m, self.insts[inst].name[..])
        ctx.self_ty = self.insts[inst].self_ty
        ctx.locals = self.insts[inst].locals.clone()
        ctx.scope_marks.append(0)
        for p in self.insts[inst].params {
            ctx.scope_names.append(ctx.locals[p].name.clone())
            ctx.scope_locals.append(p)
            ctx.scope_deref.append(false)
        }
        self.ctxs.append(ctx)
        let tb = self.check_block(body, ret, NONE, NONE)
        let tb2 = self.finalize_block_as_body(tb, ret)
        let done = self.ctxs.pop() orelse return
        self.env_restore(&saved_env)
        self.insts[inst].locals = done.locals.clone()
        self.insts[inst].body = tb2
        self.insts[inst].own_effects = done.own_effects
        self.insts[inst].witnesses = done.witnesses.clone()
        self.insts[inst].callees = done.callees.clone()
    }

    fn is_void_like_ret(self: *mut Self, ret: usize) -> bool {
        let r = self.tys.resolve(ret, true)
        let k = self.tys.kind(r)
        if k == TK.Void { return true }
        if k == TK.ErrUnion {
            let inner = self.tys.shallow(self.tys.list[r].args[0])
            return self.tys.kind(inner) == TK.Void
        }
        return false
    }

    fn finalize_block_as_body(self: *mut Self, tb: usize, ret: usize) -> usize {
        let is_void_ret = self.is_void_like_ret(ret)
        let tail = self.tir.nodes[tb].a
        if tail != NONE {
            self.tir.nodes[tb].a = NONE
            let tt = self.tys.resolve(self.tir.nodes[tail].ty, false)
            let tk = self.tys.kind(tt)
            var tail_is_err_void = false
            if tk == TK.ErrUnion { tail_is_err_void = self.tys.kind(self.tys.shallow(self.tys.list[tt].args[0])) == TK.Void }
            let ret_is_err = self.tys.kind(self.tys.resolve(ret, true)) == TK.ErrUnion
            if is_void_ret and (tk == TK.Void or tk == TK.Never) {
                let s = self.tir.add(tblank(TKind.SExpr, tt, self.tir.nodes[tail].start, self.tir.nodes[tail].end))
                self.tir.nodes[s].kids.append(tail)
                self.tir.nodes[tb].kids.append(s)
            } else if is_void_ret and tail_is_err_void and ret_is_err {
                // a `!void` tail in a `!void` function is returned, errors and all
                let start = self.tir.nodes[tail].start
                let end = self.tir.nodes[tail].end
                let v = self.coerce_or_error(tail, ret, "return value")
                let s = self.tir.add(tblank(TKind.SReturn, ret, start, end))
                self.tir.nodes[s].kids.append(v)
                self.tir.nodes[tb].kids.append(s)
            } else if is_void_ret {
                self.fail_here(self.tir.nodes[tail].start, format("this value of type `{}` is unused; the function returns void. Discard it with `_ = ...` or return it", .{self.ty_name(tt)})[..])
                let s = self.tir.add(tblank(TKind.SExpr, tt, self.tir.nodes[tail].start, self.tir.nodes[tail].end))
                self.tir.nodes[s].kids.append(tail)
                self.tir.nodes[tb].kids.append(s)
            } else {
                let start = self.tir.nodes[tail].start
                let end = self.tir.nodes[tail].end
                let v = self.coerce_or_error(tail, ret, "return value")
                let s = self.tir.add(tblank(TKind.SReturn, ret, start, end))
                self.tir.nodes[s].kids.append(v)
                self.tir.nodes[tb].kids.append(s)
            }
        } else if !is_void_ret and !self.block_diverges(tb) {
            self.fail_here(self.tir.nodes[tb].start, format("function must return a value of type `{}` on every path; add a `return` or a tail expression", .{self.ty_name(ret)})[..])
        }
        return tb
    }

    fn block_diverges(self: *mut Self, b: usize) -> bool {
        let tail = self.tir.nodes[b].a
        if tail != NONE and self.expr_diverges(tail) { return true }
        let kids = self.tir.nodes[b].kids.clone()
        for s in kids { if self.stmt_diverges(s) { return true } }
        return false
    }

    fn stmt_diverges(self: *mut Self, s: usize) -> bool {
        let k = self.tir.nodes[s].k
        if k == TKind.SReturn or k == TKind.SBreak or k == TKind.SContinue { return true }
        if k == TKind.SExpr { return self.expr_diverges(self.tir.nodes[s].kids[0]) }
        if k == TKind.SLet {
            if self.tir.nodes[s].kids.len > 0 { return self.expr_diverges(self.tir.nodes[s].kids[0]) }
            return false
        }
        if k == TKind.SBlock or k == TKind.SUsing { return self.block_diverges(self.tir.nodes[s].kids[self.tir.nodes[s].kids.len - 1]) }
        if k == TKind.SWhile {
            let cond = self.tir.nodes[s].kids[0]
            let always = self.tir.nodes[cond].k == TKind.Bool and self.tir.nodes[cond].flag
            return always and !self.has_break(self.tir.nodes[s].kids[1], 0)
        }
        return false
    }

    /// Does a loop body break out of the loop at `depth` 0? Nested loops own
    /// their own breaks.
    fn has_break(self: *mut Self, b: usize, depth: u32) -> bool {
        let k = self.tir.nodes[b].k
        if k == TKind.SBreak { return depth == 0 }
        if k == TKind.SWhile or k == TKind.SForRange or k == TKind.SForSlice {
            let kids = self.tir.nodes[b].kids.clone()
            for c in kids { if self.has_break(c, depth + 1) { return true } }
            return false
        }
        let kids = self.tir.nodes[b].kids.clone()
        for c in kids { if self.has_break(c, depth) { return true } }
        let tail = self.tir.nodes[b].a
        if k == TKind.Block and tail != NONE { return self.has_break(tail, depth) }
        return false
    }

    fn expr_diverges(self: *mut Self, e: usize) -> bool {
        let t = self.tys.shallow(self.tir.nodes[e].ty)
        return self.tys.kind(t) == TK.Never
    }

    // ----- blocks and statements ----------------------------------------------------

    fn check_block(self: *mut Self, b: usize, expected: usize, label: usize, label_ty: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, b)
        let stmts = n.kids.clone()
        let tail_node = n.x
        let start = n.start
        let end = n.end
        self.push_scope()
        var tb = tblank(TKind.Block, NONE, start, end)
        tb.b = label
        for s in stmts {
            let ts = self.check_stmt(s)
            if ts != NONE { tb.kids.append(ts) }
        }
        var ty = self.tys.void()
        var tail = NONE
        if tail_node != NONE {
            let want = if expected != NONE { expected } else { label_ty }
            var te = self.check_expr(tail_node, want)
            let tt = self.tys.shallow(self.tir.nodes[te].ty)
            let tk = self.tys.kind(tt)
            var is_void_expected = false
            if want != NONE { is_void_expected = self.tys.kind(self.tys.shallow(want)) == TK.Void }
            if is_void_expected and ! (tk == TK.Void or tk == TK.Never) {
                self.check_unused(te)
                let s = self.tir.add(tblank(TKind.SExpr, tt, self.tir.nodes[te].start, self.tir.nodes[te].end))
                self.tir.nodes[s].kids.append(te)
                tb.kids.append(s)
            } else if tk == TK.Void {
                let s = self.tir.add(tblank(TKind.SExpr, tt, self.tir.nodes[te].start, self.tir.nodes[te].end))
                self.tir.nodes[s].kids.append(te)
                tb.kids.append(s)
            } else {
                if want != NONE and !is_void_expected { te = self.coerce_or_error(te, want, "block value") }
                te = self.take_ownership(te)
                ty = self.tir.nodes[te].ty
                tail = te
            }
        }
        if tail == NONE {
            var diverges = false
            for s in tb.kids { if self.stmt_diverges(s) { diverges = true } }
            if diverges {
                ty = self.tys.never()
            } else if label_ty != NONE {
                ty = label_ty
            }
        }
        if label_ty != NONE and tail != NONE { ty = label_ty }
        self.pop_scope()
        tb.a = tail
        tb.ty = ty
        return self.tir.add(tb)
    }

    /// A labeled block yields its value through `break :label v`.
    fn check_block_labeled(self: *mut Self, b: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let label = self.node(m, b).name.clone()
        if label.len == 0 { return self.check_block(b, expected, NONE, NONE) }
        let ty = if expected != NONE { expected } else { self.tys.fresh_infer() }
        let lid = self.new_label(label[..], true, false, ty)
        let tb = self.check_block(b, ty, lid, ty)
        _ = self.ctx().labels.pop()
        return tb
    }

    fn check_unused(self: *mut Self, te: usize) {
        let t = self.tys.shallow(self.tir.nodes[te].ty)
        let k = self.tys.kind(t)
        if k == TK.Void or k == TK.Never { return }
        let at = self.tir.nodes[te].start
        if k == TK.ErrUnion {
            self.fail_here(at, format("unhandled error: this expression has type `{}`", .{self.ty_name(t)})[..])
            return
        }
        self.fail_here(at, format("unused value of type `{}`", .{self.ty_name(t)})[..])
    }

    fn stmt_node(self: *mut Self, k: TKind, start: usize, end: usize) -> usize {
        let v = self.tys.void()
        return self.tir.add(tblank(k, v, start, end))
    }

    fn check_stmt(self: *mut Self, s: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, s)
        let k = n.k
        let start = n.start
        let end = n.end
        if k == parser.NodeKind.Let { return self.check_let(s) }
        if k == parser.NodeKind.Assign { return self.check_assign(s) }
        if k == parser.NodeKind.Discard {
            let value_node = n.x
            let te = self.check_expr(value_node, NONE)
            let st = self.stmt_node(TKind.SExpr, start, end)
            self.tir.nodes[st].kids.append(te)
            return st
        }
        if k == parser.NodeKind.ExprStmt {
            let e = n.x
            let v = self.tys.void()
            let te = self.check_expr(e, v)
            self.check_unused(te)
            let st = self.stmt_node(TKind.SExpr, start, end)
            self.tir.nodes[st].kids.append(te)
            return st
        }
        if k == parser.NodeKind.Return { return self.check_return(s) }
        if k == parser.NodeKind.Break { return self.check_break(s) }
        if k == parser.NodeKind.Continue {
            let label = n.name.clone()
            let has_label = label != "-"
            let li = self.find_label(label[..], has_label, false, start)
            if li == NONE { return NONE }
            let is_loop = self.ctx().labels[li].is_loop
            let lid = self.ctx().labels[li].id
            if !is_loop { self.fail_here(start, "`continue` needs a loop label") }
            let st = self.stmt_node(TKind.SContinue, start, end)
            self.tir.nodes[st].a = lid
            return st
        }
        if k == parser.NodeKind.Defer or k == parser.NodeKind.ErrDefer {
            let is_err = k == parser.NodeKind.ErrDefer
            let body = n.x
            if is_err {
                let ret = self.ctx().ret
                if self.tys.kind(self.tys.shallow(ret)) != TK.ErrUnion {
                    self.fail_here(start, "`errdefer` is only meaningful in a function that returns an error union")
                }
            }
            let saved = self.ctx().in_defer
            self.ctx().in_defer = true
            self.push_scope()
            let tb = self.check_stmt(body)
            self.pop_scope()
            self.ctx().in_defer = saved
            if tb == NONE { return NONE }
            let st = self.stmt_node(if is_err { TKind.SErrDefer } else { TKind.SDefer }, start, end)
            self.tir.nodes[st].kids.append(tb)
            return st
        }
        if k == parser.NodeKind.While { return self.check_while(s) }
        if k == parser.NodeKind.For { return self.check_for(s) }
        if k == parser.NodeKind.Unsafe {
            let body = n.x
            self.ctx().unsafe_depth += 1
            let v = self.tys.void()
            let tb = self.check_block(body, v, NONE, NONE)
            self.ctx().unsafe_depth -= 1
            let st = self.stmt_node(TKind.SBlock, start, end)
            self.tir.nodes[st].kids.append(tb)
            return st
        }
        if k == parser.NodeKind.Using {
            let strategy = n.name.clone()
            let body = n.x
            let v = self.tys.void()
            let tb = self.check_block(body, v, NONE, NONE)
            let st = self.stmt_node(TKind.SUsing, start, end)
            st_set_name(&mut self.tir, st, strategy[..])
            self.tir.nodes[st].kids.append(tb)
            return st
        }
        self.fail_here(start, "unsupported statement (stage 2)")
        return NONE
    }

    fn check_let(self: *mut Self, s: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, s)
        let name = n.name.clone()
        let mutable = n.flag
        let ty_node = n.x
        let init_node = n.y
        let start = n.start
        let end = n.end
        var declared = NONE
        if ty_node != NONE {
            let st = self.ctx().self_ty
            declared = self.resolve_type(m, ty_node, st)
        }
        var init = NONE
        if init_node != NONE {
            var te = self.check_expr(init_node, declared)
            if declared != NONE { te = self.coerce_or_error(te, declared, format("initializer of `{}`", .{name})[..]) }
            let tt = self.tys.shallow(self.tir.nodes[te].ty)
            if self.tys.kind(tt) == TK.Void {
                self.fail_here(self.tir.nodes[te].start, format("`{}` would have type `void`; a `let` must bind a value", .{name})[..])
            }
            init = self.take_ownership(te)
        } else {
            if declared == NONE { self.fail_here(start, format("`{}` needs a type or an initializer", .{name})[..]) }
            if !mutable { self.fail_here(start, format("`let {}` without an initializer can never be assigned; use `var`", .{name})[..]) }
        }
        var lty = self.tys.void()
        if declared != NONE { lty = declared } else if init != NONE { lty = self.tir.nodes[init].ty }
        var has_range = false
        var range = Range{ .lo = 0, .hi = 0 }
        if init != NONE {
            if let r = self.expr_range(init) {
                has_range = true
                range = r
            }
        }
        let id = self.declare_local(name[..], lty, mutable, start, end)
        if !mutable and has_range { self.ctx().ranges.put(id, range) }
        if self.is_ref_class(lty) { self.add_effect(EFF_REFCOUNTS, start, "holding a reference releases it at scope exit") }
        let st = self.stmt_node(TKind.SLet, start, end)
        self.tir.nodes[st].a = id
        if init != NONE { self.tir.nodes[st].kids.append(init) }
        return st
    }

    fn check_assign(self: *mut Self, s: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, s)
        let op = n.name.clone()
        let target_node = n.x
        let value_node = n.y
        let start = n.start
        let end = n.end
        let compound = op != "="
        let bop = op.clone()
        if !compound {
            // naming the target of `x = v` is not a read: a moved local is revived
            let tn = self.node(m, target_node)
            if tn.k == parser.NodeKind.Ident {
                let l = self.lookup_local(tn.name[..])
                if l != NONE {
                    _ = self.ctx().moved.remove(l)
                    _ = self.ctx().ranges.remove(l)
                }
            }
        }
        let t = self.check_expr(target_node, NONE)
        if !self.is_place(t) {
            self.fail_here(self.tir.nodes[t].start, "the left side of an assignment must be a variable, field, element, or dereference")
            _ = self.check_expr(value_node, NONE)
            return NONE
        }
        if !self.place_mutable(t) {
            let tk = self.tir.nodes[t].k
            if tk == TKind.Local {
                let ln = self.ctx().locals[self.tir.nodes[t].a].name.clone()
                self.fail_here(self.tir.nodes[t].start, format("`{}` is immutable; declare it with `var`", .{ln})[..])
            } else {
                self.fail_here(self.tir.nodes[t].start, "cannot assign to an immutable location")
            }
        }
        if self.tir.nodes[t].k == TKind.Global { self.add_effect(EFF_SHARED_MUTABLE, start, "writing a mutable global") }
        let tt = self.tir.nodes[t].ty
        let st = self.stmt_node(TKind.SAssign, start, end)
        if !compound {
            var v = self.check_expr(value_node, tt)
            v = self.coerce_or_error(v, tt, "assignment")
            v = self.take_ownership(v)
            if self.tir.nodes[t].k == TKind.Local {
                let l = self.tir.nodes[t].a
                _ = self.ctx().moved.remove(l)
                _ = self.ctx().ranges.remove(l)
            }
            st_set_name(&mut self.tir, st, "=")
            self.tir.nodes[st].kids.append(t)
            self.tir.nodes[st].kids.append(v)
            return st
        }
        // compound: typed as the binary operation on (target, value)
        let be = self.check_binary_parts(bop[..], target_node, value_node, tt, start, end)
        if self.tir.nodes[be].k != TKind.Binary { return NONE }
        let mode = self.tir.nodes[be].name.clone()
        let v = self.tir.nodes[be].kids[1]
        if self.tir.nodes[t].k == TKind.Local { _ = self.ctx().ranges.remove(self.tir.nodes[t].a) }
        st_set_name(&mut self.tir, st, format("{}= {}", .{bop, mode})[..])
        self.tir.nodes[st].kids.append(t)
        self.tir.nodes[st].kids.append(v)
        return st
    }

    fn check_return(self: *mut Self, s: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, s)
        let value_node = n.x
        let start = n.start
        let end = n.end
        if self.ctx().in_defer { self.fail_here(start, "`return` is not allowed inside `defer`") }
        if self.ctx().in_parallel > 0 { self.fail_here(start, "`return` is not allowed inside a `for parallel` body") }
        let ret = self.ctx().ret
        let ret_is_void = self.is_void_like_ret(ret)
        let st = self.stmt_node(TKind.SReturn, start, end)
        if value_node == NONE {
            if !ret_is_void { self.fail_here(start, format("`return` without a value in a function returning `{}`", .{self.ty_name(ret)})[..]) }
            return st
        }
        var te = self.check_expr(value_node, ret)
        let tt = self.tys.shallow(self.tir.nodes[te].ty)
        if ret_is_void and self.tys.kind(tt) == TK.Void {
            self.tir.nodes[st].kids.append(te)
            return st
        }
        te = self.coerce_or_error(te, ret, "return value")
        self.check_escaping_view(te, start)
        te = self.take_ownership(te)
        self.tir.nodes[st].kids.append(te)
        return st
    }

    /// Region rule R1, conservatively: a returned slice or pointer must not be
    /// a view into a local variable (array, List, String, or a struct holding
    /// one) that is released when the function returns.
    fn check_escaping_view(self: *mut Self, te: usize, at: usize) {
        var t = self.tys.shallow(self.tys.resolve(self.tir.nodes[te].ty, false))
        var k = self.tys.kind(t)
        if k == TK.Opt or k == TK.ErrUnion {
            t = self.tys.shallow(self.tys.list[t].args[0])
            k = self.tys.kind(t)
        }
        if ! (k == TK.Slice or k == TK.Ptr) { return }
        var what: []u8 = ""
        let local = self.view_root(te, &mut what)
        if local == NONE { return }
        if self.ctx().locals[local].is_param { return }
        let lt = self.tys.shallow(self.tys.resolve(self.ctx().locals[local].ty, false))
        let lk = self.tys.kind(lt)
        let owns = lk == TK.Array or lk == TK.List or lk == TK.Str or lk == TK.Map or lk == TK.Struct or lk == TK.Tuple or lk == TK.Enum
            or lk == TK.Int or lk == TK.Float or lk == TK.Bool or lk == TK.Char
        if !owns { return }
        let name = self.ctx().locals[local].name.clone()
        self.fail_here(at, format("this returns a {} into `{}`, a local that is released when the function returns (region rule R1)", .{what, name})[..])
    }

    /// The local a view expression borrows from (NONE when none), and what kind of view it is.
    fn view_root(self: *mut Self, e: usize, what: *mut[]u8) -> usize {
        let k = self.tir.nodes[e].k
        let kids = self.tir.nodes[e].kids.clone()
        if k == TKind.ArrayToSlice or k == TKind.ListToSlice or k == TKind.StrToSlice {
            what.*= "slice"
            return self.place_root(kids[0])
        }
        if k == TKind.SliceOp {
            what.*= "slice"
            let bk = self.tir.nodes[kids[0]].k
            if bk == TKind.ArrayToSlice or bk == TKind.ListToSlice or bk == TKind.StrToSlice { return self.place_root(self.tir.nodes[kids[0]].kids[0]) }
            return self.place_root(kids[0])
        }
        if k == TKind.AddrOf {
            what.*= "pointer"
            return self.place_root(kids[0])
        }
        if k == TKind.OptWrap or k == TKind.ErrWrap { return self.view_root(kids[0], what) }
        if k == TKind.BlockExpr {
            let tail = self.tir.nodes[kids[0]].a
            if tail == NONE { return NONE }
            return self.view_root(tail, what)
        }
        if k == TKind.If {
            let then_tail = self.tir.nodes[kids[1]].a
            if then_tail != NONE {
                let r = self.view_root(then_tail, what)
                if r != NONE { return r }
            }
            if kids.len > 2 {
                let else_tail = self.tir.nodes[kids[2]].a
                if else_tail != NONE { return self.view_root(else_tail, what) }
            }
            return NONE
        }
        return NONE
    }

    /// The root local of a place expression (`x`, `x.f`, `x[i]`, `x.0`), not through pointers.
    fn place_root(self: *mut Self, e: usize) -> usize {
        let k = self.tir.nodes[e].k
        if k == TKind.Local { return self.tir.nodes[e].a }
        if k == TKind.Field or k == TKind.TupleField or k == TKind.Index {
            // indexing a slice reaches memory the slice borrows, not the local itself
            let base = self.tir.nodes[e].kids[0]
            let bt = self.tys.shallow(self.tir.nodes[base].ty)
            let bk = self.tys.kind(bt)
            if bk == TK.Slice or bk == TK.Ptr { return NONE }
            return self.place_root(base)
        }
        return NONE
    }

    /// The index into the label stack of the named label (or the innermost loop), or NONE.
    fn find_label(self: *mut Self, name: []u8, has_name: bool, for_break: bool, at: usize) -> usize {
        let c = self.ctx()
        var i = c.labels.len
        while i > 0 {
            i -= 1
            let l = &c.labels[i]
            if has_name {
                if l.has_name and l.name == name { return i }
            } else if l.is_loop {
                return i
            }
        }
        if has_name {
            self.fail_here(at, format("cannot find label `{}`", .{name})[..])
        } else {
            self.fail_here(at, if for_break { "`break` outside of a loop" } else { "`continue` outside of a loop" })
        }
        return NONE
    }

    fn check_break(self: *mut Self, s: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, s)
        let label = n.name.clone()
        let has_label = label != "-"
        let value_node = n.x
        let start = n.start
        let end = n.end
        if self.ctx().in_parallel > 0 { self.fail_here(start, "`break` is not allowed inside a `for parallel` body (other workers cannot be stopped); use `continue`") }
        let li = self.find_label(label[..], has_label, true, start)
        if li == NONE { return NONE }
        let is_loop = self.ctx().labels[li].is_loop
        let lid = self.ctx().labels[li].id
        let break_ty = self.ctx().labels[li].break_ty
        let st = self.stmt_node(TKind.SBreak, start, end)
        self.tir.nodes[st].a = lid
        if value_node != NONE {
            if is_loop { self.fail_here(start, "loops do not produce values; use a labeled block for `break :label value`") }
            var te = self.check_expr(value_node, break_ty)
            if break_ty != NONE { te = self.coerce_or_error(te, break_ty, "break value") }
            te = self.take_ownership(te)
            self.tir.nodes[st].kids.append(te)
        } else if !is_loop and break_ty != NONE {
            let v = self.tys.void()
            if !self.unify(break_ty, v) { self.fail_here(start, "this labeled block produces a value; `break :label` needs one") }
        }
        return st
    }

    fn check_while(self: *mut Self, s: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, s)
        let label = n.name.clone()
        let cond_node = n.x
        let body_node = n.y
        let els_node = n.z
        let start = n.start
        let end = n.end
        let bt = self.tys.bool_ty()
        var c = self.check_expr(cond_node, bt)
        c = self.coerce_or_error(c, bt, "while condition")
        let lid = self.new_label(label[..], label.len > 0, true, NONE)
        self.ctx().loop_depth += 1
        let v = self.tys.void()
        let tb = self.check_block(body_node, v, NONE, NONE)
        self.ctx().loop_depth -= 1
        _ = self.ctx().labels.pop()
        let st = self.stmt_node(TKind.SWhile, start, end)
        self.tir.nodes[st].a = lid
        self.tir.nodes[st].kids.append(c)
        self.tir.nodes[st].kids.append(tb)
        if els_node != NONE {
            let eb = self.check_block(els_node, v, NONE, NONE)
            self.tir.nodes[st].kids.append(eb)
        }
        return st
    }

    fn check_for(self: *mut Self, s: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, s)
        let label = n.name.clone()
        let is_range = n.flag
        let is_parallel = n.flag2
        let bindings = n.words.clone()
        let start = n.start
        let end = n.end
        let items = n.kids2.clone()
        let range_start = n.x
        let range_end = n.y
        let range_step = n.z
        let body_node = n.a
        if is_range {
            if bindings.len != 1 { self.fail_here(start, "a range loop binds exactly one variable: `for i in a..b`") }
            let hint = self.tys.usize_ty()
            var st = self.check_expr(range_start, NONE)
            let s_ty = self.tys.shallow(self.tir.nodes[st].ty)
            var en = NONE
            if self.tys.kind(s_ty) == TK.Infer {
                // an untyped literal start takes the end's type, defaulting to usize
                en = self.check_expr(range_end, hint)
                let et = self.tys.resolve(self.tir.nodes[en].ty, false)
                st = self.coerce_or_error(st, et, "range start")
            } else {
                en = self.check_expr(range_end, s_ty)
                en = self.coerce_or_error(en, s_ty, "range end")
            }
            let it = self.tys.resolve(self.tir.nodes[st].ty, true)
            if !self.tys.is_integer(it) {
                self.fail_here(start, format("range bounds must be integers but found `{}`", .{self.ty_name(it)})[..])
            }
            var step = NONE
            if range_step != NONE {
                step = self.arg(range_step, it, "step")
                if self.tir.nodes[step].k == TKind.Int {
                    let sv = self.tir.nodes[step].ival
                    if sv == 0 { self.fail_here(self.tir.nodes[step].start, "a range step cannot be zero") }
                    let signed = self.tys.kind(it) == TK.Int and int_signed(self.tys.list[it].name[..])
                    if sv < 0 and !signed {
                        self.fail_here(self.tir.nodes[step].start, format("a negative step needs a signed loop variable, but this one is `{}`", .{self.ty_name(it)})[..])
                    }
                }
            }
            self.push_scope()
            let v = self.declare_local(bindings[0][..], it, false, start, end)
            // range fact: start <= i < end, for the default step of 1
            if step == NONE {
                if let sr = self.expr_range(st) {
                    if let er = self.expr_range(en) {
                        if er.hi > sr.lo { self.ctx().ranges.put(v, Range{ .lo = sr.lo, .hi = er.hi - 1 }) }
                    }
                }
            }
            // `for i in 0..xs.len`: i indexes xs safely
            if self.tir.nodes[en].k == TKind.Builtin and self.tir.nodes[en].name == "Len" {
                let arg0 = self.tir.nodes[en].kids[0]
                if self.tir.nodes[arg0].k == TKind.Local and self.tir.nodes[st].k == TKind.Int and self.tir.nodes[st].ival == 0 and step == NONE {
                    self.ctx().index_of.put(v, self.tir.nodes[arg0].a)
                }
            }
            let lid = self.new_label(label[..], label.len > 0, true, NONE)
            self.ctx().loop_depth += 1
            let vt = self.tys.void()
            let tb = self.check_block(body_node, vt, NONE, NONE)
            self.ctx().loop_depth -= 1
            _ = self.ctx().labels.pop()
            self.pop_scope()
            if is_parallel { self.fail_here(start, "`for parallel` iterates slices: write `for parallel x, i in items { ... }`") }
            let node = self.stmt_node(TKind.SForRange, start, end)
            self.tir.nodes[node].a = v
            self.tir.nodes[node].b = lid
            self.tir.nodes[node].kids.append(st)
            self.tir.nodes[node].kids.append(en)
            if step != NONE {
                self.tir.nodes[node].flag = true
                self.tir.nodes[node].kids.append(step)
            }
            self.tir.nodes[node].kids.append(tb)
            return node
        }
        return self.check_for_items(s)
    }
}

fn st_set_name(tir: *mut Tir, id: usize, name: []u8) {
    tir.nodes[id].name = String.from(name)
}

// ---------------------------------------------------------------- type predicates

impl Checker {
    fn is_ref_class(self: *mut Self, t0: usize) -> bool {
        let t = self.tys.shallow(t0)
        if self.tys.kind(t) != TK.Struct { return false }
        return self.structs[self.tys.list[t].def].kind == "ref"
    }

    /// Types whose copies are made by retaining: ref classes and optionals or weak refs of them.
    fn is_ref_like(self: *mut Self, t0: usize) -> bool {
        let t = self.tys.shallow(t0)
        let k = self.tys.kind(t)
        if k == TK.Opt or k == TK.Weak { return self.is_ref_like(self.tys.list[t].args[0]) }
        return self.is_ref_class(t)
    }

    /// The resolved field types of a struct type (generic arguments applied).
    fn struct_field_types(self: *mut Self, t0: usize) -> List(usize) {
        let t = self.tys.shallow(t0)
        var out = List(usize).new()
        if self.tys.kind(t) != TK.Struct { return out }
        let d = self.tys.list[t].def
        let m = self.structs[d].module
        let fields = self.structs[d].fields.clone()
        let saved = self.env_save()
        self.env_set(&self.structs[d].tparams.clone(), &self.tys.list[t].args.clone())
        for f in fields {
            let ty_node = self.node(m, f).x
            out.append(self.resolve_type(m, ty_node, t))
        }
        self.env_restore(&saved)
        return out
    }

    // ----- the generic environment ----------------------------------------------------

    fn env_lookup(self: *mut Self, name: []u8) -> usize {
        var i = self.env_names.len
        while i > 0 {
            i -= 1
            if self.env_names[i] == name { return self.env_tys[i] }
        }
        return NONE
    }

    /// The environment as a flat list: names then types, for save and restore.
    fn env_save(self: *mut Self) -> EnvSave {
        return EnvSave{ .names = self.env_names.clone(), .tys = self.env_tys.clone() }
    }
    fn env_restore(self: *mut Self, saved: *EnvSave) {
        self.env_names = saved.names.clone()
        self.env_tys = saved.tys.clone()
    }
    fn env_set(self: *mut Self, names: *List(String), tys: *List(usize)) {
        self.env_names = names.clone()
        self.env_tys = tys.clone()
    }
    fn env_bind(self: *mut Self, name: []u8, ty: usize) {
        self.env_names.append(String.from(name))
        self.env_tys.append(ty)
    }

    /// Does a value of this type own resources released at scope exit?
    fn needs_drop(self: *mut Self, t0: usize) -> bool {
        let t = self.tys.shallow(t0)
        let k = self.tys.kind(t)
        if k == TK.List or k == TK.Str or k == TK.Map or k == TK.Weak { return true }
        if k == TK.Struct {
            if self.is_ref_class(t) { return true }
            let fts = self.struct_field_types(t)
            for f in fts { if self.needs_drop(f) { return true } }
            return false
        }
        if k == TK.Enum {
            let d = self.tys.list[t].def
            let m = self.enums[d].module
            let variants = self.enums[d].variants.clone()
            for v in variants {
                let vn = self.node(m, v)
                if vn.text == "unit" { continue }
                let kids = vn.kids.clone()
                let is_tuple = vn.text == "tuple"
                for c in kids {
                    let ty_node = if is_tuple { c } else { self.node(m, c).x }
                    let ft = self.resolve_type(m, ty_node, NONE)
                    if self.needs_drop(ft) { return true }
                }
            }
            return false
        }
        if k == TK.Array or k == TK.Opt or k == TK.ErrUnion { return self.needs_drop(self.tys.list[t].args[0]) }
        if k == TK.Tuple {
            let args = self.tys.list[t].args.clone()
            for a in args { if self.needs_drop(a) { return true } }
        }
        return false
    }

    fn is_place(self: *mut Self, e: usize) -> bool {
        let k = self.tir.nodes[e].k
        if k == TKind.Local or k == TKind.Global or k == TKind.RefField or k == TKind.Deref { return true }
        if k == TKind.Field or k == TKind.TupleField { return self.is_place(self.tir.nodes[e].kids[0]) }
        if k == TKind.Index {
            let base = self.tir.nodes[e].kids[0]
            let bt = self.tys.shallow(self.tir.nodes[base].ty)
            if self.tys.kind(bt) == TK.Slice { return true }
            return self.is_place(base)
        }
        return false
    }

    fn place_mutable(self: *mut Self, e: usize) -> bool {
        let k = self.tir.nodes[e].k
        if k == TKind.Local { return self.ctx().locals[self.tir.nodes[e].a].mutable }
        if k == TKind.Global { return true }
        if k == TKind.Field or k == TKind.TupleField { return self.place_mutable(self.tir.nodes[e].kids[0]) }
        if k == TKind.RefField { return true }
        if k == TKind.Index {
            let base = self.tir.nodes[e].kids[0]
            let bt = self.tys.shallow(self.tir.nodes[base].ty)
            if self.tys.kind(bt) == TK.Slice { return self.tys.list[bt].flag }
            return self.place_mutable(base)
        }
        if k == TKind.Deref {
            let p = self.tir.nodes[e].kids[0]
            let pt = self.tys.shallow(self.tir.nodes[p].ty)
            if self.tys.kind(pt) == TK.Ptr { return self.tys.list[pt].flag }
            return false
        }
        return false
    }

    // ----- ownership ------------------------------------------------------------------

    fn take_ownership(self: *mut Self, e: usize) -> usize {
        let t = self.tys.resolve(self.tir.nodes[e].ty, false)
        if !self.needs_drop(t) { return e }
        let k = self.tir.nodes[e].k
        if self.is_ref_like(t) {
            if k == TKind.RefNew or k == TKind.Call or k == TKind.Retained { return e }
            self.add_effect(EFF_REFCOUNTS, self.tir.nodes[e].start, "copying a reference retains it")
            var r = tblank(TKind.Retained, self.tir.nodes[e].ty, self.tir.nodes[e].start, self.tir.nodes[e].end)
            r.kids.append(e)
            return self.tir.add(r)
        }
        var l = NONE
        if k == TKind.Local {
            l = self.tir.nodes[e].a
        } else if k == TKind.Unwrap or k == TKind.OrElse or k == TKind.Try {
            let inner = self.tir.nodes[e].kids[0]
            if self.tir.nodes[inner].k == TKind.Local { l = self.tir.nodes[inner].a }
        }
        if l != NONE {
            let at = self.tir.nodes[e].start
            let is_param = self.ctx().locals[l].is_param
            let owned = self.ctx().locals[l].owned
            let loop_item = self.ctx().locals[l].loop_item
            let lname = self.ctx().locals[l].name.clone()
            if is_param and !owned {
                if k == TKind.Local {
                    self.fail_here(at, format("cannot move `{}` out of a parameter; parameters are borrowed", .{lname})[..])
                } else {
                    self.fail_here(at, format("cannot move the `{}` out of the parameter `{}`; parameters are borrowed", .{self.ty_name(t), lname})[..])
                }
            } else if loop_item {
                if k == TKind.Local {
                    self.fail_here(at, format("cannot move `{}` out of a loop; a loop variable is a view of the element", .{lname})[..])
                } else {
                    self.fail_here(at, format("cannot move the `{}` out of the loop variable `{}`; it is a view of the element", .{self.ty_name(t), lname})[..])
                }
            } else {
                self.ctx().moved.put(l, at)
            }
            return e
        }
        if self.is_borrowed_view(e) {
            self.fail_here(self.tir.nodes[e].start, format("cannot move a `{}` out of a field or element", .{self.ty_name(t)})[..])
            self.note(self.cur_module(), self.tir.nodes[e].start, "use `.clone()` for an owned copy")
        }
        return e
    }

    /// A field, element, or dereference: a view into something else's storage.
    fn is_borrowed_view(self: *mut Self, e: usize) -> bool {
        let k = self.tir.nodes[e].k
        if k == TKind.Field or k == TKind.RefField or k == TKind.TupleField or k == TKind.Index or k == TKind.Deref { return true }
        if k == TKind.Builtin { return self.tir.nodes[e].name == "MapGet" or self.tir.nodes[e].name == "ListLast" }
        // `return xs[i]` into a `?T` or `!T` wraps the element first; the view is still moved
        if k == TKind.OrElse or k == TKind.Unwrap or k == TKind.Try or k == TKind.OptWrap or k == TKind.ErrWrap {
            return self.is_borrowed_view(self.tir.nodes[e].kids[0])
        }
        return false
    }

    // ----- unification and coercion -------------------------------------------------

    fn unify(self: *mut Self, a0: usize, b0: usize) -> bool {
        let a = self.tys.shallow(a0)
        let b = self.tys.shallow(b0)
        if a == b { return true }
        let ka = self.tys.kind(a)
        let kb = self.tys.kind(b)
        if ka == TK.Infer { return self.bind_infer(self.tys.infer_index(a), b) }
        if kb == TK.Infer { return self.bind_infer(self.tys.infer_index(b), a) }
        if ka == TK.Never or kb == TK.Never { return true }
        if ka != kb { return false }
        let ta = self.tys.list[a].args.clone()
        let tb = self.tys.list[b].args.clone()
        if ka == TK.Struct or ka == TK.Enum {
            if self.tys.list[a].def != self.tys.list[b].def or ta.len != tb.len { return false }
            return self.unify_all(ta[..], tb[..])
        }
        if ka == TK.Array { return self.tys.list[a].n == self.tys.list[b].n and self.unify(ta[0], tb[0]) }
        if ka == TK.Slice or ka == TK.Ptr { return self.tys.list[a].flag == self.tys.list[b].flag and self.unify(ta[0], tb[0]) }
        if ka == TK.Opt or ka == TK.List or ka == TK.Weak { return self.unify(ta[0], tb[0]) }
        if ka == TK.ErrUnion {
            let sa = self.tys.list[a].flag
            let sb = self.tys.list[b].flag
            let same_set = (!sa or !sb) or self.tys.list[a].def == self.tys.list[b].def
            return same_set and self.unify(ta[0], tb[0])
        }
        if ka == TK.Map { return self.unify(ta[0], tb[0]) and self.unify(ta[1], tb[1]) }
        if ka == TK.Fn {
            if ta.len != tb.len { return false }
            let ea = self.tys.list[a].n
            let eb = self.tys.list[b].n
            return self.unify_all(ta[..], tb[..]) and (ea == eb or (ea & eb) == eb)
        }
        if ka == TK.Tuple { return ta.len == tb.len and self.unify_all(ta[..], tb[..]) }
        if ka == TK.ErrorSet { return true }
        if ka == TK.Dyn { return self.tys.list[a].def == self.tys.list[b].def and (self.tys.list[b].n & self.tys.list[a].n) == self.tys.list[a].n }
        if ka == TK.Int or ka == TK.Float { return self.tys.list[a].name == self.tys.list[b].name }
        if ka == TK.Distinct { return self.tys.list[a].def == self.tys.list[b].def }
        return false
    }

    fn unify_all(self: *mut Self, xs: []usize, ys: []usize) -> bool {
        for x, i in xs { if !self.unify(x, ys[i]) { return false } }
        return true
    }

    fn bind_infer(self: *mut Self, n: usize, target0: usize) -> bool {
        let kind = self.tys.infer_kinds[n]
        let target = self.tys.shallow(target0)
        if self.tys.kind(target) == TK.Infer {
            let m = self.tys.infer_index(target)
            if m == n { return true }
            let tk = self.tys.infer_kinds[m]
            var merged = kind
            if kind == INFER_ANY { merged = tk } else if tk == INFER_ANY { merged = kind } else if kind != tk { return false }
            self.tys.infer_kinds[m] = merged
            self.tys.subst[n] = target
            return true
        }
        let tk = self.tys.kind(target)
        var ok = true
        if kind == INFER_INT { ok = tk == TK.Int }
        if kind == INFER_FLOAT { ok = tk == TK.Float }
        if !ok { return false }
        self.tys.subst[n] = target
        return true
    }

    fn retype(self: *mut Self, e: usize, ty: usize) -> usize {
        self.tir.nodes[e].ty = ty
        return e
    }

    fn wrap_node(self: *mut Self, k: TKind, e: usize, ty: usize) -> usize {
        var w = tblank(k, ty, self.tir.nodes[e].start, self.tir.nodes[e].end)
        w.kids.append(e)
        return self.tir.add(w)
    }

    /// Coerce `e` to `target`; NONE when impossible (the expression is untouched).
    fn coerce(self: *mut Self, e: usize, target: usize) -> usize {
        let from = self.tys.shallow(self.tir.nodes[e].ty)
        let to = self.tys.shallow(target)
        if from == to { return e }
        let kf = self.tys.kind(from)
        let kt = self.tys.kind(to)
        if kf == TK.Never { return self.retype(e, target) }
        if kf == TK.Infer or kt == TK.Infer {
            if self.unify(from, to) { return self.retype(e, target) }
            if kt == TK.Opt {
                let inner = self.tys.list[to].args[0]
                let saved_ty = self.tir.nodes[e].ty
                let r = self.coerce(e, inner)
                if r != NONE { return self.wrap_node(TKind.OptWrap, r, target) }
                self.tir.nodes[e].ty = saved_ty
            }
            if kt == TK.ErrUnion {
                let inner = self.tys.list[to].args[0]
                let saved_ty = self.tir.nodes[e].ty
                let r = self.coerce(e, inner)
                if r != NONE { return self.wrap_node(TKind.ErrWrap, r, target) }
                self.tir.nodes[e].ty = saved_ty
            }
            return NONE
        }
        // *String / *List(T) -> a slice: a pointer to an owning value reads as a view of it
        if kf == TK.Ptr and kt == TK.Slice {
            let inner = self.tys.list[from].args[0]
            let ik = self.tys.kind(self.tys.shallow(inner))
            if ik == TK.Str or ik == TK.List {
                let d = self.wrap_node(TKind.Deref, e, inner)
                let r = self.coerce(d, target)
                if r != NONE { return r }
                return NONE
            }
            if ik == TK.Array {
                let ish = self.tys.shallow(inner)
                let e1 = self.tys.list[ish].args[0]
                let e2 = self.tys.list[to].args[0]
                let pm = self.tys.list[from].flag
                let m = self.tys.list[to].flag
                if self.unify(e1, e2) and (!m or pm) {
                    let d = self.wrap_node(TKind.Deref, e, inner)
                    return self.wrap_node(TKind.ArrayToSlice, d, target)
                }
            }
            return NONE
        }
        if kf == TK.Opt and kt == TK.Opt {
            if self.unify(self.tys.list[from].args[0], self.tys.list[to].args[0]) { return self.retype(e, target) }
            return NONE
        }
        if kt == TK.Opt {
            let inner = self.tys.list[to].args[0]
            let r = self.coerce(e, inner)
            if r != NONE { return self.wrap_node(TKind.OptWrap, r, target) }
            return NONE
        }
        if kf == TK.ErrorSet and kt == TK.ErrUnion {
            if self.tir.nodes[e].k == TKind.ErrVal { return self.retype(e, target) }
            return self.wrap_node(TKind.ErrToUnion, e, target)
        }
        if kt == TK.ErrUnion {
            let inner = self.tys.list[to].args[0]
            let r = self.coerce(e, inner)
            if r != NONE { return self.wrap_node(TKind.ErrWrap, r, target) }
            return NONE
        }
        if kf == TK.Array and kt == TK.Slice {
            let e1 = self.tys.list[from].args[0]
            let e2 = self.tys.list[to].args[0]
            if self.unify(e1, e2) {
                if self.tys.list[to].flag and !self.place_mutable(e) and self.is_place(e) { return NONE }
                return self.wrap_node(TKind.ArrayToSlice, e, target)
            }
            return NONE
        }
        if kf == TK.List and kt == TK.Slice {
            let e1 = self.tys.list[from].args[0]
            let e2 = self.tys.list[to].args[0]
            if self.unify(e1, e2) {
                if self.tys.list[to].flag and self.is_place(e) and !self.place_mutable(e) { return NONE }
                return self.wrap_node(TKind.ListToSlice, e, target)
            }
            return NONE
        }
        if kf == TK.Str and kt == TK.Slice {
            let e2 = self.tys.shallow(self.tys.list[to].args[0])
            if self.tys.kind(e2) == TK.Int and self.tys.list[e2].name == "u8" {
                if self.tys.list[to].flag and self.is_place(e) and !self.place_mutable(e) { return NONE }
                return self.wrap_node(TKind.StrToSlice, e, target)
            }
            return NONE
        }
        if kf == TK.Slice and kt == TK.Slice and self.tys.list[from].flag and !self.tys.list[to].flag {
            if self.unify(self.tys.list[from].args[0], self.tys.list[to].args[0]) { return self.retype(e, target) }
            return NONE
        }
        if kf == TK.Ptr and kt == TK.Ptr and self.tys.list[from].flag and !self.tys.list[to].flag {
            if self.unify(self.tys.list[from].args[0], self.tys.list[to].args[0]) { return self.retype(e, target) }
            return NONE
        }
        // *T -> dyn Trait (a fat pointer; the pointee must implement the trait)
        if kf == TK.Ptr and kt == TK.Dyn {
            let inner = self.tys.resolve(self.tys.list[from].args[0], true)
            let trait_id = self.tys.list[to].def
            let tname = self.traits[trait_id].name.clone()
            if !self.type_satisfies_trait(inner, tname[..]) { return NONE }
            let vt = self.vtable_for(trait_id, inner, self.tir.nodes[e].start)
            if vt == NONE { return NONE }
            // every method must satisfy the trait object's negative bounds
            let need_neg = EFF_ALL & ~self.tys.list[to].n
            let vinsts = self.vtables[vt].insts.clone()
            for vi in vinsts { self.oblige(vi, need_neg, self.tir.nodes[e].start) }
            let r = self.wrap_node(TKind.DynFrom, e, target)
            self.tir.nodes[r].a = vt
            return r
        }
        if kf == TK.Fn and kt == TK.Fn {
            let pa = self.tys.list[from].args.clone()
            let pb = self.tys.list[to].args.clone()
            if pa.len == pb.len and self.unify_all(pa[..], pb[..]) {
                // the target may forbid effects the value has
                let need_neg = EFF_ALL & ~self.tys.list[to].n
                if need_neg != 0 {
                    let k = self.tir.nodes[e].k
                    if k == TKind.FnToFat or k == TKind.Closure {
                        self.oblige(self.tir.nodes[e].a, need_neg, self.tir.nodes[e].start)
                    } else if (self.tys.list[from].n & ~self.tys.list[to].n) != 0 {
                        return NONE
                    }
                }
                return self.retype(e, target)
            }
            return NONE
        }
        if self.unify(from, to) { return self.retype(e, target) }
        return NONE
    }

    fn coerce_or_error(self: *mut Self, e: usize, target: usize, what: []u8) -> usize {
        let r = self.coerce(e, target)
        if r != NONE { return r }
        let got = self.ty_name(self.tir.nodes[e].ty)
        let want = self.ty_name(target)
        self.fail_here(self.tir.nodes[e].start, format("type mismatch in {}: expected `{}` but found `{}`", .{what, want, got})[..])
        return self.retype(e, target)
    }

    fn finalize_expr(self: *mut Self, e: usize) -> usize {
        let t = self.tys.resolve(self.tir.nodes[e].ty, true)
        self.tir.nodes[e].ty = t
        return e
    }

    fn mk(self: *mut Self, k: TKind, ty: usize, start: usize, end: usize) -> usize {
        return self.tir.add(tblank(k, ty, start, end))
    }

    fn error_expr(self: *mut Self, start: usize, end: usize) -> usize {
        let n = self.tys.never()
        return self.mk(TKind.Unreachable, n, start, end)
    }

    // ----- ranges ------------------------------------------------------------------------

    fn type_range(self: *mut Self, t0: usize) -> ?Range {
        let t = self.tys.shallow(t0)
        let k = self.tys.kind(t)
        if k == TK.Int {
            let name = self.tys.list[t].name.clone()
            return Range{ .lo = int_min(name[..]), .hi = int_max(name[..]) }
        }
        if k == TK.Bool { return Range{ .lo = 0, .hi = 1 } }
        if k == TK.Char { return Range{ .lo = 0, .hi = 0x10FFFF } }
        return null
    }

    fn expr_range(self: *mut Self, e: usize) -> ?Range {
        let k = self.tir.nodes[e].k
        if k == TKind.Int or k == TKind.Char { return Range{ .lo = self.tir.nodes[e].ival, .hi = self.tir.nodes[e].ival } }
        if k == TKind.Bool {
            let v: i128 = if self.tir.nodes[e].flag { 1 } else { 0 }
            return Range{ .lo = v, .hi = v }
        }
        if k == TKind.Value and self.tir.nodes[e].name == "int" { return Range{ .lo = self.tir.nodes[e].ival, .hi = self.tir.nodes[e].ival } }
        if k == TKind.Local {
            let l = self.tir.nodes[e].a
            if let r = self.ctx().ranges.get(l) { return r }
            return self.type_range(self.ctx().locals[l].ty)
        }
        if k == TKind.Cast and self.tir.nodes[e].name.len >= 10 and self.tir.nodes[e].name[0..10] == "int_to_int" {
            let inner = self.expr_range(self.tir.nodes[e].kids[0]) orelse return null
            let tr = self.type_range(self.tir.nodes[e].ty) orelse return null
            return Range{ .lo = max128(inner.lo, tr.lo), .hi = min128(inner.hi, tr.hi) }
        }
        if k == TKind.Binary {
            let op = self.tir.nodes[e].text.clone()
            let a = self.expr_range(self.tir.nodes[e].kids[0]) orelse return null
            let b = self.expr_range(self.tir.nodes[e].kids[1]) orelse return null
            var r = Range{ .lo = 0, .hi = 0 }
            var known = true
            if op == "+" or op == "+%" or op == "+|" {
                r = Range{ .lo = sat_add(a.lo, b.lo), .hi = sat_add(a.hi, b.hi) }
            } else if op == "-" or op == "-%" or op == "-|" {
                r = Range{ .lo = sat_sub(a.lo, b.hi), .hi = sat_sub(a.hi, b.lo) }
            } else if op == "*" or op == "*%" or op == "*|" {
                let c0 = sat_mul(a.lo, b.lo)
                let c1 = sat_mul(a.lo, b.hi)
                let c2 = sat_mul(a.hi, b.lo)
                let c3 = sat_mul(a.hi, b.hi)
                r = Range{ .lo = min128(min128(c0, c1), min128(c2, c3)), .hi = max128(max128(c0, c1), max128(c2, c3)) }
            } else if op == "%" and b.lo > 0 {
                r = Range{ .lo = max128(0, min128(a.lo, 0)), .hi = min128(b.hi - 1, max128(a.hi, 0)) }
            } else if op == "/" and b.lo > 0 {
                r = Range{ .lo = min128(min128(a.lo, 0), a.lo / b.lo), .hi = max128(max128(a.hi, 0), a.hi / b.lo) }
            } else if op == "&" and b.lo >= 0 and a.lo >= 0 {
                r = Range{ .lo = 0, .hi = min128(a.hi, b.hi) }
            } else if op == ">>" and a.lo >= 0 and b.lo >= 0 {
                r = Range{ .lo = a.lo >> (min128(b.hi, 127) as u32), .hi = a.hi >> (min128(b.lo, 127) as u32) }
            } else {
                known = false
            }
            if !known { return self.type_range(self.tir.nodes[e].ty) }
            let wrapping = op == "+%" or op == "-%" or op == "*%" or op == "+|" or op == "-|" or op == "*|"
            if wrapping {
                if let tr = self.type_range(self.tir.nodes[e].ty) {
                    return Range{ .lo = max128(r.lo, tr.lo), .hi = min128(r.hi, tr.hi) }
                }
            }
            return r
        }
        if k == TKind.Builtin and self.tir.nodes[e].name == "Len" {
            let arg = self.tir.nodes[e].kids[0]
            let at = self.tys.shallow(self.tir.nodes[arg].ty)
            if self.tys.kind(at) == TK.Array {
                let n = self.tys.list[at].n as i128
                return Range{ .lo = n, .hi = n }
            }
            return Range{ .lo = 0, .hi = 170141183460469231731687303715884105727 }
        }
        return self.type_range(self.tir.nodes[e].ty)
    }

    /// The range of a checked operation before clamping to its type: null on overflow of i128.
    fn expr_range_raw(self: *mut Self, e: usize) -> ?Range {
        if self.tir.nodes[e].k != TKind.Binary { return self.expr_range(e) }
        let op = self.tir.nodes[e].text.clone()
        let a = self.expr_range(self.tir.nodes[e].kids[0]) orelse return null
        let b = self.expr_range(self.tir.nodes[e].kids[1]) orelse return null
        if op == "+" {
            let lo = checked_add(a.lo, b.lo) orelse return null
            let hi = checked_add(a.hi, b.hi) orelse return null
            return Range{ .lo = lo, .hi = hi }
        }
        if op == "-" {
            let lo = checked_sub(a.lo, b.hi) orelse return null
            let hi = checked_sub(a.hi, b.lo) orelse return null
            return Range{ .lo = lo, .hi = hi }
        }
        if op == "*" {
            let c0 = checked_mul(a.lo, b.lo) orelse return null
            let c1 = checked_mul(a.lo, b.hi) orelse return null
            let c2 = checked_mul(a.hi, b.lo) orelse return null
            let c3 = checked_mul(a.hi, b.hi) orelse return null
            return Range{ .lo = min128(min128(c0, c1), min128(c2, c3)), .hi = max128(max128(c0, c1), max128(c2, c3)) }
        }
        if op == "/" and b.lo > 0 { return Range{ .lo = min128(a.lo, 0), .hi = max128(a.hi, 0) } }
        if op == "%" and b.lo > 0 { return Range{ .lo = min128(a.lo, 0), .hi = min128(b.hi - 1, max128(a.hi, 0)) } }
        return null
    }

    // ----- expressions ---------------------------------------------------------------------

    fn check_expr(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let k = n.k
        let start = n.start
        let end = n.end
        if k == parser.NodeKind.Lit { return self.check_lit(e, expected) }
        if k == parser.NodeKind.Ident { return self.check_ident(n.name.clone()[..], start, end) }
        if k == parser.NodeKind.Unary { return self.check_unary(e, expected) }
        if k == parser.NodeKind.Binary {
            let op = n.name.clone()
            let l = n.x
            let r = n.y
            return self.check_binary_parts(op[..], l, r, expected, start, end)
        }
        if k == parser.NodeKind.Call { return self.check_call(e, expected) }
        if k == parser.NodeKind.If { return self.check_if(e, expected) }
        if k == parser.NodeKind.Block {
            let tb = self.check_block_labeled(e, expected)
            let ty = self.tir.nodes[tb].ty
            let be = self.mk(TKind.BlockExpr, ty, self.tir.nodes[tb].start, self.tir.nodes[tb].end)
            self.tir.nodes[be].kids.append(tb)
            return be
        }
        if k == parser.NodeKind.Cast { return self.check_cast(e) }
        if k == parser.NodeKind.FieldE { return self.check_field(e, expected) }
        if k == parser.NodeKind.ImplicitVariant { return self.check_implicit_variant(e, expected) }
        if k == parser.NodeKind.Index { return self.check_index(e) }
        if k == parser.NodeKind.SliceE { return self.check_slice_op(e) }
        if k == parser.NodeKind.StructLit { return self.check_struct_lit(e, expected) }
        if k == parser.NodeKind.ArrayLit { return self.check_array_lit(e, expected) }
        if k == parser.NodeKind.TupleLit { return self.check_tuple_lit(e, expected) }
        if k == parser.NodeKind.Try { return self.check_try(e) }
        if k == parser.NodeKind.Catch { return self.check_catch(e, expected) }
        if k == parser.NodeKind.OrElse { return self.check_orelse(e, expected) }
        if k == parser.NodeKind.IfCapture { return self.check_if_capture(e, expected) }
        if k == parser.NodeKind.MethodCall { return self.check_method_call(e, expected) }
        if k == parser.NodeKind.Match { return self.check_match(e, expected) }
        if k == parser.NodeKind.Closure { return self.check_closure(e, expected) }
        if k == parser.NodeKind.BinConstruct { return self.check_bin_construct(e) }
        if k == parser.NodeKind.Comptime {
            // evaluated at compile time; the stage-2 evaluator folds scalars,
            // calls are a later stage (the expression is kept as checked)
            let inner_node = n.x
            let saved = self.ctx().is_comptime
            self.ctx().is_comptime = true
            var inner = self.check_expr(inner_node, expected)
            self.ctx().is_comptime = saved
            inner = self.finalize_expr(inner)
            if let v = self.eval_const_expr(inner) { return self.value_node(&v, self.tir.nodes[inner].ty, start, end) }
            self.fail_here(start, "this expression cannot be evaluated at compile time")
            return inner
        }
        if k == parser.NodeKind.Builtin { return self.check_at_builtin(e, expected) }
        if k == parser.NodeKind.Null {
            var t = NONE
            if expected != NONE {
                let ex = self.tys.shallow(expected)
                if self.tys.kind(ex) == TK.Opt { t = ex }
                if self.tys.kind(ex) == TK.Infer {
                    let v = self.tys.fresh_infer()
                    let o = self.tys.wrap(TK.Opt, v, false)
                    _ = self.unify(ex, o)
                    t = o
                }
            }
            if t == NONE {
                let v = self.tys.fresh_infer()
                t = self.tys.wrap(TK.Opt, v, false)
            }
            return self.mk(TKind.OptNull, t, start, end)
        }
        if k == parser.NodeKind.Undefined {
            if expected != NONE { return self.mk(TKind.Undefined, expected, start, end) }
            self.fail_here(start, "`undefined` needs a type from context, e.g. `var buf: [1500]u8 = undefined`")
            return self.error_expr(start, end)
        }
        if k == parser.NodeKind.Unreachable {
            self.add_effect(EFF_PANICS, start, "`unreachable` panics if reached")
            let nv = self.tys.never()
            return self.mk(TKind.Unreachable, nv, start, end)
        }
        if k == parser.NodeKind.ErrorLit {
            let name = n.name.clone()
            let id = self.error_id(name[..])
            let t = self.tys.err_set(0, false)
            let te = self.mk(TKind.ErrVal, t, start, end)
            self.tir.nodes[te].a = id
            if expected != NONE {
                let r = self.coerce(te, expected)
                if r != NONE { return r }
            }
            return te
        }
        if k == parser.NodeKind.Unwrap {
            let inner_node = n.x
            let inner = self.check_expr(inner_node, NONE)
            let t = self.tys.shallow(self.tir.nodes[inner].ty)
            if self.tys.kind(t) == TK.Opt {
                self.add_effect(EFF_PANICS, start, "`.?` panics when the optional is null")
                let r = self.mk(TKind.Unwrap, self.tys.list[t].args[0], start, end)
                self.tir.nodes[r].kids.append(inner)
                return r
            }
            self.fail_here(start, format("`.?` requires an optional but found `{}`", .{self.ty_name(t)})[..])
            return self.error_expr(start, end)
        }
        if k == parser.NodeKind.Deref {
            let inner_node = n.x
            let inner = self.check_expr(inner_node, NONE)
            let t = self.tys.shallow(self.tir.nodes[inner].ty)
            if self.tys.kind(t) == TK.Ptr {
                let r = self.mk(TKind.Deref, self.tys.list[t].args[0], start, end)
                self.tir.nodes[r].kids.append(inner)
                return r
            }
            self.fail_here(start, format("`.*` requires a pointer but found `{}`", .{self.ty_name(t)})[..])
            return self.error_expr(start, end)
        }
        if k == parser.NodeKind.TypeVal {
            let ty_node = n.x
            let st = self.ctx().self_ty
            let t = self.resolve_type(m, ty_node, st)
            let tt = self.tys.type_ty()
            let r = self.mk(TKind.TypeVal, tt, start, end)
            self.tir.nodes[r].a = t
            return r
        }
        if k == parser.NodeKind.UnsafeE {
            let body = n.x
            self.ctx().unsafe_depth += 1
            let tb = self.check_block(body, expected, NONE, NONE)
            self.ctx().unsafe_depth -= 1
            let ty = self.tir.nodes[tb].ty
            let be = self.mk(TKind.BlockExpr, ty, start, end)
            self.tir.nodes[be].kids.append(tb)
            return be
        }
        let snippet = self.source_text(m, start, if end - start > 40 { start + 40 } else { end })
        self.fail_here(start, format("unsupported expression (stage 2): `{}`", .{snippet})[..])
        return self.error_expr(start, end)
    }

    fn check_lit(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let kind = n.text.clone()
        let text = n.name.clone()
        let start = n.start
        let end = n.end
        var exp = NONE
        if expected != NONE { exp = self.tys.shallow(expected) }
        if kind == "int" {
            let v = text[..].parse_int(i128) catch { 0 }
            if exp != NONE {
                let ek = self.tys.kind(exp)
                if ek == TK.Int {
                    let name = self.tys.list[exp].name.clone()
                    if v < int_min(name[..]) or v > int_max(name[..]) {
                        self.fail_here(start, format("literal `{}` does not fit in `{}` (range {} to {})", .{v, name, int_min(name[..]), int_max(name[..])})[..])
                    }
                    return self.int_node(v, exp, start, end)
                }
                if ek == TK.Float { return self.float_node(v as f64, exp, start, end) }
                if let ik = self.tys.infer_kind_of(exp) {
                    if ik == INFER_FLOAT { return self.float_node(v as f64, exp, start, end) }
                    if ik == INFER_INT { return self.int_node(v, exp, start, end) }
                }
                if ek == TK.Distinct {
                    let u = self.distinct_underlying(self.tys.list[exp].def)
                    if self.tys.is_integer(u) { return self.int_node(v, exp, start, end) }
                    if self.tys.is_float(u) { return self.float_node(v as f64, exp, start, end) }
                }
            }
            let t = self.tys.int_lit()
            return self.int_node(v, t, start, end)
        }
        if kind == "float" {
            let f = text[..].parse_float() catch { 0.0 }
            if exp != NONE {
                if self.tys.kind(exp) == TK.Float { return self.float_node(f, exp, start, end) }
                if self.tys.kind(exp) == TK.Distinct {
                    let u = self.distinct_underlying(self.tys.list[exp].def)
                    if self.tys.is_float(u) { return self.float_node(f, exp, start, end) }
                }
            }
            let t = self.tys.float_lit()
            return self.float_node(f, t, start, end)
        }
        if kind == "str" or kind == "bytes" {
            let t = self.tys.str_slice()
            // `[N]u8` from a string literal when an array of that length is expected
            if exp != NONE and self.tys.kind(exp) == TK.Array {
                let et = self.tys.shallow(self.tys.list[exp].args[0])
                if self.tys.list[exp].n as usize == text.len and self.tys.kind(et) == TK.Int and self.tys.list[et].name == "u8" {
                    let u8t = self.tys.u8_ty()
                    let arr = self.mk(TKind.ArrayLit, exp, start, end)
                    for b in text {
                        let el = self.int_node(b as i128, u8t, start, end)
                        self.tir.nodes[arr].kids.append(el)
                    }
                    return arr
                }
            }
            let r = self.mk(TKind.Str, t, start, end)
            self.tir.nodes[r].text = text.clone()
            return r
        }
        if kind == "char" {
            let c = text[..].parse_int(i128) catch { 0 }
            if exp != NONE and self.tys.kind(exp) == TK.Int {
                let name = self.tys.list[exp].name.clone()
                if c <= int_max(name[..]) { return self.int_node(c, exp, start, end) }
                self.fail_here(start, format("character literal does not fit in `{}`", .{name})[..])
            }
            let t = self.tys.char_ty()
            let r = self.mk(TKind.Char, t, start, end)
            self.tir.nodes[r].ival = c
            return r
        }
        if kind == "bool" {
            let t = self.tys.bool_ty()
            let r = self.mk(TKind.Bool, t, start, end)
            self.tir.nodes[r].flag = text == "true"
            return r
        }
        self.fail_here(start, "unknown literal")
        return self.error_expr(start, end)
    }

    fn int_node(self: *mut Self, v: i128, ty: usize, start: usize, end: usize) -> usize {
        let r = self.mk(TKind.Int, ty, start, end)
        self.tir.nodes[r].ival = v
        return r
    }
    fn float_node(self: *mut Self, v: f64, ty: usize, start: usize, end: usize) -> usize {
        let r = self.mk(TKind.Float, ty, start, end)
        self.tir.nodes[r].fval = v
        return r
    }

    fn distinct_underlying(self: *mut Self, alias: usize) -> usize {
        let a_node = self.aliases[alias].node
        let a_mod = self.aliases[alias].module
        let target_node = self.node(a_mod, a_node).x
        return self.resolve_type(a_mod, target_node, NONE)
    }

    fn check_ident(self: *mut Self, name: []u8, start: usize, end: usize) -> usize {
        let l = self.lookup_local(name)
        if l != NONE {
            let ty = self.ctx().locals[l].ty
            if let moved_at = self.ctx().moved.get(l) {
                _ = moved_at
                self.fail_here(start, format("use of `{}` after it was moved", .{name})[..])
            }
            let r = self.mk(TKind.Local, ty, start, end)
            self.tir.nodes[r].a = l
            if self.lookup_deref(name) {
                let pt = self.tys.shallow(ty)
                let inner = if self.tys.kind(pt) == TK.Ptr { self.tys.list[pt].args[0] } else { ty }
                let d = self.mk(TKind.Deref, inner, start, end)
                self.tir.nodes[d].kids.append(r)
                return d
            }
            return r
        }
        let m = self.cur_module()
        if let item = self.lookup(m, name) {
            if item.kind == ItemKind.Fn {
                let fid = item.id
                if self.fns[fid].is_generic {
                    self.fail_here(start, format("`{}` is generic; call it with arguments so its type parameters can be inferred", .{name})[..])
                    return self.error_expr(start, end)
                }
                if self.fn_takes_own(fid) {
                    self.fail_here(start, format("`{}` takes `own` parameters and cannot be used as a function value; call it directly", .{name})[..])
                    return self.error_expr(start, end)
                }
                let inst = self.instantiate(fid, List(usize).new())
                var ps = List(usize).new()
                for p in self.insts[inst].params { ps.append(self.insts[inst].locals[p].ty) }
                let r = self.insts[inst].ret
                let neg = self.insts[inst].declared_neg
                let ft = self.tys.func(ps, r, EFF_ALL & ~neg)
                let te = self.mk(TKind.FnToFat, ft, start, end)
                self.tir.nodes[te].a = inst
                return te
            }
            if item.kind == ItemKind.Const {
                let ty = self.resolve_const(item.id)
                // a scalar constant is inlined as its value
                let init = self.consts[item.id].value
                if init != NONE {
                    if let v = self.eval_const(init) { return self.value_node(&v, ty, start, end) }
                }
                let te = self.mk(TKind.Const, ty, start, end)
                self.tir.nodes[te].a = item.id
                return te
            }
            if item.kind == ItemKind.Global {
                let ty = self.globals[item.id].ty
                if self.ctx().unsafe_depth == 0 and !self.ctx().is_comptime {
                    self.fail_here(start, format("access to mutable global `{}` requires an `unsafe` block", .{name})[..])
                }
                self.add_effect(EFF_SHARED_MUTABLE, start, "access to a mutable global")
                self.global_uses.append(Obligation{ .inst = item.id, .neg = 0, .at = start, .module = m })
                self.global_use_fns.append(self.ctx().fn_name.clone())
                let te = self.mk(TKind.Global, ty, start, end)
                self.tir.nodes[te].a = item.id
                return te
            }
            if item.kind == ItemKind.Struct or item.kind == ItemKind.Enum {
                let n_params = if item.kind == ItemKind.Struct { self.structs[item.id].tparams.len } else { self.enums[item.id].tparams.len }
                if n_params > 0 {
                    self.fail_here(start, format("`{}` is generic; write `{}(...)`", .{name, name})[..])
                    return self.error_expr(start, end)
                }
                let t = self.tys.of_def(if item.kind == ItemKind.Struct { TK.Struct } else { TK.Enum }, item.id, List(usize).new())
                return self.type_val(t, start, end)
            }
            if item.kind == ItemKind.Alias {
                let t = self.resolve_alias(item.id)
                return self.type_val(t, start, end)
            }
            if item.kind == ItemKind.ErrorSet {
                let t = self.tys.err_set(item.id, true)
                return self.type_val(t, start, end)
            }
            if item.kind == ItemKind.Trait {
                self.fail_here(start, format("`{}` is a trait and cannot be used as a value", .{name})[..])
                return self.error_expr(start, end)
            }
            if item.kind == ItemKind.Module {
                let te = self.mk(TKind.Unit, NONE, start, end)
                self.tir.nodes[te].name = format("module:{}", .{item.id})
                return te
            }
        }
        let g = self.env_lookup(name)
        if g != NONE { return self.type_val(g, start, end) }
        if name == "String" {
            let t = self.tys.string()
            return self.type_val(t, start, end)
        }
        if name == "List" or name == "Map" or is_builtin_namespace(name) or name == "context" or name == "Ordering" {
            let te = self.mk(TKind.Unit, NONE, start, end)
            self.tir.nodes[te].name = String.from(name)
            return te
        }
        self.fail_here(start, format("cannot find `{}` in this scope", .{name})[..])
        return self.error_expr(start, end)
    }

    fn type_val(self: *mut Self, t: usize, start: usize, end: usize) -> usize {
        let tt = self.tys.type_ty()
        let r = self.mk(TKind.TypeVal, tt, start, end)
        self.tir.nodes[r].a = t
        return r
    }

    fn check_unary(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let op = n.name.clone()
        let inner_node = n.x
        let start = n.start
        let end = n.end
        if op == "&" or op == "&mut" {
            let mutable = op == "&mut"
            var inner_expected = NONE
            if expected != NONE {
                let ex = self.tys.shallow(expected)
                if self.tys.kind(ex) == TK.Ptr { inner_expected = self.tys.list[ex].args[0] }
            }
            let inner = self.check_expr(inner_node, inner_expected)
            if mutable and self.is_place(inner) and !self.place_mutable(inner) {
                self.fail_here(start, "cannot take a mutable reference to an immutable value; declare it with `var`")
            }
            let it = self.tir.nodes[inner].ty
            let pt = self.tys.wrap(TK.Ptr, it, mutable)
            let r = self.mk(TKind.AddrOf, pt, start, end)
            self.tir.nodes[r].flag = mutable
            self.tir.nodes[r].kids.append(inner)
            return r
        }
        if op == "!" {
            let bt = self.tys.bool_ty()
            var inner = self.check_expr(inner_node, bt)
            inner = self.coerce_or_error(inner, bt, "operand of `!`")
            return self.unary_node("!", "plain", inner, bt, start, end)
        }
        if op == "-" {
            let inner = self.check_expr(inner_node, expected)
            let t = self.tys.shallow(self.tir.nodes[inner].ty)
            if self.tys.is_float(t) { return self.unary_node("-", "float", inner, t, start, end) }
            if self.tys.is_integer(t) {
                if self.tys.kind(t) == TK.Int and !int_signed(self.tys.list[t].name[..]) {
                    self.fail_here(start, format("cannot negate a value of unsigned type `{}`", .{self.tys.list[t].name})[..])
                }
                var proven = false
                if let r = self.expr_range(inner) {
                    if let tr = self.type_range(t) { proven = r.lo > tr.lo }
                }
                if !proven { self.add_effect(EFF_PANICS, start, "negation overflows for the minimum value") }
                return self.unary_node("-", "checked", inner, t, start, end)
            }
            if self.tys.kind(t) == TK.Distinct {
                let u = self.distinct_underlying(self.tys.list[t].def)
                let mode = if self.tys.is_float(u) { "float" } else { "checked" }
                return self.unary_node("-", mode, inner, t, start, end)
            }
            self.fail_here(start, format("cannot negate a value of type `{}`", .{self.ty_name(t)})[..])
            return self.error_expr(start, end)
        }
        // `~`
        let inner = self.check_expr(inner_node, expected)
        let t = self.tys.shallow(self.tir.nodes[inner].ty)
        if !self.tys.is_integer(t) { self.fail_here(start, format("`~` requires an integer but found `{}`", .{self.ty_name(t)})[..]) }
        return self.unary_node("~", "plain", inner, t, start, end)
    }

    fn unary_node(self: *mut Self, op: []u8, mode: []u8, inner: usize, ty: usize, start: usize, end: usize) -> usize {
        let r = self.mk(TKind.Unary, ty, start, end)
        self.tir.nodes[r].name = String.from(mode)
        self.tir.nodes[r].text = String.from(op)
        self.tir.nodes[r].kids.append(inner)
        return r
    }

    fn binary_node(self: *mut Self, op: []u8, mode: []u8, proven: bool, l: usize, r: usize, ty: usize, start: usize, end: usize) -> usize {
        let b = self.mk(TKind.Binary, ty, start, end)
        self.tir.nodes[b].text = String.from(op)
        self.tir.nodes[b].name = String.from(mode)
        self.tir.nodes[b].flag = proven
        self.tir.nodes[b].kids.append(l)
        self.tir.nodes[b].kids.append(r)
        return b
    }

    fn check_binary_parts(self: *mut Self, op: []u8, lhs: usize, rhs: usize, expected: usize, start: usize, end: usize) -> usize {
        if op == "and" or op == "or" {
            let bt = self.tys.bool_ty()
            var l = self.check_expr(lhs, bt)
            l = self.coerce_or_error(l, bt, "operand of a logical operator")
            var r = self.check_expr(rhs, bt)
            r = self.coerce_or_error(r, bt, "operand of a logical operator")
            let node = self.mk(TKind.Logical, bt, start, end)
            self.tir.nodes[node].flag = op == "and"
            self.tir.nodes[node].kids.append(l)
            self.tir.nodes[node].kids.append(r)
            return node
        }
        if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=" {
            return self.check_comparison(op, lhs, rhs, start, end)
        }
        let is_arith = op == "+" or op == "-" or op == "*" or op == "/" or op == "%" or op == "+%" or op == "-%" or op == "*%" or op == "+|" or op == "-|" or op == "*|"
        let is_bitwise = op == "&" or op == "|" or op == "^" or op == "<<" or op == ">>"
        let hint = if is_arith { expected } else { NONE }
        let l = self.check_expr(lhs, hint)
        let lt = self.tys.shallow(self.tir.nodes[l].ty)
        if op == "<<" or op == ">>" {
            let r = self.check_expr(rhs, NONE)
            let rt = self.tys.shallow(self.tir.nodes[r].ty)
            if !self.tys.is_integer(lt) or !self.tys.is_integer(rt) { self.fail_here(start, "shift operands must be integers") }
            var bits: i128 = 64
            var have_bits = false
            if self.tys.kind(lt) == TK.Int {
                bits = int_bits(self.tys.list[lt].name[..]) as i128
                have_bits = true
            }
            var proven = false
            if let rr = self.expr_range(r) { proven = rr.lo >= 0 and rr.hi < bits }
            _ = have_bits
            if !proven { self.add_effect(EFF_PANICS, start, "shift amount may exceed the bit width") }
            let res = self.tys.resolve(lt, false)
            return self.binary_node(op, "checked", proven, l, r, res, start, end)
        }
        var r = self.check_expr(rhs, lt)
        let rc = self.coerce(r, lt)
        if rc == NONE {
            let rt = self.tir.nodes[r].ty
            let ln = self.ty_name(lt)
            let rn = self.ty_name(rt)
            let lc = self.coerce(l, rt)
            if lc != NONE {
                self.fail_here(start, format("mismatched operand types `{}` and `{}` for `{}`; numeric conversions are explicit (`as`)", .{ln, rn, op})[..])
            } else {
                self.fail_here(start, format("mismatched operand types `{}` and `{}` for `{}`", .{ln, rn, op})[..])
            }
            return self.error_expr(start, end)
        }
        r = rc
        let t = self.tys.shallow(self.tir.nodes[l].ty)
        var under = t
        if self.tys.kind(t) == TK.Distinct { under = self.distinct_underlying(self.tys.list[t].def) }
        let is_int = self.tys.is_integer(under)
        let is_float = self.tys.is_float(under)
        let is_bool = self.tys.kind(self.tys.shallow(under)) == TK.Bool
        if is_bitwise and ! (is_int or is_bool) {
            self.fail_here(start, format("bitwise `{}` requires integer operands but found `{}`", .{op, self.ty_name(t)})[..])
            return self.error_expr(start, end)
        }
        if is_arith and ! (is_int or is_float) {
            self.fail_here(start, format("cannot apply `{}` to values of type `{}`", .{op, self.ty_name(t)})[..])
            return self.error_expr(start, end)
        }
        var mode = "checked"
        let wrapping = op == "+%" or op == "-%" or op == "*%"
        let saturating = op == "+|" or op == "-|" or op == "*|"
        if is_float {
            if wrapping or saturating { self.fail_here(start, "wrapping and saturating operators apply to integers only") }
            mode = "float"
        } else if is_bool {
            mode = "plain"
        } else if wrapping {
            mode = "wrap"
        } else if saturating {
            mode = "sat"
        } else if op == "&" or op == "|" or op == "^" {
            mode = "plain"
        }
        var proven = true
        if mode == "checked" {
            let tmp = self.binary_node(op, mode, false, l, r, t, start, end)
            var fits = false
            if let rr = self.expr_range_raw(tmp) {
                if let tr = self.type_range(under) { fits = rr.lo >= tr.lo and rr.hi <= tr.hi }
            }
            var div_ok = true
            if op == "/" or op == "%" {
                div_ok = false
                if let rr = self.expr_range(r) { div_ok = rr.lo > 0 or rr.hi < 0 }
            }
            proven = fits and div_ok
            if !proven {
                let why = if op == "/" or op == "%" { "division may divide by zero or overflow" } else { "arithmetic may overflow (use `+%` to wrap or `+|` to saturate)" }
                self.add_effect(EFF_PANICS, start, why)
            }
        }
        let res = self.tys.resolve(t, false)
        return self.binary_node(op, mode, proven, l, r, res, start, end)
    }

    fn check_comparison(self: *mut Self, op: []u8, lhs: usize, rhs: usize, start: usize, end: usize) -> usize {
        let bt = self.tys.bool_ty()
        var l = self.check_expr(lhs, NONE)
        let lt = self.tys.shallow(self.tir.nodes[l].ty)
        var r = self.check_expr(rhs, lt)
        let rc = self.coerce(r, lt)
        if rc != NONE {
            r = rc
        } else {
            let rt = self.tir.nodes[r].ty
            let lc = self.coerce(l, rt)
            if lc == NONE {
                self.fail_here(start, format("cannot compare `{}` with `{}`", .{self.ty_name(self.tir.nodes[l].ty), self.ty_name(rt)})[..])
                return self.error_expr(start, end)
            }
            l = lc
        }
        let t = self.tys.shallow(self.tir.nodes[l].ty)
        var under = t
        if self.tys.kind(t) == TK.Distinct { under = self.tys.shallow(self.distinct_underlying(self.tys.list[t].def)) }
        let k = self.tys.kind(under)
        let ordered = op == "<" or op == "<=" or op == ">" or op == ">="
        if k == TK.Int or k == TK.Float or k == TK.Char or k == TK.Infer {
            // fine
        } else if (k == TK.Bool or k == TK.Ptr or k == TK.ErrorSet) and !ordered {
            // fine
        } else if k == TK.Slice {
            let el = self.tys.list[under].args[0]
            let es = self.tys.shallow(el)
            let is_u8 = self.tys.kind(es) == TK.Int and self.tys.list[es].name == "u8"
            if !is_u8 and ordered { self.fail_here(start, format("cannot order values of type `{}`", .{self.ty_name(t)})[..]) }
            let cmp = self.builtin_node("SliceEq", bt, start, end)
            self.tir.nodes[cmp].kids.append(l)
            self.tir.nodes[cmp].kids.append(r)
            self.tir.nodes[cmp].kids2.append(el)
            return self.finish_compare(op, cmp, start, end)
        } else if k == TK.Str {
            let u8t = self.tys.u8_ty()
            let sl = self.tys.wrap(TK.Slice, u8t, false)
            let l2 = self.wrap_node(TKind.StrToSlice, l, sl)
            let r2 = self.wrap_node(TKind.StrToSlice, r, sl)
            self.tir.nodes[l2].start = start
            self.tir.nodes[l2].end = end
            self.tir.nodes[r2].start = start
            self.tir.nodes[r2].end = end
            let cmp = self.builtin_node("SliceEq", bt, start, end)
            self.tir.nodes[cmp].kids.append(l2)
            self.tir.nodes[cmp].kids.append(r2)
            self.tir.nodes[cmp].kids2.append(u8t)
            return self.finish_compare(op, cmp, start, end)
        } else if k == TK.Enum {
            let d = self.tys.list[under].def
            var all_unit = true
            let em = self.enums[d].module
            let variants = self.enums[d].variants.clone()
            for v in variants { if self.node(em, v).text != "unit" { all_unit = false } }
            let derived = list_has(&self.enums[d].derives, "Eq") or list_has(&self.enums[d].derives, "Ord")
            if ! (all_unit or derived) {
                self.fail_here(start, format("enum `{}` has payloads; add `derive(Eq)` to compare it, or use `match`", .{self.enums[d].name})[..])
            }
            if ordered and !list_has(&self.enums[d].derives, "Ord") {
                self.fail_here(start, format("enum `{}` is not ordered; add `derive(Ord)`", .{self.enums[d].name})[..])
            }
        } else if k == TK.Struct {
            let d = self.tys.list[under].def
            if self.structs[d].kind == "ref" and !ordered {
                let cmp = self.builtin_node("RefEq", bt, start, end)
                self.tir.nodes[cmp].kids.append(l)
                self.tir.nodes[cmp].kids.append(r)
                return self.finish_compare(op, cmp, start, end)
            }
            let want = if ordered { "Ord" } else { "Eq" }
            if !list_has(&self.structs[d].derives, want) {
                self.fail_here(start, format("`{}` cannot be compared with `{}`; add `derive({})` to the struct", .{self.structs[d].name, op, want})[..])
            }
        } else if k == TK.Opt and !ordered {
            if ! (self.tir.nodes[r].k == TKind.OptNull or self.tir.nodes[l].k == TKind.OptNull) {
                self.fail_here(start, "compare optionals against `null`, or unwrap them first")
            }
        } else {
            self.fail_here(start, format("cannot compare values of type `{}` with `{}`", .{self.ty_name(t), op})[..])
        }
        return self.binary_node(op, "plain", true, l, r, bt, start, end)
    }

    fn finish_compare(self: *mut Self, op: []u8, cmp: usize, start: usize, end: usize) -> usize {
        let bt = self.tys.bool_ty()
        if op == "==" { return cmp }
        if op == "!=" { return self.unary_node("!", "plain", cmp, bt, start, end) }
        // ordered comparison of byte slices: a memcmp-style compare against zero
        let it = self.tys.int("i32")
        let c = self.builtin_node("SliceFind", it, start, end)
        self.tir.nodes[c].kids = self.tir.nodes[cmp].kids.clone()
        self.tir.nodes[c].kids2.append(self.tir.nodes[cmp].kids2[0])
        self.tir.nodes[c].kids2.append(it)
        let zero = self.int_node(0, it, start, end)
        return self.binary_node(op, "plain", true, c, zero, bt, start, end)
    }

    fn builtin_node(self: *mut Self, name: []u8, ty: usize, start: usize, end: usize) -> usize {
        let b = self.mk(TKind.Builtin, ty, start, end)
        self.tir.nodes[b].name = String.from(name)
        return b
    }

    // ----- calls -----------------------------------------------------------------------------

    fn check_call(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let callee = n.x
        let args = n.kids.clone()
        let start = n.start
        let end = n.end
        let cn = self.node(m, callee)
        if cn.k == parser.NodeKind.Ident {
            let name = cn.name.clone()
            if self.lookup_local(name[..]) == NONE {
                let item = self.lookup(m, name[..])
                if item == null {
                    let b = self.check_builtin_fn(name[..], args[..], start, end)
                    if b != NONE { return b }
                    if self.env_lookup(name[..]) == NONE and ! (name == "List" or name == "Map" or name == "String" or name == "Allocator") {
                        self.fail_here(start, format("cannot find function `{}`", .{name})[..])
                        for a in args { _ = self.check_expr(a, NONE) }
                        return self.error_expr(start, end)
                    }
                }
                if let it = item {
                    if it.kind == ItemKind.Fn { return self.call_fn_def(it.id, NONE, args[..], expected, start, end) }
                }
            }
        }
        if cn.k == parser.NodeKind.FieldE {
            // `Type.assoc(...)`, `mod.f(...)`, `ns.f(...)`, or a call through a field of function type
            let base_node = cn.x
            let fname = cn.name.clone()
            let b = self.check_expr(base_node, NONE)
            if self.is_namespace(b) {
                let ns = self.tir.nodes[b].name.clone()
                return self.check_namespace_call(ns[..], fname[..], args[..], expected, start, end)
            }
            let bt = self.tys.shallow(self.tir.nodes[b].ty)
            if self.tys.kind(bt) == TK.Type and self.tir.nodes[b].k == TKind.TypeVal {
                return self.check_static_call(self.tir.nodes[b].a, fname[..], args[..], expected, start, end)
            }
            let f = self.field_access(b, fname[..], cn.start, cn.end)
            return self.call_value(f, args[..], start, end)
        }
        if cn.k == parser.NodeKind.Ident {
            // a generic type instantiated in expression position: `List(i32)`, `Pair(i32, f64)`
            let name = cn.name.clone()
            var is_type = name == "List" or name == "Map" or name == "String"
            if let it = self.lookup(m, name[..]) { if it.kind == ItemKind.Struct or it.kind == ItemKind.Enum { is_type = true } }
            if is_type {
                var targs = List(usize).new()
                for a in args { targs.append(self.expr_as_type(a)) }
                let st = self.ctx().self_ty
                let t = self.named_type(m, name[..], NONE_NAME, targs, start, st)
                return self.type_val(t, start, end)
            }
        }
        let f = self.check_expr(callee, NONE)
        let ft = self.tys.shallow(self.tir.nodes[f].ty)
        if self.tys.kind(ft) == TK.Type and self.tir.nodes[f].k == TKind.TypeVal {
            let tn = self.ty_name(self.tir.nodes[f].a)
            self.fail_here(start, format("`{}` is a type; construct it with `{}{{ .field = value }}`", .{tn, tn})[..])
            return self.error_expr(start, end)
        }
        return self.call_value(f, args[..], start, end)
    }

    fn call_value(self: *mut Self, f: usize, args: []usize, start: usize, end: usize) -> usize {
        let ft = self.tys.shallow(self.tir.nodes[f].ty)
        if self.tys.kind(ft) != TK.Fn {
            self.fail_here(start, format("cannot call a value of type `{}`", .{self.ty_name(ft)})[..])
            for a in args { _ = self.check_expr(a, NONE) }
            return self.error_expr(start, end)
        }
        let all = self.tys.list[ft].args.clone()
        let n_params = all.len - 1
        let ret = all[n_params]
        let eff = self.tys.list[ft].n
        if args.len != n_params {
            self.fail_here(start, format("this function takes {} argument(s) but {} were given", .{n_params, args.len})[..])
            return self.error_expr(start, end)
        }
        var targs = List(usize).new()
        for a, i in args {
            var te = self.check_expr(a, all[i])
            te = self.coerce_or_error(te, all[i], "argument")
            targs.append(te)
        }
        if self.tir.nodes[f].k == TKind.FnToFat {
            let inst = self.tir.nodes[f].a
            self.ctx().callees.append(inst)
            self.ctx().callee_spans.append(start)
            let c = self.mk(TKind.Call, ret, start, end)
            self.tir.nodes[c].a = inst
            self.tir.nodes[c].kids = targs
            return c
        }
        if eff != 0 { self.add_effect(eff, start, "calling through a function value acquires the effects its type permits") }
        let c = self.mk(TKind.CallPtr, ret, start, end)
        self.tir.nodes[c].kids.append(f)
        for t in targs { self.tir.nodes[c].kids.append(t) }
        return c
    }

    /// Call a non-generic definition (stage 2: no type inference of generics yet).
    /// Call a definition, inferring generic arguments from the receiver, the
    /// arguments, explicit type arguments, and the expected type.
    fn call_fn_def(self: *mut Self, fid: usize, self_arg: usize, args: []usize, expected: usize, start: usize, end: usize) -> usize {
        let fm = self.fns[fid].module
        let nm = self.fns[fid].node_module
        let node = self.fns[fid].node
        let impl_id = self.fns[fid].impl_id
        let saved_env = self.env_save()
        var names = List(String).new()
        var tys = List(usize).new()
        var impl_targs = List(usize).new()
        var self_ty = NONE
        if impl_id != NONE {
            let tps = self.impls[impl_id].tparams.clone()
            var bound = List(usize).new()
            if self_arg != NONE {
                // the receiver type (through a pointer) binds the impl's parameters
                var rt = self.tys.resolve(self.tir.nodes[self_arg].ty, true)
                if self.tys.kind(rt) == TK.Ptr { rt = self.tys.list[rt].args[0] }
                if let b = self.match_impl_target(impl_id, rt) { bound = b }
            }
            for tp, i in tps {
                let t = if i < bound.len { bound[i] } else { self.tys.fresh_infer() }
                names.append(tp.clone())
                tys.append(t)
                impl_targs.append(t)
            }
            self.env_set(&names, &tys)
            let target = self.impls[impl_id].target
            self_ty = self.resolve_type(fm, target, NONE)
        }
        let fname = self.node(nm, node).name.clone()
        let param_nodes = self.node(nm, node).kids.clone()
        let type_params = self.fn_type_params(fid)
        // value parameters: everything but the type parameters
        var value_params = List(usize).new()
        for pn in param_nodes { if ! (self.node(nm, pn).flag and self.is_type_param_node(nm, pn)) { value_params.append(pn) } }
        let n_self: usize = if self_arg != NONE { 1 } else { 0 }
        // explicit type arguments come first: `max(i32, a, b)`
        var explicit = false
        if type_params.len > 0 and args.len == value_params.len + type_params.len - n_self {
            explicit = true
            for i in 0..type_params.len { if !self.is_type_arg(args[i]) { explicit = false } }
        }
        var fn_targs = List(usize).new()
        var rest_start: usize = 0
        if explicit {
            for tp, i in type_params {
                let te = self.check_expr(args[i], NONE)
                var t = self.tys.void()
                if self.tir.nodes[te].k == TKind.TypeVal { t = self.tir.nodes[te].a } else { self.fail_here(self.tir.nodes[te].start, "expected a type argument") }
                names.append(tp.clone())
                tys.append(t)
                fn_targs.append(t)
            }
            rest_start = type_params.len
        } else {
            for tp in type_params {
                let t = self.tys.fresh_infer()
                names.append(tp.clone())
                tys.append(t)
                fn_targs.append(t)
            }
        }
        self.env_set(&names, &tys)
        let n_rest = args.len - rest_start
        let is_extern = self.node(nm, node).flag2
        let variadic = self.node(nm, node).b == 1
        if (variadic and n_rest + n_self < value_params.len) or (!variadic and n_rest + n_self != value_params.len) {
            var msg = format("`{}` takes {} argument(s) but {} were given", .{fname, value_params.len - n_self, n_rest})
            if type_params.len > 0 and !explicit { msg.append(" (type parameters are inferred from the arguments)") }
            self.fail_here(start, msg[..])
            var i = rest_start
            while i < args.len { _ = self.check_expr(args[i], NONE); i += 1 }
            self.env_restore(&saved_env)
            return self.error_expr(start, end)
        }
        var targs = List(usize).new()
        var pi: usize = 0
        if self_arg != NONE {
            let pt_node = self.node(nm, value_params[0]).x
            let pt = self.resolve_type(fm, pt_node, self_ty)
            let sa = self.adjust_receiver(self_arg, pt, start, end)
            targs.append(sa)
            pi = 1
        }
        // the expected type helps infer the return type's parameters
        let ret_node = self.node(nm, node).x
        if expected != NONE and ret_node != NONE {
            let rt = self.resolve_type(fm, ret_node, self_ty)
            let saved_errs = self.errors.len
            _ = self.unify(rt, expected)
            while self.errors.len > saved_errs { _ = self.errors.pop() }
        }
        var ai = rest_start
        while ai < args.len {
            if pi >= value_params.len {
                // extra arguments of a C variadic: untyped literals take C's default promotions
                var te = self.check_expr(args[ai], NONE)
                let t = self.tys.shallow(self.tir.nodes[te].ty)
                let tk = self.tys.kind(t)
                if tk == TK.Infer and self.tys.is_integer(t) {
                    te = self.coerce_or_error(te, self.tys.named(TK.Int, "i32"), "variadic argument")
                } else if tk == TK.Infer and self.tys.is_float(t) {
                    te = self.coerce_or_error(te, self.tys.named(TK.Float, "f64"), "variadic argument")
                } else if ! (tk == TK.Int or tk == TK.Float or tk == TK.Bool or tk == TK.Char or tk == TK.Ptr) {
                    self.fail_here(self.tir.nodes[te].start, format("a value of type `{}` cannot be passed to a C variadic parameter; use scalars or pointers", .{self.ty_name(t)})[..])
                }
                targs.append(te)
                ai += 1
                continue
            }
            let pn = self.node(nm, value_params[pi])
            let pname = pn.name.clone()
            let pt_node = pn.x
            let owned = pn.flag2
            pi += 1
            // the parameter type is resolved in the callee's environment, the
            // argument checked in the caller's
            self.env_set(&names, &tys)
            let pt = self.resolve_type(fm, pt_node, self_ty)
            self.env_restore(&saved_env)
            var te = self.check_expr(args[ai], pt)
            te = self.coerce_or_error(te, pt, format("argument `{}`", .{pname})[..])
            if owned { te = self.take_ownership(te) }
            targs.append(te)
            ai += 1
        }
        self.env_restore(&saved_env)
        // every type argument must be known now
        var all_targs = List(usize).new()
        for t in impl_targs {
            let r = self.tys.resolve(t, true)
            if self.tys.contains_infer(r) {
                self.fail_here(start, format("cannot infer all type parameters of `{}`; pass them explicitly", .{fname})[..])
                return self.error_expr(start, end)
            }
            all_targs.append(r)
        }
        for t in fn_targs {
            let r = self.tys.resolve(t, true)
            if self.tys.contains_infer(r) {
                self.fail_here(start, format("cannot infer all type parameters of `{}`; pass them explicitly", .{fname})[..])
                return self.error_expr(start, end)
            }
            all_targs.append(r)
        }
        // where-clause bounds
        let wheres = self.node(nm, node).kids2.clone()
        for w in wheres {
            let wn = self.node(nm, w)
            let pname = wn.name.clone()
            let bounds = wn.text.clone()
            var bt = NONE
            for nm, i in names { if nm == pname { bt = tys[i] } }
            if bt == NONE { continue }
            let t = self.tys.resolve(bt, true)
            let bnames = Checker.split_words(bounds[..])
            for b in bnames {
                if !self.type_satisfies_trait(t, b[..]) {
                    self.fail_here(start, format("`{}` requires `{}: {}`, but `{}` does not implement `{}`", .{fname, pname, b, self.ty_name(t), b})[..])
                }
            }
        }
        let inst = self.instantiate(fid, all_targs)
        let ret = self.insts[inst].ret
        self.ctx().callees.append(inst)
        self.ctx().callee_spans.append(start)
        if is_extern {
            if self.ctx().unsafe_depth == 0 { self.fail_here(start, format("calling the foreign function `{}` requires an `unsafe` block", .{fname})[..]) }
            self.add_effect(EFF_FFI, start, "call to a foreign function")
        }
        let c = self.mk(TKind.Call, ret, start, end)
        self.tir.nodes[c].a = inst
        self.tir.nodes[c].kids = targs
        return c
    }

    /// Is this argument a type (for explicit type arguments)?
    fn is_type_arg(self: *mut Self, a: usize) -> bool {
        let m = self.cur_module()
        let n = self.node(m, a)
        if n.k == parser.NodeKind.TypeVal { return true }
        if n.k == parser.NodeKind.Ident {
            let name = n.name.clone()
            if self.lookup_local(name[..]) != NONE { return false }
            if self.env_lookup(name[..]) != NONE { return true }
            if name == "String" { return true }
            if let it = self.lookup(m, name[..]) { return it.kind == ItemKind.Struct or it.kind == ItemKind.Enum or it.kind == ItemKind.Alias }
            return false
        }
        if n.k == parser.NodeKind.Call {
            let callee = self.node(m, n.x)
            if callee.k != parser.NodeKind.Ident { return false }
            let name = callee.name.clone()
            if name == "List" or name == "Map" { return true }
            if let it = self.lookup(m, name[..]) { return it.kind == ItemKind.Struct or it.kind == ItemKind.Enum }
        }
        return false
    }

    /// Does `t` satisfy a trait: the derivable ones by their rules, others by an impl.
    fn type_satisfies_trait(self: *mut Self, t0: usize, trait_name: []u8) -> bool {
        let t = self.tys.resolve(t0, true)
        let k = self.tys.kind(t)
        let derivable = trait_name == "Eq" or trait_name == "Ord" or trait_name == "Hash" or trait_name == "Format" or trait_name == "Copy"
        if derivable {
            if k == TK.Int or k == TK.Float or k == TK.Bool or k == TK.Char { return true }
            if k == TK.Slice and trait_name != "Copy" {
                let e = self.tys.list[t].args[0]
                if trait_name == "Ord" {
                    let es = self.tys.shallow(e)
                    return self.tys.kind(es) == TK.Int and self.tys.list[es].name == "u8"
                }
                return self.type_satisfies_trait(e, trait_name)
            }
            if k == TK.Str and trait_name != "Copy" { return true }
            if k == TK.Struct {
                if list_has(&self.structs[self.tys.list[t].def].derives, trait_name) { return true }
            }
            if k == TK.Enum {
                let d = self.tys.list[t].def
                if list_has(&self.enums[d].derives, trait_name) { return true }
                if trait_name != "Copy" {
                    var all_unit = true
                    let em = self.enums[d].module
                    let variants = self.enums[d].variants.clone()
                    for v in variants { if self.node(em, v).text != "unit" { all_unit = false } }
                    if all_unit { return true }
                }
            }
            if k == TK.Distinct { return self.type_satisfies_trait(self.distinct_underlying(self.tys.list[t].def), trait_name) }
        }
        let n = self.impls.len
        for i in 0..n {
            if !self.impls[i].has_trait or self.impls[i].trait_name != trait_name { continue }
            if self.match_impl_target(i, t) != null { return true }
        }
        return false
    }

    /// A method receiver becomes what the `self` parameter wants: a pointer
    /// to a place, or the value itself.
    fn adjust_receiver(self: *mut Self, recv: usize, want: usize, at: usize, end: usize) -> usize {
        let wt = self.tys.shallow(want)
        let rt = self.tys.shallow(self.tir.nodes[recv].ty)
        let wk = self.tys.kind(wt)
        let rk = self.tys.kind(rt)
        if wk == TK.Ptr and rk == TK.Ptr {
            if self.tys.list[wt].flag and !self.tys.list[rt].flag {
                self.fail_here(at, "this method mutates its receiver, but the receiver is an immutable pointer")
            }
            return recv
        }
        if wk == TK.Ptr {
            let mutable = self.tys.list[wt].flag
            if mutable and self.is_place(recv) and !self.place_mutable(recv) {
                var what = String.from("the receiver")
                if self.tir.nodes[recv].k == TKind.Local { what = format("`{}`", .{self.ctx().locals[self.tir.nodes[recv].a].name}) }
                self.fail_here(at, format("this method mutates its receiver, but {} is immutable", .{what})[..])
            }
            let pt = self.tys.wrap(TK.Ptr, self.tir.nodes[recv].ty, mutable)
            let r = self.mk(TKind.AddrOf, pt, at, end)
            self.tir.nodes[r].flag = mutable
            self.tir.nodes[r].kids.append(recv)
            return r
        }
        if rk == TK.Ptr {
            let r = self.mk(TKind.Deref, want, at, end)
            self.tir.nodes[r].kids.append(recv)
            return r
        }
        return recv
    }

    fn check_builtin_fn(self: *mut Self, name: []u8, args: []usize, start: usize, end: usize) -> usize {
        let m = self.cur_module()
        let v = self.tys.void()
        let bytes = self.tys.str_slice()
        if name == "println" or name == "print" or name == "eprintln" or name == "format" {
            if args.len == 0 or args.len > 2 {
                self.fail_here(start, format("`{}` takes a format string and an optional `.{{ }}` argument tuple", .{name})[..])
                return self.error_expr(start, end)
            }
            let fmt_node = args[0]
            let fn_ = self.node(m, fmt_node)
            if ! (fn_.k == parser.NodeKind.Lit and fn_.text == "str") {
                self.fail_here(fn_.start, "the format string must be a string literal so it can be checked at compile time (section 7.4)")
                return self.error_expr(start, end)
            }
            let fmt = fn_.name.clone()
            let fstart = fn_.start
            let fend = fn_.end
            // placeholders
            var count: usize = 0
            var i: usize = 0
            while i < fmt.len {
                if fmt[i] == '{' {
                    if i + 1 < fmt.len and fmt[i + 1] == '{' { i += 2; continue }
                    var j = i + 1
                    while j < fmt.len and fmt[j] != '}' { j += 1 }
                    if j >= fmt.len {
                        self.fail_here(fstart, "unterminated `{` in format string (write `{{` for a literal brace)")
                        return self.error_expr(start, end)
                    }
                    count += 1
                    i = j + 1
                } else if fmt[i] == '}' {
                    if i + 1 < fmt.len and fmt[i + 1] == '}' { i += 2; continue }
                    self.fail_here(fstart, "unmatched `}` in format string (write `}}` for a literal brace)")
                    return self.error_expr(start, end)
                } else {
                    i += 1
                }
            }
            var arg_nodes = List(usize).new()
            if args.len == 2 {
                let an = self.node(m, args[1])
                if an.k == parser.NodeKind.TupleLit {
                    arg_nodes = an.kids.clone()
                } else if an.k == parser.NodeKind.StructLit and an.x == NONE and an.kids.len == 0 {
                    // `.{}`: no arguments
                } else {
                    arg_nodes.append(args[1])
                }
            }
            if arg_nodes.len != count {
                self.fail_here(start, format("format string has {} placeholder(s) but {} argument(s) were given", .{count, arg_nodes.len})[..])
                return self.error_expr(start, end)
            }
            var all = List(usize).new()
            let fs = self.mk(TKind.Str, bytes, fstart, fend)
            self.tir.nodes[fs].text = fmt.clone()
            all.append(fs)
            for a in arg_nodes {
                var te = self.check_expr(a, NONE)
                te = self.finalize_expr(te)
                let t = self.tys.resolve(self.tir.nodes[te].ty, true)
                let k = self.tys.kind(t)
                var ok = k == TK.Int or k == TK.Float or k == TK.Bool or k == TK.Char or k == TK.ErrorSet or k == TK.Ptr
                if k == TK.Slice {
                    let es = self.tys.shallow(self.tys.list[t].args[0])
                    ok = self.tys.kind(es) == TK.Int and self.tys.list[es].name == "u8"
                }
                if k == TK.Str {
                    let sl = self.tys.str_slice()
                    te = self.wrap_node(TKind.StrToSlice, te, sl)
                    ok = true
                }
                if k == TK.Enum {
                    ok = true
                    let d = self.tys.list[t].def
                    let em = self.enums[d].module
                    let variants = self.enums[d].variants.clone()
                    for vv in variants { if self.node(em, vv).text != "unit" { ok = false } }
                }
                if k == TK.Distinct {
                    let u = self.distinct_underlying(self.tys.list[t].def)
                    let c = self.mk(TKind.Cast, u, self.tir.nodes[te].start, self.tir.nodes[te].end)
                    self.tir.nodes[c].name = String.from("bits")
                    self.tir.nodes[c].kids.append(te)
                    te = c
                    ok = true
                }
                if k == TK.Opt {
                    let ik = self.tys.kind(self.tys.shallow(self.tys.list[t].args[0]))
                    ok = ik == TK.Int or ik == TK.Float or ik == TK.Bool or ik == TK.Char
                }
                if !ok {
                    self.fail_here(self.tir.nodes[te].start, format("cannot format a value of type `{}`; formatting supports numbers, bool, char, `[]u8`, `String`, unit enums, and errors", .{self.ty_name(t)})[..])
                }
                all.append(te)
            }
            var op = "Println"
            var ty = v
            if name == "print" { op = "Print" }
            if name == "eprintln" { op = "Eprintln" }
            if name == "format" {
                op = "Format"
                ty = self.tys.string()
                self.add_effect(EFF_ALLOCATES, start, "`format` builds an owned String")
            } else {
                self.add_effect(EFF_BLOCKS, start, "writing to stdout may block")
            }
            let b = self.builtin_node(op, ty, start, end)
            self.tir.nodes[b].kids = all
            return b
        }
        if name == "expect" or name == "assert" {
            if args.len != 1 {
                self.fail_here(start, format("`{}` takes 1 argument(s) but {} were given", .{name, args.len})[..])
                for a in args { _ = self.check_expr(a, NONE) }
                return self.error_expr(start, end)
            }
            let bt = self.tys.bool_ty()
            var c = self.check_expr(args[0], bt)
            c = self.coerce_or_error(c, bt, "condition")
            self.add_effect(EFF_PANICS, start, "a failed `expect` panics")
            let an = self.node(m, args[0])
            let src = self.source_text(m, an.start, an.end)
            let msg = self.mk(TKind.Str, bytes, start, end)
            self.tir.nodes[msg].text = src
            let b = self.builtin_node("Expect", v, start, end)
            self.tir.nodes[b].kids.append(c)
            self.tir.nodes[b].kids.append(msg)
            return b
        }
        if name == "expect_eq" {
            if args.len != 2 {
                self.fail_here(start, format("`expect_eq` takes 2 argument(s) but {} were given", .{args.len})[..])
                for a in args { _ = self.check_expr(a, NONE) }
                return self.error_expr(start, end)
            }
            let c = self.check_comparison("==", args[0], args[1], start, end)
            self.add_effect(EFF_PANICS, start, "a failed `expect_eq` panics")
            let src = self.source_text(m, start, end)
            let msg = self.mk(TKind.Str, bytes, start, end)
            self.tir.nodes[msg].text = src
            let b = self.builtin_node("Expect", v, start, end)
            self.tir.nodes[b].kids.append(c)
            self.tir.nodes[b].kids.append(msg)
            return b
        }
        if name == "panic" {
            if args.len != 1 {
                self.fail_here(start, format("`panic` takes 1 argument(s) but {} were given", .{args.len})[..])
                for a in args { _ = self.check_expr(a, NONE) }
                return self.error_expr(start, end)
            }
            var msg = self.check_expr(args[0], bytes)
            msg = self.coerce_or_error(msg, bytes, "panic message")
            self.add_effect(EFF_PANICS, start, "explicit panic")
            let nv = self.tys.never()
            let b = self.builtin_node("Panic", nv, start, end)
            self.tir.nodes[b].kids.append(msg)
            return b
        }
        return NONE
    }

    fn source_text(self: *Self, m: usize, start: usize, end: usize) -> String {
        return String.from(self.mods[m].source[start..end])
    }

    // ----- if, casts ---------------------------------------------------------------------------

    fn check_if(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let cond_node = n.x
        let then_node = n.y
        let els_node = n.z
        let start = n.start
        let end = n.end
        let bt = self.tys.bool_ty()
        var c = self.check_expr(cond_node, bt)
        c = self.coerce_or_error(c, bt, "if condition")
        let narrowing = self.guard_narrowing(c)
        let ranges_before = self.ctx().ranges.clone()
        self.push_scope()
        for nr in narrowing { self.ctx().ranges.put(nr.local, Range{ .lo = nr.lo, .hi = nr.hi }) }
        let moved_before = self.moved_snapshot()
        let v = self.tys.void()
        let then_expected = if els_node != NONE { expected } else { v }
        let tb = self.check_block(then_node, then_expected, NONE, NONE)
        self.pop_scope()
        self.ctx().ranges = ranges_before
        let moved_then = self.moved_snapshot()
        let then_ty = self.tir.nodes[tb].ty
        let then_diverges = self.tys.kind(self.tys.shallow(then_ty)) == TK.Never
        if then_diverges and els_node == NONE { self.moved_restore(&moved_before) }
        if els_node == NONE {
            let tk = self.tys.kind(self.tys.shallow(then_ty))
            if ! (tk == TK.Void or tk == TK.Never) {
                self.fail_here(self.tir.nodes[tb].start, format("an `if` without `else` produces no value, but this block has type `{}`; discard the value with `_ =`", .{self.ty_name(then_ty)})[..])
            }
            let r = self.mk(TKind.If, v, start, end)
            self.tir.nodes[r].kids.append(c)
            self.tir.nodes[r].kids.append(tb)
            return r
        }
        self.moved_restore(&moved_before)
        let hint = if then_diverges { expected } else { then_ty }
        var eb = NONE
        let ek = self.node(m, els_node).k
        if ek == parser.NodeKind.Block {
            eb = self.check_block(els_node, hint, NONE, NONE)
        } else {
            let te = self.check_expr(els_node, hint)
            eb = self.mk(TKind.Block, self.tir.nodes[te].ty, self.tir.nodes[te].start, self.tir.nodes[te].end)
            self.tir.nodes[eb].a = te
        }
        let else_diverges = self.tys.kind(self.tys.shallow(self.tir.nodes[eb].ty)) == TK.Never
        let moved_else = self.moved_snapshot()
        self.moved_restore(&moved_before)
        if !then_diverges { self.moved_merge(&moved_then) }
        if !else_diverges { self.moved_merge(&moved_else) }
        let ty = self.join_branches(tb, eb, expected)
        let r = self.mk(TKind.If, ty, start, end)
        self.tir.nodes[r].kids.append(c)
        self.tir.nodes[r].kids.append(tb)
        self.tir.nodes[r].kids.append(eb)
        return r
    }

    /// Unify two branch blocks to a common type, coercing tails as needed.
    fn join_branches(self: *mut Self, a: usize, b: usize, expected: usize) -> usize {
        let at = self.tys.shallow(self.tir.nodes[a].ty)
        let bt = self.tys.shallow(self.tir.nodes[b].ty)
        let a_never = self.tys.kind(at) == TK.Never
        let b_never = self.tys.kind(bt) == TK.Never
        var target = NONE
        if a_never and b_never {
            target = self.tys.never()
        } else if a_never {
            target = bt
            if expected != NONE and self.coerce_tail_ok(b, expected) { target = expected }
        } else if b_never {
            target = at
            if expected != NONE and self.coerce_tail_ok(a, expected) { target = expected }
        } else {
            if expected != NONE and self.coerce_tail_ok(a, expected) and self.coerce_tail_ok(b, expected) {
                target = expected
            } else if self.coerce_tail_ok(b, at) {
                target = at
            } else if self.coerce_tail_ok(a, bt) {
                target = bt
            } else {
                self.fail_here(self.tir.nodes[b].start, format("`if` branches have incompatible types: `{}` and `{}`", .{self.ty_name(at), self.ty_name(bt)})[..])
                target = at
            }
        }
        self.coerce_block_tail(a, target)
        self.coerce_block_tail(b, target)
        return target
    }

    fn coerce_tail_ok(self: *mut Self, b: usize, t: usize) -> bool {
        let tail = self.tir.nodes[b].a
        if tail != NONE {
            // a probe: errors are not reported, bindings made by unification stay
            let saved = self.errors.len
            let saved_ty = self.tir.nodes[tail].ty
            let r = self.coerce(tail, t)
            while self.errors.len > saved { _ = self.errors.pop() }
            if r == NONE {
                self.tir.nodes[tail].ty = saved_ty
                return false
            }
            // undo the wrapping the probe made; the real coercion redoes it
            self.tir.nodes[tail].ty = saved_ty
            return true
        }
        let bk = self.tys.kind(self.tys.shallow(self.tir.nodes[b].ty))
        let tk = self.tys.kind(self.tys.shallow(t))
        return (bk == TK.Never or bk == TK.Void) and (tk == TK.Void or self.block_diverges(b))
    }

    fn coerce_block_tail(self: *mut Self, b: usize, t: usize) {
        let tail = self.tir.nodes[b].a
        if tail != NONE {
            let c = self.coerce_or_error(tail, t, "block value")
            self.tir.nodes[b].a = c
        }
        self.tir.nodes[b].ty = t
    }

    fn moved_snapshot(self: *mut Self) -> List(usize) {
        return self.ctx().moved.keys()
    }
    fn moved_restore(self: *mut Self, snap: *List(usize)) {
        let keys = self.ctx().moved.keys()
        for k in keys {
            var keep = false
            for s in snap { if s == k { keep = true } }
            if !keep { _ = self.ctx().moved.remove(k) }
        }
        for s in snap { if !self.ctx().moved.contains(s) { self.ctx().moved.put(s, 0) } }
    }
    fn moved_merge(self: *mut Self, snap: *List(usize)) {
        for s in snap { if !self.ctx().moved.contains(s) { self.ctx().moved.put(s, 0) } }
    }

    /// Range facts from a boolean guard on a local: `x < N`, `x <= N`, `x >= N`, `x > N`.
    fn guard_narrowing(self: *mut Self, c: usize) -> List(Narrowing) {
        var out = List(Narrowing).new()
        if self.tir.nodes[c].k == TKind.Logical and self.tir.nodes[c].flag {
            let l = self.guard_narrowing(self.tir.nodes[c].kids[0])
            let r = self.guard_narrowing(self.tir.nodes[c].kids[1])
            for x in l { out.append(Narrowing{ .local = x.local, .lo = x.lo, .hi = x.hi }) }
            for x in r { out.append(Narrowing{ .local = x.local, .lo = x.lo, .hi = x.hi }) }
            return out
        }
        if self.tir.nodes[c].k != TKind.Binary { return out }
        let op = self.tir.nodes[c].text.clone()
        let lhs = self.tir.nodes[c].kids[0]
        let rhs = self.tir.nodes[c].kids[1]
        if self.tir.nodes[lhs].k != TKind.Local { return out }
        let rr = self.expr_range(rhs) orelse return out
        var cur = Range{ .lo = -85070591730234615865843651857942052864, .hi = 85070591730234615865843651857942052863 }
        if let lr = self.expr_range(lhs) { cur = lr }
        let l = self.tir.nodes[lhs].a
        var nr = Narrowing{ .local = l, .lo = cur.lo, .hi = cur.hi }
        var known = true
        if op == "<" { nr.hi = min128(cur.hi, rr.hi - 1) }
        else if op == "<=" { nr.hi = min128(cur.hi, rr.hi) }
        else if op == ">" { nr.lo = max128(cur.lo, rr.lo + 1) }
        else if op == ">=" { nr.lo = max128(cur.lo, rr.lo) }
        else if op == "==" { nr.lo = max128(cur.lo, rr.lo); nr.hi = min128(cur.hi, rr.hi) }
        else { known = false }
        if known and nr.lo <= nr.hi { out.append(nr) }
        return out
    }

    fn check_cast(self: *mut Self, e: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let inner_node = n.x
        let ty_node = n.y
        let start = n.start
        let end = n.end
        let st = self.ctx().self_ty
        let target = self.resolve_type(m, ty_node, st)
        let inner = self.check_expr(inner_node, NONE)
        let from = self.tys.resolve(self.tir.nodes[inner].ty, true)
        let to = self.tys.shallow(target)
        let kf = self.tys.kind(from)
        let kt = self.tys.kind(to)
        var uf = from
        var ut = to
        if kf == TK.Distinct { uf = self.tys.shallow(self.distinct_underlying(self.tys.list[from].def)) }
        if kt == TK.Distinct { ut = self.tys.shallow(self.distinct_underlying(self.tys.list[to].def)) }
        let kuf = self.tys.kind(uf)
        let kut = self.tys.kind(ut)
        var kind = String.new()
        if (kf == TK.Distinct or kt == TK.Distinct) and uf == ut {
            kind = String.from("bits")
        } else if kuf == TK.Int and kut == TK.Int {
            let an = self.tys.list[uf].name.clone()
            let bn = self.tys.list[ut].name.clone()
            let fits = int_min(an[..]) >= int_min(bn[..]) and int_max(an[..]) <= int_max(bn[..])
            var proven = fits
            if !proven {
                if let r = self.expr_range(inner) { proven = r.lo >= int_min(bn[..]) and r.hi <= int_max(bn[..]) }
            }
            if !proven { self.add_effect(EFF_PANICS, start, "narrowing cast panics when the value does not fit (use `@truncate` to wrap)") }
            kind = format("int_to_int checked={}", .{!proven})
        } else if kuf == TK.Int and kut == TK.Float {
            kind = String.from("int_to_float")
        } else if kuf == TK.Float and kut == TK.Int {
            self.add_effect(EFF_PANICS, start, "float to integer cast panics when out of range")
            kind = String.from("float_to_int")
        } else if kuf == TK.Float and kut == TK.Float {
            kind = String.from("float_to_float")
        } else if kuf == TK.Bool and kut == TK.Int {
            kind = String.from("bits")
        } else if kuf == TK.Char and kut == TK.Int {
            if int_max(self.tys.list[ut].name[..]) < 0x10FFFF {
                self.add_effect(EFF_PANICS, start, "char to narrow integer cast panics when out of range")
                kind = String.from("int_to_int checked=true")
            } else {
                kind = String.from("bits")
            }
        } else if kuf == TK.Int and kut == TK.Char {
            self.add_effect(EFF_PANICS, start, "integer to char cast panics for invalid scalar values")
            kind = String.from("int_to_int checked=true")
        } else if kuf == TK.Enum and kut == TK.Int {
            let d = self.tys.list[uf].def
            let em = self.enums[d].module
            let variants = self.enums[d].variants.clone()
            for v in variants { if self.node(em, v).text != "unit" { self.fail_here(start, "only enums without payloads convert to integers") } }
            kind = String.from("bits")
        } else if kuf == TK.Ptr and kut == TK.Ptr {
            if self.ctx().unsafe_depth == 0 { self.fail_here(start, "pointer casts require an `unsafe` block") }
            kind = String.from("ptr_to_ptr")
        } else if (kuf == TK.Int and kut == TK.Ptr) or (kuf == TK.Ptr and kut == TK.Int and self.tys.list[ut].name == "usize") {
            if self.ctx().unsafe_depth == 0 { self.fail_here(start, "casting between pointers and integers requires an `unsafe` block") }
            kind = String.from("ptr_to_ptr")
        } else {
            if self.unify(from, to) { return inner }
            self.fail_here(start, format("cannot cast `{}` to `{}`", .{self.ty_name(from), self.ty_name(to)})[..])
            return self.error_expr(start, end)
        }
        let c = self.mk(TKind.Cast, to, start, end)
        self.tir.nodes[c].name = kind
        self.tir.nodes[c].kids.append(inner)
        return c
    }
}

pub struct EnvSave {
    names: List(String)
    tys: List(usize)
}

pub struct Narrowing {
    local: usize
    lo: i128
    hi: i128
}

fn min128(a: i128, b: i128) -> i128 { return if a < b { a } else { b } }
fn max128(a: i128, b: i128) -> i128 { return if a > b { a } else { b } }
fn sat_add(a: i128, b: i128) -> i128 { return a +| b }
fn sat_sub(a: i128, b: i128) -> i128 { return a -| b }
fn sat_mul(a: i128, b: i128) -> i128 { return a *| b }
fn checked_add(a: i128, b: i128) -> ?i128 {
    let r = a +| b
    if r != a +% b { return null }
    return r
}
fn checked_sub(a: i128, b: i128) -> ?i128 {
    let r = a -| b
    if r != a -% b { return null }
    return r
}
fn checked_mul(a: i128, b: i128) -> ?i128 {
    let r = a *| b
    if r != a *% b { return null }
    return r
}

// ---------------------------------------------------------------- the printer (nx tir shape)

pub struct Printer {
    out: String
    depth: usize
}

impl Printer {
    fn line(self: *mut Self, text: []u8) {
        for k in 0..self.depth {
            _ = k
            self.out.append("  ")
        }
        self.out.append(text)
        self.out.append("\n")
    }
    fn open(self: *mut Self, text: []u8) {
        self.line(text)
        self.depth += 1
    }
    fn close(self: *mut Self) {
        self.depth -= 1
        self.line(")")
    }
}

fn tquote(b: []u8) -> String {
    var s = String.from("\"")
    for c in b {
        if c == '"' { s.append("\\\"") }
        else if c == '\\' { s.append("\\\\") }
        else if c == '\n' { s.append("\\n") }
        else if c == '\r' { s.append("\\r") }
        else if c == '\t' { s.append("\\t") }
        else if c >= 0x20 and c <= 0x7e { s.push_byte(c) }
        else {
            let hex = "0123456789abcdef"
            s.append("\\x")
            s.push_byte(hex[(c >> 4) as usize])
            s.push_byte(hex[(c & 15) as usize])
        }
    }
    s.append("\"")
    return s
}

fn eff_list(mask: u64) -> String {
    return format("({})", .{render_effects(mask)})
}

impl Checker {
    fn print_program(self: *mut Self, out: *mut String) {
        // the declaration sections are shared with --sigs; errors and alias
        // types are known now
        var sigs = String.new()
        self.print_sigs(&mut sigs)
        // cut the sigs text before its (fns section and rebuild the parts that differ
        let fns_at = find_sub(sigs[..], "  (fns\n") orelse sigs.len
        let head = String.from(sigs[0..fns_at])
        // insert (errors after (enums ... ) and alias types
        var p = Printer{ .out = String.new(), .depth = 0 }
        let enums_end = find_sub(head[..], "  (aliases\n") orelse head.len
        p.out.append(head[0..enums_end])
        p.depth = 1
        p.open("(errors")
        for e, i in self.error_names { p.line(format("(error {} {})", .{i + 1, e})[..]) }
        p.close()
        p.open("(aliases")
        for a, i in self.aliases {
            // an alias resolves when first used; an unused one has no type yet
            let t = self.aliases[i].resolved
            let tn = if t == NONE { String.from("-") } else { self.ty_name(t) }
            p.line(format("(alias {} {} @{}:{} distinct={} module={} ty={})", .{i, a.name, a.start, a.end, a.is_distinct, a.module, tn})[..])
        }
        p.close()
        p.depth = 0
        let aliases_end = find_sub(head[..], "  (traits\n") orelse head.len
        p.out.append(head[aliases_end..])
        p.depth = 1
        p.open("(fns")
        let n = self.insts.len
        for i in 0..n { self.print_inst(i, &mut p) }
        p.close()
        p.depth = 0
        p.line(")")
        out.append(p.out[..])
    }

    fn print_inst(self: *mut Self, i: usize, p: *mut Printer) {
        let f = &self.insts[i]
        let ret = self.ty_name(f.ret)
        let targs = self.ty_list(f.targs[..])
        p.open(format("(fn {} {} @{}:{} mangled={} module={} ret={} targs=({}) export={} extern={} variadic={} pub={} test={} ctest={} closure={} body={}",
            .{i, f.name, f.start, f.end, f.mangled, f.module, ret, targs, f.export_name, f.is_extern, f.is_variadic, f.is_pub, f.is_test, f.test_comptime, f.is_closure, yes_no(f.body)})[..])
        var params = String.new()
        for pi, k in f.params {
            if k > 0 { params.append(" ") }
            let l = &f.locals[pi]
            params.append(format("({} {} own={})", .{l.name, self.ty_name(l.ty), l.owned})[..])
        }
        p.line(format("(params {})", .{params})[..])
        p.line(format("(declared neg={} pos={})", .{eff_list(f.declared_neg), eff_list(f.declared_pos)})[..])
        p.line(format("(effects own={} all={})", .{eff_list(f.own_effects), eff_list(f.effects)})[..])
        p.open("(locals")
        for l, li in f.locals {
            p.line(format("(local {} {} @{}:{} {} mut={} param={} own={} loop={})", .{li, l.name, l.start, l.end, self.ty_name(l.ty), l.mutable, l.is_param, l.owned, l.loop_item})[..])
        }
        p.close()
        if f.body != NONE { self.print_block(f.body, p) }
        p.close()
    }

    fn sp(self: *Self, id: usize) -> String {
        return format("@{}:{}", .{self.tir.nodes[id].start, self.tir.nodes[id].end})
    }

    fn print_block(self: *mut Self, b: usize, p: *mut Printer) {
        let t = self.ty_name(self.tir.nodes[b].ty)
        let label = self.tir.nodes[b].b
        let label_text = if label == NONE { String.from("-") } else { format("{}", .{label}) }
        p.open(format("(block {} :{} label={}", .{self.sp(b), t, label_text})[..])
        let kids = self.tir.nodes[b].kids.clone()
        for s in kids { self.print_stmt(s, p) }
        let tail = self.tir.nodes[b].a
        if tail != NONE {
            p.open("(tail")
            self.print_expr(tail, p)
            p.close()
        }
        p.close()
    }

    fn print_stmt(self: *mut Self, s: usize, p: *mut Printer) {
        let k = self.tir.nodes[s].k
        let kids = self.tir.nodes[s].kids.clone()
        let a = self.tir.nodes[s].a
        let b = self.tir.nodes[s].b
        let sp = self.sp(s)
        if k == TKind.SLet {
            p.open(format("(let {} local={}", .{sp, a})[..])
            for e in kids { self.print_expr(e, p) }
            p.close()
        } else if k == TKind.SAssign {
            p.open(format("(assign {} op={}", .{sp, self.tir.nodes[s].name})[..])
            self.print_expr(kids[0], p)
            self.print_expr(kids[1], p)
            p.close()
        } else if k == TKind.SExpr {
            p.open("(expr")
            self.print_expr(kids[0], p)
            p.close()
        } else if k == TKind.SReturn {
            p.open(format("(return {}", .{sp})[..])
            for e in kids { self.print_expr(e, p) }
            p.close()
        } else if k == TKind.SBreak {
            p.open(format("(break {} label={}", .{sp, a})[..])
            for e in kids { self.print_expr(e, p) }
            p.close()
        } else if k == TKind.SContinue {
            p.line(format("(continue {} label={})", .{sp, a})[..])
        } else if k == TKind.SDefer or k == TKind.SErrDefer {
            p.open(format("({} {}", .{if k == TKind.SDefer { "defer" } else { "errdefer" }, sp})[..])
            self.print_stmt(kids[0], p)
            p.close()
        } else if k == TKind.SWhile {
            p.open(format("(while {} label={}", .{sp, a})[..])
            self.print_expr(kids[0], p)
            self.print_block(kids[1], p)
            if kids.len > 2 {
                p.open("(else")
                self.print_block(kids[2], p)
                p.close()
            }
            p.close()
        } else if k == TKind.SForRange {
            p.open(format("(for_range {} var={} label={}", .{sp, a, b})[..])
            self.print_expr(kids[0], p)
            self.print_expr(kids[1], p)
            if self.tir.nodes[s].flag {
                p.open("(step")
                self.print_expr(kids[2], p)
                p.close()
            }
            self.print_block(kids[kids.len - 1], p)
            p.close()
        } else if k == TKind.SForSlice {
            let idx = if a == NONE { String.from("-") } else { format("{}", .{a}) }
            p.open(format("(for_slice {} index={} label={} parallel={}", .{sp, idx, b, self.tir.nodes[s].flag})[..])
            let locals = self.tir.nodes[s].kids2.clone()
            for l, i in locals {
                p.open(format("(item local={}", .{l})[..])
                self.print_expr(kids[i], p)
                p.close()
            }
            self.print_block(kids[kids.len - 1], p)
            p.close()
        } else if k == TKind.SBlock {
            self.print_block(kids[0], p)
        } else if k == TKind.SDrop {
            p.line(format("(drop {} local={})", .{sp, a})[..])
        } else if k == TKind.SUsing {
            p.open(format("(using {} {}", .{sp, self.tir.nodes[s].name})[..])
            self.print_block(kids[0], p)
            p.close()
        }
    }

    fn head(self: *mut Self, name: []u8, e: usize) -> String {
        return format("({} {} :{}", .{name, self.sp(e), self.ty_name(self.tir.nodes[e].ty)})
    }

    fn print_kids(self: *mut Self, e: usize, p: *mut Printer) {
        let kids = self.tir.nodes[e].kids.clone()
        for c in kids { self.print_expr(c, p) }
    }

    fn print_expr(self: *mut Self, e: usize, p: *mut Printer) {
        let k = self.tir.nodes[e].k
        let a = self.tir.nodes[e].a
        let kids = self.tir.nodes[e].kids.clone()
        if k == TKind.Int { p.line(format("{} {})", .{self.head("int", e), self.tir.nodes[e].ival})[..]); return }
        if k == TKind.Float { p.line(format("{} {})", .{self.head("float", e), rust_float(self.tir.nodes[e].fval)})[..]); return }
        if k == TKind.Bool { p.line(format("{} {})", .{self.head("bool", e), self.tir.nodes[e].flag})[..]); return }
        if k == TKind.Char { p.line(format("{} {})", .{self.head("char", e), self.tir.nodes[e].ival})[..]); return }
        if k == TKind.Str { p.line(format("{} {})", .{self.head("str", e), tquote(self.tir.nodes[e].text[..])})[..]); return }
        if k == TKind.Unit { p.line(format("{})", .{self.head("unit", e)})[..]); return }
        if k == TKind.Local { p.line(format("{} {})", .{self.head("local", e), a})[..]); return }
        if k == TKind.Global { p.line(format("{} {})", .{self.head("global", e), a})[..]); return }
        if k == TKind.Const { p.line(format("{} {})", .{self.head("const", e), a})[..]); return }
        if k == TKind.FnRef { p.line(format("{} {})", .{self.head("fnref", e), a})[..]); return }
        if k == TKind.FnToFat { p.line(format("{} {})", .{self.head("fn_to_fat", e), a})[..]); return }
        if k == TKind.OptNull { p.line(format("{})", .{self.head("null", e)})[..]); return }
        if k == TKind.ErrVal { p.line(format("{} {})", .{self.head("err_val", e), a})[..]); return }
        if k == TKind.Unreachable { p.line(format("{})", .{self.head("unreachable", e)})[..]); return }
        if k == TKind.Undefined { p.line(format("{})", .{self.head("undefined", e)})[..]); return }
        if k == TKind.TypeVal { p.line(format("{} {})", .{self.head("type_val", e), self.ty_name(a)})[..]); return }
        if k == TKind.Value { p.line(format("{} {})", .{self.head("value", e), self.value_text(e)})[..]); return }
        if k == TKind.Closure {
            var caps = String.new()
            let locals = self.tir.nodes[e].kids2.clone()
            for l, i in locals {
                if i > 0 { caps.append(" ") }
                caps.append(format("({} ref={})", .{l, kids[i] == 1})[..])
            }
            p.line(format("{} {} captures=({}))", .{self.head("closure", e), a, caps})[..])
            return
        }
        if k == TKind.Field or k == TKind.RefField or k == TKind.TupleField {
            let nm = if k == TKind.Field { "field" } else if k == TKind.RefField { "ref_field" } else { "tuple_field" }
            p.open(format("{} {}", .{self.head(nm, e), a})[..])
            self.print_expr(kids[0], p)
            p.close()
            return
        }
        if k == TKind.Index {
            p.open(format("{} proven={}", .{self.head("index", e), self.tir.nodes[e].flag})[..])
            self.print_kids(e, p)
            p.close()
            return
        }
        if k == TKind.SliceOp {
            p.open(self.head("slice", e)[..])
            self.print_expr(kids[0], p)
            let has_start = self.tir.nodes[e].flag
            let has_end = self.tir.nodes[e].flag2
            p.line(format("(start {})", .{if has_start { "yes" } else { "no" }})[..])
            var next: usize = 1
            if has_start { self.print_expr(kids[next], p); next += 1 }
            p.line(format("(end {})", .{if has_end { "yes" } else { "no" }})[..])
            if has_end { self.print_expr(kids[next], p) }
            p.close()
            return
        }
        if k == TKind.Deref or k == TKind.Try or k == TKind.OptWrap or k == TKind.ErrWrap or k == TKind.ErrToUnion
            or k == TKind.ArrayToSlice or k == TKind.ListToSlice or k == TKind.StrToSlice or k == TKind.Retained or k == TKind.BlockExpr{
            let nm = if k == TKind.Deref { "deref" } else if k == TKind.Try { "try" } else if k == TKind.OptWrap { "opt_wrap" }
            else if k == TKind.ErrWrap { "err_wrap" } else if k == TKind.ErrToUnion { "err_to_union" } else if k == TKind.ArrayToSlice { "array_to_slice" }
            else if k == TKind.ListToSlice { "list_to_slice" } else if k == TKind.StrToSlice { "str_to_slice" } else if k == TKind.Retained { "retained" } else { "block_expr" }
            p.open(self.head(nm, e)[..])
            if k == TKind.BlockExpr { self.print_block(kids[0], p) } else { self.print_expr(kids[0], p) }
            p.close()
            return
        }
        if k == TKind.AddrOf {
            p.open(format("{} mut={}", .{self.head("addr", e), self.tir.nodes[e].flag})[..])
            self.print_expr(kids[0], p)
            p.close()
            return
        }
        if k == TKind.Call {
            p.open(format("{} {}", .{self.head("call", e), a})[..])
            self.print_kids(e, p)
            p.close()
            return
        }
        if k == TKind.CallPtr {
            p.open(self.head("call_ptr", e)[..])
            self.print_kids(e, p)
            p.close()
            return
        }
        if k == TKind.Builtin {
            let tl = self.ty_list(self.tir.nodes[e].kids2[..])
            p.open(format("{} {} tys=({})", .{self.head("builtin", e), self.tir.nodes[e].name, tl})[..])
            self.print_kids(e, p)
            p.close()
            return
        }
        if k == TKind.Unary {
            p.open(format("{} {} {}", .{self.head("unary", e), self.tir.nodes[e].text, self.tir.nodes[e].name})[..])
            self.print_expr(kids[0], p)
            p.close()
            return
        }
        if k == TKind.Binary {
            p.open(format("{} {} {} proven={}", .{self.head("binary", e), self.tir.nodes[e].text, self.tir.nodes[e].name, self.tir.nodes[e].flag})[..])
            self.print_kids(e, p)
            p.close()
            return
        }
        if k == TKind.Logical {
            p.open(format("{} {}", .{self.head("logical", e), if self.tir.nodes[e].flag { "and" } else { "or" }})[..])
            self.print_kids(e, p)
            p.close()
            return
        }
        if k == TKind.Cast {
            p.open(format("{} {}", .{self.head("cast", e), self.tir.nodes[e].name})[..])
            self.print_expr(kids[0], p)
            p.close()
            return
        }
        if k == TKind.If or k == TKind.IfCapture {
            if k == TKind.If { p.open(self.head("if", e)[..]) } else { p.open(format("{} local={}", .{self.head("if_let", e), a})[..]) }
            self.print_expr(kids[0], p)
            self.print_block(kids[1], p)
            if kids.len > 2 {
                p.open("(else")
                self.print_block(kids[2], p)
                p.close()
            }
            p.close()
            return
        }
        if k == TKind.Match {
            p.open(self.head("match", e)[..])
            self.print_expr(kids[0], p)
            var i: usize = 1
            while i < kids.len {
                self.print_arm(kids[i], p)
                i += 1
            }
            p.close()
            return
        }
        if k == TKind.StructLit or k == TKind.RefNew {
            p.open(self.head(if k == TKind.StructLit { "struct_lit" } else { "ref_new" }, e)[..])
            let idxs = self.tir.nodes[e].kids2.clone()
            for f, i in kids {
                p.open(format("(init {}", .{idxs[i]})[..])
                self.print_expr(f, p)
                p.close()
            }
            p.close()
            return
        }
        if k == TKind.EnumLit {
            p.open(format("{} {}", .{self.head("enum_lit", e), a})[..])
            self.print_kids(e, p)
            p.close()
            return
        }
        if k == TKind.ArrayLit or k == TKind.TupleLit {
            p.open(self.head(if k == TKind.ArrayLit { "array_lit" } else { "tuple_lit" }, e)[..])
            self.print_kids(e, p)
            p.close()
            return
        }
        if k == TKind.ArrayRepeat {
            p.open(format("{} {}", .{self.head("array_repeat", e), a})[..])
            self.print_expr(kids[0], p)
            p.close()
            return
        }
        if k == TKind.Catch {
            let l = if a == NONE { String.from("-") } else { format("{}", .{a}) }
            p.open(format("{} err={}", .{self.head("catch", e), l})[..])
            self.print_kids(e, p)
            p.close()
            return
        }
        if k == TKind.OrElse {
            p.open(self.head("orelse", e)[..])
            self.print_kids(e, p)
            p.close()
            return
        }
        if k == TKind.Unwrap {
            p.open(format("{} proven={}", .{self.head("unwrap", e), self.tir.nodes[e].flag})[..])
            self.print_expr(kids[0], p)
            p.close()
            return
        }
        if k == TKind.BinConstruct {
            p.open(self.head("bin_construct", e)[..])
            var i: usize = 0
            while i + 1 < kids.len { self.print_seg(kids[i], p); i += 1 }
            p.open("(into")
            self.print_expr(kids[kids.len - 1], p)
            p.close()
            p.close()
            return
        }
        if k == TKind.RecordCheck {
            p.open(format("{} as_error={}", .{self.head("record_check", e), self.tir.nodes[e].flag})[..])
            self.print_expr(kids[0], p)
            let fields = self.tir.nodes[e].kids2.clone()
            var i: usize = 1
            while i < kids.len {
                let c = kids[i]
                p.open(format("(check field={} local={}", .{fields[(i - 1) * 2], fields[(i - 1) * 2 + 1]})[..])
                self.print_expr(c, p)
                p.close()
                i += 1
            }
            p.close()
            return
        }
        if k == TKind.DynFrom {
            p.open(format("{} vtable={}", .{self.head("dyn_from", e), a})[..])
            self.print_expr(kids[0], p)
            p.close()
            return
        }
        if k == TKind.DynCall {
            p.open(format("{} method={}", .{self.head("dyn_call", e), a})[..])
            self.print_kids(e, p)
            p.close()
            return
        }
        p.line(format("(?unknown {})", .{self.sp(e)})[..])
    }

    fn print_arm(self: *mut Self, arm: usize, p: *mut Printer) {
        let kids = self.tir.nodes[arm].kids.clone()
        let has_guard = self.tir.nodes[arm].flag
        p.open(format("(arm {} guard={}", .{self.sp(arm), if has_guard { "yes" } else { "no" }})[..])
        self.print_pat(kids[0], p)
        var i: usize = 1
        while i < kids.len { self.print_expr(kids[i], p); i += 1 }
        p.close()
    }

    fn print_pat(self: *mut Self, q: usize, p: *mut Printer) {
        let k = self.tir.nodes[q].k
        let a = self.tir.nodes[q].a
        let kids = self.tir.nodes[q].kids.clone()
        if k == TKind.PWild { p.line("(pat _)"); return }
        if k == TKind.PBind { p.line(format("(pat bind {})", .{a})[..]); return }
        if k == TKind.PInt { p.line(format("(pat int {})", .{self.tir.nodes[q].ival})[..]); return }
        if k == TKind.PFloat { p.line(format("(pat float {})", .{rust_float(self.tir.nodes[q].fval)})[..]); return }
        if k == TKind.PBool { p.line(format("(pat bool {})", .{self.tir.nodes[q].flag})[..]); return }
        if k == TKind.PStr { p.line(format("(pat str {})", .{tquote(self.tir.nodes[q].text[..])})[..]); return }
        if k == TKind.PChar { p.line(format("(pat char {})", .{self.tir.nodes[q].ival})[..]); return }
        if k == TKind.PRange { p.line(format("(pat range {} {} inclusive={})", .{self.tir.nodes[q].ival, self.tir.nodes[q].text, self.tir.nodes[q].flag})[..]); return }
        if k == TKind.PError { p.line(format("(pat error {})", .{a})[..]); return }
        if k == TKind.PNull { p.line("(pat null)"); return }
        if k == TKind.PVariant {
            p.open(format("(pat variant {}", .{a})[..])
            for c in kids { self.print_pat(c, p) }
            p.close()
            return
        }
        if k == TKind.PSome or k == TKind.POk or k == TKind.POr or k == TKind.PTuple {
            let nm = if k == TKind.PSome { "some" } else if k == TKind.POk { "ok" } else if k == TKind.POr { "or" } else { "tuple" }
            p.open(format("(pat {}", .{nm})[..])
            for c in kids { self.print_pat(c, p) }
            p.close()
            return
        }
        if k == TKind.PBinary {
            p.open("(pat binary")
            for c in kids { self.print_seg(c, p) }
            p.close()
            return
        }
        p.line("(pat ?)")
    }

    fn print_seg(self: *mut Self, s: usize, p: *mut Printer) {
        p.open(format("(seg {} :{} {}", .{self.sp(s), self.ty_name(self.tir.nodes[s].ty), self.tir.nodes[s].name})[..])
        let kids = self.tir.nodes[s].kids.clone()
        for c in kids { self.print_expr(c, p) }
        p.close()
    }
}

fn find_sub(hay: []u8, needle: []u8) -> ?usize {
    if needle.len > hay.len { return null }
    var i: usize = 0
    while i + needle.len <= hay.len {
        if hay[i..i + needle.len] == needle { return i }
        i += 1
    }
    return null
}

/// Rust prints floats with `{:?}`: the shortest round-trip text, with a
/// fractional part in decimal form (`100.0`) and a bare exponent in
/// exponential form (`1e-6`, `1e21`, never `1e-06`).
pub fn rust_float(v: f64) -> String {
    let s = format("{}", .{v})
    var epos = NONE
    for c, i in s { if c == 'e' or c == 'E' { epos = i } }
    if epos == NONE {
        var has_dot = false
        for c in s { if c == '.' or c == 'n' or c == 'i' { has_dot = true } }
        var out = String.from(s[..])
        if !has_dot { out.append(".0") }
        return out
    }
    var out = String.from(s[0..epos])
    out.append("e")
    var rest = s[epos + 1..]
    if rest.len > 0 and rest[0] == '+' { rest = rest[1..] }
    var neg = false
    if rest.len > 0 and rest[0] == '-' { neg = true; rest = rest[1..] }
    while rest.len > 1 and rest[0] == '0' { rest = rest[1..] }
    if neg { out.append("-") }
    out.append(rest)
    return out
}

// ---------------------------------------------------------------- fields, literals, indexing

impl Checker {
    /// The resolved payload types of every variant of an enum type.
    fn enum_variant_types(self: *mut Self, t0: usize) -> List(List(usize)) {
        let t = self.tys.shallow(t0)
        var out = List(List(usize)).new()
        if self.tys.kind(t) != TK.Enum { return out }
        let d = self.tys.list[t].def
        let m = self.enums[d].module
        let variants = self.enums[d].variants.clone()
        let saved = self.env_save()
        self.env_set(&self.enums[d].tparams.clone(), &self.tys.list[t].args.clone())
        for v in variants {
            let vn = self.node(m, v)
            var tys = List(usize).new()
            if vn.text != "unit" {
                let kids = vn.kids.clone()
                let is_tuple = vn.text == "tuple"
                for c in kids {
                    let ty_node = if is_tuple { c } else { self.node(m, c).x }
                    tys.append(self.resolve_type(m, ty_node, t))
                }
            }
            out.append(tys)
        }
        self.env_restore(&saved)
        return out
    }

    fn struct_field_index(self: *mut Self, d: usize, name: []u8) -> usize {
        let m = self.structs[d].module
        let fields = self.structs[d].fields.clone()
        for f, i in fields { if self.node(m, f).name == name { return i } }
        return NONE
    }

    fn enum_variant_index(self: *mut Self, d: usize, name: []u8) -> usize {
        let m = self.enums[d].module
        let variants = self.enums[d].variants.clone()
        for v, i in variants { if self.node(m, v).name == name { return i } }
        return NONE
    }

    fn auto_deref_all(self: *mut Self, e0: usize) -> usize {
        var e = e0
        while true {
            let t = self.tys.shallow(self.tir.nodes[e].ty)
            if self.tys.kind(t) != TK.Ptr { return e }
            let inner = self.tys.list[t].args[0]
            e = self.wrap_node(TKind.Deref, e, inner)
        }
        return e
    }

    fn check_field(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let base_node = n.x
        let name = n.name.clone()
        let start = n.start
        let end = n.end
        let b = self.check_expr(base_node, NONE)
        if self.is_namespace(b) {
            let ns = self.tir.nodes[b].name.clone()
            return self.check_namespace_member(ns[..], name[..], start, end, expected)
        }
        let bt = self.tys.shallow(self.tir.nodes[b].ty)
        if self.tys.kind(bt) == TK.Type and self.tir.nodes[b].k == TKind.TypeVal {
            return self.check_static_member(self.tir.nodes[b].a, name[..], start, end, expected)
        }
        return self.field_access(b, name[..], start, end)
    }

    /// Dereference through every pointer, the new nodes spanning the access.
    /// A namespace value (`io`, `math`, an imported module): a Unit node without a type.
    fn is_namespace(self: *mut Self, e: usize) -> bool {
        return self.tir.nodes[e].k == TKind.Unit and self.tir.nodes[e].ty == NONE
    }

    fn deref_all_at(self: *mut Self, b0: usize, start: usize, end: usize) -> usize {
        var b = b0
        var bt = self.tys.shallow(self.tir.nodes[b].ty)
        while self.tys.kind(bt) == TK.Ptr {
            let inner = self.tys.list[bt].args[0]
            let d = self.mk(TKind.Deref, inner, start, end)
            self.tir.nodes[d].kids.append(b)
            b = d
            bt = self.tys.shallow(inner)
        }
        return b
    }

    fn field_access(self: *mut Self, b0: usize, name: []u8, start: usize, end: usize) -> usize {
        let b = self.deref_all_at(b0, start, end)
        let bt = self.tys.shallow(self.tir.nodes[b].ty)
        let k = self.tys.kind(bt)
        if k == TK.Struct {
            let d = self.tys.list[bt].def
            let idx = self.struct_field_index(d, name)
            if idx != NONE {
                let ftys = self.struct_field_types(bt)
                let fty = ftys[idx]
                let r = self.mk(if self.structs[d].kind == "ref" { TKind.RefField } else { TKind.Field }, fty, start, end)
                self.tir.nodes[r].a = idx
                self.tir.nodes[r].kids.append(b)
                return r
            }
            self.fail_here(start, format("`{}` has no field `{}`", .{self.structs[d].name, name})[..])
            return self.error_expr(start, end)
        }
        if k == TK.Tuple {
            let idx = name.parse_int(usize) catch { NONE }
            let ts = self.tys.list[bt].args.clone()
            if idx != NONE and idx < ts.len {
                let r = self.mk(TKind.TupleField, ts[idx], start, end)
                self.tir.nodes[r].a = idx
                self.tir.nodes[r].kids.append(b)
                return r
            }
            self.fail_here(start, format("tuple has no field `{}`", .{name})[..])
            return self.error_expr(start, end)
        }
        if k == TK.Slice or k == TK.Array or k == TK.List or k == TK.Str or k == TK.Map {
            if name == "len" {
                let u = self.tys.usize_ty()
                let r = self.builtin_node("Len", u, start, end)
                self.tir.nodes[r].kids.append(b)
                return r
            }
            if name == "ptr" and k == TK.Slice {
                if self.ctx().unsafe_depth == 0 { self.fail_here(start, "`.ptr` of a slice is a raw pointer and requires an `unsafe` block") }
                let pt = self.tys.wrap(TK.Ptr, self.tys.list[bt].args[0], self.tys.list[bt].flag)
                let r = self.builtin_node("PtrAdd", pt, start, end)
                self.tir.nodes[r].kids.append(b)
                return r
            }
            self.fail_here(start, format("`{}` has no field `{}` (methods are called with parentheses)", .{self.ty_name(bt), name})[..])
            return self.error_expr(start, end)
        }
        if k == TK.Opt {
            self.fail_here(start, format("cannot access field `{}` of optional `{}`; unwrap it first with `orelse`, `.?`, or `if let`", .{name, self.ty_name(bt)})[..])
            return self.error_expr(start, end)
        }
        if k == TK.ErrUnion {
            self.fail_here(start, format("cannot access field `{}` of `{}`; use `try` first", .{name, self.ty_name(bt)})[..])
            return self.error_expr(start, end)
        }
        if k == TK.Enum {
            self.fail_here(start, format("`{}` is an enum; use `match` to access variant payloads", .{self.enums[self.tys.list[bt].def].name})[..])
            return self.error_expr(start, end)
        }
        self.fail_here(start, format("`{}` has no field `{}`", .{self.ty_name(bt), name})[..])
        return self.error_expr(start, end)
    }

    fn check_implicit_variant(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let name = n.name.clone()
        let args = n.kids.clone()
        let start = n.start
        let end = n.end
        if expected == NONE {
            self.fail_here(start, format("cannot infer the enum type of `.{}`; write `EnumName.{}`", .{name, name})[..])
            return self.error_expr(start, end)
        }
        let exp = self.tys.shallow(expected)
        var target = exp
        var wrap = NONE
        let ek = self.tys.kind(exp)
        if ek == TK.Opt or ek == TK.ErrUnion {
            target = self.tys.shallow(self.tys.list[exp].args[0])
            wrap = exp
        }
        if self.tys.kind(target) != TK.Enum {
            self.fail_here(start, format("`.{}` needs an enum type from context, but the expected type is `{}`", .{name, self.ty_name(exp)})[..])
            return self.error_expr(start, end)
        }
        let v = self.check_variant_ctor(target, name[..], args[..], start, end)
        if wrap != NONE { return self.coerce_or_error(v, wrap, "enum value") }
        return v
    }

    fn check_variant_ctor(self: *mut Self, enum_ty: usize, name: []u8, args: []usize, start: usize, end: usize) -> usize {
        let d = self.tys.list[enum_ty].def
        let vtys = self.enum_variant_types(enum_ty)
        let idx = self.enum_variant_index(d, name)
        if idx == NONE {
            self.fail_here(start, format("enum `{}` has no variant `{}`", .{self.enums[d].name, name})[..])
            return self.error_expr(start, end)
        }
        let want = vtys[idx].clone()
        if args.len != want.len {
            self.fail_here(start, format("variant `{}.{}` takes {} value(s) but {} were given", .{self.enums[d].name, name, want.len, args.len})[..])
            return self.error_expr(start, end)
        }
        let r = self.mk(TKind.EnumLit, enum_ty, start, end)
        self.tir.nodes[r].a = idx
        for a, i in args {
            var te = self.check_expr(a, want[i])
            te = self.coerce_or_error(te, want[i], "enum variant payload")
            te = self.take_ownership(te)
            self.tir.nodes[r].kids.append(te)
        }
        return r
    }

    fn check_index(self: *mut Self, e: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let base_node = n.x
        let index_node = n.y
        let start = n.start
        let end = n.end
        var b = self.check_expr(base_node, NONE)
        b = self.deref_all_at(b, start, end)
        let bt = self.tys.shallow(self.tir.nodes[b].ty)
        let k = self.tys.kind(bt)
        var elem = NONE
        if k == TK.Array or k == TK.Slice or k == TK.List {
            elem = self.tys.list[bt].args[0]
        } else if k == TK.Str {
            elem = self.tys.u8_ty()
        } else if k == TK.Map {
            let kt = self.tys.list[bt].args[0]
            let vt = self.tys.list[bt].args[1]
            var lk = kt
            if self.tys.kind(self.tys.shallow(kt)) == TK.Str { lk = self.tys.str_slice() }
            var key = self.check_expr(index_node, lk)
            key = self.coerce_or_error(key, lk, "map key")
            let ot = self.tys.wrap(TK.Opt, vt, false)
            let r = self.builtin_node("MapGet", ot, start, end)
            self.tir.nodes[r].kids.append(b)
            self.tir.nodes[r].kids.append(key)
            return r
        } else {
            self.fail_here(start, format("cannot index a value of type `{}`", .{self.ty_name(bt)})[..])
            return self.error_expr(start, end)
        }
        let u = self.tys.usize_ty()
        var i = self.check_expr(index_node, u)
        i = self.coerce_or_error(i, u, "index")
        let proven = self.index_proven(b, i)
        if !proven { self.add_effect(EFF_PANICS, start, "index may be out of bounds") }
        let r = self.mk(TKind.Index, elem, start, end)
        self.tir.nodes[r].flag = proven
        self.tir.nodes[r].kids.append(b)
        self.tir.nodes[r].kids.append(i)
        return r
    }

    fn index_proven(self: *mut Self, base: usize, index: usize) -> bool {
        let bt = self.tys.shallow(self.tir.nodes[base].ty)
        if self.tys.kind(bt) == TK.Array {
            if let r = self.expr_range(index) { return r.lo >= 0 and r.hi < self.tys.list[bt].n as i128 }
        }
        if self.tir.nodes[base].k == TKind.Local and self.tir.nodes[index].k == TKind.Local {
            let bl = self.tir.nodes[base].a
            let il = self.tir.nodes[index].a
            if let sl = self.ctx().index_of.get(il) { if sl == bl { return true } }
        }
        return false
    }

    fn check_slice_op(self: *mut Self, e: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let base_node = n.x
        let start_node = n.y
        let end_node = n.z
        let start = n.start
        let end = n.end
        var b = self.check_expr(base_node, NONE)
        b = self.deref_all_at(b, start, end)
        let bt = self.tys.shallow(self.tir.nodes[b].ty)
        let k = self.tys.kind(bt)
        var mutable = false
        var elem = NONE
        if k == TK.Array or k == TK.List {
            mutable = self.place_mutable(b)
            elem = self.tys.list[bt].args[0]
        } else if k == TK.Slice {
            mutable = self.tys.list[bt].flag
            elem = self.tys.list[bt].args[0]
        } else if k == TK.Str {
            mutable = self.place_mutable(b)
            elem = self.tys.u8_ty()
        } else {
            self.fail_here(start, format("cannot slice a value of type `{}`", .{self.ty_name(bt)})[..])
            return self.error_expr(start, end)
        }
        let u = self.tys.usize_ty()
        let st = self.tys.wrap(TK.Slice, elem, mutable)
        let r = self.mk(TKind.SliceOp, st, start, end)
        self.tir.nodes[r].kids.append(b)
        if start_node != NONE {
            var s = self.check_expr(start_node, u)
            s = self.coerce_or_error(s, u, "slice start")
            self.tir.nodes[r].flag = true
            self.tir.nodes[r].kids.append(s)
        }
        if end_node != NONE {
            var x = self.check_expr(end_node, u)
            x = self.coerce_or_error(x, u, "slice end")
            self.tir.nodes[r].flag2 = true
            self.tir.nodes[r].kids.append(x)
        }
        self.add_effect(EFF_PANICS, start, "slicing checks its bounds and panics when they are out of range")
        return r
    }

    fn check_struct_lit(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let ty_node = n.x
        let inits = n.kids.clone()
        let start = n.start
        let end = n.end
        var t = NONE
        if ty_node != NONE {
            // `Enum.Variant{ ... }`: a struct-payload variant
            let tn = self.node(m, ty_node)
            if tn.k == parser.NodeKind.TName and tn.words.len == 2 and tn.kids.len == 0 {
                if let r = self.lookup(m, tn.words[0][..]) {
                    if r.kind == ItemKind.Enum {
                        let et = self.tys.of_def(TK.Enum, r.id, List(usize).new())
                        return self.check_variant_struct_lit(et, tn.words[1].clone()[..], inits[..], start, end)
                    }
                }
            }
            let st = self.ctx().self_ty
            t = self.resolve_type(m, ty_node, st)
        } else {
            if expected == NONE {
                self.fail_here(start, "cannot infer the type of this anonymous struct literal; name the type: `Point{ ... }`")
                return self.error_expr(start, end)
            }
            let ex = self.tys.shallow(expected)
            let ek = self.tys.kind(ex)
            if ek == TK.Opt or ek == TK.ErrUnion {
                let inner = self.tys.list[ex].args[0]
                let v = self.check_struct_lit_into(e, inner)
                return self.coerce_or_error(v, ex, "struct literal")
            }
            t = ex
        }
        return self.check_struct_lit_into(e, t)
    }

    /// A struct literal of a known type.
    fn check_struct_lit_into(self: *mut Self, e: usize, t0: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let inits = n.kids.clone()
        let start = n.start
        let end = n.end
        let t = self.tys.shallow(t0)
        if self.tys.kind(t) != TK.Struct {
            if inits.len == 0 and self.tys.kind(t) == TK.Void { return self.mk(TKind.Unit, t, start, end) }
            self.fail_here(start, format("`{}` is not a struct; struct literal syntax does not apply", .{self.ty_name(t)})[..])
            return self.error_expr(start, end)
        }
        let d = self.tys.list[t].def
        let ftys = self.struct_field_types(t)
        let n_fields = self.structs[d].fields.len
        var seen = List(bool).new()
        for i in 0..n_fields { seen.append(false) }
        var idxs = List(usize).new()
        var vals = List(usize).new()
        for init in inits {
            let inode = self.node(m, init)
            let fname = inode.name.clone()
            let value_node = inode.x
            let fstart = inode.start
            let idx = self.struct_field_index(d, fname[..])
            if idx == NONE {
                self.fail_here(fstart, format("`{}` has no field `{}`", .{self.structs[d].name, fname})[..])
                continue
            }
            if seen[idx] {
                self.fail_here(fstart, format("field `{}` is given twice", .{fname})[..])
                continue
            }
            seen[idx] = true
            var v = self.check_expr(value_node, ftys[idx])
            v = self.coerce_or_error(v, ftys[idx], format("field `{}`", .{fname})[..])
            v = self.take_ownership(v)
            idxs.append(idx)
            vals.append(v)
        }
        let dm = self.structs[d].module
        let fields = self.structs[d].fields.clone()
        for f, i in fields {
            if seen[i] { continue }
            let fnode = self.node(dm, f)
            let fname = fnode.name.clone()
            let dflt = fnode.y
            if dflt != NONE {
                // the default is written in the struct's module
                var v = self.check_expr_in_module(dm, dflt, ftys[i])
                v = self.coerce_or_error(v, ftys[i], format("default of field `{}`", .{fname})[..])
                idxs.append(i)
                vals.append(v)
            } else {
                self.fail_here(start, format("missing field `{}` in literal of `{}`", .{fname, self.structs[d].name})[..])
            }
        }
        // in field order
        let is_ref = self.structs[d].kind == "ref"
        if is_ref {
            self.add_effect(EFF_ALLOCATES, start, "constructing a `ref class` allocates")
            self.add_effect(EFF_REFCOUNTS, start, "a `ref class` value is reference counted")
        }
        let lit = self.mk(if is_ref { TKind.RefNew } else { TKind.StructLit }, t, start, end)
        for fi in 0..n_fields {
            for x, j in idxs {
                if x == fi {
                    self.tir.nodes[lit].kids2.append(x)
                    self.tir.nodes[lit].kids.append(vals[j])
                }
            }
        }
        if self.structs[d].kind == "record" and !self.record_new_mode {
            return self.record_check(lit, t, false, start, end)
        }
        return lit
    }

    /// Wrap a record value in its constraint checks; a check that decides at
    /// compile time is dropped (or reported when it fails).
    fn record_check(self: *mut Self, lit: usize, t: usize, as_error: bool, start: usize, end: usize) -> usize {
        if self.tys.kind(t) != TK.Struct { return lit }
        let d = self.tys.list[t].def
        let dm = self.structs[d].module
        let ftys = self.struct_field_types(t)
        let fields = self.structs[d].fields.clone()
        var check_fields = List(usize).new()
        var check_locals = List(usize).new()
        var check_exprs = List(usize).new()
        for f, i in fields {
            let fnode = self.node(dm, f)
            let c = fnode.z
            if c == NONE { continue }
            let fname = fnode.name.clone()
            let fstart = fnode.start
            let fend = fnode.end
            let cstart = self.node(dm, c).start
            let cend = self.node(dm, c).end
            self.push_scope()
            let vl = self.declare_local("value", ftys[i], false, fstart, fend)
            let bt = self.tys.bool_ty()
            var ce = self.check_expr_in_module(dm, c, bt)
            ce = self.coerce_or_error(ce, bt, "record constraint")
            self.pop_scope()
            // static evaluation when the field value is a literal
            var decided = false
            var holds = false
            if !as_error and self.tir.nodes[lit].k == TKind.StructLit {
                let lk = self.tir.nodes[lit].kids.clone()
                let lf = self.tir.nodes[lit].kids2.clone()
                for x, j in lf {
                    if x != i { continue }
                    if let fv = self.eval_const_expr(lk[j]) {
                        if let r = self.eval_with_local(ce, vl, fv) {
                            if r.kind == VK_BOOL {
                                decided = true
                                holds = r.flag
                            }
                        }
                    }
                }
            }
            if decided and holds { continue }
            if decided {
                let csrc = self.source_text(dm, cstart, cend)
                self.fail_here(start, format("record `{}` constraint violated: field `{}` must satisfy `{}`", .{self.structs[d].name, fname, csrc})[..])
                continue
            }
            check_fields.append(i)
            check_locals.append(vl)
            check_exprs.append(ce)
        }
        if check_exprs.len == 0 {
            if as_error {
                let et = self.tys.err_union(0, false, t)
                var w = tblank(TKind.ErrWrap, et, start, end)
                w.kids.append(lit)
                return self.tir.add(w)
            }
            return lit
        }
        var rt = t
        if as_error {
            rt = self.tys.err_union(0, false, t)
        } else {
            self.add_effect(EFF_PANICS, start, "a record constraint that cannot be checked at compile time panics at runtime if violated (use `.new(...)` for an error instead)")
        }
        let r = self.mk(TKind.RecordCheck, rt, start, end)
        self.tir.nodes[r].flag = as_error
        self.tir.nodes[r].kids.append(lit)
        for ce, j in check_exprs {
            self.tir.nodes[r].kids.append(ce)
            self.tir.nodes[r].kids2.append(check_fields[j])
            self.tir.nodes[r].kids2.append(check_locals[j])
        }
        return r
    }

    /// Check an expression that lives in another module's tree (a field default).
    fn check_expr_in_module(self: *mut Self, dm: usize, e: usize, expected: usize) -> usize {
        let saved = self.ctx().module
        self.ctx().module = dm
        let r = self.check_expr(e, expected)
        self.ctx().module = saved
        return r
    }

    fn check_variant_struct_lit(self: *mut Self, et: usize, variant: []u8, inits: []usize, start: usize, end: usize) -> usize {
        let m = self.cur_module()
        let d = self.tys.list[et].def
        let idx = self.enum_variant_index(d, variant)
        if idx == NONE {
            self.fail_here(start, format("enum `{}` has no variant `{}`", .{self.enums[d].name, variant})[..])
            return self.error_expr(start, end)
        }
        let em = self.enums[d].module
        let vnode = self.enums[d].variants[idx]
        if self.node(em, vnode).text != "struct" {
            self.fail_here(start, format("variant `{}.{}` has no named fields", .{self.enums[d].name, variant})[..])
            return self.error_expr(start, end)
        }
        let field_nodes = self.node(em, vnode).kids.clone()
        let vtys = self.enum_variant_types(et)
        let want = vtys[idx].clone()
        var payload = List(usize).new()
        for i in 0..want.len { payload.append(NONE) }
        for init in inits {
            let inode = self.node(m, init)
            let fname = inode.name.clone()
            let value_node = inode.x
            var fi = NONE
            for f, i in field_nodes { if self.node(em, f).name == fname { fi = i } }
            if fi == NONE {
                self.fail_here(inode.start, format("variant `{}.{}` has no field `{}`", .{self.enums[d].name, variant, fname})[..])
                continue
            }
            var v = self.check_expr(value_node, want[fi])
            v = self.coerce_or_error(v, want[fi], format("field `{}`", .{fname})[..])
            v = self.take_ownership(v)
            payload[fi] = v
        }
        let r = self.mk(TKind.EnumLit, et, start, end)
        self.tir.nodes[r].a = idx
        for v, i in payload {
            if v == NONE {
                self.fail_here(start, format("missing field `{}` in `{}.{}`", .{self.node(em, field_nodes[i]).name, self.enums[d].name, variant})[..])
                continue
            }
            self.tir.nodes[r].kids.append(v)
        }
        return r
    }

    fn check_array_lit(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let elems = n.kids.clone()
        let start = n.start
        let end = n.end
        var exp = NONE
        if expected != NONE { exp = self.tys.shallow(expected) }
        var elem_hint = NONE
        var want_slice = false
        var want_list = false
        if exp != NONE {
            let ek = self.tys.kind(exp)
            if ek == TK.Array {
                if self.tys.list[exp].n as usize != elems.len {
                    self.fail_here(start, format("expected an array of {} elements but the literal has {}", .{self.tys.list[exp].n, elems.len})[..])
                }
                elem_hint = self.tys.list[exp].args[0]
            } else if ek == TK.Slice {
                elem_hint = self.tys.list[exp].args[0]
                want_slice = true
            } else if ek == TK.List {
                elem_hint = self.tys.list[exp].args[0]
                want_list = true
            }
        }
        let elem_ty = if elem_hint != NONE { elem_hint } else { self.tys.fresh_infer() }
        var out = List(usize).new()
        for x in elems {
            var te = self.check_expr(x, elem_ty)
            te = self.coerce_or_error(te, elem_ty, "array element")
            te = self.take_ownership(te)
            out.append(te)
        }
        if elems.len == 0 and elem_hint == NONE {
            self.fail_here(start, "cannot infer the element type of an empty array literal; annotate it, e.g. `let xs: [0]i32 = []`")
        }
        let at = self.tys.array(elems.len as u64, elem_ty)
        let lit = self.mk(TKind.ArrayLit, at, start, end)
        self.tir.nodes[lit].kids = out
        if want_slice {
            let r = self.mk(TKind.ArrayToSlice, exp, start, end)
            self.tir.nodes[r].kids.append(lit)
            return r
        }
        if want_list {
            self.add_effect(EFF_ALLOCATES, start, "building a List allocates")
            let st = self.tys.wrap(TK.Slice, elem_ty, false)
            let sl = self.mk(TKind.ArrayToSlice, st, start, end)
            self.tir.nodes[sl].kids.append(lit)
            let r = self.builtin_node("ListFromSlice", exp, start, end)
            self.tir.nodes[r].kids.append(sl)
            self.tir.nodes[r].kids2.append(elem_ty)
            return r
        }
        return lit
    }

    fn check_tuple_lit(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let elems = n.kids.clone()
        let start = n.start
        let end = n.end
        if elems.len == 0 {
            let v = self.tys.void()
            return self.mk(TKind.Unit, v, start, end)
        }
        var hints = List(usize).new()
        for i in 0..elems.len { hints.append(NONE) }
        if expected != NONE {
            let ex = self.tys.shallow(expected)
            if self.tys.kind(ex) == TK.Tuple and self.tys.list[ex].args.len == elems.len { hints = self.tys.list[ex].args.clone() }
        }
        var out = List(usize).new()
        var tys = List(usize).new()
        for x, i in elems {
            var te = self.check_expr(x, hints[i])
            if hints[i] != NONE { te = self.coerce_or_error(te, hints[i], "tuple element") }
            te = self.take_ownership(te)
            tys.append(self.tir.nodes[te].ty)
            out.append(te)
        }
        let tt = self.tys.tuple(tys)
        let r = self.mk(TKind.TupleLit, tt, start, end)
        self.tir.nodes[r].kids = out
        return r
    }

    // ----- error handling, optionals ----------------------------------------------------

    fn check_try(self: *mut Self, e: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let inner_node = n.x
        let start = n.start
        let end = n.end
        let ret = self.ctx().ret
        let ret_r = self.tys.shallow(ret)
        if self.tys.kind(ret_r) != TK.ErrUnion {
            self.fail_here(start, "`try` is only valid in a function that returns an error union")
            _ = self.check_expr(inner_node, NONE)
            return self.error_expr(start, end)
        }
        let inner = self.check_expr(inner_node, NONE)
        let it = self.tys.shallow(self.tir.nodes[inner].ty)
        if self.tys.kind(it) != TK.ErrUnion {
            self.fail_here(start, format("`try` requires an error union but found `{}`", .{self.ty_name(it)})[..])
            return inner
        }
        let payload = self.tys.list[it].args[0]
        let r = self.mk(TKind.Try, payload, start, end)
        self.tir.nodes[r].kids.append(inner)
        return r
    }

    fn check_catch(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let inner_node = n.x
        let handler_node = n.y
        let binding = n.name.clone()
        let has_binding = binding != "-"
        let start = n.start
        let end = n.end
        let inner = self.check_expr(inner_node, NONE)
        let it = self.tys.shallow(self.tir.nodes[inner].ty)
        if self.tys.kind(it) != TK.ErrUnion {
            self.fail_here(start, format("`catch` requires an error union but found `{}`", .{self.ty_name(it)})[..])
            return self.error_expr(start, end)
        }
        _ = expected
        let payload = self.tys.list[it].args[0]
        let set = self.tys.list[it].def
        let has_set = self.tys.list[it].flag
        self.push_scope()
        var err_local = NONE
        if has_binding {
            let et = self.tys.err_set(set, has_set)
            err_local = self.declare_local(binding[..], et, false, start, end)
        }
        let moved_before = self.moved_snapshot()
        var h = self.check_expr(handler_node, payload)
        if self.tys.kind(self.tys.shallow(self.tir.nodes[h].ty)) == TK.Never { self.moved_restore(&moved_before) }
        h = self.coerce_or_error(h, payload, "catch handler")
        self.pop_scope()
        let r = self.mk(TKind.Catch, payload, start, end)
        self.tir.nodes[r].a = err_local
        self.tir.nodes[r].kids.append(inner)
        self.tir.nodes[r].kids.append(h)
        return r
    }

    fn check_orelse(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let inner_node = n.x
        let default_node = n.y
        let start = n.start
        let end = n.end
        var hint = NONE
        if expected != NONE { hint = self.tys.wrap(TK.Opt, expected, false) }
        let inner = self.check_expr(inner_node, hint)
        let it = self.tys.shallow(self.tir.nodes[inner].ty)
        if self.tys.kind(it) != TK.Opt {
            self.fail_here(start, format("`orelse` requires an optional but found `{}`", .{self.ty_name(it)})[..])
            return self.error_expr(start, end)
        }
        let payload = self.tys.list[it].args[0]
        let moved_before = self.moved_snapshot()
        var d = self.check_expr(default_node, payload)
        if self.tys.kind(self.tys.shallow(self.tir.nodes[d].ty)) == TK.Never { self.moved_restore(&moved_before) }
        d = self.coerce_or_error(d, payload, "orelse default")
        let p = self.tys.resolve(payload, false)
        let r = self.mk(TKind.OrElse, p, start, end)
        self.tir.nodes[r].kids.append(inner)
        self.tir.nodes[r].kids.append(d)
        return r
    }

    fn check_if_capture(self: *mut Self, e: usize, expected: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, e)
        let cond_node = n.x
        let then_node = n.y
        let els_node = n.z
        let binding = n.name.clone()
        let start = n.start
        let end = n.end
        let c = self.check_expr(cond_node, NONE)
        let ct = self.tys.shallow(self.tir.nodes[c].ty)
        if self.tys.kind(ct) != TK.Opt {
            self.fail_here(self.tir.nodes[c].start, format("`if let v = x` requires an optional but found `{}`", .{self.ty_name(ct)})[..])
            return self.error_expr(start, end)
        }
        let payload = self.tys.list[ct].args[0]
        self.push_scope()
        let local = self.declare_local(binding[..], payload, false, start, end)
        let moved_before = self.moved_snapshot()
        let v = self.tys.void()
        let then_expected = if els_node != NONE { expected } else { v }
        let tb = self.check_block(then_node, then_expected, NONE, NONE)
        self.pop_scope()
        let moved_then = self.moved_snapshot()
        let then_ty = self.tir.nodes[tb].ty
        let then_diverges = self.tys.kind(self.tys.shallow(then_ty)) == TK.Never
        if then_diverges and els_node == NONE { self.moved_restore(&moved_before) }
        if els_node == NONE {
            let tk = self.tys.kind(self.tys.shallow(then_ty))
            if ! (tk == TK.Void or tk == TK.Never) { self.fail_here(self.tir.nodes[tb].start, "an `if` without `else` produces no value") }
            let r = self.mk(TKind.IfCapture, v, start, end)
            self.tir.nodes[r].a = local
            self.tir.nodes[r].kids.append(c)
            self.tir.nodes[r].kids.append(tb)
            return r
        }
        self.moved_restore(&moved_before)
        let hint = if then_diverges { expected } else { then_ty }
        var eb = NONE
        if self.node(m, els_node).k == parser.NodeKind.Block {
            eb = self.check_block(els_node, hint, NONE, NONE)
        } else {
            let te = self.check_expr(els_node, hint)
            eb = self.mk(TKind.Block, self.tir.nodes[te].ty, self.tir.nodes[te].start, self.tir.nodes[te].end)
            self.tir.nodes[eb].a = te
        }
        let else_diverges = self.tys.kind(self.tys.shallow(self.tir.nodes[eb].ty)) == TK.Never
        let moved_else = self.moved_snapshot()
        self.moved_restore(&moved_before)
        if !then_diverges { self.moved_merge(&moved_then) }
        if !else_diverges { self.moved_merge(&moved_else) }
        let ty = self.join_branches(tb, eb, expected)
        let r = self.mk(TKind.IfCapture, ty, start, end)
        self.tir.nodes[r].a = local
        self.tir.nodes[r].kids.append(c)
        self.tir.nodes[r].kids.append(tb)
        self.tir.nodes[r].kids.append(eb)
        return r
    }

    // ----- loops over items ----------------------------------------------------------------

    fn check_for_items(self: *mut Self, s: usize) -> usize {
        let m = self.cur_module()
        let n = self.node(m, s)
        let label = n.name.clone()
        let is_parallel = n.flag2
        let bindings = n.words.clone()
        let start = n.start
        let end = n.end
        let items = n.kids2.clone()
        let body_node = n.a
        let n_items = items.len
        if ! (bindings.len == n_items or bindings.len == n_items + 1) {
            self.fail_here(start, format("this loop iterates {} value(s) and may bind an index; expected {} or {} names but found {}", .{n_items, n_items, n_items + 1, bindings.len})[..])
            return NONE
        }
        var checked = List(usize).new()
        var elems = List(usize).new()
        for it in items {
            let istart = self.node(m, it).start
            let iend = self.node(m, it).end
            var te = self.check_expr(it, NONE)
            te = self.auto_deref_all(te)
            let t = self.tys.shallow(self.tir.nodes[te].ty)
            let k = self.tys.kind(t)
            var elem = NONE
            if k == TK.Array or k == TK.Slice or k == TK.List {
                elem = self.tys.list[t].args[0]
            } else if k == TK.Str {
                elem = self.tys.u8_ty()
            } else if k == TK.Map {
                let kt = self.tys.list[t].args[0]
                let ks = self.tys.wrap(TK.Slice, kt, false)
                let b = self.builtin_node("MapKeys", ks, istart, iend)
                self.tir.nodes[b].kids.append(te)
                self.tir.nodes[b].kids2.append(kt)
                self.add_effect(EFF_ALLOCATES, istart, "iterating a Map collects its keys")
                checked.append(b)
                elems.append(kt)
                continue
            } else {
                self.fail_here(istart, format("cannot iterate a value of type `{}`; expected an array, slice, List, String, or Map", .{self.ty_name(t)})[..])
                return NONE
            }
            if k == TK.Array {
                let mu = self.place_mutable(te)
                let st = self.tys.wrap(TK.Slice, elem, mu)
                te = self.wrap_node(TKind.ArrayToSlice, te, st)
            } else if k == TK.List {
                let mu = self.place_mutable(te)
                let st = self.tys.wrap(TK.Slice, elem, mu)
                te = self.wrap_node(TKind.ListToSlice, te, st)
            } else if k == TK.Str {
                let st = self.tys.wrap(TK.Slice, elem, false)
                te = self.wrap_node(TKind.StrToSlice, te, st)
            }
            checked.append(te)
            elems.append(elem)
        }
        self.push_scope()
        var item_locals = List(usize).new()
        for te, i in checked {
            let l = self.declare_local(bindings[i][..], elems[i], false, start, end)
            self.ctx().locals[l].loop_item = true
            item_locals.append(l)
        }
        var index = NONE
        if bindings.len == n_items + 1 {
            let u = self.tys.usize_ty()
            let l = self.declare_local(bindings[n_items][..], u, false, start, end)
            for te in checked {
                var src = te
                let k = self.tir.nodes[te].k
                if k == TKind.ListToSlice or k == TKind.ArrayToSlice { src = self.tir.nodes[te].kids[0] }
                if self.tir.nodes[src].k == TKind.Local { self.ctx().index_of.put(l, self.tir.nodes[src].a) }
            }
            index = l
        }
        let lid = self.new_label(label[..], label.len > 0, true, NONE)
        self.ctx().loop_depth += 1
        let v = self.tys.void()
        // a parallel body must not touch shared mutable state
        let w_before = self.ctx().witnesses.len
        let c_before = self.ctx().callees.len
        if is_parallel { self.ctx().in_parallel += 1 }
        let tb = self.check_block(body_node, v, NONE, NONE)
        if is_parallel {
            self.ctx().in_parallel -= 1
            let nw = self.ctx().witnesses.len
            for wi in w_before..nw {
                if (self.ctx().witnesses[wi].effects & EFF_SHARED_MUTABLE) != 0 {
                    let wat = self.ctx().witnesses[wi].at
                    self.fail_here(wat, "a `for parallel` body must not have the `shared_mutable` effect")
                }
            }
            let nc = self.ctx().callees.len
            for ci in c_before..nc {
                let callee = self.ctx().callees[ci]
                self.parallel_calls.append(Obligation{ .inst = callee, .neg = 0, .at = start, .module = self.cur_module() })
            }
            self.add_effect(EFF_BLOCKS, start, "`for parallel` joins its worker threads")
        }
        self.ctx().loop_depth -= 1
        _ = self.ctx().labels.pop()
        self.pop_scope()
        let node = self.stmt_node(TKind.SForSlice, start, end)
        self.tir.nodes[node].a = index
        self.tir.nodes[node].b = lid
        self.tir.nodes[node].flag = is_parallel
        self.tir.nodes[node].kids = checked
        self.tir.nodes[node].kids2 = item_locals
        self.tir.nodes[node].kids.append(tb)
        return node
    }
}

// ---------------------------------------------------------------- methods, static and namespace calls

/// A builtin namespace function: argument type codes, result type code, the
/// builtin's name, and the effects it carries.
pub struct NsFn {
    ns: []u8
    name: []u8
    args: []u8
    ret: []u8
    op: []u8
    effects: u64
}

const NS_FNS = [
    NsFn{ .ns = "io", .name = "read_file", .args = "bytes", .ret = "!string", .op = "ReadFile", .effects = EFF_BLOCKS | EFF_ALLOCATES },
    NsFn{ .ns = "io", .name = "write_file", .args = "bytes bytes", .ret = "!void", .op = "WriteFile", .effects = EFF_BLOCKS },
    NsFn{ .ns = "io", .name = "read_line", .args = "", .ret = "?string", .op = "ReadLine", .effects = EFF_BLOCKS | EFF_ALLOCATES },
    NsFn{ .ns = "io", .name = "append_file", .args = "bytes bytes", .ret = "!void", .op = "AppendFile", .effects = EFF_BLOCKS },
    NsFn{ .ns = "io", .name = "file_kind", .args = "bytes", .ret = "i32", .op = "FsKind", .effects = EFF_BLOCKS },
    NsFn{ .ns = "io", .name = "file_size", .args = "bytes", .ret = "!u64", .op = "FsSize", .effects = EFF_BLOCKS },
    NsFn{ .ns = "io", .name = "file_modified", .args = "bytes", .ret = "!i64", .op = "FsModified", .effects = EFF_BLOCKS },
    NsFn{ .ns = "io", .name = "make_dir", .args = "bytes", .ret = "!void", .op = "FsMkdir", .effects = EFF_BLOCKS },
    NsFn{ .ns = "io", .name = "remove_file", .args = "bytes", .ret = "!void", .op = "FsRemoveFile", .effects = EFF_BLOCKS },
    NsFn{ .ns = "io", .name = "remove_dir", .args = "bytes", .ret = "!void", .op = "FsRemoveDir", .effects = EFF_BLOCKS },
    NsFn{ .ns = "io", .name = "rename", .args = "bytes bytes", .ret = "!void", .op = "FsRename", .effects = EFF_BLOCKS },
    NsFn{ .ns = "io", .name = "list_dir", .args = "bytes", .ret = "!List(string)", .op = "FsListDir", .effects = EFF_BLOCKS | EFF_ALLOCATES },
    NsFn{ .ns = "io", .name = "cwd", .args = "", .ret = "!string", .op = "FsCwd", .effects = EFF_ALLOCATES },
    NsFn{ .ns = "io", .name = "temp_dir", .args = "", .ret = "string", .op = "FsTempDir", .effects = EFF_ALLOCATES },
    NsFn{ .ns = "io", .name = "open", .args = "bytes bytes", .ret = "!i64", .op = "FileOpen", .effects = EFF_BLOCKS },
    NsFn{ .ns = "io", .name = "read", .args = "i64 usize", .ret = "!string", .op = "FileRead", .effects = EFF_BLOCKS | EFF_ALLOCATES },
    NsFn{ .ns = "io", .name = "write", .args = "i64 bytes", .ret = "!void", .op = "FileWrite", .effects = EFF_BLOCKS },
