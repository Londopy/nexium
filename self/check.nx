    NsFn{ .ns = "os", .name = "args", .args = "", .ret = "[]bytes", .op = "Args", .effects = 0 },
    NsFn{ .ns = "os", .name = "environ", .args = "", .ret = "List(string)", .op = "Environ", .effects = EFF_NONDETERMINISTIC | EFF_ALLOCATES },
    NsFn{ .ns = "os", .name = "env", .args = "bytes", .ret = "?bytes", .op = "Env", .effects = EFF_NONDETERMINISTIC },
