// `artifact node`: an npm package over the shared library.
//
// The package is plain JavaScript calling the library through `koffi` (a
// prebuilt FFI package on npm), so it needs no build step, no node-gyp and
// no N-API headers on the user's machine. Errors from Nexium code arrive as
// `NexiumError`; a panic inside the library is caught at the export boundary
// and becomes `NexiumPanic`. A `.d.ts` gives every export its types.

import cgen

fn koffi_type(k: *cgen.Scalar) -> []u8 {
    if k.kind == 1 { return "float32" }
    if k.kind == 2 { return "float64" }
    if k.kind == 3 { return "bool" }
    if k.kind == 4 { return "uint32" }
    let n = k.int_name[..]
    if n == "i8" { return "int8" }
    if n == "i16" { return "int16" }
    if n == "i32" { return "int32" }
    if n == "i64" { return "int64" }
    if n == "u8" { return "uint8" }
    if n == "u16" { return "uint16" }
    if n == "u32" { return "uint32" }
    if n == "u64" { return "uint64" }
    if n == "isize" { return "intptr" }
    if n == "usize" { return "size_t" }
    return "int64"
}

/// The typed array a slice of this element is exchanged through.
fn typed_array(k: *cgen.Scalar) -> []u8 {
    if k.kind == 1 { return "Float32Array" }
    if k.kind == 2 { return "Float64Array" }
    if k.kind == 3 { return "Uint8Array" }
    if k.kind == 4 { return "Uint32Array" }
    let n = k.int_name[..]
    if n == "i8" { return "Int8Array" }
    if n == "u8" { return "Uint8Array" }
    if n == "i16" { return "Int16Array" }
    if n == "u16" { return "Uint16Array" }
    if n == "i32" { return "Int32Array" }
    if n == "u32" { return "Uint32Array" }
    if n == "i64" or n == "isize" { return "BigInt64Array" }
    if n == "u64" or n == "usize" { return "BigUint64Array" }
    return "BigInt64Array"
}

fn ts_type(k: *cgen.Scalar) -> []u8 {
    if k.kind == 3 { return "boolean" }
    if k.kind != 0 { return "number" }
    let n = k.int_name[..]
    if n == "i64" or n == "u64" or n == "isize" or n == "usize" or n == "i128" or n == "u128" { return "bigint" }
    return "number"
}

fn struct_name(c_name: []u8) -> []u8 {
    if c_name.starts_with("nx_") { return c_name[3..] }
    return c_name
}

fn join(parts: *List(String), sep: []u8) -> String {
    var out = String.new()
    for p, i in parts {
        if i > 0 { out.append(sep) }
        out.append(p[..])
    }
    return out
}

fn quoted(s: []u8) -> String {
    var out = String.from("\"")
    for c in s {
        if c == '"' or c == '\\' { out.push_byte('\\') }
        out.push_byte(c)
    }
    out.append("\"")
    return out
}

fn structs_of(infos: *List(cgen.ExportInfo)) -> List(*cgen.ExportParam) {
    var seen = List(String).new()
    var out = List(*cgen.ExportParam).new()
    for info in infos {
        for p, i in info.params {
            if p.kind == 2 and !has(&seen, p.c_name[..]) { seen.append(p.c_name.clone()); out.append(&info.params[i]) }
        }
        if info.has_ret and info.ret.kind == 2 and !has(&seen, info.ret.c_name[..]) { seen.append(info.ret.c_name.clone()); out.append(&info.ret) }
    }
    return out
}

fn has(xs: *List(String), s: []u8) -> bool {
    for x in xs { if x == s { return true } }
    return false
}

/// The `index.js` of the package.
pub fn module(lib: []u8, version: []u8, infos: *List(cgen.ExportInfo), libfile: []u8) -> String {
    var js = String.new()
    js.append(format("// {} {} - generated by nx from a Nexium source tree.\n//\n// Every function calls into the native library through koffi. Errors raised\n// by the Nexium code arrive as NexiumError; a panic inside the native code is\n// caught at the boundary and raised as NexiumPanic.\n'use strict';\nconst path = require('path');\nconst koffi = require('koffi');\n\n", .{lib, version})[..])
    js.append(format("const lib = koffi.load(path.join(__dirname, {}));\nconst errorName = lib.func('{}_error_name', 'str', ['int32']);\nconst lastPanic = lib.func('{}_last_panic', 'str', []);\n\n", .{quoted(libfile), lib, lib})[..])
    js.append("class NexiumError extends Error {\n  constructor(code) {\n    const name = errorName(code);\n    super(name);\n    this.name = 'NexiumError';\n    this.code = code;\n    this.errorName = name;\n  }\n}\n\nclass NexiumPanic extends NexiumError {\n  constructor(code) {\n    super(code);\n    this.name = 'NexiumPanic';\n    this.message = lastPanic();\n  }\n}\n\nfunction raise(code) {\n  if (errorName(code) === 'Panic') throw new NexiumPanic(code);\n  throw new NexiumError(code);\n}\n\n// a slice argument: a typed array is passed as is, anything iterable is copied\nfunction buf(value, Ctor) {\n  if (value instanceof Ctor) return value;\n  if (typeof value === 'string') return Buffer.from(value, 'utf8');\n  if (Buffer.isBuffer(value) && Ctor === Uint8Array) return value;\n  return Ctor.from(value);\n}\n\n")
    for st in structs_of(infos) {
        let name = struct_name(st.c_name[..])
        var members = List(String).new()
        for f in st.fields { members.append(format("{}: '{}'", .{f.name, koffi_type(&f.scalar)})) }
        js.append(format("const {}_t = koffi.struct('{}', {{ {} }});\n", .{name, name, join(&members, ", ")})[..])
    }
    js.append("\n")
    for info in infos {
        var ctypes = List(String).new()
        var params = List(String).new()
        var conv = List(String).new()
        var call = List(String).new()
        for p in info.params {
            if p.kind == 0 {
                ctypes.append(format("'{}'", .{koffi_type(&p.scalar)}))
                params.append(p.name.clone())
                call.append(p.name.clone())
            } else if p.kind == 1 {
                ctypes.append(format("'{}{} *'", .{if p.mutable { "_Inout_ " } else { "" }, koffi_type(&p.scalar)}))
                ctypes.append(String.from("'size_t'"))
                params.append(p.name.clone())
                conv.append(format("  const _{} = buf({}, {});", .{p.name, p.name, typed_array(&p.scalar)}))
                call.append(format("_{}", .{p.name}))
                call.append(format("_{}.length", .{p.name}))
            } else {
                ctypes.append(format("{}_t", .{struct_name(p.c_name[..])}))
                params.append(p.name.clone())
                call.append(p.name.clone())
            }
        }
        var ret = String.new()
        if info.has_ret {
            if info.ret.kind == 0 { ret = String.from(koffi_type(&info.ret.scalar)) }
            else if info.ret.kind == 2 { ret = format("{}_t", .{struct_name(info.ret.c_name[..])}) }
            else { ret = String.from("void") }
        }
        let effects = if info.effects.len == 0 { String.from("none") } else { info.effects.clone() }
        if info.status {
            var all = ctypes.clone()
            if info.has_ret {
                var base = ret[..]
                if base.ends_with("_t") { base = base[0..base.len - 2] }
                all.append(format("'_Out_ {} *'", .{base}))
            }
            js.append(format("const _{} = lib.func('{}', 'int32', [{}]);\n", .{info.name, info.name, join(&all, ", ")})[..])
            js.append(format("/** effects: {} */\n", .{effects})[..])
            js.append(format("function {}({}) {{\n", .{info.name, join(&params, ", ")})[..])
            for c in conv { js.append(format("{}\n", .{c})[..]) }
            if info.has_ret {
                var c2 = call.clone()
                c2.append(String.from("_out"))
                js.append(format("  const _out = [{}];\n  const code = _{}({});\n  if (code !== 0) raise(code);\n  return _out[0];\n", .{if ret[..].ends_with("_t") { "{}" } else { "0" }, info.name, join(&c2, ", ")})[..])
            } else {
                js.append(format("  const code = _{}({});\n  if (code !== 0) raise(code);\n", .{info.name, join(&call, ", ")})[..])
            }
            js.append("}\n\n")
        } else {
            let rt = if !info.has_ret { String.from("'void'") } else if ret[..].ends_with("_t") { ret.clone() } else { format("'{}'", .{ret}) }
            js.append(format("const _{} = lib.func('{}', {}, [{}]);\n", .{info.name, info.name, rt, join(&ctypes, ", ")})[..])
            js.append(format("/** effects: {} (cannot panic) */\n", .{effects})[..])
            js.append(format("function {}({}) {{\n", .{info.name, join(&params, ", ")})[..])
            for c in conv { js.append(format("{}\n", .{c})[..]) }
            js.append(format("  return _{}({});\n}}\n\n", .{info.name, join(&call, ", ")})[..])
        }
    }
    var names = List(String).new()
    for info in infos { names.append(info.name.clone()) }
    js.append(format("module.exports = {{ NexiumError, NexiumPanic, {} }};\n", .{join(&names, ", ")})[..])
    return js
}

/// The `index.d.ts` of the package.
pub fn typings(infos: *List(cgen.ExportInfo)) -> String {
    var ts = String.from("// generated by nx\nexport class NexiumError extends Error {\n  code: number;\n  errorName: string;\n}\nexport class NexiumPanic extends NexiumError {}\n\n")
    for st in structs_of(infos) {
        ts.append(format("export interface {} {{\n", .{struct_name(st.c_name[..])})[..])
        for f in st.fields { ts.append(format("  {}: {};\n", .{f.name, ts_type(&f.scalar)})[..]) }
        ts.append("}\n\n")
    }
    for info in infos {
        var params = List(String).new()
        for p in info.params {
            if p.kind == 0 { params.append(format("{}: {}", .{p.name, ts_type(&p.scalar)})) }
            else if p.kind == 1 {
                let is_u8 = p.scalar.kind == 0 and p.scalar.int_name == "u8"
                params.append(format("{}: {} | ArrayLike<{}>{}", .{p.name, typed_array(&p.scalar), ts_type(&p.scalar), if is_u8 { " | string" } else { "" }}))
            } else { params.append(format("{}: {}", .{p.name, struct_name(p.c_name[..])})) }
        }
        var ret = String.from("void")
        if info.has_ret {
            if info.ret.kind == 0 { ret = String.from(ts_type(&info.ret.scalar)) }
            else if info.ret.kind == 2 { ret = String.from(struct_name(info.ret.c_name[..])) }
        }
        for d in info.doc { ts.append(format("/** {} */\n", .{d})[..]) }
        ts.append(format("export function {}({}): {};\n", .{info.name, join(&params, ", "), ret})[..])
    }
    return ts
}

/// The `package.json` of the package.
pub fn package_json(name: []u8, version: []u8, libfile: []u8, os_name: []u8, cpu: []u8) -> String {
    return format("{{\n  \"name\": {},\n  \"version\": {},\n  \"description\": \"{} (built with Nexium)\",\n  \"main\": \"index.js\",\n  \"types\": \"index.d.ts\",\n  \"files\": [\"index.js\", \"index.d.ts\", {}],\n  \"dependencies\": {{ \"koffi\": \"^2.9.0\" }},\n  \"engines\": {{ \"node\": \">=18\" }},\n  \"os\": [\"{}\"],\n  \"cpu\": [\"{}\"]\n}}\n", .{quoted(name), quoted(version), name, quoted(libfile), os_name, cpu})
}
