// self/check_views.nx: views and their origins (specification 5.6). The
// checker knows where every view points (locals, a parameter's storage, a
// literal, a temporary, a value's own heap storage) and checks the rules V1
// to V5 against those origins: what a function returns, what a place keeps,
// and uses after a container changes, after a move, or past an arena.
// The methods are the checker's (`impl Checker`, decision 110).

import check

type Change = check.Change
type Checker = check.Checker
const NONE = check.NONE
const ORIGIN_PARAM = check.ORIGIN_PARAM
const ORIGIN_SELF = check.ORIGIN_SELF
const ORIGIN_STATIC = check.ORIGIN_STATIC
const ORIGIN_TEMP = check.ORIGIN_TEMP
type Origin = check.Origin
type TK = check.TK
type TKind = check.TKind

// ---------------------------------------------------------------- views and their origins (section 5.6)

impl Checker {
    /// Can a value of this type hold a view: a slice, a pointer, a function
    /// value (a closure's captures) or a trait object, or a container, an
    /// optional, an error union, a tuple, a struct or an enum holding one. A
    /// recursive type answers for its inner mention with "no", which is what
    /// the outer answer needs.
    fn holds_view(self: *mut Self, t0: usize) -> bool {
        // without defaulting: an open literal is decided by its use, not here
        let t = self.tys.resolve(t0, false)
        if let c = self.view_cache.get(t) { return c == 2 }
        self.view_cache.put(t, 1)
        let k = self.tys.kind(t)
        var r = false
        if k == TK.Slice or k == TK.Ptr or k == TK.Fn or k == TK.Dyn {
            r = true
        } else if k == TK.Opt or k == TK.ErrUnion or k == TK.Array or k == TK.List or k == TK.Map or k == TK.Tuple {
            for a in self.tys.list[t].args.clone() { if self.holds_view(a) { r = true } }
        } else if k == TK.Struct {
            for ft in self.struct_field_types(t) { if self.holds_view(ft) { r = true } }
        } else if k == TK.Enum {
            for tys in self.enum_variant_types(t) {
                for pt in tys { if self.holds_view(pt) { r = true } }
            }
        } else if k == TK.Distinct {
            r = self.holds_view(self.distinct_underlying(self.tys.list[t].def))
        }
        self.view_cache.put(t, if r { 2 } else { 1 })
        return r
    }

    /// The line of a source position in the current module.
    fn line_no(self: *mut Self, at: usize) -> usize {
        let src = self.mods[self.cur_module()].source[..]
        var line: usize = 1
        var i: usize = 0
        let stop = if at < src.len { at } else { src.len }
        while i < stop {
            if src[i] == '\n' { line += 1 }
            i += 1
        }
        return line
    }

    /// Where a value expression points when it holds a view: the storage it
    /// was taken from, or the origins the places and locals it reads already
    /// carry. Empty for an owner or a scalar. A view of a temporary is
    /// ORIGIN_TEMP; of a literal, ORIGIN_STATIC; of a parameter's storage,
    /// ORIGIN_PARAM; a call's result may point into any argument.
    fn origins_of(self: *mut Self, e: usize) -> List(Origin) {
        var out = List(Origin).new()
        if !self.holds_view(self.tir.nodes[e].ty) { return out }
        let k = self.tir.nodes[e].k
        let at = self.tir.nodes[e].start
        let kids = self.tir.nodes[e].kids.clone()
        if k == TKind.Local {
            let l = self.tir.nodes[e].a
            // a parameter is the caller's storage, unless `own`: then it is a local
            if self.ctx().locals[l].is_param and !self.ctx().locals[l].owned { check.add_origin(&mut out, ORIGIN_PARAM, at); return out }
            check.add_origins(&mut out, &self.ctx().locals[l].origins)
            return out
        }
        if k == TKind.Global { check.add_origin(&mut out, ORIGIN_STATIC, at); return out }
        if k == TKind.Str { check.add_origin(&mut out, ORIGIN_STATIC, at); return out }
        if k == TKind.Field or k == TKind.RefField or k == TKind.TupleField or k == TKind.Index or k == TKind.Deref {
            let os = self.origins_of(kids[0])
            // a part of a value that views its own heap storage: a view into the value
            let r = self.place_root(kids[0])
            if r == NONE { return os }
            for o in os {
                if o.local == ORIGIN_SELF { check.add_origin_h(&mut out, r, o.taken_at, true) } else { check.add_origin_f(&mut out, o.local, o.taken_at, o.heap, o.field) }
            }
            return out
        }
        if k == TKind.ArrayToSlice or k == TKind.ListToSlice or k == TKind.StrToSlice or k == TKind.SliceOp or k == TKind.AddrOf {
            var base = kids[0]
            var bk = self.tir.nodes[base].k
            var kind = k
            if k == TKind.SliceOp and (bk == TKind.ArrayToSlice or bk == TKind.ListToSlice or bk == TKind.StrToSlice) {
                kind = bk
                base = self.tir.nodes[base].kids[0]
                bk = self.tir.nodes[base].k
            }
            let os = self.storage_of(base, at)
            // into a container's buffer, which moves with the container, or into
            // inline storage (an array, a struct's fields), which does not
            var heap = false
            if kind == TKind.AddrOf {
                heap = self.place_through_heap(base)
            } else if kind == TKind.ListToSlice or kind == TKind.StrToSlice {
                heap = true
            } else {
                let btk = self.tys.kind(self.tys.shallow(self.tys.resolve(self.tir.nodes[base].ty, false)))
                if btk == TK.Slice or btk == TK.Ptr { return os }
                heap = btk == TK.List or btk == TK.Str or btk == TK.Map or self.place_through_heap(base)
            }
            for o in os { check.add_origin_f(&mut out, o.local, o.taken_at, (heap or o.heap) and o.local < ORIGIN_TEMP, o.field) }
            return out
        }
        if k == TKind.OptWrap or k == TKind.ErrWrap or k == TKind.Unwrap or k == TKind.Try or k == TKind.Retained or k == TKind.Cast or k == TKind.ErrToUnion or k == TKind.FnToFat or k == TKind.DynFrom {
            if kids.len > 0 { return self.origins_of(kids[0]) }
            return out
        }
        if k == TKind.OrElse or k == TKind.Catch {
            for c in kids {
                let os = self.origins_of(c)
                check.add_origins(&mut out, &os)
            }
            return out
        }
        if k == TKind.BlockExpr {
            let tail = self.tir.nodes[kids[0]].a
            if tail != NONE { return self.origins_of(tail) }
            return out
        }
        if k == TKind.Block {
            let tail = self.tir.nodes[e].a
            if tail != NONE { return self.origins_of(tail) }
            return out
        }
        if k == TKind.If or k == TKind.IfCapture {
            var i: usize = 1
            while i < kids.len {
                let os = self.origins_of(kids[i])
                check.add_origins(&mut out, &os)
                i += 1
            }
            return out
        }
        if k == TKind.Match {
            var i: usize = 1
            while i < kids.len {
                let arm = kids[i]
                let ak = self.tir.nodes[arm].kids.clone()
                if ak.len > 0 {
                    let os = self.origins_of(ak[ak.len - 1])
                    check.add_origins(&mut out, &os)
                }
                i += 1
            }
            return out
        }
        if k == TKind.StructLit or k == TKind.TupleLit or k == TKind.ArrayLit or k == TKind.ArrayRepeat or k == TKind.EnumLit or k == TKind.RefNew {
            for c in kids {
                let os = self.origins_of(c)
                check.add_origins(&mut out, &os)
            }
            return out
        }
        if k == TKind.Closure {
            if let caps = self.closure_caps.get(self.tir.nodes[e].a) {
                for l in caps {
                    if self.ctx().locals[l].is_param and !self.ctx().locals[l].owned { check.add_origin(&mut out, ORIGIN_PARAM, at); continue }
                    check.add_origin(&mut out, l, at)
                    check.add_origins(&mut out, &self.ctx().locals[l].origins)
                }
            }
            return out
        }
        if k == TKind.Call or k == TKind.CallPtr or k == TKind.DynCall or k == TKind.Builtin {
            // the result may point into any argument: a view's storage, a place, a temporary
            var any = false
            for c in kids {
                // a scalar argument is passed by value: nothing points into it
                let ck = self.tys.kind(self.tys.shallow(self.tys.resolve(self.tir.nodes[c].ty, false)))
                if ck == TK.Type or ck == TK.Int or ck == TK.Float or ck == TK.Bool or ck == TK.Char or ck == TK.Void or ck == TK.Never or ck == TK.ErrorSet { continue }
                // an argument moved into the call is the callee's now, not storage borrowed
                let cr = self.place_root(c)
                if cr != NONE and self.ctx().moved.contains(cr) { continue }
                let os = self.storage_of(c, at)
                if os.len > 0 { any = true }
                // a container passed by pointer: the result points into its buffer
                var heap = false
                if self.tir.nodes[c].k == TKind.AddrOf {
                    let ak = self.tys.kind(self.tys.shallow(self.tys.resolve(self.tir.nodes[self.tir.nodes[c].kids[0]].ty, false)))
                    heap = ak == TK.List or ak == TK.Str or ak == TK.Map
                }
                for o in os { check.add_origin_f(&mut out, o.local, o.taken_at, (heap or o.heap) and o.local < ORIGIN_TEMP, o.field) }
            }
            if !any { check.add_origin(&mut out, ORIGIN_STATIC, at) }
            return out
        }
        return out
    }

    /// The storage a view taken from `e` points into: the root local of a
    /// place, the origins of a view or a value that holds one, the caller's
    /// storage for a parameter, a literal's, or a temporary's.
    fn storage_of(self: *mut Self, e: usize, at: usize) -> List(Origin) {
        var out = List(Origin).new()
        let k = self.tir.nodes[e].k
        if k == TKind.Str { check.add_origin(&mut out, ORIGIN_STATIC, at); return out }
        if k == TKind.Global { check.add_origin(&mut out, ORIGIN_STATIC, at); return out }
        // a slice or a pointer is not storage: the view's origins are its storage's
        let ek = self.tys.kind(self.tys.shallow(self.tys.resolve(self.tir.nodes[e].ty, false)))
        if ek == TK.Slice or ek == TK.Ptr { return self.origins_of(e) }
        let r = self.place_root(e)
        if r != NONE {
            if self.ctx().locals[r].is_param and !self.ctx().locals[r].owned { check.add_origin(&mut out, ORIGIN_PARAM, at); return out }
            // a binding that views a value stands for that value's storage
            if self.ctx().locals[r].loop_item or self.ctx().locals[r].if_let or self.ctx().locals[r].tuple_view {
                check.add_origins(&mut out, &self.ctx().locals[r].origins)
                return out
            }
            check.add_origin_f(&mut out, r, at, false, self.first_field(e))
            return out
        }
        if self.holds_view(self.tir.nodes[e].ty) or self.is_borrowed_view(e) {
            let os = self.origins_of(e)
            if os.len > 0 { return os }
            if self.is_borrowed_view(e) { return out }
        }
        // a temporary is released at the end of the block that made it: it is
        // storage of this depth, a hidden local the rules can compare against
        if !self.is_place(e) and !self.is_borrowed_view(e) and self.needs_drop(self.tir.nodes[e].ty) {
            let t = self.declare_local("__temp", self.tir.nodes[e].ty, false, at, at)
            check.add_origin(&mut out, t, at)
        }
        return out
    }

    /// The first field on a place's path from its root local (`lv.rows[y]`
    /// is field `rows` of `lv`), or NONE when the path starts with an index
    /// or is the local itself.
    fn first_field(self: *mut Self, e: usize) -> usize {
        var cur = e
        var field = NONE
        while true {
            let k = self.tir.nodes[cur].k
            if k == TKind.Local { return field }
            if k == TKind.Field or k == TKind.TupleField { field = self.tir.nodes[cur].a }
            else if k == TKind.Index { field = NONE }
            else { return NONE }
            cur = self.tir.nodes[cur].kids[0]
        }
        return NONE
    }

    /// Does a view of this place point into heap storage its value owns (an
    /// element of a `List`, `String` or `Map` on the path), rather than into
    /// the place's own inline storage (an array, a struct's fields)?
    fn place_through_heap(self: *mut Self, e: usize) -> bool {
        let k = self.tir.nodes[e].k
        if k == TKind.Field or k == TKind.TupleField or k == TKind.Index {
            let base = self.tir.nodes[e].kids[0]
            if k == TKind.Index {
                let bk = self.tys.kind(self.tys.shallow(self.tys.resolve(self.tir.nodes[base].ty, false)))
                if bk == TK.List or bk == TK.Str or bk == TK.Map { return true }
            }
            return self.place_through_heap(base)
        }
        return false
    }

    /// What a stored value points into, where a view into heap storage that
    /// the same expression moves in (a literal holding a `String` and a slice
    /// of it) is a view into the value itself: it travels with the value.
    fn origins_for_store(self: *mut Self, value: usize) -> List(Origin) {
        var out = List(Origin).new()
        let lo = self.tir.nodes[value].start
        let hi = self.tir.nodes[value].end
        for o in self.origins_of(value) {
            if o.heap and o.local < ORIGIN_TEMP {
                if let moved_at = self.ctx().moved.get(o.local) {
                    if moved_at >= lo and moved_at <= hi { check.add_origin(&mut out, ORIGIN_SELF, o.taken_at); continue }
                }
            }
            check.add_origin_f(&mut out, o.local, o.taken_at, o.heap, o.field)
        }
        return out
    }

    /// The `using arena` nesting a value's heap storage was made in (0: the
    /// heap). A call, a literal or a clone makes its value where it stands,
    /// `@escape` one level out, a local carries what it was given, and a
    /// value taken out of a container was made where the container's was.
    fn value_arena_depth(self: *mut Self, e: usize) -> usize {
        if self.ctx().using_depth == 0 { return 0 }
        if !self.needs_drop(self.tir.nodes[e].ty) { return 0 }
        let k = self.tir.nodes[e].k
        let kids = self.tir.nodes[e].kids.clone()
        if k == TKind.Local { return self.ctx().locals[self.tir.nodes[e].a].made_in }
        if k == TKind.Global or k == TKind.Str { return 0 }
        if k == TKind.Field or k == TKind.TupleField or k == TKind.Index { return self.value_arena_depth(kids[0]) }
        if k == TKind.RefField or k == TKind.Deref {
            var d: usize = 0
            for o in self.origins_of(kids[0]) {
                if o.local < ORIGIN_TEMP and self.ctx().locals[o.local].made_in > d { d = self.ctx().locals[o.local].made_in }
            }
            return d
        }
        if k == TKind.Builtin {
            let name = self.tir.nodes[e].name.clone()
            if name == "Escape" { return self.ctx().using_depth - 1 }
            if name == "ListPop" or name == "ListRemove" or name == "ListSwapRemove" or name == "MapRemove" {
                var recv = kids[0]
                if self.tir.nodes[recv].k == TKind.AddrOf { recv = self.tir.nodes[recv].kids[0] }
                return self.value_arena_depth(recv)
            }
            return self.ctx().using_depth
        }
        if k == TKind.OptWrap or k == TKind.ErrWrap or k == TKind.Unwrap or k == TKind.Try or k == TKind.Retained or k == TKind.Cast or k == TKind.ErrToUnion {
            if kids.len > 0 { return self.value_arena_depth(kids[0]) }
            return 0
        }
        if k == TKind.BlockExpr {
            let tail = self.tir.nodes[kids[0]].a
            if tail != NONE { return self.value_arena_depth(tail) }
            return 0
        }
        if k == TKind.Block {
            let tail = self.tir.nodes[e].a
            if tail != NONE { return self.value_arena_depth(tail) }
            return 0
        }
        if k == TKind.Match {
            var d: usize = 0
            var i: usize = 1
            while i < kids.len {
                let ak = self.tir.nodes[kids[i]].kids.clone()
                if ak.len > 0 {
                    let ad = self.value_arena_depth(ak[ak.len - 1])
                    if ad > d { d = ad }
                }
                i += 1
            }
            return d
        }
        if k == TKind.OrElse or k == TKind.Catch or k == TKind.If or k == TKind.IfCapture or k == TKind.StructLit or k == TKind.TupleLit or k == TKind.ArrayLit or k == TKind.ArrayRepeat or k == TKind.EnumLit {
            var d: usize = 0
            for c in kids {
                let cd = self.value_arena_depth(c)
                if cd > d { d = cd }
            }
            return d
        }
        // a call, a literal, a container made here
        return self.ctx().using_depth
    }

    /// Rule V5: a value whose heap storage was made inside a `using arena`
    /// block may not be kept in a place that outlives the block, where the
    /// arena has freed it.
    fn check_arena_store(self: *mut Self, value: usize, roots: *List(usize), caller: bool, global: bool, at: usize) {
        let vd = self.value_arena_depth(value)
        if vd == 0 { return }
        if global {
            self.warn_here(at, "a global keeps a value made inside this `using arena` block, whose storage is freed with the arena at the end of the block (rule V5); `@escape` it first")
            return
        }
        if caller {
            self.warn_here(at, "the caller's storage keeps a value made inside this `using arena` block, whose storage is freed with the arena at the end of the block (rule V5); `@escape` it first")
            return
        }
        for r in roots.* {
            if self.ctx().locals[r].arena_depth < vd {
                let name = self.ctx().locals[r].name.clone()
                self.warn_here(at, format("`{}` lives past this `using arena` block, but the value stored in it was made inside the block and its storage is freed with the arena at the end (rule V5); `@escape` it first, or declare `{}` inside the block", .{name, name})[..])
                return
            }
        }
    }

    /// Rule V5 at a `return`: the returned value must not have been made in
    /// a `using arena` block the return leaves.
    fn check_arena_return(self: *mut Self, te: usize, at: usize) {
        if self.value_arena_depth(te) > 0 {
            self.warn_here(at, "this returns a value made inside a `using arena` block, whose storage is freed with the arena when the block ends (rule V5); `@escape` it first")
        }
    }

    /// A hidden local standing for a temporary (see `storage_of`).
    fn is_temp_local(self: *mut Self, l: usize) -> bool {
        return l < ORIGIN_TEMP and self.ctx().locals[l].name == "__temp"
    }

    /// How an origin is named in a diagnostic: the local, or the temporary's line.
    fn origin_name(self: *mut Self, l: usize) -> String {
        if self.is_temp_local(l) { return format("a temporary of line {}", .{self.line_no(self.ctx().locals[l].start)}) }
        return format("`{}`", .{self.ctx().locals[l].name})
    }

    /// The roots a store into place `t` lands in: locals, or the caller's
    /// storage (through a parameter or a pointer into it), or a global.
    fn store_roots(self: *mut Self, t: usize, roots: *mut List(usize), caller: *mut bool, global: *mut bool) {
        let k = self.tir.nodes[t].k
        if k == TKind.Global { global.* = true; return }
        let r = self.place_root(t)
        if r != NONE {
            if self.ctx().locals[r].is_param and !self.ctx().locals[r].owned { caller.* = true } else { roots.append(r) }
            return
        }
        // through a pointer or a slice: where its local points
        var b = t
        while true {
            let bk = self.tir.nodes[b].k
            if bk == TKind.Field or bk == TKind.RefField or bk == TKind.TupleField or bk == TKind.Index or bk == TKind.Deref { b = self.tir.nodes[b].kids[0] } else { break }
        }
        if self.tir.nodes[b].k != TKind.Local { return }
        let l = self.tir.nodes[b].a
        if self.ctx().locals[l].is_param and !self.ctx().locals[l].owned { caller.* = true }
        for o in self.ctx().locals[l].origins.clone() {
            if o.local == ORIGIN_PARAM { caller.* = true }
            else if o.local < ORIGIN_TEMP { roots.append(o.local) }
        }
    }

    /// Rule V2: a view stored into a place must not outlive the storage it
    /// points into. `t` is the place (a local, a field, an element, through a
    /// pointer, a global); the stored value's origins are then the place's.
    fn check_store(self: *mut Self, t: usize, value: usize, at: usize) {
        var roots = List(usize).new()
        var caller = false
        var global = false
        self.store_roots(t, &mut roots, &mut caller, &mut global)
        self.check_arena_store(value, &roots, caller, global, at)
        if !self.holds_view(self.tir.nodes[value].ty) { return }
        let os = self.origins_for_store(value)
        if os.len == 0 { return }
        var tname = String.from("this place")
        if self.tir.nodes[t].k == TKind.Local { tname = format("`{}`", .{self.ctx().locals[self.tir.nodes[t].a].name}) }
        else if roots.len > 0 { tname = format("`{}`", .{self.ctx().locals[roots[0]].name}) }
        for o in os {
            if o.local == ORIGIN_TEMP {
                self.warn_here(at, format("{} keeps a view into a temporary that is released at the end of this statement; bind the temporary with `let` first, or clone the view (rule V2)", .{tname})[..])
                continue
            }
            if o.local == ORIGIN_STATIC or o.local == ORIGIN_SELF { continue }
            if o.local == ORIGIN_PARAM {
                if global { self.warn_here(at, "a global keeps a view into a caller's storage, which is released when the caller returns (rule V2)") }
                continue
            }
            let oname = self.origin_name(o.local)
            let odepth = self.ctx().locals[o.local].depth
            if self.ctx().locals[o.local].is_param and !self.ctx().locals[o.local].owned { if global { self.warn_here(at, format("a global keeps a view into `{}`, a parameter whose storage is released when the caller returns (rule V2)", .{oname})[..]) }; continue }
            if global {
                self.warn_here(at, format("a global keeps a view into {}, which is released when the function returns (rule V2); clone it", .{oname})[..])
                continue
            }
            if caller {
                self.warn_here(at, format("the caller's storage would keep a view into {}, which is released when this function returns (rule V2); clone it", .{oname})[..])
                continue
            }
            for r in roots {
                if self.ctx().locals[r].depth < odepth {
                    let rname = self.ctx().locals[r].name.clone()
                    if self.is_temp_local(o.local) {
                        self.warn_here(at, format("`{}` keeps a view into {}, which is released at the end of that block while `{}` lives on (rule V2); bind the temporary with `let` where `{}` lives, or clone the view", .{rname, oname, rname, rname})[..])
                    } else {
                        self.warn_here(at, format("`{}` keeps a view into {}, which is released at the end of its block on line {}, while `{}` lives on (rule V2); clone it, or declare {} where `{}` lives", .{rname, oname, self.line_no(self.ctx().locals[o.local].start), rname, oname, rname})[..])
                    }
                    break
                }
            }
        }
        // the place now carries what it holds
        for r in roots {
            var kept = self.ctx().locals[r].origins.clone()
            for o in os { if o.local != ORIGIN_TEMP { check.add_origin_f(&mut kept, o.local, at, o.heap, o.field) } }
            self.ctx().locals[r].origins = kept
        }
    }

    /// A `let` binding: the new local carries what its initializer points into.
    fn check_store_local(self: *mut Self, l: usize, init: usize, at: usize) {
        let lt = self.ctx().locals[l].ty
        // where the value's heap storage was made (V5): `@escape` lands one level out
        if self.needs_drop(lt) { self.ctx().locals[l].made_in = self.value_arena_depth(init) }
        if !self.holds_view(lt) { return }
        let os = self.origins_for_store(init)
        var kept = List(Origin).new()
        for o in os {
            if o.local == ORIGIN_TEMP {
                self.warn_here(at, format("`{}` keeps a view into a temporary that is released at the end of this statement; bind the temporary with `let` first, or clone the view (rule V2)", .{self.ctx().locals[l].name})[..])
                continue
            }
            check.add_origin_f(&mut kept, o.local, at, o.heap, o.field)
        }
        self.ctx().locals[l].origins = kept
    }

    /// Rules V3 and V4 at a use of a local that holds a view: its storage
    /// must not have moved away, nor changed since the view was taken (a
    /// change inside a loop the view was taken before counts, for the next
    /// pass). Each origin is reported once per local.
    fn check_view_use(self: *mut Self, l: usize, at: usize) {
        let name = self.ctx().locals[l].name.clone()
        for o in self.ctx().locals[l].origins.clone() {
            if o.local >= ORIGIN_TEMP { continue }
            if check.has_local(&self.ctx().locals[l].warned, o.local) { continue }
            let oname = self.origin_name(o.local)
            if let moved_at = self.ctx().moved.get(o.local) {
                // moved on the line of this use: a literal or a return that holds
                // the value and the view together, which keeps the storage alive
                if moved_at != 0 and self.line_no(moved_at) == self.line_no(at) { continue }
                let when_moved = if moved_at == 0 { String.from("in a branch") } else { format("on line {}", .{self.line_no(moved_at)}) }
                self.warn_here(at, format("`{}` is a view into {}, which was moved away {}; the storage may be released (rule V4); clone the view, or use it before the move", .{name, oname, when_moved})[..])
                self.ctx().locals[l].warned.append(o.local)
                continue
            }
            var hit = NONE
            for ch in self.ctx().locals[o.local].changes.clone() {
                if !check.fields_meet(ch.field, o.field) { continue }
                if ch.pos > o.taken_at and ch.pos < at { hit = ch.pos; break }
                for s in ch.loops { if s > o.taken_at and check.has_local(&self.ctx().loop_starts, s) { hit = ch.pos } }
                if hit != NONE { break }
            }
            if hit != NONE {
                self.warn_here(at, format("`{}` is a view into {}, which changed on line {} after the view was taken; its storage may have moved (rule V3); take the view after the change, or clone it", .{name, oname, self.line_no(hit)})[..])
                self.ctx().locals[l].warned.append(o.local)
            }
        }
    }

    /// A binding that views a value (a loop item, an `if let` over a place, a
    /// pattern binding, a tuple name) points where that value's storage is.
    fn bind_view(self: *mut Self, l: usize, src: usize, at: usize) {
        self.ctx().locals[l].origins = self.storage_of(src, at)
    }

    /// A pattern binding: over a place it views the value (through a pointer,
    /// by reference); over a temporary it owns its part.
    fn bind_pattern_local(self: *mut Self, l: usize) {
        let src = self.ctx().pat_source
        if src == NONE { return }
        let at = self.ctx().locals[l].start
        if self.is_place(src) or self.is_borrowed_view(src) or self.ctx().pat_by_ref != NONE { self.bind_view(l, src, at) } else { self.check_store_local(l, src, at) }
    }

    /// The storage of a local changes here: a growth, a clearing, a reassignment
    /// of the whole value (`field` NONE) or of one field of it.
    fn note_change(self: *mut Self, l: usize, at: usize) { self.note_change_f(l, at, NONE) }

    fn note_change_f(self: *mut Self, l: usize, at: usize, field: usize) {
        if l == NONE { return }
        self.ctx().locals[l].changes.append(Change{ .pos = at, .loops = self.ctx().loop_starts.clone(), .field = field })
        // a view taken before an enclosing loop and read in the loop before this
        // change reads moved storage on the next pass: reported here, at the change
        if self.ctx().loop_starts.len == 0 { return }
        let lname = self.ctx().locals[l].name.clone()
        var w: usize = 0
        while w < self.ctx().locals.len {
            var taken = NONE
            for o in self.ctx().locals[w].origins.clone() {
                if o.local != l or !check.fields_meet(o.field, field) { continue }
                let used = self.ctx().locals[w].last_use
                for s in self.ctx().loop_starts.clone() { if o.taken_at < s and used > s and used < at { taken = o.taken_at } }
            }
            if taken != NONE and !check.has_local(&self.ctx().locals[w].warned, l) {
                let wname = self.ctx().locals[w].name.clone()
                self.warn_here(at, format("`{}` changes here inside a loop, while `{}`, a view into it taken before the loop on line {}, is read in the loop; the next pass reads moved storage (rule V3); take the view inside the loop, or clone it", .{lname, wname, self.line_no(taken)})[..])
                self.ctx().locals[w].warned.append(l)
            }
            w += 1
        }
    }

    /// Region rule R1, conservatively: a returned slice or pointer must not be
    /// a view into a local variable (array, List, String, or a struct holding
    /// one) that is released when the function returns.
    fn check_escaping_view(self: *mut Self, te: usize, at: usize) {
        var t = self.tys.shallow(self.tys.resolve(self.tir.nodes[te].ty, false))
        var k = self.tys.kind(t)
        if k == TK.Opt or k == TK.ErrUnion {
            t = self.tys.shallow(self.tys.list[t].args[0])
            k = self.tys.kind(t)
        }
        if ! (k == TK.Slice or k == TK.Ptr) {
            // a struct, a closure, a list holding a view: where it points (a warning in 1.2)
            if !self.holds_view(t) { return }
            for o in self.origins_of(te) {
                if o.local == ORIGIN_TEMP {
                    self.warn_here(at, "this returns a value holding a view into a temporary that is released before the caller sees it (rule V1)")
                } else if o.local < ORIGIN_TEMP and (!self.ctx().locals[o.local].is_param or self.ctx().locals[o.local].owned) {
                    self.warn_here(at, format("this returns a value holding a view into {}, which is released when the function returns (rule V1); clone the view", .{self.origin_name(o.local)})[..])
                }
            }
            return
        }
        var what: []u8 = ""
        let local = self.view_root(te, &mut what)
        if local == NONE { return }
        if self.ctx().locals[local].is_param {
            // an `own` parameter is the callee's, released at return unless moved on
            if self.ctx().locals[local].owned and !self.ctx().moved.contains(local) {
                self.warn_here(at, format("this returns a {} into `{}`, an `own` parameter that is released when the function returns (rule V1); clone the view", .{what, self.ctx().locals[local].name})[..])
            }
            return
        }
        let lt = self.tys.shallow(self.tys.resolve(self.ctx().locals[local].ty, false))
        let lk = self.tys.kind(lt)
        let owns = lk == TK.Array or lk == TK.List or lk == TK.Str or lk == TK.Map or lk == TK.Struct or lk == TK.Tuple or lk == TK.Enum
            or lk == TK.Int or lk == TK.Float or lk == TK.Bool or lk == TK.Char
        if !owns { return }
        let name = self.ctx().locals[local].name.clone()
        self.fail_here(at, format("this returns a {} into `{}`, a local that is released when the function returns (region rule R1)", .{what, name})[..])
    }

    /// The local a view expression borrows from (NONE when none), and what kind of view it is.
    fn view_root(self: *mut Self, e: usize, what: *mut[]u8) -> usize {
        let k = self.tir.nodes[e].k
        let kids = self.tir.nodes[e].kids.clone()
        if k == TKind.ArrayToSlice or k == TKind.ListToSlice or k == TKind.StrToSlice {
            what.* = "slice"
            return self.place_root(kids[0])
        }
        if k == TKind.SliceOp {
            what.* = "slice"
            let bk = self.tir.nodes[kids[0]].k
            if bk == TKind.ArrayToSlice or bk == TKind.ListToSlice or bk == TKind.StrToSlice { return self.place_root(self.tir.nodes[kids[0]].kids[0]) }
            return self.place_root(kids[0])
        }
        if k == TKind.AddrOf {
            what.* = "pointer"
            return self.place_root(kids[0])
        }
        if k == TKind.OptWrap or k == TKind.ErrWrap { return self.view_root(kids[0], what) }
        if k == TKind.BlockExpr {
            let tail = self.tir.nodes[kids[0]].a
            if tail == NONE { return NONE }
            return self.view_root(tail, what)
        }
        if k == TKind.If {
            let then_tail = self.tir.nodes[kids[1]].a
            if then_tail != NONE {
                let r = self.view_root(then_tail, what)
                if r != NONE { return r }
            }
            if kids.len > 2 {
                let else_tail = self.tir.nodes[kids[2]].a
                if else_tail != NONE { return self.view_root(else_tail, what) }
            }
            return NONE
        }
        return NONE
    }

    /// The root local of a place expression (`x`, `x.f`, `x[i]`, `x.0`), not through pointers.
    fn place_root(self: *mut Self, e: usize) -> usize {
        let k = self.tir.nodes[e].k
        if k == TKind.Local { return self.tir.nodes[e].a }
        if k == TKind.Field or k == TKind.TupleField or k == TKind.Index {
            // indexing a slice reaches memory the slice borrows, not the local itself
            let base = self.tir.nodes[e].kids[0]
            let bt = self.tys.shallow(self.tir.nodes[base].ty)
            let bk = self.tys.kind(bt)
            if bk == TK.Slice or bk == TK.Ptr { return NONE }
            return self.place_root(base)
        }
        return NONE
    }
}
