// Packages: the `nexium.toml` manifest, the `nexium.lock` file, and fetching
// dependencies into `nexium_modules/` (docs/packages.md).
//
// A package is a directory with a manifest and a `src/` folder. `import
// foo` loads `src/lib.nx` of the dependency `foo`; `import foo.bar` loads
// `src/bar.nx`. Dependencies come from a git tag or a local path:
//
//     [package]
//     name = "app"
//     version = "0.1.0"
//
//     [dependencies]
//     greet = { git = "https://github.com/someone/greet", tag = "v1.2.0" }
//     local = { path = "../local" }
//
// The manifest is TOML, read by std.toml.

import std.fs
import std.toml

pub const MANIFEST = "nexium.toml"
pub const LOCK = "nexium.lock"
pub const MODULES_DIR = "nexium_modules"

/// A dependency as the manifest names it.
pub struct Dep {
    name: String
    git: String
    tag: String
    path: String
    // the package's directory inside a git repository (an SDK beside an
    // app), empty for the root
    dir: String
}

/// A manifest: the package's name and version, its dependencies, and the
/// directory holding it.
pub struct Manifest {
    name: String
    version: String
    deps: List(Dep)
    dir: String
}

// a value as the manifest reads it: a string, or a number or a boolean as
// its text, as the reader before std.toml kept them
fn text_of(v: *toml.Toml) -> ?String {
    if let s = toml.as_str(v) { return String.from(s) }
    if let i = toml.as_int(v) { return format("{}", .{i}) }
    if let f = toml.as_float(v) { return format("{}", .{f}) }
    if let b = toml.as_bool(v) { return String.from(if b { "true" } else { "false" }) }
    return null
}

fn is_ident(s: []u8) -> bool {
    if s.len == 0 { return false }
    for c in s { if !((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_') { return false } }
    return true
}

/// Read a manifest file; errors are printed and returned.
pub fn read(path: []u8) -> !Manifest {
    let text = fs.read(path) catch {
        eprintln("error: cannot read {}", .{path})
        return error.NotFound
    }
    let doc = toml.parse(text[..]) catch {
        eprintln("error: {}: {}", .{path, toml.problem(text[..]) orelse String.from("not TOML")})
        return error.InvalidInput
    }
    let pkg = toml.get(&doc, "package") orelse {
        eprintln("error: {}: missing a [package] table", .{path})
        return error.InvalidInput
    }
    var name = String.new()
    var version = String.from("0.0.0")
    if let n = toml.get(pkg, "name") { if let s = text_of(n) { name = s } }
    if let v = toml.get(pkg, "version") { if let s = text_of(v) { version = s } }
    if name.len == 0 {
        eprintln("error: {}: [package] needs a name", .{path})
        return error.InvalidInput
    }
    if !is_ident(name[..]) {
        eprintln("error: {}: package name `{}` must be an identifier (letters, digits, underscores)", .{path, name})
        return error.InvalidInput
    }
    var deps = List(Dep).new()
    if let d = toml.get(&doc, "dependencies") {
        for key in toml.keys(d) {
            let v = toml.get(d, key) orelse continue
            var dep = Dep{ .name = String.from(key), .git = String.new(), .tag = String.new(), .path = String.new(), .dir = String.new() }
            if toml.is_table(v) {
                if let g = toml.get(v, "git") { if let s = text_of(g) { dep.git = s } }
                if let t = toml.get(v, "tag") { if let s = text_of(t) { dep.tag = s } }
                if let p = toml.get(v, "path") { if let s = text_of(p) { dep.path = s } }
                if let x = toml.get(v, "dir") { if let s = text_of(x) { dep.dir = s } }
            } else if let s = text_of(v) {
                dep.tag = s
            } else {
                eprintln("error: {}: dependency `{}` must be a table or a version", .{path, key})
                return error.InvalidInput
            }
            if dep.git.len == 0 and dep.path.len == 0 {
                eprintln("error: {}: dependency `{}` needs `git = \"url\"` (with `tag`) or `path = \"dir\"`", .{path, key})
                return error.InvalidInput
            }
            if dep.dir.len > 0 and dep.git.len == 0 {
                eprintln("error: {}: dependency `{}`: `dir` goes with `git` (a `path` points at the package's directory itself)", .{path, key})
                return error.InvalidInput
            }
            deps.append(dep)
        }
    }
    return Manifest{ .name = name, .version = version, .deps = deps, .dir = String.from(fs.parent(path)) }
}

impl Manifest {
    /// Where a dependency's checkout lives.
    pub fn dep_dir(self: *Self, dep: *Dep) -> String {
        if dep.path.len > 0 { return fs.join(self.dir[..], dep.path[..]) }
        return fs.join(fs.join(self.dir[..], MODULES_DIR)[..], dep.name[..])
    }
}

/// The manifest governing a directory: the nearest `nexium.toml` at or above it.
pub fn find(start: []u8) -> ?Manifest {
    var dir = if fs.is_dir(start) { String.from(start) } else { String.from(fs.parent(start)) }
    if dir.len == 0 { dir = String.from(".") }
    if !fs.is_absolute(dir[..]) {
        let cwd = io.cwd() catch { String.from(".") }
        dir = fs.normalize(fs.join(cwd[..], dir[..])[..])
    }
    while true {
        let m = fs.join(dir[..], MANIFEST)
        if fs.exists(m[..]) {
            return read(m[..]) catch { return null }
        }
        let parent = fs.parent(dir[..])
        if parent.len == 0 or parent == dir[..] { return null }
        dir = String.from(parent)
    }
    return null
}

/// A package reachable from a manifest: its name and its `src` directory.
pub struct Package {
    name: String
    src: String
}

/// Every package reachable from the manifest, the root's direct
/// dependencies first. Transitive dependencies are read from each
/// dependency's own manifest; the first package to claim a name wins.
pub fn packages(root: *Manifest) -> !List(Package) {
    var out = List(Package).new()
    var queue = List(Manifest).new()
    queue.append(Manifest{ .name = root.name.clone(), .version = root.version.clone(), .deps = root.deps.clone(), .dir = root.dir.clone() })
    var qi: usize = 0
    while qi < queue.len {
        let deps = queue[qi].deps.clone()
        let qdir = queue[qi].dir.clone()
        qi += 1
        for d in deps {
            var known = false
            for p in out { if p.name == d.name { known = true } }
            if known { continue }
            let dir = if d.path.len > 0 { fs.join(qdir[..], d.path[..]) } else { fs.join(fs.join(root.dir[..], MODULES_DIR)[..], d.name[..]) }
            if !fs.exists(dir[..]) {
                eprintln("error: dependency `{}` is not fetched; run `nx fetch` in {}", .{d.name, root.dir})
                return error.NotFound
            }
            // the package's own directory: the checkout, or `dir` inside it
            let pkg = if d.dir.len > 0 { fs.join(dir[..], d.dir[..]) } else { dir.clone() }
            if !fs.exists(pkg[..]) {
                eprintln("error: dependency `{}`: {} has no directory `{}`", .{d.name, dir, d.dir})
                return error.NotFound
            }
            out.append(Package{ .name = d.name.clone(), .src = fs.join(pkg[..], "src") })
            let sub = fs.join(pkg[..], MANIFEST)
            if fs.exists(sub[..]) { queue.append(try read(sub[..])) }
        }
    }
    return out
}

fn git(args: [][]u8, cwd: []u8) -> !String {
    var argv = List([]u8).new()
    argv.append("git")
    for a in args { argv.append(a) }
    let code = process.exec(argv[..], "", cwd) catch {
        eprintln("error: cannot run git", .{})
        return error.IoError
    }
    if code != 0 {
        var joined = String.new()
        for a, i in args { if i > 0 { joined.append(" ") }; joined.append(a) }
        let err = process.last_stderr()
        eprintln("error: git {} failed: {}", .{joined, err[..].trim()})
        return error.IoError
    }
    let out = process.last_stdout()
    return String.from(out[..].trim())
}

/// `git` that may fail: true when it exits 0, nothing printed otherwise.
fn git_try(args: [][]u8, cwd: []u8) -> bool {
    var argv = List([]u8).new()
    argv.append("git")
    for a in args { argv.append(a) }
    let code = process.exec(argv[..], "", cwd) catch { return false }
    return code == 0
}

/// A line of the lock file: name, source, tag, commit.
pub struct Locked {
    name: String
    source: String
    tag: String
    commit: String
}

/// The lines of `nexium.lock` next to the manifest, or none when there is
/// no lock file yet.
pub fn read_lock(dir: []u8) -> List(Locked) {
    var out = List(Locked).new()
    let text = fs.read(fs.join(dir, LOCK)[..]) catch { return out }
    for line in text[..].lines() {
        let t = line.trim()
        if t.len == 0 or t.starts_with("#") { continue }
        let parts = t.split("\t")
        if parts.len < 4 { continue }
        out.append(Locked{ .name = String.from(parts[0]), .source = String.from(parts[1]), .tag = String.from(parts[2]), .commit = String.from(parts[3]) })
    }
    return out
}

fn has_name(xs: [][]u8, n: []u8) -> bool {
    for x in xs { if x == n { return true } }
    return false
}

/// Clone every git dependency (transitively) into `nexium_modules/` and
/// write `nexium.lock` with the commit each one resolved to. A dependency
/// the lock names at the manifest's tag and source is checked out at the
/// locked commit, whatever its tag points at today, so another machine
/// builds the same thing. Any other (one the lock does not name, one whose
/// tag or source the manifest changed, and those in `update`, or all of
/// them with `update_all`) has its tag resolved again from a fresh clone.
pub fn fetch(root: *Manifest, update: [][]u8, update_all: bool) -> !List(Locked) {
    let modules = fs.join(root.dir[..], MODULES_DIR)
    let locked = if update_all { List(Locked).new() } else { read_lock(root.dir[..]) }
    var lock = List(Locked).new()
    var done = List(String).new()
    var queue = List(Manifest).new()
    queue.append(Manifest{ .name = root.name.clone(), .version = root.version.clone(), .deps = root.deps.clone(), .dir = root.dir.clone() })
    var qi: usize = 0
    while qi < queue.len {
        let deps = queue[qi].deps.clone()
        let qdir = queue[qi].dir.clone()
        qi += 1
        for d in deps {
            var seen = false
            for x in done { if x == d.name { seen = true } }
            if seen { continue }
            done.append(d.name.clone())
            let dir = if d.path.len > 0 { fs.join(qdir[..], d.path[..]) } else { fs.join(modules[..], d.name[..]) }
            if d.git.len > 0 {
                let renew = update_all or has_name(update, d.name[..])
                // the commit the lock names for this dependency, from this
                // source at this tag: a line for another tag or source (the
                // manifest changed since) says nothing about what it asks for
                var want = String.new()
                if !renew {
                    for l in locked { if l.name == d.name and l.source == d.git and l.tag == d.tag { want = l.commit.clone() } }
                }
                // no locked commit to hold to (`nx update`, a new dependency, a
                // tag or source that changed): the tag is resolved again from a
                // fresh clone, since a checkout already there may be of another
                // tag. A directory that is not a checkout (a removal that
                // stopped halfway) is replaced too, or `git` would answer for
                // the repository above it
                if fs.exists(dir[..]) and (want.len == 0 or !fs.exists(fs.join(dir[..], ".git")[..])) {
                    fs.remove_all(dir[..]) catch {
                        eprintln("error: dependency `{}`: cannot replace {}", .{d.name, dir})
                        return error.IoError
                    }
                }
                if !fs.exists(dir[..]) {
                    fs.make_dirs(modules[..]) catch {
                        eprintln("error: cannot create {}", .{modules})
                        return error.IoError
                    }
                    var args = List([]u8).new()
                    args.append("clone")
                    args.append("--depth")
                    args.append("1")
                    args.append("--quiet")
                    if d.tag.len > 0 { args.append("--branch"); args.append(d.tag[..]) }
                    args.append(d.git[..])
                    args.append(dir[..])
                    _ = try git(args[..], "")
                }
                var rp = List([]u8).new()
                rp.append("rev-parse")
                rp.append("HEAD")
                var commit = try git(rp[..], dir[..])
                if want.len > 0 and want != commit {
                    // the checkout is not at the locked commit (the tag moved, or the
                    // clone is fresh): fetch that commit and check it out
                    var fa = List([]u8).new()
                    fa.append("fetch")
                    fa.append("--depth")
                    fa.append("1")
                    fa.append("--quiet")
                    fa.append("origin")
                    fa.append(want[..])
                    // a source may refuse a fetch by commit (a local path does) while
                    // the clone has the object already, so the checkout decides
                    _ = git_try(fa[..], dir[..])
                    var co = List([]u8).new()
                    co.append("checkout")
                    co.append("--quiet")
                    co.append(want[..])
                    if !git_try(co[..], dir[..]) {
                        eprintln("error: dependency `{}`: {} names commit {}, which {} does not have; `nx update {}` resolves the tag again", .{d.name, LOCK, want, d.git, d.name})
                        return error.NotFound
                    }
                    commit = want.clone()
                }
                if d.dir.len > 0 and !fs.exists(fs.join(dir[..], d.dir[..])[..]) {
                    eprintln("error: dependency `{}`: {} has no directory `{}` at {}", .{d.name, d.git, d.dir, d.tag})
                    return error.NotFound
                }
                lock.append(Locked{ .name = d.name.clone(), .source = d.git.clone(), .tag = d.tag.clone(), .commit = commit })
            } else {
                if !fs.exists(dir[..]) {
                    eprintln("error: dependency `{}`: path {} does not exist", .{d.name, dir})
                    return error.NotFound
                }
                lock.append(Locked{ .name = d.name.clone(), .source = String.from("path"), .tag = d.path.clone(), .commit = String.new() })
            }
            let pkg = if d.dir.len > 0 { fs.join(dir[..], d.dir[..]) } else { dir.clone() }
            let sub = fs.join(pkg[..], MANIFEST)
            if fs.exists(sub[..]) { queue.append(try read(sub[..])) }
        }
    }
    var text = String.from("# nexium.lock: dependency\tsource\ttag\tcommit (written by `nx fetch`)\n")
    for l in lock { text.append(format("{}\t{}\t{}\t{}\n", .{l.name, l.source, l.tag, l.commit})[..]) }
    fs.write(fs.join(root.dir[..], LOCK)[..], text[..]) catch {
        eprintln("error: cannot write {}", .{LOCK})
        return error.IoError
    }
    return lock
}

/// Create a manifest (and a `main.nx` when the directory has no source yet);
/// the files written come back.
pub fn init(dir: []u8, name: []u8) -> !List(String) {
    var written = List(String).new()
    let m = fs.join(dir, MANIFEST)
    if fs.exists(m[..]) {
        eprintln("error: {} already exists", .{m})
        return error.AlreadyExists
    }
    fs.write(m[..], format("[package]\nname = \"{}\"\nversion = \"0.1.0\"\n\n[dependencies]\n", .{name})[..]) catch {
        eprintln("error: cannot write {}", .{m})
        return error.IoError
    }
    written.append(m)
    var has_source = false
    let entries = fs.list(dir) catch { List(String).new() }
    for e in entries { if e[..].ends_with(".nx") { has_source = true } }
    if !has_source {
        let main = fs.join(dir, "main.nx")
        fs.write(main[..], "fn main() {\n    println(\"hello from a Nexium package\", .{})\n}\n") catch {
            eprintln("error: cannot write {}", .{main})
            return error.IoError
        }
        written.append(main)
    }
    return written
}

/// Append a dependency to the manifest text.
pub fn add(manifest_path: []u8, dep: *Dep) -> !void {
    var text = fs.read(manifest_path) catch {
        eprintln("error: cannot read {}", .{manifest_path})
        return error.NotFound
    }
    var line = String.new()
    if dep.git.len > 0 {
        var fields = format("git = \"{}\"", .{dep.git})
        if dep.tag.len > 0 { fields.append(format(", tag = \"{}\"", .{dep.tag})[..]) }
        if dep.dir.len > 0 { fields.append(format(", dir = \"{}\"", .{dep.dir})[..]) }
        line = format("{} = {{ {} }}\n", .{dep.name, fields})
    } else if dep.path.len > 0 {
        var p = String.new()
        for c in dep.path { p.push_byte(if c == '\\' { '/' } else { c }) }
        line = format("{} = {{ path = \"{}\" }}\n", .{dep.name, p})
    } else {
        eprintln("error: a dependency needs --git URL or --path DIR", .{})
        return error.InvalidInput
    }
    var out = String.new()
    if let i = text[..].find("[dependencies]") {
        let after = i + "[dependencies]".len
        var nl = text.len
        if let k = text[after..].find("\n") { nl = after + k + 1 }
        out.append(text[0..nl])
        out.append(line[..])
        out.append(text[nl..])
    } else {
        out.append(text[..])
        if out.len == 0 or out[out.len - 1] != '\n' { out.append("\n") }
        out.append("\n[dependencies]\n")
        out.append(line[..])
    }
    fs.write(manifest_path, out[..]) catch {
        eprintln("error: cannot write {}", .{manifest_path})
        return error.IoError
    }
}

test "a manifest, read through std.toml" {
    let dir = fs.temp_path("nx-manifest-")
    fs.make_dirs(dir[..]) catch {
        expect(false)
        return
    }
    let file = fs.join(dir[..], MANIFEST)
    fs.write(file[..], "# c\n[package]\nname = \"app\" # trailing\nversion = 1.0\n\n[dependencies]\ngreet = { git = \"https://x/y\", tag = \"v1\" }\nloc = { path = \"../loc\" }\n") catch {
        expect(false)
        return
    }
    let m = read(file[..]) catch {
        expect(false)
        return
    }
    expect_eq(m.name[..], "app")
    expect_eq(m.version[..], "1.0")
    expect_eq(m.deps.len, 2)
    expect_eq(m.deps[0].git[..], "https://x/y")
    expect_eq(m.deps[0].tag[..], "v1")
    expect_eq(m.deps[1].path[..], "../loc")
    fs.write(file[..], "[package]\nname = \"app\"\nname = \"twice\"\n") catch { }
    var refused = false
    _ = read(file[..]) catch {
        refused = true
        Manifest{ .name = String.new(), .version = String.new(), .deps = List(Dep).new(), .dir = String.new() }
    }
    expect(refused)
    fs.remove_all(dir[..]) catch { }
}
