//! `nx repl`: an interactive session on the compile-time interpreter.
//!
//! Every line is added to a synthetic program (items at the top level,
//! statements inside a synthetic `main`), the whole program is re-checked so
//! the prompt gets the compiler's real diagnostics, and only the new
//! statements are executed against the values kept from earlier lines. In
//! REPL mode the interpreter may perform I/O, which `comptime` never may.

import lexer
import check
import lsp

const ITEM_KEYWORDS = ["fn", "pub", "struct", "enum", "record", "ref", "trait", "impl", "import", "type", "error", "test", "extern", "artifact", "comptime"]

struct Session {
    items: List(String)
    stmts: List(String)
    // the kept bindings, by name, the same rendered with their types, and
    // the types alone (for `:effects`, which passes them as parameters)
    names: List(String)
    values: List(check.CV)
    shown: List(String)
    types: List(String)
    // what each accepted input was, for `:undo`: 0 an item, 1 a statement
    kinds: List(u8)
    // whether each statement printed a value at the prompt, for `:save`
    printed: List(bool)
    // the bindings before each statement, for `:undo`
    hist_names: List(List(String))
    hist_values: List(List(check.CV))
    hist_shown: List(List(String))
    hist_types: List(List(String))
    // the `ref class` objects the bindings name, shared across lines
    heap: List(check.CV)
}

fn new_session() -> Session {
    return Session{
        .items = List(String).new(), .stmts = List(String).new(),
        .names = List(String).new(), .values = List(check.CV).new(), .shown = List(String).new(), .types = List(String).new(),
        .kinds = List(u8).new(), .printed = List(bool).new(),
        .hist_names = List(List(String)).new(), .hist_values = List(List(check.CV)).new(),
        .hist_shown = List(List(String)).new(), .hist_types = List(List(String)).new(), .heap = List(check.CV).new(),
    }
}

/// The synthetic program: the items, then `main` holding the statements.
/// An empty `extra_item` or `extra_stmt` adds nothing.
fn source(s: *Session, extra_item: []u8, extra_stmt: []u8) -> String {
    var out = String.new()
    for it in s.items { out.append(it[..]); out.append("\n") }
    if extra_item.len > 0 { out.append(extra_item); out.append("\n") }
    out.append("fn main() -> !void {\n")
    for st in s.stmts { out.append(st[..]); out.append("\n") }
    if extra_stmt.len > 0 { out.append(extra_stmt); out.append("\n") }
    out.append("    return\n}\n")
    return out
}

/// The program `:save` writes: the items and the statements, runnable with
/// `nx run`. A value printed at the prompt is an unused value in a program,
/// so those statements are kept as `_ = ...`.
fn saved_program(s: *Session) -> String {
    var out = String.new()
    out.append("// a session saved by nx repl; `nx run` runs it. Values printed at the\n// prompt are discarded here (`_ = ...`): wrap one in println to see it.\n")
    for it in s.items { out.append(it[..]); out.append("\n") }
    out.append("\nfn main() -> !void {\n")
    for st, i in s.stmts {
        if i < s.printed.len and s.printed[i] {
            out.append(format("    _ = {}\n", .{st})[..])
        } else {
            out.append(format("    {}\n", .{st})[..])
        }
    }
    out.append("    return\n}\n")
    return out
}

/// The program `:effects` checks: the expression inside a function of its
/// own, with the kept bindings it names as owned parameters (rebound as
/// `var` so it may mutate them), so the function's effects are the expression's.
fn effects_source(s: *Session, expr: []u8) -> String {
    var lx = lexer.new_lexer(expr)
    lx.lex()
    var params = String.new()
    var binds = String.new()
    for n, i in s.names {
        if i >= s.types.len or s.types[i].len == 0 { continue }
        var used = false
        for t in lx.toks { if t.kind == lexer.Kind.Ident and t.text[..] == n[..] { used = true } }
        if !used { continue }
        if params.len > 0 { params.append(", ") }
        // a heap value is moved into the function (`own`); a scalar is copied
        if is_scalar(s.types[i][..]) {
            params.append(format("{}_p: {}", .{n, s.types[i]})[..])
        } else {
            params.append(format("own {}_p: {}", .{n, s.types[i]})[..])
        }
        binds.append(format("    var {} = {}_p\n", .{n, n})[..])
    }
    let item = format("fn __nx_effects({}) -> !void {{\n{}    {}\n    return\n}}", .{params, binds, expr})
    return source(s, item[..], "")
}

/// A type a parameter takes by copy, which `own` may not qualify.
fn is_scalar(t: []u8) -> bool {
    for k in ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "isize", "usize", "f32", "f64", "bool"] { if t == k { return true } }
    return false
}

/// Is the text a complete input? Unbalanced brackets or an unterminated
/// string mean the user is still typing.
fn complete(text: []u8) -> bool {
    var lx = lexer.new_lexer(text)
    lx.lex()
    for e in lx.errors { if e[..].find("unterminated") != null { return false } }
    var depth: i32 = 0
    for t in lx.toks {
        let k = t.kind
        if k == lexer.Kind.LParen or k == lexer.Kind.LBracket or k == lexer.Kind.LBrace or k == lexer.Kind.DotLBrace { depth += 1 }
        if k == lexer.Kind.RParen or k == lexer.Kind.RBracket or k == lexer.Kind.RBrace { depth -= 1 }
    }
    return depth <= 0
}

/// Does the text declare an item rather than run a statement?
fn is_item(text: []u8) -> bool {
    var lx = lexer.new_lexer(text)
    lx.lex()
    if lx.toks.len == 0 or lx.toks[0].kind != lexer.Kind.Ident { return false }
    let first = lx.toks[0].text[..]
    for k in ITEM_KEYWORDS { if first == k { return true } }
    if first == "const" { for t in lx.toks { if t.kind == lexer.Kind.At { return true } } }
    return false
}

fn help() {
    println("Type Nexium code; each line is checked by the compiler and run.", .{})
    println("  let x = 2 * 21          bind a value (kept for later lines)", .{})
    println("  x + 1                   evaluate and print an expression", .{})
    println("  fn f(n: i32) -> i32 {{ return n * 2 }}", .{})
    println("  import std.json         then json.parse(\"[1, 2]\")", .{})
    println("Lines with open brackets continue on the next prompt.", .{})
    println("Commands:", .{})
    println("  :help          this text            :quit, :q      exit", .{})
    println("  :vars          the kept bindings    :items         the declared items", .{})
    println("  :load FILE     add a file's items    :reset         start over", .{})
    println("  :undo          take back the last line, bindings and all", .{})
    println("  :save FILE     write the session as a program nx run runs", .{})
    println("  :effects EXPR  the effects of an expression, with the bindings in scope", .{})
    println("At a terminal the line colours as you type, Tab completes, the arrows move and", .{})
    println("Up/Down walk the history, Ctrl-C drops the line; NX_PLAIN=1 asks for the plain reader.", .{})
    println("Not available at the prompt: @cImport, for parallel, using arena, artifacts.", .{})
}

/// Check the synthetic program: the checker after a clean check, null after
/// errors, which have been printed.
fn repl_checker(text: []u8, std_dir: []u8, cc: *List(String)) -> ?check.Checker {
    let mods = check.load_with_text("<repl>", text, std_dir) catch { return null }
    var c = check.new_checker(mods)
    c.cc = cc.clone()
    c.repl_mode = true
    c.collect()
    c.reserve_errors()
    c.check_program()
    if c.errors.len > 0 {
        // the diagnostics without the count: one line's worth at a time
        for e in c.errors { if e[..].starts_with("  note:") { eprintln("{}", .{e}) } else { eprintln("error: {}", .{e}) } }
        return null
    }
    return c
}

/// Check the synthetic program and run its new statements. Null after
/// errors, which have been printed.
fn repl_check(text: []u8, start: usize, s: *Session, std_dir: []u8, cc: *List(String)) -> ?check.ReplOutcome {
    var c = repl_checker(text, std_dir, cc) orelse return null
    return c.run_repl(start, &s.names, &s.values, &s.heap)
}

/// The first line of an item, for `:items`.
fn first_line(text: []u8) -> []u8 {
    for l in text.lines() { return l }
    return text
}

/// What accepting one input came to: whether it was accepted, and the value
/// an expression statement printed, if any.
struct Accepted {
    ok: bool
    printed: bool
    value: String
}

/// Accept one complete input, an item or a statement: check it, run it,
/// keep the bindings and the history. With `echo`, an expression's type and
/// value are printed the way the prompt does.
fn accept(s: *mut Session, own input: String, std_dir: []u8, cc: *List(String), echo: bool) -> Accepted {
    var res = Accepted{ .ok = false, .printed = false, .value = String.new() }
    if is_item(input[..]) {
        let src = source(s, input[..], "")
        if repl_check(src[..], s.stmts.len, s, std_dir, cc) != null {
            s.items.append(input)
            s.kinds.append(0)
            res.ok = true
        }
        return res
    }
    let src = source(s, "", input[..])
    let out = repl_check(src[..], s.stmts.len, s, std_dir, cc) orelse return res
    if out.has_panic {
        eprintln("panic: {}", .{out.panic})
        return res
    }
    // the bindings before this statement, for `:undo`
    s.hist_names.append(s.names.clone())
    var before = List(check.CV).new()
    for i in 0..s.values.len { before.append(s.values[i].clone()) }
    s.hist_values.append(before)
    s.hist_shown.append(s.shown.clone())
    s.hist_types.append(s.types.clone())
    s.stmts.append(input)
    s.kinds.append(1)
    s.printed.append(out.has_printed)
    var names = List(String).new()
    var values = List(check.CV).new()
    var shown = List(String).new()
    var types = List(String).new()
    for n, i in out.names {
        if !check.cv_keepable(&out.values[i]) { continue }
        names.append(n.clone())
        values.append(out.values[i].clone())
        shown.append(out.shown[i].clone())
        types.append(if i < out.types.len { out.types[i].clone() } else { String.new() })
    }
    s.names = names
    s.values = values
    s.heap = out.heap.clone()
    s.shown = shown
    s.types = types
    if out.has_printed and echo { println("{}: {}", .{out.printed_ty, out.printed_val}) }
    res.ok = true
    res.printed = out.has_printed
    res.value = out.printed_val.clone()
    return res
}

/// `nx -e CODE` and `nx -p EXPR`: the lines of `code` go through a session
/// as at the prompt, without the prompt; with `print_last`, the value of the
/// last expression is printed on its own, the way a shell expects. The
/// interpreter runs them, so nothing is compiled. The exit code.
pub fn eval(code: []u8, print_last: bool, std_dir: []u8, cc: *List(String)) -> i32 {
    var session = new_session()
    var pending = String.new()
    var last = Accepted{ .ok = true, .printed = false, .value = String.new() }
    for line in code.lines() {
        if pending.len > 0 { pending.append("\n") }
        pending.append(line)
        if pending[..].trim().len == 0 { pending = String.new(); continue }
        if !complete(pending[..]) { continue }
        let input = pending.clone()
        pending = String.new()
        last = accept(&mut session, input, std_dir, cc, false)
        if !last.ok { return 1 }
    }
    if pending.len > 0 {
        eprintln("error: the input ends inside brackets or a string", .{})
        return 1
    }
    if print_last {
        if !last.printed {
            eprintln("error: the last line is not an expression with a value; nx -e runs code without printing", .{})
            return 1
        }
        println("{}", .{last.value})
    }
    return 0
}

/// `nx play [FILE]`: a whole program, from FILE or else from stdin, checked
/// the way `nx check` checks it and run from `main` by the interpreter, so
/// nothing is compiled. It is the playground's command (the site runs the
/// compiler as WebAssembly, where there is no C compiler) and works the same
/// in a terminal. The interpreter runs the language and the standard
/// library's pure parts; foreign calls, threads, sockets, processes, mutable
/// globals and `@refCount` need a compiled program, and say so. The exit code: `main`'s own, 1 after
/// diagnostics or an error returned from `main`, 2 after a panic or a
/// statement the interpreter cannot run.
pub fn play(file: []u8, std_dir: []u8, cc: *List(String), strict: bool) -> i32 {
    var text = String.new()
    var name: []u8 = "main.nx"
    if file.len > 0 {
        text = io.read_file(file) catch {
            eprintln("error: cannot read {}", .{file})
            return 1
        }
        name = file
    } else {
        while true {
            let line = io.read_line() orelse break
            text.append(line[..])
            text.append("\n")
        }
    }
    // an empty text would send the loader to a file of that name
    if text[..].trim().len == 0 {
        eprintln("error: the program is empty; write a `fn main()` to run", .{})
        return 1
    }
    let mods = check.load_with_text(name, text[..], std_dir) catch { return 1 }
    var c = check.new_checker(mods)
    c.cc = cc.clone()
    c.play_mode = true
    // the page runs on the browser's stack, which holds fewer nested calls
    if let d = os.env("NX_PLAY_DEPTH") {
        let n = d.parse_int(usize) catch { 0 }
        if n > 0 { c.it_depth_limit = n }
    }
    c.collect()
    c.reserve_errors()
    c.check_program()
    if c.warnings.len > 0 { check.print_warnings(&c.warnings, strict) }
    if c.errors.len > 0 {
        check.print_errors(&c.errors)
        return 1
    }
    if strict and c.warnings.len > 0 { return 1 }
    if !c.has_main() {
        eprintln("error: the program has no `main` to run", .{})
        return 1
    }
    let r = c.run_main()
    if r.kind == check.PLAY_ERROR {
        eprintln("error: {}", .{r.message})
        return 1
    }
    if r.kind == check.PLAY_PANIC {
        eprintln("panic: {}", .{r.message})
        if r.at.len > 0 { eprintln("  at {}", .{r.at}) }
        return 2
    }
    if r.kind == check.PLAY_UNSUPPORTED {
        var at = String.new()
        if r.own_at.len > 0 { at = format(" (at {}, inside {})", .{r.own_at, r.at}) } else if r.at.len > 0 { at = format(" (at {})", .{r.at}) }
        eprintln("error: the interpreter cannot run this program{}: foreign calls, threads, sockets, processes, mutable globals and @refCount need a compiled program (nx run)", .{at})
        return 2
    }
    return r.code
}

// ----- the line editor at the prompt ------------------------------------------------

const K_UP: i64 = -1
const K_DOWN: i64 = -2
const K_RIGHT: i64 = -3
const K_LEFT: i64 = -4
const K_HOME: i64 = -5
const K_END: i64 = -6
const K_DEL: i64 = -7
const K_ESC: i64 = -8

/// The colour a token gets at the prompt, or "" for none.
fn colour_of(k: lexer.Kind, text: []u8) -> []u8 {
    if k == lexer.Kind.Ident {
        if lexer.is_keyword(text) { return "\x1b[1;34m" }
        if text.len > 0 and text[0] >= 'A' and text[0] <= 'Z' { return "\x1b[33m" }
        return ""
    }
    if k == lexer.Kind.Str or k == lexer.Kind.Bytes or k == lexer.Kind.Char { return "\x1b[32m" }
    if k == lexer.Kind.Int or k == lexer.Kind.Float { return "\x1b[36m" }
    if k == lexer.Kind.Comment or k == lexer.Kind.Doc { return "\x1b[90m" }
    if k == lexer.Kind.At or k == lexer.Kind.Hash { return "\x1b[35m" }
    return ""
}

/// The line with its tokens coloured, as the prompt draws it; the plain
/// line when NO_COLOR is set.
pub fn colourize(line: []u8) -> String {
    if os.env("NO_COLOR") != null { return String.from(line) }
    var lx = lexer.new_lexer(line)
    lx.lex()
    var out = String.new()
    var pos: usize = 0
    for t in lx.toks {
        if t.kind == lexer.Kind.Eof or t.kind == lexer.Kind.Newline { continue }
        if t.start < pos or t.end > line.len or t.start > t.end { continue }
        out.append(line[pos..t.start])
        let c = colour_of(t.kind, line[t.start..t.end])
        if c.len > 0 {
            out.append(c)
            out.append(line[t.start..t.end])
            out.append("\x1b[0m")
        } else {
            out.append(line[t.start..t.end])
        }
        pos = t.end
    }
    if pos < line.len { out.append(line[pos..]) }
    return out
}

/// One key: a byte, or a named key from an escape sequence (arrows, Home,
/// End and Delete arrive as `ESC [ ... final` whole, so the bytes pending
/// after an escape say whether one starts).
fn next_key() -> ?i64 {
    let b = io.read_key() orelse return null
    if b != 27 { return b }
    if io.pending_input() == 0 { return K_ESC }
    let c = io.read_key() orelse return K_ESC
    if c != ('[' as i64) and c != ('O' as i64) { return K_ESC }
    var seq = String.new()
    while true {
        let d = io.read_key() orelse break
        seq.push_byte(d as u8)
        if d >= 0x40 and d <= 0x7E { break }
        if io.pending_input() == 0 { break }
    }
    let s = seq[..]
    if s == "A" { return K_UP }
    if s == "B" { return K_DOWN }
    if s == "C" { return K_RIGHT }
    if s == "D" { return K_LEFT }
    if s == "H" or s == "1~" or s == "7~" { return K_HOME }
    if s == "F" or s == "4~" or s == "8~" { return K_END }
    if s == "3~" { return K_DEL }
    return K_ESC
}

/// Columns a byte string takes: one per character (a continuation byte of
/// UTF-8 adds none); a wide character counts as one, which is close.
fn columns(s: []u8) -> usize {
    var n: usize = 0
    for b in s { if (b & 0xC0) != 0x80 { n += 1 } }
    return n
}

fn prev_char(s: []u8, i: usize) -> usize {
    if i == 0 { return 0 }
    var j = i - 1
    while j > 0 and (s[j] & 0xC0) == 0x80 { j -= 1 }
    return j
}

fn next_char(s: []u8, i: usize) -> usize {
    if i >= s.len { return s.len }
    var j = i + 1
    while j < s.len and (s[j] & 0xC0) == 0x80 { j += 1 }
    return j
}

/// Draw the prompt and the line, coloured, and put the cursor at `cur`.
fn redraw(prompt: []u8, buf: []u8, cur: usize) {
    print("\r{}{}\x1b[K", .{prompt, colourize(buf)})
    let col = columns(prompt) + columns(buf[0..cur])
    print("\r", .{})
    if col > 0 { print("\x1b[{}C", .{col}) }
    io.flush(2) catch { }
}

fn ident_byte(c: u8) -> bool {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'
}

struct Completed {
    line: String
    cur: usize
}

/// Tab: the identifier before the cursor completed from what the language
/// server's completion finds at that point of the synthetic program. One
/// candidate, or a prefix they all share, goes into the line; otherwise the
/// candidates are listed under the prompt.
fn complete_at(s: *Session, buf: []u8, cur: usize) -> ?Completed {
    var text = String.new()
    for it in s.items {
        text.append(it[..])
        text.append("\n")
    }
    text.append("fn main() -> !void {\n")
    for st in s.stmts {
        text.append(st[..])
        text.append("\n")
    }
    let off = text.len + cur
    text.append(buf)
    text.append("\n    return\n}\n")
    let mods = lsp.editor_modules("repl_session.nx", text[..])
    let cands = lsp.completions(&mods, text[..], off)
    var ws = cur
    while ws > 0 and ident_byte(buf[ws - 1]) { ws -= 1 }
    let prefix = buf[ws..cur]
    var labels = List(String).new()
    for c in cands { if c.label[..].starts_with(prefix) { labels.append(c.label.clone()) } }
    if labels.len == 0 {
        print("\x07", .{})
        return null
    }
    var common = labels[0].clone()
    for l in labels {
        var n: usize = 0
        while n < common.len and n < l.len and common[n] == l[n] { n += 1 }
        common = String.from(common[0..n])
    }
    if common.len > prefix.len {
        var nb = String.from(buf[0..cur])
        nb.append(common[prefix.len..])
        nb.append(buf[cur..])
        return Completed{ .line = nb, .cur = cur + (common.len - prefix.len) }
    }
    if labels.len > 1 {
        print("\r\n", .{})
        for l, i in labels {
            if i > 0 { print("  ", .{}) }
            print("{}", .{l})
        }
        print("\r\n", .{})
    }
    return null
}

fn hist_line(h: *List(String), i: usize) -> String {
    for s, k in h { if k == i { return s.clone() } }
    return String.new()
}

/// A line at the prompt with the editor: the line redrawn in colour after
/// every key, Tab completing, arrows and Home/End moving, Up/Down through
/// the history, Ctrl-A/E to the ends, Ctrl-U/K cutting, Ctrl-L clearing
/// the screen, Ctrl-C dropping the line (the result is "\x03"), Ctrl-D at
/// an empty line leaving. Null at the end of input.
fn edit_line(prompt: []u8, history: *List(String), s: *Session) -> ?String {
    var buf = String.new()
    var cur: usize = 0
    var hist_pos = history.len
    var stash = String.new()
    redraw(prompt, buf[..], cur)
    while true {
        let k = next_key() orelse {
            print("\r\n", .{})
            return null
        }
        if k == 13 or k == 10 {
            print("\r\n", .{})
            return buf
        }
        if k == 3 {
            print("^C\r\n", .{})
            return String.from("\x03")
        }
        if k == 4 {
            if buf.len == 0 {
                print("\r\n", .{})
                return null
            }
        } else if k == 127 or k == 8 {
            if cur > 0 {
                let p = prev_char(buf[..], cur)
                var nb = String.from(buf[0..p])
                nb.append(buf[cur..])
                buf = nb
                cur = p
            }
        } else if k == K_DEL {
            if cur < buf.len {
                let n = next_char(buf[..], cur)
                var nb = String.from(buf[0..cur])
                nb.append(buf[n..])
                buf = nb
            }
        } else if k == K_LEFT {
            cur = prev_char(buf[..], cur)
        } else if k == K_RIGHT {
            cur = next_char(buf[..], cur)
        } else if k == K_HOME or k == 1 {
            cur = 0
        } else if k == K_END or k == 5 {
            cur = buf.len
        } else if k == 21 {
            buf = String.new()
            cur = 0
        } else if k == 11 {
            buf = String.from(buf[0..cur])
        } else if k == 12 {
            print("\x1b[2J\x1b[H", .{})
        } else if k == K_UP {
            if hist_pos > 0 {
                if hist_pos == history.len { stash = buf.clone() }
                hist_pos -= 1
                buf = hist_line(history, hist_pos)
                cur = buf.len
            }
        } else if k == K_DOWN {
            if hist_pos < history.len {
                hist_pos += 1
                buf = if hist_pos == history.len { stash.clone() } else { hist_line(history, hist_pos) }
                cur = buf.len
            }
        } else if k == 9 {
            if let c = complete_at(s, buf[..], cur) {
                buf = c.line.clone()
                cur = c.cur
            }
        } else if k >= 32 and k != 127 {
            var nb = String.from(buf[0..cur])
            nb.push_byte(k as u8)
            nb.append(buf[cur..])
            buf = nb
            cur += 1
        }
        redraw(prompt, buf[..], cur)
    }
    return null
}

/// Run the session until the input ends or the user quits; the exit code.
pub fn run(version: []u8, compiler: []u8, host: []u8, std_dir: []u8, cc: *List(String), newer: []u8) -> i32 {
    let interactive = io.is_terminal(1)
    if interactive and (host != "windows" or os.env("WT_SESSION") != null) { print("\x1b]0;Nexium {}\x07", .{version}) }
    println("Nexium {} (nx repl, {}) on {}", .{version, compiler, host})
    if newer.len > 0 { println("nx {} is available: `nx upgrade` installs it.", .{newer}) }
    println("Type :help for commands, :quit to exit.", .{})
    var session = new_session()
    var pending = String.new()
    var history = List(String).new()
    // the line editor: raw input at a terminal, unless NX_PLAIN asks for the
    // plain reader; raw mode is on only while a line is being typed
    let editor = interactive and os.env("NX_PLAIN") == null and io.raw_mode(true)
    if editor { _ = io.raw_mode(false) }
    while true {
        let prompt = if pending.len == 0 { "> " } else { "... " }
        var raw = String.new()
        if editor {
            if !io.raw_mode(true) { return 0 }
            let got = edit_line(prompt, &history, &session) orelse {
                _ = io.raw_mode(false)
                return 0
            }
            _ = io.raw_mode(false)
            raw = got
            if raw[..] == "\x03" {
                pending = String.new()
                continue
            }
            if raw[..].trim().len > 0 { history.append(raw.clone()) }
        } else {
            if interactive { print("{}", .{prompt}) }
            raw = io.read_line() orelse {
                if interactive { println("", .{}) }
                return 0
            }
        }
        var line = raw[..]
        while line.len > 0 and (line[line.len - 1] == '\n' or line[line.len - 1] == '\r') { line = line[0..line.len - 1] }
        if pending.len == 0 {
            let t = line.trim()
            if t.len == 0 { continue }
            if t.starts_with(":") {
                let cmd = t[1..]
                var word = cmd
                var rest = ""
                if let sp = cmd.find(" ") {
                    word = cmd[0..sp]
                    rest = cmd[sp + 1..]
                }
                if word == "q" or word == "quit" or word == "exit" {
                    return 0
                } else if word == "help" or word == "h" or word == "?" {
                    help()
                } else if word == "reset" {
                    session = new_session()
                    println("reset", .{})
                } else if word == "vars" {
                    if session.shown.len == 0 { println("(no bindings)", .{}) }
                    for v, i in session.shown { println("{}: {}", .{session.names[i], v}) }
                } else if word == "items" {
                    if session.items.len == 0 { println("(no items)", .{}) }
                    for it in session.items { println("{}", .{first_line(it[..])}) }
                } else if word == "load" {
                    let path = rest.trim()
                    let text = io.read_file(path) catch {
                        eprintln("cannot read: {}", .{path})
                        continue
                    }
                    let src = source(&session, text[..], "")
                    if repl_check(src[..], session.stmts.len, &session, std_dir, cc) != null {
                        session.items.append(text)
                        session.kinds.append(0)
                        println("loaded", .{})
                    }
                } else if word == "undo" {
                    let kind = session.kinds.pop() orelse {
                        println("nothing to undo", .{})
                        continue
                    }
                    if kind == 0 {
                        let it = session.items.pop() orelse String.new()
                        println("undone: {}", .{first_line(it[..])})
                    } else {
                        let st = session.stmts.pop() orelse String.new()
                        _ = session.printed.pop()
                        session.names = session.hist_names.pop() orelse List(String).new()
                        session.values = session.hist_values.pop() orelse List(check.CV).new()
                        session.shown = session.hist_shown.pop() orelse List(String).new()
                        session.types = session.hist_types.pop() orelse List(String).new()
                        println("undone: {}", .{first_line(st[..])})
                    }
                } else if word == "save" {
                    let path = rest.trim()
                    if path.len == 0 {
                        println("usage: :save FILE", .{})
                        continue
                    }
                    let text = saved_program(&session)
                    io.write_file(path, text[..]) catch {
                        eprintln("cannot write: {}", .{path})
                        continue
                    }
                    println("saved {} item(s) and {} statement(s) to {}; nx run {} runs it", .{session.items.len, session.stmts.len, path, path})
                } else if word == "colour" or word == "color" {
                    // the line as the prompt colours it (a testing aid)
                    println("{}", .{colourize(rest)})
                } else if word == "effects" {
                    let expr = rest.trim()
                    if expr.len == 0 {
                        println("usage: :effects EXPRESSION", .{})
                        continue
                    }
                    let src = effects_source(&session, expr)
                    var c = repl_checker(src[..], std_dir, cc) orelse continue
                    var found = false
                    for i in 0..c.insts.len {
                        if c.insts[i].name[..] != "__nx_effects" { continue }
                        found = true
                        let e = check.render_effects(c.insts[i].effects)
                        println("effects: {}", .{if e.len == 0 { "none" } else { e[..] }})
                    }
                    if !found { println("effects: (not determined)", .{}) }
                } else {
                    println("unknown command :{}; try :help", .{word})
                }
                continue
            }
            if t == "exit" or t == "quit" { return 0 }
        }
        if pending.len > 0 { pending.append("\n") }
        pending.append(line)
        if !complete(pending[..]) { continue }
        let input = pending.clone()
        pending = String.new()
        _ = accept(&mut session, input, std_dir, cc, true)
    }
    return 0
}
