// The `nx` command in Nexium: the driver over the self-hosted lexer,
// parser, checker and C emitter. It loads a program, checks it, emits C
// and hands that to the C compiler, the way the Rust driver does.
//
//     nx build file.nx [-o out] [--out-dir dir] [--mode debug|safe|fast|small]
//     nx run file.nx [-- args]
//     nx test file.nx [-- --verbose] [filter]
//     nx check file.nx
//     nx emit-c file.nx
//     nx tir file.nx [--sigs]
//
// Options everywhere: --std <dir> (std sources beside the embedded copies),
// --cc <command>, --target <triple>, --keep-c, -D<name>, -I<dir>.

import parser
import check
import cgen
import fmt
import tools
import size
import doc
import manifest
import ship
import ship_node
import installer
import lsp
import repl
import std.fs

const VERSION = "1.0.1"
const RELEASE_NAME = "Annapurna: Rébuffat"

const NONE: usize = 0xFFFFFFFFFFFFFFFF

pub struct Opts {
    command: String
    file: String
    out: String
    out_dir: String
    mode: u8
    std_dir: String
    cc: List(String)
    target: String
    keep_c: bool
    defines: List(String)
    include_dirs: List(String)
    rest: List(String)
    sigs: bool
    /// how the C compiler was chosen: 1 --cc, 2 NX_CC, 3 NX_ZIG, 4 the system compiler on macOS, 0 zig on PATH
    cc_source: u8
}

fn usage() {
    eprintln("usage: nx <build|run|test|check|effects|audit|refcounts|leaks|size|emit-c|tir> <file.nx> [options] [-- args]", .{})
    eprintln("       nx fmt <file.nx>... [--check] | nx fix <file.nx>...", .{})
    eprintln("       nx doc <file.nx> [-o <dir>]", .{})
    eprintln("       nx ship <file.nx> [--mode m] [--target t]   produce the declared artifacts", .{})
    eprintln("       nx version | nx doctor | nx lsp | nx repl", .{})
    eprintln("       nx init [name] | nx add <name> --git URL [--tag TAG] | --path DIR | nx fetch", .{})
    eprintln("  -o <path>          output file", .{})
    eprintln("  --out-dir <dir>    where C and binaries go (default nx-out)", .{})
    eprintln("  --mode <m>         debug (default), safe, fast, small", .{})
    eprintln("  --std <dir>        standard library sources (embedded copies otherwise)", .{})
    eprintln("  --cc <command>     C compiler (default zig cc; NX_CC and NX_ZIG override)", .{})
    eprintln("  --target <triple>  cross-compile", .{})
    eprintln("  --keep-c           keep the generated C", .{})
}

fn parse_opts(args: [][]u8) -> ?Opts {
    if args.len < 3 {
        if args.len == 2 and (args[1] == "version" or args[1] == "--version" or args[1] == "-V" or args[1] == "doctor" or args[1] == "lsp" or args[1] == "repl") {
            var padded = List([]u8).new()
            for a in args { padded.append(a) }
            padded.append("")
            return parse_opts(padded[..])
        }
        return null
    }
    var o = Opts{
        .command = String.from(args[1]), .file = String.from(args[2]), .out = String.new(), .out_dir = String.from("nx-out"), .mode = cgen.MODE_DEBUG,
        .std_dir = String.from("std"), .cc = List(String).new(), .target = String.new(), .keep_c = false,
        .defines = List(String).new(), .include_dirs = List(String).new(), .rest = List(String).new(), .sigs = false, .cc_source = 0,
    }
    var cc_text = String.new()
    var i: usize = 3
    while i < args.len {
        let a = args[i]
        if a == "--" {
            i += 1
            while i < args.len { o.rest.append(String.from(args[i])); i += 1 }
            break
        }
        if a == "-o" and i + 1 < args.len { o.out = String.from(args[i + 1]); i += 2; continue }
        if a == "--out-dir" and i + 1 < args.len { o.out_dir = String.from(args[i + 1]); i += 2; continue }
        if a == "--std" and i + 1 < args.len { o.std_dir = String.from(args[i + 1]); i += 2; continue }
        if a == "--cc" and i + 1 < args.len { cc_text = String.from(args[i + 1]); i += 2; continue }
        if a == "--target" and i + 1 < args.len { o.target = String.from(args[i + 1]); i += 2; continue }
        if a == "--mode" and i + 1 < args.len {
            let m = args[i + 1]
            if m == "debug" { o.mode = cgen.MODE_DEBUG } else if m == "safe" { o.mode = cgen.MODE_SAFE }
            else if m == "fast" { o.mode = cgen.MODE_FAST } else if m == "small" { o.mode = cgen.MODE_SMALL }
            else { eprintln("error: unknown mode `{}`", .{m}); return null }
            i += 2
            continue
        }
        if a == "--keep-c" { o.keep_c = true; i += 1; continue }
        if a == "--sigs" { o.sigs = true; i += 1; continue }
        if a.len > 2 and a[0..2] == "-D" { o.defines.append(String.from(a[2..])); i += 1; continue }
        if a.len > 2 and a[0..2] == "-I" { o.include_dirs.append(String.from(a[2..])); i += 1; continue }
        // anything else after the file is an argument to the program
        o.rest.append(String.from(a))
        i += 1
    }
    if cc_text.len > 0 { o.cc_source = 1 }
    if cc_text.len == 0 { if let v = os.env("NX_CC") { cc_text = String.from(v); o.cc_source = 2 } }
    if cc_text.len > 0 {
        for w in cc_text[..].split(" ") { if w.len > 0 { o.cc.append(String.from(w)) } }
    } else if let z = os.env("NX_ZIG") {
        o.cc.append(String.from(z))
        o.cc.append(String.from("cc"))
        o.cc_source = 3
    } else if let z = bundled_zig() {
        o.cc.append(z)
        o.cc.append(String.from("cc"))
        o.cc_source = 5
    } else if is_macos_target(o.target[..]) and o.target.len == 0 {
        // zig 0.14 cannot link against the current Xcode SDK; the system
        // compiler can (the Rust driver makes the same choice)
        o.cc.append(String.from("cc"))
        o.cc_source = 4
    } else {
        o.cc.append(String.from("zig"))
        o.cc.append(String.from("cc"))
    }
    return o
}

/// A Zig installed next to `nx`: `<dir>/zig/zig` (the Windows installer) or
/// `<dir>/../zig/zig` (`~/.nexium/bin/nx` with `~/.nexium/zig`).
fn bundled_zig() -> ?String {
    let exe = os.exe_path()
    if exe.len == 0 { return null }
    let dir = dir_of(exe[..])
    let name = if is_windows_target("") { "zig.exe" } else { "zig" }
    let here = format("{}/zig/{}", .{dir, name})
    if io.file_kind(here[..]) == 1 { return here }
    let above = format("{}/../zig/{}", .{dir, name})
    if io.file_kind(above[..]) == 1 { return above }
    return null
}

fn is_windows_target(target: []u8) -> bool {
    if target.len == 0 { return os.env("COMSPEC") != null and os.env("WINDIR") != null }
    return target.find("windows") != null
}

fn is_macos_target(target: []u8) -> bool {
    if target.len == 0 { return os.env("HOME") != null and io.file_kind("/System/Library/CoreServices") == 2 }
    return target.find("macos") != null or target.find("darwin") != null
}

fn dir_of(path: []u8) -> []u8 {
    var i = path.len
    while i > 0 {
        if path[i - 1] == '/' or path[i - 1] == '\\' { return path[0..i - 1] }
        i -= 1
    }
    return "."
}

fn stem_of(path: []u8) -> []u8 {
    var start: usize = 0
    var i = path.len
    while i > 0 {
        if path[i - 1] == '/' or path[i - 1] == '\\' { start = i; break }
        i -= 1
    }
    var end = path.len
    var j = path.len
    while j > start {
        if path[j - 1] == '.' { end = j - 1; break }
        j -= 1
    }
    return path[start..end]
}

/// Load and check; the checker is returned for the emitter. Null after
/// errors, which have been printed.
fn check_program(o: *Opts) -> ?check.Checker {
    let mods = check.load(o.file[..], o.std_dir[..]) catch { return null }
    var c = check.new_checker(mods)
    c.cc = o.cc.clone()
    c.target = o.target.clone()
    c.collect()
    c.reserve_errors()
    c.check_program()
    if c.errors.len > 0 {
        check.print_errors(&c.errors)
        return null
    }
    return c
}

/// The C of the program with the given entry: "" after errors.
fn emit(c: *mut check.Checker, o: *Opts, entry: u8) -> String {
    var infos = List(cgen.ExportInfo).new()
    return emit_with(c, o, entry, stem_of(o.file[..]), o.mode, &mut infos)
}

/// The C of the program with the given entry, library name and mode; the
/// exported functions' boundary records come back through `infos`.
fn emit_with(c: *mut check.Checker, o: *Opts, entry: u8, lib_name: []u8, mode: u8, infos: *mut List(cgen.ExportInfo)) -> String {
    var g = cgen.new_gen(c, mode, entry)
    g.lib_name = String.from(lib_name)
    let out = g.generate()
    if g.errors.len > 0 {
        for e in g.errors { eprintln("error: {}", .{e}) }
        return String.new()
    }
    infos.*= g.exports.clone()
    return out
}

/// Write the C next to a current copy of the runtime header.
fn write_c(o: *Opts, stem: []u8, text: []u8) -> ?String {
    fs.make_dirs(o.out_dir[..]) catch { }
    let path = format("{}/{}.c", .{o.out_dir, stem})
    io.write_file(path[..], text) catch {
        eprintln("error: cannot write {}", .{path})
        return null
    }
    let rt = format("{}/nx_rt.h", .{o.out_dir})
    var current = false
    let existing = io.read_file(rt[..]) catch { String.new() }
    current = existing[..] == cgen.RUNTIME_H
    if !current { io.write_file(rt[..], cgen.RUNTIME_H) catch { } }
    return path
}

/// `artifact link { c_sources, libs, include, lib_paths }` declared in the sources.
fn link_info(c: *check.Checker, o: *Opts, c_sources: *mut List(String), libs: *mut List(String), include: *mut List(String), lib_paths: *mut List(String)) {
    let windows = is_windows_target(o.target[..])
    let macos = is_macos_target(o.target[..])
    let n_mods = c.mods.len
    for m in 0..n_mods {
        let root_dir = c.mods[m].dir.clone()
        for it in c.mods[m].parsed.items.clone() {
            let n = c.node(m, it)
            if n.k != parser.NodeKind.Artifact or n.name != "link" { continue }
            for f in n.kids.clone() {
                let fnode = c.node(m, f)
                let key = fnode.name.clone()
                let v = c.node(m, fnode.x)
                var vals = List(String).new()
                if v.k == parser.NodeKind.ArrayLit {
                    for e in v.kids.clone() {
                        let en = c.node(m, e)
                        if en.k == parser.NodeKind.Lit and en.text == "str" { vals.append(en.name.clone()) }
                    }
                } else if v.k == parser.NodeKind.Lit and v.text == "str" {
                    vals.append(v.name.clone())
                }
                for x in vals {
                    let rel = format("{}/{}", .{root_dir, x})
                    if key == "c_sources" { c_sources.append(rel) }
                    else if key == "libs" { libs.append(x.clone()) }
                    else if key == "libs_windows" and windows { libs.append(x.clone()) }
                    else if key == "libs_linux" and !windows and !macos { libs.append(x.clone()) }
                    else if key == "libs_macos" and macos { libs.append(x.clone()) }
                    else if key == "include" { include.append(rel) }
                    else if key == "lib_paths" { lib_paths.append(rel) }
                }
            }
        }
    }
}

/// Run the C compiler on the generated file. Zig's shared cache refuses a
/// concurrent run now and then: that is retried.
fn compile_c(c: *check.Checker, o: *Opts, c_path: []u8, out: []u8, kind: []u8) -> bool {
    var argv = List(String).new()
    for x in o.cc { argv.append(x.clone()) }
    argv.append(String.from("-std=gnu11"))
    if o.mode == cgen.MODE_DEBUG { argv.append(String.from("-O0")); if kind != "sections" { argv.append(String.from("-g")) } }
    else if o.mode == cgen.MODE_SMALL { argv.append(String.from("-Os")) }
    else { argv.append(String.from("-O2")) }
    // one section per function and datum, for `nx size`
    if kind == "sections" { argv.append(String.from("-ffunction-sections")); argv.append(String.from("-fdata-sections")) }
    argv.append(String.from("-w"))
    argv.append(String.from("-fno-strict-aliasing"))
    for d in o.defines { argv.append(format("-D{}", .{d})) }
    var c_sources = List(String).new()
    var libs = List(String).new()
    var include = List(String).new()
    var lib_paths = List(String).new()
    link_info(c, o, &mut c_sources, &mut libs, &mut include, &mut lib_paths)
    for d in o.include_dirs { argv.append(format("-I{}", .{d})) }
    for d in include { argv.append(format("-I{}", .{d})) }
    argv.append(format("-I{}", .{dir_of(o.file[..])}))
    // an object of the generated file alone: no vendored C, no libraries
    let linking = kind != "object" and kind != "sections"
    if linking {
        for s in c_sources { argv.append(s.clone()) }
        for d in lib_paths { argv.append(format("-L{}", .{d})) }
        for l in libs { argv.append(format("-l{}", .{l})) }
    }
    if o.target.len > 0 {
        argv.append(String.from("-target"))
        argv.append(o.target.clone())
    }
    if kind == "object" or kind == "sections" { argv.append(String.from("-c")) }
    if kind == "shared" {
        argv.append(String.from("-shared"))
        argv.append(String.from("-DNX_BUILD_SHARED"))
        if !is_windows_target(o.target[..]) { argv.append(String.from("-fPIC")) }
    }
    argv.append(String.from(c_path))
    argv.append(String.from("-o"))
    argv.append(String.from(out))
    let windows = is_windows_target(o.target[..])
    if windows and linking { argv.append(String.from("-lws2_32")) }
    if !windows and linking {
        // libm is part of libSystem on macOS; a separate -lm there makes zig skip
        // its implicit libc link on machines without an SDK. Ask for libc explicitly.
        if !is_macos_target(o.target[..]) { argv.append(String.from("-lm")) }
        argv.append(String.from("-lc"))
    }
    var views = List([]u8).new()
    for a in argv { views.append(a[..]) }
    let cache = private_zig_cache(o)
    var code: i32 = 1
    for attempt in 0..5 {
        code = os.exec(views[..], "", "") catch {
            eprintln("error: cannot run the C compiler `{}`; put zig on the PATH or set NX_CC", .{argv[0]})
            return false
        }
        let err = os.last_stderr()
        if code != 0 and err[..].find("failed to check cache") != null and attempt + 1 < 5 {
            time.sleep(300 *((attempt as u64) + 1))
            continue
        }
        if err.len > 0 { eprintln("{}", .{err[..].trim()}) }
        let outp = os.last_stdout()
        if outp.len > 0 { print("{}", .{outp}) }
        break
    }
    if cache.len > 0 { release_zig_cache(cache[..]) }
    if code != 0 {
        eprintln("error: C compilation failed (this is a compiler bug; run `nx emit-c` to inspect the output)", .{})
        return false
    }
    return true
}

/// When the C compiler is Zig, its local cache goes under the output
/// directory, one per build: Zig's cache is not safe against several
/// `zig cc` processes starting at once on Windows ("failed to check cache
/// ... file_open Unexpected"), and parallel builds (a test suite, a CI
/// matrix on one machine) do exactly that. A cache the user set explicitly
/// is respected. The directory, or "" when none was made.
fn private_zig_cache(o: *Opts) -> String {
    if o.cc.len == 0 or os.env("ZIG_LOCAL_CACHE_DIR") != null { return String.new() }
    let stem = stem_of(o.cc[0][..])
    var lower = String.new()
    for c in stem { lower.push_byte(if c >= 'A' and c <= 'Z' { c + 32 } else { c }) }
    if lower[..] != "zig" { return String.new() }
    let dir = format("{}/.zig-cache/{}-{}", .{o.out_dir, time.now(), random.int(0, 999999)})
    fs.make_dirs(dir[..]) catch { return String.new() }
    os.set_env("ZIG_LOCAL_CACHE_DIR", dir[..])
    return dir
}

/// Remove this build's Zig cache. Caches left behind by builds that
/// crashed or were killed are swept once they are an hour old; a younger
/// sibling may belong to a build running right now.
fn release_zig_cache(dir: []u8) {
    os.set_env("ZIG_LOCAL_CACHE_DIR", "")
    fs.remove_all(dir) catch { }
    let parent = fs.parent(dir)
    let names = fs.list(parent) catch { return }
    let now = time.now()
    for n in names {
        let child = fs.join(parent, n[..])
        let at = fs.modified(child[..]) catch { continue }
        if now - at > 3600 * 1000 { fs.remove_all(child[..]) catch { } }
    }
    io.remove_dir(parent) catch { }
}

fn exe_name(stem: []u8, target: []u8) -> String {
    if is_windows_target(target) { return format("{}.exe", .{stem}) }
    return String.from(stem)
}

fn absolute(path: []u8) -> String {
    if path.len > 0 and (path[0] == '/' or (path.len > 1 and path[1] == ':')) { return String.from(path) }
    let cwd = io.cwd() catch { return String.from(path) }
    return format("{}/{}", .{cwd, path})
}

fn cmd_build(o: *Opts, run: bool, out_path: *mut String) -> bool {
    var c = check_program(o) orelse return false
    let stem = stem_of(o.file[..])
    let has_main = c.main_inst != NONE
    if !has_main and !run { eprintln("note: no `main` found; building a library object", .{}) }
    let text = emit(&mut c, o, if has_main { cgen.ENTRY_MAIN } else { cgen.ENTRY_LIBRARY })
    if text.len == 0 { return false }
    let c_path = write_c(o, stem, text[..]) orelse return false
    var out = o.out.clone()
    if out.len == 0 {
        if has_main { out = format("{}/{}", .{o.out_dir, exe_name(stem, o.target[..])}) } else { out = format("{}/{}.o", .{o.out_dir, stem}) }
    }
    if !compile_c(&c, o, c_path[..], out[..], if has_main { "exe" } else { "object" }) { return false }
    if !o.keep_c { io.remove_file(c_path[..]) catch { } }
    out_path.*= out
    return true
}

fn run_program(exe: []u8, rest: *List(String)) -> i32 {
    var argv = List([]u8).new()
    let abs = absolute(exe)
    argv.append(abs[..])
    for a in rest { argv.append(a[..]) }
    let code = os.run(argv[..]) catch {
        eprintln("error: cannot run {}", .{exe})
        return 1
    }
    return code
}

fn cmd_run(o: *Opts) -> i32 {
    var exe = String.new()
    if !cmd_build(o, true, &mut exe) { return 1 }
    return run_program(exe[..], &o.rest)
}

fn cmd_test(o: *Opts) -> i32 {
    var c = check_program(o) orelse return 1
    if c.tests.len == 0 {
        println("no tests found", .{})
        return 0
    }
    let stem = stem_of(o.file[..])
    let text = emit(&mut c, o, cgen.ENTRY_TESTS)
    if text.len == 0 { return 1 }
    let tstem = format("{}_test", .{stem})
    let c_path = write_c(o, tstem[..], text[..]) orelse return 1
    let out = format("{}/{}", .{o.out_dir, exe_name(tstem[..], o.target[..])})
    if !compile_c(&c, o, c_path[..], out[..], "exe") { return 1 }
    if !o.keep_c { io.remove_file(c_path[..]) catch { } }
    return run_program(out[..], &o.rest)
}

fn cmd_check(o: *Opts) -> i32 {
    let c = check_program(o) orelse return 1
    _ = c
    println("ok", .{})
    return 0
}

fn cmd_emit_c(o: *Opts) -> i32 {
    var c = check_program(o) orelse return 1
    var entry = cgen.ENTRY_MAIN
    if c.main_inst == NONE { entry = if c.tests.len > 0 { cgen.ENTRY_TESTS } else { cgen.ENTRY_LIBRARY } }
    let text = emit(&mut c, o, entry)
    if text.len == 0 { return 1 }
    print("{}", .{text})
    return 0
}

/// `nx fmt FILE...`: rewrite each file in canonical form; `--check` only
/// reports the files that would change, and fails when there are any.
/// `nx fix FILE...`: rewrite the deprecated forms this compiler can migrate
/// mechanically (docs/stability.md). There are none in this version, so
/// every file is checked for parse errors and left alone.
fn cmd_fix(o: *Opts) -> i32 {
    var files = List(String).new()
    files.append(o.file.clone())
    for a in o.rest { if !a[..].starts_with("--") { files.append(a.clone()) } }
    for f in files {
        let text = io.read_file(f[..]) catch {
            eprintln("error: cannot read {}", .{f})
            return 1
        }
        let parsed = parser.parse_source(text[..])
        if parsed.errors.len > 0 {
            for e in parsed.errors { eprintln("{}: {}", .{f, e}) }
            return 1
        }
    }
    println("nothing to migrate: {} has no deprecations ({} file(s) unchanged)", .{VERSION, files.len})
    return 0
}

fn cmd_fmt(o: *Opts) -> i32 {
    var check_only = false
    var files = List(String).new()
    files.append(o.file.clone())
    for a in o.rest {
        if a == "--check" { check_only = true }
        else if a == "--migrate-only" { }
        else if !a[..].starts_with("--") { files.append(a.clone()) }
    }
    var changed: i32 = 0
    for f in files {
        let original = io.read_file(f[..]) catch {
            eprintln("error: cannot read {}", .{f})
            return 1
        }
        let formatted = fmt.format_source(original[..]) catch {
            eprintln("error: {}: the file has lexical errors; fix them before formatting", .{f})
            return 1
        }
        if formatted != original {
            changed += 1
            if check_only {
                println("would reformat {}", .{f})
            } else {
                io.write_file(f[..], formatted[..]) catch {
                    eprintln("error: cannot write {}", .{f})
                    return 1
                }
                println("formatted {}", .{f})
            }
        }
    }
    if check_only and changed > 0 { return 1 }
    return 0
}

fn cmd_effects(o: *Opts) -> i32 {
    var c = check_program(o) orelse return 1
    tools.effects(&mut c)
    return 0
}

fn cmd_refcounts(o: *Opts) -> i32 {
    var c = check_program(o) orelse return 1
    tools.refcounts(&mut c)
    return 0
}

/// `nx audit`: the unsafe blocks and mutable globals, then a full check.
fn cmd_audit(o: *Opts) -> i32 {
    let mods = check.load(o.file[..], o.std_dir[..]) catch { return 1 }
    var c = check.new_checker(mods)
    c.cc = o.cc.clone()
    c.target = o.target.clone()
    var globals_flag = false
    for a in o.rest { if a == "--globals" { globals_flag = true } }
    tools.audit(&mut c, globals_flag)
    let checked = check_program(o) orelse return 1
    _ = checked
    return 0
}

/// A deep copy of the options, for a command that runs a variant build.
fn clone_opts(o: *Opts) -> Opts {
    return Opts{
        .command = o.command.clone(), .file = o.file.clone(), .out = o.out.clone(), .out_dir = o.out_dir.clone(), .mode = o.mode,
        .std_dir = o.std_dir.clone(), .cc = o.cc.clone(), .target = o.target.clone(), .keep_c = o.keep_c,
        .defines = o.defines.clone(), .include_dirs = o.include_dirs.clone(), .rest = o.rest.clone(), .sigs = o.sigs, .cc_source = o.cc_source,
    }
}

/// `nx size`: the program compiled to an object with one section per
/// function, the sections attributed to declarations by C symbol.
fn cmd_size(o: *Opts) -> i32 {
    var c = check_program(o) orelse return 1
    let stem = stem_of(o.file[..])
    let has_main = c.main_inst != NONE
    var symbols = List(size.Symbol).new()
    let n = c.insts.len
    for i in 0..n {
        if c.insts[i].body == NONE { continue }
        let nm = c.insts[i].name.clone()
        symbols.append(size.Symbol{ .c = c.insts[i].mangled.clone(), .nx = if c.insts[i].targs.len == 0 { nm } else { format("{} (instance)", .{nm}) } })
    }
    for i in 0..n {
        if c.insts[i].export_name.len == 0 { continue }
        symbols.append(size.Symbol{ .c = c.insts[i].name.clone(), .nx = format("{} (export wrapper)", .{c.insts[i].name}) })
    }
    symbols.append(size.Symbol{ .c = String.from("main"), .nx = String.from("main (entry point)") })
    let text = emit(&mut c, o, if has_main { cgen.ENTRY_MAIN } else { cgen.ENTRY_LIBRARY })
    if text.len == 0 { return 1 }
    let sstem = format("{}_size", .{stem})
    let c_path = write_c(o, sstem[..], text[..]) orelse return 1
    let obj = format("{}/{}_size.o", .{o.out_dir, stem})
    var so = clone_opts(o)
    so.defines.append(String.from("NX_SIZE_SECTIONS"))
    if !compile_c(&c, &so, c_path[..], obj[..], "sections") { return 1 }
    io.remove_file(c_path[..]) catch { }
    let bytes = io.read_file(obj[..]) catch {
        eprintln("error: cannot read {}", .{obj})
        return 1
    }
    io.remove_file(obj[..]) catch { }
    let sections = size.section_sizes(bytes[..]) catch |e| {
        eprintln("error: {}", .{size.explain(e)})
        return 1
    }
    let a = size.attribute(&sections, &symbols)
    println("{>9}  {<5} declaration", .{"bytes", "kind"})
    for e in a.entries { println("{>9}  {<5} {}", .{e.bytes, e.kind, e.symbol}) }
    println("{>9}  {<5} runtime and libc glue", .{a.runtime, ""})
    let mode = if o.mode == cgen.MODE_DEBUG { "debug" } else if o.mode == cgen.MODE_SAFE { "safe" } else if o.mode == cgen.MODE_FAST { "fast" } else { "small" }
    println("{>9}        total ({} mode; the linker drops unreferenced sections)", .{a.total, mode})
    return 0
}

/// `nx doc`: the HTML page for a program, into `-o` or `<out-dir>/doc`.
fn cmd_doc(o: *Opts) -> i32 {
    var c = check_program(o) orelse return 1
    let stem = stem_of(o.file[..])
    let html = doc.generate(stem, &mut c)
    let dir = if o.out.len > 0 { o.out.clone() } else { format("{}/doc", .{o.out_dir}) }
    io.make_dir(dir[..]) catch { }
    let path = format("{}/{}.html", .{dir, stem})
    io.write_file(path[..], html[..]) catch {
        eprintln("error: cannot write {}", .{path})
        return 1
    }
    println("wrote {}", .{path})
    return 0
}

/// `nx init [name]`: a manifest here (and a main.nx when there is no source).
fn cmd_init(rest: [][]u8) -> i32 {
    let cwd = io.cwd() catch { String.from(".") }
    var name = String.new()
    if rest.len > 0 { name = String.from(rest[0]) } else {
        let base = stem_of(cwd[..])
        name = if base.len > 0 { String.from(base) } else { String.from("app") }
    }
    var clean = String.new()
    for c in name { clean.push_byte(if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') { c } else { '_' }) }
    let files = manifest.init(cwd[..], clean[..]) catch { return 1 }
    for f in files { println("wrote {}", .{f}) }
    return 0
}

/// `nx add <name> --git URL [--tag TAG] | --path DIR`: a dependency in the
/// manifest, then `nx fetch`.
fn cmd_add(rest: [][]u8) -> i32 {
    var name = String.new()
    var dep = manifest.Dep{ .name = String.new(), .git = String.new(), .tag = String.new(), .path = String.new() }
    var i: usize = 0
    while i < rest.len {
        let a = rest[i]
        if a == "--git" and i + 1 < rest.len { dep.git = String.from(rest[i + 1]); i += 2; continue }
        if a == "--tag" and i + 1 < rest.len { dep.tag = String.from(rest[i + 1]); i += 2; continue }
        if a == "--path" and i + 1 < rest.len { dep.path = String.from(rest[i + 1]); i += 2; continue }
        if name.len == 0 and !a.starts_with("--") { name = String.from(a); i += 1; continue }
        eprintln("error: unexpected argument `{}`", .{a})
        return 1
    }
    if name.len == 0 {
        eprintln("usage: nx add <name> --git URL [--tag TAG] | --path DIR", .{})
        return 1
    }
    dep.name = name
    let cwd = io.cwd() catch { String.from(".") }
    let mf = manifest.find(cwd[..]) orelse {
        eprintln("error: no {} here or above; run `nx init` first", .{manifest.MANIFEST})
        return 1
    }
    let mpath = format("{}/{}", .{mf.dir, manifest.MANIFEST})
    manifest.add(mpath[..], &dep) catch { return 1 }
    println("added `{}` to {}", .{dep.name, mpath})
    return cmd_fetch()
}

/// `nx fetch`: clone every git dependency and write the lock file.
fn cmd_fetch() -> i32 {
    let cwd = io.cwd() catch { String.from(".") }
    let mf = manifest.find(cwd[..]) orelse {
        eprintln("error: no {} here or above; run `nx init` first", .{manifest.MANIFEST})
        return 1
    }
    let lock = manifest.fetch(&mf) catch { return 1 }
    for l in lock {
        if l.source != "path" {
            let short = if l.commit.len > 10 { l.commit[0..10] } else { l.commit[..] }
            println("{} {} ({})", .{l.name, l.tag, short})
        } else {
            println("{} path {}", .{l.name, l.tag})
        }
    }
    println("wrote {}/{}", .{mf.dir, manifest.LOCK})
    return 0
}

/// The string value of an artifact field, or "".
fn artifact_str(c: *check.Checker, m: usize, art: usize, key: []u8) -> String {
    for f in c.node(m, art).kids.clone() {
        let fnode = c.node(m, f)
        if fnode.name != key { continue }
        let v = c.node(m, fnode.x)
        if v.k == parser.NodeKind.Lit and v.text == "str" { return v.name.clone() }
    }
    return String.new()
}

fn artifact_list(c: *check.Checker, m: usize, art: usize, key: []u8) -> List(String) {
    var out = List(String).new()
    for f in c.node(m, art).kids.clone() {
        let fnode = c.node(m, f)
        if fnode.name != key { continue }
        let v = c.node(m, fnode.x)
        if v.k == parser.NodeKind.ArrayLit {
            for e in v.kids.clone() {
                let en = c.node(m, e)
                if en.k == parser.NodeKind.Lit and en.text == "str" { out.append(en.name.clone()) }
            }
        }
    }
    return out
}

fn artifact_bool(c: *check.Checker, m: usize, art: usize, key: []u8) -> bool {
    for f in c.node(m, art).kids.clone() {
        let fnode = c.node(m, f)
        if fnode.name != key { continue }
        let v = c.node(m, fnode.x)
        if v.k == parser.NodeKind.Lit and v.text == "bool" { return v.name == "true" }
        if v.k == parser.NodeKind.Ident { return v.name == "true" }
    }
    return false
}

/// The host as a target triple: `x86_64-windows`, `aarch64-macos`, `x86_64-linux`.
fn host_target() -> String {
    let host = if is_windows_target("") { "windows" } else if is_macos_target("") { "macos" } else { "linux" }
    var arch = "x86_64"
    if let a = os.env("PROCESSOR_ARCHITECTURE") { if a == "ARM64" { arch = "aarch64" } }
    if host != "windows" {
        var argv = List([]u8).new()
        argv.append("uname")
        argv.append("-m")
        let code = process.exec(argv[..], "", "") catch { -1 }
        if code == 0 {
            let m = process.last_stdout()
            if m[..].trim() == "arm64" or m[..].trim() == "aarch64" { arch = "aarch64" }
        }
    }
    return format("{}-{}", .{arch, host})
}

/// Copy a directory tree.
fn copy_dir(from: []u8, to: []u8) -> !void {
    try fs.make_dirs(to)
    for name in try fs.list(from) {
        let src = fs.join(from, name[..])
        let dst = fs.join(to, name[..])
        if fs.is_dir(src[..]) { try copy_dir(src[..], dst[..]) } else { try fs.copy(src[..], dst[..]) }
    }
}

/// `nx ship`: every artifact the program declares (specification 15).
fn cmd_ship(o: *Opts) -> i32 {
    var c = check_program(o) orelse return 1
    // the artifacts, from the parse trees of the program's own modules
    var arts = List(usize).new()
    var art_mods = List(usize).new()
    let n_mods = c.mods.len
    for m in 0..n_mods {
        if c.mods[m].name[..].starts_with("std.") or c.mods[m].name[..].starts_with("cimport:") { continue }
        for it in c.mods[m].parsed.items.clone() {
            if c.node(m, it).k == parser.NodeKind.Artifact { arts.append(it); art_mods.append(m) }
        }
    }
    if arts.len == 0 {
        eprintln("error: no `artifact` declarations found; declare e.g. `artifact cabi {{ name = \"mylib\" }}` or `artifact python {{ name = \"mylib\" }}`", .{})
        return 1
    }
    let stem = stem_of(o.file[..])
    var produced = List(String).new()
    var lib_arts = List(usize).new()
    var cli_arts = List(usize).new()
    var installer_art = NONE
    for a, i in arts {
        let kind = c.node(art_mods[i], a).name.clone()
        if kind == "cabi" or kind == "python" or kind == "shared" or kind == "rustlib" or kind == "node" { lib_arts.append(i) }
        else if kind == "cli" or kind == "app" { cli_arts.append(i) }
        else if kind == "installer" { installer_art = i }
        else if kind != "lib" and kind != "link" {
            eprintln("note: artifact `{}` is not produced by this version of nx (supported: cabi, python, node, rustlib, shared, cli, installer); skipped", .{kind})
        }
    }
    if installer_art != NONE and cli_arts.len == 0 {
        eprintln("error: `artifact installer` needs an `artifact cli {{ name = ... }}` to install", .{})
        return 1
    }
    let target = if o.target.len > 0 { o.target.clone() } else { host_target() }
    let windows = is_windows_target(o.target[..])
    let macos = is_macos_target(o.target[..])
    let ship_mode = if o.mode == cgen.MODE_DEBUG { cgen.MODE_SAFE } else { o.mode }
    if lib_arts.len > 0 {
        var lib_name = String.new()
        var version = String.new()
        var has_python = false
        var has_node = false
        var has_rust = false
        var py_name = String.new()
        var npm_name = String.new()
        for i in lib_arts {
            let a = arts[i]
            let m = art_mods[i]
            let kind = c.node(m, a).name.clone()
            if lib_name.len == 0 { lib_name = artifact_str(&c, m, a, "name") }
            if version.len == 0 { version = artifact_str(&c, m, a, "version") }
            if kind == "python" { has_python = true; if py_name.len == 0 { py_name = artifact_str(&c, m, a, "name") } }
            if kind == "node" { has_node = true; if npm_name.len == 0 { npm_name = artifact_str(&c, m, a, "name") } }
            if kind == "rustlib" { has_rust = true }
        }
        if lib_name.len == 0 { lib_name = String.from(stem) }
        if version.len == 0 { version = String.from("0.1.0") }
        var any_export = false
        for i in 0..c.insts.len { if c.insts[i].export_name != "-" { any_export = true } }
        if !any_export {
            eprintln("error: library artifacts need at least one `export(c)` function", .{})
            return 1
        }
        var infos = List(cgen.ExportInfo).new()
        let text = emit_with(&mut c, o, cgen.ENTRY_LIBRARY, lib_name[..], ship_mode, &mut infos)
        if text.len == 0 { return 1 }
        let dir = format("{}/{}", .{o.out_dir, lib_name})
        fs.make_dirs(dir[..]) catch {
            eprintln("error: cannot create {}", .{dir})
            return 1
        }
        let c_path = format("{}/{}.c", .{dir, lib_name})
        io.write_file(c_path[..], text[..]) catch {
            eprintln("error: cannot write {}", .{c_path})
            return 1
        }
        // the runtime header next to the C, as write_c does
        let rt = format("{}/nx_rt.h", .{dir})
        io.write_file(rt[..], cgen.RUNTIME_H) catch { }
        let h_path = format("{}/{}.h", .{dir, lib_name})
        io.write_file(h_path[..], ship.c_header(lib_name[..], &infos)[..]) catch { }
        let shared_name = if windows { format("{}.dll", .{lib_name}) } else if macos { format("lib{}.dylib", .{lib_name}) } else { format("lib{}.so", .{lib_name}) }
        let shared_path = format("{}/{}", .{dir, shared_name})
        var lib_opts = clone_opts(o)
        lib_opts.mode = ship_mode
        lib_opts.keep_c = true
        // the shared library is built in its own directory: on Windows the linker also
        // writes an import library named <name>.lib there, which must not be confused
        // with the static archive produced below
        let shared_dir = format("{}/shared", .{dir})
        fs.make_dirs(shared_dir[..]) catch { }
        let shared_build = format("{}/{}", .{shared_dir, shared_name})
        if !compile_c(&c, &lib_opts, c_path[..], shared_build[..], "shared") { return 1 }
        fs.copy(shared_build[..], shared_path[..]) catch {
            eprintln("error: cannot place {}", .{shared_path})
            return 1
        }
        produced.append(shared_path.clone())
        // static object; on Windows it targets the MSVC ABI so Rust and MSVC users can link it
        let obj_path = format("{}/{}.{}", .{dir, lib_name, if windows { "obj" } else { "o" }})
        if windows and o.target.len == 0 and o.cc_source != 1 and o.cc_source != 2 { lib_opts.target = String.from("x86_64-windows-msvc") }
        if compile_c(&c, &lib_opts, c_path[..], obj_path[..], "object") {
            let ar_path = format("{}/{}", .{dir, if windows { format("{}.lib", .{lib_name}) } else { format("lib{}.a", .{lib_name}) }})
            io.remove_file(ar_path[..]) catch { }
            var argv = List([]u8).new()
            let is_zig = o.cc[0] == "zig" or o.cc[0][..].ends_with("zig") or o.cc[0][..].ends_with("zig.exe")
            if is_zig { argv.append(o.cc[0][..]); argv.append("ar") } else { argv.append("ar") }
            argv.append("rcs")
            argv.append(ar_path[..])
            argv.append(obj_path[..])
            let code = process.run(argv[..]) catch { -1 }
            if code == 0 { produced.append(ar_path) }
        }
        produced.append(h_path.clone())
        if has_rust {
            let ar_name = if windows { format("{}.lib", .{lib_name}) } else { format("lib{}.a", .{lib_name}) }
            let crate_dir = format("{}/rust", .{dir})
            fs.make_dirs(format("{}/src", .{crate_dir})[..]) catch { }
            fs.make_dirs(format("{}/lib", .{crate_dir})[..]) catch { }
            fs.copy(format("{}/{}", .{dir, ar_name})[..], format("{}/lib/{}", .{crate_dir, ar_name})[..]) catch { }
            for f in ship.rust_crate(lib_name[..], version[..], &infos, ar_name[..]) {
                let p = format("{}/{}", .{crate_dir, f.path})
                io.write_file(p[..], f.text[..]) catch {
                    eprintln("error: cannot write {}", .{p})
                    return 1
                }
            }
            produced.append(format("{}/Cargo.toml", .{crate_dir}))
        }
        if has_python {
            if py_name.len == 0 { py_name = lib_name.clone() }
            var pyn = String.new()
            for ch in py_name { pyn.push_byte(if ch == '-' { '_' } else { ch }) }
            let pkg_dir = format("{}/python/{}", .{dir, pyn})
            fs.make_dirs(pkg_dir[..]) catch {
                eprintln("error: cannot create {}", .{pkg_dir})
                return 1
            }
            let module = ship.python_module(lib_name[..], version[..], &infos, shared_name[..])
            io.write_file(format("{}/__init__.py", .{pkg_dir})[..], module[..]) catch { }
            let stub = ship.python_stub(&infos)
            io.write_file(format("{}/__init__.pyi", .{pkg_dir})[..], stub[..]) catch { }
            io.write_file(format("{}/py.typed", .{pkg_dir})[..], "") catch { }
            let lib_bytes = io.read_file(shared_path[..]) catch { String.new() }
            io.write_file(format("{}/{}", .{pkg_dir, shared_name})[..], lib_bytes[..]) catch { }
            io.write_file(format("{}/python/pyproject.toml", .{dir})[..], format("[project]\nname = \"{}\"\nversion = \"{}\"\nrequires-python = \">=3.8\"\n\n[build-system]\nrequires = [\"setuptools\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools]\npackages = [\"{}\"]\n\n[tool.setuptools.package-data]\n\"{}\" = [\"*.dll\", \"*.so\", \"*.dylib\", \"*.pyi\", \"py.typed\"]\n", .{pyn, version, pyn, pyn})[..]) catch { }
            var files = List(ship.ZipEntry).new()
            files.append(ship.ZipEntry{ .name = format("{}/__init__.py", .{pyn}), .data = module })
            files.append(ship.ZipEntry{ .name = format("{}/__init__.pyi", .{pyn}), .data = stub })
            files.append(ship.ZipEntry{ .name = format("{}/py.typed", .{pyn}), .data = String.new() })
            files.append(ship.ZipEntry{ .name = format("{}/{}", .{pyn, shared_name}), .data = lib_bytes })
            var wheel_name = String.new()
            let wheel = ship.build_wheel(pyn[..], version[..], ship.platform_tag(target[..]), &files, format("{} (built with Nexium)", .{pyn})[..], &mut wheel_name)
            let wheel_path = format("{}/{}", .{dir, wheel_name})
            io.write_file(wheel_path[..], wheel[..]) catch {
                eprintln("error: cannot write wheel: {}", .{wheel_path})
                return 1
            }
            produced.append(wheel_path)
        }
        if has_node {
            if npm_name.len == 0 { npm_name = lib_name.clone() }
            let pkg_dir = format("{}/node", .{dir})
            fs.make_dirs(pkg_dir[..]) catch {
                eprintln("error: cannot create {}", .{pkg_dir})
                return 1
            }
            io.write_file(format("{}/index.js", .{pkg_dir})[..], ship_node.module(lib_name[..], version[..], &infos, shared_name[..])[..]) catch { }
            io.write_file(format("{}/index.d.ts", .{pkg_dir})[..], ship_node.typings(&infos)[..]) catch { }
            let os_name = if windows { "win32" } else if macos { "darwin" } else { "linux" }
            let cpu = if target[..].starts_with("aarch64") { "arm64" } else { "x64" }
            io.write_file(format("{}/package.json", .{pkg_dir})[..], ship_node.package_json(npm_name[..], version[..], shared_name[..], os_name, cpu)[..]) catch { }
            io.write_file(format("{}/README.md", .{pkg_dir})[..], format("# {}\n\nA native library built with Nexium, callable from Node.js through koffi.\n\n```sh\nnpm install\nnode -e \"const m = require('.'); console.log(Object.keys(m))\"\n```\n\nThe package holds one platform's shared library; publish one per platform or\nuse `os` and `cpu` fields to gate installs.\n", .{npm_name})[..]) catch { }
            fs.copy(shared_path[..], format("{}/{}", .{pkg_dir, shared_name})[..]) catch {
                eprintln("error: cannot place the library in {}", .{pkg_dir})
                return 1
            }
            produced.append(format("{}/package.json", .{pkg_dir}))
        }
    }
    if cli_arts.len > 0 {
        var name = String.new()
        for i in cli_arts { if name.len == 0 { name = artifact_str(&c, art_mods[i], arts[i], "name") } }
        if name.len == 0 { name = String.from(stem) }
        var co = clone_opts(o)
        co.mode = ship_mode
        co.out_dir = format("{}/{}", .{o.out_dir, name})
        co.out = format("{}/{}", .{co.out_dir, exe_name(name[..], o.target[..])})
        co.keep_c = false
        fs.make_dirs(co.out_dir[..]) catch { }
        var exe_path = String.new()
        if !cmd_build(&co, false, &mut exe_path) { return 1 }
        produced.append(exe_path.clone())
        if installer_art != NONE {
            let ia = arts[installer_art]
            let im = art_mods[installer_art]
            // the program's files sit next to the executable so the installer templates can list them
            let src_dir = dir_of(o.file[..])
            var iname = artifact_str(&c, im, ia, "name")
            if iname.len == 0 { iname = name.clone() }
            var iversion = artifact_str(&c, im, ia, "version")
            if iversion.len == 0 { iversion = String.from("0.1.0") }
            let spec = installer.Spec{
                .name = iname, .exe = exe_name(name[..], o.target[..]), .version = iversion,
                .publisher = artifact_str(&c, im, ia, "publisher"), .url = artifact_str(&c, im, ia, "url"),
                .license = artifact_str(&c, im, ia, "license"), .readme = artifact_str(&c, im, ia, "readme"),
                .files = artifact_list(&c, im, ia, "files"), .add_to_path = artifact_bool(&c, im, ia, "add_to_path"),
            }
            let out_dir = co.out_dir.clone()
            var to_copy = spec.files.clone()
            if spec.readme.len > 0 { to_copy.append(spec.readme.clone()) }
            if spec.license.len > 0 { to_copy.append(spec.license.clone()) }
            for f in to_copy {
                let from = fs.join(src_dir, f[..])
                let to = fs.join(out_dir[..], f[..])
                if fs.is_dir(from[..]) {
                    copy_dir(from[..], to[..]) catch {
                        eprintln("error: cannot copy {}", .{from})
                        return 1
                    }
                } else if fs.exists(from[..]) {
                    fs.make_dirs(fs.parent(to[..])) catch { }
                    fs.copy(from[..], to[..]) catch {
                        eprintln("error: cannot copy {}", .{from})
                        return 1
                    }
                } else {
                    eprintln("error: installer file `{}` not found next to {}", .{f, o.file})
                    return 1
                }
            }
            let files = installer.produce(&spec, exe_path[..], windows, macos) catch { return 1 }
            for f in files { produced.append(f.clone()) }
        }
    }
    println("shipped {} artifact file(s) for {}:", .{produced.len, target})
    for p in produced { println("  {}", .{p}) }
    return 0
}

fn cmd_version() -> i32 {
    println("nx {} ({})", .{VERSION, RELEASE_NAME})
    return 0
}

/// `nx doctor`: the installation as this binary sees it.
fn cmd_doctor(o: *Opts) -> i32 {
    println("nx {} ({})", .{VERSION, RELEASE_NAME})
    var exe = os.exe_path()
    if exe.len == 0 { let args = os.args(); exe = absolute(args[0]) }
    println("executable:  {}", .{exe})
    var shown = String.new()
    for a, i in o.cc { if i > 0 { shown.append(" ") }; shown.append(a[..]) }
    println("C compiler:  {}  ({})", .{shown, cc_why(o)})
    var probe = List([]u8).new()
    probe.append(o.cc[0][..])
    let is_zig = o.cc[0][..].ends_with("zig") or o.cc[0][..].ends_with("zig.exe")
    probe.append(if is_zig { "version" } else { "--version" })
    var ok = false
    let code = os.exec(probe[..], "", "") catch { -1 }
    if code == 0 {
        let out = os.last_stdout()
        var first = String.new()
        for line in out[..].lines() { if first.len == 0 { first = String.from(line.trim()) } }
        println("             {}", .{first})
        ok = true
    } else if code < 0 {
        println("             not found", .{})
    } else {
        let err = os.last_stderr()
        var first = String.new()
        for line in err[..].lines() { if first.len == 0 { first = String.from(line.trim()) } }
        println("             does not run: {}", .{first})
    }
    println("std modules: {}", .{check.STD_MODULE_NAMES})
    let dir = dir_of(exe[..])
    var on_path = false
    if let path = os.env("PATH") {
        let sep = if is_windows_target("") { ";" } else { ":" }
        for d in path.split(sep) { if d == dir { on_path = true } }
    }
    println("on PATH:     {}", .{if on_path { "yes" } else { "no (add the executable's directory to PATH to run `nx` from anywhere)" }})
    if !ok {
        println("", .{})
        println("no working C compiler. Options:", .{})
        println("  - Windows: run the installer from https://github.com/Londopy/nexium/releases (it bundles Zig)", .{})
        println("  - macOS:   xcode-select --install", .{})
        println("  - Linux:   the install script (installers/install.sh) downloads Zig, or install zig / gcc", .{})
        println("  - any:     put zig on the PATH, or set NX_ZIG=/path/to/zig or NX_CC=gcc", .{})
        return 1
    }
    println("", .{})
    println("everything works. Try: nx run examples/hello.nx", .{})
    return 0
}

/// The C compiler and why it is the one, for the REPL banner: "zig via NX_ZIG".
fn compiler_summary(o: *Opts) -> String {
    var base = String.from(if o.cc.len > 0 { o.cc[0][..] } else { "zig" })
    let stem = stem_of(base[..])
    if stem.len > 0 { base = String.from(stem) }
    let why = cc_why(o)
    if why.starts_with(base[..]) { return String.from(why) }
    return format("{} via {}", .{base, why})
}

/// The host operating system, as the REPL banner names it.
fn host_os() -> []u8 {
    if is_windows_target("") { return "windows" }
    if is_macos_target("") { return "macos" }
    return "linux"
}

/// Why the driver runs the C compiler it runs, for `nx doctor`.
fn cc_why(o: *Opts) -> []u8 {
    if o.cc_source == 1 { return "--cc" }
    if o.cc_source == 2 { return "NX_CC" }
    if o.cc_source == 3 { return "NX_ZIG" }
    if o.cc_source == 4 { return "system compiler (macOS)" }
    if o.cc_source == 5 { return "bundled with nx" }
    return "zig on PATH"
}

fn cmd_tir(o: *Opts) -> i32 {
    let mods = check.load(o.file[..], o.std_dir[..]) catch { return 1 }
    var c = check.new_checker(mods)
    c.cc = o.cc.clone()
    c.target = o.target.clone()
    c.collect()
    c.reserve_errors()
    var out = String.new()
    if o.sigs {
        c.resolve_globals()
        c.print_sigs(&mut out)
    } else {
        c.check_program()
        c.print_program(&mut out)
    }
    print("{}", .{out})
    check.print_errors(&c.errors)
    if c.errors.len > 0 { return 1 }
    return 0
}

fn main() -> u8 {
    var args = os.args()
    // like `python`: no arguments at a terminal opens the REPL
    if args.len == 1 and io.is_terminal(1) {
        var padded = List([]u8).new()
        padded.append(args[0])
        padded.append("repl")
        args = padded[..]
    }
    if args.len >= 2 and (args[1] == "init" or args[1] == "add" or args[1] == "fetch") {
        let rest = args[2..]
        let c = if args[1] == "init" { cmd_init(rest) } else if args[1] == "add" { cmd_add(rest) } else { cmd_fetch() }
        return (if c < 0 or c > 255 { 1 } else { c }) as u8
    }
    let o = parse_opts(args) orelse {
        usage()
        return 2
    }
    var code: i32 = 0
    if o.command == "build" {
        var out = String.new()
        code = if cmd_build(&o, false, &mut out) { 0 } else { 1 }
        if code == 0 { println("built {}", .{out}) }
    } else if o.command == "run" {
        code = cmd_run(&o)
    } else if o.command == "test" {
        code = cmd_test(&o)
    } else if o.command == "check" {
        code = cmd_check(&o)
    } else if o.command == "emit-c" {
        code = cmd_emit_c(&o)
    } else if o.command == "tir" {
        code = cmd_tir(&o)
    } else if o.command == "fix" {
        code = cmd_fix(&o)
    } else if o.command == "fmt" {
        code = cmd_fmt(&o)
    } else if o.command == "effects" {
        code = cmd_effects(&o)
    } else if o.command == "audit" {
        code = cmd_audit(&o)
    } else if o.command == "refcounts" {
        code = cmd_refcounts(&o)
    } else if o.command == "doc" {
        code = cmd_doc(&o)
    } else if o.command == "ship" {
        var so = o
        var mode_given = false
        for a in args { if a == "--mode" { mode_given = true } }
        if !mode_given { so.mode = cgen.MODE_SAFE }
        code = cmd_ship(&so)
    } else if o.command == "size" {
        var so = o
        var mode_given = false
        for a in args { if a == "--mode" { mode_given = true } }
        if !mode_given { so.mode = cgen.MODE_SMALL }
        code = cmd_size(&so)
    } else if o.command == "leaks" {
        var lo = o
        lo.mode = cgen.MODE_DEBUG
        lo.defines.append(String.from("NX_LEAK_CHECK"))
        code = cmd_run(&lo)
    } else if o.command == "version" or o.command == "--version" or o.command == "-V" {
        code = cmd_version()
    } else if o.command == "doctor" {
        code = cmd_doctor(&o)
    } else if o.command == "lsp" {
        lsp.run(VERSION, o.std_dir[..], &o.cc)
        code = 0
    } else if o.command == "repl" {
        code = repl.run(VERSION, compiler_summary(&o)[..], host_os()[..], o.std_dir[..], &o.cc)
    } else {
        usage()
        return 2
    }
    return (if code < 0 or code > 255 { 1 } else { code }) as u8
}
