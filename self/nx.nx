// The `nx` command in Nexium: the driver over the self-hosted lexer,
// parser, checker and C emitter. It loads a program, checks it, emits C
// and hands that to the C compiler, the way the Rust driver does.
//
//     nx build file.nx [-o out] [--out-dir dir] [--mode debug|safe|fast|small]
//     nx run file.nx [-- args]
//     nx test file.nx [-- --verbose] [filter]
//     nx check file.nx
//     nx emit-c file.nx
//     nx tir file.nx [--sigs]
//
// Options everywhere: --std <dir> (std sources beside the embedded copies),
// --cc <command>, --target <triple>, --keep-c, -D<name>, -I<dir>.

import parser
import check
import cgen
import fmt
import tools
import size
import doc
import manifest
import ship
import ship_node
import installer
import lsp
import repl
import topo
import std.fs
import std.strings

// the compiler runs on a gigabyte of stack: the compile-time interpreter
// recurses on it, and each nested call costs about 165 KiB of frame
artifact cli { name = "nx", stack = "1G" }

const VERSION = "1.2.0"
const RELEASE_NAME = "Annapurna: South Face"

const NONE: usize = 0xFFFFFFFFFFFFFFFF

pub struct Opts {
    command: String
    file: String
    out: String
    out_dir: String
    mode: u8
    std_dir: String
    cc: List(String)
    target: String
    keep_c: bool
    /// `--watch`: run again whenever a file of the program changes
    watch: bool
    /// `--strict` (or NX_STRICT=1): warnings are errors
    strict: bool
    /// the CPU the C compiler targets when no --target is given: "baseline"
    /// (the default: plain x86-64, so a binary runs on any 64-bit x86 machine),
    /// "native" (this machine's; not portable), or a name for -march
    cpu: String
    defines: List(String)
    include_dirs: List(String)
    rest: List(String)
    sigs: bool
    /// how the C compiler was chosen: 1 --cc, 2 NX_CC, 3 NX_ZIG, 4 the system compiler on macOS,
    /// 5 a zig bundled with nx, 6 cc/gcc/clang on the PATH when there is no zig, 0 zig on PATH
    cc_source: u8
}

fn usage() {
    eprintln("usage: nx <build|run|test|check|effects|audit|refcounts|leaks|size|layout|emit-c|tir> <file.nx> [options] [-- args]", .{})
    eprintln("       nx explain <file.nx> <function> <effect>     why the function has the effect, as a tree", .{})
    eprintln("       nx fmt <file.nx>... [--check] | nx fix <file.nx>...", .{})
    eprintln("       nx doc <file.nx> [-o <dir>]", .{})
    eprintln("       nx ship <file.nx> [--mode m] [--target t]   produce the declared artifacts", .{})
    eprintln("       nx version | nx doctor | nx upgrade [--check] | nx install [DIR] | nx lsp | nx repl", .{})
    eprintln("       nx -e CODE | nx -p EXPR                    run a line as at the prompt; -p prints the value", .{})
    eprintln("       nx init [name] | nx add <name> --git URL [--tag TAG] [--dir SUB] | --path DIR | nx fetch | nx update [name...]", .{})
    eprintln("  -o <path>          output file", .{})
    eprintln("  --out-dir <dir>    where C and binaries go (default nx-out)", .{})
    eprintln("  --mode <m>         debug (default), safe, fast, small", .{})
    eprintln("  --std <dir>        standard library sources (embedded copies otherwise)", .{})
    eprintln("  --cc <command>     C compiler (default zig cc; NX_CC and NX_ZIG override)", .{})
    eprintln("  --target <triple>  cross-compile", .{})
    eprintln("  --cpu <name>       baseline (default: runs on any machine of the architecture), native, or a CPU name (NX_CPU too)", .{})
    eprintln("  --keep-c           keep the generated C", .{})
    eprintln("  --watch            run or test again whenever a file of the program changes", .{})
    eprintln("  --strict           warnings are errors (the view rules of 1.2; NX_STRICT=1 too)", .{})
    eprintln("", .{})
    eprintln("  nx topo [<chapter>|check|hint|solution|quiz|reset]   the Topo's exercises in the terminal", .{})
}

fn parse_opts(args: [][]u8) -> ?Opts {
    if args.len < 3 {
        if args.len == 2 and (args[1] == "version" or args[1] == "--version" or args[1] == "-V" or args[1] == "doctor" or args[1] == "lsp" or args[1] == "repl" or args[1] == "upgrade" or args[1] == "topo") {
            var padded = List([]u8).new()
            for a in args { padded.append(a) }
            padded.append("")
            return parse_opts(padded[..])
        }
        return null
    }
    var o = Opts{
        .command = String.from(args[1]), .file = String.from(args[2]), .out = String.new(), .out_dir = String.from("nx-out"), .mode = cgen.MODE_DEBUG,
        .std_dir = String.from("std"), .cc = List(String).new(), .target = String.new(), .keep_c = false, .watch = false, .strict = os.env("NX_STRICT") != null, .cpu = String.from("baseline"),
        .defines = List(String).new(), .include_dirs = List(String).new(), .rest = List(String).new(), .sigs = false, .cc_source = 0,
    }
    if let v = os.env("NX_CPU") { o.cpu = String.from(v) }
    var cc_text = String.new()
    var i: usize = 3
    while i < args.len {
        let a = args[i]
        if a == "--" {
            i += 1
            while i < args.len { o.rest.append(String.from(args[i])); i += 1 }
            break
        }
        if a == "-o" and i + 1 < args.len { o.out = String.from(args[i + 1]); i += 2; continue }
        if a == "--out-dir" and i + 1 < args.len { o.out_dir = String.from(args[i + 1]); i += 2; continue }
        if a == "--std" and i + 1 < args.len { o.std_dir = String.from(args[i + 1]); i += 2; continue }
        if a == "--cc" and i + 1 < args.len { cc_text = String.from(args[i + 1]); i += 2; continue }
        if a == "--target" and i + 1 < args.len { o.target = String.from(args[i + 1]); i += 2; continue }
        if a == "--mode" and i + 1 < args.len {
            let m = args[i + 1]
            if m == "debug" { o.mode = cgen.MODE_DEBUG } else if m == "safe" { o.mode = cgen.MODE_SAFE }
            else if m == "fast" { o.mode = cgen.MODE_FAST } else if m == "small" { o.mode = cgen.MODE_SMALL }
            else { eprintln("error: unknown mode `{}`", .{m}); return null }
            i += 2
            continue
        }
        if a == "--keep-c" { o.keep_c = true; i += 1; continue }
        if a == "--watch" { o.watch = true; i += 1; continue }
        if a == "--strict" { o.strict = true; i += 1; continue }
        if a == "--cpu" and i + 1 < args.len { o.cpu = String.from(args[i + 1]); i += 2; continue }
        if a == "--sigs" { o.sigs = true; i += 1; continue }
        if a.len > 2 and a[0..2] == "-D" { o.defines.append(String.from(a[2..])); i += 1; continue }
        if a.len > 2 and a[0..2] == "-I" { o.include_dirs.append(String.from(a[2..])); i += 1; continue }
        // anything else after the file is an argument to the program
        o.rest.append(String.from(a))
        i += 1
    }
    if cc_text.len > 0 { o.cc_source = 1 }
    if cc_text.len == 0 { if let v = os.env("NX_CC") { cc_text = String.from(v); o.cc_source = 2 } }
    if cc_text.len > 0 {
        for w in cc_text[..].split(" ") { if w.len > 0 { o.cc.append(String.from(w)) } }
    } else if let z = os.env("NX_ZIG") {
        o.cc.append(String.from(z))
        o.cc.append(String.from("cc"))
        o.cc_source = 3
    } else if let z = bundled_zig() {
        o.cc.append(z)
        o.cc.append(String.from("cc"))
        o.cc_source = 5
    } else if is_macos_target(o.target[..]) and o.target.len == 0 {
        // zig 0.14 cannot link against the current Xcode SDK; the system
        // compiler can (the Rust driver makes the same choice)
        o.cc.append(String.from("cc"))
        o.cc_source = 4
    } else if found_on_path("zig") {
        o.cc.append(String.from("zig"))
        o.cc.append(String.from("cc"))
    } else if let sys = system_cc() {
        // no zig anywhere: the machine's own compiler, so a Linux with gcc
        // alone still builds programs (it built nx from the seed, after all)
        o.cc.append(sys)
        o.cc_source = 6
    } else {
        o.cc.append(String.from("zig"))
        o.cc.append(String.from("cc"))
    }
    return o
}

/// Whether a program of that name is in a PATH directory.
fn found_on_path(name: []u8) -> bool {
    let path = os.env("PATH") orelse return false
    let windows = is_windows_target("")
    let sep = if windows { ";" } else { ":" }
    for d in path.split(sep) {
        if d.len == 0 { continue }
        let p = if windows { format("{}/{}.exe", .{d, name}) } else { format("{}/{}", .{d, name}) }
        if io.file_kind(p[..]) == 1 { return true }
    }
    return false
}

/// The system C compiler on a Unix without zig: the first of cc, gcc and
/// clang on the PATH. Windows has no such fallback: zig is the toolchain there.
fn system_cc() -> ?String {
    if is_windows_target("") { return null }
    for n in ["cc", "gcc", "clang"] { if found_on_path(n) { return String.from(n) } }
    return null
}

/// A file named `portable` beside the executable makes the copy leave
/// nothing on the machine: Zig's global cache goes under `<dir>/cache` (its
/// local cache is under the output directory already). The directory, or ""
/// when the copy is not portable.
fn portable_dir() -> String {
    let exe = os.exe_path()
    if exe.len == 0 { return String.new() }
    let dir = dir_of(exe[..])
    if io.file_kind(format("{}/portable", .{dir})[..]) == 1 { return String.from(dir) }
    return String.new()
}

fn apply_portable() {
    let dir = portable_dir()
    if dir.len == 0 or os.env("ZIG_GLOBAL_CACHE_DIR") != null { return }
    let cache = format("{}/cache/zig", .{dir})
    fs.make_dirs(cache[..]) catch { return }
    os.set_env("ZIG_GLOBAL_CACHE_DIR", cache[..])
}

/// `nx install [DIR]`: this copy of nx, with the zig, examples, std and docs
/// beside it, into the user's place (`%LocalAppData%\Programs\Nexium`, or
/// `~/.nexium` with `bin/` and `share/`), and that directory on the user's
/// PATH unless NEXIUM_NO_MODIFY_PATH=1. What the portable zip does for
/// itself, in one command.
fn cmd_install(dest_arg: []u8) -> i32 {
    let exe = os.exe_path()
    if exe.len == 0 {
        eprintln("error: cannot find the running executable", .{})
        return 1
    }
    let src = String.from(dir_of(exe[..]))
    let windows = is_windows_target("")
    var dest = String.from(dest_arg)
    if dest.len == 0 {
        if windows {
            let la = os.env("LOCALAPPDATA") orelse {
                eprintln("error: LOCALAPPDATA is not set; name the directory: nx install DIR", .{})
                return 1
            }
            dest = format("{}\\Programs\\Nexium", .{la})
        } else {
            let home = os.env("HOME") orelse {
                eprintln("error: HOME is not set; name the directory: nx install DIR", .{})
                return 1
            }
            dest = format("{}/.nexium", .{home})
        }
    }
    let bin = if windows { dest.clone() } else { fs.join(dest[..], "bin") }
    let share = if windows { dest.clone() } else { fs.join(dest[..], "share") }
    let name = if windows { "nx.exe" } else { "nx" }
    let target = fs.join(bin[..], name)
    if fs.normalize(target[..])[..] == fs.normalize(exe[..])[..] {
        println("nx is already installed at {}", .{exe})
        return 0
    }
    fs.make_dirs(bin[..]) catch {
        eprintln("error: cannot create {}", .{bin})
        return 1
    }
    fs.make_dirs(share[..]) catch {
        eprintln("error: cannot create {}", .{share})
        return 1
    }
    // an nx already there is set aside (a running one may be renamed)
    if fs.exists(target[..]) {
        let old = format("{}.old", .{target})
        fs.remove(old[..]) catch { }
        fs.rename(target[..], old[..]) catch {
            eprintln("error: cannot replace {}", .{target})
            return 1
        }
    }
    if !copy_program(exe[..], target[..]) {
        eprintln("error: cannot copy nx to {}", .{target})
        return 1
    }
    fs.remove(format("{}.old", .{target})[..]) catch { }
    // what sits beside the executable: the toolchain next to nx, the rest under share
    for d in ["zig", "examples", "std", "docs"] {
        let from = fs.join(src[..], d)
        if !fs.is_dir(from[..]) { continue }
        let to = if d == "zig" { fs.join(dest[..], d) } else { fs.join(share[..], d) }
        fs.remove_all(to[..]) catch { }
        copy_dir(from[..], to[..]) catch {
            eprintln("error: cannot copy {} to {}", .{from, to})
            return 1
        }
    }
    for f in ["README.md", "LICENSE", "CHANGELOG.md", "nexium.ico"] {
        let from = fs.join(src[..], f)
        if fs.is_file(from[..]) { fs.copy(from[..], fs.join(share[..], f)[..]) catch { } }
    }
    println("installed nx to {}", .{target})
    if os.env("NEXIUM_NO_MODIFY_PATH") != null {
        println("the PATH is left alone (NEXIUM_NO_MODIFY_PATH); add {} to it yourself", .{bin})
    } else if windows {
        var ps = String.from("$p = [Environment]::GetEnvironmentVariable('Path', 'User'); $parts = @(); if ($p) { $parts = @($p -split ';' | Where-Object { $_ }) }; if ($parts -notcontains '")
        ps.append(bin[..])
        ps.append("') { [Environment]::SetEnvironmentVariable('Path', (($parts + '")
        ps.append(bin[..])
        ps.append("') -join ';'), 'User'); 'added' } else { 'present' }")
        let argv: [][]u8 = ["powershell", "-NoProfile", "-Command", ps[..]]
        let code = os.exec(argv[..], "", "") catch { -1 }
        if code == 0 and os.last_stdout()[..].find("added") != null { println("added {} to the user PATH; new consoles see it", .{bin}) }
        else if code == 0 { println("{} is on the user PATH already", .{bin}) }
        else { println("could not edit the user PATH; add {} to it yourself", .{bin}) }
    } else {
        let home = os.env("HOME") orelse ""
        let line = format("export PATH=\"{}:$PATH\"", .{bin})
        var added = String.new()
        var any = false
        for rc in [".profile", ".bashrc", ".zshrc"] {
            let path = format("{}/{}", .{home, rc})
            if !fs.is_file(path[..]) { continue }
            any = true
            let text = fs.read(path[..]) catch { continue }
            if text[..].find(bin[..]) != null { continue }
            fs.append(path[..], format("\n# Nexium\n{}\n", .{line})[..]) catch { continue }
            added.append(" ")
            added.append(rc)
        }
        if !any {
            fs.write(format("{}/.profile", .{home})[..], format("# Nexium\n{}\n", .{line})[..]) catch { }
            added.append(" .profile")
        }
        if added.len > 0 { println("added {} to the PATH in:{}; new shells see it", .{bin, added}) }
        else { println("{} is on the PATH already", .{bin}) }
    }
    println("in a new console: nx doctor", .{})
    return 0
}

/// Copy a program, keeping the mode where there is one to keep.
fn copy_program(from: []u8, to: []u8) -> bool {
    if is_windows_target("") {
        fs.copy(from, to) catch { return false }
        return true
    }
    let argv: [][]u8 = ["cp", "-p", from, to]
    let code = os.exec(argv[..], "", "") catch { -1 }
    if code == 0 { return true }
    fs.copy(from, to) catch { return false }
    let chmod: [][]u8 = ["chmod", "755", to]
    _ = os.exec(chmod[..], "", "") catch { -1 }
    return true
}

/// A Zig installed next to `nx`: `<dir>/zig/zig` (the Windows installer) or
/// `<dir>/../zig/zig` (`~/.nexium/bin/nx` with `~/.nexium/zig`).
fn bundled_zig() -> ?String {
    let exe = os.exe_path()
    if exe.len == 0 { return null }
    let dir = dir_of(exe[..])
    let name = if is_windows_target("") { "zig.exe" } else { "zig" }
    let here = format("{}/zig/{}", .{dir, name})
    if io.file_kind(here[..]) == 1 { return here }
    let above = format("{}/../zig/{}", .{dir, name})
    if io.file_kind(above[..]) == 1 { return above }
    return null
}

fn is_windows_target(target: []u8) -> bool {
    if target.len == 0 { return os.env("COMSPEC") != null and os.env("WINDIR") != null }
    return target.find("windows") != null
}

fn is_macos_target(target: []u8) -> bool {
    if target.len == 0 { return os.env("HOME") != null and io.file_kind("/System/Library/CoreServices") == 2 }
    return target.find("macos") != null or target.find("darwin") != null
}

fn dir_of(path: []u8) -> []u8 {
    var i = path.len
    while i > 0 {
        if path[i - 1] == '/' or path[i - 1] == '\\' { return path[0..i - 1] }
        i -= 1
    }
    return "."
}

fn stem_of(path: []u8) -> []u8 {
    var start: usize = 0
    var i = path.len
    while i > 0 {
        if path[i - 1] == '/' or path[i - 1] == '\\' { start = i; break }
        i -= 1
    }
    var end = path.len
    var j = path.len
    while j > start {
        if path[j - 1] == '.' { end = j - 1; break }
        j -= 1
    }
    return path[start..end]
}

/// Load and check; the checker is returned for the emitter. Null after
/// errors, which have been printed.
fn check_program(o: *Opts) -> ?check.Checker {
    let mods = check.load(o.file[..], o.std_dir[..]) catch { return null }
    var c = check.new_checker(mods)
    c.cc = o.cc.clone()
    c.target = o.target.clone()
    c.collect()
    c.reserve_errors()
    c.check_program()
    if c.warnings.len > 0 { check.print_warnings(&c.warnings, o.strict) }
    if c.errors.len > 0 {
        check.print_errors(&c.errors)
        return null
    }
    if o.strict and c.warnings.len > 0 { return null }
    return c
}

/// The C of the program with the given entry: "" after errors.
fn emit(c: *mut check.Checker, o: *Opts, entry: u8) -> String {
    var infos = List(cgen.ExportInfo).new()
    return emit_with(c, o, entry, stem_of(o.file[..]), o.mode, &mut infos)
}

/// The C of the program with the given entry, library name and mode; the
/// exported functions' boundary records come back through `infos`.
fn emit_with(c: *mut check.Checker, o: *Opts, entry: u8, lib_name: []u8, mode: u8, infos: *mut List(cgen.ExportInfo)) -> String {
    var g = cgen.new_gen(c, mode, entry)
    g.lib_name = String.from(lib_name)
    g.stack_bytes = cli_stack(c) orelse return String.new()
    let out = g.generate()
    if g.errors.len > 0 {
        for e in g.errors { eprintln("error: {}", .{e}) }
        return String.new()
    }
    infos.*= g.exports.clone()
    return out
}

/// Write the C next to a current copy of the runtime header.
fn write_c(o: *Opts, stem: []u8, text: []u8) -> ?String {
    fs.make_dirs(o.out_dir[..]) catch { }
    let path = format("{}/{}.c", .{o.out_dir, stem})
    io.write_file(path[..], text) catch {
        eprintln("error: cannot write {}", .{path})
        return null
    }
    let rt = format("{}/nx_rt.h", .{o.out_dir})
    var current = false
    let existing = io.read_file(rt[..]) catch { String.new() }
    current = existing[..] == cgen.RUNTIME_H
    if !current { io.write_file(rt[..], cgen.RUNTIME_H) catch { } }
    return path
}

/// `artifact link { c_sources, libs, include, lib_paths }` declared in the sources.
fn link_info(c: *check.Checker, o: *Opts, c_sources: *mut List(String), libs: *mut List(String), include: *mut List(String), lib_paths: *mut List(String)) {
    let windows = is_windows_target(o.target[..])
    let macos = is_macos_target(o.target[..])
    let n_mods = c.mods.len
    for m in 0..n_mods {
        let root_dir = c.mods[m].dir.clone()
        for it in c.mods[m].parsed.items.clone() {
            let n = c.node(m, it)
            if n.k != parser.NodeKind.Artifact or n.name != "link" { continue }
            for f in n.kids.clone() {
                let fnode = c.node(m, f)
                let key = fnode.name.clone()
                let v = c.node(m, fnode.x)
                var vals = List(String).new()
                if v.k == parser.NodeKind.ArrayLit {
                    for e in v.kids.clone() {
                        let en = c.node(m, e)
                        if en.k == parser.NodeKind.Lit and en.text == "str" { vals.append(en.name.clone()) }
                    }
                } else if v.k == parser.NodeKind.Lit and v.text == "str" {
                    vals.append(v.name.clone())
                }
                for x in vals {
                    let rel = format("{}/{}", .{root_dir, x})
                    if key == "c_sources" { c_sources.append(rel) }
                    else if key == "libs" { libs.append(x.clone()) }
                    else if key == "libs_windows" and windows { libs.append(x.clone()) }
                    else if key == "libs_linux" and !windows and !macos { libs.append(x.clone()) }
                    else if key == "libs_macos" and macos { libs.append(x.clone()) }
                    else if key == "include" { include.append(rel) }
                    else if key == "lib_paths" { lib_paths.append(rel) }
                }
            }
        }
    }
}

/// Run the C compiler on the generated file. Zig's shared cache refuses a
/// concurrent run now and then: that is retried.
fn compile_c(c: *check.Checker, o: *Opts, c_path: []u8, out: []u8, kind: []u8) -> bool {
    var argv = List(String).new()
    for x in o.cc { argv.append(x.clone()) }
    argv.append(String.from("-std=gnu11"))
    if o.mode == cgen.MODE_DEBUG { argv.append(String.from("-O0")); if kind != "sections" { argv.append(String.from("-g")) } }
    else if o.mode == cgen.MODE_SMALL { argv.append(String.from("-Os")) }
    else { argv.append(String.from("-O2")) }
    // one section per function and datum, for `nx size`
    if kind == "sections" { argv.append(String.from("-ffunction-sections")); argv.append(String.from("-fdata-sections")) }
    argv.append(String.from("-w"))
    argv.append(String.from("-fno-strict-aliasing"))
    for d in o.defines { argv.append(format("-D{}", .{d})) }
    var c_sources = List(String).new()
    var libs = List(String).new()
    var include = List(String).new()
    var lib_paths = List(String).new()
    link_info(c, o, &mut c_sources, &mut libs, &mut include, &mut lib_paths)
    for d in o.include_dirs { argv.append(format("-I{}", .{d})) }
    for d in include { argv.append(format("-I{}", .{d})) }
    argv.append(format("-I{}", .{dir_of(o.file[..])}))
    // an object of the generated file alone: no vendored C, no libraries
    let linking = kind != "object" and kind != "sections"
    if linking {
        for s in c_sources { argv.append(s.clone()) }
        for d in lib_paths { argv.append(format("-L{}", .{d})) }
        for l in libs { argv.append(format("-l{}", .{l})) }
    }
    if o.target.len > 0 {
        argv.append(String.from("-target"))
        argv.append(o.target.clone())
    } else if let m = march_flag(o) {
        // zig cc compiles for the machine it runs on unless told otherwise, so a
        // binary built on a machine with AVX-512 trapped on one without it
        argv.append(m)
    }
    if kind == "object" or kind == "sections" { argv.append(String.from("-c")) }
    if kind == "shared" {
        argv.append(String.from("-shared"))
        argv.append(String.from("-DNX_BUILD_SHARED"))
        if !is_windows_target(o.target[..]) { argv.append(String.from("-fPIC")) }
    }
    argv.append(String.from(c_path))
    argv.append(String.from("-o"))
    argv.append(String.from(out))
    let windows = is_windows_target(o.target[..])
    if windows and linking { argv.append(String.from("-lws2_32")) }
    if !windows and linking {
        // libm is part of libSystem on macOS; a separate -lm there makes zig skip
        // its implicit libc link on machines without an SDK. Ask for libc explicitly.
        if !is_macos_target(o.target[..]) { argv.append(String.from("-lm")) }
        argv.append(String.from("-lc"))
        // threads live in libpthread before glibc 2.34; harmless after, and zig accepts it
        if !is_macos_target(o.target[..]) { argv.append(String.from("-lpthread")) }
    }
    var views = List([]u8).new()
    for a in argv { views.append(a[..]) }
    let cache = private_zig_cache(o)
    var code: i32 = 1
    for attempt in 0..5 {
        code = os.exec(views[..], "", "") catch {
            eprintln("error: cannot run the C compiler `{}`; put zig on the PATH or set NX_CC", .{argv[0]})
            return false
        }
        let err = os.last_stderr()
        if code != 0 and err[..].find("failed to check cache") != null and attempt + 1 < 5 {
            time.sleep(300 *((attempt as u64) + 1))
            continue
        }
        if err.len > 0 { eprintln("{}", .{err[..].trim()}) }
        let outp = os.last_stdout()
        if outp.len > 0 { print("{}", .{outp}) }
        break
    }
    if cache.len > 0 { release_zig_cache(cache[..]) }
    if code != 0 {
        eprintln("error: C compilation failed (this is a compiler bug; run `nx emit-c` to inspect the output)", .{})
        return false
    }
    return true
}

/// When the C compiler is Zig, its local cache goes under the output
/// directory, one per build: Zig's cache is not safe against several
/// `zig cc` processes starting at once on Windows ("failed to check cache
/// ... file_open Unexpected"), and parallel builds (a test suite, a CI
/// matrix on one machine) do exactly that. A cache the user set explicitly
/// is respected. The directory, or "" when none was made.
fn private_zig_cache(o: *Opts) -> String {
    if o.cc.len == 0 or os.env("ZIG_LOCAL_CACHE_DIR") != null { return String.new() }
    let stem = stem_of(o.cc[0][..])
    var lower = String.new()
    for c in stem { lower.push_byte(if c >= 'A' and c <= 'Z' { c + 32 } else { c }) }
    if lower[..] != "zig" { return String.new() }
    let dir = format("{}/.zig-cache/{}-{}", .{o.out_dir, time.now(), random.int(0, 999999)})
    fs.make_dirs(dir[..]) catch { return String.new() }
    os.set_env("ZIG_LOCAL_CACHE_DIR", dir[..])
    return dir
}

/// Remove this build's Zig cache. Caches left behind by builds that
/// crashed or were killed are swept once they are an hour old; a younger
/// sibling may belong to a build running right now.
fn release_zig_cache(dir: []u8) {
    os.set_env("ZIG_LOCAL_CACHE_DIR", "")
    fs.remove_all(dir) catch { }
    let parent = fs.parent(dir)
    let names = fs.list(parent) catch { return }
    let now = time.now()
    for n in names {
        let child = fs.join(parent, n[..])
        let at = fs.modified(child[..]) catch { continue }
        if now - at > 3600 * 1000 { fs.remove_all(child[..]) catch { } }
    }
    io.remove_dir(parent) catch { }
}

fn exe_name(stem: []u8, target: []u8) -> String {
    if is_windows_target(target) { return format("{}.exe", .{stem}) }
    return String.from(stem)
}

fn absolute(path: []u8) -> String {
    if path.len > 0 and (path[0] == '/' or (path.len > 1 and path[1] == ':')) { return String.from(path) }
    let cwd = io.cwd() catch { return String.from(path) }
    return format("{}/{}", .{cwd, path})
}

fn cmd_build(o: *Opts, run: bool, out_path: *mut String) -> bool {
    var c = check_program(o) orelse return false
    let stem = stem_of(o.file[..])
    let has_main = c.main_inst != NONE
    if !has_main and !run { eprintln("note: no `main` found; building a library object", .{}) }
    let text = emit(&mut c, o, if has_main { cgen.ENTRY_MAIN } else { cgen.ENTRY_LIBRARY })
    if text.len == 0 { return false }
    let c_path = write_c(o, stem, text[..]) orelse return false
    var out = o.out.clone()
    if out.len == 0 {
        if has_main { out = format("{}/{}", .{o.out_dir, exe_name(stem, o.target[..])}) } else { out = format("{}/{}.o", .{o.out_dir, stem}) }
    }
    if !compile_c(&c, o, c_path[..], out[..], if has_main { "exe" } else { "object" }) { return false }
    if !o.keep_c { io.remove_file(c_path[..]) catch { } }
    out_path.*= out
    return true
}

fn run_program(exe: []u8, rest: *List(String)) -> i32 {
    var argv = List([]u8).new()
    let abs = absolute(exe)
    argv.append(abs[..])
    for a in rest { argv.append(a[..]) }
    let code = os.run(argv[..]) catch {
        eprintln("error: cannot run {}", .{exe})
        return 1
    }
    return code
}

fn cmd_run(o: *Opts) -> i32 {
    if o.watch { return watch_loop(o) }
    var exe = String.new()
    if !cmd_build(o, true, &mut exe) { return 1 }
    return run_program(exe[..], &o.rest)
}

/// `nx run FILE --watch`, `nx test FILE --watch`: run, then run again
/// whenever a file of the program changes. The files are the modules the
/// checker loads (the program's own and its packages', never the standard
/// library), polled twice a second by their modification times; a change
/// waits a moment for the editor to finish writing. Ctrl-C leaves.
/// NX_WATCH_ROUNDS=N stops after N reruns, for the harness.
fn watch_loop(o: *Opts) -> i32 {
    var rounds: i64 = -1
    if let r = os.env("NX_WATCH_ROUNDS") { if r.len > 0 { rounds = r.parse_int(i64) catch { -1 } } }
    var files = watched_files(o)
    var stamps = stamps_of(&files)
    var code = run_once(o)
    println("--- watching {} file(s); Ctrl-C leaves ---", .{files.len})
    var done: i64 = 0
    while rounds < 0 or done < rounds {
        time.sleep(500)
        let now = stamps_of(&files)
        if !stamps_differ(&stamps, &now) { continue }
        time.sleep(150)
        println("--- changed; running again ---", .{})
        code = run_once(o)
        files = watched_files(o)
        stamps = stamps_of(&files)
        done += 1
    }
    return code
}

fn run_once(o: *Opts) -> i32 {
    var once = clone_opts(o)
    once.watch = false
    if o.command == "test" { return cmd_test(&once) }
    return cmd_run(&once)
}

/// The program's files: the one named and every module the checker loads
/// for it, apart from the standard library and imported headers.
fn watched_files(o: *Opts) -> List(String) {
    var out = List(String).new()
    out.append(o.file.clone())
    let mods = check.load(o.file[..], o.std_dir[..]) catch { return out }
    for i in 0..mods.len {
        let p = mods[i].path[..]
        if p.len == 0 or p.starts_with("<std>") or mods[i].name[..].starts_with("cimport:") { continue }
        var known = false
        for f in out { if f[..] == p { known = true } }
        if !known { out.append(String.from(p)) }
    }
    return out
}

fn stamps_of(files: *List(String)) -> List(i64) {
    var out = List(i64).new()
    for f in files { out.append(fs.modified(f[..]) catch { 0 }) }
    return out
}

fn stamps_differ(a: *List(i64), b: *List(i64)) -> bool {
    if a.len != b.len { return true }
    for x, i in a { if x != b[i] { return true } }
    return false
}

fn cmd_test(o: *Opts) -> i32 {
    if o.watch { return watch_loop(o) }
    var c = check_program(o) orelse return 1
    if c.tests.len == 0 {
        println("no tests found", .{})
        return 0
    }
    let stem = stem_of(o.file[..])
    let text = emit(&mut c, o, cgen.ENTRY_TESTS)
    if text.len == 0 { return 1 }
    let tstem = format("{}_test", .{stem})
    let c_path = write_c(o, tstem[..], text[..]) orelse return 1
    let out = format("{}/{}", .{o.out_dir, exe_name(tstem[..], o.target[..])})
    if !compile_c(&c, o, c_path[..], out[..], "exe") { return 1 }
    if !o.keep_c { io.remove_file(c_path[..]) catch { } }
    return run_program(out[..], &o.rest)
}

fn cmd_check(o: *Opts) -> i32 {
    let c = check_program(o) orelse return 1
    _ = c
    println("ok", .{})
    return 0
}

fn cmd_emit_c(o: *Opts) -> i32 {
    var c = check_program(o) orelse return 1
    var entry = cgen.ENTRY_MAIN
    if c.main_inst == NONE { entry = if c.tests.len > 0 { cgen.ENTRY_TESTS } else { cgen.ENTRY_LIBRARY } }
    let text = emit(&mut c, o, entry)
    if text.len == 0 { return 1 }
    print("{}", .{text})
    return 0
}

/// `nx fmt FILE...`: rewrite each file in canonical form; `--check` only
/// reports the files that would change, and fails when there are any.
/// `nx fix FILE...`: rewrite the deprecated forms this compiler can migrate
/// mechanically (docs/stability.md). There are none in this version, so
/// every file is checked for parse errors and left alone.
fn cmd_fix(o: *Opts) -> i32 {
    var files = List(String).new()
    files.append(o.file.clone())
    for a in o.rest { if !a[..].starts_with("--") { files.append(a.clone()) } }
    for f in files {
        let text = io.read_file(f[..]) catch {
            eprintln("error: cannot read {}", .{f})
            return 1
        }
        let parsed = parser.parse_source(text[..])
        if parsed.errors.len > 0 {
            for e in parsed.errors { eprintln("{}: {}", .{f, e}) }
            return 1
        }
    }
    println("nothing to migrate: {} has no deprecations ({} file(s) unchanged)", .{VERSION, files.len})
    return 0
}

fn cmd_fmt(o: *Opts) -> i32 {
    var check_only = false
    var files = List(String).new()
    files.append(o.file.clone())
    for a in o.rest {
        if a == "--check" { check_only = true }
        else if a == "--migrate-only" { }
        else if !a[..].starts_with("--") { files.append(a.clone()) }
    }
    var changed: i32 = 0
    for f in files {
        let original = io.read_file(f[..]) catch {
            eprintln("error: cannot read {}", .{f})
            return 1
        }
        let formatted = fmt.format_source(original[..]) catch {
            eprintln("error: {}: the file has lexical errors; fix them before formatting", .{f})
            return 1
        }
        if formatted != original {
            changed += 1
            if check_only {
                println("would reformat {}", .{f})
            } else {
                io.write_file(f[..], formatted[..]) catch {
                    eprintln("error: cannot write {}", .{f})
                    return 1
                }
                println("formatted {}", .{f})
            }
        }
    }
    if check_only and changed > 0 { return 1 }
    return 0
}

fn cmd_effects(o: *Opts) -> i32 {
    var c = check_program(o) orelse return 1
    tools.effects(&mut c)
    return 0
}

fn cmd_refcounts(o: *Opts) -> i32 {
    var c = check_program(o) orelse return 1
    tools.refcounts(&mut c)
    return 0
}

/// `nx audit`: the unsafe blocks and mutable globals, then a full check.
/// `--lock` writes the effects lockfile beside the file instead, `--check`
/// compares the program's effects with it and fails on a gained effect.
fn cmd_audit(o: *Opts) -> i32 {
    var lock_flag = false
    var check_flag = false
    for a in o.rest {
        if a == "--lock" { lock_flag = true }
        if a == "--check" { check_flag = true }
    }
    if lock_flag or check_flag {
        var c = check_program(o) orelse return 1
        let lock_path = fs.with_extension(o.file[..], "effects.lock")
        if lock_flag {
            let text = tools.effects_lock_text(&mut c)
            io.write_file(lock_path[..], text[..]) catch {
                eprintln("error: cannot write {}", .{lock_path})
                return 1
            }
            var n: usize = 0
            for l in text[..].lines() { if l.len > 0 and !l.starts_with("#") { n += 1 } }
            println("wrote {} ({} functions)", .{lock_path, n})
            return 0
        }
        let locked = fs.read(lock_path[..]) catch {
            eprintln("error: no {}; `nx audit {} --lock` writes it", .{lock_path, o.file})
            return 1
        }
        var gains = List(String).new()
        var notes = List(String).new()
        tools.effects_lock_compare(&mut c, locked[..], &mut gains, &mut notes)
        for n in notes { println("note: {}", .{n}) }
        for g in gains { eprintln("error: {}", .{g}) }
        if gains.len > 0 {
            eprintln("{} function(s) gained an effect since {}; `nx audit {} --lock` accepts the change", .{gains.len, lock_path, o.file})
            return 1
        }
        println("effects match {} ({} note(s))", .{lock_path, notes.len})
        return 0
    }
    let mods = check.load(o.file[..], o.std_dir[..]) catch { return 1 }
    var c = check.new_checker(mods)
    c.cc = o.cc.clone()
    c.target = o.target.clone()
    var globals_flag = false
    for a in o.rest { if a == "--globals" { globals_flag = true } }
    tools.audit(&mut c, globals_flag)
    let checked = check_program(o) orelse return 1
    _ = checked
    return 0
}

/// A deep copy of the options, for a command that runs a variant build.
fn clone_opts(o: *Opts) -> Opts {
    return Opts{
        .command = o.command.clone(), .file = o.file.clone(), .out = o.out.clone(), .out_dir = o.out_dir.clone(), .mode = o.mode,
        .std_dir = o.std_dir.clone(), .cc = o.cc.clone(), .target = o.target.clone(), .keep_c = o.keep_c, .watch = o.watch, .strict = o.strict, .cpu = o.cpu.clone(),
        .defines = o.defines.clone(), .include_dirs = o.include_dirs.clone(), .rest = o.rest.clone(), .sigs = o.sigs, .cc_source = o.cc_source,
    }
}

/// `nx size`: the program compiled to an object with one section per
/// function, the sections attributed to declarations by C symbol.
/// `nx layout FILE [TYPE...]`: the C layout of the named structs and enums
/// of the file, or of every non-generic one when none is named.
fn cmd_layout(o: *Opts) -> i32 {
    var c = check_program(o) orelse return 1
    var names = List(String).new()
    for r in o.rest { names.append(r.clone()) }
    if names.len == 0 {
        for d in 0..c.structs.len { if c.structs[d].module == 0 and c.structs[d].tparams.len == 0 { names.append(c.structs[d].name.clone()) } }
        for d in 0..c.enums.len { if c.enums[d].module == 0 and c.enums[d].tparams.len == 0 { names.append(c.enums[d].name.clone()) } }
        if names.len == 0 {
            println("no struct or enum in {}", .{o.file})
            return 0
        }
    }
    var code: i32 = 0
    for n, i in names {
        if i > 0 { println("", .{}) }
        let report = c.layout_report(n[..]) orelse {
            eprintln("error: no struct or enum named `{}` in {}", .{n, o.file})
            code = 1
            continue
        }
        print("{}", .{report})
    }
    return code
}

fn cmd_size(o: *Opts) -> i32 {
    var c = check_program(o) orelse return 1
    let stem = stem_of(o.file[..])
    let has_main = c.main_inst != NONE
    var symbols = List(size.Symbol).new()
    let n = c.insts.len
    for i in 0..n {
        if c.insts[i].body == NONE { continue }
        let nm = c.insts[i].name.clone()
        symbols.append(size.Symbol{ .c = c.insts[i].mangled.clone(), .nx = if c.insts[i].targs.len == 0 { nm } else { format("{} (instance)", .{nm}) } })
    }
    for i in 0..n {
        if c.insts[i].export_name.len == 0 { continue }
        symbols.append(size.Symbol{ .c = c.insts[i].name.clone(), .nx = format("{} (export wrapper)", .{c.insts[i].name}) })
    }
    symbols.append(size.Symbol{ .c = String.from("main"), .nx = String.from("main (entry point)") })
    let text = emit(&mut c, o, if has_main { cgen.ENTRY_MAIN } else { cgen.ENTRY_LIBRARY })
    if text.len == 0 { return 1 }
    let sstem = format("{}_size", .{stem})
    let c_path = write_c(o, sstem[..], text[..]) orelse return 1
    let obj = format("{}/{}_size.o", .{o.out_dir, stem})
    var so = clone_opts(o)
    so.defines.append(String.from("NX_SIZE_SECTIONS"))
    if !compile_c(&c, &so, c_path[..], obj[..], "sections") { return 1 }
    io.remove_file(c_path[..]) catch { }
    let bytes = io.read_file(obj[..]) catch {
        eprintln("error: cannot read {}", .{obj})
        return 1
    }
    io.remove_file(obj[..]) catch { }
    let sections = size.section_sizes(bytes[..]) catch |e| {
        eprintln("error: {}", .{size.explain(e)})
        return 1
    }
    let a = size.attribute(&sections, &symbols)
    println("{>9}  {<5} declaration", .{"bytes", "kind"})
    for e in a.entries { println("{>9}  {<5} {}", .{e.bytes, e.kind, e.symbol}) }
    println("{>9}  {<5} runtime and libc glue", .{a.runtime, ""})
    let mode = if o.mode == cgen.MODE_DEBUG { "debug" } else if o.mode == cgen.MODE_SAFE { "safe" } else if o.mode == cgen.MODE_FAST { "fast" } else { "small" }
    println("{>9}        total ({} mode; the linker drops unreferenced sections)", .{a.total, mode})
    return 0
}

/// `nx doc`: the HTML page for a program, into `-o` or `<out-dir>/doc`.
fn cmd_doc(o: *Opts) -> i32 {
    var c = check_program(o) orelse return 1
    let stem = stem_of(o.file[..])
    let html = doc.generate(stem, &mut c)
    let dir = if o.out.len > 0 { o.out.clone() } else { format("{}/doc", .{o.out_dir}) }
    io.make_dir(dir[..]) catch { }
    let path = format("{}/{}.html", .{dir, stem})
    io.write_file(path[..], html[..]) catch {
        eprintln("error: cannot write {}", .{path})
        return 1
    }
    println("wrote {}", .{path})
    return 0
}

/// `nx init [name]`: a manifest here (and a main.nx when there is no source).
fn cmd_init(rest: [][]u8) -> i32 {
    let cwd = io.cwd() catch { String.from(".") }
    var name = String.new()
    if rest.len > 0 { name = String.from(rest[0]) } else {
        let base = stem_of(cwd[..])
        name = if base.len > 0 { String.from(base) } else { String.from("app") }
    }
    var clean = String.new()
    for c in name { clean.push_byte(if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') { c } else { '_' }) }
    let files = manifest.init(cwd[..], clean[..]) catch { return 1 }
    for f in files { println("wrote {}", .{f}) }
    return 0
}

/// `nx add <name> --git URL [--tag TAG] | --path DIR`: a dependency in the
/// manifest, then `nx fetch`.
fn cmd_add(rest: [][]u8) -> i32 {
    var name = String.new()
    var dep = manifest.Dep{ .name = String.new(), .git = String.new(), .tag = String.new(), .path = String.new(), .dir = String.new() }
    var i: usize = 0
    while i < rest.len {
        let a = rest[i]
        if a == "--git" and i + 1 < rest.len { dep.git = String.from(rest[i + 1]); i += 2; continue }
        if a == "--tag" and i + 1 < rest.len { dep.tag = String.from(rest[i + 1]); i += 2; continue }
        if a == "--path" and i + 1 < rest.len { dep.path = String.from(rest[i + 1]); i += 2; continue }
        if a == "--dir" and i + 1 < rest.len { dep.dir = String.from(rest[i + 1]); i += 2; continue }
        if name.len == 0 and !a.starts_with("--") { name = String.from(a); i += 1; continue }
        eprintln("error: unexpected argument `{}`", .{a})
        return 1
    }
    if name.len == 0 {
        eprintln("usage: nx add <name> --git URL [--tag TAG] [--dir SUB] | --path DIR", .{})
        return 1
    }
    dep.name = name
    let cwd = io.cwd() catch { String.from(".") }
    let mf = manifest.find(cwd[..]) orelse {
        eprintln("error: no {} here or above; run `nx init` first", .{manifest.MANIFEST})
        return 1
    }
    let mpath = format("{}/{}", .{mf.dir, manifest.MANIFEST})
    manifest.add(mpath[..], &dep) catch { return 1 }
    println("added `{}` to {}", .{dep.name, mpath})
    // the new dependency is not in the lock yet, so a fetch resolves its tag
    var none = List([]u8).new()
    return cmd_fetch(none[..], false)
}

/// `nx fetch`: clone every git dependency and write the lock file.
/// `nx fetch`: every dependency at the commit the lock names (or at its tag,
/// the first time). `nx update [name...]`: those dependencies (all, with no
/// name) get their tag resolved again and the lock rewritten.
fn cmd_fetch(update: [][]u8, update_all: bool) -> i32 {
    let cwd = io.cwd() catch { String.from(".") }
    let mf = manifest.find(cwd[..]) orelse {
        eprintln("error: no {} here or above; run `nx init` first", .{manifest.MANIFEST})
        return 1
    }
    let lock = manifest.fetch(&mf, update, update_all) catch { return 1 }
    for l in lock {
        if l.source != "path" {
            let short = if l.commit.len > 10 { l.commit[0..10] } else { l.commit[..] }
            println("{} {} ({})", .{l.name, l.tag, short})
        } else {
            println("{} path {}", .{l.name, l.tag})
        }
    }
    println("wrote {}/{}", .{mf.dir, manifest.LOCK})
    return 0
}

/// `artifact cli { stack = "1G" }` in the program's own modules: the bytes
/// `main` runs on, 0 when nothing is declared, null after a diagnostic for a
/// value that is not a size (K, M or G after the digits, or plain bytes).
fn cli_stack(c: *check.Checker) -> ?u64 {
    for m in 0..c.mods.len {
        if c.mods[m].name[..].starts_with("std.") or c.mods[m].name[..].starts_with("cimport:") { continue }
        for it in c.mods[m].parsed.items.clone() {
            if c.node(m, it).k != parser.NodeKind.Artifact { continue }
            let kind = c.node(m, it).name.clone()
            if kind[..] != "cli" and kind[..] != "app" { continue }
            let s = artifact_str(c, m, it, "stack")
            if s.len == 0 { continue }
            if let n = parse_size(s[..]) { return n }
            eprintln("error: artifact cli: `stack` must be a size such as \"1G\", \"256M\" or \"64K\" (got \"{}\")", .{s})
            return null
        }
    }
    return 0
}

/// "64K", "256M", "1G" or a count of bytes; null for anything else or zero.
fn parse_size(s: []u8) -> ?u64 {
    if s.len == 0 { return null }
    var digits = s
    var mult: u64 = 1
    let last = s[s.len - 1]
    if last == 'K' or last == 'k' { mult = 1024; digits = s[0..s.len - 1] }
    else if last == 'M' or last == 'm' { mult = 1024 * 1024; digits = s[0..s.len - 1] }
    else if last == 'G' or last == 'g' { mult = 1024 * 1024 * 1024; digits = s[0..s.len - 1] }
    if digits.len == 0 { return null }
    let n = digits.parse_int(u64) catch { return null }
    if n == 0 { return null }
    return n * mult
}

/// The string value of an artifact field, or "".
fn artifact_str(c: *check.Checker, m: usize, art: usize, key: []u8) -> String {
    for f in c.node(m, art).kids.clone() {
        let fnode = c.node(m, f)
        if fnode.name != key { continue }
        let v = c.node(m, fnode.x)
        if v.k == parser.NodeKind.Lit and v.text == "str" { return v.name.clone() }
    }
    return String.new()
}

fn artifact_list(c: *check.Checker, m: usize, art: usize, key: []u8) -> List(String) {
    var out = List(String).new()
    for f in c.node(m, art).kids.clone() {
        let fnode = c.node(m, f)
        if fnode.name != key { continue }
        let v = c.node(m, fnode.x)
        if v.k == parser.NodeKind.ArrayLit {
            for e in v.kids.clone() {
                let en = c.node(m, e)
                if en.k == parser.NodeKind.Lit and en.text == "str" { out.append(en.name.clone()) }
            }
        }
    }
    return out
}

fn artifact_bool(c: *check.Checker, m: usize, art: usize, key: []u8) -> bool {
    for f in c.node(m, art).kids.clone() {
        let fnode = c.node(m, f)
        if fnode.name != key { continue }
        let v = c.node(m, fnode.x)
        if v.k == parser.NodeKind.Lit and v.text == "bool" { return v.name == "true" }
        if v.k == parser.NodeKind.Ident { return v.name == "true" }
    }
    return false
}

/// The host as a target triple: `x86_64-windows`, `aarch64-macos`, `x86_64-linux`.
fn host_target() -> String {
    let host = if is_windows_target("") { "windows" } else if is_macos_target("") { "macos" } else { "linux" }
    var arch = "x86_64"
    if let a = os.env("PROCESSOR_ARCHITECTURE") { if a == "ARM64" { arch = "aarch64" } }
    if host != "windows" {
        var argv = List([]u8).new()
        argv.append("uname")
        argv.append("-m")
        let code = process.exec(argv[..], "", "") catch { -1 }
        if code == 0 {
            let m = process.last_stdout()
            if m[..].trim() == "arm64" or m[..].trim() == "aarch64" { arch = "aarch64" }
        }
    }
    return format("{}-{}", .{arch, host})
}

/// Copy a directory tree.
fn copy_dir(from: []u8, to: []u8) -> !void {
    try fs.make_dirs(to)
    for name in try fs.list(from) {
        let src = fs.join(from, name[..])
        let dst = fs.join(to, name[..])
        if fs.is_dir(src[..]) { try copy_dir(src[..], dst[..]) } else { try fs.copy(src[..], dst[..]) }
    }
}

/// `nx ship`: every artifact the program declares (specification 15).
fn cmd_ship(o: *Opts) -> i32 {
    var c = check_program(o) orelse return 1
    // the artifacts, from the parse trees of the program's own modules
    var arts = List(usize).new()
    var art_mods = List(usize).new()
    let n_mods = c.mods.len
    for m in 0..n_mods {
        if c.mods[m].name[..].starts_with("std.") or c.mods[m].name[..].starts_with("cimport:") { continue }
        for it in c.mods[m].parsed.items.clone() {
            if c.node(m, it).k == parser.NodeKind.Artifact { arts.append(it); art_mods.append(m) }
        }
    }
    if arts.len == 0 {
        eprintln("error: no `artifact` declarations found; declare e.g. `artifact cabi {{ name = \"mylib\" }}` or `artifact python {{ name = \"mylib\" }}`", .{})
        return 1
    }
    let stem = stem_of(o.file[..])
    var produced = List(String).new()
    var lib_arts = List(usize).new()
    var cli_arts = List(usize).new()
    var installer_art = NONE
    for a, i in arts {
        let kind = c.node(art_mods[i], a).name.clone()
        if kind == "cabi" or kind == "python" or kind == "shared" or kind == "rustlib" or kind == "node" { lib_arts.append(i) }
        else if kind == "cli" or kind == "app" { cli_arts.append(i) }
        else if kind == "installer" { installer_art = i }
        else if kind != "lib" and kind != "link" {
            eprintln("note: artifact `{}` is not produced by this version of nx (supported: cabi, python, node, rustlib, shared, cli, installer); skipped", .{kind})
        }
    }
    if installer_art != NONE and cli_arts.len == 0 {
        eprintln("error: `artifact installer` needs an `artifact cli {{ name = ... }}` to install", .{})
        return 1
    }
    let target = if o.target.len > 0 { o.target.clone() } else { host_target() }
    let windows = is_windows_target(o.target[..])
    let macos = is_macos_target(o.target[..])
    let ship_mode = if o.mode == cgen.MODE_DEBUG { cgen.MODE_SAFE } else { o.mode }
    if lib_arts.len > 0 {
        var lib_name = String.new()
        var version = String.new()
        var has_python = false
        var has_node = false
        var has_rust = false
        var py_name = String.new()
        var npm_name = String.new()
        for i in lib_arts {
            let a = arts[i]
            let m = art_mods[i]
            let kind = c.node(m, a).name.clone()
            if lib_name.len == 0 { lib_name = artifact_str(&c, m, a, "name") }
            if version.len == 0 { version = artifact_str(&c, m, a, "version") }
            if kind == "python" { has_python = true; if py_name.len == 0 { py_name = artifact_str(&c, m, a, "name") } }
            if kind == "node" { has_node = true; if npm_name.len == 0 { npm_name = artifact_str(&c, m, a, "name") } }
            if kind == "rustlib" { has_rust = true }
        }
        if lib_name.len == 0 { lib_name = String.from(stem) }
        if version.len == 0 { version = String.from("0.1.0") }
        var any_export = false
        for i in 0..c.insts.len { if c.insts[i].export_name != "-" { any_export = true } }
        if !any_export {
            eprintln("error: library artifacts need at least one `export(c)` function", .{})
            return 1
        }
        var infos = List(cgen.ExportInfo).new()
        let text = emit_with(&mut c, o, cgen.ENTRY_LIBRARY, lib_name[..], ship_mode, &mut infos)
        if text.len == 0 { return 1 }
        let dir = format("{}/{}", .{o.out_dir, lib_name})
        fs.make_dirs(dir[..]) catch {
            eprintln("error: cannot create {}", .{dir})
            return 1
        }
        let c_path = format("{}/{}.c", .{dir, lib_name})
        io.write_file(c_path[..], text[..]) catch {
            eprintln("error: cannot write {}", .{c_path})
            return 1
        }
        // the runtime header next to the C, as write_c does
        let rt = format("{}/nx_rt.h", .{dir})
        io.write_file(rt[..], cgen.RUNTIME_H) catch { }
        let h_path = format("{}/{}.h", .{dir, lib_name})
        io.write_file(h_path[..], ship.c_header(lib_name[..], &infos)[..]) catch { }
        let shared_name = if windows { format("{}.dll", .{lib_name}) } else if macos { format("lib{}.dylib", .{lib_name}) } else { format("lib{}.so", .{lib_name}) }
        let shared_path = format("{}/{}", .{dir, shared_name})
        var lib_opts = clone_opts(o)
        lib_opts.mode = ship_mode
        lib_opts.keep_c = true
        // the shared library is built in its own directory: on Windows the linker also
        // writes an import library named <name>.lib there, which must not be confused
        // with the static archive produced below
        let shared_dir = format("{}/shared", .{dir})
        fs.make_dirs(shared_dir[..]) catch { }
        let shared_build = format("{}/{}", .{shared_dir, shared_name})
        if !compile_c(&c, &lib_opts, c_path[..], shared_build[..], "shared") { return 1 }
        fs.copy(shared_build[..], shared_path[..]) catch {
            eprintln("error: cannot place {}", .{shared_path})
            return 1
        }
        produced.append(shared_path.clone())
        // static object; on Windows it targets the MSVC ABI so Rust and MSVC users can link it
        let obj_path = format("{}/{}.{}", .{dir, lib_name, if windows { "obj" } else { "o" }})
        if windows and o.target.len == 0 and o.cc_source != 1 and o.cc_source != 2 { lib_opts.target = String.from("x86_64-windows-msvc") }
        if compile_c(&c, &lib_opts, c_path[..], obj_path[..], "object") {
            let ar_path = format("{}/{}", .{dir, if windows { format("{}.lib", .{lib_name}) } else { format("lib{}.a", .{lib_name}) }})
            io.remove_file(ar_path[..]) catch { }
            var argv = List([]u8).new()
            let is_zig = o.cc[0] == "zig" or o.cc[0][..].ends_with("zig") or o.cc[0][..].ends_with("zig.exe")
            if is_zig { argv.append(o.cc[0][..]); argv.append("ar") } else { argv.append("ar") }
            argv.append("rcs")
            argv.append(ar_path[..])
            argv.append(obj_path[..])
            let code = process.run(argv[..]) catch { -1 }
            if code == 0 { produced.append(ar_path) }
        }
        produced.append(h_path.clone())
        if has_rust {
            let ar_name = if windows { format("{}.lib", .{lib_name}) } else { format("lib{}.a", .{lib_name}) }
            let crate_dir = format("{}/rust", .{dir})
            fs.make_dirs(format("{}/src", .{crate_dir})[..]) catch { }
            fs.make_dirs(format("{}/lib", .{crate_dir})[..]) catch { }
            fs.copy(format("{}/{}", .{dir, ar_name})[..], format("{}/lib/{}", .{crate_dir, ar_name})[..]) catch { }
            for f in ship.rust_crate(lib_name[..], version[..], &infos, ar_name[..]) {
                let p = format("{}/{}", .{crate_dir, f.path})
                io.write_file(p[..], f.text[..]) catch {
                    eprintln("error: cannot write {}", .{p})
                    return 1
                }
            }
            produced.append(format("{}/Cargo.toml", .{crate_dir}))
        }
        if has_python {
            if py_name.len == 0 { py_name = lib_name.clone() }
            var pyn = String.new()
            for ch in py_name { pyn.push_byte(if ch == '-' { '_' } else { ch }) }
            let pkg_dir = format("{}/python/{}", .{dir, pyn})
            fs.make_dirs(pkg_dir[..]) catch {
                eprintln("error: cannot create {}", .{pkg_dir})
                return 1
            }
            let module = ship.python_module(lib_name[..], version[..], &infos, shared_name[..])
            io.write_file(format("{}/__init__.py", .{pkg_dir})[..], module[..]) catch { }
            let stub = ship.python_stub(&infos)
            io.write_file(format("{}/__init__.pyi", .{pkg_dir})[..], stub[..]) catch { }
            io.write_file(format("{}/py.typed", .{pkg_dir})[..], "") catch { }
            let lib_bytes = io.read_file(shared_path[..]) catch { String.new() }
            io.write_file(format("{}/{}", .{pkg_dir, shared_name})[..], lib_bytes[..]) catch { }
            io.write_file(format("{}/python/pyproject.toml", .{dir})[..], format("[project]\nname = \"{}\"\nversion = \"{}\"\nrequires-python = \">=3.8\"\n\n[build-system]\nrequires = [\"setuptools\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools]\npackages = [\"{}\"]\n\n[tool.setuptools.package-data]\n\"{}\" = [\"*.dll\", \"*.so\", \"*.dylib\", \"*.pyi\", \"py.typed\"]\n", .{pyn, version, pyn, pyn})[..]) catch { }
            var files = List(ship.ZipEntry).new()
            files.append(ship.ZipEntry{ .name = format("{}/__init__.py", .{pyn}), .data = module })
            files.append(ship.ZipEntry{ .name = format("{}/__init__.pyi", .{pyn}), .data = stub })
            files.append(ship.ZipEntry{ .name = format("{}/py.typed", .{pyn}), .data = String.new() })
            files.append(ship.ZipEntry{ .name = format("{}/{}", .{pyn, shared_name}), .data = lib_bytes })
            var wheel_name = String.new()
            let wheel = ship.build_wheel(pyn[..], version[..], ship.platform_tag(target[..]), &files, format("{} (built with Nexium)", .{pyn})[..], &mut wheel_name)
            let wheel_path = format("{}/{}", .{dir, wheel_name})
            io.write_file(wheel_path[..], wheel[..]) catch {
                eprintln("error: cannot write wheel: {}", .{wheel_path})
                return 1
            }
            produced.append(wheel_path)
        }
        if has_node {
            if npm_name.len == 0 { npm_name = lib_name.clone() }
            let pkg_dir = format("{}/node", .{dir})
            fs.make_dirs(pkg_dir[..]) catch {
                eprintln("error: cannot create {}", .{pkg_dir})
                return 1
            }
            io.write_file(format("{}/index.js", .{pkg_dir})[..], ship_node.module(lib_name[..], version[..], &infos, shared_name[..])[..]) catch { }
            io.write_file(format("{}/index.d.ts", .{pkg_dir})[..], ship_node.typings(&infos)[..]) catch { }
            let os_name = if windows { "win32" } else if macos { "darwin" } else { "linux" }
            let cpu = if target[..].starts_with("aarch64") { "arm64" } else { "x64" }
            io.write_file(format("{}/package.json", .{pkg_dir})[..], ship_node.package_json(npm_name[..], version[..], shared_name[..], os_name, cpu)[..]) catch { }
            io.write_file(format("{}/README.md", .{pkg_dir})[..], format("# {}\n\nA native library built with Nexium, callable from Node.js through koffi.\n\n```sh\nnpm install\nnode -e \"const m = require('.'); console.log(Object.keys(m))\"\n```\n\nThe package holds one platform's shared library; publish one per platform or\nuse `os` and `cpu` fields to gate installs.\n", .{npm_name})[..]) catch { }
            fs.copy(shared_path[..], format("{}/{}", .{pkg_dir, shared_name})[..]) catch {
                eprintln("error: cannot place the library in {}", .{pkg_dir})
                return 1
            }
            produced.append(format("{}/package.json", .{pkg_dir}))
        }
    }
    if cli_arts.len > 0 {
        var name = String.new()
        for i in cli_arts { if name.len == 0 { name = artifact_str(&c, art_mods[i], arts[i], "name") } }
        if name.len == 0 { name = String.from(stem) }
        var co = clone_opts(o)
        co.mode = ship_mode
        co.out_dir = format("{}/{}", .{o.out_dir, name})
        co.out = format("{}/{}", .{co.out_dir, exe_name(name[..], o.target[..])})
        co.keep_c = false
        fs.make_dirs(co.out_dir[..]) catch { }
        var exe_path = String.new()
        if !cmd_build(&co, false, &mut exe_path) { return 1 }
        produced.append(exe_path.clone())
        if installer_art != NONE {
            let ia = arts[installer_art]
            let im = art_mods[installer_art]
            // the program's files sit next to the executable so the installer templates can list them
            let src_dir = dir_of(o.file[..])
            var iname = artifact_str(&c, im, ia, "name")
            if iname.len == 0 { iname = name.clone() }
            var iversion = artifact_str(&c, im, ia, "version")
            if iversion.len == 0 { iversion = String.from("0.1.0") }
            let spec = installer.Spec{
                .name = iname, .exe = exe_name(name[..], o.target[..]), .version = iversion,
                .publisher = artifact_str(&c, im, ia, "publisher"), .url = artifact_str(&c, im, ia, "url"),
                .license = artifact_str(&c, im, ia, "license"), .readme = artifact_str(&c, im, ia, "readme"),
                .files = artifact_list(&c, im, ia, "files"), .add_to_path = artifact_bool(&c, im, ia, "add_to_path"),
            }
            let out_dir = co.out_dir.clone()
            var to_copy = spec.files.clone()
            if spec.readme.len > 0 { to_copy.append(spec.readme.clone()) }
            if spec.license.len > 0 { to_copy.append(spec.license.clone()) }
            for f in to_copy {
                let from = fs.join(src_dir, f[..])
                let to = fs.join(out_dir[..], f[..])
                if fs.is_dir(from[..]) {
                    copy_dir(from[..], to[..]) catch {
                        eprintln("error: cannot copy {}", .{from})
                        return 1
                    }
                } else if fs.exists(from[..]) {
                    fs.make_dirs(fs.parent(to[..])) catch { }
                    fs.copy(from[..], to[..]) catch {
                        eprintln("error: cannot copy {}", .{from})
                        return 1
                    }
                } else {
                    eprintln("error: installer file `{}` not found next to {}", .{f, o.file})
                    return 1
                }
            }
            let files = installer.produce(&spec, exe_path[..], windows, macos) catch { return 1 }
            for f in files { produced.append(f.clone()) }
        }
    }
    println("shipped {} artifact file(s) for {}:", .{produced.len, target})
    for p in produced { println("  {}", .{p}) }
    return 0
}

fn cmd_version() -> i32 {
    println("nx {} ({})", .{VERSION, RELEASE_NAME})
    return 0
}

/// `nx doctor`: the installation as this binary sees it.
fn cmd_doctor(o: *Opts) -> i32 {
    println("nx {} ({})", .{VERSION, RELEASE_NAME})
    var exe = os.exe_path()
    if exe.len == 0 { let args = os.args(); exe = absolute(args[0]) }
    println("executable:  {}", .{exe})
    let portable = portable_dir()
    if portable.len > 0 { println("portable:    yes; Zig's cache lives under {}/cache, and `nx install` puts this copy in place for the user", .{portable}) }
    var shown = String.new()
    for a, i in o.cc { if i > 0 { shown.append(" ") }; shown.append(a[..]) }
    println("C compiler:  {}  ({})", .{shown, cc_why(o)})
    let cpu_note = if o.cpu[..] == "baseline" { "the architecture's baseline, runs on any machine of it; --cpu native for this machine's" } else if o.cpu[..] == "native" { "this machine's; the binary may not run on another" } else { "as given" }
    println("cpu:         {} on {}  ({})", .{o.cpu, os.arch(), cpu_note})
    var probe = List([]u8).new()
    probe.append(o.cc[0][..])
    let is_zig = o.cc[0][..].ends_with("zig") or o.cc[0][..].ends_with("zig.exe")
    probe.append(if is_zig { "version" } else { "--version" })
    var ok = false
    let code = os.exec(probe[..], "", "") catch { -1 }
    if code == 0 {
        let out = os.last_stdout()
        var first = String.new()
        for line in out[..].lines() { if first.len == 0 { first = String.from(line.trim()) } }
        println("             {}", .{first})
        ok = true
    } else if code < 0 {
        println("             not found", .{})
    } else {
        let err = os.last_stderr()
        var first = String.new()
        for line in err[..].lines() { if first.len == 0 { first = String.from(line.trim()) } }
        println("             does not run: {}", .{first})
    }
    println("std modules: {}", .{check.STD_MODULE_NAMES})
    let dir = dir_of(exe[..])
    var on_path = false
    if let path = os.env("PATH") {
        let sep = if is_windows_target("") { ";" } else { ":" }
        for d in path.split(sep) { if d == dir { on_path = true } }
    }
    println("on PATH:     {}", .{if on_path { "yes" } else { "no (add the executable's directory to PATH to run `nx` from anywhere)" }})
    if !ok {
        println("", .{})
        println("no working C compiler. Options:", .{})
        println("  - Windows: run the installer from https://github.com/Londopy/nexium/releases (it bundles Zig)", .{})
        println("  - macOS:   xcode-select --install", .{})
        println("  - Linux:   the install script (installers/install.sh) downloads Zig, or install zig, gcc or clang (nx takes cc, gcc or clang when there is no zig)", .{})
        println("  - any:     put zig on the PATH, or set NX_ZIG=/path/to/zig or NX_CC=gcc", .{})
        return 1
    }
    // the answer that matters: a program goes through the checker, the C
    // emitter, the C compiler, the linker, and runs. 1.0.1's doctor said
    // "everything works" on a machine where the compiler could not compile a
    // line, because it had only asked the C compiler for its version.
    if !doctor_smoke(o) { return 1 }
    doctor_updates()
    println("", .{})
    println("everything works. Try: nx run examples/hello.nx", .{})
    return 0
}

/// Whether a newer release exists: curl asks the GitHub API (TLS is curl's;
/// std.http speaks plain http only), three seconds at most, and the answer
/// is one line. NX_OFFLINE=1 skips the question; no curl or no answer is
/// reported, never an error.
fn doctor_updates() {
    if os.env("NX_OFFLINE") != null {
        println("latest release: not checked (NX_OFFLINE is set)", .{})
        return
    }
    var auth = String.new()
    var argv = github_api_argv("3", &mut auth)
    let code = os.exec(argv[..], "", "") catch { -1 }
    if code != 0 {
        let why = if code < 0 { "curl is not on the PATH" } else { "no answer from api.github.com in 3 s" }
        println("latest release: not checked ({}; NX_OFFLINE=1 skips the check)", .{why})
        return
    }
    let out = os.last_stdout()
    let tag = json_string(out[..], "tag_name") orelse {
        println("latest release: not checked (unexpected answer from api.github.com)", .{})
        return
    }
    let latest = if tag.starts_with("v") { tag[1..] } else { tag }
    var cache = read_update_cache(update_cache_path()[..])
    cache.checked = time.now() / 1000
    cache.latest = String.from(latest)
    write_update_cache(update_cache_path()[..], &cache)
    let c = compare_versions(latest, VERSION)
    if c > 0 {
        println("latest release: {}; this is {}, and `nx upgrade` installs it", .{tag, VERSION})
    } else if c == 0 {
        println("latest release: {}, this one", .{tag})
    } else {
        println("latest release: {}; this is {}, ahead of it", .{tag, VERSION})
    }
}

/// Where `nx topo` keeps what is done: NX_TOPO_PROGRESS, or `topo-progress`
/// beside the update cache.
fn topo_progress_path() -> String {
    if let p = os.env("NX_TOPO_PROGRESS") { return String.from(p) }
    let cache = update_cache_path()
    if cache.len == 0 { return String.new() }
    return fs.join(fs.parent(cache[..]), "topo-progress")
}

/// Where the daily release check keeps its answer: NX_UPDATE_CACHE, the
/// portable copy's cache directory, or the user's Nexium directory.
fn update_cache_path() -> String {
    if let p = os.env("NX_UPDATE_CACHE") { return String.from(p) }
    let portable = portable_dir()
    if portable.len > 0 { return format("{}/cache/update-check", .{portable}) }
    if host_os() == "windows" {
        let la = os.env("LOCALAPPDATA") orelse return String.new()
        return format("{}\\Nexium\\update-check", .{la})
    }
    let home = os.env("HOME") orelse return String.new()
    return format("{}/.nexium/update-check", .{home})
}

/// When the release was last asked for and last named, in seconds since
/// 1970, and the version the answer named ("" for none yet).
struct UpdateCache {
    checked: i64
    noticed: i64
    latest: String
}

fn read_update_cache(path: []u8) -> UpdateCache {
    var c = UpdateCache{ .checked = 0, .noticed = 0, .latest = String.new() }
    if path.len == 0 { return c }
    let text = io.read_file(path) catch { return c }
    for line in text[..].lines() {
        let t = line.trim()
        if t.len > 8 and t[..8] == "checked " { c.checked = t[8..].parse_int(i64) catch { 0 } }
        else if t.len > 8 and t[..8] == "noticed " { c.noticed = t[8..].parse_int(i64) catch { 0 } }
        else if t.len > 7 and t[..7] == "latest " { c.latest = String.from(t[7..]) }
    }
    return c
}

fn write_update_cache(path: []u8, c: *UpdateCache) {
    if path.len == 0 { return }
    fs.make_dirs(dir_of(path)[..]) catch { return }
    io.write_file(path, format("checked {}\nnoticed {}\nlatest {}\n", .{c.checked, c.noticed, c.latest})[..]) catch { }
}

/// The latest release's version from the GitHub API (curl, as the doctor
/// asks), or null when curl or the network does not answer in `seconds`.
fn latest_release(seconds: []u8) -> ?String {
    var auth = String.new()
    var argv = github_api_argv(seconds, &mut auth)
    let code = os.exec(argv[..], "", "") catch { -1 }
    if code != 0 { return null }
    let out = os.last_stdout()
    let tag = json_string(out[..], "tag_name") orelse return null
    return String.from(if tag.starts_with("v") { tag[1..] } else { tag })
}

/// Once a day, after a command has done its work: is there a newer release?
/// The answer is kept in the update cache, and a newer release is named on
/// stderr once a day with the way to get it. NX_NO_UPDATE_CHECK=1 silences
/// the question and the notice; NX_OFFLINE=1 and a CI variable skip the
/// question but not a cached answer; nothing is asked more than once a day,
/// answer or not, so a machine without curl asks once and is quiet.
fn update_notice() {
    if let off = os.env("NX_NO_UPDATE_CHECK") { if off.len > 0 { return } }
    let path = update_cache_path()
    var c = read_update_cache(path[..])
    let now = time.now() / 1000
    let day: i64 = 86400
    if os.env("NX_OFFLINE") == null and os.env("CI") == null and now - c.checked >= day {
        c.checked = now
        if let v = latest_release("2") { c.latest = v }
        write_update_cache(path[..], &c)
    }
    if c.latest.len > 0 and compare_versions(c.latest[..], VERSION) > 0 and now - c.noticed >= day {
        eprintln("nx {} is available (this is {}): `nx upgrade` installs it; https://github.com/Londopy/nexium/releases/latest", .{c.latest, VERSION})
        c.noticed = now
        write_update_cache(path[..], &c)
    }
}

/// The newer release the cache already names, for the REPL's banner; it
/// never asks.
fn cached_newer_release() -> ?String {
    if let off = os.env("NX_NO_UPDATE_CHECK") { if off.len > 0 { return null } }
    let c = read_update_cache(update_cache_path()[..])
    if c.latest.len > 0 and compare_versions(c.latest[..], VERSION) > 0 { return c.latest.clone() }
    return null
}

/// `nx upgrade`: the latest release for this machine in place of the
/// running executable. The GitHub API names the release (through curl, as
/// the doctor asks it), the archive is downloaded and verified against the
/// release's SHA256SUMS.txt with the machine's own checksum tool, unpacked
/// with tar (bsdtar on Windows reads the zip too), and moved over the
/// executable: a running program may be renamed, so the old one is set
/// aside as `nx.exe.old` and removed by the next upgrade. A bundled Zig, the
/// examples and the docs next to nx are left as they are. `--check` only
/// reports; NX_OFFLINE=1 refuses.
fn cmd_upgrade(check_only: bool) -> i32 {
    let exe = os.exe_path()
    if exe.len == 0 {
        eprintln("error: cannot find the running executable", .{})
        return 1
    }
    let old = format("{}.old", .{exe})
    if fs.exists(old[..]) { fs.remove(old[..]) catch { } }
    if os.env("NX_OFFLINE") != null {
        eprintln("error: NX_OFFLINE is set; nx upgrade needs the network", .{})
        return 1
    }
    var auth = String.new()
    var api = github_api_argv("10", &mut auth)
    let code = os.exec(api[..], "", "") catch { -1 }
    if code != 0 {
        let why = if code < 0 { "curl is not on the PATH" } else { "no answer from api.github.com" }
        eprintln("error: cannot ask for the latest release ({}); the releases are at https://github.com/Londopy/nexium/releases/latest", .{why})
        return 1
    }
    let body = os.last_stdout()
    let tag = String.from(json_string(body[..], "tag_name") orelse {
            eprintln("error: unexpected answer from api.github.com", .{})
            return 1
    })
    let latest = if tag[..].starts_with("v") { tag[1..] } else { tag[..] }
    let c = compare_versions(latest, VERSION)
    if c <= 0 {
        println("nx {} is the latest release{}", .{VERSION, if c < 0 { " (this build is ahead of it)" } else { "" }})
        return 0
    }
    println("latest release: {}; this is {}", .{tag, VERSION})
    if check_only {
        println("`nx upgrade` installs it", .{})
        return 0
    }
    let host = host_os()
    let arch = os.arch()
    let name = if host == "windows" { "nx.exe" } else { "nx" }
    var target = String.new()
    if host == "windows" { target = format("{}-pc-windows-msvc.zip", .{arch}) }
    else if host == "macos" { target = format("{}-apple-darwin.tar.gz", .{arch}) }
    else { target = format("{}-unknown-linux-gnu.tar.gz", .{arch}) }
    let asset = format("nx-{}-{}", .{tag, target})
    let base = format("https://github.com/Londopy/nexium/releases/download/{}", .{tag})
    let tmp = fs.temp_path("nx-upgrade")
    fs.make_dirs(tmp[..]) catch {
        eprintln("error: cannot create {}", .{tmp})
        return 1
    }
    let archive = fs.join(tmp[..], asset[..])
    println("downloading {}", .{asset})
    if !curl_to(format("{}/{}", .{base, asset})[..], archive[..]) {
        eprintln("error: no {} in release {}; the ways in are at https://londopy.github.io/nexium/docs/install.html", .{asset, tag})
        return 1
    }
    let sums = fs.join(tmp[..], "SHA256SUMS.txt")
    if !curl_to(format("{}/SHA256SUMS.txt", .{base})[..], sums[..]) {
        eprintln("error: SHA256SUMS.txt is missing from release {}", .{tag})
        return 1
    }
    let want = checksum_listed(sums[..], asset[..]) orelse {
        eprintln("error: no checksum for {} in SHA256SUMS.txt", .{asset})
        return 1
    }
    let got = sha256_of(archive[..]) orelse {
        eprintln("error: no checksum tool found (sha256sum, shasum or certutil); the archive is at {}", .{archive})
        return 1
    }
    if want[..] != got[..] {
        eprintln("error: checksum mismatch for {} (expected {}, got {})", .{asset, want, got})
        return 1
    }
    println("checksum ok", .{})
    let unpack = fs.join(tmp[..], "unpacked")
    fs.make_dirs(unpack[..]) catch { }
    let untar: [][]u8 = ["tar", "-xf", archive[..], "-C", unpack[..]]
    let tcode = os.exec(untar[..], "", "") catch { -1 }
    if tcode != 0 {
        eprintln("error: tar could not unpack {}", .{asset})
        return 1
    }
    let fresh = fs.join(unpack[..], name)
    if !fs.exists(fresh[..]) {
        eprintln("error: {} has no {}", .{asset, name})
        return 1
    }
    // the running executable is set aside, the new one takes its place; a
    // rename across volumes fails, so a copy that keeps the mode follows
    fs.rename(exe[..], old[..]) catch {
        eprintln("error: cannot replace {}: is it writable? The way it was installed (the installer, pip, npm, brew, scoop, winget) upgrades it too", .{exe})
        return 1
    }
    var placed = true
    fs.rename(fresh[..], exe[..]) catch { placed = false }
    if !placed {
        if host == "windows" {
            fs.copy(fresh[..], exe[..]) catch {
                fs.rename(old[..], exe[..]) catch { }
                eprintln("error: cannot move the new nx into {}", .{exe})
                return 1
            }
        } else {
            let cp: [][]u8 = ["cp", "-p", fresh[..], exe[..]]
            let ccode = os.exec(cp[..], "", "") catch { -1 }
            if ccode != 0 {
                fs.rename(old[..], exe[..]) catch { }
                eprintln("error: cannot move the new nx into {}", .{exe})
                return 1
            }
        }
    }
    fs.remove(old[..]) catch { }
    fs.remove_all(tmp[..]) catch { }
    println("upgraded to nx {} at {}; `nx version` in a new console shows it", .{tag, exe})
    return 0
}

/// curl's arguments for the latest-release query. A token from the
/// environment (GITHUB_TOKEN or GH_TOKEN, which a CI runner has) goes in
/// the header, since anonymous requests share a rate limit per address and
/// a runner's is often spent; `auth` keeps the header alive for the call.
fn github_api_argv(seconds: []u8, auth: *mut String) -> List([]u8) {
    var argv = List([]u8).new()
    for a in ["curl", "-fsSL", "-m"] { argv.append(a) }
    argv.append(seconds)
    argv.append("-H")
    argv.append("Accept: application/vnd.github+json")
    if let t = os.env("GITHUB_TOKEN") {
        auth.*= format("Authorization: Bearer {}", .{t})
    } else if let t = os.env("GH_TOKEN") {
        auth.*= format("Authorization: Bearer {}", .{t})
    }
    if auth.len > 0 {
        argv.append("-H")
        argv.append(auth.*[..])
    }
    argv.append("https://api.github.com/repos/Londopy/nexium/releases/latest")
    return argv
}

/// Download a URL to a file with curl (two minutes at most); false on failure.
fn curl_to(url: []u8, path: []u8) -> bool {
    let argv: [][]u8 = ["curl", "-fsSL", "-m", "120", "-o", path, url]
    let code = os.exec(argv[..], "", "") catch { -1 }
    return code == 0
}

/// The checksum a SHA256SUMS.txt lists for a file, lowercased.
fn checksum_listed(sums_path: []u8, asset: []u8) -> ?String {
    let text = fs.read(sums_path) catch { return null }
    for line in text[..].lines() {
        let t = line.trim()
        if t.len < 66 or !t.ends_with(asset) { continue }
        let rest = t[64..].trim()
        if rest != asset { continue }
        return strings.to_lower(t[0..64])
    }
    return null
}

/// The SHA-256 of a file, by the first checksum tool the machine has.
fn sha256_of(path: []u8) -> ?String {
    let s1: [][]u8 = ["sha256sum", path]
    if (os.exec(s1[..], "", "") catch { -1 }) == 0 {
        let out = os.last_stdout()
        for w in out[..].split(" ") { if w.len == 64 { return strings.to_lower(w) } }
    }
    let s2: [][]u8 = ["shasum", "-a", "256", path]
    if (os.exec(s2[..], "", "") catch { -1 }) == 0 {
        let out = os.last_stdout()
        for w in out[..].split(" ") { if w.len == 64 { return strings.to_lower(w) } }
    }
    let s3: [][]u8 = ["certutil", "-hashfile", path, "SHA256"]
    if (os.exec(s3[..], "", "") catch { -1 }) == 0 {
        // the hash is the second line; older versions space the bytes
        let out = os.last_stdout()
        var n: usize = 0
        for line in out[..].lines() {
            n += 1
            if n != 2 { continue }
            var hex = String.new()
            for c in line.trim() { if c != ' ' { hex.push_byte(c) } }
            if hex.len == 64 { return strings.to_lower(hex[..]) }
        }
    }
    return null
}

/// The string value of a key in a JSON text, by the first `"key"` in it.
fn json_string(text: []u8, key: []u8) -> ?[]u8 {
    let quoted = format("\"{}\"", .{key})
    let i = text.find(quoted[..]) orelse return null
    let rest = text[i + quoted.len..]
    let q1 = rest.find("\"") orelse return null
    let after = rest[q1 + 1..]
    let q2 = after.find("\"") orelse return null
    return after[0..q2]
}

/// Numeric comparison of dotted versions: negative, zero or positive.
fn compare_versions(a: []u8, b: []u8) -> i32 {
    let pa = a.split(".")
    let pb = b.split(".")
    for k in 0..3 {
        let x = if k < pa.len { pa[k].parse_int(u64) catch { 0 } } else { 0 }
        let y = if k < pb.len { pb[k].parse_int(u64) catch { 0 } } else { 0 }
        if x < y { return -1 }
        if x > y { return 1 }
    }
    return 0
}

/// Build and run a one-line program in the temporary directory and report.
fn doctor_smoke(o: *Opts) -> bool {
    let dir = fs.join(fs.temp_dir()[..], "nx-doctor")
    fs.make_dirs(dir[..]) catch { }
    let src = fs.join(dir[..], "probe.nx")
    io.write_file(src[..], "fn main() { println(\"nx doctor: ok\", .{}) }\n") catch {
        println("smoke test:  cannot write to {}", .{dir})
        return false
    }
    var p = clone_opts(o)
    p.command = String.from("run")
    p.file = src.clone()
    p.out_dir = dir.clone()
    p.out = String.new()
    var exe = String.new()
    if !cmd_build(&mut p, true, &mut exe) {
        println("smoke test:  FAILED: the probe program did not compile (the diagnostics above say why)", .{})
        return false
    }
    var argv = List([]u8).new()
    argv.append(exe[..])
    let code = os.exec(argv[..], "", "") catch { -1 }
    let out = os.last_stdout()
    io.remove_file(exe[..]) catch { }
    io.remove_file(src[..]) catch { }
    if code == 0 and out[..].find("nx doctor: ok") != null {
        println("smoke test:  a program compiles and runs (checker, C emitter, C compiler, linker, executable)", .{})
        return true
    }
    println("smoke test:  FAILED: the compiled program exited with {}", .{code})
    if code == -1073741795 or code == 132 or code == -4 {
        println("             an illegal instruction: the C compiler built it for another CPU (see docs/install.md, \"Which CPU a binary is built for\"; try NX_CPU=baseline)", .{})
    } else {
        println("             {}", .{os.last_stderr()[..].trim()})
    }
    return false
}

/// The C compiler and why it is the one, for the REPL banner: "zig via NX_ZIG".
fn compiler_summary(o: *Opts) -> String {
    var base = String.from(if o.cc.len > 0 { o.cc[0][..] } else { "zig" })
    let stem = stem_of(base[..])
    if stem.len > 0 { base = String.from(stem) }
    let why = cc_why(o)
    if why.starts_with(base[..]) { return String.from(why) }
    return format("{} via {}", .{base, why})
}

/// The host operating system, as the REPL banner names it.
/// The CPU flag for a build without --target: none for `native` (what the
/// C compiler does on its own), otherwise the baseline of the architecture
/// by default. Zig spells it `-mcpu=baseline` on every architecture and
/// takes its own CPU names (`x86_64_v3`); gcc and clang take `-march`, and
/// their baseline for x86-64 is `-march=x86-64`.
fn march_flag(o: *Opts) -> ?String {
    if o.cpu[..] == "native" { return null }
    if uses_zig(o) { return format("-mcpu={}", .{o.cpu}) }
    if o.cpu[..] == "baseline" {
        if os.arch() == "x86_64" { return String.from("-march=x86-64") }
        return null
    }
    return format("-march={}", .{o.cpu})
}

/// Whether the C compiler the driver runs is `zig cc` (by choice, by
/// `NX_ZIG`, bundled, or named in `--cc`/`NX_CC`).
fn uses_zig(o: *Opts) -> bool {
    if o.cc_source == 0 or o.cc_source == 3 or o.cc_source == 5 { return true }
    if o.cc.len > 0 and (o.cc[0][..].ends_with("zig") or o.cc[0][..].ends_with("zig.exe")) { return true }
    return false
}

fn host_os() -> []u8 {
    if is_windows_target("") { return "windows" }
    if is_macos_target("") { return "macos" }
    return "linux"
}

/// Why the driver runs the C compiler it runs, for `nx doctor`.
fn cc_why(o: *Opts) -> []u8 {
    if o.cc_source == 1 { return "--cc" }
    if o.cc_source == 2 { return "NX_CC" }
    if o.cc_source == 3 { return "NX_ZIG" }
    if o.cc_source == 4 { return "system compiler (macOS)" }
    if o.cc_source == 5 { return "bundled with nx" }
    if o.cc_source == 6 { return "the system compiler on the PATH, no zig found" }
    return "zig on PATH"
}

fn cmd_tir(o: *Opts) -> i32 {
    let mods = check.load(o.file[..], o.std_dir[..]) catch { return 1 }
    var c = check.new_checker(mods)
    c.cc = o.cc.clone()
    c.target = o.target.clone()
    c.collect()
    c.reserve_errors()
    var out = String.new()
    if o.sigs {
        c.resolve_globals()
        c.print_sigs(&mut out)
    } else {
        c.check_program()
        c.print_program(&mut out)
    }
    print("{}", .{out})
    check.print_errors(&c.errors)
    if c.errors.len > 0 { return 1 }
    return 0
}

fn main() -> u8 {
    var args = os.args()
    apply_portable()
    // like `python`: no arguments at a terminal opens the REPL (`padded` lives
    // as long as `args` does: a view into a local of the block would dangle)
    var padded = List([]u8).new()
    if args.len == 1 and io.is_terminal(1) {
        padded.append(args[0])
        padded.append("repl")
        args = padded[..]
    }
    if args.len == 2 and args[1] == "install" or args.len == 3 and args[1] == "install" {
        let c = cmd_install(if args.len == 3 { args[2] } else { "" })
        return (if c < 0 or c > 255 { 1 } else { c }) as u8
    }
    if args.len >= 2 and (args[1] == "init" or args[1] == "add" or args[1] == "fetch" or args[1] == "update") {
        let rest = args[2..]
        var none = List([]u8).new()
        let c = if args[1] == "init" { cmd_init(rest) } else if args[1] == "add" { cmd_add(rest) } else if args[1] == "update" { cmd_fetch(rest, rest.len == 0) } else { cmd_fetch(none[..], false) }
        return (if c < 0 or c > 255 { 1 } else { c }) as u8
    }
    let o = parse_opts(args) orelse {
        usage()
        return 2
    }
    // the commands that do work get the daily word on a newer release; the
    // ones that are about the release, the editor's server and the one-liners do not
    let quiet = o.command == "upgrade" or o.command == "doctor" or o.command == "lsp" or o.command == "repl" or o.command == "-e" or o.command == "-p" or o.command == "version" or o.command == "--version" or o.command == "-V" or o.command == "topo"
    var code: i32 = 0
    if o.command == "build" {
        var out = String.new()
        code = if cmd_build(&o, false, &mut out) { 0 } else { 1 }
        if code == 0 { println("built {}", .{out}) }
    } else if o.command == "run" {
        code = cmd_run(&o)
    } else if o.command == "test" {
        code = cmd_test(&o)
    } else if o.command == "check" {
        code = cmd_check(&o)
    } else if o.command == "emit-c" {
        code = cmd_emit_c(&o)
    } else if o.command == "tir" {
        code = cmd_tir(&o)
    } else if o.command == "fix" {
        code = cmd_fix(&o)
    } else if o.command == "fmt" {
        code = cmd_fmt(&o)
    } else if o.command == "effects" {
        code = cmd_effects(&o)
    } else if o.command == "audit" {
        code = cmd_audit(&o)
    } else if o.command == "refcounts" {
        code = cmd_refcounts(&o)
    } else if o.command == "doc" {
        code = cmd_doc(&o)
    } else if o.command == "ship" {
        var so = o
        var mode_given = false
        for a in args { if a == "--mode" { mode_given = true } }
        if !mode_given { so.mode = cgen.MODE_SAFE }
        code = cmd_ship(&so)
    } else if o.command == "layout" {
        code = cmd_layout(&o)
    } else if o.command == "explain" {
        if o.rest.len != 2 {
            eprintln("usage: nx explain <file.nx> <function> <effect>", .{})
            code = 2
        } else {
            var c = check_program(&o) orelse return 1
            code = if tools.explain(&mut c, o.rest[0][..], o.rest[1][..]) { 0 } else { 1 }
        }
    } else if o.command == "size" {
        var so = o
        var mode_given = false
        for a in args { if a == "--mode" { mode_given = true } }
        if !mode_given { so.mode = cgen.MODE_SMALL }
        code = cmd_size(&so)
    } else if o.command == "leaks" {
        var lo = o
        lo.mode = cgen.MODE_DEBUG
        lo.defines.append(String.from("NX_LEAK_CHECK"))
        code = cmd_run(&lo)
    } else if o.command == "version" or o.command == "--version" or o.command == "-V" {
        code = cmd_version()
    } else if o.command == "doctor" {
        code = cmd_doctor(&o)
    } else if o.command == "lsp" {
        lsp.run(VERSION, o.std_dir[..], &o.cc)
        code = 0
    } else if o.command == "repl" {
        let newer = cached_newer_release() orelse String.new()
        code = repl.run(VERSION, compiler_summary(&o)[..], host_os()[..], o.std_dir[..], &o.cc, newer[..])
    } else if o.command == "-e" or o.command == "-p" {
        code = repl.eval(o.file[..], o.command == "-p", o.std_dir[..], &o.cc)
    } else if o.command == "upgrade" {
        code = cmd_upgrade(o.file[..] == "--check")
    } else if o.command == "topo" {
        // the words after `topo`: the chapter or the subcommand, then its arguments
        var words = List([]u8).new()
        if o.file.len > 0 { words.append(o.file[..]) }
        for r in o.rest { words.append(r[..]) }
        code = topo.run(words[..], os.exe_path()[..], topo_progress_path()[..])
    } else {
        usage()
        return 2
    }
    if !quiet { update_notice() }
    return (if code < 0 or code > 255 { 1 } else { code }) as u8
}
