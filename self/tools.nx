// The reporting commands of `nx`: `effects`, `audit`, `refcounts`. Each
// reads the checked program and prints what the first compiler's commands
// printed, so the two can be compared while the Rust one exists.

import parser
import check

/// `nx effects`: every function with a body, its signature and its inferred
/// effects, in declaration order.
pub fn effects(c: *mut check.Checker) {
    var rows = List(String).new()
    var locs = List(String).new()
    let n = c.insts.len
    for i in 0..n {
        if c.insts[i].body == parser.NONE or c.insts[i].is_closure or c.insts[i].is_test { continue }
        var params = String.new()
        let ps = c.insts[i].params.clone()
        for p, pi in ps {
            if pi > 0 { params.append(", ") }
            let l = &c.insts[i].locals[p]
            params.append(format("{}: {}", .{l.name, c.ty_name(l.ty)})[..])
        }
        let ret = c.ty_name(c.insts[i].ret)
        let eff = c.insts[i].effects
        let sig = format("{}fn {}({}) -> {}", .{if c.insts[i].is_pub { "pub " } else { "" }, c.insts[i].name, params, ret})
        let effs = if eff == 0 { String.from("(pure)") } else { check.render_effects(eff) }
        rows.append(format("{}  {}", .{sig, effs}))
        locs.append(c.location(c.insts[i].module, c.insts[i].start))
    }
    println("inferred effects ({} functions)\n", .{rows.len})
    for r, i in rows { println("{}\n    at {}", .{r, locs[i]}) }
}

/// `nx explain FILE f effect`: why `f` has the effect, as a tree. Each
/// function is printed with the reason the checker recorded for it (the
/// witness: an allocation, an overflow check, an explicit panic), then the
/// calls that carry the effect in, each followed by the callee's own tree,
/// down to the primitive that brings it. A cycle or a depth past twelve
/// stops with a note.
pub fn explain(c: *mut check.Checker, fname: []u8, effect: []u8) -> bool {
    let bit = check.effect_bit(effect)
    if bit == 0 {
        eprintln("error: `{}` is not an effect (they are: {})", .{effect, check.render_effects(0xFFFFFFFFFFFFFFFF)})
        return false
    }
    var found = false
    let n = c.insts.len
    for i in 0..n {
        if c.insts[i].name[..] != fname or c.insts[i].body == parser.NONE or c.insts[i].is_closure or c.insts[i].is_test { continue }
        let mname = c.mods[c.insts[i].module].name.clone()
        if mname[..].starts_with("std.") or mname[..].starts_with("cimport:") { continue }
        found = true
        if (c.insts[i].effects & bit) == 0 {
            // written as a signature bounds it: `!blocks`
            println("{}  !{}", .{signature_of(c, i), effect})
            continue
        }
        var seen = List(usize).new()
        explain_inst(c, i, bit, 0, &mut seen)
    }
    if !found { eprintln("error: no function named `{}` in the program", .{fname}) }
    return found
}

fn signature_of(c: *mut check.Checker, i: usize) -> String {
    var params = String.new()
    let ps = c.insts[i].params.clone()
    for p, pi in ps {
        if pi > 0 { params.append(", ") }
        let l = &c.insts[i].locals[p]
        params.append(format("{}: {}", .{l.name, c.ty_name(l.ty)})[..])
    }
    return format("fn {}({}) -> {}", .{c.insts[i].name, params, c.ty_name(c.insts[i].ret)})
}

fn indent(depth: usize) -> String {
    var s = String.new()
    for _ in 0..depth { s.append("  ") }
    return s
}

fn explain_inst(c: *mut check.Checker, inst: usize, bit: u64, depth: usize, seen: *mut List(usize)) {
    let pad = indent(depth)
    println("{}{}  {}", .{pad, signature_of(c, inst), check.render_effects(c.insts[inst].effects & bit)})
    for s in seen { if s == inst { println("{}  (seen above)", .{pad}); return } }
    seen.append(inst)
    if depth > 12 {
        println("{}  ... (deeper than twelve calls)", .{pad})
        return
    }
    // the reason recorded here, when the effect enters in this body
    let why = c.witness_why(inst, bit)
    if why.len > 0 {
        let at = c.witness_at(inst, bit)
        println("{}  {} at {}", .{pad, why, c.location(c.insts[inst].module, at)})
    }
    // the calls that carry it in
    var callees = List(usize).new()
    var sites = List(usize).new()
    explain_walk(c, c.insts[inst].body, bit, &mut callees, &mut sites)
    for callee, k in callees {
        println("{}  calls {} at {}", .{pad, c.insts[callee].name, c.location(c.insts[inst].module, sites[k])})
        explain_inst(c, callee, bit, depth + 2, seen)
    }
    if why.len == 0 and callees.len == 0 {
        println("{}  (the effect is declared or comes through a value; no call carries it)", .{pad})
    }
}

fn explain_walk(c: *mut check.Checker, e: usize, bit: u64, callees: *mut List(usize), sites: *mut List(usize)) {
    if e == parser.NONE { return }
    let k = c.tir.nodes[e].k
    if k == check.TKind.Call {
        let callee = c.tir.nodes[e].a
        if callee != parser.NONE and callee < c.insts.len and (c.insts[callee].effects & bit) != 0 {
            var dup = false
            for x in callees { if x == callee { dup = true } }
            if !dup {
                callees.append(callee)
                sites.append(c.tir.nodes[e].start)
            }
        }
    }
    for kid in c.tir.nodes[e].kids.clone() { explain_walk(c, kid, bit, callees, sites) }
}

/// The effects lockfile: one line per function of the program's own modules
/// and its packages (never the standard library or an imported header),
/// `signature<TAB>effects`, sorted, with `-` for none. Semver for behaviour:
/// `nx audit --lock` writes it, `nx audit --check` fails when a function
/// gained an effect the lock does not name.
pub fn effects_lock_text(c: *mut check.Checker) -> String {
    var lines = List(String).new()
    let n = c.insts.len
    for i in 0..n {
        if c.insts[i].body == parser.NONE or c.insts[i].is_closure or c.insts[i].is_test { continue }
        let mname = c.mods[c.insts[i].module].name.clone()
        if mname[..].starts_with("std.") or mname[..].starts_with("cimport:") { continue }
        var params = String.new()
        let ps = c.insts[i].params.clone()
        for p, pi in ps {
            if pi > 0 { params.append(", ") }
            let l = &c.insts[i].locals[p]
            params.append(format("{}: {}", .{l.name, c.ty_name(l.ty)})[..])
        }
        let ret = c.ty_name(c.insts[i].ret)
        let sig = format("{}fn {}({}) -> {}", .{if c.insts[i].is_pub { "pub " } else { "" }, c.insts[i].name, params, ret})
        let eff = c.insts[i].effects
        let effs = if eff == 0 { String.from("-") } else { check.render_effects(eff) }
        lines.append(format("{}\t{}", .{sig, effs}))
    }
    // sorted, so the file diffs by function (insertion sort: a few hundred lines)
    var i: usize = 1
    while i < lines.len {
        var j = i
        while j > 0 and bytes_less(lines[j][..], lines[j - 1][..]) {
            let tmp = lines[j - 1].clone()
            lines[j - 1] = lines[j].clone()
            lines[j] = tmp
            j -= 1
        }
        i += 1
    }
    var out = String.from("# effects.lock: the effects of every function, written by `nx audit --lock`;\n# `nx audit --check` fails when one gained an effect this file does not name\n")
    for l in lines {
        out.append(l[..])
        out.append("\n")
    }
    return out
}

/// Byte-wise order of two strings, for the lockfile's lines.
fn bytes_less(a: []u8, b: []u8) -> bool {
    var k: usize = 0
    while k < a.len and k < b.len {
        if a[k] != b[k] { return a[k] < b[k] }
        k += 1
    }
    return a.len < b.len
}

/// Compare the program's effects with a lockfile's: the functions that
/// gained an effect (a failure), and notes on what else moved (an effect
/// lost, a function new or gone).
pub fn effects_lock_compare(c: *mut check.Checker, locked: []u8, gains: *mut List(String), notes: *mut List(String)) {
    var old_sigs = List(String).new()
    var old_effs = List(String).new()
    for line in locked.lines() {
        if line.len == 0 or line.starts_with("#") { continue }
        let tab = line.find("\t") orelse continue
        old_sigs.append(String.from(line[0..tab]))
        old_effs.append(String.from(line[tab + 1..]))
    }
    var seen = List(bool).new()
    for _ in old_sigs { seen.append(false) }
    let now = effects_lock_text(c)
    for line in now[..].lines() {
        if line.len == 0 or line.starts_with("#") { continue }
        let tab = line.find("\t") orelse continue
        let sig = line[0..tab]
        let effs = line[tab + 1..]
        var idx = parser.NONE
        for s, i in old_sigs { if s[..] == sig { idx = i } }
        if idx == parser.NONE {
            notes.append(format("new: {}  {}", .{sig, effs}))
            continue
        }
        seen[idx] = true
        let was = old_effs[idx][..]
        var gained = String.new()
        var lost = String.new()
        for e in effs.split(" ") {
            if e == "-" or e.len == 0 { continue }
            var had = false
            for w in was.split(" ") { if w == e { had = true } }
            if !had {
                if gained.len > 0 { gained.append(" ") }
                gained.append(e)
            }
        }
        for w in was.split(" ") {
            if w == "-" or w.len == 0 { continue }
            var has = false
            for e in effs.split(" ") { if e == w { has = true } }
            if !has {
                if lost.len > 0 { lost.append(" ") }
                lost.append(w)
            }
        }
        if gained.len > 0 { gains.append(format("{} gained: {}", .{sig, gained})) }
        if lost.len > 0 { notes.append(format("{} lost: {}", .{sig, lost})) }
    }
    for s, i in old_sigs { if !seen[i] { notes.append(format("gone: {}", .{s})) } }
}

/// `nx audit`: every `unsafe` block with its statement count, and every
/// mutable global, from the parse trees; then the program is checked.
pub fn audit(c: *mut check.Checker, globals_flag: bool) {
    var sites = List(String).new()
    var globals = List(String).new()
    let n_mods = c.mods.len
    for m in 0..n_mods {
        if c.mods[m].name[..].starts_with("std.") or c.mods[m].name[..].starts_with("cimport:") { continue }
        let items = c.mods[m].parsed.items.clone()
        for it in items {
            let k = c.mods[m].parsed.tree.nodes[it].k
            if k == parser.NodeKind.Global {
                let nm = c.mods[m].parsed.tree.nodes[it].name.clone()
                globals.append(format("  {}  at {}", .{nm, c.location(m, c.mods[m].parsed.tree.nodes[it].start)}))
            }
            audit_walk(c, m, it, &mut sites)
        }
    }
    println("unsafe blocks: {}", .{sites.len})
    for s in sites { println("{}", .{s}) }
    println("mutable globals: {}", .{globals.len})
    for g in globals { println("{}", .{g}) }
    if globals_flag and globals.len > 0 {
        println("note: a project declaring a `cabi`, `python`, `node`, `rustlib`, or `shared` artifact rejects any function that reaches these (S2)", .{})
    }
}

/// Pre-order over a parse tree in source order: statements before a
/// block's tail, single children before child lists otherwise.
fn audit_walk(c: *mut check.Checker, m: usize, id: usize, sites: *mut List(String)) {
    if id == parser.NONE { return }
    let k = c.mods[m].parsed.tree.nodes[id].k
    if k == parser.NodeKind.Unsafe or k == parser.NodeKind.UnsafeE {
        let body = c.mods[m].parsed.tree.nodes[id].x
        var count = c.mods[m].parsed.tree.nodes[body].kids.len
        if c.mods[m].parsed.tree.nodes[body].x != parser.NONE { count += 1 }
        sites.append(format("  {}  ({} line(s))", .{c.location(m, c.mods[m].parsed.tree.nodes[id].start), count}))
    }
    if k == parser.NodeKind.Block {
        for kid in c.mods[m].parsed.tree.nodes[id].kids.clone() { audit_walk(c, m, kid, sites) }
        audit_walk(c, m, c.mods[m].parsed.tree.nodes[id].x, sites)
        return
    }
    audit_walk(c, m, c.mods[m].parsed.tree.nodes[id].x, sites)
    audit_walk(c, m, c.mods[m].parsed.tree.nodes[id].y, sites)
    audit_walk(c, m, c.mods[m].parsed.tree.nodes[id].z, sites)
    for kid in c.mods[m].parsed.tree.nodes[id].kids.clone() { audit_walk(c, m, kid, sites) }
    for kid in c.mods[m].parsed.tree.nodes[id].kids2.clone() { audit_walk(c, m, kid, sites) }
}

/// `nx refcounts`: every place the generated code retains or releases a
/// `ref class` reference, in the order the first compiler walked them.
pub fn refcounts(c: *mut check.Checker) {
    var lines = List(String).new()
    let n = c.insts.len
    for i in 0..n {
        if c.insts[i].body == parser.NONE { continue }
        refcount_walk(c, i, c.insts[i].body, &mut lines)
    }
    println("reference count traffic: {} site(s)\n", .{lines.len})
    for l in lines { println("{}", .{l}) }
    if lines.len == 0 {
        println("this program performs no reference counting: every function qualifies for `!refcounts` (spec 5.3)", .{})
    }
}

fn site(c: *mut check.Checker, inst: usize, at: usize, what: []u8, out: *mut List(String)) {
    out.append(format("{}  {}\n    in {}", .{c.location(c.insts[inst].module, at), what, c.insts[inst].name}))
}

fn refcount_walk(c: *mut check.Checker, inst: usize, e: usize, out: *mut List(String)) {
    if e == parser.NONE { return }
    let k = c.tir.nodes[e].k
    let start = c.tir.nodes[e].start
    if k == check.TKind.SLet {
        let l = c.tir.nodes[e].a
        if c.holds_refs(c.insts[inst].locals[l].ty) { site(c, inst, start, "release at scope exit", out) }
    } else if k == check.TKind.SAssign {
        let target = c.tir.nodes[e].kids[0]
        if c.holds_refs(c.tir.nodes[target].ty) { site(c, inst, start, "release of the previous value", out) }
    } else if k == check.TKind.Retained {
        site(c, inst, start, "retain (copy of a reference)", out)
    } else if k == check.TKind.RefNew {
        site(c, inst, start, "allocation with count 1", out)
    } else if k == check.TKind.Builtin and c.tir.nodes[e].name == "Weak" {
        site(c, inst, start, "weak reference created", out)
    } else if k == check.TKind.Builtin and c.tir.nodes[e].name == "Upgrade" {
        site(c, inst, start, "retain on upgrade", out)
    }
    for kid in c.tir.nodes[e].kids.clone() { refcount_walk(c, inst, kid, out) }
}
