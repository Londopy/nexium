// `nx doc`: static HTML from `///` comments and the type system, including
// inferred effect signatures (specification 16). A port of the first
// generator; the page is the same byte for byte.

import parser
import check

fn esc(s: []u8) -> String {
    var out = String.new()
    for c in s {
        if c == '&' { out.append("&amp;") }
        else if c == '<' { out.append("&lt;") }
        else if c == '>' { out.append("&gt;") }
        else { out.push_byte(c) }
    }
    return out
}

/// A type as written, from its parse node.
fn type_str(t: *parser.Tree, id: usize) -> String {
    let n = &t.nodes[id]
    let k = n.k
    if k == parser.NodeKind.TName {
        var path = String.new()
        for w, i in n.words {
            if i > 0 { path.append(".") }
            path.append(w[..])
        }
        if n.kids.len == 0 { return path }
        var args = String.new()
        for a, i in n.kids {
            if i > 0 { args.append(", ") }
            args.append(type_str(t, a)[..])
        }
        return format("{}({})", .{path, args})
    }
    if k == parser.NodeKind.TArray { return format("[N]{}", .{type_str(t, n.y)}) }
    if k == parser.NodeKind.TSlice { return format("[]{}{}", .{if n.flag { "mut " } else { "" }, type_str(t, n.x)}) }
    if k == parser.NodeKind.TPtr { return format("*{}{}", .{if n.flag { "mut " } else { "" }, type_str(t, n.x)}) }
    if k == parser.NodeKind.TOpt { return format("?{}", .{type_str(t, n.x)}) }
    if k == parser.NodeKind.TErr {
        let set = if n.x == parser.NONE { String.new() } else { type_str(t, n.x) }
        return format("{}!{}", .{set, type_str(t, n.y)})
    }
    if k == parser.NodeKind.TFn {
        var ps = String.new()
        for p, i in n.kids {
            if i > 0 { ps.append(", ") }
            ps.append(type_str(t, p)[..])
        }
        return format("fn({}) -> {}", .{ps, type_str(t, n.x)})
    }
    if k == parser.NodeKind.TTuple {
        var es = String.new()
        for e, i in n.kids {
            if i > 0 { es.append(", ") }
            es.append(type_str(t, e)[..])
        }
        return format("({})", .{es})
    }
    if k == parser.NodeKind.TWeak { return format("weak {}", .{type_str(t, n.x)}) }
    if k == parser.NodeKind.TDyn { return format("dyn {}", .{n.name}) }
    return String.from("_")
}

fn fn_sig(t: *parser.Tree, id: usize) -> String {
    let n = &t.nodes[id]
    var params = String.new()
    for p, i in n.kids {
        if i > 0 { params.append(", ") }
        let pn = &t.nodes[p]
        params.append(format("{}{}: {}", .{if pn.flag { "comptime " } else { "" }, pn.name, type_str(t, pn.x)})[..])
    }
    let ret = if n.x == parser.NONE { String.new() } else { format(" -> {}", .{type_str(t, n.x)}) }
    return format("{}fn {}({}){}", .{if n.flag { "pub " } else { "" }, n.name, params, ret})
}

fn docs_html(t: *parser.Tree, id: usize) -> String {
    let d = t.nodes[id].doc
    if d == parser.NONE or t.doc_counts[d] == 0 { return String.new() }
    return format("<p class=\"doc\">{}</p>", .{esc(t.docs[d][..])})
}

/// The page for a checked program: every public item of every module.
pub fn generate(title: []u8, c: *mut check.Checker) -> String {
    var h = String.new()
    let t = esc(title)
    h.append(format("<!doctype html><html><head><meta charset=\"utf-8\"><title>{}</title><style>\n", .{t})[..])
    h.append("body{font-family:system-ui,sans-serif;max-width:60rem;margin:2rem auto;padding:0 1rem;line-height:1.5;color:#222}\n")
    h.append("code,pre{font-family:ui-monospace,Consolas,monospace;background:#f4f4f6;border-radius:4px}\n")
    h.append("pre{padding:.6rem .8rem;overflow:auto} code{padding:0 .25rem}\n")
    h.append("h2{border-bottom:1px solid #ddd;padding-bottom:.2rem;margin-top:2rem}\n")
    h.append(".item{margin:1.2rem 0} .eff{color:#7a3e00;font-size:.9em} .doc{margin:.3rem 0 0 1rem}\n")
    h.append(".fields{margin:.3rem 0 0 1rem;color:#444} nav a{margin-right:1rem}\n")
    h.append(format("</style></head><body><h1>{}</h1><p>Generated by <code>nx doc</code>. Effects are inferred by the compiler, not written by hand.</p>", .{t})[..])
    let n_mods = c.mods.len
    for m in 0..n_mods {
        if c.mods[m].name[..].starts_with("cimport:") { continue }
        h.append(format("<h2>module {}</h2>", .{esc(c.mods[m].name[..])})[..])
        let items = c.mods[m].parsed.items.clone()
        for it in items {
            let tree = &c.mods[m].parsed.tree
            let k = tree.nodes[it].k
            let is_pub = tree.nodes[it].flag
            let name = tree.nodes[it].name.clone()
            if k == parser.NodeKind.Fn and (is_pub or tree.nodes[it].text != "-") {
                // the non-generic instance's inferred effects
                var eff_s = String.from("effects: (generic; inferred per instantiation)")
                let n = c.insts.len
                for i in 0..n {
                    if c.insts[i].name == name and c.insts[i].targs.len == 0 and !c.insts[i].is_closure and c.insts[i].module == m {
                        eff_s = if c.insts[i].effects == 0 { String.from("pure (no effects)") } else { format("effects: {}", .{check.render_effects(c.insts[i].effects)}) }
                        break
                    }
                }
                let exp = if tree.nodes[it].text == "-" { String.new() } else { format(" export({})", .{tree.nodes[it].text}) }
                h.append(format("<div class=\"item\" id=\"fn-{}\"><pre>{}{}</pre><div class=\"eff\">{}</div>{}</div>", .{esc(name[..]), esc(fn_sig(tree, it)[..]), exp, esc(eff_s[..]), docs_html(tree, it)})[..])
            } else if k == parser.NodeKind.Struct and is_pub {
                let kind = tree.nodes[it].text[..]
                let kw = if kind == "record" { "record" } else if kind == "ref" { "ref class" } else { "struct" }
                var fields = String.new()
                for f in tree.nodes[it].kids {
                    let fnode = &tree.nodes[f]
                    let cons = if fnode.z != parser.NONE { " (constrained)" } else { "" }
                    fields.append(format("<div><code>{}: {}</code>{}{}</div>", .{esc(fnode.name[..]), esc(type_str(tree, fnode.x)[..]), cons, docs_html(tree, f)})[..])
                }
                var tparams = String.new()
                for w in tree.nodes[it].words {
                    if w == "+" { break }
                    if tparams.len > 0 { tparams.append(", ") }
                    tparams.append(w[..])
                }
                let tp = if tparams.len == 0 { String.new() } else { format("({})", .{tparams}) }
                h.append(format("<div class=\"item\"><pre>{} {}{}</pre>{}<div class=\"fields\">{}</div></div>", .{kw, esc(name[..]), tp, docs_html(tree, it), fields})[..])
            } else if k == parser.NodeKind.Enum and is_pub {
                var vs = String.new()
                for v, i in tree.nodes[it].kids {
                    if i > 0 { vs.append(", ") }
                    vs.append(esc(tree.nodes[v].name[..])[..])
                }
                h.append(format("<div class=\"item\"><pre>enum {}</pre>{}<div class=\"fields\">variants: {}</div></div>", .{esc(name[..]), docs_html(tree, it), vs})[..])
            } else if k == parser.NodeKind.Trait and is_pub {
                var ms = String.new()
                for mth, i in tree.nodes[it].kids {
                    if i > 0 { ms.append("\n") }
                    ms.append(esc(fn_sig(tree, mth)[..])[..])
                }
                h.append(format("<div class=\"item\"><pre>trait {}</pre>{}<div class=\"fields\"><pre>{}</pre></div></div>", .{esc(name[..]), docs_html(tree, it), ms})[..])
            } else if k == parser.NodeKind.Const and is_pub {
                let ty = if tree.nodes[it].x == parser.NONE { String.new() } else { format(": {}", .{esc(type_str(tree, tree.nodes[it].x)[..])}) }
                h.append(format("<div class=\"item\"><pre>const {}{}</pre>{}</div>", .{esc(name[..]), ty, docs_html(tree, it)})[..])
            } else if k == parser.NodeKind.ErrorSet and is_pub {
                var names = String.new()
                for w, i in tree.nodes[it].words {
                    if i > 0 { names.append(", ") }
                    names.append(w[..])
                }
                h.append(format("<div class=\"item\"><pre>error {} {{ {} }}</pre></div>", .{esc(name[..]), names})[..])
            } else if k == parser.NodeKind.TypeAlias and is_pub {
                h.append(format("<div class=\"item\"><pre>type {} = {}{}</pre></div>", .{esc(name[..]), if tree.nodes[it].flag2 { "distinct " } else { "" }, esc(type_str(tree, tree.nodes[it].x)[..])})[..])
            }
        }
    }
    h.append("</body></html>\n")
    return h
}
