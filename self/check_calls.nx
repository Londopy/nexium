// self/check_calls.nx: calls that are not plain function calls. Methods
// (inherent, trait and `dyn`), each type's methods kept to one per name;
// static members and calls on types; and the builtin namespaces (`math`,
// `io`, `os`, ...), whose functions are the NS_FNS table.
// The methods are the checker's (`impl Checker`, decision 110).

import check
import parser

type Checker = check.Checker
const EFF_ALL = check.EFF_ALL
const EFF_ALLOCATES = check.EFF_ALLOCATES
const EFF_BLOCKS = check.EFF_BLOCKS
const EFF_NONDETERMINISTIC = check.EFF_NONDETERMINISTIC
const EFF_PANICS = check.EFF_PANICS
const EFF_REFCOUNTS = check.EFF_REFCOUNTS
const EFF_SHARED_MUTABLE = check.EFF_SHARED_MUTABLE
type FnDef = check.FnDef
type ItemKind = check.ItemKind
const NONE = check.NONE
const NONE_NAME = check.NONE_NAME
type TK = check.TK
type TKind = check.TKind
type VTable = check.VTable

// ---------------------------------------------------------------- methods, static and namespace calls

/// A builtin namespace function: argument type codes, result type code, the
/// builtin's name, and the effects it carries.
pub struct NsFn {
    ns: []u8
    name: []u8
    args: []u8
    ret: []u8
    op: []u8
    effects: u64
}

const NS_FNS = [
    NsFn{ .ns = "io", .name = "read_file", .args = "bytes", .ret = "!string", .op = "ReadFile", .effects = EFF_BLOCKS | EFF_ALLOCATES },
    NsFn{ .ns = "io", .name = "write_file", .args = "bytes bytes", .ret = "!void", .op = "WriteFile", .effects = EFF_BLOCKS },
