// Artifact production: C headers, Python packages and wheels, Rust crates
// (specification 15). A port of the first compiler's ship.rs; the files it
// writes are the same byte for byte.

import cgen

fn upper(s: []u8) -> String {
    var out = String.new()
    for c in s { out.push_byte(if c >= 'a' and c <= 'z' { c - 32 } else { c }) }
    return out
}

fn is_alnum(c: u8) -> bool { return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') }

/// `nx_point` -> `point`: the struct's name outside C.
fn plain(c_name: []u8) -> []u8 {
    if c_name.starts_with("nx_") { return c_name[3..] }
    return c_name
}

/// The distinct `layout(c)` structs the exports use, in first-use order.
fn structs_of(infos: *List(cgen.ExportInfo)) -> List(*cgen.ExportParam) {
    var seen = List(String).new()
    var out = List(*cgen.ExportParam).new()
    for info in infos {
        for p, i in info.params {
            if p.kind == 2 and !has(&seen, p.c_name[..]) { seen.append(p.c_name.clone()); out.append(&info.params[i]) }
        }
        if info.has_ret and info.ret.kind == 2 and !has(&seen, info.ret.c_name[..]) { seen.append(info.ret.c_name.clone()); out.append(&info.ret) }
    }
    return out
}

fn has(xs: *List(String), s: []u8) -> bool {
    for x in xs { if x == s { return true } }
    return false
}

fn effects_text(info: *cgen.ExportInfo) -> []u8 {
    return if info.effects.len == 0 { "none" } else { info.effects[..] }
}

fn join(parts: *List(String), sep: []u8) -> String {
    var out = String.new()
    for p, i in parts {
        if i > 0 { out.append(sep) }
        out.append(p[..])
    }
    return out
}

// ----- C header --------------------------------------------------------------

pub fn c_header(lib: []u8, infos: *List(cgen.ExportInfo)) -> String {
    var guard = upper(lib)
    var g = String.new()
    for c in guard { g.push_byte(if is_alnum(c) { c } else { '_' }) }
    g.append("_H")
    var h = String.new()
    h.append(format("/* {} - generated by nx. Link the static library or load the shared one. */\n", .{lib})[..])
    h.append(format("#ifndef {}\n#define {}\n#include <stdint.h>\n#include <stddef.h>\n#include <stdbool.h>\n#ifdef __cplusplus\nextern \"C\" {{\n#endif\n\n", .{g, g})[..])
    h.append(format("/* Status codes: 0 = ok. Any other value is an error code; {}_error_name() gives its name.\n   A Nexium panic inside a call is converted to the code named \"Panic\"; {}_last_panic() returns the message. */\n", .{lib, lib})[..])
    h.append(format("const char* {}_error_name(int32_t code);\nconst char* {}_last_panic(void);\n\n", .{lib, lib})[..])
    for st in structs_of(infos) {
        h.append(format("typedef struct {} {{\n", .{st.c_name})[..])
        for f in st.fields { h.append(format("  {} {}; /* {} */\n", .{f.scalar.c, f.c_name, f.name})[..]) }
        h.append(format("}} {};\n\n", .{st.c_name})[..])
    }
    for info in infos {
        for d in info.doc { h.append(format("/* {} */\n", .{d})[..]) }
        var params = List(String).new()
        for p in info.params {
            if p.kind == 0 { params.append(format("{} {}", .{p.scalar.c, p.name})) }
            else if p.kind == 1 {
                params.append(format("{}{}* {}", .{if p.mutable { "" } else { "const " }, p.elem_c, p.name}))
                params.append(format("size_t {}_len", .{p.name}))
            } else { params.append(format("{} {}", .{p.c_name, p.name})) }
        }
        if info.status {
            if info.has_ret { params.append(format("{}* out", .{ret_c(&info)})) }
            h.append(format("/* effects: {} */\nint32_t {}({});\n", .{effects_text(&info), info.name, if params.len == 0 { String.from("void") } else { join(&params, ", ") }})[..])
        } else {
            let r = if info.has_ret { ret_c(&info) } else { String.from("void") }
            h.append(format("/* effects: {}; cannot panic, so it returns its value directly */\n{} {}({});\n", .{effects_text(&info), r, info.name, if params.len == 0 { String.from("void") } else { join(&params, ", ") }})[..])
        }
        h.append("\n")
    }
    h.append(format("#ifdef __cplusplus\n}}\n#endif\n#endif /* {} */\n", .{g})[..])
    return h
}

/// The C type of a return value: the scalar's, or the struct's name.
fn ret_c(info: *cgen.ExportInfo) -> String {
    if info.ret.kind == 0 { return info.ret.scalar.c.clone() }
    return info.ret.c_name.clone()
}

// ----- Python ----------------------------------------------------------------

fn py_ctype(k: *cgen.Scalar) -> []u8 {
    if k.kind == 1 { return "ctypes.c_float" }
    if k.kind == 2 { return "ctypes.c_double" }
    if k.kind == 3 { return "ctypes.c_bool" }
    if k.kind == 4 { return "ctypes.c_uint32" }
    let n = k.int_name[..]
    if n == "i8" { return "ctypes.c_int8" }
    if n == "i16" { return "ctypes.c_int16" }
    if n == "i32" { return "ctypes.c_int32" }
    if n == "i64" { return "ctypes.c_int64" }
    if n == "u8" { return "ctypes.c_uint8" }
    if n == "u16" { return "ctypes.c_uint16" }
    if n == "u32" { return "ctypes.c_uint32" }
    if n == "u64" { return "ctypes.c_uint64" }
    if n == "isize" { return "ctypes.c_ssize_t" }
    if n == "usize" { return "ctypes.c_size_t" }
    return "ctypes.c_int64"
}

fn py_hint(k: *cgen.Scalar) -> []u8 {
    if k.kind == 1 or k.kind == 2 { return "float" }
    if k.kind == 3 { return "bool" }
    return "int"
}

fn py_array_code(k: *cgen.Scalar) -> []u8 {
    if k.kind == 1 { return "f" }
    if k.kind == 2 { return "d" }
    if k.kind == 3 { return "B" }
    if k.kind == 4 { return "I" }
    let n = k.int_name[..]
    if n == "i8" { return "b" }
    if n == "u8" { return "B" }
    if n == "i16" { return "h" }
    if n == "u16" { return "H" }
    if n == "i32" { return "i" }
    if n == "u32" { return "I" }
    if n == "i64" or n == "isize" { return "q" }
    if n == "u64" or n == "usize" { return "Q" }
    return "q"
}

fn quoted(s: []u8) -> String {
    var out = String.from("\"")
    for c in s {
        if c == '"' or c == '\\' { out.push_byte('\\') }
        out.push_byte(c)
    }
    out.append("\"")
    return out
}

pub fn python_module(lib: []u8, version: []u8, infos: *List(cgen.ExportInfo), libfile: []u8) -> String {
    var py = String.new()
    py.append(format("\"\"\"{} - generated by nx from a Nexium source tree.\n\nEvery function here calls into the native library through ctypes. Errors\nraised by the Nexium code arrive as NexiumError; a panic inside the native\ncode is caught at the boundary and raised as NexiumPanic.\n\"\"\"\nimport ctypes\nimport os\nimport array\n\n__version__ = {}\n__all__ = [\"NexiumError\", \"NexiumPanic\"]\n\n_lib = ctypes.CDLL(os.path.join(os.path.dirname(os.path.abspath(__file__)), {}))\n", .{lib, quoted(version), quoted(libfile)})[..])
    py.append(format("_lib.{}_error_name.restype = ctypes.c_char_p\n_lib.{}_error_name.argtypes = [ctypes.c_int32]\n_lib.{}_last_panic.restype = ctypes.c_char_p\n_lib.{}_last_panic.argtypes = []\n\n\n", .{lib, lib, lib, lib})[..])
    py.append(format("class NexiumError(Exception):\n    \"\"\"An error value returned by Nexium code.\"\"\"\n    def __init__(self, code):\n        self.code = code\n        self.name = _lib.{}_error_name(code).decode()\n        super().__init__(self.name)\n\n\n", .{lib})[..])
    py.append(format("class NexiumPanic(NexiumError):\n    \"\"\"A panic inside Nexium code, converted at the boundary.\"\"\"\n    def __init__(self, code):\n        super().__init__(code)\n        self.message = _lib.{}_last_panic().decode()\n        self.args = (self.message,)\n\n\n", .{lib})[..])
    py.append(format("def _raise(code):\n    if _lib.{}_error_name(code) == b\"Panic\":\n        raise NexiumPanic(code)\n    raise NexiumError(code)\n\n\n", .{lib})[..])
    py.append("def _buf(value, ctype, code, writable):\n    \"\"\"Turn a bytes/bytearray/array/list/memoryview into (pointer, length).\"\"\"\n    if isinstance(value, (bytes, bytearray, memoryview, array.array)):\n        mv = memoryview(value)\n        if mv.format != code and not (code == \"B\" and mv.format in (\"b\", \"c\")):\n            value = array.array(code, list(value))\n            mv = memoryview(value)\n        if writable and mv.readonly:\n            raise TypeError(\"a writable buffer (bytearray or array) is required\")\n        n = mv.nbytes // mv.itemsize\n        if writable:\n            arr = (ctype * n).from_buffer(value)\n        else:\n            arr = (ctype * n).from_buffer_copy(mv)\n        return arr, n\n    seq = list(value)\n    arr = (ctype * len(seq))(*seq)\n    return arr, len(seq)\n\n")
    for st in structs_of(infos) {
        let pyname = plain(st.c_name[..])
        py.append(format("\n\nclass {}(ctypes.Structure):\n    _fields_ = [\n", .{pyname})[..])
        for f in st.fields { py.append(format("        ({}, {}),\n", .{quoted(f.name[..]), py_ctype(&f.scalar)})[..]) }
        py.append(format("    ]\n\n    def __repr__(self):\n        return \"{}(\" + \", \".join(f\"{{n}}={{getattr(self, n)!r}}\" for n, _ in self._fields_) + \")\"\n\n__all__.append({})\n", .{pyname, quoted(pyname)})[..])
    }
    for info in infos {
        var argtypes = List(String).new()
        var sig = List(String).new()
        var conv = List(String).new()
        var call = List(String).new()
        for p in info.params {
            if p.kind == 0 {
                argtypes.append(String.from(py_ctype(&p.scalar)))
                sig.append(format("{}: {}", .{p.name, py_hint(&p.scalar)}))
                call.append(p.name.clone())
            } else if p.kind == 1 {
                argtypes.append(format("ctypes.POINTER({})", .{py_ctype(&p.scalar)}))
                argtypes.append(String.from("ctypes.c_size_t"))
                sig.append(p.name.clone())
                conv.append(format("    _{}, _{}_len = _buf({}, {}, {}, {})", .{p.name, p.name, p.name, py_ctype(&p.scalar), quoted(py_array_code(&p.scalar)), if p.mutable { "True" } else { "False" }}))
                call.append(format("_{}", .{p.name}))
                call.append(format("_{}_len", .{p.name}))
            } else {
                let pyname = plain(p.c_name[..])
                argtypes.append(String.from(pyname))
                sig.append(format("{}: {}", .{p.name, pyname}))
                call.append(p.name.clone())
            }
        }
        var ret_ct = String.new()
        var ret_hint = String.new()
        if info.has_ret {
            if info.ret.kind == 0 { ret_ct = String.from(py_ctype(&info.ret.scalar)); ret_hint = String.from(py_hint(&info.ret.scalar)) }
            else if info.ret.kind == 2 { ret_ct = String.from(plain(info.ret.c_name[..])); ret_hint = ret_ct.clone() }
            else { ret_ct = String.from("None"); ret_hint = String.from("None") }
        }
        let arrow = if info.has_ret { format(" -> {}", .{ret_hint}) } else { String.new() }
        py.append("\n\n")
        if info.status {
            var at = argtypes.clone()
            if info.has_ret { at.append(format("ctypes.POINTER({})", .{ret_ct})) }
            py.append(format("_lib.{}.restype = ctypes.c_int32\n_lib.{}.argtypes = [{}]\n", .{info.name, info.name, join(&at, ", ")})[..])
            py.append(format("\n\ndef {}({}){}:\n", .{info.name, join(&sig, ", "), arrow})[..])
            py.append(format("    \"\"\"effects: {}\"\"\"\n", .{effects_text(&info)})[..])
            for c in conv { py.append(format("{}\n", .{c})[..]) }
            if info.has_ret {
                var c2 = call.clone()
                c2.append(String.from("ctypes.byref(_out)"))
                py.append(format("    _out = {}()\n    _code = _lib.{}({})\n    if _code != 0:\n        _raise(_code)\n    return _out.value if hasattr(_out, \"value\") else _out\n", .{ret_ct, info.name, join(&c2, ", ")})[..])
            } else {
                py.append(format("    _code = _lib.{}({})\n    if _code != 0:\n        _raise(_code)\n", .{info.name, join(&call, ", ")})[..])
            }
        } else {
            py.append(format("_lib.{}.restype = {}\n_lib.{}.argtypes = [{}]\n", .{info.name, if info.has_ret { ret_ct.clone() } else { String.from("None") }, info.name, join(&argtypes, ", ")})[..])
            py.append(format("\n\ndef {}({}){}:\n", .{info.name, join(&sig, ", "), arrow})[..])
            py.append(format("    \"\"\"effects: {} (cannot panic)\"\"\"\n", .{effects_text(&info)})[..])
            for c in conv { py.append(format("{}\n", .{c})[..]) }
            py.append(format("    return _lib.{}({})\n", .{info.name, join(&call, ", ")})[..])
        }
        py.append(format("\n\n__all__.append({})\n", .{quoted(info.name[..])})[..])
    }
    return py
}

pub fn python_stub(infos: *List(cgen.ExportInfo)) -> String {
    var s = String.from("import ctypes\nfrom typing import Sequence\n\nclass NexiumError(Exception):\n    code: int\n    name: str\n\nclass NexiumPanic(NexiumError):\n    message: str\n\n")
    for st in structs_of(infos) {
        let pyname = plain(st.c_name[..])
        s.append(format("class {}(ctypes.Structure):\n", .{pyname})[..])
        var inits = List(String).new()
        for f in st.fields {
            s.append(format("    {}: {}\n", .{f.name, py_hint(&f.scalar)})[..])
            inits.append(format("{}: {} = ...", .{f.name, py_hint(&f.scalar)}))
        }
        s.append(format("    def __init__(self, {}) -> None: ...\n\n", .{join(&inits, ", ")})[..])
    }
    for info in infos {
        var sig = List(String).new()
        for p in info.params {
            if p.kind == 0 { sig.append(format("{}: {}", .{p.name, py_hint(&p.scalar)})) }
            else if p.kind == 1 { sig.append(format("{}: Sequence[{}] | bytes | bytearray", .{p.name, py_hint(&p.scalar)})) }
            else { sig.append(format("{}: {}", .{p.name, plain(p.c_name[..])})) }
        }
        var ret = String.from("None")
        if info.has_ret {
            if info.ret.kind == 0 { ret = String.from(py_hint(&info.ret.scalar)) }
            else if info.ret.kind == 2 { ret = String.from(plain(info.ret.c_name[..])) }
        }
        s.append(format("def {}({}) -> {}: ...\n", .{info.name, join(&sig, ", "), ret})[..])
    }
    return s
}

// ----- Rust ------------------------------------------------------------------

fn rust_scalar(k: *cgen.Scalar) -> []u8 {
    if k.kind == 1 { return "f32" }
    if k.kind == 2 { return "f64" }
    if k.kind == 3 { return "bool" }
    if k.kind == 4 { return "u32" }
    let n = k.int_name[..]
    if n == "i8" or n == "i16" or n == "i32" or n == "i64" or n == "u8" or n == "u16" or n == "u32" or n == "u64" or n == "isize" or n == "usize" { return n }
    return "i64"
}

/// A file of the generated crate.
pub struct CrateFile {
    path: String
    text: String
}

fn ret_rs(info: *cgen.ExportInfo) -> String {
    if info.ret.kind == 0 { return String.from(rust_scalar(&info.ret.scalar)) }
    if info.ret.kind == 2 { return String.from(plain(info.ret.c_name[..])) }
    return String.from("()")
}

/// A Rust crate wrapping the static library: `Cargo.toml`, `build.rs`, and
/// `src/lib.rs` with `extern "C"` declarations plus safe wrappers.
pub fn rust_crate(lib: []u8, version: []u8, infos: *List(cgen.ExportInfo), static_lib_file: []u8) -> List(CrateFile) {
    var crate_name = String.new()
    for c in lib { crate_name.push_byte(if c == '-' { '_' } else { c }) }
    let cargo = format("[package]\nname = \"{}\"\nversion = \"{}\"\nedition = \"2021\"\nlinks = \"{}\"\nbuild = \"build.rs\"\ndescription = \"Rust bindings for the Nexium library {} (generated by nx ship)\"\n\n[lib]\npath = \"src/lib.rs\"\n", .{crate_name, version, lib, lib})
    let build = format("fn main() {{\n    let dir = std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"lib\");\n    println!(\"cargo:rustc-link-search=native={{}}\", dir.display());\n    println!(\"cargo:rustc-link-lib=static={}\");\n    println!(\"cargo:rerun-if-changed=lib/{}\");\n}}\n", .{lib, static_lib_file})
    var rs = String.new()
    rs.append(format("//! Bindings for the Nexium library `{}`, generated by `nx ship`.\n//!\n//! Every exported function is wrapped: slices are passed as pointer and length,\n//! status-returning exports become `Result<T, NexiumError>`, and a panic inside\n//! Nexium code is reported as `NexiumError::Panic` rather than aborting.\n\n", .{lib})[..])
    rs.append("use std::ffi::CStr;\nuse std::os::raw::c_char;\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub enum NexiumError {\n    /// an error value returned by the Nexium code, by name\n    Error { code: i32, name: String },\n    /// a panic caught at the boundary\n    Panic { message: String },\n}\n\nimpl std::fmt::Display for NexiumError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        match self {\n            NexiumError::Error { name, .. } => write!(f, \"{}\", name),\n            NexiumError::Panic { message } => write!(f, \"panic: {}\", message),\n        }\n    }\n}\nimpl std::error::Error for NexiumError {}\n\n")
    for st in structs_of(infos) {
        rs.append(format("#[repr(C)]\n#[derive(Debug, Clone, Copy, PartialEq)]\npub struct {} {{\n", .{plain(st.c_name[..])})[..])
        for f in st.fields { rs.append(format("    pub {}: {},\n", .{f.name, rust_scalar(&f.scalar)})[..]) }
        rs.append("}\n\n")
    }
    rs.append(format("mod ffi {{\n    use super::*;\n    extern \"C\" {{\n        pub fn {}_error_name(code: i32) -> *const c_char;\n        pub fn {}_last_panic() -> *const c_char;\n", .{lib, lib})[..])
    for info in infos {
        var ps = List(String).new()
        for p in info.params {
            if p.kind == 0 { ps.append(format("{}: {}", .{p.name, rust_scalar(&p.scalar)})) }
            else if p.kind == 1 {
                ps.append(format("{}: *{} {}", .{p.name, if p.mutable { "mut" } else { "const" }, rust_scalar(&p.scalar)}))
                ps.append(format("{}_len: usize", .{p.name}))
            } else { ps.append(format("{}: {}", .{p.name, plain(p.c_name[..])})) }
        }
        if info.status {
            if info.has_ret { ps.append(format("out: *mut {}", .{ret_rs(&info)})) }
            rs.append(format("        pub fn {}({}) -> i32;\n", .{info.name, join(&ps, ", ")})[..])
        } else {
            let arrow = if info.has_ret { format(" -> {}", .{ret_rs(&info)}) } else { String.new() }
            rs.append(format("        pub fn {}({}){};\n", .{info.name, join(&ps, ", "), arrow})[..])
        }
    }
    rs.append(format("    }}\n}}\n\nfn error_for(code: i32) -> NexiumError {{\n    // SAFETY: the library returns pointers to static NUL-terminated strings\n    let name = unsafe {{ CStr::from_ptr(ffi::{}_error_name(code)) }}.to_string_lossy().into_owned();\n    if name == \"Panic\" {{\n        let message = unsafe {{ CStr::from_ptr(ffi::{}_last_panic()) }}.to_string_lossy().into_owned();\n        NexiumError::Panic {{ message }}\n    }} else {{\n        NexiumError::Error {{ code, name }}\n    }}\n}}\n\n", .{lib, lib})[..])
    for info in infos {
        var sig = List(String).new()
        var call = List(String).new()
        for p in info.params {
            if p.kind == 0 { sig.append(format("{}: {}", .{p.name, rust_scalar(&p.scalar)})); call.append(p.name.clone()) }
            else if p.kind == 1 {
                sig.append(format("{}: &{}[{}]", .{p.name, if p.mutable { "mut " } else { "" }, rust_scalar(&p.scalar)}))
                call.append(format("{}.{}()", .{p.name, if p.mutable { "as_mut_ptr" } else { "as_ptr" }}))
                call.append(format("{}.len()", .{p.name}))
            } else { sig.append(format("{}: {}", .{p.name, plain(p.c_name[..])})); call.append(p.name.clone()) }
        }
        rs.append(format("/// effects: {}\n", .{effects_text(&info)})[..])
        if info.status {
            if info.has_ret {
                var c2 = call.clone()
                c2.append(String.from("&mut out"))
                let r = ret_rs(&info)
                rs.append(format("pub fn {}({}) -> Result<{}, NexiumError> {{\n    let mut out: {} = unsafe {{ std::mem::zeroed() }};\n    let code = unsafe {{ ffi::{}({}) }};\n    if code == 0 {{ Ok(out) }} else {{ Err(error_for(code)) }}\n}}\n\n", .{info.name, join(&sig, ", "), r, r, info.name, join(&c2, ", ")})[..])
            } else {
                rs.append(format("pub fn {}({}) -> Result<(), NexiumError> {{\n    let code = unsafe {{ ffi::{}({}) }};\n    if code == 0 {{ Ok(()) }} else {{ Err(error_for(code)) }}\n}}\n\n", .{info.name, join(&sig, ", "), info.name, join(&call, ", ")})[..])
            }
        } else {
            let arrow = if info.has_ret { format(" -> {}", .{ret_rs(&info)}) } else { String.new() }
            rs.append(format("pub fn {}({}){} {{\n    unsafe {{ ffi::{}({}) }}\n}}\n\n", .{info.name, join(&sig, ", "), arrow, info.name, join(&call, ", ")})[..])
        }
    }
    var files = List(CrateFile).new()
    files.append(CrateFile{ .path = String.from("Cargo.toml"), .text = cargo })
    files.append(CrateFile{ .path = String.from("build.rs"), .text = build })
    files.append(CrateFile{ .path = String.from("src/lib.rs"), .text = rs })
    return files
}

// ----- wheel -----------------------------------------------------------------

fn lower(s: []u8) -> String {
    var out = String.new()
    for c in s { out.push_byte(if c >= 'A' and c <= 'Z' { c + 32 } else { c }) }
    return out
}

pub fn platform_tag(target: []u8) -> []u8 {
    let t = lower(target)
    let s = t[..]
    if s.find("windows") != null { return if s.find("aarch64") != null { "win_arm64" } else { "win_amd64" } }
    if s.find("macos") != null or s.find("darwin") != null { return if s.find("aarch64") != null { "macosx_11_0_arm64" } else { "macosx_10_13_x86_64" } }
    if s.find("linux") != null { return if s.find("aarch64") != null { "manylinux_2_17_aarch64" } else { "manylinux_2_17_x86_64" } }
    return "any"
}

fn crc32(data: []u8) -> u32 {
    var table: [256]u32 = undefined
    for i in 0..256 {
        var c = i as u32
        for _ in 0..8 { c = if (c & 1) != 0 { 0xEDB88320 ^ (c >> 1) } else { c >> 1 } }
        table[i] = c
    }
    var crc: u32 = 0xFFFFFFFF
    for b in data { crc = table[((crc ^ (b as u32)) & 0xff) as usize] ^ (crc >> 8) }
    return crc ^ 0xFFFFFFFF
}

fn le16(out: *mut String, v: u32) { out.push_byte((v & 0xff) as u8); out.push_byte(((v >> 8) & 0xff) as u8) }
fn le32(out: *mut String, v: u32) { le16(out, v & 0xffff); le16(out, v >> 16) }

/// A file to put in an archive.
pub struct ZipEntry {
    name: String
    data: String
}

/// A stored (uncompressed) zip archive.
pub fn zip_bytes(files: *List(ZipEntry)) -> String {
    var out = String.new()
    var central = String.new()
    for f in files {
        let offset = out.len as u32
        let crc = crc32(f.data[..])
        let n = f.data.len as u32
        let nl = f.name.len as u32
        // local header
        out.append("PK\x03\x04")
        le16(&mut out, 20); le16(&mut out, 0); le16(&mut out, 0); le16(&mut out, 0); le16(&mut out, 0)
        le32(&mut out, crc); le32(&mut out, n); le32(&mut out, n); le16(&mut out, nl); le16(&mut out, 0)
        out.append(f.name[..])
        out.append(f.data[..])
        // central directory
        central.append("PK\x01\x02")
        le16(&mut central, 20 | (3 << 8)); le16(&mut central, 20); le16(&mut central, 0); le16(&mut central, 0); le16(&mut central, 0); le16(&mut central, 0)
        le32(&mut central, crc); le32(&mut central, n); le32(&mut central, n); le16(&mut central, nl)
        le16(&mut central, 0); le16(&mut central, 0); le16(&mut central, 0); le16(&mut central, 0)
        le32(&mut central, 0o100644 << 16)
        le32(&mut central, offset)
        central.append(f.name[..])
    }
    let cd_offset = out.len as u32
    let cd_size = central.len as u32
    out.append(central[..])
    out.append("PK\x05\x06")
    le16(&mut out, 0); le16(&mut out, 0)
    le16(&mut out, files.len as u32); le16(&mut out, files.len as u32)
    le32(&mut out, cd_size); le32(&mut out, cd_offset); le16(&mut out, 0)
    return out
}

/// The wheel file's bytes and name for a package's files.
pub fn build_wheel(name: []u8, version: []u8, tag: []u8, package_files: *List(ZipEntry), summary: []u8, out_name: *mut String) -> String {
    let dist = format("{}-{}.dist-info", .{name, version})
    var files = List(ZipEntry).new()
    for f in package_files { files.append(ZipEntry{ .name = f.name.clone(), .data = f.data.clone() }) }
    files.append(ZipEntry{ .name = format("{}/METADATA", .{dist}), .data = format("Metadata-Version: 2.1\nName: {}\nVersion: {}\nSummary: {}\nRequires-Python: >=3.8\n", .{name, version, summary}) })
    files.append(ZipEntry{ .name = format("{}/WHEEL", .{dist}), .data = format("Wheel-Version: 1.0\nGenerator: nx\nRoot-Is-Purelib: false\nTag: py3-none-{}\n", .{tag}) })
    files.append(ZipEntry{ .name = format("{}/top_level.txt", .{dist}), .data = format("{}\n", .{name}) })
    var rec = String.new()
    for f in files { rec.append(format("{},sha256=,{}\n", .{f.name, f.data.len})[..]) }
    rec.append(format("{}/RECORD,,\n", .{dist})[..])
    files.append(ZipEntry{ .name = format("{}/RECORD", .{dist}), .data = rec })
    out_name.*= format("{}-{}-py3-none-{}.whl", .{name, version, tag})
    return zip_bytes(&files)
}
