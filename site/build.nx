//! The documentation site, built by a Nexium program: the Markdown under
//! `docs/`, the project files at the root and the chapters of the Topo under
//! `topo/` become one static site in `site/out/`, which GitHub Pages serves.
//!
//!     nx run site/build.nx                 # writes site/out/
//!     nx run site/build.nx -- --out DIR
//!
//! The renderer covers the Markdown the repository writes: ATX headings,
//! paragraphs, fenced code (Nexium is highlighted with the language's own
//! token rules), inline code, emphasis, links (links between the files
//! become links between the pages), images, lists, block quotes, tables,
//! rules and raw HTML lines. `{{include path}}` in a chapter inlines a source
//! file as a code block and `{{output path}}` a recorded output, so the
//! tutorial shows the programs the test harness runs.

import std.fs
import std.strings
import std.json

const REPO = "https://github.com/Londopy/nexium"
const SITE_TITLE = "Nexium"
const SITE_URL = "https://londopy.github.io/nexium/"
const SIDE_SCRIPT = r"<script>(function(){var n=document.querySelector('nav.side');if(!n)return;var k='nx-side-scroll';try{var s=sessionStorage.getItem(k);if(s!==null)n.scrollTop=+s;}catch(e){}var c=n.querySelector('a.current');if(c){var r=c.getBoundingClientRect(),h=n.getBoundingClientRect();if(r.top<h.top+8||r.bottom>h.bottom-8)n.scrollTop+=(r.top-h.top)-n.clientHeight/2+r.height/2;}function save(){try{sessionStorage.setItem(k,n.scrollTop)}catch(e){}}n.addEventListener('scroll',save);n.addEventListener('click',save);window.addEventListener('pagehide',save);})();</script>"

/// The course's progress, kept in the browser: the "done" boxes of the
/// exercises, and the count on every chapter link of the sidebar.
const TOPO_SCRIPT = r"<script>(function(){var k='nx-topo-done';function load(){try{return JSON.parse(localStorage.getItem(k)||'[]')}catch(e){return []}}function save(d){try{localStorage.setItem(k,JSON.stringify(d))}catch(e){}}var done=load();document.querySelectorAll('input[data-done]').forEach(function(b){b.checked=done.indexOf(b.dataset.done)>=0;b.addEventListener('change',function(){done=load();var i=done.indexOf(b.dataset.done);if(b.checked&&i<0)done.push(b.dataset.done);if(!b.checked&&i>=0)done.splice(i,1);save(done);mark();});});function mark(){done=load();document.querySelectorAll('nav.side a[data-chapter]').forEach(function(a){var n=+a.dataset.exercises,c=a.dataset.chapter,h=0;done.forEach(function(d){if(d.indexOf(c+'/')===0)h++;});var s=a.querySelector('.done');if(!s){s=document.createElement('span');s.className='done';a.appendChild(s);}s.textContent=h>=n?' \u2713':(h>0?' '+h+'/'+n:'');});}mark();})();</script>"

/// One page of the site: where it comes from, where it goes, what it is called.
struct Page {
    // "topo", "docs", "reference", "project", "index"
    section: String
    // repository-relative source, forward slashes
    src: String
    // output path under the site root, forward slashes
    out: String
    title: String
}

/// The site's plan: sections in sidebar order; the Topo's chapters in file order.
fn plan() -> List(Page) {
    var pages = List(Page).new()
    pages.append(Page{ .section = String.from("index"), .src = String.from("site/index.md"), .out = String.from("index.html"), .title = String.from("Nexium") })
    // the Topo: every chapter under topo/, numbered by its file name
    let chapters = fs.list("topo") catch { List(String).new() }
    for c in chapters {
        if !c[..].ends_with(".md") { continue }
        let stem = fs.stem(c[..])
        pages.append(Page{ .section = String.from("topo"), .src = fs.join("topo", c[..]), .out = format("topo/{}.html", .{stem}), .title = String.new() })
    }
    let docs = [
        ("docs/install.md", "install"), ("docs/language.md", "language"), ("docs/std.md", "std"), ("docs/repl.md", "repl"),
        ("docs/packages.md", "packages"), ("docs/discord.md", "discord"), ("docs/gui.md", "gui"), ("docs/embedding.md", "embedding"),
        ("docs/numbers.md", "numbers"), ("docs/api.md", "api"),
        ("docs/releasing-your-program.md", "releasing-your-program"), ("docs/architecture.md", "architecture"),
        ("docs/stability.md", "stability"), ("docs/platforms.md", "platforms"), ("docs/release-names.md", "release-names"),
    ]
    for d in docs { pages.append(Page{ .section = String.from("docs"), .src = String.from(d.0), .out = format("docs/{}.html", .{d.1}), .title = String.new() }) }
    let project = [
        ("SPEC.md", "spec"), ("ROADMAP.md", "roadmap"), ("DECISIONS.md", "decisions"), ("CHANGELOG.md", "changelog"),
        ("CONTRIBUTING.md", "contributing"), ("KNOWN_ISSUES.md", "known-issues"), ("SECURITY.md", "security"), ("CLA.md", "cla"),
    ]
    for d in project { pages.append(Page{ .section = String.from("project"), .src = String.from(d.0), .out = format("docs/{}.html", .{d.1}), .title = String.new() }) }
    return pages
}

// ----- text helpers ----------------------------------------------------------------

fn esc(s: []u8) -> String {
    var out = String.with_capacity(s.len)
    for c in s {
        if c == '<' { out.append("&lt;") } else if c == '>' { out.append("&gt;") } else if c == '&' { out.append("&amp;") } else if c == '"' { out.append("&quot;") } else { out.push_byte(c) }
    }
    return out
}

/// A heading's anchor: lower case, runs of anything but letters and digits become one dash.
fn slug(s: []u8) -> String {
    var out = String.new()
    var dash = false
    for c in s {
        let lower = if c >= 'A' and c <= 'Z' { c + 32 } else { c }
        let ok = (lower >= 'a' and lower <= 'z') or (lower >= '0' and lower <= '9')
        if ok {
            if dash and out.len > 0 { out.push_byte('-') }
            dash = false
            out.push_byte(lower)
        } else {
            dash = true
        }
    }
    return out
}

fn is_blank(s: []u8) -> bool { return s.trim().len == 0 }

fn count_prefix(s: []u8, c: u8) -> usize {
    var n: usize = 0
    while n < s.len and s[n] == c { n += 1 }
    return n
}

fn leading_spaces(s: []u8) -> usize { return count_prefix(s, ' ') }

/// The text after `- `, `* ` or `N. `, or null when the line is not a list item.
fn list_item(line: []u8, ordered: *mut bool) -> ?[]u8 {
    let t = strings.trim_left(line)
    if t.len >= 2 and (t[0] == '-' or t[0] == '*') and t[1] == ' ' { ordered.* = false; return t[2..] }
    var i: usize = 0
    while i < t.len and t[i] >= '0' and t[i] <= '9' { i += 1 }
    if i > 0 and i + 1 < t.len and t[i] == '.' and t[i + 1] == ' ' { ordered.* = true; return t[i + 2..] }
    return null
}

// ----- the Nexium highlighter --------------------------------------------------------

const KEYWORDS = ["fn", "let", "var", "const", "struct", "enum", "record", "ref", "class", "trait", "impl", "pub", "import", "return", "if", "else", "for", "while", "match", "break", "continue", "try", "catch", "defer", "errdefer", "comptime", "unsafe", "error", "true", "false", "null", "undefined", "and", "or", "type", "distinct", "where", "into", "artifact", "test", "export", "unreachable", "as", "orelse", "in", "dyn", "weak", "parallel", "extern", "using", "own", "step", "derive", "layout", "self"]

const TYPES = ["i8", "i16", "i32", "i64", "i128", "u8", "u16", "u32", "u64", "u128", "isize", "usize", "f32", "f64", "bool", "char", "void", "never", "String", "List", "Map", "Self"]

fn is_ident_start(c: u8) -> bool { return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_' }
fn is_ident_char(c: u8) -> bool { return is_ident_start(c) or (c >= '0' and c <= '9') }

fn in_list(word: []u8, words: [][]u8) -> bool {
    for w in words { if w == word { return true } }
    return false
}

fn span(out: *mut String, cls: []u8, text: []u8) {
    out.append("<span class=\"")
    out.append(cls)
    out.append("\">")
    out.append(esc(text)[..])
    out.append("</span>")
}

/// Nexium source as HTML with token classes: k keyword, t type, s string,
/// n number, c comment, f function, b builtin, a attribute-like `@name`.
fn highlight_nexium(src: []u8) -> String {
    var out = String.with_capacity(src.len * 2)
    var i: usize = 0
    let n = src.len
    while i < n {
        let c = src[i]
        // comments to the end of the line
        if c == '/' and i + 1 < n and src[i + 1] == '/' {
            var j = i
            while j < n and src[j] != '\n' { j += 1 }
            let cls = if i + 2 < n and (src[i + 2] == '/' or src[i + 2] == '!') { "d" } else { "c" }
            span(&mut out, cls, src[i..j])
            i = j
            continue
        }
        // strings, raw and byte strings
        if c == '"' or ((c == 'r' or c == 'b') and i + 1 < n and src[i + 1] == '"' and (i == 0 or !is_ident_char(src[i - 1]))) {
            let raw = c == 'r'
            var j = if c == '"' { i + 1 } else { i + 2 }
            while j < n and src[j] != '"' {
                if src[j] == '\\' and !raw and j + 1 < n { j += 2 } else { j += 1 }
            }
            if j < n { j += 1 }
            span(&mut out, "s", src[i..j])
            i = j
            continue
        }
        // char literals: 'x', '\n', '\''
        if c == '\'' and i + 1 < n {
            var j = i + 1
            if src[j] == '\\' and j + 1 < n { j += 2 } else { j += 1 }
            while j < n and src[j] != '\'' and src[j] != '\n' and j - i < 12 { j += 1 }
            if j < n and src[j] == '\'' {
                j += 1
                span(&mut out, "s", src[i..j])
                i = j
                continue
            }
        }
        // numbers
        if c >= '0' and c <= '9' {
            var j = i + 1
            while j < n and (is_ident_char(src[j]) or src[j] == '.' and j + 1 < n and src[j + 1] >= '0' and src[j + 1] <= '9') { j += 1 }
            span(&mut out, "n", src[i..j])
            i = j
            continue
        }
        // @builtins
        if c == '@' and i + 1 < n and is_ident_start(src[i + 1]) {
            var j = i + 1
            while j < n and is_ident_char(src[j]) { j += 1 }
            span(&mut out, "b", src[i..j])
            i = j
            continue
        }
        // identifiers, keywords, types, calls
        if is_ident_start(c) {
            var j = i
            while j < n and is_ident_char(src[j]) { j += 1 }
            let word = src[i..j]
            if in_list(word, KEYWORDS[..]) {
                span(&mut out, "k", word)
            } else if in_list(word, TYPES[..]) or (word[0] >= 'A' and word[0] <= 'Z') {
                span(&mut out, "t", word)
            } else if j < n and src[j] == '(' {
                span(&mut out, "f", word)
            } else {
                out.append(esc(word)[..])
            }
            i = j
            continue
        }
        // everything else, one byte at a time, escaped
        out.append(esc(src[i..i + 1])[..])
        i += 1
    }
    return out
}

/// A shell transcript: the `$ ` prompts and comments stand out, the rest is plain.
fn highlight_shell(src: []u8) -> String {
    var out = String.new()
    for line, li in src.lines() {
        if li > 0 { out.append("\n") }
        if line.starts_with("$ ") {
            span(&mut out, "p", "$ ")
            out.append(esc(line[2..])[..])
        } else if line.starts_with("#") {
            span(&mut out, "c", line)
        } else {
            out.append(esc(line)[..])
        }
    }
    return out
}

fn code_block(out: *mut String, lang: []u8, text: []u8) {
    var body = text
    while body.len > 0 and body[body.len - 1] == '\n' { body = body[0..body.len - 1] }
    let l = if lang.len == 0 { "text" } else { lang }
    out.append(format("<pre class=\"code lang-{}\"><code>", .{esc(l)})[..])
    if l == "nexium" or l == "nx" {
        out.append(highlight_nexium(body)[..])
    } else if l == "bash" or l == "sh" or l == "shell" or l == "console" or l == "powershell" {
        out.append(highlight_shell(body)[..])
    } else {
        out.append(esc(body)[..])
    }
    out.append("</code></pre>\n")
}

// ----- inline Markdown ------------------------------------------------------------

/// Where a link in `from` points on the site: another page, an anchor, or GitHub.
struct Links {
    // repository-relative source paths and the site paths they render to
    srcs: List(String)
    outs: List(String)
}

fn resolve_link(links: *Links, from_src: []u8, from_out: []u8, target: []u8) -> String {
    if target.starts_with("http://") or target.starts_with("https://") or target.starts_with("mailto:") or target.starts_with("#") { return String.from(target) }
    // split off an anchor
    var path = target
    var anchor = ""
    if let h = target.find("#") { path = target[0..h]; anchor = target[h..] }
    // a link written in the site's own terms (`../docs/language.html`) stays as it is
    if path.ends_with(".html") { return String.from(target) }
    // resolve against the source file's directory
    let dir = fs.parent(from_src)
    let joined = fs.normalize(fs.join(dir, path)[..])
    let rel = strings.replace(joined[..], "\\", "/")
    for s, i in links.srcs {
        if s[..] == rel[..] {
            var url = relative(from_out, links.outs[i][..])
            url.append(anchor)
            return url
        }
    }
    // the tutorial's images are copied to the same path under the site
    if rel[..].starts_with("topo/img/") { return relative(from_out, rel[..]) }
    // not a page of the site: the file on GitHub
    var url = format("{}/blob/main/{}", .{REPO, rel})
    url.append(anchor)
    return url
}

/// `to` relative to the directory of `from`, both site paths.
fn relative(from: []u8, to: []u8) -> String {
    var up = String.new()
    for c in from { if c == '/' { up.append("../") } }
    up.append(to)
    return up
}

/// Inline Markdown to HTML: code spans, images, links, bold, italic.
fn inline(s: []u8, links: *Links, page: *Page) -> String {
    var out = String.with_capacity(s.len + 16)
    var i: usize = 0
    let n = s.len
    while i < n {
        let c = s[i]
        if c == '`' {
            // a code span, one or more backticks long
            let ticks = count_prefix(s[i..], '`')
            var j = i + ticks
            var close = NONE_IDX
            while j < n {
                if s[j] == '`' and count_prefix(s[j..], '`') == ticks { close = j; break }
                j += 1
            }
            if close != NONE_IDX {
                var body = s[i + ticks..close]
                if body.len > 1 and body[0] == ' ' and body[body.len - 1] == ' ' { body = body[1..body.len - 1] }
                out.append("<code>")
                out.append(esc(body)[..])
                out.append("</code>")
                i = close + ticks
                continue
            }
        }
        if c == '!' and i + 1 < n and s[i + 1] == '[' {
            if let e = link_end(s, i + 1) {
                let alt = s[i + 2..e.0]
                let src = s[e.0 + 2..e.1]
                out.append(format("<img alt=\"{}\" src=\"{}\">", .{esc(alt), esc(resolve_link(links, page.src[..], page.out[..], src)[..])})[..])
                i = e.1 + 1
                continue
            }
        }
        if c == '[' {
            if let e = link_end(s, i) {
                let text = s[i + 1..e.0]
                let target = s[e.0 + 2..e.1]
                out.append(format("<a href=\"{}\">{}</a>", .{esc(resolve_link(links, page.src[..], page.out[..], target)[..]), inline(text, links, page)})[..])
                i = e.1 + 1
                continue
            }
        }
        if c == '*' and i + 1 < n and s[i + 1] == '*' {
            if let e = strings.index_from(s, "**", i + 2) {
                out.append("<strong>")
                out.append(inline(s[i + 2..e], links, page)[..])
                out.append("</strong>")
                i = e + 2
                continue
            }
        }
        if c == '*' and i + 1 < n and s[i + 1] != ' ' {
            if let e = strings.index_from(s, "*", i + 1) {
                if e > i + 1 and s[e - 1] != ' ' {
                    out.append("<em>")
                    out.append(inline(s[i + 1..e], links, page)[..])
                    out.append("</em>")
                    i = e + 1
                    continue
                }
            }
        }
        if c == '<' and i + 1 < n and (s[i + 1..].starts_with("https://") or s[i + 1..].starts_with("http://")) {
            if let e = strings.index_from(s, ">", i) {
                let url = s[i + 1..e]
                out.append(format("<a href=\"{}\">{}</a>", .{esc(url), esc(url)})[..])
                i = e + 1
                continue
            }
        }
        if c == '<' or c == '>' or c == '&' or c == '"' {
            out.append(esc(s[i..i + 1])[..])
        } else {
            out.push_byte(c)
        }
        i += 1
    }
    return out
}

const NONE_IDX: usize = 18446744073709551615

/// For `[text](target)` starting at `open`: the index of `]` and of the closing `)`.
fn link_end(s: []u8, open: usize) -> ?(usize, usize) {
    var depth: usize = 0
    var i = open
    var close = NONE_IDX
    while i < s.len {
        if s[i] == '`' {
            // a code span inside the text: skip to its end
            let ticks = count_prefix(s[i..], '`')
            var j = i + ticks
            while j < s.len and ! (s[j] == '`' and count_prefix(s[j..], '`') == ticks) { j += 1 }
            i = if j < s.len { j + ticks } else { s.len }
            continue
        }
        if s[i] == '[' { depth += 1 }
        if s[i] == ']' { depth -= 1; if depth == 0 { close = i; break } }
        i += 1
    }
    if close == NONE_IDX or close + 1 >= s.len or s[close + 1] != '(' { return null }
    var j = close + 2
    var pdepth: usize = 1
    while j < s.len {
        if s[j] == '(' { pdepth += 1 }
        if s[j] == ')' { pdepth -= 1; if pdepth == 0 { return (close, j) } }
        if s[j] == ' ' or s[j] == '\n' { return null }
        j += 1
    }
    return null
}

// ----- block Markdown ---------------------------------------------------------------

/// A heading the page has, for the table of contents.
struct Heading {
    level: usize
    text: String
    id: String
}

/// The rendered body of one Markdown file and its headings; the first `# `
/// heading is the title and is not repeated in the body.
fn render_markdown(src: []u8, links: *Links, page: *Page, title: *mut String, headings: *mut List(Heading)) -> String {
    var out = String.with_capacity(src.len * 2)
    var lines = List([]u8).new()
    for l in src.lines() { lines.append(l) }
    let n = lines.len
    var i: usize = 0
    var para = List([]u8).new()
    var list_depths = List(usize).new()
    var list_ordered = List(bool).new()

    while i < n {
        let line = lines[i]

        // a fenced code block, or an include of a source file
        if line.starts_with("```") or line.starts_with("{{include ") or line.starts_with("{{output ") {
            flush_para(&mut out, &mut para, links, page)
            close_lists(&mut out, &mut list_depths, &mut list_ordered, 0)
            if line.starts_with("```") {
                let lang = String.from(line[3..].trim())
                var body = String.new()
                i += 1
                while i < n and !lines[i].starts_with("```") { body.append(lines[i]); body.append("\n"); i += 1 }
                i += 1
                code_block(&mut out, lang[..], body[..])
            } else {
                let is_code = line.starts_with("{{include ")
                let start: usize = if is_code { 10 } else { 9 }
                let end = line.find("}}") orelse line.len
                let path = line[start..end].trim()
                let text = fs.read(path) catch { format("(missing {})", .{path}) }
                let ext = fs.extension(path)
                let lang = if !is_code { "text" } else if ext == "nx" { "nexium" } else if ext == "toml" { "toml" } else if ext == "sh" { "bash" } else { "text" }
                out.append(format("<div class=\"included\"><span class=\"file\">{}</span>", .{esc(path)})[..])
                code_block(&mut out, lang, text[..])
                out.append("</div>\n")
                i += 1
            }
            continue
        }

        if is_blank(line) {
            flush_para(&mut out, &mut para, links, page)
            // a blank line inside a list keeps the list open only when the next item continues it
            var next = i + 1
            while next < n and is_blank(lines[next]) { next += 1 }
            var ordered = false
            if list_depths.len > 0 and (next >= n or list_item(lines[next], &mut ordered) == null) { close_lists(&mut out, &mut list_depths, &mut list_ordered, 0) }
            i += 1
            continue
        }

        // headings
        let hashes = count_prefix(line, '#')
        if hashes >= 1 and hashes <= 6 and line.len > hashes and line[hashes] == ' ' {
            flush_para(&mut out, &mut para, links, page)
            close_lists(&mut out, &mut list_depths, &mut list_ordered, 0)
            let text = line[hashes + 1..].trim()
            if hashes == 1 and title.len == 0 {
                title.* = String.from(text)
            } else {
                let id = slug(text)
                headings.append(Heading{ .level = hashes, .text = String.from(text), .id = id.clone() })
                out.append(format("<h{} id=\"{}\">{}<a class=\"anchor\" href=\"#{}\">#</a></h{}>\n", .{hashes, id, inline(text, links, page), id, hashes})[..])
            }
            i += 1
            continue
        }

        // a rule
        if (line.starts_with("---") or line.starts_with("***")) and line.trim().len >= 3 and strings.trim_right(line)[..].len == count_prefix(strings.trim_right(line), line[0]) {
            flush_para(&mut out, &mut para, links, page)
            close_lists(&mut out, &mut list_depths, &mut list_ordered, 0)
            out.append("<hr>\n")
            i += 1
            continue
        }

        // a block quote
        if line.starts_with(">") {
            flush_para(&mut out, &mut para, links, page)
            close_lists(&mut out, &mut list_depths, &mut list_ordered, 0)
            var inner = String.new()
            while i < n and lines[i].starts_with(">") {
                var t = lines[i][1..]
                if t.len > 0 and t[0] == ' ' { t = t[1..] }
                inner.append(t)
                inner.append("\n")
                i += 1
            }
            var qt = String.new()
            var qh = List(Heading).new()
            out.append("<blockquote>\n")
            out.append(render_markdown(inner[..], links, page, &mut qt, &mut qh)[..])
            out.append("</blockquote>\n")
            continue
        }

        // a table: a header row, a separator row, body rows
        if line.starts_with("|") and i + 1 < n and lines[i + 1].starts_with("|") and lines[i + 1].find("---") != null {
            flush_para(&mut out, &mut para, links, page)
            close_lists(&mut out, &mut list_depths, &mut list_ordered, 0)
            out.append("<div class=\"table\"><table>\n<thead><tr>")
            for cell in table_cells(line) { out.append(format("<th>{}</th>", .{inline(cell, links, page)})[..]) }
            out.append("</tr></thead>\n<tbody>\n")
            i += 2
            while i < n and lines[i].starts_with("|") {
                out.append("<tr>")
                for cell in table_cells(lines[i]) { out.append(format("<td>{}</td>", .{inline(cell, links, page)})[..]) }
                out.append("</tr>\n")
                i += 1
            }
            out.append("</tbody>\n</table></div>\n")
            continue
        }

        // raw HTML: a line that opens a tag is passed through to the blank line
        if line.starts_with("<") and line.len > 1 and (is_ident_start(line[1]) or line[1] == '/' or line[1] == '!') {
            flush_para(&mut out, &mut para, links, page)
            close_lists(&mut out, &mut list_depths, &mut list_ordered, 0)
            while i < n and !is_blank(lines[i]) { out.append(lines[i]); out.append("\n"); i += 1 }
            continue
        }

        // list items, nested by indentation
        var ordered = false
        if let item = list_item(line, &mut ordered) {
            flush_para(&mut out, &mut para, links, page)
            let depth = leading_spaces(line) / 2 + 1
            close_lists(&mut out, &mut list_depths, &mut list_ordered, depth)
            if list_depths.len < depth {
                list_depths.append(depth)
                list_ordered.append(ordered)
                out.append(if ordered { "<ol>\n" } else { "<ul>\n" })
            } else {
                out.append("</li>\n")
            }
            // continuation lines of the item, indented deeper than its marker
            var text = String.from(item)
            var j = i + 1
            while j < n and !is_blank(lines[j]) {
                var o2 = false
                if list_item(lines[j], &mut o2) != null or lines[j].starts_with("```") or lines[j].starts_with("#") { break }
                text.append(" ")
                text.append(lines[j].trim())
                j += 1
            }
            out.append(format("<li>{}", .{inline(text[..], links, page)})[..])
            i = j
            continue
        }

        // a paragraph line
        para.append(line)
        i += 1
    }
    flush_para(&mut out, &mut para, links, page)
    close_lists(&mut out, &mut list_depths, &mut list_ordered, 0)
    return out
}

fn table_cells(line: []u8) -> List([]u8) {
    var cells = List([]u8).new()
    var t = line.trim()
    if t.len > 0 and t[0] == '|' { t = t[1..] }
    if t.len > 0 and t[t.len - 1] == '|' { t = t[0..t.len - 1] }
    // a `\|` inside a cell is a literal bar; split on the others
    var start: usize = 0
    var i: usize = 0
    while i <= t.len {
        if i == t.len or (t[i] == '|' and (i == 0 or t[i - 1] != '\\')) {
            cells.append(t[start..i].trim())
            start = i + 1
        }
        i += 1
    }
    return cells
}

fn flush_para(out: *mut String, para: *mut List([]u8), links: *Links, page: *Page) {
    if para.len == 0 { return }
    var text = String.new()
    for l, i in para.* {
        if i > 0 { text.append(" ") }
        text.append(l.trim())
    }
    out.append("<p>")
    out.append(inline(text[..], links, page)[..])
    out.append("</p>\n")
    para.clear()
}

fn close_lists(out: *mut String, depths: *mut List(usize), ordered: *mut List(bool), keep: usize) {
    while depths.len > keep {
        let o = ordered.pop().?
        _ = depths.pop()
        out.append(if o { "</li>\n</ol>\n" } else { "</li>\n</ul>\n" })
    }
}

// ----- the page shell -----------------------------------------------------------------

const CSS = r"
:root { --bg: #ffffff; --fg: #1b1f27; --muted: #5d6675; --line: #e3e6eb; --side: #f6f7f9; --accent: #5b4bd6; --accent-2: #0f9d8a; --code-bg: #f3f4f7; --k: #a626a4; --t: #0b6e99; --s: #3e7f2f; --n: #b36b00; --c: #7a8290; --f: #4b5bd6; --b: #c0392b; }
@media (prefers-color-scheme: dark) { :root { --bg: #0f1117; --fg: #e6e8ee; --muted: #9aa3b2; --line: #262b36; --side: #141821; --accent: #9d8cff; --accent-2: #4fd1c5; --code-bg: #171b25; --k: #d68cf0; --t: #67c8ff; --s: #9ad27a; --n: #f0b25a; --c: #7d8798; --f: #9fb0ff; --b: #ff7b72; } }
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; font: 16px/1.6 -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: var(--fg); background: var(--bg); }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
code, pre { font-family: ui-monospace, 'Cascadia Code', 'JetBrains Mono', Consolas, 'Liberation Mono', Menlo, monospace; font-size: 0.92em; }
code { background: var(--code-bg); padding: 0.1em 0.35em; border-radius: 4px; overflow-wrap: anywhere; }
pre.code { background: var(--code-bg); border: 1px solid var(--line); border-radius: 8px; padding: 0.9rem 1.1rem; overflow-x: auto; line-height: 1.5; }
pre.code code { background: none; padding: 0; font-size: 0.9em; }
.k { color: var(--k); font-weight: 600; } .t { color: var(--t); } .s { color: var(--s); } .n { color: var(--n); } .c { color: var(--c); font-style: italic; } .d { color: var(--c); } .f { color: var(--f); } .b { color: var(--b); } .p { color: var(--muted); }
.layout { display: grid; grid-template-columns: 270px minmax(0, 1fr); min-height: 100vh; }
nav.side { background: var(--side); border-right: 1px solid var(--line); padding: 1.2rem 1rem 3rem; position: sticky; top: 0; height: 100vh; overflow-y: auto; }
nav.side .brand { display: flex; align-items: center; gap: 0.6rem; font-weight: 700; font-size: 1.15rem; margin-bottom: 1rem; color: var(--fg); }
nav.side .brand img { width: 30px; height: 30px; }
nav.side h4 { margin: 1.1rem 0 0.35rem; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
nav.side a { display: block; padding: 0.22rem 0.5rem; border-radius: 6px; color: var(--fg); font-size: 0.93rem; }
nav.side a:hover { background: var(--line); text-decoration: none; }
nav.side a.current { background: var(--accent); color: #fff; }
nav.side a .num { color: var(--muted); font-variant-numeric: tabular-nums; margin-right: 0.35rem; }
nav.side a.current .num { color: #eee; }
main { padding: 2rem 3rem 4rem; max-width: 62rem; }
main { overflow-wrap: break-word; }
main h1 { font-size: 2.1rem; margin: 0 0 1rem; line-height: 1.2; }
main h2 { margin-top: 2.2rem; border-bottom: 1px solid var(--line); padding-bottom: 0.3rem; }
main h3 { margin-top: 1.6rem; }
main h2 .anchor, main h3 .anchor, main h4 .anchor { opacity: 0; margin-left: 0.4rem; font-weight: 400; color: var(--muted); }
main h2:hover .anchor, main h3:hover .anchor, main h4:hover .anchor { opacity: 1; }
main img { max-width: 100%; }
.table { overflow-x: auto; margin: 1rem 0; -webkit-overflow-scrolling: touch; }
table { border-collapse: collapse; width: 100%; font-size: 0.93rem; }
th, td { border: 1px solid var(--line); padding: 0.4rem 0.6rem; text-align: left; vertical-align: top; }
th { background: var(--side); }
blockquote { margin: 1rem 0; padding: 0.2rem 1rem; border-left: 4px solid var(--accent-2); color: var(--muted); }
hr { border: 0; border-top: 1px solid var(--line); margin: 2rem 0; }
.included .file { display: inline-block; font-family: ui-monospace, Consolas, monospace; font-size: 0.78rem; color: var(--muted); background: var(--side); border: 1px solid var(--line); border-bottom: 0; border-radius: 6px 6px 0 0; padding: 0.15rem 0.6rem; }
.included pre.code { margin-top: 0; border-top-left-radius: 0; }
.toc { float: right; width: 15rem; margin: 0 0 1rem 1.5rem; padding: 0.6rem 0.9rem; border: 1px solid var(--line); border-radius: 8px; background: var(--side); font-size: 0.85rem; }
.toc h4 { margin: 0 0 0.3rem; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
.toc a { display: block; color: var(--fg); padding: 0.1rem 0; }
.toc a.l3 { padding-left: 0.9rem; color: var(--muted); }
.exercise { margin: 1.5rem 0 2rem; padding: 0 0 0 1rem; border-left: 4px solid var(--accent-2); }
.exercise h3 { margin-top: 0; }
.exercise .kind { display: inline-block; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin-left: 0.5rem; }
.exercise details { margin: 0.5rem 0; }
.exercise summary { cursor: pointer; color: var(--accent); }
.exercise label.done { display: inline-block; margin-top: 0.4rem; font-size: 0.9rem; color: var(--muted); cursor: pointer; }
.quiz ol { padding-left: 1.4rem; }
.quiz ol > li { margin-bottom: 0.9rem; }
.quiz ul { list-style: none; padding-left: 0.4rem; margin: 0.3rem 0; }
.quiz ul li { margin: 0.1rem 0; }
.quiz details { margin: 0.2rem 0; }
.quiz summary { cursor: pointer; color: var(--accent); font-size: 0.9rem; }
nav.side a .done { color: var(--accent); margin-left: 0.3rem; font-size: 0.85em; }
.pager { display: flex; justify-content: space-between; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--line); gap: 1rem; }
.pager a { max-width: 48%; }
.pager .label { display: block; font-size: 0.75rem; color: var(--muted); }
footer { margin-top: 3rem; color: var(--muted); font-size: 0.85rem; }
.hero { padding: 1rem 0 2rem; }
.hero h1 { font-size: 2.6rem; }
.hero p.tag { font-size: 1.2rem; color: var(--muted); max-width: 46rem; }
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1rem; margin: 1.5rem 0; }
.card { border: 1px solid var(--line); border-radius: 10px; padding: 1rem 1.1rem; background: var(--side); }
.card h3 { margin: 0 0 0.4rem; }
.card p { margin: 0; color: var(--muted); font-size: 0.93rem; }
.two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1rem; }
.play-bar { display: flex; align-items: center; gap: 0.5rem; margin: -0.6rem 0 0.8rem; flex-wrap: wrap; }
.play-bar button, .play-guess button { font: inherit; font-size: 0.85rem; padding: 0.25rem 0.9rem; border-radius: 6px; border: 1px solid var(--line); background: var(--side); color: var(--fg); cursor: pointer; }
.play-bar button.play-run { background: var(--accent); border-color: var(--accent); color: #fff; }
.play-bar button:disabled { opacity: 0.6; cursor: progress; }
.play-status { font-size: 0.85rem; color: var(--muted); }
pre.code code[contenteditable] { outline: none; display: block; min-height: 1.5em; caret-color: var(--accent); }
pre.code code.edited span { color: inherit; font-weight: inherit; font-style: inherit; }
pre.code:focus-within { border-color: var(--accent); }
.play-out { margin: 0 0 1rem; }
.play-out pre { margin: 0 0 0.4rem; padding: 0.6rem 0.9rem; border-radius: 6px; border: 1px dashed var(--line); background: var(--bg); white-space: pre-wrap; font-size: 0.85em; }
.play-out pre.play-stderr { color: var(--b); }
.play-out pre.play-empty { color: var(--muted); }
.play-verdict { margin: 0.3rem 0; font-weight: 600; }
.play-ok { color: var(--accent-2); }
.play-no { color: var(--b); }
.play-guess { margin: 0 0 0.8rem; }
.quiz ul[data-right] li { cursor: pointer; padding: 0.1rem 0.4rem; border-radius: 4px; }
.quiz ul[data-right] li:hover { background: var(--side); }
.quiz li.q-right { color: var(--accent-2); font-weight: 600; }
.quiz li.q-right::before { content: '\2713  '; }
.quiz li.q-wrong { color: var(--b); text-decoration: line-through; }
.quiz p.says { margin: 0.4rem 0 0.2rem; font-size: 0.85rem; color: var(--muted); }
.play-guess textarea { display: block; width: 100%; font-family: ui-monospace, Consolas, monospace; font-size: 0.85em; padding: 0.5rem 0.7rem; border: 1px solid var(--line); border-radius: 6px; background: var(--code-bg); color: var(--fg); margin-bottom: 0.4rem; }
.menu-toggle, .menu-label { display: none; }
.brand-row { display: flex; align-items: center; justify-content: space-between; }
@media (max-width: 900px) {
  .layout { grid-template-columns: minmax(0, 1fr); }
  nav.side { position: static; height: auto; border-right: 0; border-bottom: 1px solid var(--line); padding-bottom: 0.8rem; }
  nav.side .brand { margin-bottom: 0; }
  .menu-label { display: inline-block; cursor: pointer; padding: 0.3rem 0.8rem; border: 1px solid var(--line); border-radius: 6px; font-size: 0.9rem; color: var(--fg); }
  nav.side .menu { display: none; margin-top: 0.8rem; }
  .menu-toggle:checked ~ .layout nav.side .menu { display: block; }
  nav.side a { padding: 0.45rem 0.6rem; font-size: 1rem; }
  main { padding: 1.2rem 1rem 3rem; }
  main h1 { font-size: 1.75rem; }
  .hero h1 { font-size: 2.1rem; }
  .hero p.tag { font-size: 1.1rem; }
  .toc { float: none; width: auto; margin: 0 0 1rem; }
  .two { grid-template-columns: minmax(0, 1fr); }
  .cards { grid-template-columns: minmax(0, 1fr); }
  pre.code { padding: 0.8rem 0.9rem; font-size: 0.9em; }
  .pager { flex-direction: column; }
  .pager a { max-width: none; }
}
"

fn page_head(out: *mut String, title: []u8, root: []u8, description: []u8) {
    out.append("<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"theme-color\" content=\"#ffffff\" media=\"(prefers-color-scheme: light)\">\n<meta name=\"theme-color\" content=\"#0f1117\" media=\"(prefers-color-scheme: dark)\">\n")
    out.append(format("<title>{}</title>\n", .{esc(title)})[..])
    if description.len > 0 { out.append(format("<meta name=\"description\" content=\"{}\">\n", .{esc(description)})[..]) }
    // the card a link to the page gets on social sites and in chats
    out.append(format("<meta property=\"og:title\" content=\"{}\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:image\" content=\"{}assets/social-preview.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n", .{esc(title), SITE_URL})[..])
    if description.len > 0 { out.append(format("<meta property=\"og:description\" content=\"{}\">\n", .{esc(description)})[..]) }
    out.append(format("<link rel=\"icon\" href=\"{}assets/logo.svg\">\n<link rel=\"stylesheet\" href=\"{}style.css\">\n<script src=\"{}play.js\" data-wasm=\"play/nx.wasm\" defer></script>\n</head>\n<body>\n<input type=\"checkbox\" id=\"menu\" class=\"menu-toggle\">\n<div class=\"layout\">\n", .{root, root, root})[..])
}

fn nav_link(out: *mut String, root: []u8, p: *Page, current: bool, number: usize) {
    out.append(format("<a href=\"{}{}\"{}", .{root, p.out, if current { " class=\"current\"" } else { "" }})[..])
    if p.section[..] == "topo" {
        let n = exercise_count(fs.stem(p.src[..]))
        if n > 0 { out.append(format(" data-chapter=\"{}\" data-exercises=\"{}\"", .{fs.stem(p.src[..]), n})[..]) }
    }
    out.append(">")
    if number > 0 { out.append(format("<span class=\"num\">{}</span>", .{number})[..]) }
    out.append(esc(p.title[..])[..])
    out.append("</a>\n")
}

fn sidebar(out: *mut String, pages: *List(Page), current: usize, root: []u8) {
    out.append("<nav class=\"side\">\n")
    out.append(format("<div class=\"brand-row\"><a class=\"brand\" href=\"{}index.html\"><img src=\"{}assets/logo.svg\" alt=\"\">Nexium</a><label for=\"menu\" class=\"menu-label\">Menu</label></div>\n<div class=\"menu\">\n", .{root, root})[..])
    out.append("<h4>The Topo</h4>\n")
    var num: usize = 0
    for p, i in pages.* {
        if p.section[..] != "topo" { continue }
        num += 1
        nav_link(out, root, &p, i == current, num)
    }
    out.append("<h4>Docs</h4>\n")
    for p, i in pages.* { if p.section[..] == "docs" { nav_link(out, root, &p, i == current, 0) } }
    out.append("<h4>Project</h4>\n")
    for p, i in pages.* { if p.section[..] == "project" { nav_link(out, root, &p, i == current, 0) } }
    out.append(format("<h4>Elsewhere</h4>\n<a href=\"{}\">GitHub</a>\n<a href=\"{}/releases\">Releases</a>\n<a href=\"{}/issues\">Issues</a>\n", .{REPO, REPO, REPO})[..])
    out.append("</div>\n</nav>\n")
    // the menu keeps its scroll position from page to page, and the current
    // page's link is brought into view when it is not
    out.append(SIDE_SCRIPT)
    out.append("\n")
}

// ----- the course: exercises and quizzes ---------------------------------------------

/// The exercise files of a chapter (starters only), sorted.
fn exercise_files(stem: []u8) -> List(String) {
    var out = List(String).new()
    let dir = fs.join("topo/exercises", stem)
    let names = fs.list(dir[..]) catch { return out }
    for nm in names {
        if !nm[..].ends_with(".nx") or nm[..].ends_with(".solution.nx") { continue }
        out.append(nm.clone())
    }
    return out
}

/// How many exercises a chapter has, its quiz counted as one.
fn exercise_count(stem: []u8) -> usize {
    var n = exercise_files(stem).len
    if fs.exists(fs.join(fs.join("topo/exercises", stem)[..], "quiz.txt")[..]) { n += 1 }
    return n
}

/// The kind of an exercise from its name's prefix, spelled out (the same
/// words `nx topo` uses).
fn kind_label(name: []u8) -> []u8 {
    if name.starts_with("fill_") { return "fill in the blank" }
    if name.starts_with("fix_") { return "fix the error" }
    if name.starts_with("write_") { return "write it" }
    if name.starts_with("test_") { return "make the tests pass" }
    if name.starts_with("predict_") { return "predict the output" }
    return "exercise"
}

/// The header of an exercise file: the task lines and the hints, the rest
/// being the code shown.
fn split_exercise(source: []u8, task: *mut List(String), hints: *mut List(String)) -> String {
    var code = String.new()
    var in_header = true
    var first = true
    for l in source.lines() {
        if in_header {
            let t = l.trim()
            if first { first = false; if t.starts_with("// topo:") { continue } }
            if let h = strings.strip_prefix(t, "// hint:") { hints.append(String.from(h.trim())); continue }
            if t.starts_with("//") {
                let r = t[2..].trim()
                if r.len > 0 { task.append(String.from(r)) }
                continue
            }
            in_header = false
        }
        code.append(l)
        code.append("\n")
    }
    return code
}

/// The Exercises section at the end of a chapter, when it has any.
fn exercises_section(out: *mut String, stem: []u8, links: *Links, page: *Page) {
    let files = exercise_files(stem)
    let dir = fs.join("topo/exercises", stem)
    let quiz_path = fs.join(dir[..], "quiz.txt")
    let has_quiz = fs.exists(quiz_path[..])
    if files.len == 0 and !has_quiz { return }
    out.append("<h2 id=\"exercises\">Exercises<a class=\"anchor\" href=\"#exercises\">#</a></h2>\n")
    out.append(format("<p>The compiler grades these: <code>nx topo {}</code> writes them into a directory, <code>nx topo check</code> runs them. Or do them here: the code is editable, <b>Run</b> runs it with the compiler in the page (it loads on the first run and never sends your code anywhere), <b>Check</b> grades it as <code>nx topo check</code> would, and <b>Reset</b> puts the exercise back. Ctrl+Enter runs.</p>\n", .{chapter_number(stem)})[..])
    for f in files {
        let name = fs.stem(f[..])
        let path = fs.join(dir[..], f[..])
        let source = fs.read(path[..]) catch { continue }
        var task = List(String).new()
        var hints = List(String).new()
        let code = split_exercise(source[..], &mut task, &mut hints)
        let key = format("{}/{}", .{stem, name})
        let kind = if name[..].starts_with("fill_") { "fill" } else if name[..].starts_with("fix_") { "fix" } else if name[..].starts_with("predict_") { "predict" } else if name[..].starts_with("write_") { "write" } else { "test" }
        let expected_attr = fs.read(fs.join(dir[..], format("{}.expected", .{name})[..])[..]) catch { String.new() }
        let data = if expected_attr.len > 0 { format(" data-expected=\"{}\"", .{esc(expected_attr[..])}) } else { String.new() }
        out.append(format("<div class=\"exercise\" id=\"{}\" data-kind=\"{}\"{}>\n<h3>{}<span class=\"kind\">{}</span></h3>\n", .{esc(name[..]), esc(kind), data, esc(name[..]), kind_label(name[..])})[..])
        for t in task { out.append(format("<p>{}</p>\n", .{inline(t[..], links, page)})[..]) }
        out.append(format("<div class=\"included\"><span class=\"file\">{}.nx</span>", .{esc(name[..])})[..])
        code_block(out, "nexium", code[..])
        out.append("</div>\n")
        let expected_path = fs.join(dir[..], format("{}.expected", .{name})[..])
        let is_predict = name.starts_with("predict_")
        let expected = fs.read(expected_path[..]) catch { String.new() }
        if expected.len > 0 {
            out.append(if is_predict { "<details><summary>What does it print?</summary>" } else { "<details><summary>The recorded output</summary>" })
            code_block(out, "text", expected[..])
            out.append("</details>\n")
        }
        if hints.len > 0 {
            out.append("<details><summary>Hints</summary><ul>")
            for h in hints { out.append(format("<li>{}</li>", .{inline(h[..], links, page)})[..]) }
            out.append("</ul></details>\n")
        }
        let solution_path = fs.join(dir[..], format("{}.solution.nx", .{name})[..])
        let solution = fs.read(solution_path[..]) catch { String.new() }
        if solution.len > 0 {
            out.append("<details><summary>Solution</summary>")
            code_block(out, "nexium", solution[..])
            out.append("</details>\n")
        }
        out.append(format("<label class=\"done\"><input type=\"checkbox\" data-done=\"{}\"> done</label>\n</div>\n", .{esc(key[..])})[..])
    }
    if has_quiz {
        let text = fs.read(quiz_path[..]) catch { String.new() }
        out.append("<div class=\"quiz exercise\" id=\"quiz\">\n<h3>Quiz<span class=\"kind\">no peeking</span></h3>\n<ol>\n")
        var open = false
        var right = String.new()
        var right_at: usize = 0
        var choices = List(String).new()
        // a question the compiler answers: its program, and the compiler's words
        var code = String.new()
        var says = String.new()
        for l in text[..].lines() {
            let t = l.trim()
            if t.len == 0 { continue }
            if let q = strings.strip_prefix(t, "Q:") {
                if open { flush_quiz(out, &choices, right_at, links, page); out.append("</li>\n") }
                out.append(format("<li>{}\n", .{inline(q.trim(), links, page)})[..])
                open = true
                right = String.new()
                choices = List(String).new()
                code = String.new()
                says = String.new()
                continue
            }
            if t == "|" or t.starts_with("| ") {
                let at = l.find("| ") orelse l.len
                code.append(if at < l.len { l[at + 2..l.len] } else { "" })
                code.append("\n")
                continue
            }
            if strings.strip_prefix(t, "ask:") != null { continue }
            if let w = strings.strip_prefix(t, "says:") { says.append(w.trim()); says.append("\n"); continue }
            if code.len > 0 and (t.starts_with("* ") or t.starts_with("- ")) {
                code_block(out, "nexium", code[..])
                code = String.new()
            }
            if let c = strings.strip_prefix(t, "* ") { right = String.from(c); right_at = choices.len; choices.append(String.from(c)); continue }
            if let c = strings.strip_prefix(t, "- ") { choices.append(String.from(c)); continue }
            if let w = strings.strip_prefix(t, ">") {
                flush_quiz(out, &choices, right_at, links, page)
                choices = List(String).new()
                out.append(format("<details><summary>Answer</summary><p><b>{}</b>. {}</p>", .{inline(right[..], links, page), inline(w.trim(), links, page)})[..])
                if says.len > 0 {
                    out.append("<p class=\"says\">The compiler says:</p>")
                    code_block(out, "text", says[..])
                }
                out.append("</details>\n")
                right = String.new()
            }
        }
        if open { flush_quiz(out, &choices, right_at, links, page); out.append("</li>\n") }
        out.append(format("</ol>\n<label class=\"done\"><input type=\"checkbox\" data-done=\"{}/quiz\"> done</label>\n</div>\n", .{esc(stem)})[..])
    }
}

/// The choices of a question, once; the page grades a click against `right`.
fn flush_quiz(out: *mut String, choices: *List(String), right: usize, links: *Links, page: *Page) {
    if choices.len == 0 { return }
    out.append(format("<ul data-right=\"{}\">", .{right})[..])
    for c in choices.* { out.append(format("<li>{}</li>", .{inline(c[..], links, page)})[..]) }
    out.append("</ul>\n")
}

/// The chapter's number from its stem ("05-values-and-types" is 5).
fn chapter_number(stem: []u8) -> usize {
    var n: usize = 0
    for c in stem {
        if c < '0' or c > '9' { break }
        n = n * 10 + (c - '0') as usize
    }
    return n
}

fn toc(out: *mut String, headings: *List(Heading), links: *Links, page: *Page) {
    var count: usize = 0
    for h in headings.* { if h.level == 2 or h.level == 3 { count += 1 } }
    if count < 3 { return }
    out.append("<div class=\"toc\"><h4>On this page</h4>\n")
    for h in headings.* {
        if h.level == 2 { out.append(format("<a href=\"#{}\">{}</a>\n", .{h.id, inline(h.text[..], links, page)})[..]) }
        else if h.level == 3 { out.append(format("<a class=\"l3\" href=\"#{}\">{}</a>\n", .{h.id, inline(h.text[..], links, page)})[..]) }
    }
    out.append("</div>\n")
}

fn pager(out: *mut String, pages: *List(Page), current: usize, root: []u8) {
    if pages.*[current].section[..] != "topo" { return }
    var prev = NONE_IDX
    var next = NONE_IDX
    for p, i in pages.* {
        if p.section[..] != "topo" { continue }
        if i < current { prev = i }
        if i > current and next == NONE_IDX { next = i }
    }
    out.append("<div class=\"pager\">\n")
    if prev != NONE_IDX { out.append(format("<a href=\"{}{}\"><span class=\"label\">Previous</span>{}</a>", .{root, pages.*[prev].out, esc(pages.*[prev].title[..])})[..]) } else { out.append("<span></span>") }
    if next != NONE_IDX { out.append(format("<a href=\"{}{}\" style=\"text-align:right\"><span class=\"label\">Next</span>{}</a>", .{root, pages.*[next].out, esc(pages.*[next].title[..])})[..]) } else { out.append("<span></span>") }
    out.append("</div>\n")
}

fn footer(out: *mut String, src: []u8) {
    out.append(format("<footer>Nexium is MIT licensed. This page is built from <a href=\"{}/blob/main/{}\">{}</a> by <code>site/build.nx</code>, a Nexium program.</footer>\n", .{REPO, src, esc(src)})[..])
    out.append("</main>\n</div>\n</body>\n</html>\n")
}

// ----- the API: JSON documents from the tree --------------------------------------

/// The value of `const NAME = "..."` in a source file, or "".
fn const_str(text: []u8, name: []u8) -> String {
    let key = format("const {} = \"", .{name})
    let at = text.find(key[..]) orelse return String.new()
    let rest = text[at + key.len..]
    let end = rest.find("\"") orelse return String.new()
    return String.from(rest[..end])
}

/// A JSON string of a slice.
fn js(s: []u8) -> json.Json { return json.string(s) }

/// The current release: version, name, date and every asset's URL.
fn api_latest(version: []u8, name: []u8, date: []u8) -> json.Json {
    var doc = json.object()
    json.set(&mut doc, "version", js(version))
    json.set(&mut doc, "name", js(name))
    json.set(&mut doc, "date", js(date))
    let tag = format("v{}", .{version})
    json.set(&mut doc, "tag", js(tag[..]))
    json.set(&mut doc, "release", js(format("{}/releases/tag/{}", .{REPO, tag})[..]))
    let base = format("{}/releases/download/{}", .{REPO, tag})
    var downloads = json.object()
    json.set(&mut downloads, "windows-x64-installer", js(format("{}/nexium-{}-setup-x64.exe", .{base, version})[..]))
    for t in ["x86_64-pc-windows-msvc", "aarch64-pc-windows-msvc"] {
        json.set(&mut downloads, t, js(format("{}/nx-{}-{}.zip", .{base, tag, t})[..]))
    }
    for t in ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu", "aarch64-apple-darwin"] {
        json.set(&mut downloads, t, js(format("{}/nx-{}-{}.tar.gz", .{base, tag, t})[..]))
    }
    json.set(&mut downloads, "one-c-file", js(format("https://raw.githubusercontent.com/Londopy/nexium/{}/bootstrap/nx.c", .{tag})[..]))
    json.set(&mut downloads, "vscode-extension", js(format("{}/nexium-{}.vsix", .{base, tag})[..]))
    json.set(&mut downloads, "deb-amd64", js(format("{}/nexium_{}_amd64.deb", .{base, version})[..]))
    json.set(&mut downloads, "deb-arm64", js(format("{}/nexium_{}_arm64.deb", .{base, version})[..]))
    json.set(&mut downloads, "rpm-x86_64", js(format("{}/nexium-{}-1.x86_64.rpm", .{base, version})[..]))
    json.set(&mut downloads, "rpm-aarch64", js(format("{}/nexium-{}-1.aarch64.rpm", .{base, version})[..]))
    json.set(&mut doc, "downloads", downloads)
    json.set(&mut doc, "checksums", js(format("{}/SHA256SUMS.txt", .{base})[..]))
    var registries = json.object()
    json.set(&mut registries, "pypi", js("nexium-lang"))
    json.set(&mut registries, "npm", js("nexium-lang"))
    json.set(&mut registries, "docker", js("ghcr.io/londopy/nexium"))
    json.set(&mut registries, "homebrew", js("londopy/tap/nexium"))
    json.set(&mut registries, "scoop", js("londopy/nexium (scoop bucket add londopy https://github.com/Londopy/scoop-bucket)"))
    json.set(&mut registries, "chocolatey", js("nexium"))
    json.set(&mut registries, "winget", js("Londopy.Nexium"))
    json.set(&mut registries, "aur", js("nexium-bin"))
    json.set(&mut registries, "nix", js("github:Londopy/nexium"))
    json.set(&mut registries, "open-vsx", js("Londopy.nexium"))
    json.set(&mut doc, "registries", registries)
    json.set(&mut doc, "docs", js(SITE_URL))
    return doc
}

/// Every release of the changelog: `## [x.y.z] - date`, then its name line.
fn api_releases() -> json.Json {
    var out = json.array()
    let text = fs.read("CHANGELOG.md") catch { String.new() }
    var lines = List([]u8).new()
    for l in text[..].lines() { lines.append(l) }
    for l, i in lines {
        if !l.starts_with("## [") { continue }
        let close = l.find("]") orelse continue
        let version = l[4..close]
        if version == "Unreleased" { continue }
        var date: []u8 = ""
        if let d = strings.strip_prefix(l[close + 1..], " - ") { date = d.trim() }
        var name = String.new()
        var j = i + 1
        while j < lines.len and j < i + 4 {
            let t = lines[j].trim()
            if t.starts_with("*") {
                let rest = t[1..]
                if let e = rest.find("*") { name = String.from(rest[..e]) }
                break
            }
            j += 1
        }
        var r = json.object()
        json.set(&mut r, "version", js(version))
        json.set(&mut r, "name", js(name[..]))
        json.set(&mut r, "date", js(date))
        json.set(&mut r, "release", js(format("{}/releases/tag/v{}", .{REPO, version})[..]))
        json.push(&mut out, r)
    }
    var doc = json.object()
    json.set(&mut doc, "releases", out)
    return doc
}

/// The standard library: every module, every public function with its
/// signature and the doc comment above it.
fn api_std() -> json.Json {
    var modules = json.array()
    let names = fs.list("std") catch { List(String).new() }
    for nm in names {
        if !nm[..].ends_with(".nx") { continue }
        let text = fs.read(fs.join("std", nm[..])[..]) catch { continue }
        var m = json.object()
        json.set(&mut m, "name", js(fs.stem(nm[..])))
        json.set(&mut m, "source", js(format("{}/blob/main/std/{}", .{REPO, nm})[..]))
        var about = String.new()
        var functions = json.array()
        var doc = List([]u8).new()
        var in_head = true
        for l in text[..].lines() {
            let t = l.trim()
            if in_head and t.starts_with("//!") {
                if about.len > 0 { about.append(" ") }
                about.append(t[3..].trim())
                continue
            }
            in_head = false
            if t.starts_with("///") { doc.append(t[3..].trim()); continue }
            if t.starts_with("pub fn ") {
                var sig = t
                if let b = t.find(" {") { sig = t[..b] }
                let name_end = sig.find("(") orelse sig.len
                var f = json.object()
                json.set(&mut f, "name", js(sig[7..name_end]))
                json.set(&mut f, "signature", js(sig))
                json.set(&mut f, "doc", js(strings.join(doc[..], " ")[..]))
                json.push(&mut functions, f)
            }
            if !t.starts_with("///") and !t.starts_with("pub fn ") { doc.clear() }
        }
        json.set(&mut m, "about", js(about[..]))
        json.set(&mut m, "functions", functions)
        json.push(&mut modules, m)
    }
    var out = json.object()
    json.set(&mut out, "modules", modules)
    return out
}

/// The Topo: the chapters with their pages and their exercises.
fn api_topo(pages: *List(Page)) -> json.Json {
    var chapters = json.array()
    var n: usize = 0
    for p in pages.* {
        if p.section[..] != "topo" { continue }
        n += 1
        let stem = fs.stem(p.src[..])
        var c = json.object()
        json.set(&mut c, "number", json.number(n as f64))
        json.set(&mut c, "slug", js(stem))
        json.set(&mut c, "title", js(p.title[..]))
        json.set(&mut c, "page", js(format("{}{}", .{SITE_URL, p.out})[..]))
        var exercises = json.array()
        for f in exercise_files(stem) {
            let name = fs.stem(f[..])
            var e = json.object()
            json.set(&mut e, "name", js(name))
            json.set(&mut e, "kind", js(kind_label(name)))
            json.set(&mut e, "source", js(format("{}/blob/main/topo/exercises/{}/{}", .{REPO, stem, f})[..]))
            json.push(&mut exercises, e)
        }
        json.set(&mut c, "exercises", exercises)
        json.set(&mut c, "quiz", json.boolean(fs.exists(fs.join(fs.join("topo/exercises", stem)[..], "quiz.txt")[..])))
        json.push(&mut chapters, c)
    }
    var out = json.object()
    json.set(&mut out, "chapters", chapters)
    return out
}

/// The commands and the options of nx, from the table in self/completions.nx.
fn api_commands() -> json.Json {
    let text = fs.read("self/completions.nx") catch { String.new() }
    var commands = json.array()
    var options = json.array()
    for l in text[..].lines() {
        let t = l.trim()
        let is_cmd = t.starts_with("out.append(Command{")
        let is_opt = t.starts_with("out.append(Option{")
        if !is_cmd and !is_opt { continue }
        var e = json.object()
        for key in ["name", "arg", "value", "about"] {
            let marker = format(".{} = \"", .{key})
            let at = t.find(marker[..]) orelse continue
            let rest = t[at + marker.len..]
            let end = rest.find("\"") orelse continue
            json.set(&mut e, key, js(rest[..end]))
        }
        if is_cmd { json.push(&mut commands, e) } else { json.push(&mut options, e) }
    }
    var out = json.object()
    json.set(&mut out, "commands", commands)
    json.set(&mut out, "options", options)
    return out
}

fn write_api(out_dir: []u8, pages: *List(Page)) -> bool {
    let dir = fs.join(out_dir, "api")
    fs.make_dirs(dir[..]) catch { eprintln("error: cannot create {}", .{dir}); return false }
    let nx = fs.read("self/nx.nx") catch { String.new() }
    let version = const_str(nx[..], "VERSION")
    let name = const_str(nx[..], "RELEASE_NAME")
    let date = const_str(nx[..], "RELEASE_DATE")
    var index = json.object()
    var docs = json.array()
    for d in [("latest.json", "the current release: version, name, date, every asset's URL, the registries"), ("releases.json", "every release: version, name, date"), ("std.json", "the standard library: modules and their public functions"), ("topo.json", "the Topo: chapters and exercises"), ("commands.json", "the commands and options of nx")] {
        var e = json.object()
        json.set(&mut e, "url", js(format("{}api/{}", .{SITE_URL, d.0})[..]))
        json.set(&mut e, "about", js(d.1))
        json.push(&mut docs, e)
    }
    json.set(&mut index, "documents", docs)
    json.set(&mut index, "docs", js(format("{}docs/api.html", .{SITE_URL})[..]))
    json.set(&mut index, "version", js(version[..]))
    let latest = api_latest(version[..], name[..], date[..])
    let releases = api_releases()
    let std_doc = api_std()
    let topo = api_topo(pages)
    let commands = api_commands()
    let files = [("index.json", &index), ("latest.json", &latest), ("releases.json", &releases), ("std.json", &std_doc), ("topo.json", &topo), ("commands.json", &commands)]
    for f in files {
        fs.write(fs.join(dir[..], f.0)[..], json.pretty(f.1, 2)[..]) catch { eprintln("error: cannot write api/{}", .{f.0}); return false }
    }
    return true
}

// ----- main ---------------------------------------------------------------------------

fn main() -> u8 {
    let args = os.args()
    var out_dir = String.from("site/out")
    var i: usize = 1
    while i < args.len {
        if args[i] == "--out" and i + 1 < args.len { out_dir = String.from(args[i + 1]); i += 2; continue }
        eprintln("usage: nx run site/build.nx -- [--out DIR]", .{})
        return 2
    }
    var pages = plan()
    // read every page once: its text and its title (the first `# ` line)
    var texts = List(String).new()
    for p in pages {
        let text = fs.read(p.src[..]) catch {
            eprintln("error: cannot read {}", .{p.src})
            return 1
        }
        texts.append(text)
    }
    for p, pi in pages {
        if p.title.len > 0 { continue }
        for l in texts[pi][..].lines() {
            if l.starts_with("# ") { pages[pi].title = String.from(l[2..].trim()); break }
        }
        if pages[pi].title.len == 0 { pages[pi].title = String.from(fs.stem(p.src[..])) }
    }
    var links = Links{ .srcs = List(String).new(), .outs = List(String).new() }
    for p in pages { links.srcs.append(p.src.clone()); links.outs.append(p.out.clone()) }
    // the README and the licence point at GitHub through the fallback; the docs index is the site root
    links.srcs.append(String.from("README.md")); links.outs.append(String.from("index.html"))
    links.srcs.append(String.from("docs/README.md")); links.outs.append(String.from("index.html"))

    fs.make_dirs(fs.join(out_dir[..], "docs")[..]) catch { eprintln("error: cannot create {}", .{out_dir}); return 1 }
    fs.make_dirs(fs.join(out_dir[..], "topo")[..]) catch { }
    fs.make_dirs(fs.join(out_dir[..], "assets")[..]) catch { }
    fs.write(fs.join(out_dir[..], "style.css")[..], CSS) catch { eprintln("error: cannot write the stylesheet", .{}); return 1 }
    // the playground's page half; the compiler (play/nx.wasm) is built by the Pages workflow
    fs.copy("site/play.js", fs.join(out_dir[..], "play.js")[..]) catch { eprintln("error: cannot copy site/play.js", .{}); return 1 }
    for a in ["logo.svg", "banner.svg", "icon-256.png", "social-preview.png"] {
        fs.copy(fs.join("assets", a)[..], fs.join(fs.join(out_dir[..], "assets")[..], a)[..]) catch { eprintln("warning: cannot copy assets/{}", .{a}) }
    }
    fs.write(fs.join(out_dir[..], ".nojekyll")[..], "") catch { }
    // the standard files a site is expected to have: where to report a
    // vulnerability (RFC 9116), what crawlers may index, and the page list
    fs.make_dirs(fs.join(out_dir[..], ".well-known")[..]) catch { }
    fs.write(fs.join(out_dir[..], ".well-known/security.txt")[..], format("Contact: https://github.com/Londopy/nexium/security/advisories/new\nContact: https://github.com/Londopy\nExpires: 2027-09-22T00:00:00.000Z\nPreferred-Languages: en\nCanonical: {}.well-known/security.txt\nPolicy: {}docs/security.html\n", .{SITE_URL, SITE_URL})[..]) catch { }
    fs.write(fs.join(out_dir[..], "robots.txt")[..], format("User-agent: *\nAllow: /\nSitemap: {}sitemap.xml\n", .{SITE_URL})[..]) catch { }
    var sitemap = String.from("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n")
    for p in pages { sitemap.append(format("  <url><loc>{}{}</loc></url>\n", .{SITE_URL, p.out})[..]) }
    sitemap.append("</urlset>\n")
    fs.write(fs.join(out_dir[..], "sitemap.xml")[..], sitemap[..]) catch { }
    fs.make_dirs(fs.join(out_dir[..], "topo/img")[..]) catch { }
    for img in fs.list("topo/img") catch { List(String).new() } {
        fs.copy(fs.join("topo/img", img[..])[..], fs.join(fs.join(out_dir[..], "topo/img")[..], img[..])[..]) catch { eprintln("warning: cannot copy topo/img/{}", .{img}) }
    }

    var written: usize = 0
    for p, pi in pages {
        let root = if p.out[..].find("/") != null { "../" } else { "" }
        var title = String.new()
        var headings = List(Heading).new()
        let body = render_markdown(texts[pi][..], &links, &p, &mut title, &mut headings)
        var html = String.with_capacity(body.len + 8192)
        // "Nexium language" in every title: a search has other things called Nexium to get past
        let full_title = if p.section[..] == "index" { String.from("The Nexium language: compiles to C, ships everywhere") } else { format("{} · Nexium language", .{p.title}) }
        page_head(&mut html, full_title[..], root, first_paragraph(body[..])[..])
        sidebar(&mut html, &pages, pi, root)
        html.append("<main>\n")
        if p.section[..] != "index" {
            toc(&mut html, &headings, &links, &p)
            html.append(format("<h1>{}</h1>\n", .{inline(p.title[..], &links, &p)})[..])
        }
        html.append(body[..])
        if p.section[..] == "topo" { exercises_section(&mut html, fs.stem(p.src[..]), &links, &p) }
        pager(&mut html, &pages, pi, root)
        html.append(TOPO_SCRIPT)
        html.append("\n")
        footer(&mut html, p.src[..])
        let path = fs.join(out_dir[..], p.out[..])
        fs.write(path[..], html[..]) catch { eprintln("error: cannot write {}", .{path}); return 1 }
        written += 1
    }
    if !write_api(out_dir[..], &pages) { return 1 }
    println("site: {} pages and the API in {}", .{written, out_dir})
    return 0
}

/// The text of the first paragraph, for the description tag.
fn first_paragraph(html: []u8) -> String {
    let start = html.find("<p>") orelse return String.new()
    let rest = html[start + 3..]
    let end = rest.find("</p>") orelse return String.new()
    var text = String.new()
    var in_tag = false
    for c in rest[0..end] {
        if c == '<' { in_tag = true } else if c == '>' { in_tag = false } else if !in_tag { text.push_byte(c) }
    }
    if text.len > 200 { text = String.from(text[0..200]) }
    return strings.replace(text[..], "&quot;", "'")
}
